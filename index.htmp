#sclDirectPaymentRoot .scl-dp-classes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
#sclDirectPaymentRoot .scl-dp-class{min-height:66px;border:2px solid #caa95f;border-left:9px solid var(--c);border-radius:13px;background:linear-gradient(90deg,var(--bg),#fff);padding:11px 12px;text-align:left;color:#4d080d;font-weight:950;cursor:pointer}
#sclDirectPaymentRoot .scl-dp-class small{display:block;font-size:10px;margin-top:4px;color:#6c5a4b}
#sclDirectPaymentRoot .scl-dp-back{border:1px solid #caa95f;background:#fff;border-radius:9px;padding:8px 12px;font-weight:900;color:#650007;cursor:pointer;margin-bottom:10px}
#sclDirectPaymentRoot .scl-dp-tablewrap{overflow:auto;border:1px solid #e2d5bf;border-radius:12px;background:#fff}
#sclDirectPaymentRoot table{width:100%;border-collapse:collapse;min-width:690px}
#sclDirectPaymentRoot th,#sclDirectPaymentRoot td{padding:9px 8px;border-bottom:1px solid #eadfce;text-align:left;font-size:12px;vertical-align:middle}
#sclDirectPaymentRoot th{background:#f7efe1;color:#650007;font-weight:950}
#sclDirectPaymentRoot .scl-dp-money{font-weight:950;white-space:nowrap}
#sclDirectPaymentRoot .scl-dp-pay{border:1px solid #650007;background:#650007;color:#fff;border-radius:8px;padding:7px 9px;font-weight:900;cursor:pointer;white-space:nowrap}
#sclDirectPaymentRoot .scl-dp-status{padding:8px 10px;border-radius:10px;font-size:11px;line-height:1.4;margin:10px 0;border:1px solid #ddd}
