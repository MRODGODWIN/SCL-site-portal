<style id="scl-v33-bottom-tools-style">
.scl-v33-tools{
  margin:22px 0 90px;padding:14px;
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;
}
.scl-v33-tool{
  min-height:78px;border:1px solid rgba(101,0,7,.16);border-radius:16px;
  background:#fffdf7;box-shadow:0 7px 20px rgba(0,0,0,.08);
  color:#650007;font:800 14px/1.2 Arial,sans-serif;cursor:pointer;padding:12px;
}
.scl-v33-tool .tool-icon{display:block;font-size:22px;margin-bottom:5px}
.scl-v33-tool .tool-sub{display:block;font-size:10px;font-weight:600;opacity:.68;margin-top:4px}
.scl-v33-tool.fee{border-top:4px solid #650007}
.scl-v33-tool.email{border-top:4px solid #d29a00}
.scl-v33-tool.curriculum{border-top:4px solid #126b3a}
.scl-v33-modal{
  position:fixed;inset:0;z-index:100002;display:none;align-items:center;justify-content:center;
  padding:16px;background:rgba(0,0,0,.68)
}
.scl-v33-modal.is-open{display:flex}
.scl-v33-box{
  width:min(540px,100%);max-height:90vh;overflow:auto;border-radius:20px;padding:18px;
  background:#fff;color:#181818;box-shadow:0 18px 60px rgba(0,0,0,.35)
}
.scl-v33-box h3{margin:0 0 6px;color:#650007}
.scl-v33-box>p{margin:5px 0 14px;line-height:1.45}
.scl-v33-close,.scl-v33-choice{
  width:100%;padding:12px;margin:7px 0;border-radius:11px;cursor:pointer;font-weight:900
}
.scl-v33-choice{border:0;background:#650007;color:#fff}
.scl-v33-choice.gold{background:#d9a400;color:#450000}
.scl-v33-close{border:1px solid #bbb;background:#fff;color:#333}
.scl-v33-wa{
  display:flex;align-items:center;gap:12px;width:100%;padding:13px;margin:9px 0;
  border:1px solid #ddd;border-radius:12px;background:#fff;cursor:pointer;text-align:left
}
.scl-v33-wa .wa-round{
  width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:#18a94b;color:#fff;font-size:19px;font-weight:900;flex:none
}
.scl-v33-wa strong{display:block;color:#650007}.scl-v33-wa small{display:block;margin-top:3px;color:#555}
.scl-v33-email-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.scl-v33-box label{display:grid;gap:5px;font-weight:700;margin-bottom:10px}
.scl-v33-box input{
  width:100%;box-sizing:border-box;padding:10px 11px;border-radius:10px;
  border:1px solid #cfcfcf;background:#fff;font:inherit
}
.scl-v33-generate{
  width:100%;padding:12px;border:0;border-radius:10px;background:#d9a400;
  color:#450000;cursor:pointer;font-weight:900
}
.scl-v33-generated{margin-top:12px;padding:12px;border-radius:12px;background:rgba(22,163,74,.08);display:grid;gap:7px}
.scl-v33-generated strong{word-break:break-all}
.scl-v33-copy{justify-self:start;padding:8px 11px;border:0;border-radius:9px;cursor:pointer;font-weight:800}
.scl-reg-email-panel{
  border:1px solid #ead5b6;border-radius:13px;padding:12px;background:#fffaf0;
}
.scl-reg-email-panel h4{margin:0 0 5px;color:#650007}
.scl-reg-email-panel p{font-size:12px;line-height:1.4;margin:5px 0 10px}
.scl-reg-email-options{display:grid;gap:7px;margin-bottom:8px}
.scl-reg-email-options label{font-weight:700}
.scl-reg-email-options input{margin-right:6px}
.scl-reg-email-action{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.scl-reg-email-action span{font-size:11px;font-weight:700}
@media(max-width:600px){
  .scl-v33-tools{grid-template-columns:1fr 1fr;margin-bottom:82px;padding:10px}
  .scl-v33-tool{min-height:72px;font-size:12px}
  .scl-v33-email-grid{grid-template-columns:1fr}
  .scl-reg-email-action{display:grid}
}
</style>
<section aria-label="SCL parent services" class="scl-v33-tools">
<button class="scl-v33-tool fee" id="sclV33FeeButton" type="button">
<span class="tool-icon">💰</span>
    FEE NEGOTIATION
    <span class="tool-sub">Discuss fees or request support</span>
</button>
<button class="scl-v33-tool email" id="sclV33EmailButton" type="button">
<span class="tool-icon">🎓</span>
    CREATE EMAIL / USER ID
    <span class="tool-sub">Create the SCL email identity and school User ID together</span>
</button>
<button class="scl-v33-tool curriculum" id="sclV33CurriculumButton" type="button">
<span class="tool-icon">📚</span>
    SCHOOL CURRICULUM
    <span class="tool-sub">View class, subject and term schemes</span>
</button>
<button class="scl-v33-tool attendance" id="sclV38AttendanceButton" onclick="sclOpenAttendance()" type="button">
<span class="tool-icon">🟢</span>
    STAFF ATTENDANCE
    <span class="tool-sub">Sign in or sign out for today's attendance</span><span class="scl-v39-status-badge" data-state="ready" id="sclAttendanceStatusBadge">READY</span>
</button>
</section>
<section aria-label="School Curriculum and Scheme of Work" class="scl-learning-section scl-curriculum-hidden-source" id="sclCurriculum">
<div class="scl-learning-head"><div><span class="scl-pill">ACADEMIC LEARNING CENTRE</span><h2>School Curriculum</h2><p>Teachers and students can view the scheme for a specific class, subject and term. Teachers should save the subjects assigned to their account to receive a focused view.</p></div><button class="scl-btn light" onclick="sclOpenCurriculum()" type="button">View Curriculum</button></div>
<div class="scl-learning-grid">
<div class="scl-panel">
<h3>My Registered Teaching Scheme</h3>
<div class="scl-form-grid">
<label>Class<select id="sclCurClass"><option value="CRECHE">Creche</option><option value="RECEPTION">Reception</option><option value="NURSERY1">Nursery 1</option><option value="NURSERY2">Nursery 2</option><option value="PRIMARY1">Primary 1</option><option value="PRIMARY2">Primary 2</option><option value="PRIMARY3">Primary 3</option><option value="PRIMARY4">Primary 4</option><option value="PRIMARY5">Primary 5</option><option value="JSS1">JSS1</option><option value="JSS2">JSS2</option><option value="JSS3">JSS3</option><option value="SSS1">SSS1</option><option value="SSS2">SSS2</option><option value="SSS3">SSS3</option></select></label>
<label>Term<select id="sclCurTerm"><option value="First Term">First Term</option><option value="Second Term">Second Term</option><option value="Third Term">Third Term</option></select></label>
<label class="scl-wide">Subject<select id="sclCurSubject"><option value="Beauty And Cosmetology">Beauty And Cosmetology</option><option value="Business Studies">Business Studies</option><option value="Christian Religious Studies">Christian Religious Studies</option><option value="Christian Religious Studies (Crs)">Christian Religious Studies (Crs)</option><option value="Cultural &amp; Creative Arts (Cca)">Cultural &amp; Creative Arts (Cca)</option><option value="Cultural And Creative Arts">Cultural And Creative Arts</option><option value="Cultural And Creative Arts (Cca)">Cultural And Creative Arts (Cca)</option><option value="Digital Technologies">Digital Technologies</option><option value="English Studies">English Studies</option><option value="Fashion Design And Garment Making">Fashion Design And Garment Making</option><option value="French">French</option><option value="Horticulture And Crop Production">Horticulture And Crop Production</option><option value="Intermediate Science">Intermediate Science</option><option value="Islamic Religious Studies (Irs)">Islamic Religious Studies (Irs)</option><option value="Livestock Farming">Livestock Farming</option><option value="Mathematics">Mathematics</option><option value="Nigerian History">Nigerian History</option><option value="Physical &amp; Health Education">Physical &amp; Health Education</option><option value="Physical And Health Education">Physical And Health Education</option><option value="Social And Citizenship Studies">Social And Citizenship Studies</option></select></label>
</div>
<div class="scl-actions"><button class="scl-btn" onclick="sclShowCurriculum()" type="button">Show My Scheme</button><button class="scl-btn alt" onclick="sclSaveTeachingSubject()" type="button">Save My Subject</button></div>
<p class="scl-muted">Your saved class, term and subject are kept on this device. When connected to the school backend, these values should be linked to the teacher's registered account and permissions.</p>
<div class="scl-result" id="sclCurriculumResult"><p class="scl-muted">Select your class, term and subject, then tap “Show My Scheme.”</p></div>
</div>
<div class="scl-panel">
<h3>Learning Materials &amp; Purchase Requests</h3>
<p class="scl-muted">The curriculum identifies practical materials, stationery and equipment needed for lessons. Prices can be added later by the school administrator.</p>
<div class="scl-materials-launch"><div><strong>School Materials Catalogue</strong><p class="scl-muted">View the complete list of school materials, practical equipment, stationery and approved gadgets.</p></div><button class="scl-btn alt" onclick="openMaterials()" type="button">OPEN SCHOOL MATERIALS</button></div>
<div class="scl-market-box"><strong>Need an extra item or gadget?</strong><p class="scl-muted">Items already paid for in the school fee form are excluded. Additional stationery, materials or gadgets may be requested through the official sales and marketing service.</p><button class="scl-btn" onclick="sclRequestMaterial()" type="button">Request Extra Material</button><div class="scl-muted" id="sclRequestStatus"></div></div>
</div>
</div>
</section>
<div aria-labelledby="sclV33FeeTitle" aria-modal="true" class="scl-v33-modal" id="sclV33FeeModal" role="dialog">
<div class="scl-v33-box">
<h3 id="sclV33FeeTitle">FEE NEGOTIATION</h3>
<p id="sclV33FeeText">Choose how SCL can assist with the selected fee.</p>
