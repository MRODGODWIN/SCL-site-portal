  .scl-v94-vertical-days .scl-tt-col-p1,.scl-v94-vertical-days .scl-tt-col-p2,.scl-v94-vertical-days .scl-tt-col-p3,.scl-v94-vertical-days .scl-tt-col-p5{width:12.54%!important}
  .scl-v94-vertical-days .scl-tt-col-p4{width:11.43%!important}
