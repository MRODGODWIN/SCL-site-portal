</div>
</div>
<div aria-labelledby="sclV33EmailTitle" aria-modal="true" class="scl-v33-modal" id="sclV33EmailModal" role="dialog">
<div class="scl-v33-box">
<h3 id="sclV33EmailTitle">OFFICIAL EMAIL CREATIONS</h3>
<p>For students who do not already have a suitable email that reflects their own name, or who currently use a parent's email, create the student's official academic email identity here.</p>
<div class="scl-v33-email-grid">
<label>Surname<input autocomplete="family-name" id="sclV33EmailSurname" type="text"/></label>
<label>First Name<input autocomplete="given-name" id="sclV33EmailFirstName" type="text"/></label>
<label>Third Name<input id="sclV33EmailThirdName" type="text"/></label>
<label>Year of Birth<input id="sclV33EmailBirthYear" inputmode="numeric" max="2100" min="1900" placeholder="YYYY" type="number"/></label>
</div>
<label>Official School Academic Email Domain
      <input id="sclV33EmailDomain" placeholder="Configured by SCL technical administrator" type="text"/>
</label>
<button class="scl-v33-generate" id="sclV33GenerateEmail" type="button">GENERATE OFFICIAL EMAIL</button>
<div class="scl-v33-generated" hidden="" id="sclV33Generated">
<span>Generated academic email identity</span>
<strong id="sclV33EmailOutput"></strong>
<button class="scl-v33-copy" id="sclV33CopyEmail" type="button">COPY EMAIL</button>
<small id="sclV33EmailStatus"></small>
</div>
<small>The actual mailbox must be provisioned by the school's approved email provider. This website creates the official identity and registration link; it does not pretend that a mailbox exists before provisioning.</small>
<button class="scl-v33-close" id="sclV33EmailClose" type="button">CLOSE</button>
</div>
</div>
<script id="scl-v33-registration-email-script">
(function(){
  window.updateRegAcademicEmailUI=function(){
    const choice=document.querySelector('input[name="academicEmailStatus"]:checked')?.value;
    const action=document.getElementById('regAcademicEmailAction');
    const status=document.getElementById('regAcademicEmailStatus');
    const hidden=document.getElementById('regOfficialAcademicEmail');
    if(!action||!status)return;
    if(choice==='create'){
      action.hidden=false;
      status.textContent=hidden.value?'Generated: '+hidden.value:'Email creation is required before registration can be completed.';
    }else{
      action.hidden=true;
      status.textContent='';
      hidden.value='';
    }
  };

  window.openSclEmailCreatorForRegistration=function(){
    window.sclV33EmailRegistrationCallback=function(email){
      const hidden=document.getElementById('regOfficialAcademicEmail');
      const status=document.getElementById('regAcademicEmailStatus');
      if(hidden)hidden.value=email;
      if(status)status.textContent='Generated: '+email;
    };
    const stored=localStorage.getItem('sclAcademicEmailDomain')||'';
    const domain=document.getElementById('sclV33EmailDomain');
    if(stored&&domain)domain.value=stored;
    if(typeof sclV33Show==='function')sclV33Show('sclV33EmailModal');
  };

  document.addEventListener('DOMContentLoaded',function(){
    const form=document.getElementById('form');
    if(!form)return;
    form.addEventListener('submit',function(e){
      const choice=document.querySelector('input[name="academicEmailStatus"]:checked')?.value;
      const generated=document.getElementById('regOfficialAcademicEmail')?.value.trim();
      if(choice==='create'&&!generated){
        e.preventDefault();
        toast('Please create the official academic email before submitting this registration.');
      }
    },true);
  });
})();
</script>
<script>
(function(){
  const KEY='sclAuthSession';
  function getAuth(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(_){return null}}
  window.sclAuthToken=function(){const a=getAuth();return a?.accessToken||''};
  window.sclAuthFetch=async function(url,options={}){const headers=new Headers(options.headers||{});const token=sclAuthToken();if(token)headers.set('Authorization','Bearer '+token);return fetch(url,{...options,headers})};
  window.sclLogin=async function(e){
    e.preventDefault(); const email=document.getElementById('sclLoginEmail').value.trim(); const password=document.getElementById('sclLoginPassword').value; const box=document.getElementById('sclLoginStatus');
    box.classList.remove('hidden'); box.textContent='Authenticating with SCL...';
    try{const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Login failed.');sessionStorage.setItem(KEY,JSON.stringify(d));renderAccount(d);closeM('loginModal');openM('sclAccountModal');toast('SCL login successful.');}
    catch(err){box.textContent=err.message||'Unable to sign in.';box.classList.add('statusbox');}
  };
  window.renderAccount=function(d){const name=d.profile?.full_name||d.user?.email||'SCL User';document.getElementById('sclAccountSummary').innerHTML='<b>'+escapeHtml(name)+'</b><br><small>'+escapeHtml(d.user?.email||'')+'</small>';document.getElementById('sclAccountRoles').innerHTML=(d.roles||[]).map(x=>'<span class="chip">'+escapeHtml(x)+'</span>').join(' ')||'<span>No role assigned yet.</span>';document.getElementById('sclAccountPermissions').innerHTML=(d.permissions||[]).map(x=>'<span class="chip">'+escapeHtml(x)+'</span>').join(' ')||'<span>No permissions assigned.</span>';sclUpdateUniformAdminAccess(d);};
  window.sclLogout=function(){try{window.sclSupabase?.auth?.signOut()}catch(_){} sessionStorage.removeItem(KEY);document.body.classList.add('scl-public-locked');closeM('sclAccountModal');closeM('sclModernProfileModal');toast('You have been logged out of SCL.');};
  window.login=function(){const a=getAuth();if(a){renderAccount(a);openM('sclAccountModal')}else openM('loginModal')};
  function escapeHtml(v){return String(v).replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));}
  document.addEventListener('DOMContentLoaded',async()=>{const a=getAuth();if(!a)return;try{const r=await sclAuthFetch('/api/auth/me');if(!r.ok)throw 0;const d=await r.json();sessionStorage.setItem(KEY,JSON.stringify({...a,...d}));}catch(_){sessionStorage.removeItem(KEY);}});
})();
</script>
<style id="aac-calendar-styles">
.aac-section{margin:18px 0;padding:20px;border:1px solid #e4c77a;border-radius:18px;background:linear-gradient(135deg,#fffdf7,#fff);box-shadow:0 8px 25px rgba(53,0,3,.07)}
.aac-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.aac-kicker{font-size:11px;font-weight:800;color:#126b3a;letter-spacing:.5px}.aac-heading h2{margin:5px 0 2px;color:#650007}.aac-heading h2 b{color:#bd850d}.aac-heading p{margin:0;color:#66574a}.aac-notice{margin:15px 0;padding:11px 13px;border-radius:10px;background:#fff8df;border:1px solid #e2c98f;color:#4d3b2d;font-size:13px}
.aac-controls{display:flex;justify-content:center;align-items:center;gap:10px;margin:12px 0}.aac-controls select{padding:10px 35px 10px 12px;border:1px solid #d9c5aa;border-radius:9px;background:#fff;font-weight:700;color:#650007}.aac-arrow{width:40px;height:40px;border:0;border-radius:50%;background:#650007;color:#fff;font-size:26px;cursor:pointer}
.aac-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:14px}.aac-calendar-card,.aac-events-card{border:1px solid #ead5b6;border-radius:13px;background:#fff;padding:12px}.aac-week,.aac-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.aac-week span{text-align:center;font-size:12px;font-weight:800;color:#650007;padding:7px 0}.aac-day{min-height:62px;border:1px solid #eee1ca;border-radius:8px;padding:6px;position:relative;background:#fffdf8;font-size:12px}.aac-day.empty{background:#fafafa;border-color:#f4eee5}.aac-day.today{outline:2px solid #f2ae00}.aac-day .num{font-weight:800}.aac-day.has-event{cursor:pointer}.aac-day.term{background:#eef8ef;border-color:#a8d5b3}.aac-day.holiday{background:#fff0f0;border-color:#e7a6a6}.aac-day.observe{background:#eef4ff;border-color:#abc3e8}.aac-day .mark{display:block;margin-top:4px;font-size:10px;line-height:1.1;font-weight:700;color:#650007;overflow:hidden;max-height:23px}.aac-events-card h3{margin:2px 0 12px;color:#650007}.aac-event{padding:10px;border-left:4px solid #126b3a;background:#f6fbf6;border-radius:7px;margin:7px 0}.aac-event.holiday{border-left-color:#b00000;background:#fff5f5}.aac-event.observe{border-left-color:#2859a8;background:#f4f7ff}.aac-event strong{display:block;font-size:13px}.aac-event small{display:block;color:#66574a;margin-top:3px}.aac-empty{color:#777;font-size:13px;padding:10px 0}.aac-legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:11px;color:#66574a}.aac-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px}.term-dot{background:#a8d5b3}.holiday-dot{background:#e7a6a6}.observe-dot{background:#abc3e8}.aac-details{margin-top:14px;font-size:13px;color:#4d3b2d}.aac-details summary{cursor:pointer;font-weight:800;color:#650007}.aac-details li{margin:7px 0}
@media(max-width:800px){.aac-layout{grid-template-columns:1fr}}@media(max-width:600px){.aac-section{padding:13px}.aac-day{min-height:49px;padding:4px;font-size:11px}.aac-day .mark{font-size:8px}.aac-week{gap:3px}.aac-grid{gap:3px}.aac-events-card{padding:10px}}
</style>
<script>
(function(){
const events=[
["2026-09-07","2026-09-11","Staff Professional Development (SPD)","term","Schools select any two days"],
["2026-09-08","2026-09-08","International Literacy Day","observe","Observance"],
["2026-09-07","2026-09-07","First Term Resumption","term","School resumes"],
["2026-10-01","2026-10-01","Independence Day","holiday","Public holiday"],
["2026-10-05","2026-10-05","World Teachers' Day","observe","Observance"],
["2026-10-29","2026-10-30","Open Day","term","29 Oct: Primary; 30 Oct: Secondary"],
["2026-11-02","2026-11-06","First Term Mid-Term Break","holiday","5 days"],
["2026-12-18","2026-12-18","First Term Ends","term","Last school day"],
["2026-12-21","2027-01-08","First Term Vacation","holiday","15 days"],
["2027-01-11","2027-01-11","Second Term Resumption","term","School resumes"],
["2027-01-24","2027-01-24","International Day of Education","observe","Observance"],
["2027-02-18","2027-02-19","Open Day","term","18 Feb: Primary; 19 Feb: Secondary"],
["2027-02-22","2027-02-26","Second Term Mid-Term Break","holiday","5 days"],
["2027-03-10","2027-03-11","Eid-el-Fitr","holiday","Public holiday"],
["2027-03-26","2027-03-26","Good Friday","holiday","Public holiday"]

,
["2027-03-29","2027-03-29","Easter Monday","holiday","Public holiday"],
["2027-04-16","2027-04-16","Second Term Ends","term","Last school day"],
["2027-04-19","2027-04-30","Second Term Vacation","holiday","10 days"],
["2027-05-01","2027-05-01","Workers' Day","holiday","Public holiday"],
["2027-05-03","2027-05-03","Third Term Resumption","term","School resumes"],
["2027-05-17","2027-05-18","Eid-el-Kabir","holiday","Public holiday"],
["2027-05-27","2027-05-27","Children's Day","observe","Observance"],
["2027-06-10","2027-06-11","Open Day","term","10 Jun: Primary; 11 Jun: Secondary"],
["2027-06-12","2027-06-12","Democracy Day","holiday","Public holiday"],
["2027-06-14","2027-06-18","Third Term Mid-Term Break","holiday","5 days"],
["2027-07-30","2027-07-30","End of Session","term","Third term ends"],
["2027-08-02","2027-08-02","Long Vacation Begins","holiday","Vacation"]
];
function localKey(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
const iso=localKey;
function visitorToday(){return new Date();}
let current=visitorToday();
if(current<new Date(2026,8,1)) current=new Date(2026,8,1);
if(current>new Date(2027,7,1)) current=new Date(2027,7,1);
const fmt=d=>d.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"});
function rangeDates(a,b){let out=[],d=new Date(a+"T00:00:00"),end=new Date(b+"T00:00:00");while(d<=end){out.push(iso(d));d.setDate(d.getDate()+1)}return out}
function monthEvents(y,m){return events.filter(e=>{let a=new Date(e[0]+"T00:00:00"),b=new Date(e[1]+"T00:00:00");return a.getFullYear()===y&&a.getMonth()===m||b.getFullYear()===y&&b.getMonth()===m||a<new Date(y,m+1,1)&&b>=new Date(y,m,1)})}
function render(){
let y=current.getFullYear(),m=current.getMonth(),sel=document.getElementById("aacMonth"),grid=document.getElementById("aacGrid"),list=document.getElementById("aacEvents");
if(!sel.options.length){for(let yy=2026;yy<=2027;yy++)for(let mm=0;mm<12;mm++){let o=document.createElement("option");o.value=yy+"-"+mm;o.textContent=new Date(yy,mm,1).toLocaleDateString("en-US",{month:"long",year:"numeric"});sel.appendChild(o)}}
sel.value=y+"-"+m;document.getElementById("aacMonthTitle").textContent=current.toLocaleDateString("en-US",{month:"long",year:"numeric"})+" Events";var tl=document.getElementById("aacTodayLabel");if(tl){var td=visitorToday();tl.textContent="Today: "+td.toLocaleDateString("en-GB",{weekday:"long",day:"numeric",month:"long",year:"numeric"});}
grid.innerHTML="";let first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate();
for(let i=0;i<first;i++){let x=document.createElement("div");x.className="aac-day empty";grid.appendChild(x)}
for(let day=1;day<=days;day++){let d=new Date(y,m,day),key=iso(d),x=document.createElement("div");x.className="aac-day";if(key===iso(visitorToday()))x.classList.add("today");let es=events.filter(e=>rangeDates(e[0],e[1]).includes(key));if(es.length){x.classList.add(es[0][3]);x.classList.add("has-event");x.title=es.map(e=>e[2]).join(", ");x.onclick=()=>document.getElementById("aacEvents").scrollIntoView({behavior:"smooth",block:"nearest"})}x.innerHTML='<span class="num">'+day+'</span>'+ (es[0]?'<span class="mark">'+es[0][2]+"</span>":"");grid.appendChild(x)}
list.innerHTML="";let es=monthEvents(y,m).sort((a,b)=>a[0].localeCompare(b[0]));if(!es.length)list.innerHTML='<div class="aac-empty">No listed events for this month.</div>';else es.forEach(e=>{let d=document.createElement("div");d.className="aac-event "+e[3];d.innerHTML="<strong>"+e[2]+"</strong><small>"+fmt(new Date(e[0]+"T00:00:00"))+(e[1]!==e[0]?" – "+fmt(new Date(e[1]+"T00:00:00")):"")+" • "+e[4]+"</small>";list.appendChild(d)})}
window.aacChangeMonth=function(n){current.setMonth(current.getMonth()+n);render()};window.aacToday=function(){current=visitorToday();if(current<new Date(2026,8,1))current=new Date(2026,8,1);if(current>new Date(2027,7,1))current=new Date(2027,7,1);render()};document.addEventListener("DOMContentLoaded",function(){document.getElementById("aacMonth").addEventListener("change",function(){let [y,m]=this.value.split("-").map(Number);current=new Date(y,m,1);render()});render()});
})();
</script>
<section aria-label="Approved Academic Calendar" class="aac-section" id="approvedAcademicCalendar">
<div class="aac-heading">
<div>
<span class="aac-kicker">LAGOS STATE GOVERNMENT • OEQA</span>
<div class="aac-today-label" id="aacTodayLabel">Today</div>
<h2>Approved Academic Calendar <b>(AAC)</b></h2>
<p>2026/2027 Provisional Harmonised Academic Calendar</p>
</div>
<button class="btn gold" onclick="aacToday()" type="button">Today</button>
</div>
<div class="aac-notice"><strong>Public Calendar:</strong> This calendar is available to everyone, whether logged in or not. It will be updated annually from the applicable government academic calendar.</div>
<div class="scl-calendar-attendance-card" id="sclCalendarAttendanceCard"><div><strong>STAFF &amp; TEACHER ATTENDANCE</strong><span>For all SCL staff and teachers, including full-time and part-time workers. Sign in from the approved school location using the required phone verification.</span></div><button class="btn red" id="sclCalendarAttendanceButton" onclick="sclCalendarAttendanceAction()" type="button">SIGN IN ATTENDANCE TODAY</button></div>
<div class="aac-controls">
<button aria-label="Previous month" class="aac-arrow" onclick="aacChangeMonth(-1)" type="button">‹</button>
<select aria-label="Select month" id="aacMonth"></select>
<button aria-label="Next month" class="aac-arrow" onclick="aacChangeMonth(1)" type="button">›</button>
</div>
<div class="aac-layout">
<div class="aac-calendar-card">
<div class="aac-week"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
<div class="aac-grid" id="aacGrid"></div>
<div class="aac-legend"><span><i class="term-dot"></i> Academic activity</span><span><i class="holiday-dot"></i> Holiday/break</span><span><i class="observe-dot"></i> Observance</span></div>
</div>
<div class="aac-events-card">
<h3 id="aacMonthTitle">Calendar Events</h3>
<div id="aacEvents"></div>
</div>
</div>
<details class="aac-details">
<summary>Important calendar notices</summary>
<ul>
<li>Schools may select any two days between 7–11 September 2026 for Staff Professional Development (SPD).</li>
<li>Open Day is mandatory; timing is at the school's discretion.</li>
<li>Public holidays are mandatory and subject to Federal Government announcement.</li>
<li>International Literacy Day is 8 September 2026; International Day of Education is 24 January 2027.</li>
<li>International-curriculum flexibility applications were due on 21 August 2026.</li>
</ul>
</details>
</section>
<script>
(function(){
const sclPages=window.sclPages;
const aiImg=window.__sclAiImg;
const schoolLogo="data:image/webp;base64,";
let sclSaved=JSON.parse(localStorage.getItem("sclTeachingScheme")||"null");
function by(id){return document.getElementById(id)}
window.sclOpenCurriculum=function(){by("sclCurriculum").scrollIntoView({behavior:"smooth",block:"start"})};
window.sclSaveTeachingSubject=function(){
 const v={className:by("sclCurClass").value,term:by("sclCurTerm").value,subject:by("sclCurSubject").value};
 localStorage.setItem("sclTeachingScheme",JSON.stringify(v));sclSaved=v;sclShowCurriculum();
};
window.sclShowCurriculum=function(){
 const c=by("sclCurClass").value,t=by("sclCurTerm").value,s=by("sclCurSubject").value;
 const matches=sclPages.filter(x=>x.class===c&&x.term===t&&x.subject.toLowerCase()===s.toLowerCase());
 const box=by("sclCurriculumResult");
 if(!matches.length){box.innerHTML='<p class="scl-muted">No exact pages were found for this selection in the supplied curriculum document. Please ask the administrator to upload the updated scheme.</p>';return}
 box.innerHTML='<p class="scl-muted"><strong>'+c+' • '+s+' • '+t+'</strong> — '+matches.length+' curriculum page(s) found.</p>'+matches.map(x=>'<article class="scl-result-card"><h4>Page '+x.page+' — '+x.class+' '+x.subject+' ('+x.term+')</h4><p>'+x.text.replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</p></article>').join('');
};
window.sclRequestMaterial=function(){
 const item=prompt("Type the extra stationery, practical material or gadget you need:");
 if(!item)return;
 const msg="Hello, I would like to request an extra school material or gadget: "+item;
 by("sclRequestStatus").innerHTML='Request prepared. Please email <a href="mailto:aisalesandmarketinguniverse@gmail.com?subject=Extra%20Material%20Request&body='+encodeURIComponent(msg)+'">aisalesandmarketinguniverse@gmail.com</a>.';
};
document.addEventListener("DOMContentLoaded",function(){
 if(sclSaved){by("sclCurClass").value=sclSaved.className;by("sclCurTerm").value=sclSaved.term;by("sclCurSubject").value=sclSaved.subject}
 if(!document.getElementById("sclAiModal")){const modal=document.createElement("div");modal.id="sclAiModal";modal.className="scl-ai-modal";modal.innerHTML='<div class="scl-ai-box"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><h3>EDUCATIONAL INTELLIGENCE</h3><button class="scl-btn light" type="button" onclick="document.getElementById(\'sclAiModal\').classList.remove(\'open\')">Close</button></div><p class="scl-muted">Ask for an explanation, learning direction, a social-media suggestion, an AI tool or a YouTube lesson.</p><textarea id="sclAiInput" class="scl-search-box" rows="4" spellcheck="true" lang="en" placeholder="Ask a question, explain a topic, or paste writing you want checked..."></textarea><div class="scl-actions"><button class="scl-btn" type="button" onclick="sclAskAI()">Ask EDUCATIONAL INTELLIGENCE</button><button class="scl-btn alt" type="button" onclick="sclCheckWriting()">Check Writing &amp; Errors</button><button class="scl-btn light" type="button" onclick="sclYouTube()">Find YouTube Lesson</button><button class="scl-btn light" type="button" onclick="sclOfficialYouTube()">Official SCL YouTube</button></div><div id="sclAiResponse" class="scl-ai-response">Your learning assistant is ready.</div></div>';document.body.appendChild(modal);}
});
window.sclAskAI=async function(){
 const q=(by("sclAiInput")?.value||"").trim(); if(!q)return;
 const out=by("sclAiResponse"); out.textContent="Thinking…";
 const curriculum=(typeof sclPages!=="undefined"?sclPages:[]);
 try{const r=await fetch(window.SCL_EDU_AI_API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question:q,context:curriculum.slice(0,12)})});if(r.ok){const d=await r.json();if(d.answer){out.textContent=d.answer;return;}}}catch(e){console.warn("SCL Educational Intelligence backend unavailable; using local internet dictionary fallback.",e)}
 const oneWord=/^[A-Za-z][A-Za-z'-]{0,79}$/.test(q.trim());
 const term=q.trim().replace(/^(what is|what does|define|meaning of|definition of|explain|the meaning of|tell me about)\s+/i,"").replace(/[?!.]+$/g,"").trim();
 if(oneWord || term!==q.trim()){
  try{const dr=await fetch("https://api.dictionaryapi.dev/api/v2/entries/en/"+encodeURIComponent(term));if(dr.ok){const data=await dr.json();const defs=[];(data?.[0]?.meanings||[]).forEach(m=>(m.definitions||[]).slice(0,2).forEach(d=>{if(d.definition)defs.push((m.partOfSpeech?"["+m.partOfSpeech+"] ":"")+d.definition+(d.example?"\nExample: "+d.example:""))}));if(defs.length){out.textContent="Meaning of "+(data?.[0]?.word||term)+":\n\n"+defs.slice(0,5).join("\n\n")+"\n\nStudy tip: Try using the word in your own sentence.";return;}}}catch(e){console.warn("Internet dictionary unavailable.",e)}
 }
 const words=q.toLowerCase().split(/\s+/).filter(w=>w.length>1);
 const matches=curriculum.filter(x=>words.some(w=>(String(x.text||"")+" "+String(x.subject||"")+" "+String(x.class||"")).toLowerCase().includes(w))).slice(0,5);
 const dictionary={food:"something that people, animals, or other living things eat or drink to provide energy and nutrients needed for life and growth",water:"a clear liquid that living things need to survive",photosynthesis:"the process by which green plants use light energy to make food from carbon dioxide and water",democracy:"a system in which people participate in choosing representatives or taking part in public decisions",fraction:"a number that represents a part of a whole",ecosystem:"a community of living things interacting with one another and with their physical environment",algorithm:"a clear sequence of steps used to solve a problem or complete a task"};
 const key=words.find(w=>dictionary[w]); let answer="";
 if(key) answer="Simple meaning: "+key.charAt(0).toUpperCase()+key.slice(1)+" means "+dictionary[key]+".\n\nStudy tip: Try using the word in your own sentence.";
 else if(matches.length) answer="Curriculum-based explanation\n\n"+matches.map(x=>String(x.class)+" • "+String(x.subject)+" • "+String(x.term)+"\n"+String(x.text||"").slice(0,1100)).join("\n\n---\n\n")+"\n\nNext step: I can turn this topic into revision questions, flashcards or a simple lesson.";
 else if(/quiz|test|question|revision/i.test(q)) answer="I can build a revision exercise from the SCL curriculum. You do not need to phrase the request perfectly.";
 else if(/write|grammar|essay|spell|correct/i.test(q)) answer="Writing support: paste the writing and I will identify spelling, grammar, sentence structure and clarity issues, then show corrected versions.";
 else answer="I can understand a single word, short phrase, misspelling or full question. Try typing just the word you want defined.";
 out.textContent=answer;
};
window.sclOfficialYouTube=function(){window.open("https://www.youtube.com/@SHININGCHILDLEADERS","_blank","noopener")};
window.sclYouTube=function(){const q=(by("sclAiInput")?.value||"").trim();if(q){window.open("https://www.youtube.com/results?search_query="+encodeURIComponent(q+" educational lesson"),"_blank","noopener");}else{window.sclOfficialYouTube();}};

})();
</script>
<style id="scl-final-polish">
.scl-materials-launch{margin-top:14px;padding:15px;border-radius:14px;background:#fff8e9;border:1px solid #ead5b6;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.scl-materials-launch strong{color:#650007;font-size:16px}.scl-materials-launch p{margin:4px 0 0}.scl-result-card{background:#fff;border:1px solid #ead5b6;border-radius:14px;padding:16px;margin:12px 0;box-shadow:0 4px 14px rgba(0,0,0,.04)}.scl-result-card h4{padding-bottom:10px;border-bottom:1px solid #eadfce}.scl-result-card .scheme-content{display:grid;gap:9px}.scl-result-card .scheme-heading{font-weight:800;color:#650007;margin-top:8px}.scl-result-card .scheme-item{padding:9px 11px;border-left:3px solid #d69b25;background:#fffaf0;border-radius:7px;line-height:1.55}.scl-result-card .scheme-week{font-weight:800;color:#126b3a;margin-top:8px}.scl-ai-box textarea{resize:vertical;min-height:105px;line-height:1.5}.scl-ai-response{white-space:pre-wrap;overflow-wrap:anywhere}.scl-ai-float{left:14px!important;right:auto!important;bottom:76px!important}.wa{right:14px!important;left:auto!important;bottom:76px!important}.scl-v33-tools{position:relative;z-index:1}.scl-social-panel{overflow:hidden;word-break:normal;overflow-wrap:anywhere}.scl-social-panel>p{max-width:100%;white-space:normal;line-height:1.5}@media(max-width:600px){.scl-materials-launch{align-items:stretch}.scl-materials-launch .scl-btn{width:100%}.scl-ai-float{width:60px!important;height:60px!important;bottom:72px!important}.wa{padding:9px 12px!important;bottom:72px!important}.scl-v33-tools{margin-bottom:90px!important}}

/* Final curriculum and school-building presentation polish */
.scl-result-card{overflow:hidden}.scheme-content{display:grid;gap:14px}.scheme-week-card{border:1px solid #e7d7b9;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 3px 12px rgba(31,20,10,.06)}.scheme-week-title{padding:11px 14px;background:linear-gradient(90deg,#650007,#8b1d24);color:#fff;font-weight:800;letter-spacing:.02em}.scheme-week-body{padding:14px;line-height:1.7;color:#263238;overflow-wrap:anywhere}.scheme-line{padding:7px 0;border-bottom:1px dashed #eadfce}.scheme-line:last-child{border-bottom:0}.scheme-paper{border:1px solid #e7d7b9;border-radius:12px;background:#fffdf8;overflow:hidden}.scheme-paper-body{padding:16px;line-height:1.8;white-space:pre-wrap}.scheme-summary{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 12px;padding:12px 14px;border:1px solid #ead5b6;border-radius:12px;background:#fff8e9;color:#650007}.scheme-summary span{font-size:12px;color:#66574a}.scheme-empty{padding:18px;border:1px solid #e6caca;border-radius:12px;background:#fff6f6;color:#650007;line-height:1.6}.scheme-week-body br{content:"";display:block;margin:.35rem 0}.scl-building-carousel{position:relative;height:300px!important;background:#f7f7f7}.scl-building-slide{position:absolute;inset:0;opacity:0;transform:translateX(24px);transition:opacity .65s ease,transform .65s ease;pointer-events:none}.scl-building-slide.is-active{opacity:1;transform:translateX(0);pointer-events:auto}.scl-building-slide img{width:100%;height:100%;object-fit:cover;display:block}.scl-building-prev,.scl-building-next{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border:0;border-radius:50%;background:rgba(0,0,0,.58);color:#fff;font-size:30px;line-height:1;cursor:pointer;z-index:3}.scl-building-prev{left:10px}.scl-building-next{right:10px}.scl-building-dots{position:absolute;left:0;right:0;bottom:10px;display:flex;justify-content:center;gap:7px;z-index:3}.scl-building-dots span{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.65)}.scl-building-dots span.active{background:#d5a052;transform:scale(1.2)}@media(max-width:600px){.scl-building-carousel{height:270px!important}.scheme-week-body{font-size:14px;padding:12px}.scheme-week-title{font-size:14px}}
</style>
<script id="scl-multiverse-curriculum-integration">
(function(){
 const incoming=[{"page":0,"class":"JSS1","subject":"English Studies","term":"First Term","text":"Week 1 Introduction to Speech; Organs of Speech Parts of Speech; Nouns – Meaning; Types of Nouns with examples The Family (use any recommended JSS1 text); Vocabulary – Introduction to Language Skills (LSRW) Meaning of Composition; Types – Narrative, Descriptive, Argumentative, Expository What is Literature? Week 2 Pure Vowel Sounds (Monothongs) with examples Pronouns – Meaning, Identification, Types Reading Strategies Elements of Composition – Introduction, Body, Conclusion Features of Literature; Types – Oral, Historical, Dance Drama, Miming (with reference to texts) Week 3 Vowel Sound /i:/ Verbs – Definition, Identification; Types – Transitive, Intransitive, Regular, Irregular, Auxiliary, Lexical SPQ3R Technique – Survey, Preview, Question, Recite, Recall, Review; Vocabulary – Members of the Family Elements of Composition – Introduction, Body, Conclusion Purpose/Functions of Literature; Introduction to Prose (use recommended text) Week 4 Vowel Sound /i/ Verbs (continued) – Types and Functions Identifying Main and Supporting Ideas; Vocabulary – Your School Subjects Differences between Descriptive and Narrative Essays Elements of Prose – Plot, Style, Characterization; Types of Oral Literature Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Vowel Sound /e/ Adjectives – Definition, Types; Comparison of Adjectives (Absolute etc.) Differentiating Main Ideas from Supporting Ideas in a passage Paragraph Writing – Logical sequence with Introduction & Conclusion Introduction to Drama; Types & Elements of Drama; Characterization & Themes in recommended prose text"},{"page":0,"class":"JSS1","subject":"English Studies","term":"Second Term","text":"Week 1 Vowel Sounds /u/ and /u:/ Adverbials – Frequency and Manner Asking specific questions requiring conclusions Formal Letter – Features; Writing to principal for permission Folktales – African Tales (Features: didactic, entertainment, magical); Recommended prose text Week 2 Vowel Sound /u:/ Tenses – Simple Present Tense Asking projection questions; Vocabulary – The Library Formal Letter – To the school authority Introduction to Poetry – Definition, Features (concise, unique, etc.); Recommended prose text Week 3 Vowel Sound /ɑ:/ Tenses – Simple Past Tense Asking recall questions; Vocabulary – Marriage-related words Guided Composition – The Federal Road Safety Commission Poetry – Types (Epic, Lyric, etc.); Oral vs Written Poetry Week 4 Vowel Sound /ɜ:/ Tenses – Present Continuous Tense Reading to understand Author’s mood (anger, doubt, joy, etc.) Narrative Essay – The Most Memorable Day of My Life Drama – Features (Theme, Costumes, Audience, etc.); Identifying features of drama in a text Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Vowel Sound /ə/ Tenses – Past Continuous Tense Reading between the lines to detect Author’s attitude; Vocabulary – Child Labour/Trafficking Argumentative Essay – Road Transportation is Safer than Air Recommended prose text Week 7 Midterm Break Midterm Break Midterm Break Midterm Break Midterm Break"},{"page":0,"class":"JSS1","subject":"English Studies","term":"Third Term","text":"Week 1 Diphthongs: /ei/ (place) /oʊ/ (home) /aʊ/ (mouse) /iə/ (clear) /eə/ (care) /ɔi/ (boy) /ai/ (find) /ʊə/ (tour) Introduction to Active and Passive Voice Reading to make meaning from spatial description; Vocabulary – Air Transport Introduction to Expository Essay Recommended prose text – Themes and Characterization Week 2 Identification of Diphthongs in words (/eə/ in Mary, /ɔi/ in boil) Highlighting Active Voice Identifying appropriate introductions and conclusions; Vocabulary – Fishing words Elements of Writing (continued) Recommended prose text – Setting/Plot Week 3 Introduction to Consonant Sounds Use of Passive Voice with examples Identifying keywords in passages that signal direction; Vocabulary – Kitchen words Expository Essay – The Ebola Virus Poetry – Identifying language in a selected poem Week 4 Syllables – Words of two, three, four syllables Exercises on Active Voice Making meaning from spatial description; Vocabulary – Words from the sick bay Argumentative Essay – Tribalism is a lesser evil than Cultism Myths/Legends – Identifying moral lessons; Recommended drama text Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Syllables (continued) Exercises on Passive Voice Reading comprehension practice; Vocabulary – Cooking words Argumentative Essay – Cultism erodes traditional values Poetry – Meaning of selected poem; Identification of figures of speech"},{"page":0,"class":"JSS1","subject":"Mathematics","term":"First Term","text":"Week 1 Whole Numbers Place value, ordering, and properties of whole numbers. Week 2 LCM (Least Common Multiple) Finding LCM using multiples and prime factorization. Week 3 HCF (Highest Common Factor) Finding HCF using factorization methods. Week 4 Counting in Base 2 Introduction to the binary number system. Week 5 Midterm Exams – Week 6 Conversion of Numbers Conversion of Base 10 numerals to binary numbers (step- by-step). Week 7 Midterm Break – Week 8 Fractions I Types of fractions (proper, improper, mixed), simplification. Week 9 Fractions II Equivalent fractions, comparison of fractions. Week 10 Basic Operations on Whole Numbers Addition, subtraction, multiplication, and division. 11– Week 13 Revision & Exams –"},{"page":0,"class":"JSS1","subject":"Mathematics","term":"Second Term","text":"Week 1 Addition & Subtraction of Fractions With the same and different denominators. Week 2 Multiplication & Division of Fractions Solving real-life problems with fractions. Week 3 Estimation & Approximation Rounding off numbers, significant figures. Week 4 Numbers in Base 2 – Addition Binary addition rules. Week 5 Midterm Exams – Week 6 Numbers in Base 2 – Subtraction Binary subtraction rules. Week 7 Midterm Break – Week 8 Numbers in Base 2 – Multiplication Binary multiplication rules. Week 9 Algebraic Processes I Use of symbols, coefficients, and algebraic expressions. Week 10 Simplification of Algebraic Expressions Expanding brackets, collecting like terms. 11–13 Revision & Exams –"},{"page":0,"class":"JSS1","subject":"Mathematics","term":"Third Term","text":"Week 1 Simple Equations Solving one-variable linear equations. Week 2 Plane Shapes Properties of triangles, quadrilaterals, and circles. Week 3 Three-Dimensional Figures Cubes, cuboids, cylinders, spheres, and cones. Week 4 Constructions Basic geometric constructions using ruler and compass. Week 5 Midterm Exams – Week 6 Angles Types of angles, angle sum properties of triangles & quadrilaterals. Week 7 Midterm Break – Week 8 Everyday Statistics I Need for statistics, importance in daily life. Week 9 Everyday Statistics II Methods of data collection. Week 10 Everyday Statistics III Data presentation: tables, bar charts, pie charts. 11–13 Revision & Exams –"},{"page":0,"class":"JSS1","subject":"Physical And Health Education","term":"First Term","text":"Week 1 Meaning of Physical Fitness Definition of physical fitness; difference between fitness and health Week 2 Components of Physical Fitness Strength, endurance, flexibility, agility, speed, balance, coordination Week 3 Characteristics of a Physically Fit Person Features such as stamina, resistance to illness, alertness, efficiency Week 4 Importance of Physical Fitness Benefits: health promotion, body development, productivity, prevention of diseases Week 5 Midterm Exams — Week 6 Exercises to Develop Strength, Endurance and Flexibility Examples: push-ups, sit-ups, squats, jogging, stretching, rope skipping Week 7 Midterm Break — Week 8 Safety Precautions while Performing Exercises Warm-up, cool-down, hydration, use of proper kits, avoiding overstrain Week 9 Meaning of Recreation, Leisure and Dance Definitions with examples of recreational and leisure activities Week 10 Differences between Dance, Leisure and Recreation Distinct features and examples of each Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS1","subject":"Physical And Health Education","term":"Second Term","text":"Week 1 Benefits of Recreation and Dance Physical, mental, emotional, and social benefits Week 2 Athletics – Shot-Put (Basic Skills and Techniques) Grip, stance, holding and releasing the shot Week 3 Athletics – Execution of Shot-Put Techniques Glide and rotational techniques, rules of performance Week 4 Athletics – Discus Throw (Basic Skills and Techniques) Holding, swinging, and throwing the discus Week 5 Midterm Exams — Week 6 Execution of Discus Throw Techniques Body positioning, release and follow-through Week 7 Midterm Break — Week 8 Rules Governing Shot-Put and Discus Throw Regulations, fouls, measuring of throws Week 9 Safety Measures in Track and Field Events Injury prevention, proper supervision, use of facilities Week 10 Football Basic rules, skills (passing, dribbling, shooting), team play, safety measures Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS1","subject":"Physical And Health Education","term":"Third Term","text":"Week 1 Volleyball Basic rules, skills (serving, passing, spiking), team play, safety measures Week 2 Contact and Non-Contact Sports – Meaning Explanation with examples Week 3 Contact and Non-Contact Sports – Types Examples: football, boxing, rugby (contact); tennis, badminton, athletics (non-contact) Week 4 Benefits of Contact and Non-Contact Sports Physical fitness, social interaction, discipline, teamwork Week 5 Midterm Exams — Week 6 Basic Skills and Techniques in Contact and Non-Contact Sports Tackling, blocking, dodging, passing, coordination Week 7 Midterm Break — Week 8 Safety Measures in Contact and Non- Contact Sports First aid, use of protective equipment, fair play Week 9 Personal, School and Community Health – Determinants of Health Factors: heredity, environment, lifestyle, healthcare Week 10 Characteristics of a Healthy Person Signs of good health (physical, mental, emotional, social well-being) Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS1","subject":"Christian Religious Studies (Crs)","term":"First Term","text":"Week 1 God and His Creation Who is God? (Gen. 1:1; Jer. 10:12) Week 2 The Creation Story Biblical account of creation in Genesis Week 3 The Creation of Man and Woman Genesis 2:4–24 Week 4 Purpose of Creation Reasons why God created human beings; Songs about creation Week 5 Midterm Examinations – Week 6 Marriage Meaning of marriage (Gen. 2:22-25); Functions of marriage (Eph. 5:21-31) Week 7 Midterm Break – Week 8 Marriage II Types of marriage; Importance of marriage Week 9 Disobedience I Meaning of disobedience; Adam & Eve’s disobedience (Gen. 3:1-19) Week 10 Disobedience II Consequences of Adam & Eve’s disobedience; Human disobedience and national disobedience 11–13 Revision, Examinations & Closing –"},{"page":0,"class":"JSS1","subject":"Christian Religious Studies (Crs)","term":"Second Term","text":"Week 1 Call to Repentance I Meaning of repentance; King David’s repentance (2 Sam. 12:7– 13; Psalm 51) Week 2 Call to Repentance II The people of Nineveh repent (Jonah 3:1-10) Week 3 Call to Repentance III John the Baptist calls for repentance (Luke 3:1-14) Week 4 Call to Repentance IV Jesus commends Zacchaeus (Luke 19:8); Consequences of lack of repentance (1 Sam. 3:18; 4:10-21) Week 5 Midterm Examinations – Week 6 Call to Obedience I Meaning of obedience; Abraham obeys God’s call (Gen. 12:1-9) Week 7 Midterm Break – Week 8 Call to Obedience II Abraham’s blessings (Gen. 17:1-21); Abraham’s sacrifice of Isaac (Gen. 21:1-8; 22:1-19) Week 9 Call to Service I Meaning of service; Joseph’s and Ruth’s examples (Gen. 37:12- 36; 41:37-57; Ruth 1:15; 2:7-18) Week 10 Call to Service II Lessons from Joseph & Ruth; Life in God’s service (1 Pet. 2:18- 25); Problems in service; Call to service 11–13 Revision, Examinations & Closing –"},{"page":0,"class":"JSS1","subject":"Christian Religious Studies (Crs)","term":"Third Term","text":"Week 1 Relationship in the Family I Meaning and types of family; Recognition of family members Week 2 Relationship in the Family II Roles of family members (Eph. 6:1-9; Col. 3:18-21; 1 Pet. 3:1- 7) Week 3 Relationship in the Family III Concept of a good family name (Prov. 22:1; Ecc. 7:1) Week 4 Relationship in the School I Names of members of the school; Choosing friends in school Week 5 Midterm Examinations – Week 6 Relationship in the School II Biblical examples of friendship (1 Sam. 18:1-5; Luke 11:5-13) Week 7 Midterm Break – Week 8 Relationship in the School III Importance of good friends; Consequences of bad friends (Prov. 1:10-12; 2 Thess. 3:6-13) Week 9 Relationship in the Community I Community leaders; Ways of sustaining relationships in the community Week 10 Relationship in the Church Relationship in the church; Importance of fellowship and unity 11–13 Revision, Examinations & Closing –"},{"page":0,"class":"JSS1","subject":"Islamic Religious Studies (Irs)","term":"First Term","text":"Week 1 Introduction to the Qur’an • Meaning and importance of the Qur’an• Revelation and preservation of the Qur’an• Difference between the Qur’an and Hadith Week 2 Qur’anic Recitation: Suratul Tariq (Q86:1–17) • Recitation and memorization• Translation and interpretation• Lessons on Allah’s power and human accountability Week 3 Qur’anic Recitation: Suratul Buruj (Q85:1–22) • Recitation and memorization• Explanation of meanings• Lessons on patience and steadfastness Week 4 Qur’anic Recitation: Suratul Inshiqaq (Q84:1–25) • Recitation and memorization• Explanation of meanings• Lessons on judgment and the Hereafter Week 5 MID-TERM EXAMINATION Assessment of Qur’anic Recitation and Interpretation (Surahs 84–86) Week 6 Introduction to Tajwid • Meaning and importance of Tajwid• Rules of pronunciation and fluency• Common errors in recitation Week 7 MID-TERM BREAK Holiday/Rest Week 8 Rules of Nun Sakinah and Tanwin • Idgham, Ikhfa, Izhar, Iqlab• Examples from the Qur’an• Class recitation practice Week 9 Rules of Mim Sakinah • Idgham Shafawi, Ikhfa Shafawi, Izhar Shafawi• Practical exercises using selected verses Week 10 Importance of Tajwid • Benefits of correct recitation• Role of Tajwid in preserving the Qur’an Week 11 REVISION Comprehensive review of Surahs and Tajwid rules Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Islamic Religious Studies (Irs)","term":"Second Term","text":"Week 1 Introduction to Hadith • Meaning and significance• Difference between Hadith and Sunnah• Preservation of Hadith Week 2 Hadith No. 11 (An-Nawawi Collection) • Text, translation, and interpretation• Lessons on good manners and sincerity Week 3 Hadith Nos. 12–13 • Explanation of purity, faith, and humility• Moral lessons from Hadith Week 4 Hadith Nos. 14–15 • Translation and application in daily life• Moral lessons on discipline and honesty Week 5 MID-TERM EXAMINATION Assessment on Hadith Nos. 11–15 Week 6 Healthy Social Relationships in Islam • Meaning and importance• Islamic teachings on kindness, cooperation, and unity Week 7 MID-TERM BREAK Holiday/Rest Week 8 Corruption in Islam • Meaning, forms, and dangers• Islamic stance on corruption• Role of honesty and accountability Week 9 Spirituality and Essence of Man’s Creation • Purpose of creation• Spiritual growth and worship• Duties of man on earth Week 10 Application of Islamic Ethics • Practical examples of honesty, justice, and compassion Week 11 REVISION Comprehensive review of Hadith and Tahdhib lessons Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Islamic Religious Studies (Irs)","term":"Third Term","text":"Week 1 Introduction to Fiqh • Meaning and sources of Islamic Law• Importance of Fiqh in Muslim life Week 2 Supererogatory Prayers (Nawafil) • Meaning and examples• Benefits of voluntary prayers Week 3 Prohibited Prayer Times • Times when prayers are not allowed• Exceptions and significance Week 4 Fundamental Principles of Iman • Meaning of Iman (faith)• Six Articles of Faith• Importance in Muslim life Week 5 MID-TERM EXAMINATION Assessment on Fiqh and Iman Week 6 Faith and Good Deeds • Relationship between belief and action• Avoiding hypocrisy Week 7 MID-TERM BREAK Holiday/Rest Week 8 Application of Faith • Living a faithful life through honesty, prayer, and service Week 9 Review of Qur’an and Hadith • Integration of faith and practice• Recitation exercises Week 10 Ethical Conduct in Islam • Modesty, patience, and truthfulness Week 11 REVISION Comprehensive review of Fiqh, Iman, and ethics Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Nigerian History","term":"First Term","text":"Week 1 Introduction to History Meaning; Importance; Sources of Nigerian history (oral, written, archaeology, artifacts, traditions) Week 2 Nigerian Peoples and Languages Major ethnic groups and their locations; Languages and diversity Week 3 Early Settlements in Nigeria Nok culture, Igbo-Ukwu, Ife, Benin Week 4 Origins of Nigerian Societies Myths of origin (Yoruba, Hausa, Igbo, others) Week 5 Midterm Test – Week 6 Traditional Political Systems I Yoruba kingdoms (Oyo, Ife); Igbo village democracy Week 7 Midterm Break – Week 8 Traditional Political Systems II Hausa/Fulani emirate system; Kanem-Bornu empire Week 9 Nigerian Art and Culture Traditional art forms; Festivals; Cultural identity Week 10 Early Trade and Exchange Local trade; Trans-Saharan trade; Trade routes Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Nigerian History","term":"Second Term","text":"Week 1 Islam in Nigeria Introduction; Spread; Impact on society Week 2 Christianity in Nigeria Introduction; Spread; Impact on society Week 3 European Contact with Nigeria Portuguese arrival; Missionaries; Traders Week 4 Trans-Atlantic Slave Trade Meaning; Causes; Effects on Nigeria Week 5 Midterm Test – Week 6 Abolition of Slave Trade Humanitarian movements; British involvement Week 7 Midterm Break – Week 8 Legitimate Trade Palm oil trade; Economic effects Week 9 British Conquest of Nigerian Territories Methods of conquest; Resistance by Nigerian states Week 10 Amalgamation of 1914 Reasons; Impact Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Nigerian History","term":"Third Term","text":"Week 1 Colonial Administration Indirect rule; Direct rule; Examples in Nigeria Week 2 Reactions to Colonialism I Resistance by Benin, Ekumeku, Satiru Week 3 Reactions to Colonialism II Resistance by Sokoto Caliphate, Tiv, Igbo Week 4 Education in Colonial Nigeria Missionary education; Western schools; Effects Week 5 Midterm Test – Week 6 Nationalism in Nigeria I Early nationalist leaders (Herbert Macaulay, Nnamdi Azikiwe) Week 7 Midterm Break – Week 8 Nationalism in Nigeria II Obafemi Awolowo, Ahmadu Bello, Anthony Enahoro Week 9 Nigerian Newspapers and Nationalism Role of press in independence struggle Week 10 Road to Independence Constitutional developments (Clifford, Richards, Macpherson, Lyttleton) Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Social And Citizenship Studies","term":"First Term","text":"Week 1 Citizenship • Meaning of citizenship• Ways of becoming a citizen• Importance of being a good citizen• Qualities of a responsible citizen Week 2 Rights and Duties of Citizens • Fundamental human rights• Duties and obligations of citizens• Relationship between rights and duties• Consequences of neglecting civic duties Week 3 Family as a Primary Social Group • Meaning and types of family• Roles and responsibilities of family members• Importance of family in social development• Respect and cooperation within the family Week 4 Culture and Identity • Meaning of culture and identity• Elements of culture (language, food, dressing, religion, values)• Cultural similarities and differences• Promoting unity in diversity Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 Socialization • Meaning and agents of socialization• Family, school, religion, peer group, media as agents• Importance of socialization• Effects of poor socialization Week 7 MID-TERM BREAK Holiday/Rest Week 8 Social Conflict • Meaning and causes of social conflict• Effects of conflict on individuals and society• Ways of resolving conflicts• Importance of tolerance and forgiveness Week 9 Peace Education • Meaning and importance of peace• Values that promote peace: honesty, fairness, respect• Peaceful coexistence in the community• Activities that promote peace in schools and society Week 10 Conflict Prevention and Resolution • Meaning of conflict prevention• Strategies for preventing conflict• Steps in conflict resolution• Role of government and community leaders Week 11 REVISION Review of all topics: Citizenship, culture, peace, and conflict resolution Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Social And Citizenship Studies","term":"Second Term","text":"Week 1 Environment and Sustainability • Meaning of environment• Importance of caring for the environment• Environmental problems (pollution, deforestation, erosion)• Ways to ensure environmental sustainability Week 2 Climate Change • Meaning of climate change• Causes and effects of climate change• Role of individuals in reducing climate change• Adaptation and mitigation measures Week 3 Disaster Risk Reduction • Meaning of disaster and risk reduction• Types of disasters: flood, fire, epidemic• Prevention and preparedness• Role of government and agencies Week 4 Disaster Forecasting and Early Warning Signs • Meaning of forecasting• Importance of early warning systems• Identifying early signs of disasters• Actions to take during warnings Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 Environmental Protection • Meaning and importance of protecting the environment• Simple environmental protection practices• Government and NGOs involved in environmental protection• Community involvement in environmental sanitation Week 7 MID-TERM BREAK Holiday/Rest Week 8 Response to Epidemics • Meaning of epidemic and pandemic• Examples of epidemics (cholera, COVID-19, malaria)• Causes and prevention• Personal and public health measures Week 9 Promoting Safety in Our Community • Meaning and importance of safety• Safety rules at home, school, and road• Community safety initiatives• Reporting unsafe situations Week 10 Harmful Traditional Practices • Meaning and examples: FGM, child marriage, preference for male children• Effects on health and society• Laws against harmful practices• Promoting positive cultural practices Week 11 REVISION Review: Environment, safety, disaster, and harmful traditions Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Social And Citizenship Studies","term":"Third Term","text":"Week 1 Digital Technologies • Meaning of digital technology• Examples of digital tools: phone, computer, internet• Importance of technology in learning and work• Responsible use of digital devices Week 2 Cyber and Digital Security • Meaning of cyber security• Common online risks: scams, cyberbullying, identity theft• Safe online practices• Importance of passwords and privacy Week 3 Benefits and Ideals of Money • Meaning and importance of money• Characteristics and functions of money• Right and wrong ways of acquiring money• Dangers of greed and corruption Week 4 Financial Risks and Rewards • Meaning of financial risks and rewards• Examples: savings, investment, loans• Importance of saving and budgeting• Avoiding financial scams and bad habits Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 Migration • Meaning and types of migration• Causes and effects of migration• Internal and international migration• How migration affects society Week 7 MID-TERM BREAK Holiday/Rest Week 8 Smuggling of Migrants and Irregular Migration • Meaning of smuggling and irregular migration• Dangers of irregular migration• Legal ways of traveling abroad• Government efforts to curb irregular migration Week 9 Human Trafficking • Meaning, causes, and effects of human trafficking• Forms of trafficking: labor, sexual, organ harvesting• Laws and agencies fighting trafficking (NAPTIP)• Ways of preventing trafficking and supporting victims Week 10 International Relations • Meaning of international relations• Importance of international cooperation• Role of Nigeria in global affairs• Promoting peace and mutual respect among nations"},{"page":0,"class":"JSS1","subject":"Cultural And Creative Arts","term":"First Term","text":"Week 1 Introduction to Arts Meaning and Definitions of Arts, History and Origin of Arts Week 2 Introduction to Arts (cont’d) How Arts Started in Nigeria Schools, Branches/Types of Arts, Uses of Arts in Society Week 3 Crafts Meaning of Crafts, Types, Materials, Tools/Equipment, Locations of Local Crafts Week 4 Crafts (cont’d) Uses of Crafts in Nigeria Week 5 Midterm Exams — Week 6 Tie and Dye Meaning of Tie and Dye, Methods of Tying Week 7 Midterm Break — Week 8 Paper Craft Meaning of Paper Craft, Methods of Folding Paper Week 9 Paper Craft (cont’d) Paper Craft Production, Uses of Paper Crafts Week 10 Revision — 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS1","subject":"Cultural And Creative Arts","term":"Second Term","text":"Week 1 Collage Meaning of Collage, Materials/Tools for Collage Week 2 Collage (cont’d) Production of Collage, Uses of Collage Week 3 Mosaic Meaning of Mosaic, Materials/Tools, Production of Mosaic, Uses of Mosaic Week 4 Modelling with Papier- mâché Meaning, Materials/Tools Week 5 Midterm Exams — Week 6 Modelling with Papier- mâché (cont’d) Preparation and Making, Modelling Techniques, Safety Measures Week 7 Midterm Break — Week 8 Bead Work Meaning of Bead Work, Production of Beads in Jewellery Week 9 Bead Work (cont’d) Uses of Beads as Creative Objects Week 10 Revision — 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS1","subject":"Cultural And Creative Arts","term":"Third Term","text":"Week 1 Music Theory Fundamentals of Music, Notes on the Keyboard Week 2 Ear Training and Harmony Rudiments of Harmony, Uses of Ear Training Week 3 Ear Training and Harmony (cont’d) Benefits of Ear Training Week 4 Rudiments of Music & Playing Instruments Musical Alphabets, Clef and Staves, Notes and Relative Values Week 5 Midterm Exams — Week 6 Recorder & Uses of Music Major Scales, Playing Recorder, Uses & Impact of Music in Society Week 7 Midterm Break — Week 8 Drama & Theatre Definition, Origin of Drama, People in Drama/Theatre, Functions Week 9 Elements & Playwriting Elements and Forms of Drama, Playwriting and Dramatists Week 10 The Director Meaning, Duties, and Functions of a Director 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS1","subject":"French","term":"First Term","text":"Week 1 Words used in the classroom Classroom instructions and expressions (sit down, stand up, open/close your book, etc.) Week 2 Saluer (Greeting) Forms of greetings (formal and informal), responses to greetings, polite expressions Week 3 Se présenter (Introducing oneself) Giving personal information: name, age, nationality, origin Week 4 Épeler un mot / Écrire un mot épelé Alphabet, spelling names and common words, writing dictated words Week 5 Midterm Examination Assessment on weeks 1–4 Week 6 Présenter quelqu’un Introducing someone else: “Voici…”, “Il/Elle s’appelle…”, polite forms Week 7 Midterm Break — Week 8 Décrire quelqu’un Physical description (height, color, appearance) and character traits Week 9 Parler de ses loisirs Talking about hobbies, leisure activities, likes and dislikes Week 10 Exprimer ses goûts et préférences Expressing likes/dislikes: “J’aime…”, “Je n’aime pas…”, “Je préfère…” Week 11 Revision Revision of all topics taught in the term Week 12 Examination End of term exam Week 13 Closing Result processing and holiday"},{"page":0,"class":"JSS1","subject":"French","term":"Second Term","text":"Week 1 Exprimer les propriétés des objets Describing objects: size, color, shape, texture Week 2 Demander quelque chose à quelqu’un Making polite requests, asking to see someone Week 3 Décrire les professions Common professions, names of jobs, describing what people do Week 4 Demander et donner l’heure Telling time, asking for time, daily activities linked to time Week 5 Midterm Examination Assessment on weeks 1–4 Week 6 Expliquer ce que l’on fait à certaines heures de la journée Daily routines and schedules at different times of the day Week 7 Midterm Break — Week 8 Dire les dates Days, months, giving dates Week 9 Situer un événement par rapport à un autre Sequencing events, using “avant”, “après”, “pendant” Week 10 Demander et expliquer ce que l’on fait tous les jours de la semaine Talking about weekly routines Week 11 Revision Revision of all topics taught in the term Week 12 Examination End of term exam Week 13 Closing Result processing and holiday"},{"page":0,"class":"JSS1","subject":"French","term":"Third Term","text":"Week 1 Demander et indiquer le temps qu’il fait Weather expressions, seasons, asking/telling about the weather Week 2 Exprimer la fréquence d’une activité Using adverbs of frequency (souvent, parfois, toujours, jamais) Week 3 Inviter quelqu’un Inviting, accepting and refusing invitations Week 4 Donner un ordre, interdire, autoriser Commands, prohibition, giving authorization Week 5 Midterm Examination Assessment on weeks 1–4 Week 6 Demander la permission, conseiller Asking for permission, giving advice Week 7 Midterm Break — Week 8 Expliquer une démarche à quelqu’un Giving directions or explaining a procedure Week 9 Revision of Communicative Functions Integrating learned topics in dialogues and role plays Week 10 Practice of Written/Oral French Guided writing, comprehension, conversation Week 11 Revision Revision of all topics taught in the term Week 12 Examination End of term exam Week 13 Closing Result processing and holiday"},{"page":0,"class":"JSS1","subject":"Intermediate Science","term":"First Term","text":"Week 1 Introduction to Intermediate Science • Meaning and importance of science • Branches and scope of science • The role of science in everyday life • Attitudes of a good scientist Week 2 Environmental Degradation: Erosion • Meaning and types of erosion • Causes and effects of erosion • Preventive measures (terracing, tree planting, contour ridges) • Simple demonstration of soil erosion Week 3 Environmental Degradation: Flooding • Meaning and causes of flooding • Effects of flooding on the environment and human life • Flood control measures • Community roles in flood prevention Week 4 Environmental Degradation: Bush Burning • Meaning of bush burning • Causes and effects on soil, air, and living organisms• Alternatives to bush burning • Importance of environmental conservation Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Climate and Weather • Difference between climate and weather • Factors affecting weather • Measuring weather elements • Effects of weather on farming and human activities Week 8 Environmental Protection • Meaning and importance of environmental protection • Individual and community roles• Government agencies (NESREA, FEPA, etc.) • Activities that promote sustainability Week 9 Sanitation and Waste Management • Meaning of sanitation and waste • Types and sources of waste • Waste disposal methods • Recycling and reusing waste materials Week 10 Review on Environmental Degradation • Summary of erosion, flooding, and bush burning • Preventive measures • Project: Drawing and labeling a scene of an eroded area or floodplain Week 11 REVISION Review of all topics covered in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Intermediate Science","term":"Second Term","text":"Week 1 Matter – Basic Concepts • Meaning of matter • States of matter: solid, liquid, gas • Properties of each state • Changes in states: melting, freezing, evaporation, condensation Week 2 Living Matter • Meaning and characteristics of living things • Examples of plants and animals • Growth, respiration, and reproduction in living things • Differences between living and non-living matter Week 3 Non-Living Matter • Meaning and examples • Physical and chemical properties • Importance of non-living matter in our environment • Relationship between living and non-living matter Week 4 Energy • Meaning and forms of energy (light, heat, sound, kinetic, potential) • Energy transformations • Sources and uses of energy • Importance of energy in everyday life Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Renewable Energy • Meaning and examples: solar, wind, hydro, biomass • Importance and advantages of renewable energy • Local sources and simple demonstrations • Limitations of renewable energy sources Week 8 Non-Renewable Energy • Meaning and examples: coal, petroleum, natural gas • Uses of non-renewable energy • Effects on the environment • Conservation measures Week 9 Energy Conversion and Conservation • Energy conversion (mechanical to electrical, etc.)• Law of conservation of energy • Energy-saving habits • Experiment: Demonstration of energy change Week 10 Review on Matter and Energy • Summary of matter, living and non-living things • Renewable vs. non-renewable energy • Practical revision exercises Week 11 REVISION Review of all topics covered in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS1","subject":"Intermediate Science","term":"Third Term","text":"Week 1 Skill Acquisition • Meaning and importance of skill acquisition • Types of vocational skills (technical, agricultural, home economics, ICT) • Benefits of practical skills to national development • Entrepreneurship awareness Week 2 Ethical Issues in Science and Development • Meaning of ethics • Positive and negative use of science and technology • Responsible use of technology • Ethical concerns: pollution, cloning, genetic modification Week 3 Familiarisation Tour of the Laboratory and Workshop • Meaning and purpose of laboratories and workshops • Rules and regulations • Identification of laboratory and workshop areas • Laboratory symbols and safety signs Week 4 Workshop Accidents and Safety • Common causes of accidents in workshop • Safety rules and precautions • First aid in workshop accidents • Teacher demonstration: using basic protective equipment Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Materials: Wood, Metals, Ceramics, and Building Materials • Types and properties of common materials • Uses in science and technology • Advantages and disadvantages • Identifying materials through observation Week 8 Workshop Processes: Drawing Practice • Meaning of drawing in science and technology • Types of drawings (freehand, technical) • Drawing instruments and their uses • Simple exercises on lines and shapes Week 9 Workshop Processes: Board Practice • Meaning of board practice • Tools and materials used • Simple layout and lettering on drawing boards • Safe handling of instruments Week 10 Machines and Tools: Woodwork & Metalwork Hand Tools • Identification of basic tools • Functions and uses of each tool • Maintenance and storage of tools and machines • Simple demonstrations Week 11 REVISION Review of all topics covered in Term"},{"page":0,"class":"JSS1","subject":"Digital Technologies","term":"First Term","text":"Week 1 Introduction to Digital Technology • Meaning of digital technology • Importance in modern life • Examples of digital devices Week 2 Historical Development of Digital Devices • Early calculating tools (Abacus, Napier’s Bones) • Generations of computers • Evolution from analog to digital devices • Modern digital trends Week 3 Career Opportunities in Information Technology • Careers in ICT: software, hardware, networking, data • Emerging digital careers (AI, cybersecurity, robotics) • Skills needed for IT careers Week 4 Basic Computer Hardware Components I • Meaning of hardware • Input and output devices • Functions and identification of devices • Simple maintenance practices Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Basic Computer Hardware Components II: Storage Units • Primary and secondary storage • Examples: RAM, ROM, hard disk, flash drive • Storage measurements (bit, byte, MB, GB, TB)"},{"page":0,"class":"JSS1","subject":"Digital Technologies","term":"Second Term","text":"Week 1 MS PowerPoint (Introduction) • Meaning and uses of presentation software • Creating and saving slides • Adding text, images, transitions Week 2 3D Modelling with Paint 3D • Introduction to Paint 3D • Drawing basic shapes and models • Saving and exporting 3D projects Week 3 Data Processing • Meaning and stages of data processing • Manual vs. electronic data processing • Importance in real-life applications Week 4 Basic Computer Communication • Meaning and importance of communication • Types: wired and wireless • Introduction to the Internet Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Introduction to Computer Networks • Definition of a network • Components: computers, cables, routers • Benefits of networking Week 7 MID-TERM BREAK Holiday/Rest Week 8 Basic Internet Concepts • Meaning of Internet • Common terms: website, URL, browser, search engine • Responsible Internet use Week 9 Online Safety Rules"},{"page":0,"class":"JSS1","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Internet Communication Practices • Meaning of Internet communication • Email, instant messaging, video conferencing • Netiquette Week 2 Spam and Online Threats • Meaning of spam • Common online scams • Preventive measures Week 3 Intellectual Property • Meaning of intellectual property • Copyright, trademark, and plagiarism • Respecting digital content ownership Week 4 Safety and Security Features on Digital Devices • Antivirus software • Screen locks, firewalls, parental controls • Device maintenance Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Introduction to Graphic Design • Meaning and importance of graphic design • Elements of design: color, shape, typography Week 7 MID-TERM BREAK Holiday/Rest Week 8 Introduction to Canva • Getting started with Canva • Creating and editing designs • Templates and customization Week 9 Digital Media • Meaning and types of digital media"},{"page":0,"class":"JSS1","subject":"Business Studies","term":"First Term","text":"Week 1 Overview of Business Studies Meaning of Business Studies; Components of Business Studies; Importance/Benefits of Business Studies; Career opportunities Week 2 Effective Office Practice I The office: meaning, types, and functions Week 3 Effective Office Practice II The office staff – clerical staff, functions, qualities Week 4 Right Attitude to Work Punctuality and regularity; Rewards and punishment; Devotion to duty; Effects on productivity and development Week 5 Midterm Examination — Week 6 Departments in an Office/Organisation Various departments in an organisation and their functions Week 7 Midterm Break — Week 8 Commerce – The Heart of Business I Introduction, meaning, importance of commerce; Activities that aid commerce (aids to trade) Week 9 Commerce – The Heart of Business II Divisions of commerce – Home trade, foreign trade (imports, exports, entrepôt) Week 10 Production I Meaning and stages (types) of production; Effects on society and environment 11–13 Revision / Examination / Closing —"},{"page":0,"class":"JSS1","subject":"Business Studies","term":"Second Term","text":"Week 1 Production II Factors of production – meaning, types, rewards, features, importance Week 2 Types of Occupation Meaning of occupation; Types – direct and indirect services; Factors influencing occupation Week 3 Honesty in Business Meaning of truthfulness; Attributes; Causes of dishonesty; Rewards/consequences Week 4 Fairplay and Ethics of Business Fairplay; Meaning of ethics; Ethics guiding sourcing of chemicals; Meaning and facts about chemicals; Safe handling, distribution, and disposal Week 5 Midterm Examination — Week 6 Entrepreneurship Meaning of entrepreneurship, enterprise, self- employment; Successful entrepreneurs (local, national, international); Importance Week 7 Midterm Break — Week 8 Forms of Business Organisation I Sole proprietorship; Partnership Week 9 Forms of Business Organisation II Limited liability companies; Co-operative societies; Advantages and disadvantages Week 10 Consumer, Market and Society Meaning of consumer, market, society; Consumer education – meaning, need, importance, consequences of lack of it 11–13 Revision / Examination / Closing —"},{"page":0,"class":"JSS1","subject":"Business Studies","term":"Third Term","text":"Week 1 Book-keeping as a Tool in Business I Introduction to book-keeping; Meaning; Importance; Qualities of a good book-keeper; Common practices Week 2 Source Documents and Special Journals I Meaning/Uses of source documents; Types of source documents Week 3 Source Documents and Special Journals II Journals: meaning, types; Format of a sales journal Week 4 Double Entry Book- keeping Meaning; Treatment of assets, liabilities, expenses; Meaning and format of ledger; Classification of accounts Week 5 Midterm Examination — Week 6 Keyboarding as a Communication Tool I Introduction to keyboarding; Meaning; Importance; Correct sitting posture Week 7 Midterm Break — Week 8 Keyboarding as a Communication Tool II The typewriter – meaning, types, parts; Computer keyboard – meaning, uses, similarities with typewriter Week 9 Keyboarding as a Communication Tool III Care of the computer; Items used; Getting ready to keyboard (paper sizes, techniques, rows, divisions) Week 10 Keyboarding as a Communication Tool IV Alphanumeric keys; Service keys; Function keys; Control keys; Special keys and their functions; Spacing and punctuation marks; Short forms 11–13 Revision / Examination / Closing —"},{"page":0,"class":"JSS1","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"First Term","text":"Week 1 Introduction to Solar Photovoltaic (PV) System • Meaning and importance of solar energy • Difference between solar and other sources of energy • Components of a basic PV system • Advantages of solar energy in homes and schools Week 2 Electrical Appliances Power Load / Load Sizing • Meaning of load • Identifying electrical appliances in homes and schools • Calculating total power load (Wattage) • Estimating energy consumption using power ratings Week 3 Electrical Safety Precautions • Definition of electrical safety • Causes of electrical accidents • Basic rules for safe use of electricity • First aid procedures for electric shock victims Week 4 Safety Precautions in Handling Solar PV System Materials • Safe handling of solar panels, batteries, and cables • Storage and maintenance of solar PV tools • Use of safety kits (gloves, goggles, boots) • Environmental considerations in handling PV materials Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Solar PV Components: Solar Panels • Meaning and function of solar panels • Types of solar panels (Monocrystalline, Polycrystalline, Thin film) • Installation position and direction • Cleaning and maintenance of panels Week 7 MID-TERM BREAK • Rest / Practical Catch-up Activities"},{"page":0,"class":"JSS1","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Second Term","text":"Week 1 Review of First Term Work • Recap of solar components and their functions • Review of load sizing and safety precautions • Correction of common errors in handling PV materials Week 2 Concept of Entrepreneurship • Meaning of entrepreneurship • Importance of entrepreneurship in renewable energy • Characteristics of a good entrepreneur • Entrepreneurial opportunities in solar energy Week 3 Concept of Money • Meaning and functions of money • Importance of money in business • Sources of business capital • Role of money management in entrepreneurship Week 4 Bookkeeping in Solar PV Installation and Maintenance • Meaning of bookkeeping • Simple record keeping in solar business • Recording income and expenditure • Preparing simple daily sales records Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Business Start-Up in Solar PV Installation and Maintenance • Steps in starting a small solar business • Identifying customer needs • Marketing solar products and services • Business ethics and customer relations Week 7 MID-TERM BREAK • Rest / Practical Activities Week 8 Marketing in Solar PV Installation and Maintenance (Goods and Services) • Meaning of marketing • Types of marketing (goods/services)"},{"page":0,"class":"JSS1","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Third Term","text":"Week 1 Review of Second Term Work • Recap of entrepreneurship and bookkeeping concepts • Review of marketing strategies • Assessment of safety and maintenance practices Week 2 Introduction to Renewable Energy • Meaning of renewable energy • Difference between renewable and non- renewable energy • Advantages of renewable energy • Sources of renewable energy: solar, wind, water, biomass Week 3 Principles of Solar Energy • Meaning of solar energy • How solar energy is generated • Conversion of sunlight to electricity • Importance of solar power in daily life Week 4 Components of Solar PV Systems • Review of solar panels, batteries, inverters, and charge controllers • Connecting solar components • Identifying faults in basic solar circuits • Practical demonstration: assembling a mini- solar setup Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Energy Storage Systems • Understanding energy storage • Functions of batteries in solar systems • Types of batteries used in solar PV • Battery maintenance and safety Week 7 MID-TERM BREAK • Rest / Practical Projects Week 8 Power Distribution and Load Management • Meaning of power distribution • Understanding DC and AC power"},{"page":0,"class":"JSS1","subject":"Fashion Design And Garment Making","term":"First Term","text":"Week 1 Introduction to Garment Making Meaning and importance of garment making; Career opportunities in garment making Week 2 Sewing Tools and Equipment Types of sewing tools and equipment; Uses and identification; Care and arrangement of tools Week 3 Sewing Machine Meaning and types of sewing machines; Simple parts of the sewing machine Week 4 Parts of the Sewing Machine and Their Functions Main parts and their functions; Operating the machine correctly Week 5 Mid-Term Examination — Week 6 Handling and Maintenance of Sewing Tools and Equipment Cleaning and oiling the sewing machine; Proper storage and safety practices Week 7 Midterm break - Week 8 Basic Sewing Techniques Running, tacking, hemming, overcasting, and back stitches Week 9 Fibres and Fabrics Meaning and classification of fibres (natural and synthetic); Examples of fabrics 10. Fabric Identification Methods of identifying fabrics (touch, sight, and burn test); Uses of fabrics 11. Simple Garment Sketching Introduction to freehand sketching; Basic shapes in garment sketching 12. Revision & Examination Review of term’s work 13. Closing —"},{"page":0,"class":"JSS1","subject":"Fashion Design And Garment Making","term":"Second Term","text":"Week 1 Taking Body Measurements Body parts for measurement; Tools for measurement; Accurate measuring methods Week 2 Pattern Drafting Meaning and importance of pattern drafting; Basic pattern symbols Week 3 Methods of Obtaining Pattern Flat pattern, draping, and freehand methods Week 4 Drafting Basic Patterns Simple drafting of skirt, blouse, and shorts patterns Week 5 Mid-Term Examination Week 6 Cutting and Sewing with Drafted Patterns Correct laying and cutting of patterns; Seam allowance and joining Week 7 Mid-Term Break — Week 8 Sewing Simple Garment Practical sewing of simple garments such as apron, pillowcase, or skirt Week 9 Finishing Techniques Seam finishing, neatening edges, and hemming 10. Pressing and Ironing Tools used for pressing; Correct ironing of garments 11. Digital Sketching Platforms (Introduction) Introduction to digital drawing tools (AutoDraw, Canva, Tinkercad, etc.) 12. Revision & Examination Review of term’s work 13. Closing —"},{"page":0,"class":"JSS1","subject":"Fashion Design And Garment Making","term":"Third Term","text":"Week 1 Introduction to Digitization in Garment Making Meaning of digitization; Benefits of technology in fashion Week 2 Digital Sketching Platforms (Practical) Digital tools for creating garment sketches; Practice session Week 3 Digital Portfolios Meaning and importance of portfolios in fashion; Components of a digital portfolio Week 4 Creating a Digital Portfolio Steps in setting up a portfolio; Uploading sketches and photos Week 5 Mid-Term Examination Week 6 Putting Works in the Digital Portfolio Arranging and organizing completed works in digital format Week 7 Mid-Term Break - Week 8 Review of Garment Production Process Summary of steps from sketching to finishing a garment Week 9 Career Opportunities in Fashion Careers in garment making and fashion design 10. Project Work Simple digital portfolio and sewn garment presentation 11. Revision — 12. Examination — 13. Closing —"},{"page":0,"class":"JSS1","subject":"Livestock Farming","term":"First Term","text":"Week 1 Introduction to Livestock Farming Meaning and importance of livestock farming; Types of livestock animals; Benefits of livestock to humans Week 2 Types of Poultry Birds Meaning of poultry; Common types — chicken, turkey, duck, guinea fowl, pigeon, quail; Uses of poultry birds Week 3 Breeds of Poultry Birds Local and exotic breeds (layers, broilers, cockerels); Characteristics of each breed Week 4 Poultry Housing Types of poultry houses; Requirements of a good house; Construction materials Week 5 Mid-Term Examination — Week 6 Poultry Equipment Types (feeders, drinkers, brooders, laying nests, perches); Uses and maintenance Week 7 Mid-Term Break — Week 8 Poultry Management Practices Daily care and management of chicks, growers, and layers; Sanitation and record-keeping Week 9 Poultry Diseases and Control Common diseases (Newcastle, Coccidiosis, Fowl Pox); Symptoms, prevention, and control Week 10 Classification of Feed Ingredients Meaning of feed; Ingredients (protein, carbohydrate, vitamins, minerals); Feed formulation Week 11 Revision Review of term’s work and practicals Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS1","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Introduction to Rabbit Production Importance of rabbits; Characteristics and benefits of rabbit rearing Week 2 Breeds of Rabbit Local and exotic breeds (New Zealand White, Chinchilla, Dutch, etc.); Characteristics and uses Week 3 Rabbit Housing Types of hutches; Materials used; Requirements of a good hutch Week 4 Rabbit Feeds Types of feeds — concentrates and roughages; Feeding schedules and water management Week 5 Mid-Term Examination — Week 6 Health Management in Rabbits Common diseases, symptoms, prevention, and control Week 7 Mid-Term Break — Week 8 Reproduction in Rabbits Mating process, gestation, kindling, and weaning Week 9 Record Keeping in Rabbitry Importance; Types of records (feeding, breeding, sales) Week 10 Handling and Management Practices Handling methods, grooming, sanitation, and waste disposal Week 11 Revision Practical demonstration: feeding, cleaning, and maintenance Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS1","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Concept of Sheep and Goat Production Meaning, importance, and uses of sheep and goats; Differences between sheep and goats Week 2 Breeds of Sheep and Goats Local and exotic breeds — West African Dwarf, Yankasa, Sokoto Red, etc. Week 3 Housing and Equipment for Sheep and Goats Types of housing; Feeding and watering equipment Week 4 Feeds for Sheep and Goats Common feed ingredients; Grazing, browsing, and supplementary feeding Week 5 Mid-Term Examination — Week 6 Health Management in Sheep and Goats Common diseases and parasites; Causes, symptoms, and control Week 7 Mid-Term Break — Week 8 Sick Sheep or Goat in a Herd Identification and isolation of sick animals; Treatment and record-keeping Week 9 Breeding in Sheep and Goats Mating systems; Gestation period; Care of pregnant animals and young ones Week 10 Practical: Identifying Feeds and Breeds Recognition and classification exercises; Field observation Week 11 Revision Review of term’s work and key livestock practices Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS1","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Introduction to Beauty and Cosmetology Meaning, origin, and importance of beauty and cosmetology. Week 2 Tools and Equipment Identification and uses of comb, brush, mirror, apron, towel, and hair dryer. Week 3 Personal Hygiene and Grooming Importance of cleanliness and daily grooming routines. Week 4 Safety Precautions in the Salon Safety measures in handling tools and electrical appliances. Week 5 Midterm Examination Week 6 Basic Hair Care Practices Brushing, washing, and simple styling of natural hair. Week 7 Midterm Break Week 8 Skin Care and Cleansing Steps in facial cleansing and types of skin. Week 9 Nail Care Simple manicure and pedicure procedures. Week 10 Introduction to Makeup Meaning and types of makeup; makeup tools. Week 11 Simple Makeup Techniques Application of facial powder, lip gloss, eyebrow shaping (theory only). Week 12 Revision Review of major topics. Week 13 Examination / Closing"},{"page":0,"class":"JSS1","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Review of First Term’s Work Recap of basic beauty concepts and hygiene. Week 2 Hair Structure and Function Parts of the hair and their functions. Week 3 Hair Types Identification of straight, curly, and kinky hair. Week 4 Hair Treatment Washing, conditioning, and natural treatment. Week 5 Midterm Examination Week 6 Simple Hair Styling Tools and techniques for plaiting and weaving. Week 7 Midterm Break Week 8 Introduction to Skin Care Products Soaps, creams, and lotions and their proper use. Week 9 Facial Treatment Steps: cleansing, steaming, exfoliation, and toning. Week 10 Nail Care Tools and Safety Proper use and cleaning of manicure/pedicure tools. Week 11 Customer Care in Beauty Services Attitude, communication, and courtesy with clients. Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS1","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Review of Second Term Work Overview of hair and skin care. Week 2 Advanced Hair Styling Weaving, threading, and cornrow patterns. Week 3 Introduction to Beauty Products Identifying safe and harmful ingredients. Week 4 Daily Skin Care Routine Cleansing, toning, and moisturizing. Week 5 Midterm Examination Week 6 Nail Art Simple decoration and color combination. Week 7 Midterm Break Week 8 Salon Hygiene and Sanitation Keeping the salon clean and free of infection. Week 9 Professional Conduct Courtesy, honesty, and confidentiality with clients. Week 10 Entrepreneurship in Beauty Care Simple business ideas and record keeping. Week 11 Revision Project Group or practical revision. Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS1","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Introduction to Computer Hardware & GSM Repairs Meaning, importance, career opportunities Week 2 History of Computers & GSM Development of computers and mobile phones Week 3 Basic Computer Hardware Components Input, output, processing, storage devices Week 4 Identification of GSM Components Screen, keypad, battery, SIM, circuit board Week 5 Midterm Test – Week 6 Safety Precautions in Workshop Handling tools, electricity, ESD safety Week 7 Midterm Break – Week 8 Tools for Computer & GSM Repairs Screwdrivers, testers, soldering iron, pliers Week 9 Peripheral Devices Printers, scanners, flash drives Week 10 Basic Care & Maintenance of Computer/GSM Cleaning, charging, battery care Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 Classification of Computers Digital, analogue, hybrid; sizes and uses Week 2 Types of Mobile Phones Feature phones vs. smartphones Week 3 System Unit Parts Motherboard, CPU, RAM, power supply Week 4 SIM Cards & Memory Cards Types, uses, care Week 5 Midterm Test – Week 6 Introduction to Software System vs. application software Week 7 Midterm Break – Week 8 Power Supply in Computers and Phones Batteries, chargers, UPS Week 9 Basic Troubleshooting Computer not booting, phone not charging Week 10 Practical: Disassembling a Phone Opening and identifying parts Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Computer Storage Devices Hard disk, SSD, flash drives, memory cards Week 2 GSM Networks 2G, 3G, 4G, 5G Week 3 Assembling a Simple Computer Step-by-step practice Week 4 Common GSM Problems Screen damage, battery fault Week 5 Midterm Test – Week 6 Practical: Replacing GSM Parts Battery, screen, keypad Week 7 Midterm Break – Week 8 Introduction to Soldering Tools and safety Week 9 Practical: Soldering Simple Joints Circuit connection Week 10 Preventive Maintenance Regular servicing of computer & GSM Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS1","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Introduction to Crop Production  Importance of crop production to national economy Week 2 Farm Tools and Safety Measures  ommon farm tools and their uses  Maintenance of farm tools  Safety precautions on the farm  First aid and emergency procedures Week 3 Farmland Preparation Practices  Importance of farmland preparation  Stages: clearing, ploughing, harrowing, ridging  Farm layout and land demarcation  Tools used in each stage Week 4 Soil and Its Properties  Meaning and types of soil  Importance of soil to crop production  Physical properties: colour, texture, structure  Effects of soil on crop growth Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Soil Texture and Structure  Determining soil texture and structure  Importance of soil texture to crop type  Soil management practices  Soil testing (simple classroom activity) Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Site Selection and Crop Types  Factors influencing site selection  Classification of crops based on lifespan  Types of crops (arable, horticultural, plantation)  Suitable sites for different crops Week 9 Crop Classification  Food crops, cash crops, industrial crops  Annual, biennial, perennial crops  Importance of crop classification"},{"page":0,"class":"JSS1","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Introduction to Horticulture Meaning of horticulture Branches: floriculture, olericulture, pomology Importance and scope of horticulture Career opportunities Week 2 Nursery Establishment (Part 1) Meaning and importance of nursery Types of nursery Site selection and tools used Steps in establishing a nursery Week 3 Nursery Bed Preparation Meaning and purpose of nursery bed Materials and tools for bed preparation Soil sterilization and watering Practical demonstration Week 4 Fertilizer Application Meaning and types of fertilizers Methods of fertilizer application Importance of balanced fertilization Effects of misuse of fertilizer Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Seed Collection and Dormancy Breaking Meaning of seed collection Reasons for seed dormancy Methods of breaking dormancy Storage of viable seeds Week 7 MID-TERM BREAK Holiday/Rest Week 8 Rootstock Preparation"},{"page":0,"class":"JSS1","subject":"Horticulture And Crop Production","term":"Third Term","text":"Week 1 Vegetative Propagation in Horticultural Crops  Meaning of vegetative propagation  Methods: cutting, layering, grafting, budding  Advantages and disadvantages Week 2 Practical Session on Vegetative Propagation  Demonstration of grafting, budding, layering  Tools and materials used  Maintenance of propagated crops Week 3 Post-Harvest Management of Vegetables  Harvesting methods  Sorting and grading  Packaging and storage  Transportation and marketing Week 4 Concept of Entrepreneurship in Horticulture  Meaning and importance of entrepreneurship  Entrepreneurial skills in crop production  Examples of successful agripreneurs Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Concept of Money  Meaning and functions of money  Types of money and uses  Money management and savings Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Book Keeping in Horticulture and Crop Production  Meaning of bookkeeping  Types of farm records  Simple profit and loss record  Importance of bookkeeping Week 9 Business Start-Up in Horticulture  Meaning and stages of business start- up  Business plan preparation"},{"page":0,"class":"JSS2","subject":"English Studies","term":"First Term","text":"Week 1 Listening and Speaking – Revision of pure vowel sounds Revision of Parts of Speech – Nouns, Pronouns, Verbs and Adjectives Review of the SQ3R reading technique Writing an outline for a Narrative Essay – How I Spent My Last Holiday Review of features of prose (setting, theme, characterization) Week 2 Revision of consonant sounds with emphasis on consonant clusters Transitive and Intransitive Verbs Reading to understand the writer’s purpose Descriptive Essay – Writing an outline on A Place of Interest I Visited Use the recommended text on prose Week 3 Listening and Speaking – The sound (ear, clear, hear, bear, etc.) More on Active and Passive Voice Identifying words that show the writer’s intention on contemporary issues (e.g. corruption); Vocabulary Development – Word families (in the hospital) Elements of Composition – Pre-writing, writing, editing, body and conclusion Features of folktales (didactic, entertaining, riddles); Use the recommended text on prose Week 4 The / ǝᴜ / sound (go, blow, mow, know...) More on Tenses (Present, Past and Future) Critical Reading – Meaning and steps; Vocabulary Development – Word families (the police officer’s job) Descriptive Essay – A Local Festival Use the recommended text on prose Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination"},{"page":0,"class":"JSS2","subject":"English Studies","term":"Second Term","text":"Week 1 Revision of Diphthongs Reported Speech – Rules guiding the use of reported speech Reading to provide alternative words that fit into context to replace target words Report Writing – Outline and features Use the recommended text on prose Week 2 Intonation – Identification of patterns in statements, questions and commands Making sentences with Prepositions Reading for speed (avoidance of vocalizations, regressive reading, phrase reading) Report Writing – An Accident I Witnessed Themes and Characterization in the recommended prose text Week 3 Stress and Intonation – Making statements, giving commands and asking questions with different intonation patterns Regular and Irregular Verbs Skimming and Scanning techniques for speed reading Informal Letter – A Letter to a Friend about Your School Inter-Sports Use the recommended text on drama Week 4 Stress – Identifying correct points of pauses in words (e.g. import/Import) Reported Commands and Dialogue Vocabulary Development – ICT Formal Letter – To the Local Government Chairman about a Flood Menace in Your Area Use the recommended drama text (Language, Setting and Characterization) Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Rhythm – Identification of appropriate rhythm in a given poem Reported Requests Distinguishing facts and opinions in passages Argumentative Essay – Herbal Medicines are More Potent than Orthodox Medicines Identification of figures of speech in the recommended prose text"},{"page":0,"class":"JSS2","subject":"English Studies","term":"Third Term","text":"Week 1 Revision of Stress and Intonation The use of conjunctions – although and whereas as contrasts Reading to understand the writer’s purpose by identifying keywords in a passage Review of Formal and Informal Letters Review of Literary Terms and Figures of Speech Week 2 Consonant sounds /t/, /d/, /p/, /s/, /b/ in initial, medial, and final positions Using despite and in spite of with examples Reading to summarize key ideas from paragraphs Report Writing Use of recommended prose text; Themes in Myths and Legends Week 3 Consonant sounds /ʃ/ and /ʧ/ as in sheep/cheap and mash/march The uses of have, has, and had Reading to infer author’s intention in a passage Composition – Pride Goes Before a Fall Characterization, Theme, and Diction in recommended prose; Write a story on Honesty and Fair Play Week 4 Consonant sounds /θ/ and /ð/ as in think/father and mouth/lathe Synonyms with examples Identifying words/expressions that signal or redirect attention to main points Composition – The Responsibilities of Government. Recommended prose text; Writing a simple poem on Laziness Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Consonant sounds /w/ and /j/ as in wonder/university and win/yellow Antonyms with examples As in Week 1; Vocabulary Development – Conflict Resolution Composition – A Memorable Journey I Once Made Moral lessons in recommended prose text; Setting and Plot Week 7 Midterm Break Midterm Break Midterm Break Midterm Break Midterm Break"},{"page":0,"class":"JSS2","subject":"Mathematics","term":"First Term","text":"Week 1 Basic Operation of Integers / Whole Numbers I Whole numbers in standard forms; decimal numbers in standard forms. Week 2 Basic Operation of Integers / Whole Numbers II I. Prime factors and applications in solving problems. II. Continuation of operations on whole numbers with emphasis on addition, subtraction, multiplication, and division. Week 3 LCM & HCF Lowest Common Multiple (LCM); Highest Common Factor (HCF); introduction to square and square roots; application in quantitative reasoning. Week 4 Fractions – Transactions in Homes and Offices Expressing fractions as ratios, decimals, and percentages; application of fractions in daily transactions; quantitative reasoning on fractions, ratios, and percentages. Week 5 Midterm Examination — Week 6 Approximation Approximation of numbers to decimal places, significant figures, whole numbers, nearest tens, hundreds, thousands, tenths, hundredths, and thousandths; application in quantitative reasoning. Week 7 Midterm Break — Week 8 Directed and Non- Directed Numbers Definition and examples of directed and non-directed numbers; use of square and square root tables. Week 9 Multiplication and Division of Directed Numbers Multiplication and division of directed and non-directed numbers with practical exercises. Week 10 Algebraic Expressions I Definition of algebraic expressions with examples; expression of algebraic forms; factorization of simple algebraic expressions. Week 11 Algebraic Expressions II Expansion and factorization of quadratic expressions; definition of algebraic fractions; addition and subtraction of algebraic fractions with whole number denominators; application of quantitative reasoning in solving algebraic fraction problems. Week 12 Revision and Examination General revision of all topics taught during the term followed by end-of-term examination and closing activities. Week 13 Closing"},{"page":0,"class":"JSS2","subject":"Mathematics","term":"Second Term","text":"Week 1 Review of First Term’s Work Emphasis on algebraic expressions, solving of quadratic equations, and transactions at home and offices. Week 2 Simple Equations Meaning of algebraic equations; differences between algebraic expressions and algebraic equations; solving problems on simple algebraic equations. Week 3 Linear Inequalities I Definition of linear inequalities; introduction to symbols and basic properties of inequalities. Week 4 Linear Inequalities II Word problems leading to simple inequalities in one variable; solving and interpreting results. Week 5 Midterm Examination — Week 6 Graphs I Graphical representation; graphs of Cartesian plane (the axis); introduction to graphs of linear equations in two variables. Week 7 Midterm Break — Week 8 Graphs II Plotting of linear graphs in two variables from real-life situations; solving quantitative reasoning problems on graphs. Week 9 Plane Figures/Shapes Identifying plane shapes in the environment; properties of plane shapes e.g. square, rectangle, parallelogram, rhombus, and kite. Week 10 Scale Drawing of Length and Distances Meaning and purpose of scale drawing; measurement and representation on paper. Week 11 Quantitative Aptitude Meaning of quantitative aptitude; reasons for studying it; solving problems related to plane shapes/figures and scale. Week 12 Revision and Examination General revision of all topics taught during the term and Second Term Examination Week 13 Closing Vacation activities."},{"page":0,"class":"JSS2","subject":"Mathematics","term":"Third Term","text":"Week 1 Revision of Second Term’s Examination Representation of real-life situations on a graph and reasons. Week 2 Angles and Polygons Definition of angles; construction of more angles (75°, 105°, 120°, 135° etc.); definition of polygon with examples; sum of interior angles of a regular polygon as (2n − 4) right angles; solving problems on interior angles of convex polygons. Week 3 Angles of Elevation and Depression Definition of angle of elevation with practical illustrations; solving problems by measuring angles of elevation; definition of angle of depression with practical examples; calculating distances and heights using scale drawings; solving quantitative aptitude problems on angles. Week 4 Bearings and Distances I Identifying the cardinal points; locating positions of objects; finding distances and bearings using scale drawing. Week 5 Midterm Examination — Week 6 Bearings and Distances II Constructing triangles (2 sides & included angle, 2 angles & included side, 3 sides); bisecting given angles. Week 7 Midterm Break — Week 8 Statistics I – Data Presentation Collecting data from home, school, church, and market; presenting data in ordered forms and frequency tables. Week 9 Statistics II – Graphical Representation Plotting pie charts; interpreting data and stating their usefulness in everyday life. Week 10 Probability Definition of probability as chances/events; importance and usefulness in daily activities; examples of chances/events; generating events using ludo and tossing of coins; solving simple problems; calculating probability of events from experiments. Week 11 Revision General revision of all topics taught during the term. Week 12 Examination Third Term Examination. Week 13 Vacation End of session activities."},{"page":0,"class":"JSS2","subject":"Physical & Health Education","term":"First Term","text":"Week 1 Posture Meaning of Posture Week 2 Posture Appropriate Posture in Sitting, Standing, Walking and Lifting Week 3 Postural Defects Types of Postural Defects Week 4 Issues & Challenges in Physical & Health Education Meaning, Issues and Challenges Week 5 Midterm Exams — Week 6 Human Trafficking Meaning, Health Implications on Victims Week 7 Midterm Break — Week 8 Human Trafficking Solutions to Human Trafficking Week 9 Sports Laws Sports Laws Week 10 Recreation & Leisure Meaning and Types of Recreational Activities 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS2","subject":"Physical & Health Education","term":"Second Term","text":"Week 1 Recreation & Leisure Demonstration of Recreational Activities Week 2 Dance Activities Dramatic & Creative Rhythms – Explanation & Demonstration Week 3 Dance Activities Types of Dance Activities Week 4 Computer Games Meaning and Types of Computer Games Week 5 Midterm Exams — Week 6 Table Tennis History & Development; Equipment and Facilities Week 7 Midterm Break — Week 8 Table Tennis Officials and their Duties Week 9 Tennis History & Development; Facilities and Equipment Week 10 Tennis Scoring System, Officials and Terminologies 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS2","subject":"Physical & Health Education","term":"Third Term","text":"Week 1 Accidents & Safety Meaning of Accidents; Safety Measures at Home, School, Sports Ground, and on the Road Week 2 Sports Injuries Meaning, Types and Causes of Sports Injuries Week 3 First Aid First Aid Treatment for Common Injuries Week 4 Preventive Measures Measures for Preventing Sports Injuries (merged with First Aid) Week 5 Midterm Exams — Week 6 Personal, School & Community Health School Health Programme; Personal and Community Health Week 7 Midterm Break — Week 8 School Health Programme Components; FRESH Approach Week 9 Environmental Pollution Types of Environmental Pollution; Preventive Measures Week 10 Non-communicable Diseases Meaning and Nature of Common Non-communicable Diseases 11–13 Revision, Examination & Closing —"},{"page":0,"class":"JSS2","subject":"Christian Religious Studies","term":"First Term","text":"Week 1 The Annunciation Isa. 9:6-7; Matt 1:22-23; Luke 1:30-33 Week 2 The Birth of Jesus Matt 1:18-25; Luke 2:1-7 Week 3 The Visit of the Wise Men Matt 2:1-12 Week 4 The Visit of the Shepherds Luke 2:8-20 Week 5 Midterm Examination — Week 6 The Value of Virginity and Faithfulness after Marriage Christian moral lessons Week 7 Midterm Break — Week 8 Meaning & Significance of The Virgin Birth of Jesus Doctrinal and faith implications Week 9 Jesus and His Family Jesus’ siblings (Matt 13:53-56; Mk 6:1-3); Obedience to parents (Lk 2:51-52) Week 10 Jesus’ Understanding of Family & Baptism of Jesus Matt 12:46-50; Mk 3:31-35; John the Baptist as forerunner (Mk 1:1-8; Lk 3:1-20); Baptism of Jesus (Matt 3:13-17) Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Christian Religious Studies","term":"Second Term","text":"Week 1 Call of the First Disciples Matt 4:18-22; Mk 1:14-20; Lk 5:1- Week 2 Call of the Twelve Disciples Mk 3:13-19 Week 3 Demands of Discipleship Matt 8:18-22; Lk 9:57-62; Lk 14:25-34 Week 4 The Beatitudes Matthew 5:1-12 Week 5 Midterm Examination — Week 6 Christians as Salt & Light Matt 5:13-16 Week 7 Midterm Break — Week 8 Jesus’ Teaching on Revenge Matt 5:38-42 Week 9 Jesus’ Teaching on Prayer, Fasting & Forgiveness Matt 6:5-18; Matt 6:14-15 Week 10 Jesus’ Teaching on Love of Money & Anxiety Matt 6:19-34; Matt 6:25-34 Week 11  Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Christian Religious Studies","term":"Third Term","text":"Week 1 The Triumphal Entry Matt 21:1-11; Mk 11:1-11; Lk 19:28-44 Week 2 The Last Supper Matt 26:17-30 Week 3 Betrayal & Arrest of Jesus Mk 14:43-52; Matt 26:47-56 Week 4 Trial & Peter’s Denial Matt 26:57-75; Situations leading to denial of Christ Week 5 Midterm Examination — Week 6 Crucifixion of Jesus Matt 27:32-44 Week 7 Midterm Break — Week 8 Death and Burial of Jesus Matt 27:45-61 Week 9 Resurrection of Jesus Matt 28:1-10; Mk 16:1-8; Lk 24:1-12 Week 10 Appearances, Significance & Role of Women Post-resurrection appearances; Meaning for Christians today; Women in the resurrection Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Islamic Religious Studies (Irs)","term":"First Term","text":"Week 1 Revision of JSS1 Qur’anic Recitations • Review of Surahs: Tariq, Buruj, Inshiqaq • Pronunciation and Tajwid practice Week 1 Introduction to the Hadith of the Prophet (SAW) • Review of Hadith meaning • Transmission and preservation of Hadith Week 2 Qur’anic Recitation: Suratul A’la (Q87:1– 19) • Recitation and memorization • Translation and moral lessons • Lessons on glorifying Allah Week 3 Qur’anic Recitation: Suratul Ghashiyah (Q88:1–26) • Meaning and interpretation • Lessons on the Hereafter Week 4 Qur’anic Recitation: Suratul Fajr (Q89:1– 30) • Recitation and memorization • Explanation of moral messages on patience and obedience Week 5 MID-TERM EXAMINATION Assessment on Surahs and Tajwid Rules Week 6 Rules of Madd (Prolongation) • Meaning and types of Madd • Application during recitation Week 7 MID-TERM BREAK Holiday/Rest Week 8 Rules of Qalqalah • Meaning and letters of Qalqalah • Examples and practical application Week 9 Rules of Idgham and Ikhfa (Revision and Practice) • Review of previous Tajwid rules • Recitation drills Week 10 The Importance of Perfecting Recitation • Role of Tajwid in Qur’anic understanding and preservation Week 11 REVISION Comprehensive review of Surahs and Tajwid Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends JSS2 ISLAMIC RELIGIOUS STUDIES (IRS) SCHEME OF WORK SECOND TERM Week Topic Breakdown (Subtopics)"},{"page":0,"class":"JSS2","subject":"Islamic Religious Studies (Irs)","term":"Third Term","text":"Week 1 Review of Fiqh from JSS1 • Overview of prayers and Iman Week 2 The Pillars of Islam (Arkan al- Islam) • Shahadah, Salah, Sawm, Zakah, Hajj • Significance of each pillar Week 3 Types of Fasting (Sawm) • Obligatory, voluntary, and prohibited fasting• Rules and benefits Week 4 Zakah and Charity • Meaning, purpose, and recipients • Social benefits of giving Week 5 MID-TERM EXAMINATION Assessment on Pillars of Islam and Fiqh Week 6 Faith in Angels and Prophets • Roles and responsibilities of Angels • Importance of Prophets as guides Week 7 MID-TERM BREAK Holiday/Rest Week 8 Faith in the Day of Judgment • Description of life after death• Preparation for accountability Week 9 Faith in Divine Decree (Qadar) • Meaning and acceptance of destiny • Balancing belief and effort Week 10 Applying Iman in Daily Life • Living in obedience and submission to Allah Week 11 REVISION Comprehensive review of Fiqh and Iman Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS2","subject":"Nigerian History","term":"First Term","text":"Week 1 Independence of Nigeria Events of October 1, 1960; Prime Minister and Governor- General Week 2 First Republic (1963– 1966) Leaders; Political parties; Achievements and problems Week 3 Military Rule in Nigeria I Causes of the January 1966 coup Week 4 Military Rule in Nigeria II Counter-coup of July 1966; Gowon’s regime Week 5 Midterm Test – Week 6 Nigerian Civil War I Causes of the war (1967–1970) Week 7 Midterm Break – Week 8 Nigerian Civil War II Major events; End of war; \"No victor, no vanquished\" policy Week 9 Post-Civil War Nigeria Reconstruction, reconciliation, rehabilitation Week 10 Oil Boom of the 1970s Discovery of crude oil; Effects on economy Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Nigerian History","term":"Second Term","text":"Week 1 Second Republic (1979–1983) Leaders; Achievements; Problems Week 2 Military Rule in the 1980s Buhari/Idiagbon regime; Babangida regime Week 3 Military Rule in the 1990s Abacha regime; Abdulsalami Abubakar Week 4 Return to Democracy 1999 transition to civilian rule Week 5 Midterm Test – Week 6 Democratic Governance Fourth Republic; Presidents since 1999 Week 7 Midterm Break – Week 8 Challenges of Democracy Corruption, elections, insecurity Week 9 Human Rights in Nigeria Abuses and remedies Week 10 Nigerian Foreign Policy Principles; Relations with ECOWAS, AU, UN Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Nigerian History","term":"Third Term","text":"Week 1 Women in Nigerian History Funmilayo Ransome-Kuti, Margaret Ekpo, Queen Amina Week 2 Youths in Nigerian History Students’ unionism; Role in independence and democracy Week 3 Workers in Nigerian History Trade unions; Nigerian Labour Congress Week 4 Education and Development UPE, UBE, tertiary education Week 5 Midterm Test – Week 6 Nigerian Economy Agriculture, oil, manufacturing Week 7 Midterm Break – Week 8 Science and Technology in Nigeria Growth and challenges Week 9 Sports and National Unity Notable Nigerian sports achievements Week 10 Culture and Tourism Nigerian cultural heritage; Tourism development Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Social And Citizenship Studies","term":"First Term","text":"Week 1 Citizenship Meaning; Acquisition (birth, registration, naturalisation) Week 2 Rights and Responsibilities Interdependence of rights and duties Week 3 Constitution Meaning; Features; Importance in governance Week 4 Government Institutions Executive, legislature, judiciary; Functions Week 5 Midterm Test – Week 6 Civic Virtues Honesty, discipline, integrity, cooperation, tolerance Week 7 Midterm Break – Week 8 Public Service Meaning; Importance; Challenges Week 9 Democracy in Practice Elections, political parties, voting process Week 10 Human Trafficking Meaning; Causes; Consequences; Prevention Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Social And Citizenship Studies","term":"Second Term","text":"Week 1 Population and Society Population growth; Effects on resources and development Week 2 Social Problems Drug abuse, cultism, prostitution, terrorism Week 3 Crime and National Security Types of crime; Effects; Security agencies Week 4 Human Rights Abuse Examples in Nigeria; Remedies Week 5 Midterm Test – Week 6 Electoral Malpractices Meaning; Examples; Effects on democracy Week 7 Midterm Break – Week 8 Media and Society Roles of media; Influence on citizenship Week 9 International Organisations UN, AU, ECOWAS; Roles in peace and security Week 10 Global Citizenship Meaning; Qualities of a good global citizen Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Social And Citizenship Studies","term":"Third Term","text":"Week 1 Economic Values Thrift, saving, investment, entrepreneurship Week 2 Taxation and Civic Duty Importance of paying tax for national development Week 3 Environmental Citizenship Sanitation, waste management, protection of environment Week 4 Human Rights Institutions NHRC, Legal Aid Council, NGOs; Roles Week 5 Midterm Test – Week 6 Corruption and Accountability Transparency; Whistleblowing; Anti-corruption agencies Week 7 Midterm Break – Week 8 National Development Meaning; Indicators; Citizens’ roles Week 9 Social Institutions Family, religion, education; Their civic functions Week 10 Civic Challenges in Nigeria Poverty, illiteracy, unemployment Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS2","subject":"Cultural & Creative Arts (Cca)","term":"First Term","text":"Week 1 Elements of Design/Art Meaning of elements of design; Elements of design (line, shape, colour, texture, space, form, value); Applications of elements of design. Week 2 Principles of Design/Art Meaning of principles of design; Principles of design (balance, contrast, harmony, rhythm, proportion, unity); Uses of principles of design. Week 3 Crafts: Materials, Tools and Equipment Meaning of crafts; Materials/tools/equipment for making crafts; Craft locations in Nigeria. Week 4 The Study of Colours (Part 1) Meaning of colour; Classification and mixing of colours; Importance of colour in painting and design. Week 5 Midterm Test — Week 6 The Study of Colours (Part 2) Local colours and their sources; Attributes/characteristics of colour; Uses of colour. Week 7 Midterm Break — Week 8 The Study of Colours (Part 3) Making a colour wheel (practical). Week 9 Colour Application in Crafts Colour production; Application of colour in craft works; Why we apply colours on crafts. Week 10 Drawing Meaning of drawing; Types of drawing; Materials/media for drawing; Shading techniques in drawing; Purpose of drawing. Week 11 Revision Revision of all topics. Week 12 Examination First Term Exam. Week 13 Closing End of term activities."},{"page":0,"class":"JSS2","subject":"Cultural & Creative Arts (Cca)","term":"Second Term","text":"Week 1 Painting (Part 1) Meaning of painting; Steps in painting objects from observation. Week 2 Painting (Part 2) Using colours; Types of paint; Types of painting. Week 3 Production of Patterns/Design (Part 1) What is pattern/design?; Processes involved in making patterns/designs. Week 4 Production of Patterns/Design (Part 2) Sources of motifs for patterns/designs; Types of patterns/designs; Differences between types of patterns. Week 5 Midterm Test — Week 6 Bead Work Meaning of bead work; Production of different forms of beads in different media of jewellery; Uses of beads as creative objects. Week 7 Midterm Break — Week 8 History of Music Circumstances that led to the origin of music; Examples of early forms of music around the world. Week 9 Musical Practices: Listening (Part 1) Listening and appreciating popular music in Nigeria; Some popular music in Nigeria’s transition period. Week 10 Musical Practices: Listening (Part 2) Music styles; Musical instruments; Early forms of music. Week 11 Revision Revision of all topics. Week 12 Examination Second Term Exam. Week 13 Closing End of term activities."},{"page":0,"class":"JSS2","subject":"Cultural & Creative Arts (Cca)","term":"Third Term","text":"Week 1 Singing (Part 1) Meaning of singing; Running scale; Pitch identification. Week 2 Singing (Part 2) Types of singing voices; Uses of breathing exercises for voice training. Week 3 Singing (Part 3) Solfa notes of the National Anthem. Week 4 Design in the Theatre Meaning of theatre design; Areas of theatre design; Elements of design in the theatre; Importance of theatre design. Week 5 Midterm Test — Week 6 Rehearsal Meaning of rehearsal; Activities involved in rehearsals; Stages of rehearsal; Uses of rehearsal. Week 7 Midterm Break — Week 8 Types of Dance Types of dance (traditional, modern, creative, etc.). Week 9 Dance as a Career Meaning of dance as a career; Career prospects of studying dance; Some dance artists in Nigeria. Week 10 Self-Control Meaning of self-control; How to exercise self-control; Benefits of self-control; How to practise self-control. Week 11 Revision Revision of all topics. Week 12 Examination Third Term Exam. Week 13 Closing End of session activities."},{"page":0,"class":"JSS2","subject":"French","term":"First Term","text":"Week 1 Unité 1: Demander et expliquer la position Savoir demander et expliquer la position des personnes ou des choses les unes par rapport aux autres Week 2 Unité 2: Situer les lieux Situer les lieux les uns par rapport aux autres Week 3 Unité 3: Accueillir et guider quelqu’un Accueillir, pouvoir guider quelqu’un dans un espace intérieur Week 4 Unité 4: Demander/indiquer le chemin Savoir demander/indiquer le chemin pour aller quelque part Week 5 Midterm Examination — Week 6 Unité 5: Les moyens de transport Parler des différents moyens de transport Week 7 Midterm Break — Week 8 Unité 6: Expliquer un trajet Savoir expliquer un trajet en transport public Week 9 Unité 7: Demander/indiquer des horaires Demander/indiquer des horaires Week 10 Unité 8: Réagir à un problème de transport Savoir réagir à un problème de transport Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"French","term":"Second Term","text":"Week 1 Unité 9: Établir des listes/inventaires Établir des listes, établir des inventaires Week 2 Unité 10: Les commerçants et marchandises Savoir nommer les commerçants, les marchandises et leur mode de présentation Week 3 Unité 11: Acheter et marchander Dire ce que l’on veut acheter, demander le prix, marchander et payer Week 4 Unité 12: Exprimer un besoin et son utilité Savoir dire de quoi on a besoin, à quoi ça sert Week 5 Midterm Examination — Week 6 Unité 13: À la pharmacie Demander un remède, expliquer une maladie Week 7 Midterm Break — Week 8 Unité 14: Les vêtements, chaussures et accessoires Parler des caractéristiques des vêtements, chaussures et accessoires Week 9 Unité 15: Apprécier, comparer, choisir Apprécier quelque chose, comparer, exprimer une hésitation et exprimer un choix Week 10 Unité 16: Quantité et qualité des produits Savoir préciser la quantité et la qualité des produits Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"French","term":"Third Term","text":"Week 1 Unité 17: Opérations de calcul simple Savoir utiliser les opérations de calcul simple Week 2 Unité 18: Nourriture et boissons Savoir dire ce qu’on mange et ce qu’on boit Week 3 Unité 19: Recettes de cuisine Comprendre des recettes de cuisine et expliquer comment réaliser des plats Week 4 Unité 20: Au restaurant/café Faire une réservation, passer une commande, demander l’addition dans un restaurant ou café Week 5 Midterm Examination — Week 6 Projet oral et écrit Jeux de rôle: transport, marché, pharmacie, restaurant (révision intégrée) Week 7 Midterm Break — Week 8 Révision générale des unités 17–20 Exercices de consolidation Week 9 Évaluation orale/pratique Conversations guidées (dialogues sur transport, achats, nourriture, restaurant) Week 10 Préparation aux examens Exercices d’expression écrite et orale Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Intermediate Science","term":"First Term","text":"Week 1 Review of JSS 1 Science Concepts Revision of matter, energy, and environment; Laboratory rules and safety recap; Importance of observation and measurement Week 2 Components of the Environment Biotic and abiotic components; Interdependence between living and non-living things; Food chains and food webs; Energy flow in ecosystems Week 3 Soil Formation and Conservation Meaning of soil and its formation; Types of soil and characteristics; Soil erosion and conservation practices; Importance of soil to living things Week 4 Environmental Pollution Meaning and types (air, water, soil, noise); Causes and effects; Control and prevention methods; Roles of individuals and government agencies Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Waste and Its Management Meaning and types of waste; Waste disposal methods; Reduce, Reuse, Recycle (3Rs); Effects of poor waste management Week 8 Air and Water Pollution Sources of air and water pollution; Effects on living organisms; Prevention and purification methods; Experiment: filtration of muddy water Week 9 Conservation of Natural Resources Meaning and types of natural resources; Importance of conservation; Renewable vs. non-renewable resources; Role of individuals in conservation Week 10 Climate and Environmental Changes Meaning and causes of climate change; Effects of global warming; Mitigation and adaptation strategies; School-based tree planting projects Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS2","subject":"Intermediate Science","term":"Second Term","text":"Week 1 Elements, Compounds and Mixtures Meaning and examples; Differences between elements, compounds, and mixtures; Simple separation techniques; Practical demonstrations Week 2 Acids, Bases and Salts Meaning and identification; Common household acids and bases; Indicators (litmus, turmeric, methyl orange); Neutralization reactions Week 3 The Human Body Digestive, circulatory, and respiratory systems; Functions of major organs; Healthy habits and body care; Simple diagrams and labeling Week 4 Reproduction in Plants and Animals Meaning and types (sexual, asexual); Structure and function of reproductive organs; Importance of reproduction; Life cycles of selected animals Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Classification of Living Things Basis for classification; Five kingdoms of living organisms; Major characteristics of each group; Examples and simple charts Week 8 Cells as the Basic Units of Life Meaning and discovery of cells; Cell structure and functions; Differences between plant and animal cells; Use of microscope (demonstration) Week 9 Growth and Development Definition of growth and development; Factors affecting growth; Stages in human development; Measurement of growth Week 10 Microorganisms Types: bacteria, fungi, virus, protozoa; Beneficial and harmful effects; Control of harmful microorganisms; Experiment: observing mould growth Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS2","subject":"Intermediate Science","term":"Third Term","text":"Week 1 Forms and Sources of Energy Light, heat, sound, mechanical, electrical, chemical; Renewable and non-renewable energy sources; Energy transformation; Simple classroom experiments Week 2 Heat and Temperature Meaning of heat and temperature; Measurement using thermometers; Effects of heat on matter; Practical demonstrations Week 3 Light and Its Properties Reflection, refraction, and absorption; Transparent, translucent, opaque objects; Shadows and eclipses; Simple activities with mirrors and lenses Week 4 Sound Production and transmission of sound; Loudness, pitch, and vibration; Noise pollution; Sound safety measures Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Electricity and Magnetism Conductors and insulators; Simple circuits; Magnetic and non-magnetic materials; Safety precautions Week 8 Machines Simple machines and their uses; Levers, pulleys, inclined planes; Mechanical advantage and efficiency; Practical demonstrations Week 9 Science, Technology and Development Relationship between science and technology; Positive and negative effects of technology; Careers in science and technology; National development contributions Week 10 Skill Acquisition and Entrepreneurship Meaning and importance; Vocational and technological skills; School-based projects; Self-reliance through practical skills Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS2","subject":"Digital Technologies","term":"First Term","text":"Week 1 Review of JSS1 Work • Recap of hardware, software, and online safety Week 2 Basic Computer Communication Networks • Meaning and need for networks • Network types: LAN, MAN, WAN Week 3 Components of a Computer Network • Servers, clients, switches, routers, hubs • Network media: cables, wireless Week 4 Network Topologies • Meaning and types: bus, star, ring • Advantages and disadvantages Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Internet and Web Services • Search engines and browsers • Email setup and etiquette Week 7 MID-TERM BREAK Holiday/Rest Week 8 Cloud Computing • Meaning of cloud storage • Examples: Google Drive, Dropbox • Advantages and safety Week 9 Cybersecurity Awareness • Meaning of cybersecurity • Types of cyberattacks • Safe online habits Week 10 Data Protection • Meaning and importance • Legal and ethical responsibilities"},{"page":0,"class":"JSS2","subject":"Digital Technologies","term":"Second Term","text":"Week 1 Introduction to Programming • Meaning and importance • Types of programming languages • Examples: Scratch, Python Week 2 Basic Algorithms • Meaning of algorithm • Steps in problem solving • Flowcharts and pseudocode Week 3 Block Coding • Understanding block-based coding (Scratch) • Creating basic animations Week 4 Variables in Programming • Meaning and uses of variables • Creating and naming variables in Scratch Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Control with Conditions • Conditional statements (IF, ELSE) • Decision-making in programs Week 7 MID-TERM BREAK Holiday/Rest Week 8 Loops in Programming • Meaning of loops • Types: for loop, while loop • Applications in coding Week 9 Game Development with Visual Programming • Steps in game creation • Designing a simple interactive game"},{"page":0,"class":"JSS2","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Introduction to Robotics • Meaning and types of robots • Components of a robot • Uses of robots Week 2 Parts and Functions of a Robot • Sensors, actuators, controllers • Role of software in robotics Week 3 Basic Robotic Movements • Programming simple movements • Concept of automation Week 4 Artificial Intelligence (AI) • Meaning and types • Applications in daily life Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Difference Between AI and Robotics • Interrelationship between AI and robotics • Examples: drones, chatbots Week 7 MID-TERM BREAK Holiday/Rest Week 8 Real-Life Application of AI • AI in education, health, and business Week 9 Careers in Robotics and AI • Job opportunities and skills needed Week 10 Class Project: Building a Simple Robot (Simulation) • Hands-on digital model or simulation Week 11 REVISION Review of all topics Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS2","subject":"Business Studies","term":"First Term","text":"Week 1 Effective Office Practice Definition of an office; Types of offices; Importance of an office Week 2 The Reception Office Meaning of reception office; Meaning of a receptionist; Importance of a receptionist Week 3 Duties of a Receptionist Qualities of a good receptionist; How to receive and treat visitors Week 4 Office Etiquette Appropriate office dress code; Documents handled by the receptionist Week 5 Midterm Examination — Week 6 Office Correspondence (Part 1) Meaning of office correspondence; Types of correspondence Week 7 Midterm Break — Week 8 Office Correspondence (Part 2) Uses of office correspondence; Ways mails come into an organisation Week 9 Handling of Mail Inward mail and outward mail; Mail handling procedures Week 10 Office Documents Meaning of office documents; Types of office documents; Preparation and uses of sales & purchase documents Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Business Studies","term":"Second Term","text":"Week 1 Right Attitude to Work Meaning; Punctuality; Regularity; Reward and punishment Week 2 Devotion to Duty Attributes of people who are devoted to duty; Effects of devotion to duty Week 3 Commerce: The Heart of Business Meaning and importance of trade; Forms of trade Week 4 Aids to Trade Meaning; Types; Role of Customs and Excise in foreign trade Week 5 Midterm Examination — Week 6 The Market Meaning; Features of a market; Commodity, money and capital markets Week 7 Midterm Break — Week 8 Careers in the Capital Market Various careers; Importance of capital market to business Week 9 Buying and Selling Buying by cash and credit; Cost of sales; Mark-up; Turnover Week 10 Profit and Loss Calculation of profit/loss; Importance of profit to business Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Business Studies","term":"Third Term","text":"Week 1 Distribution Meaning; Channels of distribution; Functions of wholesalers and retailers Week 2 Licensed Chemical Vendors Handling & distribution of chemicals; Effects of wrong handling Week 3 Financial Institutions: Banks Commercial banks; Bank services; Ethical issues in banking Week 4 Insurance Meaning; Services rendered by insurance companies; Types and benefits of insurance Week 5 Midterm Examination — Week 6 Entrepreneurship Meaning; Definition of entrepreneur; Personal qualities of an entrepreneur Week 7 Midterm Break — Week 8 Business Opportunities Meaning; How to discover opportunities; Types (local, national, international) Week 9 Consumer Rights & Responsibilities Meaning of consumer rights; Consumerism; Eight universal rights of a consumer; Responsibilities of consumers Week 10 Shopping and After-Sales Services Needs vs wants; Decision making; Impulse buying and its effects; After-sales services Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS2","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"First Term","text":"Week 1 Review of JSS 1 Work • Revision of basic concepts in solar PV systems • Review of components and their functions • Safety precautions during installation • Importance of entrepreneurship in solar PV Week 2 Electricity Fundamentals • Definition and importance of electricity • Conductors and insulators • Types of current: AC and DC • Voltage, current, and resistance (Ohm’s Law) • Measuring electrical quantities using a multimeter Week 3 Energy Sources and Power Generation • Renewable vs non-renewable energy • Solar, wind, hydro, and thermal power • Electricity generation process • Importance of clean energy to the environment Week 4 Solar PV System Configuration • Types of solar PV systems: standalone, grid-tied, hybrid • Components connection (series and parallel) • Advantages and disadvantages of each configuration • System setup demonstration Week 5 MID-TERM EXAMINATION • Assessment on Weeks 1–4 Topics Week 6 Solar Charge Controllers • Meaning and functions of charge controllers • Types of charge controllers (PWM and MPPT)"},{"page":0,"class":"JSS2","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Second Term","text":"Week 1 Review of First Term Work • Recap of solar PV components and configurations • Review of electrical wiring concepts • Discussion of charge controller and battery connections • Assessment of students’ understanding through class discussions Week 2 Solar Batteries • Meaning and importance of solar batteries • Types of batteries: Lead-acid, lithium-ion, gel batteries • Functions and characteristics of each type • Battery charging and discharging cycles • Practical: Identifying and testing batteries Week 3 Inverters and Converters • Meaning and functions of inverters and converters • Types of inverters: pure sine wave, modified sine wave • Importance of voltage conversion (DC to AC) • Practical: Connecting an inverter to a solar battery Week 4 Load Estimation and Energy Demand • Meaning of electrical load • Steps in calculating total load requirement • Daily energy consumption estimation • Importance of proper load management • Practical: Calculating the load of classroom equipment Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 System Sizing and Design • Meaning of system sizing • Factors to consider in sizing (load, autonomy, location) • Panel, battery, and inverter sizing"},{"page":0,"class":"JSS2","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Third Term","text":"Week 1 Review of Second Term Work • Recap of installation and maintenance concepts • Review of inverter, battery, and system sizing • Identifying solar system components • Class discussion and short quiz Week 2 Energy Storage Systems • Meaning and importance of energy storage • Types of energy storage systems: chemical, mechanical, thermal • Batteries as energy storage devices in PV systems • Factors affecting energy storage efficiency • Practical: Observing battery charge/discharge patterns Week 3 Solar System Performance Evaluation • Meaning and importance of performance evaluation • Parameters to monitor (voltage, current, efficiency) • Tools and instruments for system testing • Recording and interpreting data • Practical: Measuring voltage and current from a panel Week 4 Fault Detection in PV Systems • Common PV system faults (panel shading, loose connection, battery failure) • Troubleshooting techniques • Step-by-step guide to fault tracing • Documentation and reporting of faults • Demonstration: Identifying faults in a sample solar circuit Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Entrepreneurship in Solar Energy • Meaning of entrepreneurship • Solar business opportunities (installation, sales, maintenance) • Customer service and communication"},{"page":0,"class":"JSS2","subject":"Fashion Design And Garment Making","term":"First Term","text":"Week 1 Review of JSS 1 Work Revision of tools, machines, and basic stitches Week 2 Advanced Sewing Techniques Decorative stitches and seam types Week 3 Fibre Blending and Fabric Finishes Types and reasons for blending; Simple finishing processes Week 4 Fabric Selection for Garments Factors influencing choice of fabrics Week 5 Mid-Term Examination — Week 6 Pattern Alteration Meaning and techniques of altering patterns Week 7 Mid-Term Break — Week 8 Simple Garment Construction Construction of blouse or shirt Week 9 Collars, Sleeves and Necklines Types and attachment methods 10. Fastenings Buttons, zips, hooks, and press studs 11. Finishing and Pressing Edge finishing and final presentation 12. Examination — 13. Closing —"},{"page":0,"class":"JSS2","subject":"Fashion Design And Garment Making","term":"Second Term","text":"Week 1 Freehand Cutting Meaning, advantages and disadvantages; Techniques Week 2 Pattern Layout Methods of laying patterns on fabrics; Grain lines Week 3 Garment Assembly Joining seams, attaching parts, fitting garments Week 4 Fitting and Adjustments Correction of fitting faults Week 5 Mid-Term Examination — Week 6 Finishing Operations Hemming, labeling, packaging Week 7 Mid-Term Break — Week 8 Traditional Attires Meaning and examples (buba, wrapper, agbada, etc.) Week 9 Modern Styles Contemporary fashion designs and trends 10. Introduction to Digital Design Overview of CAD in fashion 11. Fashion Illustration Use of lines, colours, and shapes in fashion sketches 12. Examination — 13. Closing —"},{"page":0,"class":"JSS2","subject":"Fashion Design And Garment Making","term":"Third Term","text":"Week 1 Garment Production Process From sketching to finishing; steps in garment making Week 2 Quality Control in Garment Making Meaning, importance, and quality checks Week 3 Entrepreneurship in Garment Making Meaning and importance of entrepreneurship Week 4 Pricing and Marketing of Garments Pricing methods; promotion and sales strategies Week 5 Mid-Term Examination — Week 6 Customer Service in Fashion Customer satisfaction and business reputation Week 7 Mid-Term Break — Week 8 Branding in Fashion Logos, labels, and packaging designs Week 9 Fashion Exhibition Preparing garments for exhibition Week 10 Project Work Fashion show or class exhibition Week 11 Revision Review of term’s work Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Livestock Farming","term":"First Term","text":"Week 1 Review of JSS 1 Livestock Farming Recap of poultry, rabbit, and sheep/goat production concepts Week 2 Poultry Management (Advanced) Brooding management; Culling; Vaccination; Record- keeping Week 3 Poultry Feed Formulation Balancing nutrients; Mixing procedures; Feed ratios and formulation steps Week 4 Egg and Meat Production Egg collection, processing, and storage; Slaughtering and dressing of birds Week 5 Mid-Term Examination — Week 6 Rabbit Management (Advanced) Breeding, kindling, care of young; Weaning and growth stages Week 7 Mid-Term Break — Week 8 Rabbit Feed Formulation Local feed ingredients; Feeding management and schedules Week 9 Record Keeping in Livestock Production Types and importance of records — feeding, health, and financial records Week 10 Sanitation and Biosecurity Hygiene, disinfection, and disease prevention methods Week 11 Revision Review of advanced livestock management topics Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Sheep and Goat Production (Advanced) Feeding methods, breeding systems, care of lambs and kids Week 2 Disease Prevention and Control Vaccination schedules; Sanitation; Isolation of sick animals Week 3 Pasture Management Types of pastures; Grazing systems; Establishment and maintenance of pastures Week 4 Livestock Housing Improved housing materials and layout for animal comfort Week 5 Mid-Term Examination — Week 6 Concept of Entrepreneurship Meaning of entrepreneurship; Characteristics of an entrepreneur Week 7 Mid-Term Break — Week 8 Importance of Entrepreneurship Role in employment creation; Opportunities in livestock farming Week 9 Concept of Money Definition and functions of money; Forms of money in agribusiness Week 10 Practical: Budgeting in Livestock Farming Simple record-keeping and cost management exercises Week 11 Revision Review of the term’s work Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Business Start-up in Livestock Farming Steps in starting a small poultry, rabbit, or goat business Week 2 Factors to Consider Before Starting Capital, location, breed selection, and feeding requirements Week 3 Business Records Daily and monthly records — expenditure, income, and profit tracking Week 4 Marketing of Livestock Products Meaning and importance of marketing livestock products Week 5 Mid-Term Examination — Week 6 Marketing Channels From producer to consumer; Role of middlemen and wholesalers Week 7 Mid-Term Break — Week 8 Packaging and Processing Methods of packaging eggs, meat, hides, and fur for sale Week 9 Marketing Poultry, Rabbit, Sheep, and Goat Products Sales, branding, and advertising techniques Week 10 Project Work Practical farm visit or market survey Week 11 Revision Review of the term’s topics and key concepts Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Review of JSS 1 Work Hygiene, tools, and safety in beauty care. Week 2 Hair Structure Layers of the hair and their importance. Week 3 Hair Treatment Natural and chemical treatments. Week 4 Hair Styling Techniques Tools and methods of simple styling. Week 5 Midterm Examination Week 6 Types of Hair and Their Care Straight, curly, and kinky hair maintenance. Week 7 Midterm Break Week 8 Skin Types Oily, dry, normal, and combination skin. Week 9 Facial Treatment Procedures Cleansing, exfoliation, and massage. Week 10 Introduction to Makeup Products Foundation, concealer, and powder. Week 11 Safety in Makeup Application Hygiene in handling products and brushes. Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS2","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Review of First Term Discussion on hair and facial care. Week 2 Hair Coloring Meaning, tools, and safety measures. Week 3 Hair Relaxing Steps and safety precautions. Week 4 Hair Plaiting and Weaving Patterns and neatness in plaiting. Week 5 Midterm Examination Week 6 Skin Disorders Acne, eczema, rashes, and prevention. Week 7 Midterm Break Week 8 Skin Treatment Products Cleansers, toners, moisturizers. Week 9 Makeup Application Steps and tools for simple facial makeup. Week 10 Nail Art Decoration and polish application. Week 11 Simple Beauty Business Ideas Home-based beauty business opportunities. Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS2","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Review of Second Term Hair care and beauty practices recap. Week 2 Salon Management Organization, cleanliness, and tools arrangement. Week 3 Record Keeping Customer details, expenses, and sales record. Week 4 Customer Service Building good customer relationships. Week 5 Midterm Examination Week 6 Product Knowledge Identifying safe and harmful ingredients. Week 7 Midterm Break Week 8 Professional Ethics Punctuality, honesty, and confidentiality. Week 9 Introduction to Entrepreneurship Concept and importance of self-employment. Week 10 Beauty Product Packaging Labeling and presentation ideas. Week 11 Branding and Marketing Promoting a beauty brand. Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS2","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Review of JSS 1 Work Recap of phone parts, safety, and tools Week 2 Introduction to Mobile Circuits Meaning of circuit; Simple phone circuit components and symbols Week 3 Power Section of a Mobile Phone Charging system, battery, and power IC functions Week 4 Display and Network Sections Screen components; Antenna, network IC, SIM section; Troubleshooting display and network faults Week 5 Mid-Term Examination — Week 6 Sound and Charging Sections Microphone, speaker, ringer, charging port; Common faults and repairs Week 7 Mid-Term Break — Week 8 Software Updates and Flashing Meaning of flashing; Importance of updating OS; Tools and apps for flashing Week 9 Fault Diagnosis and Testing Use of multimeter; Continuity test; Battery voltage test Week 10 Practical: Fault Detection and Repair Step-by-step testing and replacement of faulty parts Week 11 Revision — Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 Introduction to Entrepreneurship Mindset Meaning and importance; Thinking like an entrepreneur Week 2 Concept of Entrepreneurship Identifying opportunities in GSM repair; Risk-taking and innovation Week 3 Concept of Money Use of money in business transactions; Savings and reinvestment Week 4 Bookkeeping in GSM Repairs Business records — daily sales, repairs log, expenses; Balance sheet basics Week 5 Mid-Term Examination — Week 6 Business Startup in GSM Repairs Writing a simple business plan; Budgeting and equipment listing Week 7 Mid-Term Break — Week 8 Customer Relations Handling customers professionally; Honesty and reliability in service delivery Week 9 Rights and Duties of Citizens in Business Consumer rights and seller responsibilities; Ethical practices in mobile repair Week 10 Practical: Business Simulation Role-play of shop management and customer service Week 11 Revision — Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Introduction to Software Tools Common repair tools (Miracle Box, SP Flash Tool, etc.); Installation and usage Week 2 Phone Unlocking and Password Reset Security locks, factory reset, bypassing screen locks Week 3 Virus and Malware Removal Meaning, types, and removal of malware from devices Week 4 Data Recovery Causes of data loss; Tools and steps in data recovery Week 5 Mid-Term Examination — Week 6 Phone Testing and Quality Control Testing repaired phones before delivery; Ensuring quality Week 7 Mid-Term Break — Week 8 Record Keeping and Reporting Writing job completion reports; Daily repair log Week 9 Practical: Full Repair Cycle Receiving a faulty phone, diagnosing, repairing, and documenting the process Week 10 Revision — Week 11 Examination — Week 12 Closing / Vacation —"},{"page":0,"class":"JSS2","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Review of JSS1 Work  Recap of farmland preparation and nursery practices  Discussion on importance of soil and crop selection Week 2 Farm Tools and Machines  Types and examples of farm machinery  Functions of simple and complex machines  Safety and maintenance practices Week 3 Soil Fertility and Improvement  Meaning of soil fertility  Causes of loss of fertility  Methods of improving soil fertility (organic/inorganic)  Compost making Week 4 Land Preparation Techniques  Clearing, tilling, and leveling  Irrigation and drainage systems  Crop rotation practices Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Site Selection for Crop Production  Factors affecting crop site selection  Land use and suitability  Environmental and economic factors Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Crop Spacing and Planting Methods  Meaning and importance of crop spacing  Methods of planting (direct, transplanting)  Plant population and density Week 9 Weed Management  Meaning and types of weeds  Effects of weeds  Methods of weed control (manual, chemical, biological) Week 10 Crop Protection  Pests and diseases of crops"},{"page":0,"class":"JSS2","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Nursery Practices  Preparation of nursery materials  Seed sowing and care  Transplanting techniques Week 2 Seed Germination  Meaning and process  Conditions necessary for germination  Experiment on germination Week 3 Fertilizer Application Methods  Organic and inorganic fertilizers  Application methods and timing  Safety precautions Week 4 Vegetative Propagation  Meaning and importance  Methods of propagation: grafting, layering, cutting  Crops that use each method Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Maintenance of Horticultural Crops  Pruning, staking, watering, and mulching  Pest and disease control Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Harvesting and Storage  Techniques of harvesting  Post-harvest handling and preservation Week 9 Marketing of Horticultural Crops  Meaning and importance of marketing  Channels of distribution  Marketing problems and solutions Week 10 Farm Record-Keeping  Types and importance of records  Cashbook, sales record, stock record Week 11 REVISION  Review of all topics"},{"page":0,"class":"JSS2","subject":"Horticulture And Crop Production Scheme Of Wor","term":"Third Term","text":"Week 1 Vegetable Production  Importance and types of vegetables  Conditions for growth  Production stages Week 2 Post-Harvest Management  Sorting, grading, and packaging  Storage methods Week 3 Introduction to Agribusiness  Meaning of agribusiness  Career opportunities Week 4 Entrepreneurship in Agriculture  Meaning and qualities of an entrepreneur  Importance of entrepreneurship Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Enterprise Development  Small agribusiness setup  Record-keeping Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Financial Management  Basic money management  Budgeting and planning Week 9 Marketing and Promotion  Marketing strategies  Customer relations Week 10 Business Simulation  Group projects and business idea development Week 11 REVISION  Review of term’s topics Week 12 EXAMINATION  End of Term Assessment Week 13 CLOSING/VACATION  Term ends"},{"page":0,"class":"JSS3","subject":"English Studies","term":"First Term","text":"Week 1 – Revision of speech from last term Revision of Parts of Speech Scanning for main points Informal Letter – Letter to my best friend on my plan for the academic session Introduction to Fiction & Non- Fiction; Examples of Non-Fiction Week 2 The Schwa /ə/ sound (about, doctor, above) Expressing/Describing emotions (Verb + Preposition) Skimming for specific information Writing to a Pen-pal Poetry Analysis Week 3 Stress and Intonation (continued) Adverbs of Frequency (often, always, occasionally) Reading to cultivate referencing skills Story Writing – All that glitters is not gold Prose – Study of the recommended text Week 4 Consonants /ʒ/ and /dʒ/ (leisure/ledger, garage/large) Changing positive statements to negative (using not) Practice scanning, skimming, and normal rate reading Expository Essay – How to care for a motor vehicle Prose – Characterization, Theme, Plot Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Contrast between /ɜ:/ and /ɔ:/ Adjectives & Adverbs expressing willingness/unwillingness (with modals + adverbials) Reading to make deductions from selected passage Guided Writing Drama – Recommended text; Rhyme Schemes; Characterization, Diction, Setting, Plot Week 7 Midterm Break Midterm Break Midterm Break Midterm Break Midterm Break"},{"page":0,"class":"JSS3","subject":"English Studies","term":"Second Term","text":"Week 1 Consonants /t/ and /θ/ (tin/thin, tick/thick) – Revision of Parts of Speech Reading for Critical Evaluation Informal Letter – More on Writing to a Pen-pal Review of Features of Folktales; Discussion of Selected Folktales Week 2 Consonant contrast /t/ and /s/ (tailor/sailor, pit/pass) Prepositions expressing relations with people (with, for, against) Listening for implied meanings Guided Writing – Week 3 Contrast consonants /ʃ/ and /ʒ/ (mission/pleasure, vision/measure) The Simple Sentence Listening to get main gist/points in a paragraph Story Writing – The School Prize- Giving Day; At the Bus Stop Poetry – Write a short poem (The Lonely Child); Short story (How the Tortoise got the Pattern on His Shell) Week 4 – – – – – Week 5 Midterm Examination Midterm Examination Midterm Examination Midterm Examination Midterm Examination Week 6 Contrast vowels /ʌ/ and /a:/ (much/march, pun/park) The Compound Sentence Listening to questions in order to answer them Informal Letter – To a friend about your best subject Prose – Use of recommended text; Identification of Prose Features Week 7 Midterm Break Midterm Break Midterm Break Midterm Break Midterm Break"},{"page":0,"class":"JSS3","subject":"English Studies","term":"Third Term","text":"Week 1 Revision of last term’s exam – – – – Week 2 Review of Monotones Review of Nouns and Pronouns Look at some past comprehension questions Review of Narrative/Descriptive Essays Review of Major/Minor Characters, Theme, Plot, Tragic/Comic Elements, and Diction Week 3 Review of Diphthongs Review of Verbs and Adverbs Use past questions Review of Argumentative/Expository Essay Review of Literary Terms in Poetry (Metaphor, Simile, Alliteration, Irony, etc.) Week 4 Review of Consonant Sounds Review of Adjectives, Conjunctions, Prepositions, and Interjections Use past questions Revisit Informal and Formal Letters with features Use past questions Week 5–10 General Revision General Revision General Revision General Revision General Revision Week 11 Examination Examination Examination Examination Examination"},{"page":0,"class":"JSS3","subject":"Mathematics","term":"First Term","text":"Week 1 Whole Numbers I - Binary Number System - Using computer to do simple mathematical calculations - Translation of word problems into numerical expressions Week 2 Whole Numbers II - Expressions involving brackets and fractions - Direct and Inverse Proportion - Applications of Direct and Inverse Proportion - Compound Interest Week 3 Addition and Subtraction of Numbers in Base 2 - Addition of two or three 3-digit binary numbers - Subtraction of two or three 3-digit binary numbers Week 4 Multiplication and Division of Numbers in Base 2 - Multiplication of two 2-digit binary numbers - Division of two or three-digit binary numbers Week 5 Mid-Term Examination Testing first half of term’s work Week 6 Rational and Non-Rational Numbers - Identifying rational and non-rational numbers Week 7 Mid-Term Break — Week 8 Variations - Solving variation problems on Direct, Indirect, Joint, and Partial Week 9 Factorization - Factorization of expressions of the form: (i) ax + ay (ii) 3m + pq + 3p + mp (iii) a² - b² (iv) a² - 2ab - b² - Word problems involving factorization Week 10 Simple Equations Involving Fractions - Solving simple equations involving fractions - Word problems leading to simple equations involving fractions Week 11 Change of Subject of Formulae - Involving addition, multiplication, and roots Week 12 Examination End-of-term examination Week 13 Closing"},{"page":0,"class":"JSS3","subject":"Mathematics","term":"Second Term","text":"Week 1 Simultaneous Linear Equations (I) – In One or Two Variables I. Elimination Method II. Subtraction Method III. Graphical Method IV. Compilation of Table of Values Week 2 Simultaneous Linear Equations (II) I. More Exercises on Simultaneous Linear Equations using Graphical Method II. Application of Simultaneous Linear Equation to Life Situation using Problem Solving Week 3 Geometry I – Similar Shapes I. Similar Shapes – Identification of Plane Shapes II. Enlargements and Scale Factor – Enlarge Figures using Scale Factors Week 4 Geometry II I. Calculate Lengths, Areas and Volume of Similar Figures II. Solve Problems on Quantitative Reasoning involving Similar Shapes. Week 5 Midterm Examination — Week 6 Area Of Plane Figures I I. Area of triangles II. Area of parallelogram III. Area of trapezium IV. Area of circles Week 7 Midterm Break — Week 8 Area of Plane Figures II I. Area of Sectors II. Word Problems Involving Areas of Plane Figures III. Quantitative Aptitude Problems on Areas of Plane Figures Week 9 Trigonometry I. The Sine, Cosine and Tangent of an Acute Angle II. Applications of Trigonometric Ratios to Solve Problems on Angles and Sides of a Right-Angled Triangle Week 10 Angles of Elevation and Depression / Study of Measurement Using Clinometers Apply trigonometric ratios to find angle of elevation and depression Use clinometers to demonstrate and estimate or calculate distances Week 11 Revision — Week 12 Examination — Week 13 Vacation"},{"page":0,"class":"JSS3","subject":"Mathematics","term":"Third Term","text":"Week 1 Construction I. Construction of Angle 45 Degree II. Construction of Angle 30 Degree III. Copying given Angles IV. Construction of Simple Plane Shapes Week 2 Measures of Central Tendency I. Revision of previous work on mean, median and mode II. Calculate the Median of any given Data III. Calculate the Mode of any given Data IV. Calculate the Mean of any given Data V. Calculate the Range of any given Data Week 3 Application of Measures of Central Tendency To Analyze any Given Information — Week 4 Data Presentation – Pie Charts — Week 5  Week 6 Revision of JSS 3 Work — Week 7–8 Mock Examination — Week 9 JSSC Examination —"},{"page":0,"class":"JSS3","subject":"Physical And Health Education","term":"First Term","text":"Week 1 Physical Fitness & Body Conditioning - Benefits Derived from Physical Fitness.- Factors that Influence Physical Fitness. Week 2 Recreation, Leisure and Dance Activities (Part 1) - Pre-Colonial/Folk Traditional Dances.- Social Dances. Week 3 Recreation, Leisure and Dance Activities (Part 2) - Foreign & Modern Dances.- Computer Games.- Values of Computer Games. Week 4 Track and Field Events - Pole Vault.- Javelin. Week 5 Midterm Examination — Week 6 Ball Games (Hockey) – Part 1 - Nature of the Game.- Basic Skills and Techniques in Hockey.- Rules & Safety Regulations. Week 7 Midterm Break — Week 8 Ball Games (Hockey) – Part 2 - Key Officials and Duties.- Facilities and Equipment.- Positions of Players.- Values/Importance of Hockey. Week 9 Group/Combined Events – Part 1 - Classification of Combined Events.- List of Various Events.- Duration of Events. Week 10 Group/Combined Events – Part 2 - Scoring System.- Facilities & Equipment.- Rules & Regulations.- Officials.- Safety Rules. Week 11 Revision First Term Topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Physical And Health Education","term":"Second Term","text":"Week 1 Nigerian Sports Heroes – Part 1 - Career Guidance in Physical Education.- Past & Present Sports Heroes and their Contributions. Week 2 Nigerian Sports Heroes – Part 2 - Professionals in Physical Education in Nigeria. Week 3 Contact Games – Taekwondo - Nature & History of Taekwondo.- Basic Skills & Techniques.- Importance.- Safety Rules & Regulations. Week 4 Contact Games – Boxing - Nature & History of Boxing.- Basic Skills.- Safety Rules & Regulations. Week 5 Midterm Examination — Week 6 Non-contact Games – Part 1 - Basic Strokes and Styles in Swimming. Week 7 Midterm Break — Week 8 Non-contact Games – Part 2 - Gymnastics.- Classifications of Floor Activities.- Safety Rules and Regulations. Week 9 Personal, School & Community Health I – Part 1 - Types of Families.- Duties of Family Members.- Puberty in Boys & Girls. Week 10 Personal, School & Community Health I – Part 2 - Teenage Pregnancy & Consequences.- Assertiveness & Communication Skills.- Agencies Promoting Health Education in Nigeria. Week 11 Revision Second Term Topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Physical And Health Education","term":"Third Term","text":"Week 1 Personal, School & Community Health II – Part 1 - Ageing.- Life-enhancing Measures.- Death & Dying. Week 2 Personal, School & Community Health II – Part 2 - Drug Use, Misuse & Abuse.- Categories of Drugs.- Health Consequences. Week 3 Pathogens, Diseases & Prevention – Part 1 - Nature of Communicable Diseases.- Mode of Transmission.- Factors & Causative Agents. Week 4 Pathogens, Diseases & Prevention – Part 2 - Prevention & Management of Non- communicable Diseases. Week 5 Midterm Examination — Week 6 Family Health – Part 1 - Types of Diseases & Modes of Transfer.- Disease Vectors. Week 7 Midterm Break — Week 8 Family Health – Part 2 - Sexually Transmitted Infections (STIs).- Consequences of Contracting Diseases. Week 9 Family Health – Part 3 - Prevention of Diseases. Week 10 General Health Education Review Integrative review of Health Education concepts (Family Health, Diseases, Drugs). Week 11 Revision Third Term Topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Christian Religious Studies","term":"First Term","text":"Week 1 The Promise of the Holy Spirit (Part 1) John 14:16-17, 26; John 16:5-16 – Jesus promises the coming of the Holy Spirit; Acts 1:3-5 – waiting for the promise. Week 2 The Coming of the Holy Spirit Acts 2:1-13 – The Day of Pentecost, speaking in tongues, reactions of the people. Week 3 Peter’s First Speech and its Effects Acts 2:14-41 – Peter’s boldness, message of repentance, conversion of about 3,000 souls. Week 4 Fellowship in the Early Church (Part 1) Acts 2:41-47 – Unity, sharing, prayers, breaking of bread. Week 5 Midterm Examination — Week 6 Fellowship in the Early Church (Part 2) Acts 5:1-11 – Fraud in the church (Ananias and Sapphira). Acts 6:1-2 – Murmuring and complaints. Week 7 Midterm Break — Week 8 Selection of Deacons Acts 6:1-7 – Appointment of Stephen and six others; responsibilities of deacons. Week 9 Persecution of Early Believers (Part 1) Acts 3:1-11, 4:1-22 – Arrest of Peter and John; Acts 6:8-15, 7:1- 60 – Arrest and martyrdom of Stephen. Week 10 Persecution of Early Believers (Part 2) Acts 8:1-3; 9:1-2 – Saul’s persecution; Acts 12:1-4 – Martyrdom of James. Week 11 Revision All topics from Weeks 1–10. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Christian Religious Studies","term":"Second Term","text":"Week 1 The Ministry of Peter (Part 1) Acts 8:4-25 – Peter and Simon the Magician. Week 2 The Ministry of Peter (Part 2) Acts 9:32-42 – Healing miracles of Peter (Aeneas and Dorcas). Week 3 The Ministry of Peter (Part 3) Acts 10:1-48 – Conversion of Cornelius. Acts 11:1-18 – Peter defends his action in Cornelius’ house. Week 4 The Ministry of Peter (Part 4) Acts 12:5-24 – Peter’s release from prison and the death of Herod. Week 5 Midterm Examination — Week 6 The Ministry of Apostle Paul (Part 1) Acts 22:1-5, 26-30 – Paul’s nativity and education; Acts 7:57-58; 8:1-3; 9:1-3 – Paul’s persecution of the Church. Week 7 Midterm Break — Week 8 The Ministry of Apostle Paul (Part 2) Acts 9:1-19; 22:6-21 – The conversion of Paul; Acts 13–14 – Paul’s first missionary journey. Week 9 The Ministry of Apostle Paul (Part 3) Acts 15:1-35 – The Council at Jerusalem; Wrong and right ways of resolving conflicts. Week 10 Christian Unity and Living Among Non- Christians Christian organisations in Nigeria; interdenominational cooperation; Christian giving (Phil. 4:14-20; 2 Cor. 8:3-5; 9:6-15); teachings that foster unity; Christians living in the community; Christian attitude to persecution. Week 11 Revision All topics from Weeks 1–10. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Islamic Religious Studies (Irs)","term":"First Term","text":"Week 1 Review of JSS2 Surahs • A’la, Ghashiyah, Fajr — revision and recitation Week 2 Qur’anic Recitation: Suratul Balad (Q90:1– 20) • Recitation and translation • Lessons on moral courage Week 3 Qur’anic Recitation: Suratul Shams (Q91:1– 15) • Explanation of meaning • Lessons on purity and righteousness Week 4 Qur’anic Recitation: Suratul Layl (Q92:1–21) • Memorization and understanding • Rewards of good deeds Week 5 MID-TERM EXAMINATION Assessment on Surahs and Tajwid Week 6 Rules of Ghunnah (Nasal Sound) • Explanation, letters, and application • Practical recitation exercises Week 7 MID-TERM BREAK Holiday/Rest Week 8 Rules of Waqf (Stopping Signs) • Understanding symbols and pauses in recitation Week 9 Practical Tajwid Exercises • Group recitation and corrections Week 10 Importance of the Qur’an in Muslim Life • Guidance, healing, and reflection Week 11 REVISION Comprehensive review of Tajwid and Surahs Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Islamic Religious Studies (Irs)","term":"Second Term","text":"Week 1 Review of Previous Hadith • Summary of JSS2 lessons Week 2 Selected Hadith on Leadership • Qualities of good leadership • Prophet Muhammad (SAW) as a model leader Week 3 Hadith on Justice and Accountability • Importance of fairness and honesty in leadership Week 4 Hadith on Seeking Knowledge • Virtue of learning and teaching Week 5 MID-TERM EXAMINATION Assessment on Hadith Studies Week 6 Tahdhib: Respect for Human Life and Property • Sanctity of life and property • Avoiding violence and theft Week 7 MID-TERM BREAK Holiday/Rest Week 8 Tahdhib: Discipline and Responsibility • Islamic teachings on self-control and accountability Week 9 Tahdhib: Purity of Intention • Doing good deeds sincerely for Allah’s sake Week 10 Tahdhib: Role of Muslims in Society • Promoting peace, honesty, and compassion Week 11 REVISION Comprehensive review of Hadith and Tahdhib Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Islamic Religious Studies (Irs)","term":"Third Term","text":"Week 1 Review of Fiqh and Iman (JSS2) • Recap of Arkan al-Islam and Arkan al-Iman Week 2 Funeral Rites in Islam • Washing, shrouding, prayer, and burial Week 3 Marriage in Islam • Conditions, types, and importance • Rights and responsibilities of spouses Week 4 Inheritance (Mirath) • Basic principles of inheritance • Rights of heirs Week 5 MID-TERM EXAMINATION Assessment on Islamic Laws and Practices Week 6 Faith in Allah and His Attributes • Names and attributes of Allah • Importance of Tawhid Week 7 MID-TERM BREAK Holiday/Rest Week 8 Belief in the Holy Books • The Qur’an and previous revelations • Role of revelation in human life Week 9 Belief in the Hereafter • Accountability, Paradise, and Hellfire Week 10 Living a Life of Faith • Applying Iman through daily actions Week 11 REVISION Comprehensive review of Fiqh and Iman Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Nigerian History","term":"First Term","text":"Week 1 Nigeria in the 21st Century Political, economic, social developments Week 2 Leadership in Contemporary Nigeria Past presidents and their impacts Week 3 Federalism in Nigeria Meaning; Challenges of Nigerian federalism Week 4 Constitution of Nigeria 1999 Constitution and amendments Week 5 Midterm Test – Week 6 Elections and Electoral Bodies INEC; Electoral reforms Week 7 Midterm Break – Week 8 National Security Issues Insurgency, banditry, militancy Week 9 Anti-Corruption Struggles EFCC, ICPC, whistleblowing policy Week 10 Role of Nigeria in Africa Peacekeeping missions; Diplomacy Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS3","subject":"Nigerian History","term":"Second Term","text":"Week 1 Nigeria and Globalization ICT, trade, migration Week 2 Nigeria in International Organisations UN, AU, Commonwealth Week 3 Nigeria and Global Peace Peacekeeping contributions Week 4 Human Rights Development in Nigeria Role of NGOs, NHRC Week 5 Midterm Test – Week 6 Political Developments (2011–Present) Elections, transitions, challenges Week 7 Midterm Break – Week 8 Nigerian Youth and Politics Role of youth in governance Week 9 Nigerian Women and Leadership Contributions and challenges Week 10 Challenges Facing Nigeria Poverty, unemployment, insecurity Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS3","subject":"Nigerian History","term":"Third Term","text":"Week 1 National Development Plans Vision 2020, Economic Recovery and Growth Plan Week 2 Sustainable Development in Nigeria SDGs; Nigeria’s progress Week 3 Corruption and Accountability Effects; Strategies for combating corruption Week 4 Nigerian Democracy and the Future Prospects of governance Week 5 Midterm Test – Week 6 Nigeria and African Unity Nigeria’s role in AU, ECOWAS Week 7 Midterm Break – Week 8 Preparation for BECE Revision of JSS1–3 Nigerian History Week 9 Mock Examination – Week 10 BECE Examination – Week 11 Closing End of JSS cycle Week 12 – – Week 13 – –"},{"page":0,"class":"JSS3","subject":"Social And Citizenship Studies","term":"First Term","text":"Week 1 Citizenship Education Recap Revision of key concepts from JSS1–2 Week 2 Democracy and Human Rights Relationship between democracy and human rights Week 3 Nigerian Constitution (1999) Basic provisions; Fundamental objectives Week 4 Separation of Powers Checks and balances; Importance Week 5 Midterm Test – Week 6 Political Parties Meaning; Functions; Party system in Nigeria Week 7 Midterm Break – Week 8 Election Processes Voter registration; Voting methods; INEC Week 9 Good Governance Meaning; Principles; Citizens’ role in promoting it Week 10 Youth and Nation-Building Roles of youth; Challenges; Opportunities Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS3","subject":"Social And Citizenship Studies","term":"Second Term","text":"Week 1 National Issues Poverty, corruption, insecurity Week 2 Humanitarian Issues Refugees, internally displaced persons (IDPs) Week 3 Peace Education Peacebuilding; Negotiation; Mediation Week 4 Human Rights Protection Strategies; National and international frameworks Week 5 Midterm Test – Week 6 Citizenship in a Digital Age Cyber citizenship; Responsible use of technology Week 7 Midterm Break – Week 8 International Relations Nigeria’s role in UN, AU, ECOWAS Week 9 Global Peace and Security Nigeria’s contribution to world peace Week 10 Civic Leadership Skills Public speaking; Advocacy; Participation Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"JSS3","subject":"Social And Citizenship Studies","term":"Third Term","text":"Week 1 Civic Challenges in Africa Governance, corruption, conflict, underdevelopment Week 2 Human Rights in Africa African Charter on Human and Peoples’ Rights Week 3 Sustainable Development SDGs; Citizens’ roles in achieving them Week 4 Entrepreneurship and Civic Responsibility Linking business to national progress Week 5 Midterm Test – Week 6 Civic Competence Decision-making, teamwork, critical thinking Week 7 Midterm Break – Week 8 Civic Participation in Nigeria’s Future Role of citizens in elections, governance, development Week 9 Revision of Entire Junior Secondary Curriculum – Week 10 Mock Examination – Week 11 Final Examination BECE preparation Week 12 Closing End of JSS cycle Week 13 – –"},{"page":0,"class":"JSS3","subject":"Cultural And Creative Arts (Cca)","term":"First Term","text":"Week 1 Types and Features of Nigerian Traditional Arts Nigerian Traditional Arts; Functions of Nigerian Traditional Arts; 1.3 Importance of Preserving Art as a Cultural Element. Week 2 Contemporary Nigerian Arts and Artists Contemporary Nigerian Artists and their Contributions; How to Generate Income through Contemporary Artworks. Week 3 Meaning and Use of Motifs (Part 1) Meaning of Motif and Pattern; Uses of Motifs. Week 4 Meaning and Use of Motifs (Part 2) Creation of Motifs from Nature and Imagination; Repeat Patterns; Transfer of Motifs on Paper or Fabric. Week 5 Midterm Examination — Week 6 Exhibition and Display Techniques Preparing Artworks; Display Techniques; Categorising; Space, Screens and Lighting. Week 7 Midterm Break — Week 8 Lettering Meaning of Lettering; Types of Lettering; Lettering Construction; Stages in the Construction of Letters. Week 9 Construction and Design Meaning of Package Design; Functions of Package Design; Processes in Package Design. Week 10 Marketing of Artworks Sources of Funding for Art Business; Outlets for Marketing Art Products; Ways of Marketing Art Products; Pricing of Artworks. Week 11 Revision Revision of Weeks 1–10. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Cultural And Creative Arts (Cca)","term":"Second Term","text":"Week 1 Introduction to Embroidery (Part 1) Meaning of Embroidery; Types of Embroidery; Embroidery Materials/Tools. Week 2 Introduction to Embroidery (Part 2) Sources of Embroidery Designs; Methods of Transferring Motifs on Fabrics; 8.6 Embroidery Stitches Guide. Week 3 Knitting Meaning of Knitting; Types of Knitting; Materials/Tools; Basic Knitting Stitches. Week 4 Crocheting Meaning of Crocheting; Materials/Tools; How to Crochet. Week 5 Midterm Examination — Week 6 Batik Work Meaning of Batik; Materials/Tools for Batik Work; Making a Batik Project. Week 7 Midterm Break — Week 8 Uses of Music Uses of Music; Impacts of Music. Week 9 Creating Music / Solfa Notation Values Solfa Notation; Music Note Values; Rhythm; Clapping a Rhythm. Week 10 Drama and the Development of Rural Communities Meaning of Drama and Theatre; Drama and Theatre for Rural Community Development; Ways Drama and Theatre Can Solve Community Issues and Problems; Roles of Drama and Theatre Towards Solving Community Issues and Problems Week 11 Revision Week 12 Examination Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Cultural And Creative Arts (Cca)","term":"Third Term","text":"Week 1 Opportunities for Career Dramatists 1. Opportunities for Career Dramatists 2. Opportunities for Career Dramatists in Nigeria 3. How Drama Can Affect the Society 4. Names of Notable Nigerian Dramatists/Playwrights Week 2 Processes of Choreography 1. Meaning of Choreographer 2. Processes Employed by a Choreographer to Create a Dance 3. Creating a Dance Pattern Week 3 Prospects of Studying Dance in Nigeria The Prospects of Studying Dance in Nigeria Week 4 Unity 1. Meaning of Unity 2. Causes of Disunity at Home, in School and in the Society 3. How to Maintain Unity at Home, in School and in the Society 4. Demonstration of Acts of Unity Week 5 Midterm Examination — Week 6–13 Revision & Examination"},{"page":0,"class":"JSS3","subject":"French","term":"First Term","text":"Week 1 Décrire plus précisément une personne Vocabulaire pour la description physique et morale; utilisation des adjectifs qualificatifs. Week 2 Décrire un paysage et des lieux touristiques Identifier les paysages naturels, monuments, sites touristiques et utiliser des adjectifs appropriés. Week 3 Expliquer ses habitudes Expressions pour parler de la routine quotidienne et des activités régulières. Week 4 Parler d’un événement passé (les souvenirs) Utilisation du passé composé et de l’imparfait; raconter un souvenir. Week 5 Midterm Examination — Week 6 Décrire un objet Vocabulaire des formes, couleurs, matières; parler de l’usage d’un objet. Week 7 Midterm Break — Week 8 Comparer Employer les comparatifs et superlatifs pour comparer personnes, objets et situations. Week 9 Dater et mesurer le temps Savoir donner la date, l’heure; employer les expressions temporelles. Week 10 Raconter sa journée Organisation d’un récit chronologique au présent et au passé. Week 11 Revision Révision des unités 1–8 avec exercices pratiques (dialogues et rédaction). Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"French","term":"Second Term","text":"Week 1 Relater un événement passé Employer le passé composé, l’imparfait et les adverbes temporels pour situer les actions. Week 2 Rapporter un fait récent Utilisation du passé composé avec \"venir de\" et autres structures pour exprimer l’actualité immédiate. Week 3 Comprendre un récit / Écrire son journal Lecture et compréhension de récits simples; rédaction de son journal intime. Week 4 Dire ce que l’on va faire Utilisation du futur proche et du futur simple; parler de ses intentions. Week 5 Midterm Examination — Week 6 Faire des projets Exprimer ses projets personnels et scolaires; vocabulaire de planification et futur simple. Week 7 Midterm Break — Week 8 Consolidation orale et écrite Exercices de dialogues, jeux de rôles et production écrite sur les unités 9–13. Week 9 Préparation au BECE (Partie I) Révision ciblée: grammaire (temps du passé, futur, comparatifs). Week 10 Préparation au BECE (Partie II) Révision ciblée: vocabulaire (description, transport, achats, temps, projets). Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Intermediate Science","term":"First Term","text":"Week 1 Review of JSS 2 Work Revision of matter, energy, and classification; Laboratory conduct and safety; Introduction to JSS 3 concepts Week 2 Ecosystem Meaning and components; Interdependence and balance of nature; Food chains, food webs, and energy flow; Disruption of ecosystems Week 3 Natural Resources Types: renewable and non-renewable; Importance to national economy; Conservation and management; Field observation project Week 4 Environmental Hazards Meaning and types: drought, desertification, erosion, flooding; Causes and prevention; Disaster preparedness; Community safety measures Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Environmental Health Meaning and components; Importance of clean environment; Role of individuals and government; Environmental health officers Week 8 Waste Disposal and Recycling Methods of waste disposal; Importance of recycling; Practical waste sorting activity; Effects of poor waste management Week 9 Sustainable Development Meaning and principles; Environmental protection and sustainable use; SDGs related to environment; School eco- project Week 10 Review of Environmental Concepts Summary of major environmental topics; Quiz and group presentation Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Intermediate Science","term":"Second Term","text":"Week 1 The Cell and Its Functions Cell theory; Organelles and their roles; Differences between plant and animal cells; Observation under microscope Week 2 Tissues and Organs Meaning and examples of tissues; Types and functions; Organs and organ systems; Importance of coordination Week 3 Heredity and Variation Meaning of heredity; Inherited and acquired traits; Importance of variation; Simple genetic inheritance Week 4 Adaptation of Organisms Meaning and examples; Adaptation to habitat; Structural and behavioral adaptations; Importance of adaptation Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Atoms and Molecules Basic structure of atom; Elements, compounds, and mixtures; Symbols and formulae; Simple chemical equations Week 8 Changes in Matter Physical and chemical changes; Reversible and irreversible processes; Simple experiments Week 9 Water and Air Composition and importance; Water purification and conservation; Air pressure and experiments Week 10 Microorganisms and Diseases Pathogens and disease transmission; Prevention and control; Vaccination and hygiene practices Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Intermediate Science","term":"Third Term","text":"Week 1 Energy Transformation Conversion from one form to another; Energy conservation; Simple demonstrations Week 2 Heat Transfer Conduction, convection, radiation; Practical examples; Insulators and conductors Week 3 Electrical Energy Meaning and sources; Electric circuit and symbols; Domestic wiring and safety; Conservation of electricity Week 4 Science, Technology and National Development Relationship among science, technology, and development; Role of research in development; Inventions and innovators Week 5 MID-TERM EXAMINATION Assessment of Weeks 1–4 Week 6 MID-TERM BREAK Holiday/Rest Week 7 Machines and Mechanisms Simple and compound machines; Functions and uses; Mechanical advantage; Practical demonstration Week 8 ICT and Scientific Advancement Role of ICT in science; Data collection and storage; Modern communication tools; Internet and global learning Week 9 Career Opportunities in Science and Technology Careers in medical, engineering, ICT, and research fields; Skills required; Importance to national growth Week 10 Science Projects and Exhibitions Planning and execution; Presentation and teamwork; Assessment and reflection Week 11 REVISION Review of all topics in Term Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Digital Technologies","term":"First Term","text":"Week 1 Review of JSS2 Work • Quick recap of programming and robotics Week 2 Advanced MS Word • Page layout, tables, mail merge Week 3 Advanced MS PowerPoint • Animation, transitions, multimedia integration Week 4 Introduction to Digital Media • Meaning and importance • Creating and editing digital content Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Graphic Design with Canva • Designing posters, flyers, social media posts Week 7 MID-TERM BREAK Holiday/Rest Week 8 Photo Editing and Visual Communication • Using online tools for design and branding Week 9 Copyright and Media Ethics • Digital rights and fair use policies Week 10 Digital Portfolio Creation • Compiling digital works and projects Week 11 REVISION Comprehensive review Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Digital Technologies","term":"Second Term","text":"Week 1 Introduction to Digital Entrepreneurship • Meaning and importance • Skills and opportunities Week 2 Internet Communication and Collaboration • Email, video calls, and cloud tools Week 3 Social Media for Education and Business • Responsible use • Branding and promotion Week 4 Digital Marketing Basics • Meaning and channels • Advertising safely online Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Cyber Ethics and Netiquette • Respectful online behavior Week 7 MID-TERM BREAK Holiday/Rest Week 8 Online Privacy and Protection • Managing personal data • Avoiding digital theft Week 9 Managing Digital Footprint • Meaning and importance • Creating a positive online presence Week 10 Digital Project: Online Business Simulation • Students create mock e-business or blog Week 11 REVISION Review of term topics Week 12 EXAMINATION End of Term Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Management of e-Waste • Meaning and sources of e-waste • Safe disposal methods • Environmental effects Week 2 Recycling Digital Devices • Refurbishing and reusing old gadgets Week 3 Emerging Technologies • IoT, Cloud, Blockchain, AR/VR Week 4 Preparing for Digital Future • STEM education and career pathways Week 5 MID-TERM TEST Assessment of Weeks 1–4 Week 6 Artificial Intelligence in Everyday Life • Examples: voice assistants, recommendations Week 7 MID-TERM BREAK Holiday/Rest Week 8 Global Digital Citizenship • Ethics and responsibilities in a connected world Week 9 Technology and Sustainable Development • Role of ICT in achieving SDGs Week 10 Final Project: Student Digital Innovation • Individual or group project presentation Week 11 REVISION Final review of all years’ topics Week 12 EXAMINATION End of Junior Secondary Assessment Week 13 CLOSING/VACATION Term ends"},{"page":0,"class":"JSS3","subject":"Business Studies","term":"First Term","text":"Week 1 Effective Office Practice Meaning of office procedure; importance of office procedure. Week 2 Office Procedure (Part 1) Procedures for making payments; preparation of sales and purchases documents. Week 3 Office Procedure (Part 2) Imprest account: meaning, features, advantages. Week 4 Store Records Meaning of store records; delivery note; gate pass. Week 5 Midterm Examination — Week 6 Stocktaking Meaning of stocktaking; importance of stocktaking in business. Week 7 Midterm Break — Week 8 Office Equipment (Part 1) Meaning of office equipment; types of office equipment. Week 9 Office Equipment (Part 2) Care of office equipment; advantages and disadvantages. Week 10 Commerce – The Heart of Business Nature of commerce as the center of business activities. Week 11 Revision Weeks 1–10 topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Business Studies","term":"Second Term","text":"Week 1 Advertising (Part 1) Meaning of advertising; types of advertising. Week 2 Advertising (Part 2) Functions and methods of advertising. Week 3 Advertising (Part 3) Media of advertising; ethics of advertising; advertising jingles. Week 4 Transportation Meaning; importance of transportation to commerce; types, advantages and disadvantages. Week 5 Midterm Examination — Week 6 Communication (Part 1) Meaning of communication; process of effective communication; hindrances to communication. Week 7 Midterm Break — Week 8 Communication (Part 2) Methods of communication; importance to business. Week 9 Communication (Part 3) Agencies of communication and their services; the Internet; GSM. Week 10 Setting Simple Business Goals Difference between goals and objectives; SWOT analysis; strengths, weaknesses, opportunities, threats. Week 11 Revision Weeks 1–10 topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Business Studies","term":"Third Term","text":"Week 1 Business Plans (Part 1) Meaning of a business plan; importance of a business plan. Week 2 Business Plans (Part 2) Procedure for drawing up a simple business plan; format of a business plan. Week 3 Consumer Protection (Part 1) Meaning; need for consumer protection; agencies and their roles. Week 4 Consumer Protection (Part 2) Responsibilities of consumers; universal rights of consumers; instruments of consumer protection. Week 5 Midterm Examination — Week 6 Consumer Protection (Part 3) Complaints: meaning; justified vs unjustified complaints; steps in lodging complaints; writing a letter of complaint. Week 7 Midterm Break — Week 8 Consumer Protection (Part 4) Reasons for banning/restricting harmful chemicals; procedure for banning chemicals; seeking redress. Week 9 Personal Finance Meaning; sources of finance for individuals; needs and wants; scale of preference; modesty and its effects. Week 10 Bookkeeping and Business Success Trial balance (meaning, uses, items, preparation); Trading, Profit and Loss accounts (meaning, purpose, preparation); Balance sheet (meaning, uses, contents, preparation). Week 11 Revision Weeks 1–10 topics. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"JSS3","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"First Term","text":"Week 1 Introduction and Revision of Previous Work • Review of JSS 2 topics: energy storage, performance evaluation, and fault detection • Understanding advanced system configurations • Classroom discussion: evolution of solar technology Week 2 Advanced Solar System Components • Detailed study of PV modules, batteries, inverters, and charge controllers • Latest innovations in solar components (Li-ion batteries, MPPT controllers) • Component identification and selection for specific installations • Practical: Comparing different inverter and battery types Week 3 System Design and Sizing • Principles of system design • Steps in sizing a solar system for home or school • Calculating load requirements (AC/DC loads) • Determining panel, battery, and inverter sizes • Hands-on activity: Designing a 12V DC lighting system Week 4 Solar Installation Procedures (Advanced) • Review of installation tools and materials • Mounting techniques for panels and arrays • Series and parallel connections (practical wiring session) • Proper grounding and cable management • Demonstration: Complete setup of a basic solar system Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 System Protection and Safety Devices • Importance of safety in solar installations • Protective devices: fuses, circuit breakers, surge arresters • Proper earthing/grounding techniques • Handling tools and batteries safely"},{"page":0,"class":"JSS3","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Second Term","text":"Week 1 Revision of First Term Work • Review of advanced system components and installation • Recap on system design and sizing • Quick diagnostic test and discussion on students’ practical experiences Week 2 Electrical Wiring for Solar Systems • Introduction to solar electrical wiring concepts • Types of electrical cables (AC/DC cables) • Colour coding and polarity awareness • Cable sizing and voltage drop considerations • Practical: Connecting panels, controllers, and batteries correctly Week 3 Battery Bank Configuration • Series and parallel connections in batteries • Battery capacity and voltage calculation • Factors affecting battery performance and lifespan • Maintenance and storage of batteries • Practical: Building a 24V battery bank Week 4 Inverter Operation and Connection • Understanding inverter functions • Types of inverters: pure sine wave, modified sine wave • Inverter wiring: DC input and AC output • Installation precautions and testing • Demonstration: Connecting an inverter to a battery and load Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Solar Load Management • Understanding electrical loads • Load prioritization and balancing • Estimating total load consumption • Power rating and efficiency management"},{"page":0,"class":"JSS3","subject":"Solar Photovoltaic (Pv) Installation And Maintenance","term":"Third Term","text":"Week 1 Revision of Previous Work • Review of solar components, wiring, and maintenance • Discussion on real-life solar installation scenarios • Introduction to professional ethics in solar practice Week 2 Occupational Health and Safety (OHS) in Solar Work • Importance of safety in solar installation • Common electrical hazards and prevention • Safe handling of panels, batteries, and tools • Personal protective equipment (PPE) and usage • Practical: Safety drill and PPE inspection Week 3 Solar Site Assessment • Identifying suitable locations for PV systems • Factors affecting solar site selection (orientation, shading, tilt angle, roof strength) • Site survey checklist and measurements • Practical: Performing a basic site assessment around the school Week 4 System Installation Procedure • Step-by-step installation process (mounting, wiring, connections, testing) • Mounting structures: roof and ground installations • Installing panels, controllers, inverters, and batteries • Practical: Installing a small off-grid solar lighting system Week 5 MID-TERM EXAMINATION • Assessment of Weeks 1–4 Topics Week 6 Maintenance and Servicing of Solar PV Systems • Types of maintenance: preventive and corrective"},{"page":0,"class":"JSS3","subject":"Fashion Design And Garment Making","term":"First Term","text":"Week 1 Review of JSS 2 Work Overview of tools, patterns, and garment production Week 2 Advanced Pattern Drafting Drafting complex patterns for dresses and trousers Week 3 Garment Assembly Techniques Sewing, lining, and interfacing Week 4 Finishing High-Quality Garments Edge finishes and professional pressing Week 5 Mid-Term Examination — Week 6 Fashion Accessories Designing and making simple accessories (belts, bags) Week 7 Mid-Term Break — Week 8 Fabric Decoration Tie and dye, appliqué, embroidery, and beadwork Week 9 Digital Fashion Design Advanced use of digital platforms for sketching Week 10 Creating Digital Collections Combining designs to create themed collections Week 11 Revision Review of term’s topics Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Fashion Design And Garment Making","term":"Second Term","text":"Week 1 Entrepreneurship in Fashion Starting a small fashion business Week 2 Record Keeping and Bookkeeping Business records and accounts Week 3 Costing and Pricing of Garments Cost elements and pricing strategies Week 4 Branding and Marketing Developing a fashion brand; advertising methods Week 5 Mid-Term Examination — Week 6 Digital Marketing Using social media for fashion marketing Week 7 Mid-Term Break — Week 8 Customer Relationship Handling clients and feedback Week 9 Fashion Business Ethics Integrity, creativity, and sustainability Week 10 Project: Mini Fashion Business Plan Practical project on fashion business planning Week 11 Revision — Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Fashion Design And Garment Making","term":"Third Term","text":"Week 1 Fashion Portfolio Development Compiling digital and physical portfolios Week 2 Presentation Skills Communicating fashion ideas effectively Week 3 Fashion Exhibition Preparation Display and arrangement techniques Week 4 Fashion Show Project Planning and coordinating a mini fashion show Week 5 Mid-Term Examination — Week 6 Portfolio Evaluation Reviewing and improving portfolio works Week 7 Mid-Term Break — Week 8 BECE Preparation Review of JSS1–JSS3 concepts and practicals Week 9 BECE Preparation (continued) Mock assessment and project defense Week 10 BECE Examination Practical and written exam Week 11 Revision Review and reflection on fashion skills learned Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Livestock Farming","term":"First Term","text":"Week 1 Review of JSS 2 Work Revision of poultry, rabbit, and sheep/goat production Week 2 Advanced Poultry Management Hatchery management, incubation, and chick brooding Week 3 Livestock Breeding Techniques Natural and artificial insemination methods Week 4 Health and Safety in Livestock Farming Hygiene, handling of chemicals, and personal safety on the farm Week 5 Mid-Term Examination — Week 6 Waste Management Composting, recycling, and manure utilization Week 7 Mid-Term Break — Week 8 Farm Layout Planning Design and organization of small livestock farms Week 9 Livestock Record Analysis Profit and loss determination; Evaluation of production efficiency Week 10 Practical: Livestock Farm Design Group project — planning and model design of a small farm Week 11 Revision Review of all topics covered during the term Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Advanced Entrepreneurship in Livestock Identifying business opportunities; Expansion and scaling up production Week 2 Financial Management in Livestock Business Budgeting, savings, credit facilities, and agricultural loans Week 3 Marketing Strategies Branding, advertising, customer service, and retention Week 4 Cooperative Farming Meaning, types, and benefits of agricultural cooperatives Week 5 Mid-Term Examination — Week 6 Farm Record Keeping (Advanced) Income statement, sales record, and expenditure analysis Week 7 Mid-Term Break — Week 8 Value Addition in Livestock Products Processing eggs, meat, hides, and fur for higher profits Week 9 Export of Livestock Products Export requirements, standards, and documentation Week 10 Practical Project Developing a mini business plan or market survey Week 11 Revision Review of the term’s work Week 12 Examination — Week 13 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Agribusiness Project Development Developing a business plan for livestock enterprise Week 2 Marketing and Distribution Channels Identifying buyers and marketing outlets Week 3 Pricing and Cost Control Calculating production cost and setting prices Week 4 Mid-Term Examination — Week 5 Livestock Exhibition and Demonstration Presentation of class livestock projects Week 6 Revision Comprehensive review of JSS1–3 work Week 7–10 BECE Preparation and Examination —"},{"page":0,"class":"JSS3","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Review of JSS 2 Work Hair and makeup recap. Week 2 Advanced Hair Styling Braiding, fixing, and extensions (theory & demonstration). Week 3 Hair Coloring and Relaxing Steps, products, and safety measures. Week 4 Hair Treatment Deep conditioning and scalp care. Week 5 Midterm Examination Week 6 Skin Care Routine Cleansing, exfoliation, and facial massage. Week 7 Midterm Break Week 8 Makeup Application Techniques Steps for day and evening makeup. Week 9 Nail Extension and Maintenance Fixing and removing artificial nails safely. Week 10 Salon Hygiene Disinfection and sanitation of tools. Week 11 Revision Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS3","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Review of First Term Recap on advanced styling and skincare. Week 2 Advanced Skin Treatment Steaming, exfoliation, and herbal masks. Week 3 Makeup Products and Their Functions Uses of concealer, powder, lipstick, and eyeliner. Week 4 Hairdressing Tools Care and maintenance of hair equipment. Week 5 Midterm Examination Week 6 Customer Care Communication and handling complaints. Week 7 Midterm Break Week 8 Professional Ethics Honesty, neatness, punctuality, and confidentiality. Week 9 Entrepreneurship in Beauty Identifying opportunities and managing a small salon. Week 10 Record Keeping and Financial Management Budgeting and pricing of services. Week 11 Revision Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS3","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Review of Second Term Recap of entrepreneurship and customer care. Week 2 Product Knowledge Safe use and identification of cosmetics. Week 3 Branding and Packaging Creating a beauty brand identity. Week 4 Marketing Strategies Social media and customer referrals. Week 5 Midterm Examination Week 6 Setting Up a Beauty Business Steps, capital, and salon layout. Week 7 Midterm Break Week 8 Health and Safety in the Salon First aid and hygiene practices. Week 9 Beauty Career Opportunities Career paths in cosmetology. Week 10 Project Work Group salon or beauty product design project. Week 11 Revision Week 12 Revision Week 13 Examination / Closing"},{"page":0,"class":"JSS3","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Review of JSS 2 Work Recap of circuits, entrepreneurship, and software tools Week 2 Introduction to Advanced GSM Repairs Identifying advanced faults; Board-level repairs Week 3 Soldering and Desoldering Techniques Tools for soldering; Safety precautions Week 4 Replacing Phone Components Replacing charging ports, screens, speakers, and buttons Week 5 Mid-Term Examination — Week 6 Troubleshooting Advanced Faults Power IC, CPU, and memory-related issues Week 7 Mid-Term Break — Week 8 Flashing and Unlocking Complex Devices Flashing Android and iPhones; IMEI repair; Avoiding software bricking Week 9 Practical: Complex Fault Repair Hands-on practice with multiple faults Week 10 Revision — Week 11 Examination — Week 12 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 Entrepreneurship in GSM Repairs Expanding repair services; Managing customers and suppliers Week 2 Concept of Money and Investment Reinvestment, cost management, and profit calculation Week 3 Business Start-up Procedures Registration, business name, and licensing Week 4 Bookkeeping and Financial Records Ledger, profit/loss, and financial reporting Week 5 Mid-Term Examination — Week 6 Marketing of GSM Repair Services Advertising, branding, and online presence Week 7 Mid-Term Break — Week 8 Rights and Duties of Citizens Consumer protection laws, integrity, and accountability Week 9 Practical: Setting up a Mini GSM Shop Designing a small-scale business plan and layout Week 10 Revision — Week 11 Examination — Week 12 Closing / Vacation —"},{"page":0,"class":"JSS3","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Final Business Project Developing and presenting a GSM repair business plan Week 2 Exhibition and Product Display Demonstration of repair skills and innovations Week 3 Entrepreneurship Fair Preparation Preparing for BECE practicals and presentation Week 4 Mid-Term Examination — Week 5 Revision and BECE Preparation Review of JSS1–3 topics and practicals Week 6–13 BECE Examination and Closing —"},{"page":0,"class":"JSS3","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Review of JSS2 Work  Quick revision of crop production and horticulture basics Week 2 Soil Management  Erosion control methods  Crop rotation  Cover cropping Week 3 Crop Planting Techniques  Advanced planting methods  Spacing and depth Week 4 Fertilizer Management  Organic composting  Fertilizer scheduling Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Crop Irrigation  Meaning and methods of irrigation  Importance and maintenance Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Pest and Disease Control  Integrated pest management  Crop sanitation Week 9 Crop Harvesting and Yield Improvement  Harvesting techniques  Crop yield measurement Week 10 Post-Harvest Technology  Handling, storage, and processing Week 11 REVISION  Comprehensive review Week 12 EXAMINATION  End of Term Assessment Week 13 CLOSING/VACATION  Term ends"},{"page":0,"class":"JSS3","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Crop Improvement  Meaning and methods  Selection, breeding, hybridization Week 2 Seed Production and Certification  Meaning and importance  Agencies involved Week 3 Organic Farming  Meaning and principles  Benefits and challenges Week 4 Greenhouse Technology  Meaning and components  Advantages in horticulture Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Enterprise Skills in Agriculture  Creativity, innovation, problem-solving Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Business Plan Development  Steps and importance  Practical class Week 9 Marketing and Branding  Advertising and sales promotion Week 10 Agribusiness Project  Class mini project (production, sales, records) Week 11 REVISION  Review Week 12 EXAMINATION  End of Term Assessment Week 13 CLOSING/VACATION  Term ends"},{"page":0,"class":"JSS3","subject":"Horticulture And Crop Production","term":"Third Term","text":"Week 1 Introduction to Agripreneurship  Meaning and scope  Importance in modern agriculture Week 2 Enterprise Development  Business idea generation  Planning for success Week 3 Record-Keeping and Bookkeeping  Simple bookkeeping in agribusiness Week 4 Financial Literacy  Budgeting, profit, and loss  Cost management Week 5 MID-TERM TEST  Assessment of Weeks 1–4 Week 6 Business Management  Leadership and teamwork Week 7 MID-TERM BREAK  Holiday/Rest Week 8 Marketing and Distribution  Market research, sales, and logistics Week 9 Sustainable Agriculture  Climate-smart farming  Environmental protection Week 10 Project Presentation  Students’ enterprise project Week 11 REVISION  Final review Week 12 EXAMINATION  End of Session Assessment Week 13 CLOSING/VACATION  Term ends"},{"page":0,"class":"SSS1","subject":"English Studies","term":"First Term","text":"Week 1 Spoken English: Oral Composition Skills I (Narrative) Vocabulary Development: Vocabulary Associated with the Home Grammar: Nouns – Numbers - Use of picture charts to develop narration. - Use of special words to bring out narrative elements in discourse. - Vocabulary: kitchen wares, utensils, wardrobe, pantry, dining room, upholstery. - Rules for forming plural nouns and practice in forming plural nouns. Week 2 Reading Comprehension: Word Meanings through Context Vocabulary Development: Vocabulary Associated with Family Life Listening Comprehension Continuous Writing: Narrative Grammar: Nouns and Gender - Dictionary use for word meanings; contextual usage. - Vocabulary: uncle, aunt, nephew, fiancé/fiancée, siblings, ancestor, naming ceremony. - Listening to selections (poems, stories, drama) reflecting national values. - Narrative composition: My First Day at College. - Grammar: four genders – masculine, feminine, common, neuter. Week 3 Spoken English: Selected Consonant Sounds (θ, ð, ʒ, ʃ) Vocabulary Development: Vocabulary Associated with Agriculture Reading Comprehension - Practice pronunciation: /ʃ/, /z/, /ʒ/, /θ/, /ð/. - Vocabulary: crops (yam, cassava, onions, cocoyam), farming activities (staking, pruning, ridge-making). - Reading comprehension passages for contextual meanings. Week 4 Grammar: Countable and Uncountable Nouns Listening Comprehension Reading Comprehension Continuous Writing: Narrative Grammar: Types of Nouns - Explanation of countable/uncountable nouns. - Uncountable nouns in singular forms (news, trousers, advice). - Listening selections: poem/passage. - Narrative composition: A Day I Will Never Forget. - Grammar: proper, common, concrete, collective, abstract nouns. Week 5 Midterm Examination Midterm Assessment covering Weeks 1–4 work. Week 6 Spoken English: Consonants followed by /w/ Vocabulary Development: Agriculture (Implements) Listening Comprehension Grammar: Noun Phrases with the Definite Article - Pronunciation: twist, sweep, swear, twig. - Vocabulary: farming implements (tractor, harvester, hoe, axe). - Listening comprehension. - Grammar: definition of noun phrase, role of definite article. Week 7 Midterm Break — Week 8 Listening Comprehension: Grasping Main Ideas Reading Comprehension: Contextual Word Meaning Continuous Writing: Narrative Grammar: Noun Phrases with Definite Article (exceptions) - Listening to real-life speeches, identifying main points. - Use of dictionary for contextual meanings. - Narrative composition: The Story of the Governor Who Stole Millions from the State Treasury. - Exceptions to article use (diseases, lakes, mountains, institutions, countries)."},{"page":0,"class":"SSS1","subject":"English Studies","term":"Second Term","text":"Week 1 Words Associated with Religions Vocabulary: Definition of traditional religion; words associated with traditional religion (shrine, cult, diviner, oracle, charm, amulet, ritual, sacrifice, etc.). Spoken English: Consonant sounds followed by /kw/ (quiet, quench, quarter, equal, question). Examples: He has the answer to the question; My friend lives in the junior staff quarter. Reading Comprehension: Short prose passages from student text, newspapers and magazines. Grammar: Simple tense forms (I come, you come, she comes, etc.); sentence construction and correction. Week 2 Vocabulary Associated with Christian Religion Vocabulary: Definition of Christianity; words associated with Christianity (Holy Bible, clergy, Pope, Bishop, nun, communion, pew, aisle, deacon, pastor, evangelist, repentance, prayer, fasting, convert, etc.). Listening Comprehension: Identifying details using connectives (because, as a result, for example, such as, consequently, etc.). Continuous Writing: Informal letter— meaning, format (address, date, salutation, body, closing). Grammar: Complex tense forms (I am coming, I have come, I have been coming, etc.) with illustrations. Week 3 Vocabulary Associated with Islamic Religion Vocabulary: Definition of Islam; words associated with Islam (Quran, mosque, hajj, pilgrimage, ablution, sheikh, sunna, hadith, prophet, saint, Sallah, Id-el-Kabir, Id-el-Fitr, praying mats, etc.). Spoken English: Syllabic /l/ in words (little, bottle, kettle, rattle, novel, simple). Reading Comprehension: As in Week 1. Grammar: Further practice on simple and complex tense forms. Week 4 Spoken English: Syllabic /n/ Spoken English: Syllabic /n/ in words (often, sudden, ripen, certain, mutton). Sentences: “There is a sudden knock at the door”; “It is certain she will visit.” Listening Comprehension: As in Week 2. Reading Comprehension: As in Week 1. Continuous Writing: Informal letter—meaning, format, tone (relaxed, flexible, may tolerate slang). Week 5 Midterm Examination — Week 6 Vocabulary Development (Other Religious Expressions) Vocabulary: Other words associated with religion (convert, fanatic, hermit, atheist, martyr, pantheist, saint, agnostic). Spoken English: Stress on two-syllable words with emphasis on second syllable (enjoy, engulf, inform, incite, welcome, excite). Listening Comprehension: As in Week 2. Dictation: Selected passages. Week 7 Midterm Break — Week 8 Listening Comprehension: Mood, Tone, and Purpose Listening Comprehension: Identifying mood, tone, and purpose from speeches, plays, and recordings. Reading Comprehension: Identifying mood, tone, and purpose of passages. Continuous Writing: Informal letter (revision). Grammar: Complex sentences—structure, types of clauses, examples. Week 9 Words Associated with Profession – Advertising Vocabulary: Definition of advertising; words associated (agent, promotion, publicity, poster, billboard, media, etc.). Spoken English: Stress in three-syllable words (exception, encompass, photograph, prohibit, exhibit, examine). Continuous Writing:"},{"page":0,"class":"SSS1","subject":"English Studies","term":"Third Term","text":"Week 1 Vocabulary Development – Antonyms (Words Exactly Opposite in Meaning) Vocabulary: Definition of antonyms; words opposite in meaning (good–bad, friendly–hostile, discipline–indiscipline, temporary– permanent, rich–poor, light–dark, black–white, man–woman). Spoken English: Stress timing in English sentences, correct phrasing and voice modulation in continuous prose reading. Use simple sentences such as: “Pick up that book”; “Who is writing the essay?” Reading Comprehension: Reading short prose passages on topical issues (waste disposal, HIV/AIDS, honesty, dignity in labour, exam malpractice, corruption). Grammar: Adjuncts (adverbs)—definition, functions, examples (place, time, manner, reason). Week 2 Vocabulary Development – Antonyms (Words Nearly Opposite in Meaning) Vocabulary: Words nearly opposite in meaning (cheerful– unhappy, sickly–healthy, harmonious–discordant, false– genuine, tough–tender). Listening Comprehension: Listening to identify a speaker’s style in different materials (expository, narrative, descriptive). Continuous Writing: Record keeping— writing simple records of class or daily events. Grammar: Adjuncts (revision); classes of adjuncts—place, time, manner, reason, degree—with sentence examples. Week 3 Vocabulary Development – Synonyms (Words the Same in Meaning) Vocabulary: Definition of synonyms; words that mean the same (quick–fast, strong–powerful, busy–engaged, brave–fearless, fearful–timid, enemy–foe). Spoken English: As in Week 1 (stress timing, phrasing, voice modulation). Reading Comprehension: As in Week 1 (making notes from texts). Grammar: Adjuncts—further examples (fast as adjective/adverb; quickest as superlative). Week 4 Listening Comprehension – Summary Skills Listening Comprehension: Listening for summary through key words (in addition, as well as, first, second, furthermore, despite, etc.). Reading Comprehension: Selected passages on topical issues (patriotism, privatization, kidnapping, corruption). Continuous Writing: Speech writing—features (opening greetings, introduction, body, conclusion); speeches for occasions (welcome address, prize giving, wedding toast). Dictation: Selected words from passages. Week 5 Midterm Examination — Week 6 Vocabulary Development – Synonyms (Words Nearly the Same in Meaning) Vocabulary: Words nearly the same in meaning (securely– safely, guest–visitor, adore–admire). Spoken English: Oral composition skills (expository writing, use of exact words and sentences). Grammar: Phrasal verbs (come across, come in, come up, come forward, etc.). Reading Comprehension: As in Week 4. Week 7 Midterm Break — Week 8 Continuous Writing – Speech Writing (Revision) Continuous Writing: Revising speech features (introduction, body, conclusion); characteristics of different types (welcome, toast, address). Vocabulary Development: Spelling of commonly misspelt words (receive, deceive, grateful, beginning,"},{"page":0,"class":"SSS1","subject":"Mathematics","term":"First Term","text":"Week 1 Number Base System - Conversion from one base to base 10 - Conversion of decimal fractions in one base to another - Arithmetic operations in number bases - Application to computer programming Week 2 Modular Arithmetic - Revision of arithmetic operations - Concept of modular arithmetic - Simple operations in modular arithmetic - Applications to daily life Week 3 Indices - Revision of standard form - Laws of indices with examples - Applications of indices in problem solving Week 4 Logarithms - Definition of logarithm - Relationship between logarithm, indices and standard form - Graph of 10^x - Reading logarithm and antilogarithm tables Week 5 Midterm Examination — Week 6 Effective Use of Logarithm Tables - Use of logarithm tables in calculations (division, multiplication, powers, roots) - Applications of logarithms in capital markets and real-life problem solving Week 7 Midterm Break — Week 8 Simple Equations and Variations - Change of subject of formula (involving roots, brackets, powers) - Substitution - Direct, inverse and joint variation - Applications of variation Week 9 Quadratic Equations I - Revision of factorization of integers - Factorization of quadratic expressions - Solution of quadratic equations by factorization Week 10 Quadratic Equations II - Formation of quadratic equations with given roots - Drawing quadratic graphs - Obtaining roots from graphs - Applications of quadratic equations to real life Week 11 Logical Reasoning I - Simple statements - Examples of true/false statements - Negation of simple statements Week 12 Logical Reasoning II - Compound statements: meaning and types - Logical operators and symbols - Conjunction, disjunction, conditional statements, biconditional Week 13 Revision, Examination & Closing —"},{"page":0,"class":"SSS1","subject":"Mathematics","term":"Second Term","text":"Week 1 Constructions I - Construction of angles and triangles - Bisection of angles: 30°, 45°, 60°, 90° - Application to problem-solving Week 2 Constructions II - Construction of equal angles and quadrilaterals - Locus of points equidistant from lines and points Week 3 Proofs of Theorems I - Proof that sum of angles in a triangle is 180° - Exterior angle of a triangle equals sum of opposite interior angles - Applications of theorems Week 4 Proofs of Theorems II (Riders) - Deductive proofs of riders - Angles of parallel lines - Angles in polygons - Congruent triangles - Properties of parallelograms - Intercept theorem Week 5 Midterm Examination — Week 6 Trigonometric Ratios - Trigonometric ratios in right-angled triangles (sine, cosine, tangent) - Solving problems using trigonometric ratios Week 7 Midterm Break — Week 8 Trigonometric Ratios of Special Angles - Ratios for 30°, 45°, 60° - Applications to solving problems Week 9 Application of Trigonometric Ratios - Applications of trigonometry in real-life contexts - Sine, cosine, tangent of angles between 0° and 360° Week 10 Trigonometric Ratios & Graphs - Trigonometric ratios with respect to the unit circle - Graphs of sine, cosine, and tangent Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS1","subject":"Mathematics","term":"Third Term","text":"Week 1 Mensuration I - Length of arcs of circles - Sectors and segments of a circle Week 2 Mensuration II - Area of sectors and segments - Relationship between sector of circle and surface area of a cone Week 3 Surface Area of Solids - Cube and cuboid - Cylinder, cone - Prism and pyramid - Using standard formulas Week 4 Volume of Solids - Cube and cuboid - Cylinder, cone - Prism and pyramid - Using formulas correctly Week 5 Midterm Examination — Week 6 Area and Volume of Frustum - Surface area and volume of frustum of cone and pyramid - Surface area and volume of compound shapes Week 7 Midterm Break — Week 8 Statistics I - Collection of meaningful data - Tabulation and presentation Week 9 Statistics II - Frequency distribution - Graphs: linear, bar charts, histograms Week 10 Statistics III - Pie charts - Frequency polygons Week 11 Revision — Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Citizenship And Heritage Studies","term":"First Term","text":"Week 1 Introduction to Citizenship & Heritage Studies Meaning, scope and importance; differences between citizenship and heritage; relevance to national identity Week 2 Origin of Citizenship Birth, registration, naturalization, honorary citizenship Week 3 Rights of Citizens Universal human rights; constitutional rights in Nigeria; rights vs privileges Week 4 Duties and Obligations of Citizens Civic responsibilities, loyalty, obedience to laws, tax payment Week 5 Midterm Test Week 6 National Symbols & Their Meanings Coat of arms, flag, anthem, pledge, currency, constitution Week 7 Midterm Break Week 8 Nigerian Heritage Cultural heritage (language, dress, festivals); historical heritage (monuments, sites) Week 9 Preservation of Nigerian Heritage Role of government, communities, families in preservation Week 10 Threats to National Heritage Urbanization, globalization, neglect, conflict, corruption 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Citizenship And Heritage Studies","term":"Second Term","text":"Week 1 Citizenship by Law Legal frameworks governing citizenship in Nigeria (1999 Constitution) Week 2 Rule of Law Concept, importance, equality before the law Week 3 Democratic Values Freedom, participation, tolerance, accountability Week 4 National Unity & Integration Need, benefits, symbols, strategies to promote unity Week 5 Midterm Test Week 6 Ethnic & Religious Heritage of Nigeria Diversity of ethnic groups and religions; respect for plurality Week 7 Midterm Break Week 8 Interpersonal Relations & Social Harmony Peaceful co-existence, tolerance, conflict resolution Week 9 Leadership & Followership Qualities of good leaders; duties of followers; examples from Nigerian history Week 10 Corruption & Its Effects on Citizenship Meaning, forms, dangers, prevention 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Citizenship And Heritage Studies","term":"Third Term","text":"Week 1 Global Citizenship Concept, rights and responsibilities, globalization Week 2 Citizenship Education in Other Countries Case studies (USA, UK, Ghana, South Africa) Week 3 International Organizations & Citizenship UN, AU, ECOWAS, Commonwealth Week 4 Protection of Human Rights NHRC, NGOs, judiciary, international courts Week 5 Midterm Test Week 6 Cultural Exchange & Tourism Importance for heritage and economy Week 7 Midterm Break Week 8 Contemporary Issues in Citizenship Migration, digital citizenship, climate change Week 9 Patriotism Meaning, importance, ways of showing patriotism Week 10 Civic Participation Voting, community service, volunteering 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Digital Technologies","term":"First Term","text":"Week 1 Introduction to Digital Technologies Meaning, scope, relevance in modern society Week 2 History & Evolution of Digital Technologies From abacus to AI; generations of computers Week 3 Number Systems Binary, decimal, octal, hexadecimal and conversions Week 4 Computer Hardware Input/output devices, storage, system vs peripheral devices Week 5 Midterm Test Week 6 Computer Software System software, application software, utility programs Week 7 Midterm Break Week 8 Operating Systems Functions, types, examples Week 9 Computer Maintenance & Safety Preventive care, health & safety measures Week 10 Data Representation Bits, bytes, ASCII, Unicode, images, sound 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Digital Technologies","term":"Second Term","text":"Week 1 Computer Networks LAN, WAN, MAN; components of networks Week 2 Internet Technologies Internet services, search engines, browsers Week 3 Email & Online Communication Email etiquette, instant messaging, conferencing Week 4 Digital Storage & Cloud Computing Types of storage, advantages of cloud, data backup Week 5 Midterm Test Week 6 Cybersecurity I Meaning, importance, threats (malware, phishing, hacking) Week 7 Midterm Break Week 8 Cybersecurity II Protection methods – antivirus, firewalls, strong passwords Week 9 Data Privacy & Digital Ethics Responsible use, cyberbullying, data protection laws Week 10 Social Media Technologies Benefits, risks, responsible digital citizenship 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Word Processing Applications Microsoft Word/Google Docs: features, formatting Week 2 Spreadsheet Applications I Introduction, basic formulas, cell referencing Week 3 Spreadsheet Applications II Functions, charts, data analysis Week 4 Presentation Software PowerPoint/Google Slides: slide creation, animations Week 5 Midterm Test Week 6 Database Introduction Concept of database, DBMS, tables, records, fields Week 7 Midterm Break Week 8 Practical Database Management Creating simple databases, queries, reports Week 9 Emerging Technologies I Artificial Intelligence, Internet of Things Week 10 Emerging Technologies II Robotics, Virtual Reality, Augmented Reality 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Biology","term":"First Term","text":"Week 1 Recognizing Living Things Characteristics and differences between living and non- living things Week 2 Classification of Living Things Importance of classification, levels of classification Week 3 Kingdoms of Living Things Monera, Protista, Fungi, Plantae, Animalia Week 4 The Cell Structure, types, and functions of cell organelles Week 5 Midterm Examination – Week 6 Cell and Its Environment Diffusion, osmosis, active transport Week 7 Midterm Break – Week 8 Properties and Functions of the Cell Nutrition, respiration, growth, irritability Week 9 Respiration Aerobic and anaerobic respiration Week 10 Growth and Irritability Meaning, processes, importance of growth and response to stimuli Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Biology","term":"Second Term","text":"Week 1 Tissue and Supporting System Types of tissues in plants and animals Week 2 Nutrition Types of nutrition, autotrophic and heterotrophic Week 3 Basic Ecological Concepts Habitat, ecosystem, ecological factors Week 4 Population Studies Population density, size, growth, and regulation Week 5 Midterm Examination – Week 6 Functioning Ecosystem Autotrophy, heterotrophy, food webs, trophic levels Week 7 Midterm Break – Week 8 Energy Transformation in Nature Energy flow, pyramid of energy, productivity Week 9 Relevance of Biology to Agriculture Application of biological principles in agriculture Week 10 Micro-Organisms Around Us Types, characteristics, and importance Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Biology","term":"Third Term","text":"Week 1 Micro-Organisms in Action Roles in fermentation, decay, food spoilage, and diseases Week 2 Towards Better Health Hygiene, sanitation, vaccination, disease prevention Week 3 Habitat Meaning, types, and examples Week 4 Aquatic Habitat Estuarine and freshwater habitats Week 5 Midterm Examination – Week 6 Terrestrial Habitat Types and features Week 7 Midterm Break – Week 8 Grassland Habitat Features, adaptations of organisms Week 9 Reproduction in Unicellular Organisms and Invertebrates I Binary fission, budding, spore formation Week 10 Reproduction in Unicellular Organisms and Invertebrates II Sexual and asexual reproduction in invertebrates Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Chemistry","term":"First Term","text":"Week 1 Introduction to Chemistry Definition, history, branches, and importance of chemistry Week 2 Chemical Industries and Laboratory Apparatus Common laboratory apparatus and their uses Week 3 Nature of Matter States of matter, properties, and changes of state Week 4 Separation Techniques Filtration, distillation, sublimation, chromatography Week 5 Midterm Examination – Week 6 Atomic Structure Structure of the atom; Subatomic particles Week 7 Midterm Break – Week 8 Periodic Table Groups, periods, and periodicity Week 9 Chemical Combination Laws of chemical combination Week 10 Acids, Bases, and Salts Definitions, examples, properties; pH scale; Neutralization Week 11 Chemical Symbols, Formulae, and Equations Writing symbols, formulae; Balancing equations Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Chemistry","term":"Second Term","text":"Week 1 Quantitative and Qualitative Analysis (Introduction) Basic concepts Week 2 Mole Concept and Stoichiometry Mole, molar mass, Avogadro’s number Week 3 Percentage Composition and Empirical Formula Calculations of composition and empirical formula Week 4 Gas Laws Boyle’s law, Charles’ law, Ideal gas equation Week 5 Midterm Examination – Week 6 Structure of the Atom and Electronic Configuration Bohr’s model; Electronic configurations Week 7 Midterm Break – Week 8 Ionic and Covalent Bonding Formation and properties Week 9 Oxidation and Reduction Definitions, examples, redox reactions Week 10 Water and Solution Properties, types of solutions, solubility Week 11 Solubility and Crystallization Saturated solutions; Solubility curves Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Chemistry","term":"Third Term","text":"Week 1 Introduction to Organic Chemistry Characteristics of organic compounds Week 2 Alkanes, Alkenes, and Alkynes Structures, properties, and examples Week 3 Isomerism Structural and geometric isomerism Week 4 Petroleum and Petrochemicals Refining, fractional distillation of petroleum Week 5 Midterm Examination – Week 6 Chemical Reactions and Types Combination, decomposition, displacement Week 7 Midterm Break – Week 8 Energy Changes in Reactions Endothermic and exothermic reactions Week 9 Rates of Chemical Reactions Factors affecting reaction rates Week 10 Reversible Reactions and Chemical Equilibrium Le Chatelier’s principle Week 11 Metals and Non-Metals Properties and uses Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Physics","term":"First Term","text":"Week 1 Fundamentals and Derived Quantities and Units Meaning of physical quantities, fundamental units, derived units, SI units Week 2 Measurements of Mass, Weight, Length and Time Definition, instruments used, accuracy and errors in measurement Week 3 Position, Distance and Displacement Concept of position, difference between distance and displacement, applications Week 4 Scalars and Vectors Definitions, differences, addition and resolution of vectors Week 5 Midterm Examination – Week 6 Speed, Velocity and Acceleration Definitions, equations, graphical representation Week 7 Midterm Break – Week 8 Motion Concept of motion, types of motion, equations of uniformly accelerated motion Week 9 Motion (Continued) Applications of equations of motion in real life Week 10 Motion (Continued) Graphical analysis of motion, problem solving Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Physics","term":"Second Term","text":"Week 1 Linear Momentum: Newton’s Laws of Motion Newton’s laws, momentum, impulse, conservation of momentum Week 2 Work, Energy and Power Definitions, equations, work done in different contexts Week 3 Mechanical Energy: Machines Simple machines, efficiency, mechanical advantage, velocity ratio Week 4 Heat Energy I: Temperature and Its Measurement Concept of heat, temperature scales, thermometers Week 5 Midterm Examination – Week 6 Heat Energy II: Heat Measurement Specific heat capacity, latent heat, calorimetry Week 7 Midterm Break – Week 8 Particulate Nature of Matter Molecular theory, evidence of particle nature, Brownian motion Week 9 Particulate Nature of Matter (Continued) Diffusion, pressure in gases, applications Week 10 Particulate Nature of Matter (Continued) Real-life applications of particle theory Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Physics","term":"Third Term","text":"Week 1 Fluids at Rest and in Motion Pressure in fluids, Pascal’s principle, Archimedes’ principle, Bernoulli’s principle Week 2 Gas Laws Boyle’s law, Charles’ law, pressure law, ideal gas equation Week 3 Simple Harmonic Motion Concept, examples, characteristics, equations Week 4 Projectile Concept, equations of projectile motion, range, maximum height Week 5 Midterm Examination – Week 6 Types of Waves Classification of waves: mechanical, electromagnetic, transverse, longitudinal Week 7 Midterm Break – Week 8 Properties of Waves Reflection, refraction, diffraction, interference, applications Week 9 Properties of Waves (Continued) Superposition of waves, resonance Week 10 Properties of Waves (Continued) Real-life applications of wave properties Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Agricultural Science","term":"First Term","text":"Week 1 Meaning and Importance of Agriculture - Definition of agriculture - Importance of agriculture to individuals and the nation Week 2 Problems of Agricultural Development and Solutions - Problems: land tenure, low technology, poor storage, pests and diseases - Suggested solutions Week 3 Subsistence and Commercial Agriculture - Meaning - Characteristics - Differences between subsistence and commercial farming Week 4 Role of Government in Agricultural Development - Agricultural programmes - Credit facilities - Extension services Week 5 Midterm Examination — Week 6 Role of NGOs in Agricultural Development - Contributions of NGOs (FAO, IFAD, etc.) - Importance of their interventions Week 7 Midterm Break — Week 8 Agricultural Laws and Reforms - Land use decree - Land tenure systems - Government reforms Week 9 Land and Its Uses - Types of land use (agriculture, forestry, housing, mining) - Importance of land Week 10 Agricultural Ecology - Meaning - Components of farm ecosystem - Interactions of crops and animals Week 11 Factors affecting Land Availability - Factors affecting land availability for agricultural purposes Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Agricultural Science","term":"Second Term","text":"Week 1 Agro-Allied Industries - Meaning - Examples (textile, breweries, oil mills) - Relationship with agriculture Week 2 Environmental Factors Affecting Agriculture - Rainfall - Temperature - Wind - Soil - Biotic factors Week 3 Rock Formation - Types of rocks (igneous, sedimentary, metamorphic) - Importance to agriculture Week 4 Soil Formation and Profile Development - Processes of soil formation - Soil horizons and profiles Week 5 Midterm Examination — Week 6 Soil Types, Composition and Properties - Types of soil - Physical and chemical properties - Soil texture and structure Week 7 Midterm Break — Week 8 Simple Farm Tools - Examples: hoe, cutlass, rake - Uses - Maintenance practices Week 9 Farm Machinery and Implements - Examples: tractors, planters, harvesters - Functions and advantages Week 10 Maintenance of Farm Machinery - Care and servicing of implements - Safety precautions Week 11 Problems of agricultural mechanization - Problems of agricultural mechanization Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Agricultural Science","term":"Third Term","text":"Week 1 Prospects of Agricultural Mechanisation - Meaning of mechanisation - Benefits and limitations Week 2 Sources of Farm Power - Human, animal, mechanical, electrical, solar, wind and water power Week 3 Classification of Crops - Food crops - Cash crops - Annuals, biennials and perennials Week 4 Husbandry of Selected Crops - Example: maize, cassava, yam - Land preparation, planting, maintenance and harvesting Week 5 Midterm Examination — Week 6 Pasture and Forage Crops - Meaning - Types - Importance in livestock production Week 7 Midterm Break — Week 8 Plant Nutrients and Nutrient Cycle - Macro and micro nutrients - Nitrogen and carbon cycles Week 9 Irrigation - Definition - Types of irrigation - Importance Week 10 Drainage - Meaning - Types of drainage systems - Importance Week 11 Agricultural Pollution - Agricultural pollution: meaning, causes, effects and control Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Further Mathematics","term":"First Term","text":"Week 1–2 Sets Definition of sets; set notation; types of sets (null, singleton, finite, infinite); subsets; universal set; power set; set operations (union, intersection, complement); number of elements in a set; Venn diagrams and applications up to 3-set problems. Week 3 Indices and Logarithms Laws of indices; applications of indices; solution of exponential equations up to quadratic form; laws of logarithms; change of base. Week 4 Surds Definition of surds; rules for manipulating surds; rationalization of the denominator. Week 5 Midterm Examination — Week 6 Linear Inequalities Linear inequalities in one variable; linear inequalities in two variables; graphs of linear inequalities. Week 7 Midterm Break — Week 8 Binary Operations Definition; laws of binary operations (associative, distributive, law of complementation); identity element and inverse; multiplication table of binary operations. Week 9 Functions Definition; types of functions (one-to-one, into, inverse, identity, constant, circular, logarithmic, exponential, composite); applications in problem- solving. Week 10 Sequence and Series Definition of sequence and series; nth term of a sequence; nth sum of a series; arithmetic progression (AP); geometric progression (GP). Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS1","subject":"Further Mathematics","term":"Second Term","text":"Week 1–2 Trigonometric Ratios of Special Angles & Logical Reasoning Trigonometric ratios of 30°, 45°, and 60°; applications of special angles; introduction to logical reasoning. Week 3 Calculating and Processing Devices Abacus; decimal and binary systems; flow charts; application of flow charts in problem-solving. Week 4 The Straight Line in Coordinate Geometry Midpoint of a line segment; gradient of a straight line; distance between two points; conditions for parallelism and perpendicularity; equation of a straight line; transforming relations into linear form; area of triangles and quadrilaterals. Week 5 Midterm Examination — Week 6 Vectors in Two Dimensions I Scalars and vectors; zero and negative vectors; vector addition and subtraction; scalar multiplication; magnitude and direction of a vector; unit vectors. Week 7 Midterm Break — Week 8 Vectors in Two Dimensions II Triangle law; parallelogram law; resolution of vectors; scalar (dot) product; applications. Week 9–10 Revision — 11–12 Examination —"},{"page":0,"class":"SSS1","subject":"Further Mathematics","term":"Third Term","text":"Week 1–2 Location Measures of central tendency: mean, mode, median, deciles, percentiles, quartiles. Week 3–4 Measures of Dispersion Range, interquartile range, mean deviation, standard deviation. Week 5 Midterm Examination — Week 6 Measures of Location Coefficient of variation and its applications. Week 7 Midterm Break — Week 8 History and Nature of Operations Research Meaning and scope of operations research; models of operations research (linear programming, transportation models, assignment models). Week 9 Models Practical application of linear programming, transportation (least cost, northwest corner), and assignment models. Week 10 Application of Models Further applications of OR models in real-life problem-solving. Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS1","subject":"Food And Nutrition","term":"First Term","text":"Week 1 Introduction to Food and Nutrition Definition of basic terms in food and nutrition (food, nutrition, antinutrient, malnutrition, pro-vitamin, etc.); Importance of foods and nutrition; Factors affecting foods and nutrition e.g., available income, availability of food, foods in season, etc. Week 2 Careers in Food and Nutrition Careers in foods and nutrition e.g., Teaching, Dietetics, Food Science and Technology, Food Engineering, Community Nutrition, Clinical Nutrition, Hotel and Catering Management. Week 3 Interrelationship of Food and Nutrition with Other Subjects Relationship between food and nutrition and other subjects. Week 4 Foods in the Locality Foods in the locality; Nutrients quality; Functions according to their nutrient quality. Week 5 Midterm Examination – Week 6 Basic Food Nutrients (Carbohydrates) Composition; Classification; Functions; Dietary deficiencies; Food sources of carbohydrates. Week 7 Midterm Break – Week 8 Proteins Composition; Classification; Complementary and supplementary values of protein; Functions; Dietary deficiencies; Food sources. Week 9 Fats and Oils Differences between fats and oils; Classification; Functions; Dietary deficiency symptoms/diseases; Food sources. Week 10 Vitamins & Minerals Vitamins – Chemical names, classifications, functions, deficiency symptoms/diseases, food sources. Minerals – Classification, functions, deficiency symptoms/diseases, food sources. Week 11 Water Chemical composition, functions, food sources. Week 12 Revision – Week 13 Examination & Closing –"},{"page":0,"class":"SSS1","subject":"Food And Nutrition","term":"Second Term","text":"Week 1 Scientific Study of Foods Measurements, units, and accuracy; Food weighing; Nutrient weight; Uses of scales, weights, and handy measures. Week 2 Effects of Heat on Nutrients Effects of heat on carbohydrates, proteins, fats and oils, minerals, and vitamins. Week 3 Tests for Proteins Foam test, Millon test, Biuret test, Coagulation test. Week 4 Tests for Carbohydrates, Fats, and Oils Iodine test, Litmus test, Blotting paper test, Sudan III test, Ethanol test. Week 5 Midterm Examination – Week 6 The Digestive System Definition of simple metabolic processes – digestion, absorption, utilization, enzymes. Week 7 Midterm Break – Week 8 Digestion and Absorption Digestion process from the mouth, stomach, duodenum, small intestine or ileum. Week 9 Reproductive Health Definition; Identification of female and male reproductive organs; Relationship between nutrition and reproductive health. Week 10 Kitchen Plans, Equipment, and Tools Definition; Kitchen plans or layout; Factors that affect size of a kitchen; Advantages of a well-planned kitchen. Week 11 Kitchen Plans, Equipment, and Utensils Factors to consider when selecting kitchen equipment/tools; Large kitchen equipment – selection and care. Week 12 Small or Moveable Tools/Utensils Small or moveable utensils – selection, use, and care; Labour- saving devices. Week 13 Revision, Examination & Closing –"},{"page":0,"class":"SSS1","subject":"Food And Nutrition","term":"Third Term","text":"Week 1 Cleaning Agents and Abrasives - Definition - Types - Commercial cleaning agents - Local cleaning agents Week 2 Safety Habits in the Kitchen - Causes of accidents in the kitchen - Measures to prevent falls - Measures to prevent burns and scalds Week 3 Measures to Prevent Cuts, Suffocation and Accidental Poisoning - Measures to prevent cuts - Measures to prevent suffocation - Measures to prevent accidental poisoning Week 4 Content and Use of First Aid Box; Simple First Aid Treatment - Definition - Content and use of a first aid box - Simple first aid treatment for cuts, burns and scalds Week 5 Midterm Examination — Week 6 Hygiene: Personal Hygiene - Definition - Personal hygiene - Rules for personal hygiene of the food handler Week 7 Midterm Break — Week 8 Food and Kitchen Hygiene - Definition - Rules of kitchen hygiene - Definition - Rules of food hygiene Week 9 Waste and Refuse Disposal - Methods of waste disposal - Use of refuse bins and bags - Use and care of bins - Pests and pest control Week 10 Food Borne Diseases - Food poisoning - Food infection - Prevention of food borne diseases - Food sanitation laws Week 11 ICPC - Misappropriate execution of family food budgets Week 12 Examination Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Geography","term":"First Term","text":"Week 1 Introduction to Geography Meaning, nature, scope, and value of geography Week 2 The Earth and Other Planets Characteristics of the Earth, comparison with other planets Week 3 Earth’s Rotation and Revolution Rotation: effects; Revolution: seasons, solstices, equinoxes Week 4 Latitudes and Longitudes Definitions, uses in location and time calculation Week 5 Midterm Examination – Week 6 The Earth’s Structure Layers: crust, mantle, core – composition and importance Week 7 Midterm Break – Week 8 Rocks Types of rocks: igneous, sedimentary, metamorphic; formation and importance Week 9 Town/Village Characteristics, similarities and differences Week 10 The Local Government Area (LGA) Definition, functions, importance in geography Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Geography","term":"Second Term","text":"Week 1 Mountains Types: block, fold, volcanic; formation and importance Week 2 Lowlands Types, examples in Nigeria and West Africa, importance Week 3 The Environment Meaning, components (physical and human), interactions Week 4 Weather Meaning, elements of weather, instruments for measurement Week 5 Midterm Examination – Week 6 Climate I Meaning, elements, factors influencing climate Week 7 Midterm Break – Week 8 Nigeria: Location and Position Latitudinal and longitudinal extent, boundaries, neighbours Week 9 Physical Setting of Nigeria Relief, drainage, vegetation zones Week 10 – – Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Geography","term":"Third Term","text":"Week 1 Population of Nigeria Size, distribution, density, factors influencing population Week 2 Resources of Nigeria Types: human and natural; distribution and importance Week 3 Basic Concepts in Map Reading Scale, direction, symbols, conventional signs Week 4 Map Distances Methods of measuring distances on maps Week 5 Midterm Examination – Week 6 Map Reduction and Enlargement Techniques, practical exercises Week 7 Midterm Break – Week 8 Interpretation of Physical and Cultural Features Relief, drainage, settlement, transport features Week 9 Transportation Modes: road, rail, water, air; importance and problems Week 10 – – Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Technical Drawing","term":"First Term","text":"Week 1 Introduction to Technical Drawing Meaning of technical drawing; Career opportunities requiring technical drawing skills; Specific uses of various drawing materials Week 2 Safe Working Habits Practice of good and safe working habits in technical drawing Week 3 Board Practice Fixing drawing sheet to the drawing board; Sharpening pencil into conical shape using sandpaper; Drawing borderlines and title block Week 4 Lines (Types of Lines) Identification of various types of lines and their applications; Drawing different line types correctly; Differentiating between perpendicular and parallel lines Week 5 Midterm Examination – Week 6 Lettering and Numbering Distinction between upper and lower case letters; Writing numbers 0–9 correctly Week 7 Midterm Break – Week 8 Plane Geometry – Division of Line Bisection of given lines; Trisection of lines; Dividing a given line into a number of equal parts; Dividing a line into given ratios and proportions Week 9 Circles Types of circles; Identification of parts and properties of circles; Division of circles into equal parts; Recognition of circular objects around us Week 10 Angles – Construction and Measurement Comprehending vertical walls forming angular relation with the ground; Recognizing angles in terms of rotation; Classification and description of angles; Relating angles to shapes; Ordering angles greater or less than a right angle Week 11 Triangles Identification of roof truss of a building with low ridge roof; Labeling and explaining parts of triangles; Description of types of triangles; Construction of triangles; Inscribed, circumscribed and ascribed circles of triangles; Differentiation among inscribed, circumscribed and ascribed circles Week 12 Quadrilaterals Description of quadrilaterals and their properties; Recognition of quadrilaterals in classroom objects; Construction of different quadrilaterals Week 13 Revision, Examination and Closing General revision and end of term examination"},{"page":0,"class":"SSS1","subject":"Technical Drawing","term":"Second Term","text":"Week 1 Introduction to Polygons – Properties and Construction of Polygons Recognition of polygon-shaped sign boards on roads; Differentiation between types of polygons; Construction of regular and irregular polygons of different sizes using various methods Week 2 Introduction to Polygons (Continued) Further recognition and classification of polygons; Advanced construction of polygons with compass and ruler Week 3 Introduction to Polygons (Continued) Exercises on properties of polygons; Practical construction of polygons of various sizes Week 4 Scales Meaning and uses of scales; Types of scales (plain, diagonal, RF); Distinguishing between plain and diagonal scales; Placing dimensions on objects using scales; Reading and interpreting scales Week 5 Midterm Examination – Week 6 Enlargement and Reduction of Plane Figures Applications of enlargement and reduction; Enlargement and reduction of plane figures using ratios of areas; Reproduction of plane figures to a given scale Week 7 Midterm Break – Week 8 Equal Areas of Similar Figures Principles of determining equal areas; Conversion of one plane figure to another of equal area by construction; Determining areas graphically Week 9 Equal Areas of Similar Figures (Continued) More exercises on equal area conversion; Advanced graphical methods of determining areas Week 10 Tangents and Tangency – Properties and Construction Relationships between centers, normals and tangents; Principles and applications of tangency; Construction of tangents to a circle from a point outside; Tangents to equal and unequal circles; Practical applications Week 11 Revision General revision of term’s work Week 12 Examination End of term examination"},{"page":0,"class":"SSS1","subject":"Technical Drawing","term":"Third Term","text":"Week 1 Loci, Parabola, Hyperbola, Ellipse Identification and explanation of types of loci; Construction of loci; Plotting and tracing loci of given points; Loci in simple crank mechanism Week 2 Loci, Parabola, Hyperbola, Ellipse (Continued) Further construction of loci; Exercises on parabola, hyperbola, ellipse; Applications in engineering and design Week 3 Loci, Parabola, Hyperbola, Ellipse (Continued) Advanced plotting of loci; Problem-solving applications involving mechanisms Week 4 Prisms Description and properties of prisms; Identification of real objects shaped like prisms (cube, maths set, etc.); Construction of various types of prisms; Cardboard model production of prisms Week 5 Midterm Examination – Week 6 Pyramids and Cones Description of pyramids and cones; Identification of objects shaped like pyramids and cones (funnels, buckets, etc.); Construction of pyramids and cones; Cardboard model production Week 7 Midterm Break – Week 8 Surface Development Principles and importance of surface development; Construction of surface development of frustum of solids, right and oblique solids Week 9 Surface Development (Continued) Advanced exercises on surface development of solids; Practical applications in packaging and metal works Week 10 Dimensioning Measurement of classroom objects (bench, door, blackboard, etc.); Principles and rules guiding dimensioning; Applications with illustrations Week 11 Construction of Isometric Explanation of isometric drawing and axis; Drawing blocks involving lines, arcs and circles; Techniques of isometric circles; Visualization of cubes with circles/curves; Drawing isometric cube showing ellipse Week 12 Examination End of term examination Week 13 Closing End of term activities and vacation"},{"page":0,"class":"SSS1","subject":"Nigerian History","term":"First Term","text":"Week 1 Introduction to History Meaning and scope of History; Importance and relevance of History in nation-building Week 2 Why We Teach History Educational, moral, political, and social values of studying History Week 3 Sources of History I Oral tradition, written sources, archaeology, linguistics, and material remains Week 4 Sources of History II and Dating Determining historical time – calendar systems, radiocarbon dating, genealogical methods Week 5 Midterm Test — Week 6 Historical Skills Ancient and modern approaches to historical analysis; critical thinking, evaluation of evidence Week 7 Midterm Break — Week 8 Prospects of ICT in Historical Studies Use of ICT in data collection, storage, and presentation of historical facts Week 9 Land and Peoples of Nigeria Geographical and ethnic diversity; location, climate, vegetation, and major ethnic groups Week 10 Traditions of Origin and Historical Links Myths, legends, and oral accounts of the origins of major Nigerian groups Week 11 Revision Review of all topics covered in the term Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Nigerian History","term":"Second Term","text":"Week 1 Early Centres of Civilization in Nigeria Nok culture, Igbo-Ukwu, Ife, and Benin civilizations; archaeological findings and significance Week 2 State Formation Process I Concept of centralized and non-centralized states; political organization Week 3 Centralized States I Kanem and Bornu to 1800 – political organization, trade, and religion Week 4 Centralized States II Hausa States to 1800 – city-states, economy, and leadership Week 5 Midterm Test — Week 6 Centralized States III Nupe, Jukun, Ife, Oyo, Benin, and Efik – origins, administration, and achievements Week 7 Midterm Break — Week 8 Non-Centralized States I Tiv, Idoma, Igbo, Ibibio, Ijaw – social and political organization Week 9 Non-Centralized States II Aspects of their history and inter-group interactions Week 10 Inter-group Relations I Economic activities and trade between groups; cultural exchanges Week 11 Revision Review of major civilizations and inter-group relations Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Nigerian History","term":"Third Term","text":"Week 1 Inter-group Relations II The impact of migrations, wars, and politics on inter-group relations Week 2 Indigenous Technology and Industries Iron smelting, weaving, pottery, carving, and blacksmithing Week 3 Early External Influences Contact with North African trade and introduction of Islam Week 4 The Trans-Saharan Trade Routes, goods exchanged, and impact on Nigerian societies Week 5 Midterm Test — Week 6 Islam in Kanem-Bornu and Hausa Land Spread, influence, and contributions to governance and education Week 7 Midterm Break — Week 8 Early European Contacts Arrival of the Portuguese and other Europeans; trade, exploration, and missionary activities Week 9 Trans-Atlantic Slave Trade I Origin and organization of the Atlantic slave trade Week 10 Trans-Atlantic Slave Trade II Effects of the slave trade on African societies and economies Week 11 Revision Comprehensive review of the session’s work Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Government","term":"First Term","text":"Week 1 Meaning, Nature and Scope of Government Definition of government; nature and scope; importance of government Week 2 Basic Concepts of Government Power, authority, legitimacy, sovereignty Week 3 Basic Principles of Government Rule of law, separation of powers, checks and balances Week 4 Types and Characteristics of Government Unitary, federal, confederal systems; features, merits, and demerits Week 5 Midterm Examination – Week 6 Systems of Government Parliamentary and presidential systems; features, merits, and demerits Week 7 Midterm Break – Week 8 Political Ideologies Capitalism, socialism, communism, fascism – meaning, features, and applications Week 9 Constitution Meaning, sources, features, types, and importance Week 10 Rule of Law and its Limitations Meaning of rule of law; limitations in practice Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Government","term":"Second Term","text":"Week 1 Separation of Powers and Its Application Meaning and application in presidential and parliamentary systems Week 2 Delegated Legislation Meaning, reasons for, types, merits, and demerits Week 3 Citizenship Meaning, acquisition, rights, duties, and obligations Week 4 Process of Political Socialisation Meaning, agents, and importance of political socialisation Week 5 Midterm Examination – Week 6 Political Participation Forms, importance, and limitations of political participation Week 7 Midterm Break – Week 8 Public Opinion Meaning, formation, measurement, importance, and limitations Week 9 Political Parties Definition, types, functions, and importance Week 10 Party System One-party, two-party, and multi-party systems; merits and demerits Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Government","term":"Third Term","text":"Week 1 Pressure Groups Meaning, types, functions, similarities and differences with political parties Week 2 Public Administration Meaning, features, importance, and functions Week 3 Civil Service Meaning, characteristics, structure, roles, and problems Week 4 Local Government Meaning, features, functions, sources of revenue, challenges Week 5 Midterm Examination – Week 6 Pre-Colonial Administration in Nigeria Hausa/Fulani, Yoruba, and Igbo systems of administration Week 7 Midterm Break – Week 8 Colonial Administration in Nigeria Features, structures, merits, and demerits Week 9 Nationalism in Nigeria Meaning, factors, roles of individuals and groups, effects Week 10 – – Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Christian Religious Studies","term":"First Term","text":"Week 1 Jesus as the Lamb, the Door, and the Good Shepherd I Jesus as the Lamb (John 1:29, 36), the Door (John 10:7–9), the Good Shepherd (John 10:11–15) Week 2 Jesus as the Lamb, the Door, and the Good Shepherd II Further teachings and applications of Jesus as Lamb, Door, Shepherd Week 3 Jesus the Light of the World John 8:12, 9:5 – meaning and significance Week 4 Jesus as the True Vine John 15:1–11 – importance of abiding in Christ Week 5 Midterm Examination – Week 6 Jesus as the Living Bread and Water John 6:25–40; 4:7–15 – Christ as sustainer of life Week 7 Midterm Break – Week 8 God’s Love for Man John 3:16, Romans 5:8 Week 9 God’s Love for One Another 1 John 4:7–12 Week 10 Justification by Faith Romans 5:1–5; Galatians 2:16 Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Christian Religious Studies","term":"Second Term","text":"Week 1 New Life in Christ 2 Corinthians 5:17; Romans 6:1–11 Week 2 Sonship John 1:12, Romans 8:14–17 Week 3 Faith and Work James 2:14–26 Week 4 The Fruit of the Spirit Galatians 5:22–23 Week 5 Midterm Examination – Week 6 Spiritual Gifts 1 Corinthians 12:4–11 Week 7 Midterm Break – Week 8 Forgiveness Matthew 6:14–15; Luke 17:3–4 Week 9 Humility Philippians 2:3–8 Week 10 – – Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Christian Religious Studies","term":"Third Term","text":"Week 1 Effective Prayer Matthew 6:5–15, Luke 18:1–8 Week 2 Living a Life of Witnessing to Christ I Acts 1:8, Matthew 28:18–20 Week 3 Living a Life of Witnessing to Christ II Practical examples of witnessing through lifestyle Week 4 Christians’ Attitudes Towards Persecution Matthew 5:10–12; Acts 7:54–60 Week 5 Midterm Examination – Week 6 Impartiality James 2:1–9 Week 7 Midterm Break – Week 8 Resurrection and the Second Coming of Jesus Christ I 1 Corinthians 15:12–23; 1 Thessalonians 4:13–18 Week 9 Resurrection and the Second Coming of Jesus Christ II Revelation 21:1–8; Matthew Week 10 The Sovereignty of God Romans 9:14–24, Psalm 115:3 Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Visual Arts","term":"First Term","text":"Week 1 Introduction to Visual Arts I - Meaning of visual arts: consciously created through expression of skill or imagination - Visual arts as making skillful use of materials for human use and pleasure - Classification of visual arts: Fine Arts (Drawing, Painting, Sculpture); Applied Arts (Graphics, Textile, Ceramics) Week 2 Introduction to Visual Arts II - Functions of visual arts: Utilitarian (teacups, clothes, posters); Aesthetic (painting, sculpture); Religious (idols, masks, divination tray); Political (stools, symbols); Educational role of art Week 3 Visual Sense - Dynamics of basic shapes in objects (e.g. cylinder in bottle) - Colour reflections and mixtures - Uniqueness of surface likeness (texture) - Nuances of colour mixture on objects Week 4 Professions and Job Opportunities in Visual Arts - Professions: graphic designer, video editor, cartoonist, textile designer, painter, sculptor, ceramicist, photographer, cultural officer, medical illustrator, investigative illustrator Week 5 Midterm Examination — Week 6 Drawing Lines - Concept of lines - Types: vertical, horizontal, diagonal, wavy, spiral, zig-zag - Qualities: thick, thin, heavy, light, rigid, flexible - Lines as patterns in nature Week 7 Midterm Break — Week 8 Drawing Nature and Man-Made Objects - Woodland (trees without leaves) - Animal patterns (zebra, skeletons, veins in leaves) - Lines as patterns in man-made objects (railway lines, bridges, fences, steel frameworks) Week 9 Drawing and Shading - Eye and hand coordination - Imitative drawing - Shading techniques: cross-hatching, pointillism, blurring, hatching Week 10 Drawing Still Life Objects - Composition of inanimate objects - Perspective in object drawing - Texture and tone in natural objects (flowers, rocks, fruits, vegetables, insects, fish) Week 11 Drawing the Human Figure - Life drawing composition - Proportion - Tonality Week 12 Introduction to Art Appreciation - Analysis and evaluation of works of art - Elements and principles of design - Composition and harmony - Significance of pictorial elements - Art terminologies: appliqué, balance, bas-relief, calligraphy, cartoon, motif, silhouette, cire perdue"},{"page":0,"class":"SSS1","subject":"Visual Arts","term":"Second Term","text":"Week 1 Introduction to Graphics I - Block lettering and calligraphic lettering - Spacing, formation, streamlining, loops, curves, ascenders, descenders - Skill and craftsmanship Week 2 Introduction to Graphics II - Elements of design: line, texture, colour, size, value, shape - Principles of design: balance, contrast, proportion, variety, gradation, harmony Week 3 Forms of Graphic Advertisement I - Types: newspapers, posters, handbills, invitation cards, book covers Week 4 Forms of Graphic Advertisement II - CD jackets, banners - Features: suitable design, legibility, communication, technical proficiency, colour distribution, harmony, symbolism Week 5 Midterm Examination — Week 6 Introduction to Computer Graphics - Computer hardware: monitor, system unit, printer, keyboard, mouse - Computer software: instructions for operation (CorelDraw, Harvard Graphics, Photoshop) Week 7 Midterm Break — Week 8 Computer Graphics II - Basic mouse techniques: pointing, clicking, double-clicking, dragging Week 9 Textile Designs I - Motif: single unit of design - Repeat patterns: block, half drop, mirror, ogee, brick, diamond Week 10 Textile Designs II - Printed textile design - Printing techniques: block, lino cut, woodcut, yarn cut, screen printing Week 11 Terminologies in 2- Dimensional Art - Terms: vanishing point, medium, chiaroscuro, foreshortening, aerial view, repeat motif, picture plane Week 12 Terminologies in 3- Dimensional Art - Terms: terra-cotta, sculpture in the round, greenware, leather hard, maquette, relief Week 13 Revision, Examination & Closing —"},{"page":0,"class":"SSS1","subject":"Visual Arts","term":"Third Term","text":"Week 1 Introduction to Modelling I - Meaning of modelling - Basic concepts of form building - Clay as a modelling material Week 2 Introduction to Modelling II - Types of clay: primary clay, secondary clay - Properties of clay: pliability, plasticity, porosity Week 3 Introduction to Modelling III - Ceramic tools and equipment - Methods of moulding: coiling, slabbing, pinching Week 4 Introduction to Modelling IV - Processes of drying and firing clay works - Finishing techniques Week 5 Midterm Examination — Week 6 Historical Foundation of Nigerian Arts I - General overview (200 BC – 1900 AD) - Nok art Week 7 Midterm Break — Week 8 Historical Foundation of Nigerian Arts II - Igbo-Ukwu art - Ife art: terracotta, bronze works, quartz carving Week 9 Historical Foundation of Nigerian Arts III - Benin art: bronze works, ivory carving - Owo terracotta - Tsoede bronze Week 10 Historical Foundation of Nigerian Arts IV - Esie soapstone - Wood carving: Ekpo mask of the Ibibios and Annangs - Alok monoliths (Ikom, Cross River State) Week 11 Museums and Art I - Definition of museum: institution/building where valuable objects are preserved and displayed - Definition of art gallery: a place for exhibiting and sometimes selling artworks Week 12 Museums and Art II - History of museums in Nigeria - Types of museums: Natural History Museum (Ife), War Museum (Umuahia), Museum of Nigerian Traditional Architecture (Jos) Week 13 Revision, Examination & Closing —"},{"page":0,"class":"SSS1","subject":"Literature-In-English","term":"First Term","text":"Week 1 Introduction to Literature - Definition of Literature - Functions of Literature - Importance of studying Literature Week 2 Literary Appreciation - Meaning of Literary Appreciation - Elements of Literary Appreciation: Theme, Plot, Setting, Style, Tone, Mood Week 3 Literary Devices I - Meaning and examples of Figures of Speech: Simile, Metaphor, Irony, Personification, Oxymoron Week 4 Literary Devices II - Additional Figures of Speech: Euphemism, Alliteration, Hyperbole, Allusion, Assonance, Paradox, Repetition Week 5 Midterm Examination — Week 6 Genres/Branches of Literature - Overview of the three genres of Literature: Prose, Poetry, Drama - Structural features of each genre Week 7 Midterm Break — Week 8 Shakespearean Text: Antony and Cleopatra I - Background of William Shakespeare - Background and setting of Antony and Cleopatra - Plot summary (Acts I–II) Week 9 Shakespearean Text: Antony and Cleopatra II - Plot summary (Acts III–V) - Themes and characterization Week 10 Shakespearean Text: Antony and Cleopatra III - Language and style - Imagery and dramatic techniques - Relevance to modern society Week 11 Revision Review of all topics and texts (Weeks 1–10) Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Literature-In-English","term":"Second Term","text":"Week 1 Introduction to African Drama - Features of African Drama - Oral tradition and cultural elements in African plays Week 2 African Drama: Bosede Ademilua- Afolayan’s Once Upon an Elephant I - Background of the playwright - Background of the text - Setting and summary of Act One Week 3 African Drama: Once Upon an Elephant II - Plot summary (Act Two) - Themes and characterization Week 4 African Drama: Efua Sutherland’s The Marriage of Anansewa I - Background of the playwright - Background of the text - Plot summary and analysis of Act One Week 5 Midterm Examination — Week 6 African Drama: The Marriage of Anansewa II - Themes, style, and characterization - Cultural values and moral lessons Week 7 Midterm Break — Week 8 Non-African Drama: J. D. Priestley’s An Inspector Calls I - Background of the playwright - Historical context - Setting and summary (Acts I–II) Week 9 Non-African Drama: An Inspector Calls II - Themes, style, and characterization - Social commentary and moral implications Week 10 Non-African Drama: Robert Bolt’s A Man for All Seasons - Background of the playwright - Themes of integrity, conscience, and power Week 11 Revision Review of all topics and plays (Weeks 1–10) Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Literature-In-English","term":"Third Term","text":"Week 1 Introduction to Prose - Features of prose - Elements: Plot, Setting, Characterization, Theme, Point of View Week 2 African Prose: Pede Hollist’s So the Path Does Not Die I - Background of the author - Setting and plot summary (Chapters 1–4) Week 3 African Prose: So the Path Does Not Die II - Themes, style, and characterization - Socio-cultural issues in the text Week 4 Non-African Prose: Harper Lee’s To Kill a Mockingbird I - Background of the author - Plot summary (Chapters 1– 5) - Setting and tone Week 5 Midterm Examination — Week 6 Non-African Prose: To Kill a Mockingbird II - Themes of justice, racism, and innocence - Character analysis and style Week 7 Midterm Break — Week 8 African Poetry I - Gabriel Okara – “Once Upon a Time” - Niyi Osundare – “Not My Business” - Themes, tone, and poetic devices Week 9 African Poetry II - Wole Soyinka – “Night” - Syl Cheney-Coker – “The Breast of the Sea” - Imagery, symbolism, and structure Week 10 Non-African Poetry - Maya Angelou – “Still I Rise” - Lord Byron – “She Walks in Beauty” - Themes, diction, and moral lessons Week 11 Revision Review of all prose, drama, and poetry texts Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS1","subject":"Catering And Craft Practice","term":"First Term","text":"Week 1 Introduction to Catering Craft Origin of catering craft; Careers in catering craft. Week 2 Hospitality Industry in Catering Definition of hospitality industry; Relationship between hospitality industry and catering trade; Classification and components of hospitality industry. Week 3 Importance and Characteristics of Hospitality Industry Importance of hospitality industry; Characteristics of hospitality industry. Week 4 Catering Establishments I Classification of catering establishments; Types of catering establishments. Week 5 Midterm Examination — Week 6 Catering Establishments II Functions of catering establishments; Hotel rating. Week 7 Midterm Break — Week 8 Culinary Terms Commonly used culinary terms; Glossary of culinary terms; Compilation of menu in French. Week 9 Safety Precautions in the Kitchen Meaning of safety; Types and causes of accidents; Prevention and management of accidents in the kitchen. Week 10 First Aid in Catering Meaning of first aid, first aider, and first aid box; Contents of first aid box; Fire control and fire equipment. Week 11 Sanitation and Hygiene Meaning of sanitation; Aims and types of sanitation; Meaning and types of hygiene; Food contamination and food poisoning; Practices of personal hygiene. Week 12 Revision — Week 13 Examination —"},{"page":0,"class":"SSS1","subject":"Catering And Craft Practice","term":"Second Term","text":"Week 1 Revision of First Term Work / Pre-Resumption Test General recall of first term topics; Food commodities. Week 2 Food Commodities I Poultry: definition, nutritive value, preparation and uses; Meat/Game: classification, nutritive value, cuts of meat, meat dishes. Week 3 Food Commodities II Fish: identification, classification, selection factors; Dairy products: types, examples, nutritive value, uses. Week 4 Food Commodities III Eggs: structure, composition, nutritive value, uses in cookery, factors to consider when buying, planning and preparing egg dishes. Week 5 Midterm Examination — Week 6 Food Commodities IV Fruits and Vegetables: classification, examples, cooking factors, importance in diets. Week 7 Midterm Break — Week 8 Food Commodities V Cereals and pulses: types, factors to consider, storage. Spices and herbs: definitions, uses, factors to consider when using. Week 9 Principles of Cooking Methods Principles of cooking; Types of heat transfer; Effects of heat on food nutrients; Classification of cooking methods. Week 10 Methods of Cooking I Boiling, poaching, steaming, stewing: advantages and disadvantages. Week 11 Methods of Cooking II Frying, baking, roasting, grilling: advantages and disadvantages. Week 12 Revision — Week 13 Examination —"},{"page":0,"class":"SSS1","subject":"Catering And Craft Practice","term":"Third Term","text":"Week 1 Welcome Test / Revision of Last Term’s Work Answering test questions; Recall of previous topics taught in the last term. Week 2 Food and Beverage Service I Functions of food and beverage manager; Duties of restaurant manager; Responsibilities of head waiter; Functions of banquet hall waiter. Week 3 Personnel in Food and Beverage Area Station waiter; Wine stewards; Junior waiter; Barman, bartender, mixologist, bar keeper; Responsibilities of each personnel. Week 4 Types of Food Services I Plate service; Family service; Cafeteria service; Differences between the methods. Week 5 Midterm Examination — Week 6 Types of Food Services II Self-service; Guéridon service; Silver service; Distinctions and applications. Week 7 Midterm Break — Week 8 Demonstration on Types of Food Service Practical demonstration of plate, family, cafeteria, self, guéridon, and silver services. Week 9 Table Cover Meaning of cover; Types of cover; Laying the table; Table wares required for different covers. Week 10 Napkin Folding Meaning of napkin folding; Types and styles of napkin folds; Methods of folding napkins. Week 11 Demonstration of Napkin Folds and Placement of Table Wares Practical demonstration of napkin folding; Placement of table wares alongside folded napkins. Week 12 Revision General review of the third term’s topics. Week 13 Examination —"},{"page":0,"class":"SSS1","subject":"Financial Accounting","term":"First Term","text":"Week 1 Book-Keeping and Accounting Meaning of book-keeping; Difference between book-keeping and accounting; Importance of accounting Week 2 Ethics of Accounting Accounting ethics; Professional conduct; Confidentiality, transparency, integrity Week 3 Principles of Double Entry (Part 1) Meaning of double entry; Debit and credit principles Week 4 Principles of Double Entry (Part 2) Application of double entry in accounts Week 5 Midterm Examination – Week 6 Accounting Concepts (Part 1) Meaning of accounting concepts; Going concern, accrual, materiality Week 7 Midterm Break – Week 8 Accounting Concepts (Part 2) Consistency, dual aspect, prudence Week 9 General Journal Meaning, features, and uses; Simple journal entries Week 10 Analytical Cash Book Meaning, format, and preparation of analytical cash book Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Financial Accounting","term":"Second Term","text":"Week 1 Bank Reconciliation Statement (Part 1) Concept, causes of differences between cash book and bank statement Week 2 Bank Reconciliation Statement (Part 2) Procedure and preparation of bank reconciliation Week 3 Classification of Accounts Personal, real, and nominal accounts; Rules of debit and credit Week 4 Trial Balance (Part 1) Meaning and structure of trial balance Week 5 Midterm Examination – Week 6 Correction of Errors (Part 2) Types of errors: errors of omission, commission, principle, compensating, etc.; Treatment Week 7 Midterm Break – Week 8 Trading Account Meaning, format, and preparation Week 9 Profit and Loss Account Meaning, format, and preparation Week 10 Adjustments in Profit and Loss Account Closing stock, prepayments, accruals, depreciation, provisions Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Financial Accounting","term":"Third Term","text":"Week 1 Balance Sheet (Part 1) Meaning and structure of balance sheet Week 2 Balance Sheet (Part 2) Preparation and classification into assets and liabilities Week 3 Sales Ledger Control Account Meaning, preparation of total debtors control account Week 4 Purchases Ledger Control Account Meaning, preparation of total creditors control account Week 5 Midterm Examination – Week 6 Depreciation Meaning, causes, and methods of providing for depreciation Week 7 Midterm Break – Week 8 Depreciation (Reducing Balance Method) Reducing balance / written down value method explained and applied Week 9 Manufacturing Account Meaning, format, and preparation of manufacturing account Week 10 – – Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Commerce","term":"First Term","text":"Week 1 Introduction: Meaning of Commerce Definition, scope, and importance of commerce Week 2 History of Commerce Origin and development of commerce locally and globally Week 3 Meaning of Occupation Types of occupation: industrial, commercial, services Week 4 Production, Division of Labour, Specialization and Exchange I Meaning of production, forms of production, concept of division of labour, specialization Week 5 Midterm Examination – Week 6 Production, Division of Labour, Specialization and Exchange II Advantages and disadvantages of division of labour and specialization; role of exchange Week 7 Midterm Break – Week 8 Trade Meaning, types, and importance of trade Week 9 Home Trade Meaning, features, advantages, limitations Week 10 Foreign Trade Meaning, features, merits and demerits of foreign trade Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Commerce","term":"Second Term","text":"Week 1 Commodity Exchange I Meaning, functions, and examples of commodity exchange Week 2 Commodity Exchange II Advantages, disadvantages, and importance of commodity exchange Week 3 Sole Proprietorship Features, advantages, disadvantages, and sources of capital Week 4 Partnership I Definition, features, types of partners Week 5 Midterm Examination – Week 6 Partnership II Advantages, disadvantages, partnership deed Week 7 Midterm Break – Week 8 Money Meaning, evolution, functions, qualities, and importance Week 9 Career Opportunities Careers in commerce, qualifications, and prospects Week 10 Cooperative Society Meaning, types, advantages, and limitations Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Commerce","term":"Third Term","text":"Week 1 Public Enterprises Meaning, types, features, advantages and disadvantages Week 2 Limited Companies I Definition, features of private and public limited companies Week 3 Limited Companies II Advantages, disadvantages, procedures for formation Week 4 Trade Association I Definition, roles, and examples of trade associations Week 5 Midterm Examination – Week 6 Trade Association II Advantages, disadvantages, contributions to commerce Week 7 Midterm Break – Week 8 Transportation I Meaning, types of transportation, importance Week 9 Transportation II Advantages, disadvantages, role in commerce Week 10 Communication Meaning, forms, importance, role in business Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Marketing","term":"First Term","text":"Week 1 Introduction to Marketing I Meaning, nature, and scope of marketing Week 2 Introduction to Marketing II Importance of marketing in business and society Week 3 Marketing Concepts Production, product, selling, marketing, and societal concepts Week 4 Classification of Products I Consumer goods and industrial goods Week 5 Midterm Examination – Week 6 Classification of Products II Durable and non-durable goods, services Week 7 Midterm Break – Week 8 Marketing Mix 4Ps: product, price, place, promotion Week 9 Marketing Environment Internal and external environment of marketing Week 10 What Do Markets Do Functions and roles of markets Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Marketing","term":"Second Term","text":"Week 1 Consumer Behaviour Meaning, factors influencing consumer behaviour Week 2 Organizational Buying Behaviour Meaning, features, and differences from consumer behaviour Week 3 Marketing Plan Meaning, components, importance Week 4 Advertising I Meaning, types, importance of advertising Week 5 Midterm Examination – Week 6 Advertising II Media of advertising, advantages and disadvantages Week 7 Midterm Break – Week 8 Pricing Strategies and Determinants Pricing objectives, strategies, and factors influencing pricing Week 9 Promotion Meaning, types, and tools of promotion Week 10 Merchandising Meaning, importance, and techniques Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Marketing","term":"Third Term","text":"Week 1 Advertising II Media of advertising, advantages and disadvantages Week 2 Pricing Strategies and Determinants Pricing objectives, strategies, and determinants Week 3 Promotion I Meaning, tools, and importance Week 4 Promotion II Methods of sales promotion, advantages and disadvantages Week 5 Midterm Examination – Week 6 Merchandising I Meaning, importance, and techniques Week 7 Midterm Break – Week 8 Merchandising II Methods of merchandising and applications Week 9 Merchandising III Modern trends in merchandising Week 10 Distribution Meaning, channels, and importance Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Economics","term":"First Term","text":"Week 1 Meaning of Economics and Related Concepts Definition of economics; Basic concepts (scarcity, choice, scale of preference, opportunity cost) Week 2 Basic Tools of Economic Analysis Tables, graphs, charts, simple equations Week 3 Concept of Demand and Supply Law of demand, demand schedule/curve; Law of supply, supply schedule/curve Week 4 Theory of Production Meaning; Types of production; Factors of production Week 5 Midterm Examination – Week 6 Basic Economic Problems of Society What to produce, how to produce, for whom to produce Week 7 Midterm Break – Week 8 Firms and Industry Meaning of firms and industry; Types of industry Week 9 Population Meaning; Types; Importance and problems of population Week 10 Labour Market Meaning; Demand and supply of labour; Wage determination Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Economics","term":"Second Term","text":"Week 1 The Nature of the Nigerian Economy Features, structure, and sectors of the Nigerian economy Week 2 Agriculture Meaning; Types of agriculture; Importance and problems Week 3 Mining Meaning; Methods of mining; Contributions to the economy Week 4 Meaning of Financial Institutions Types: formal and informal; Roles in the economy Week 5 Midterm Examination – Week 6 Money: Meaning, Characteristics, and Functions Evolution of money; Features; Functions of money Week 7 Midterm Break – Week 8 Channels of Distribution Meaning; Middlemen; Importance and limitations Week 9 Instruments of Business Finance Shares, debentures, loans, bonds Week 10 Tools of Economic Analysis Revision of graphs, charts, tables, equations Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Economics","term":"Third Term","text":"Week 1 Cost Concepts Meaning; Types of costs: fixed, variable, total, marginal, average Week 2 Revenue Concepts Meaning; Types of revenue: total, average, marginal Week 3 Types and Features of Economic Systems Capitalism, socialism, mixed economy, communalism Week 4 Labour Market Supply and demand of labour; Wage determination Week 5 Midterm Examination – Week 6 Elementary Treatment of Utility Theory Meaning; Types of utility; Law of diminishing marginal utility Week 7 Midterm Break – Week 8 Price Determination Interaction of demand and supply; Equilibrium price Week 9 Market Structures Perfect competition, monopoly, monopolistic, oligopoly Week 10 Industries in Nigeria Types: primary, secondary, tertiary; Importance; Problems Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Solar Photovoltaic Installation & Maintenance","term":"First Term","text":"Week 1 Introduction to Renewable Energy Meaning, sources (solar, wind, hydro, biomass), importance of solar energy in Nigeria Week 2 Basics of Solar Energy Solar radiation, photovoltaic effect, advantages & limitations Week 3 Solar Energy Terminologies Irradiance, insolation, efficiency, peak sun hours Week 4 Types of Solar Energy Systems Off-grid, on-grid, hybrid systems – differences, applications Week 5 Midterm Test Week 6 Components of PV Systems I Solar panels: types (monocrystalline, polycrystalline, thin- film), ratings Week 7 Midterm Break Week 8 Components of PV Systems II Charge controllers: types, functions Week 9 Components of PV Systems III Batteries: types (lead-acid, lithium-ion), sizing, care Week 10 Components of PV Systems IV Inverters: types (pure sine, modified sine), ratings 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Solar Photovoltaic Installation & Maintenance","term":"Second Term","text":"Week 1 Basic Electrical Concepts Current, voltage, resistance, power (Ohm’s law) Week 2 Tools & Instruments in PV Installation Multimeter, clamp meter, solar tester, hand tools Week 3 Solar Panel Connections I Series connection, voltage effects Week 4 Solar Panel Connections II Parallel connection, current effects Week 5 Midterm Test Week 6 Solar Panel Mounting Structures Types, orientations, tilt angle, site assessment Week 7 Midterm Break Week 8 Wiring & Cabling DC & AC cabling, cable sizing, safety Week 9 Earthing & Protection Surge protectors, grounding systems, circuit breakers Week 10 Practical: Small Solar Setup Assembling a 12V DC lighting system 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Solar Photovoltaic Installation & Maintenance","term":"Third Term","text":"Week 1 PV System Design Principles Load assessment, energy demand calculation Week 2 Sizing Solar Panels Calculating energy requirement vs solar panel output Week 3 Sizing Batteries Daily load, depth of discharge, battery autonomy Week 4 Sizing Charge Controllers & Inverters Ratings, efficiency considerations Week 5 Midterm Test Week 6 Practical PV System Design Case study: household system Week 7 Midterm Break Week 8 PV System Installation Steps I Mounting panels, installing balance of system Week 9 PV System Installation Steps II Electrical wiring, inverter & battery connection Week 10 System Testing & Commissioning Voltage/current tests, performance checks 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Fashion Design & Garment Making","term":"First Term","text":"Week 1 Introduction to Fashion & Garment Making Meaning, importance, career opportunities Week 2 History of Fashion Evolution of clothing, Nigerian traditional attire Week 3 Basic Sewing Tools & Equipment I Cutting tools, measuring tools, pressing tools Week 4 Basic Sewing Tools & Equipment II Sewing machine – parts, functions, maintenance Week 5 Midterm Test Week 6 Safety in the Sewing Workshop Rules, accident prevention, first aid Week 7 Midterm Break Week 8 Fibres & Fabrics I Natural & synthetic fibres, characteristics Week 9 Fibres & Fabrics II Fabric selection for different garments Week 10 Textile Care & Finishes Washing, bleaching, dyeing, printing 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Fashion Design & Garment Making","term":"Second Term","text":"Week 1 Basic Sewing Stitches I Temporary stitches (tacking, basting) Week 2 Basic Sewing Stitches II Permanent stitches (running, hemming, backstitch) Week 3 Machine Stitches Straight stitch, zigzag stitch, decorative stitches Week 4 Seams & Seam Finishes Types (plain, French, open, overlocked) Week 5 Midterm Test Week 6 Fullness Techniques I Darts, tucks, gathers Week 7 Midterm Break Week 8 Fullness Techniques II Pleats, smocking, shirring Week 9 Pressing Techniques Use of iron, pressing ham, pressing cloth Week 10 Practical: Sewing Simple Articles Handkerchief, apron, pillowcase 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Fashion Design & Garment Making","term":"Third Term","text":"Week 1 Body Measurements Taking accurate measurements Week 2 Pattern Drafting I Basic bodice, skirt, sleeve Week 3 Pattern Drafting II Simple dress patterns Week 4 Pattern Alteration Adjusting for size, figure variations Week 5 Midterm Test Week 6 Fabric Layout & Cutting Grain, nap, layout methods Week 7 Midterm Break Week 8 Garment Construction I Skirt (straight, gathered, flared) Week 9 Garment Construction II Blouse/shirt Week 10 Practical: Sewing a Simple Garment 11–13 Revision & Exams"},{"page":0,"class":"SSS1","subject":"Livestock Farming","term":"First Term","text":"Week 1 Introduction to Livestock Farming Meaning and importance of livestock farming; Scope (cattle, poultry, goats, sheep, pigs, rabbits, fish); Difference between subsistence and commercial livestock farming Week 2 History and Development of Livestock Farming in Nigeria Traditional livestock keeping; Modern methods; Government roles in livestock development Week 3 Classification of Livestock Ruminants and non-ruminants; Examples and characteristics Week 4 Livestock Housing Types of housing for poultry, goats, sheep, cattle, pigs; Principles of good housing Week 5 Midterm Test – Week 6 Animal Nutrition I Classes of feed: Energy, protein, minerals, vitamins, water; Examples of feed ingredients Week 7 Midterm Break – Week 8 Animal Nutrition II Balanced ration; Factors affecting feed formulation; Feed storage Week 9 Animal Breeding I Natural breeding; Artificial insemination; Selection methods Week 10 Animal Breeding II Crossbreeding, inbreeding, line breeding; Advantages and disadvantages Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Introduction to Poultry Farming Importance; Types of poultry (broilers, layers, cockerels, turkeys, ducks); Poultry house design Week 2 Poultry Management I Brooding, feeding, vaccination; Care of day-old chicks Week 3 Poultry Management II Growers and layers management; Egg production and handling Week 4 Poultry Diseases Common diseases (Newcastle, coccidiosis, fowl pox); Causes, symptoms, prevention and control Week 5 Midterm Test – Week 6 Poultry Business Cost analysis; Record keeping; Marketing of eggs and broilers Week 7 Midterm Break – Week 8 Goat and Sheep Farming I Breeds, housing, feeding practices Week 9 Goat and Sheep Farming II Breeding, diseases, management Week 10 Goat and Sheep Business Economics of goat/sheep farming; Value chain products (meat, milk, hides) Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Cattle Farming I Breeds of cattle (local and exotic); Housing; Feeding Week 2 Cattle Farming II Dairy vs beef cattle; Management practices Week 3 Cattle Breeding and Production Breeding methods; Milk production; Beef fattening Week 4 Cattle Diseases Major diseases (trypanosomiasis, foot and mouth, mastitis); Control measures Week 5 Midterm Test – Week 6 Pig Farming I Breeds, housing, feeding Week 7 Midterm Break – Week 8 Pig Farming II Breeding, disease control, management Week 9 Rabbit and Grasscutter Farming Importance; Housing; Feeding; Management Week 10 Business Opportunities in Livestock Meat processing, hides and skin, manure use; Value addition Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Introduction to Beauty and Cosmetology Meaning, scope and importance; Career opportunities in the beauty industry Week 2 History of Beauty and Cosmetology Traditional Nigerian beauty practices; Modern evolution; Global influence Week 3 Personal Hygiene and Grooming Cleanliness, neatness, dressing etiquette, skin and hair care Week 4 Tools and Equipment I Types, uses, care and storage of basic beauty tools Week 5 Midterm Test – Week 6 Tools and Equipment II Electrical appliances (hair dryer, straightener, sterilizer); Maintenance Week 7 Midterm Break – Week 8 Safety and First Aid in Beauty Practice Safety precautions; Handling sharp tools; Fire and electrical safety Week 9 Skin Care I Types of skin; Basic facial treatment; Cleansing, toning, moisturizing Week 10 Skin Care II Acne management; Exfoliation; Face masks (natural and synthetic) Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Hair Care I Types of hair; Hair structure; Importance of hair care Week 2 Hair Care II Shampooing and conditioning; Blow drying; Combing and detangling Week 3 Hair Treatments Natural hair care; Hot oil treatment; Deep conditioning Week 4 Hair Styling I Simple styles: braids, weaving, cornrows Week 5 Midterm Test – Week 6 Hair Styling II Use of rollers, straighteners, curling irons Week 7 Midterm Break – Week 8 Nail Care I Anatomy of nails; Tools for manicure and pedicure Week 9 Nail Care II Steps in manicure and pedicure; Nail art basics Week 10 Cosmetic Products I Types of cosmetics; Uses; Identifying safe vs harmful products Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Introduction to Makeup I Types of makeup (day, evening, bridal, stage) Week 2 Introduction to Makeup II Tools and products for makeup application Week 3 Makeup Application I Foundation, powder, contouring, concealer Week 4 Makeup Application II Eye makeup (eyeshadow, liner, lashes); Lip makeup Week 5 Midterm Test – Week 6 Corrective Makeup Makeup for different face shapes; Highlighting and shading Week 7 Midterm Break – Week 8 Traditional and Cultural Makeup Nigerian ethnic beauty styles; Festival makeup Week 9 Cosmetic Chemistry Basic ingredients in cosmetics; Natural vs synthetic products Week 10 Skin Disorders and Management Common conditions (eczema, rashes, acne); Referral to specialists Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Introduction to Computer Hardware and GSM Repairs Scope, importance, career opportunities Week 2 Classification of Computer Hardware Input, output, storage, processing units Week 3 Peripheral Devices Printers, scanners, projectors, functions, and maintenance Week 4 Internal Components of a Computer Motherboard, CPU, RAM, power supply Week 5 Midterm Examination – Week 6 Safety Rules and Workshop Practices Electrostatic discharge precautions, safe handling Week 7 Midterm Break – Week 8 Tools for Computer and GSM Repairs Screwdrivers, spudgers, multimeter, soldering tools Week 9 Computer Assembly I Installing RAM, HDD, power supply Week 10 Computer Assembly II BIOS setup, OS installation basics Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 Introduction to GSM Technology Evolution of mobile phones, GSM architecture Week 2 GSM Hardware Components Screen, keypad, battery, SIM slot, charging port Week 3 GSM Software Components Firmware, IMEI, OS in smartphones Week 4 GSM Repair Tools Soldering station, hot air gun, flashing tools Week 5 Midterm Examination – Week 6 Disassembly and Reassembly of GSM Phones Step-by-step process Week 7 Midterm Break – Week 8 Common GSM Faults I Charging faults, battery faults, power issues Week 9 Common GSM Faults II Network issues, microphone/speaker problems Week 10 GSM Software Issues Flashing, unlocking, virus removal Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Maintenance of Computer Hardware Cleaning, cooling, upgrading components Week 2 Power Supply Systems UPS, stabilizers, inverters Week 3 Introduction to Networking Hardware Modems, routers, switches Week 4 GSM Communication Principles Frequency, signal transmission, SIM technology Week 5 Midterm Examination – Week 6 GSM Connectivity Issues No service, SIM errors, network configuration Week 7 Midterm Break – Week 8 Computer and GSM Accessories Identification, functions, replacement Week 9 Preventive Maintenance Practices Routine checks, record keeping Week 10 Entrepreneurship in ICT Setting up a small repair business Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Introduction to Horticulture Meaning, scope, importance in Nigeria Week 2 Branches of Horticulture Olericulture, floriculture, pomology, landscaping Week 3 Crop Classification Food, cash, ornamental, medicinal crops Week 4 Tools and Equipment Identification, uses, care and maintenance Week 5 Midterm Examination – Week 6 Soil in Horticulture Types, properties, soil management Week 7 Midterm Break – Week 8 Nursery Practices Seed selection, germination, transplanting Week 9 Crop Propagation Methods Sexual and asexual propagation Week 10 Irrigation and Watering Techniques Methods: drip, sprinkler, surface irrigation Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Fertilizer and Manure Application Organic and inorganic, methods of application Week 2 Weed and Pest Control Types, effects, cultural and chemical methods Week 3 Crop Diseases Identification, prevention and control Week 4 Environmental Factors Light, temperature, rainfall, wind, humidity Week 5 Midterm Examination – Week 6 Farm Records in Horticulture Types, uses, importance Week 7 Midterm Break – Week 8 Harvesting of Horticultural Crops Tools, stages, methods Week 9 Post-Harvest Handling Sorting, grading, packaging, storage Week 10 Marketing of Horticultural Products Channels, pricing, challenges Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS1","subject":"Horticulture And Crop Production","term":"Third Term","text":"Week 1 Introduction to Crop Production Definition, importance in Nigeria Week 2 Classification of Crops by Life Cycle Annual, biennial, perennial Week 3 Crop Ecology Climatic and soil requirements of major crops Week 4 Land Preparation Clearing, ploughing, harrowing, ridging Week 5 Midterm Examination – Week 6 Planting Operations Spacing, depth, timing Week 7 Midterm Break – Week 8 Maintenance of Crops Thinning, mulching, pruning, staking Week 9 Crop Protection Integrated pest management (IPM) Week 10 Harvesting of Field Crops Time, method, tools Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"English Language","term":"First Term","text":"Week 1 Grammar, Oral, Summary, Vocabulary Grammar: Nominalization of adjectives and verbs – meaning, process, conversion into nouns. Oral: Consonant sounds – voiced and voiceless, contrast and correct production. Summary: Meaning, features, do’s and don’ts, practice with a passage. Vocabulary: Words of the week – bombastic, dearth, hiatus, implacable, stingy, dour, ebullient, ignominious, impinge, tome. Week 2 Oral, Vocabulary/Comprehension, Writing, Vocabulary Oral: Consonant clusters (two, three, four, five consonants). Vocabulary/Comprehension: Words related to human body systems and functions; gap-fill comprehension. Writing: Expository essay – Controlling HIV/AIDS in Nigeria or Managing Population Explosion. Vocabulary: Words of the week – partisan, repose, vivacious, surmise, malediction, stoic, tangential, mores. Week 3 Structure, Oral, Vocabulary/Comprehension, Vocabulary Structure: Nouns and noun phrases – types, functions, distinction from noun clauses. Oral: Transcription of monosyllabic, disyllabic and polysyllabic words with stress marking. Vocabulary/Comprehension: Words related to health (diagnosis, contagious, counselling, etc.); gap-fill comprehension passage. Vocabulary: Words of the week – paradigm, obtuse, sublime, paragon, reciprocate, solvent, frugal, surrogate, vilify, exonerate. Week 4 Structure, Summary, Vocabulary/Comprehension, Vocabulary Structure: Pronouns – personal, possessive, demonstrative, interrogative, reflexive, relative, reciprocal, indefinite. Summary: Reading to summarize – steps, rules, application. Vocabulary/Comprehension: Words associated with building and construction. Vocabulary: Words of the week – parsimony, virtuoso, revoke, surreptitious, expurgate, vacuous, manifest, incendiary, remiss, querulous. Week 5 Mid-Term Examination Mid-term assessment covering weeks 1–4. Week 6 Oral, Comprehension/Listening, Writing, Vocabulary Oral: Word stress (2–6 syllable words). Comprehension/Listening: Listening skills; answering questions on a passage. Writing: Argumentative essay – Should female circumcision be abolished? OR Military rule is better than civilian rule. Vocabulary: Words of the week –"},{"page":0,"class":"SSS2","subject":"English Language","term":"Second Term","text":"Week 1 Revision of Last Term’s Work & Welcome Test Oral: Consonant sounds. Structure: Use of possessive apostrophe – rules, examples, contractions. Comprehension: Reading to grasp main points; identifying topic sentences. Vocabulary: Words of the week – morass, abject, blandish, duplicity, ennui, maudlin, abscond, alias, dither, emaciated. Week 2 Structure, Vocabulary, Comprehension Structure: Punctuation marks – question mark, exclamation mark, colon, semi-colon, hyphen. Vocabulary Development: Words associated with press and journalism. Comprehension (Listening): Poetry for pleasure – tone, purpose, figurative expressions. Vocabulary: Words of the week – enmity, inept, laudatory, pinnacle, divine, flabbergasted, extant, laconic, pertinacious, enervate. Week 3 Oral, Structure, Writing, Vocabulary Oral: Intonation – expressing surprise/disbelief. Structure: Sentence types – declarative, imperative, interrogative. Writing: Formal letter – letter of complaint. Vocabulary: Words of the week – cherish, capricious, eschew, perusal, renunciation, rhapsodize, spurious, tenable, catalogue, turgid, antediluvian. Week 4 Oral, Comprehension, Writing, Vocabulary Oral: Falling tone (statements). Comprehension (Listening): Reading for implied meaning. Writing: Informal letter – letter to a friend in another town. Vocabulary: Words of the week – monumental, moot, luxuriant, intrude, succinct, wheedle, brochure, herbivore, spasmodic, medley. Week 5 Mid-Term Examination Mid-term assessment covering weeks 1–4. Week 6 Oral, Structure, Comprehension, Vocabulary Oral: Rhyme scheme – identification and application. Structure: Pronouns – personal, relative. Comprehension (Listening): Summarized speech/lectures and note-making. Vocabulary: Words of the week – abduct, abrogate, dirge, dilatory, embellish, entail, novice, nefarious, orthodox, palliate. Week 7 Mid-Term Break Mid-term holiday (no academic work). Week 8 Oral, Vocabulary, Writing, Vocabulary Oral: Rising tone – politeness, tentativeness. Vocabulary Development: Words associated with environment. Writing: Creative writing – short story, play or poem. Vocabulary: Words of the week – paucity, ostracism, acclaim, acerbic, bereft, nomadic, beguile, munificence, palliate, phlegmatic. Week 9 Oral, Structure, Comprehension, Vocabulary Oral: Consonant contrasts – /p/ and /b/, /t/ and /d/, /s/ and /z/. Structure: Sequence of tenses – rules, usage. Comprehension: Reading for critical evaluation. Vocabulary: Words of the week – propriety, preclusive, canvas, exigent, requisition, carouse, forestall, tranquil, heterogeneous, unctuous. Week 10 Structure, Vocabulary, Writing, Vocabulary Structure: Phrasal verbs – verbs with more than one particle (look up to, put up with, etc.). Vocabulary Development: Words associated with building and construction. Writing: Articles – features, differences from letters. Vocabulary: Words of the week – culvert, ideograph, mychotophobia, closely, grunge, unsightly, wishy-washy, asylum, consensus, hospice."},{"page":0,"class":"SSS2","subject":"English Language","term":"Third Term","text":"Week 1 Welcome Test A. Grammar: Revise Tenses B. Words for the Week - Recall types of tenses - Explain tenses with examples - Differentiate each tense from another - Learn new words (acronym, troupe, socialism, ardour, professionalism, behemoth, calumny, compliment, indigent, dissemble) Week 2 A. Grammar: Sentences (Conditional Clauses – likely, unlikely, impossible; Complex Sentences) B. Writing: Speech Writing for Special Purposes (Welcome Address, Farewell Address, Prize-giving Day Address) C. Vocabulary Development: Words associated with publishing and printing D. Words for the Week - Use conditional clauses in sentences - Identify and construct complex sentences - Explain features of speeches - Distinguish between a speech and an article - Write speeches for specific purposes - List and explain words associated with publishing/printing - Learn new words (balik, complicit, impecunious, encumber, mollify, frivolous, confection, disrepute, benevolent, generous) Week 3 A. Grammar: Affixation (Prefixes as word extensions) B. Writing: Summary (Summarizing a talk/lecture) C. Vocabulary Development: Words associated with industries D. Words for the Week - Explain affixation and root words - Form new words using prefixes - Identify subject matter and main ideas in lectures - Summarize talks/lectures - Explain “industries” and related terms - Learn new words (arcane, battery, plenitude, interject, laconic, primeval, quandary, tranquil, rail, vacillate) Week 4 A. Grammar: Verb Forms (Active and Passive) B. Oral: Spelling (Use of dictionary, spelling) C. Writing: Article Writing (Article for publication) D. Words for the Week - Differentiate active and passive voice - Change sentences between active and passive - Use dictionary for spelling, pronunciation, meaning, idiomatic uses, and origins - Identify features of an article - Write an article for publication - Learn new words (arboreal, camaraderie, exalt, gaudy, mawkish, diffident, forum, idolatrous, ornate, paradigm) Week 5 Midterm Examination - Week 6 A. Oral: Stress Placement on Two-syllable Words B. Comprehension: Reading to paraphrase poems and dramatic works C. Grammar: Rules of Concord D. Words for the Week - Define stress and apply stress placement rules - Read, understand, and paraphrase poems/dramas - Identify themes and features in poems/dramas - Explain rules of concord and use them in sentences - Learn new words (incendiary, winsome, rapport, sovereign, vitriolic, quaint, pathology, acrylic, gourmet, abhor) Week 7 Midterm Break - Week 8 A. Oral: Vowel Sounds (/i/ vs /i:/, /u/ vs /u:/, /æ/ vs /a:/) B. Structure: Adjuncts, Conjuncts, Disjuncts C. Comprehension: Reading for structural patterns (sentence - Produce and distinguish vowel sounds - Explain adjuncts, conjuncts, disjuncts with examples - Identify sentence types in passages - Write expository essay on family love,"},{"page":0,"class":"SSS2","subject":"Mathematics","term":"First Term","text":"Week 1 Revision of Previous Work Review of key concepts from SS1; solving diagnostic test questions. Week 2 Numbers and Approximation Numbers greater and less than 1; standard form of numbers; significant figures; solving problems on approximation; percentage error and its applications. Week 3 Use of Logarithm Tables and Calculators Evaluation of numbers using logarithm tables; solving problems on multiplication, division, powers, roots, and approximations. Week 4 Sequences and Series Meaning and types of sequences; arithmetic progression (AP); common difference; formula for nth term; sum of first n terms; applications in problem solving. Week 5 Midterm Examination — Week 6 Quadratic Equations I Construction of quadratic tables from sums and products of roots; solving quadratic equations by completing the square and by formula; applications of quadratic equations in daily life. Week 7 Midterm Break — Week 8 Quadratic Equations II Formation of quadratic equations from given conditions; sum and product of roots; verification of roots. Week 9 Simultaneous Equations Solving simultaneous equations in two variables by elimination and substitution methods; application to word problems. Week 10 Graphical Solutions Drawing graphs of quadratic and linear equations; solution of simultaneous equations by graphical method; interpretation of results. Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS2","subject":"Mathematics","term":"Second Term","text":"Week 1 Straight Line Graphs Equation of a straight line; determination of x- and y-intercepts; gradient of a straight line; drawing tangent to a curve at a point. Week 2 Circle Geometry I Tangent properties; perpendicularity of tangent and radius; angle in a semicircle; angles in alternate segments. Week 3 Circle Geometry II Chord properties; angle at the centre and angle at the circumference; cyclic quadrilaterals; properties of equal chords. Week 4 Circle Geometry III Angles in the same segment; angle in a semicircle; exterior angle properties; solving related problems. Week 5 Midterm Examination — Week 6 Trigonometry I Sine rule and cosine rule; application to triangles; problem solving with sine and cosine rules. Week 7 Midterm Break — Week 8 Trigonometry II Pythagoras’ theorem; applications to real-life problems; solving 2D problems involving angles of elevation and depression. Week 9 Fractions Operations with fractions; solving equations involving fractions; application of fractions to daily life problems. Week 10 Further Application of Trigonometry Problems involving bearings; chord and arc properties; solving problems on distances and directions. Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS2","subject":"Mathematics","term":"Third Term","text":"Week 1 Introduction to Linear Programming Meaning of linear programming; formulation of problems; real- life applications. Week 2 Linear Programming Graphical Solutions Graphical representation of inequalities; feasible region; solving optimization problems. Week 3 Bearings Definition and types of bearings; 4-point and 3-digit bearings; solving bearing problems (e.g., N75°E, S350°W); applications in navigation. Week 4 Angles of Elevation and Depression Meaning; construction of angles of elevation and depression; solving real-life problems involving angles of elevation and depression. Week 5 Midterm Examination — Week 6 Frequency Distribution Meaning of frequency; construction of frequency tables; cumulative frequency. Week 7 Midterm Break — Week 8 Graphical Representation of Frequency Ogive (cumulative frequency curve); estimating median, quartiles, and percentiles from ogive; real-life applications. Week 9 Measures from Frequency Median from grouped data; comparison with mean and mode. Week 10 Probability Meaning of probability; sample space; mutually exclusive, independent, and complementary events; solving probability problems. Week 11 Revision — Week 12 Examination —"},{"page":0,"class":"SSS2","subject":"Citizenship And Heritage Studies","term":"First Term","text":"Week 1 Nigerian Constitution Origin, structure, features Week 2 Fundamental Objectives & Directive Principles Political, economic, social, educational objectives Week 3 Separation of Powers Executive, legislature, judiciary; checks & balances Week 4 Public Service & Citizenship Role of civil service, duties, challenges Week 5 Midterm Test Week 6 Nigerian Heritage Sites UNESCO sites, national museums, parks Week 7 Midterm Break Week 8 Traditional Institutions Roles of chiefs, kings, emirs, obas, obis Week 9 Colonial Heritage Positive & negative impacts; lessons Week 10 Preservation of Historical Records Archives, museums, libraries 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Citizenship And Heritage Studies","term":"Second Term","text":"Week 1 Governance & Citizenship Meaning, principles, systems of governance Week 2 Federalism in Nigeria Features, challenges, importance Week 3 Human Rights Violations Causes, effects, remedies Week 4 Civil Society & NGOs Roles in democracy, advocacy, service Week 5 Midterm Test Week 6 Security & Citizenship Roles of police, army, civil defense; citizens’ roles in security Week 7 Midterm Break Week 8 Nigerian Foreign Policy Principles, objectives, achievements Week 9 Citizenship in a Digital Age Cyber rights, cybercrime, digital responsibility Week 10 Case Studies Role models in Nigerian citizenship & heritage 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Citizenship And Heritage Studies","term":"Third Term","text":"Week 1 Democratic Institutions in Nigeria INEC, political parties, judiciary Week 2 Elections & Citizenship Importance, processes, duties of voters Week 3 Electoral Malpractices Forms, effects, solutions Week 4 Media & Citizenship Role of press, social media, freedom of expression Week 5 Midterm Test Week 6 Nigerian Cultural Heritage in Global Context Nollywood, music, literature Week 7 Midterm Break Week 8 Civic Challenges Drug abuse, cultism, examination malpractice Week 9 National Development Role of active citizenship Week 10 Environmental Citizenship Climate change, waste management, sustainable living 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Digital Technologies","term":"First Term","text":"Week 1 Review of SS1 Work Quick revision of digital foundations Week 2 Advanced Word Processing Mail merge, macros, templates Week 3 Advanced Spreadsheet I Pivot tables, advanced formulas Week 4 Advanced Spreadsheet II Financial models, scenario analysis Week 5 Midterm Test Week 6 Advanced Presentation Tools Multimedia integration, professional designs Week 7 Midterm Break Week 8 Web Design I Introduction to HTML, CSS Week 9 Web Design II Creating simple websites Week 10 Web Publishing & Hosting Domains, hosting, publishing process 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Digital Technologies","term":"Second Term","text":"Week 1 Computer Programming I Introduction to algorithms, flowcharts Week 2 Computer Programming II Introduction to Python/JavaScript Week 3 Programming Basics Variables, data types, operators Week 4 Control Structures If-else, loops, functions Week 5 Midterm Test Week 6 Data Science Basics Data collection, storage, cleaning Week 7 Midterm Break Week 8 Big Data & Analytics Meaning, applications, tools Week 9 Artificial Intelligence Applications in education, health, business Week 10 Machine Learning Basics Concept, simple applications 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Mobile Application Development I Introduction to mobile apps Week 2 Mobile Application Development II Creating simple Android/iOS apps Week 3 Cloud Computing II SaaS, PaaS, IaaS Week 4 Blockchain Technology Concept, cryptocurrency, uses beyond finance Week 5 Midterm Test Week 6 Cybersecurity III Ethical hacking, penetration testing Week 7 Midterm Break Week 8 Cyber Laws & Digital Rights Nigerian cybercrime act, global cyber laws Week 9 Digital Entrepreneurship E-commerce, freelancing, online business Week 10 Project Work Students develop mini ICT projects 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Biology","term":"First Term","text":"Week 1 Digestive System I Organs of the alimentary canal; associated glands; mechanical and chemical digestion. Week 2 Digestive System II Enzymes of digestion; absorption of digested food; assimilation and egestion. Week 3 Transportation System I Transport in unicellular and multicellular organisms; differences between diffusion, osmosis and active transport. Week 4 Transportation System II Circulatory system in mammals; structure and functions of the heart, blood vessels and blood components. Week 5 Midterm Examination – Week 6 Respiratory System I Meaning of respiration; structure of the respiratory system in man; breathing mechanism. Week 7 Midterm Break – Week 8 Respiratory System II Types of respiration (aerobic and anaerobic); comparison; importance and energy yield. Week 9 Excretory System Excretory organs in man; structure and functions of the kidney; excretory products; disorders of the excretory system. Week 10 Nutrient Cycling in Nature Cycles of carbon, nitrogen and water; importance of nutrient cycling to living organisms. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Biology","term":"Second Term","text":"Week 1 Ecological Management Meaning of ecology; concepts of association, tolerance and adaptation; examples in plants and animals. Week 2 Pollution Meaning and types (air, water, soil, noise); causes, effects and control of pollution. Week 3 Conservation of Natural Resources Meaning of conservation; methods; importance of conserving soil, water, forests and wildlife. Week 4 Pests and Diseases of Crops Types of crop pests and diseases; effects on crop production; preventive and control measures. Week 5 Midterm Examination – Week 6 Reproductive Systems in Vertebrates Structures and functions of reproductive systems in fish, amphibians, reptiles, birds and mammals. Week 7 Midterm Break – Week 8 Reproductive Systems in Plants Floral parts and their functions; types of flowers; comparison of monocot and dicot flowers. Week 9 Pollination in Plants Self- and cross-pollination; agents of pollination; advantages and disadvantages. Week 10 Regulation of Internal Environment Homeostasis in humans; regulation of temperature, water and salt balance; role of the skin, kidney and hormones. Week 11 Revision Review of second term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Biology","term":"Third Term","text":"Week 1 Nervous Coordination Organization of the nervous system; structure and functions of neurones; transmission of impulses. Week 2 Sense Organs Structure and functions of the eye, ear, nose, tongue and skin; common defects and corrections. Week 3 Ecology of Population Definition; population characteristics (size, density, birth rate, death rate, age distribution); population growth curve. Week 4 Balance in Nature Concept of ecological balance; food chains, food webs and energy flow in ecosystems. Week 5 Midterm Examination – Week 6 Reproductive System and Reproduction in Humans Structures and functions of male and female reproductive systems; fertilization; development of embryo. Week 7 Midterm Break – Week 8 Development of New Seeds Fertilization in plants; development of seeds; structure and functions of seed parts. Week 9 Fruits Types of fruits (simple, aggregate, multiple); features of wind- and animal-dispersed fruits. Week 10 Reproductive Behaviours Courtship behaviour in animals; parental care; importance of reproductive behaviour to species continuity. Week 11 Revision Review of third term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Chemistry","term":"First Term","text":"Week 1 Environmental Chemistry Water pollution, air pollution, sources, effects, and control measures. Week 2 Electrolysis Electrolytes, electrodes, principles, applications of electrolysis, Faraday’s laws. Week 3 Electrochemical Cells Galvanic and electrolytic cells, construction, working principles, applications. Week 4 Acid-Base Titration Apparatus, procedures, acid-base indicators, titration calculations. Week 5 Midterm Examination Revision and assessment of weeks 1–4. Week 6 Solubility and Solubility Curves Definition, factors affecting solubility, solubility calculations, interpretation of solubility curves. Week 7 Midterm Break — Week 8 Chemical Equilibrium Concept of dynamic equilibrium, equilibrium constant (Kc), simple calculations. Week 9 Chemical Kinetics Meaning of reaction rate, factors affecting rates, rate laws, order of reaction. Week 10 Heat of Reaction Enthalpy change, calorimetry, Hess’s law applications. Week 11 Energetics of Reactions Activation energy, energy profile diagrams, exothermic and endothermic reactions. Week 12 Examination Term assessment. Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Chemistry","term":"Second Term","text":"Week 1 Saponification and Detergents Chemistry of soap making, properties, differences between soap and detergent, uses. Week 2 Introduction to Nuclear Chemistry Radioactivity, half-life, nuclear reactions, applications and dangers. Week 3 Halogens General properties, trends, compounds, and uses of fluorine, chlorine, bromine, iodine. Week 4 Alkali and Alkaline Earth Metals Characteristics, occurrence, reactivity, and uses. Week 5 Midterm Examination Revision and assessment of weeks 1–4. Week 6 Transition Elements General properties, variable oxidation states, complex compounds, industrial importance. Week 7 Midterm Break — Week 8 General Properties of Metals Reactivity series, extraction and refining, metallic bonding. Week 9 Non-Metals and Their Compounds Hydrogen, oxygen, nitrogen and their compounds. Week 10 Water Hardness of water, purification methods, water quality control. Week 11 Environmental Pollution Causes, effects, and control of land, air, and water pollution. Week 12 Examination Term assessment. Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Chemistry","term":"Third Term","text":"Week 1 Sulphur and Its Compounds Occurrence, preparation, properties, uses of sulphur, sulphur dioxide, and sulphuric acid. Week 2 Carbon and Its Compounds Properties, oxides, carbonates, hydrocarbons, importance. Week 3 Industrial Preparation of Chemicals Large-scale production of HCl, NH₃, H₂SO₄, processes and applications. Week 4 Organic Chemistry (Revision) Functional groups, homologous series, IUPAC nomenclature. Week 5 Midterm Examination Revision and assessment of weeks 1–4. Week 6 Hydrocarbons Types, properties, reactions, tests for hydrocarbons. Week 7 Midterm Break — Week 8 Alcohols, Ethers, and Phenols Structures, uses, reactions, industrial applications. Week 9 Aldehydes and Ketones Preparation, identification, uses and reactions. Week 10 Carboxylic Acids and Esters Structure, reactions, uses, esterification. Week 11 Polymers and Plastics Types, polymerization, uses, dangers of plastics. Week 12 Examination Term assessment. Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Physics","term":"First Term","text":"Week 1 Light Waves I Nature of light; rectilinear propagation; reflection of light; laws of reflection; applications. Week 2 Light Waves II Refraction of light; laws of refraction; refractive index; total internal reflection and applications (prisms, optical fibers). Week 3 Sound Waves Production and propagation of sound; characteristics of sound (pitch, loudness, quality); speed of sound in different media. Week 4 Human Eye Structure and functions of the eye; image formation in the eye; defects of the eye and their corrections (short sight, long sight, astigmatism). Week 5 Midterm Examination – Week 6 Application of Sound Waves Uses of sound in medicine (ultrasound), industry (SONAR, echolocation); musical instruments. Week 7 Midterm Break – Week 8 Electric Charges Concept of charge; types of charges; methods of charging (friction, conduction, induction); properties of charges. Week 9 Description and Properties of Fields Concept of a field; electric, magnetic, and gravitational fields; field lines and properties. Week 10 Gravitational Field Newton’s law of universal gravitation; gravitational field strength; differences between mass and weight; motion under gravity. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Physics","term":"Second Term","text":"Week 1 Electric Field Concept of electric field; field patterns; Coulomb’s law; potential difference; capacitors. Week 2 Magnetic Fields Properties of magnets; magnetic field patterns; magnetic flux; earth’s magnetic field and its uses. Week 3 Electro-Magnetic Field Relationship between electricity and magnetism; electromagnetic induction; Faraday’s and Lenz’s laws; applications (transformers, generators). Week 4 Simple A.C. Circuits Characteristics of alternating current; comparison of A.C. and D.C.; peak and rms values; resistors, capacitors, and inductors in A.C. circuits. Week 5 Midterm Examination – Week 6 Battery Types of cells and batteries (primary, secondary); construction, working, and applications; care and maintenance. Week 7 Midterm Break – Week 8 Solar Collector Meaning and importance of solar energy; principles of solar collector; applications and advantages in energy supply. Week 9 Revision Review of second term’s work. Week 10 Examination – Week 11 Closing –"},{"page":0,"class":"SSS2","subject":"Physics","term":"Third Term","text":"Week 1 Electrical Continuity Testing Concept of electrical continuity; testing with continuity tester and multimeter; importance in troubleshooting circuits. Week 2 Electroplating Principles of electrolysis; process of electroplating; industrial and domestic applications. Week 3 Application of Electromagnetic Field Uses in communication, medicine (MRI, X-ray), industry (induction furnaces, motors). Week 4 Models of the Atom Historical development: Dalton, Thomson, Rutherford, Bohr; modern atomic theory. Week 5 Midterm Examination – Week 6 Nucleus Structure of the nucleus; atomic number, mass number, isotopes; nuclear reactions (fission, fusion); radioactivity. Week 7 Midterm Break – Week 8 Energy Quantization Planck’s hypothesis; photons; energy levels in atoms; applications (lasers, photoelectric effect). Week 9 Duality of Matter Wave-particle duality; de Broglie hypothesis; experimental evidences. Week 10 Energy and Society Sources of energy (renewable, non-renewable); energy crisis; environmental effects of energy use; sustainable energy strategies. Week 11 Revision Review of third term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Agricultural Science","term":"First Term","text":"Week 1 Farm Surveying and Planning Meaning of farm surveying; importance; instruments used; methods of land measurement; uses of surveying data in agriculture. Week 2 Farm Planning Definition of farm planning; objectives; factors influencing farm planning; steps in farm planning; importance to agricultural production. Week 3 Principles of Farmstead Planning and Location of Buildings/Structures Meaning of farmstead planning; factors affecting location (topography, soil type, water supply, nearness to market, accessibility); layout of farm structures (barn, silo, poultry house, fish pond, etc.). Week 4 Forest Management Meaning; importance of forest to agriculture and economy; methods of forest management (afforestation, controlled exploitation, taungya system, forest reservation). Week 5 Agro-Forestry Practices in Nigeria Definition of agroforestry; examples (alley cropping, shelter belts, windbreaks); benefits to soil fertility, erosion control, and biodiversity. Week 6 Importance of Ornamental Plants Economic, aesthetic, medicinal, and environmental importance of ornamental plants. Week 7 Common Types of Ornamental Plants Flowering plants, foliage plants, shrubs, lawn grasses, trees, climbers; examples of each. Week 8 Settings and Locations for Planting Each Type of Ornamental Plant Home gardens, parks, schools, offices, roadsides; factors to consider when locating ornamental plants. Week 9 Methods of Cultivating Ornamental Plants Direct seeding, transplanting, grafting, layering, budding, use of cuttings; care and management. Week 10 Revision Review of first term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Agricultural Science","term":"Second Term","text":"Week 1 Maintenance of Ornamental Plants Weeding, watering, pruning, staking, mulching, manuring, pest and disease control in ornamental plants. Week 2 Diseases of Crops Meaning of crop diseases; types (fungal, bacterial, viral, nematode); symptoms; effects; control measures. Week 3 Pests of Crops Definition of crop pests; examples (insects, birds, rodents, monkeys); economic importance; preventive and control measures. Week 4 Weeds and Weed Control Meaning and types of weeds; characteristics; harmful and beneficial effects; methods of weed control (cultural, mechanical, chemical, biological). Week 5 Types and Classification of Farm Animals Cattle, sheep, goats, pigs, poultry, rabbits, fish; classification based on uses (meat, milk, work, eggs, hides/skins). Week 6 Anatomy and Physiology of Farm Animals External parts; digestive, circulatory, respiratory, and reproductive systems of cattle, poultry, and pigs. Week 7 Animal Reproduction Meaning and importance; types (asexual and sexual); reproductive processes in farm animals; fertilization and gestation. Week 8 Environmental Physiology in Farm Animals Effects of climate (temperature, rainfall, humidity, wind) on growth, production, and reproduction of farm animals; adaptation strategies. Week 9 Livestock Management Meaning; principles; management practices for cattle, sheep, goats, pigs, poultry, and rabbits; housing, feeding, breeding, health care. Week 10 Revision Review of second term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Agricultural Science","term":"Third Term","text":"Week 1 Animal Nutrition Classes of food nutrients (carbohydrates, proteins, fats, vitamins, minerals, water); functions; sources; importance in animal production. Week 2 Rangeland Management Meaning of rangeland; types; importance; methods of improvement (reseeding, rotational grazing, controlled stocking, fertilizer application). Week 3 Basic Economic Principles Definition; scarcity, choice, and opportunity cost; scale of preference; production possibilities curve. Week 4 Factors of Production Land, labour, capital, and entrepreneurship; meaning, characteristics, and roles in agriculture. Week 5 Midterm Examination – Week 6 Principles of Demand Meaning; law of demand; demand schedule and curve; factors affecting demand; elasticity of demand in agriculture. Week 7 Midterm Break – Week 8 Principles of Supply Meaning; law of supply; supply schedule and curve; factors affecting supply; elasticity of supply in agriculture. Week 9 Implications of Demand and Supply for Agricultural Production Application of demand and supply to pricing, output, and farmers’ decisions in agriculture. Week 10 Functions of a Farm Manager Roles, qualities, and responsibilities of a farm manager; importance to agricultural productivity. Week 11 Revision Review of third term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Further Mathematics","term":"First Term","text":"Week 1 Solution to Quadratic Equation Methods of solving quadratic equations: factorization, completing the square, quadratic formula; word problems. Week 2 Tangent and Normal to Curve Meaning; derivation of tangent and normal equations; applications in coordinate geometry. Week 3 Polynomials I Definition; degree of polynomials; addition, subtraction, multiplication; long division. Week 4 Polynomials II Factor and remainder theorem; applications in simplifying algebraic expressions. Week 5 Midterm Examination — Week 6 Polynomials II (Cont.) Application of factor and remainder theorem; solving higher order equations. Week 7 Midterm Break — Week 8 Cubic Equations and their Factorization Factorization of cubic expressions; methods of solution. Week 9 Logical Reasoning I Statements; truth table; negation, conjunction, disjunction. Week 10 Logical Reasoning II Conditional and biconditional statements; tautology and contradiction. Week 11 Trigonometric Function Definition; values of trigonometric ratios; angle of elevation and depression. Week 12 Graphs of Trigonometric Function Sine, cosine, and tangent graphs; properties and transformations. Week 13 Trigonometric Identity & Graphs of Inverse Trigonometric Ratios; Pythagoras Theorem Basic identities; inverse trigonometric graphs; applications of Pythagoras theorem."},{"page":0,"class":"SSS2","subject":"Further Mathematics","term":"Second Term","text":"Week 1 Limits of Functions and Differentiation from First Principle Concept of limits; evaluation; differentiation using first principle. Week 2 Rules of Differentiation I Differentiation of algebraic functions using power rule, constant rule, and sum/difference rule. Week 3 Rules of Differentiation II Product rule, quotient rule, chain rule. Week 4 Differentiation of Trigonometric, Logarithmic, and Exponential Functions Standard derivatives; application to problems. Week 5 Midterm Examination — Week 6 Application of Differentiation Rate of change; velocity and acceleration; equation of motion. Week 7 Midterm Break — Week 8 Maximum and Minimum Points and Values Turning points of curves; second derivative test; applications. Week 9 The Circle Definition; general equation of a circle; equation of tangent; length of tangent. Week 10 Conic Sections I Parabola, ellipse, hyperbola: definitions and equations. Week 11 Conic Sections II Properties and graphs of conic sections; applications. Week 12 Conic Sections III Continuation of parabola, ellipse, and hyperbola. Week 13 Sample Space and Events Event space; independent and dependent events; probability."},{"page":0,"class":"SSS2","subject":"Further Mathematics","term":"Third Term","text":"Week 1 Sample Space and Events (Cont.) Further problems on event space; probability of compound events. Week 2 Permutation and Combination I Meaning; arrangement of objects; fundamental counting principle. Week 3 Permutation and Combination II Combination of objects; applications in probability. Week 4 Dynamics I Newton’s laws of motion; motion along inclined plane. Week 5 Midterm Examination — Week 6 Dynamics II Motion of connected particles; applications of Newton’s laws. Week 7 Midterm Break — Week 8 Work, Power, Energy Work done by a force; power; energy; impulse and momentum. Week 9 Projectiles Motion of projectiles; equations and applications. Week 10 Binomial Expansion Binomial theorem; expansion of (a + b)^n; applications. Week 11 Mechanics (Vector Geometry) Vector operations; scalar and vector products; applications in mechanics. Week 12 Integration I Indefinite integral; basic rules; applications. Week 13 Integration II and Applications Definite integrals; area under a curve; regression line and correlation coefficient."},{"page":0,"class":"SSS2","subject":"Food And Nutrition","term":"First Term","text":"Week 1 Meat Cookery Meaning and types of meat; structure of meat; nutritive value of meat; factors affecting choice of meat; methods of cooking meat and meat dishes Week 2 Poultry Meaning and types of poultry; structure; preparation; nutritive value; factors affecting choice; methods of cooking poultry dishes Week 3 Eggs Meaning, uses and nutritive value of eggs; structure of egg; test for freshness; methods of cooking eggs and egg dishes Week 4 Milk and Milk Products Meaning, types and nutritive value of milk; methods of preserving milk; examples of milk dishes Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Sea Foods Meaning and classification of sea foods; nutritive value; factors to consider when choosing sea foods; methods of cooking fishes Week 7 Midterm Break — Week 8 Food Additives Meaning, types (flavouring, herbs, spices etc.); classification (local and foreign); uses and presentation on album/cardboard Week 9 Practical on Meat, Poultry, Milk, Sea Foods, and Food Additives Preparation and serving of dishes; use of additives in meals Week 10 Starchy Roots and Plantain Meaning; types of starchy roots; nutritive value; types and value of plantain; dishes made from plantain Week 11 Revision General review of all topics Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Food And Nutrition","term":"Second Term","text":"Week 1 Energy Management in Food Preparation Meaning, advantages, principles of energy management; steps in managing energy; meaning of fatigue Week 2 Kitchen Equipment and Utensils Meaning, classification, selection, use, care and storage of large and small kitchen equipment, fixtures and appliances Week 3 Labour Saving Devices Meaning, uses, factors to consider in selection; care and maintenance Week 4 Special Nutritional Needs I Infants, children, adolescents, adults, aged, pregnant and lactating mothers: meal planning and physiological needs Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Special Nutritional Needs II Continuation of meal planning for different groups and physiological needs Week 7 Midterm Break — Week 8 Project on Test Interpretation Practice in interpreting exam questions and writing responses Week 9 Flour Cookery Meaning and types of flour; local flour sources; nutritive value; dishes from flour (bread, pastries etc.) Week 10 Raising Agents Meaning; types (yeast, baking powder etc.); composition and evaluation Week 11 Revision General review of all topics Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Food And Nutrition","term":"Third Term","text":"Week 1 Convenience Foods Meaning, uses, forms, examples; selection factors; advantages and disadvantages; dishes made with convenience foods Week 2 Preservation of Foods Meaning of spoilage; causes and agents; importance of preservation; principles of preservation Week 3 Methods of Food Preservation Various preservation methods (drying, smoking, salting, freezing, canning etc.) Week 4 Food Storage Meaning and importance; storage of perishable and non- perishable foods; storage equipment and spaces (barns, refrigerator, deep freezers) Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Practical on Convenience Foods and Food Storage Preparation of dishes using convenience foods; practical demonstration of preservation methods Week 7 Midterm Break — Week 8 Budgeting Meaning of budgeting; income, expenditure; family needs; food budgeting; factors influencing budgeting Week 9 Food Purchasing Meaning of bulk-purchasing, piece-meal, impulse buying; factors to consider; advantages and disadvantages; shopping list preparation Week 10 Consumer Education I & II Meaning and principles; consumer agents; government agencies (NAFDAC, SON, FCCPC); duties of consumer agents; consumer practices (adulteration, falsification, misbranding) Week 11 Revision General review of all topics Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Geography","term":"First Term","text":"Week 1 Industry Meaning and types of industries (primary, secondary, tertiary, quaternary); importance of industries in economic development. Week 2 Basic Concepts of GIS Meaning of GIS (Geographic Information System); importance and uses of GIS in geography and planning. Week 3 Components of GIS Hardware, software, data, people, and methods; functions of each component. Week 4 Earth’s External Processes and Landform Development Weathering, erosion, transportation and deposition; resulting landforms (valleys, deltas, beaches, dunes, floodplains). Week 5 Midterm Examination – Week 6 Climate II Elements of climate; climatic controls; differences between weather and climate. Week 7 Midterm Break – Week 8 Climatic Classification Koppen’s classification of climate; other approaches to classifying climate; world climatic regions. Week 9 Environmental Resources Meaning and types (renewable and non-renewable); importance and sustainable use of environmental resources. Week 10 Revision Review of first term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Geography","term":"Second Term","text":"Week 1 Renewable and Non- Renewable Resources Meaning and examples; differences; significance in Nigeria’s economy. Week 2 Environmental Problems Pollution (air, water, land, noise); deforestation; desertification; soil erosion; overpopulation. Week 3 Environmental Conservation Meaning; methods (afforestation, reforestation, legislation, recycling, controlled grazing); importance of conservation. Week 4 Agriculture Types (subsistence, commercial, mixed farming); importance of agriculture; problems and solutions in Nigeria. Week 5 Midterm Examination – Week 6 Transport and Communication in Nigeria Types of transport (road, rail, water, air, pipeline); importance and challenges; types of communication; role in economic development. Week 7 Midterm Break – Week 8 Manufacturing Industries in Nigeria Types and examples; factors influencing location; contributions to GDP; problems of industries in Nigeria. Week 9 Commercial Activities in Nigeria Meaning and types of commercial activities; role of trade, banking, insurance, and tourism in Nigeria’s economy. Week 10 Revision Review of second term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Geography","term":"Third Term","text":"Week 1 Direction and Bearing Meaning of direction and bearing; use of compass and bearings in navigation and map reading. Week 2 Representation of Relief Forms Methods of showing relief on maps (contours, hachures, spot heights, shading, layer colouring); interpretation of relief features. Week 3 Population Meaning; factors influencing population distribution; population structure, density and growth; problems of overpopulation and underpopulation. Week 4 Settlements Meaning and types (rural and urban); functions of settlements; factors affecting location of settlements. Week 5 Midterm Examination – Week 6 Settlement Interactions Rural-urban migration; effects of rural-urban interactions on development; problems and solutions. Week 7 Midterm Break – Week 8 Geo-political Issues Meaning; examples in Nigeria and Africa (boundary disputes, ethnic conflicts, political instability); effects on development. Week 9 GIS Data Types of GIS data (spatial, attribute); sources of GIS data; uses in planning and development. Week 10 Earth’s Internal Processes Meaning; processes such as vulcanicity, earthquakes, folding and faulting; landforms associated with each. Week 11 Revision Review of third term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Technical Drawing","term":"First Term","text":"Week 1 Revision of SS1 Work General review of previous year’s work Week 2 Geometrical Construction Identification of different types of geometrical construction; Construction of geometrical figures using appropriate instruments Week 3 Geometrical Construction (Continued) Construction of triangles, quadrilaterals, and polygons; Bisection of lines and angles Week 4 Geometrical Construction (Continued) Division of lines into equal parts; Construction of tangents to circles Week 5 Midterm Examination – Week 6 Simple Scale Drawing – Plain and Diagonal Scales Explanation of plain and diagonal scales; Construction of scales to given representative fractions Week 7 Midterm Break – Week 8 Pictorial Drawings – Oblique Projection Definition of oblique projection; Construction of oblique drawings using given dimensions Week 9 Pictorial Drawings – Isometric Projection Definition of isometric projection; Construction of isometric drawings using given dimensions Week 10 Freehand Sketching Sketching objects in freehand with correct proportion Week 11 Freehand Sketching (Continued) Sketching more complex objects in freehand showing details Week 12 Examination End of term examination Week 13 Closing End of term activities and vacation"},{"page":0,"class":"SSS2","subject":"Technical Drawing","term":"Second Term","text":"Week 1 Revision of First Term’s Work General review of First Term’s work Week 2 Orthographic Projection Definition of orthographic projection; Differences between first angle and third angle projection; Drawing objects in both methods Week 3 Orthographic Projection (Continued) Construction of orthographic views of given objects Week 4 Sectional Views Definition of sectional views; Types of sectional views; Drawing sectional views of simple objects Week 5 Midterm Examination – Week 6 Sectional Views (Continued) Drawing more complex sectional views involving different shapes Week 7 Midterm Break – Week 8 Auxiliary Views Definition of auxiliary views; Drawing auxiliary views of given objects Week 9 Assembly Drawing Definition of assembly drawing; Identification of machine components; Drawing exploded and assembled views Week 10 Assembly Drawing (Continued) Assembling given parts into complete objects in orthographic projection Week 11 Fasteners Identification of types of fasteners (nuts, bolts, screws, rivets); Conventional representations Week 12 Examination End of term examination Week 13 Closing End of term activities and vacation"},{"page":0,"class":"SSS2","subject":"Technical Drawing","term":"Third Term","text":"Week 1 Interpenetration and Development of Solids Definition of interpenetration; Practical applications; Construction of interpenetration of two solids Week 2 Interpenetration and Development of Solids (Continued) Development of surfaces of interpenetrating solids Week 3 Building Drawings Explanation of building drawings; Reading simple floor plans Week 4 Building Drawings (Continued) Drawing floor plans and elevations of simple buildings Week 5 Midterm Examination – Week 6 Pictorial Drawing of Buildings Drawing pictorial views of simple buildings from given plans Week 7 Midterm Break – Week 8 Pictorial Drawing of Buildings (Continued) Drawing more complex pictorial views of buildings Week 9 Freehand Sketching Sketching building components and fittings accurately Week 10 Freehand Sketching (Continued) Sketching more complex building components Week 11 Specification Writing Definition of specification writing; Writing simple specifications for construction works Week 12 Examination End of term examination Week 13 Closing End of term activities and vacation"},{"page":0,"class":"SSS2","subject":"Nigerian History","term":"First Term","text":"Week 1 The Sokoto Caliphate Origin and rise of the Caliphate; causes and effects of the 1804 Jihad; leadership of Usman dan Fodio Week 2 The Administration of the Caliphate Political and religious organization; emirate system; taxation; justice and governance Week 3 The Impact of the Jihad Political, religious, social, and educational transformations in Northern Nigeria Week 4 Bornu under the Shehus: The Emergence of El-Kanemi The decline of the Sefawa dynasty; rise of El-Kanemi; his reforms and leadership Week 5 Midterm Examination — Week 6 Developments under El-Kanemi and the Shehus Reorganization of Bornu administration; resistance to the Sokoto Caliphate; restoration of stability Week 7 Midterm Break — Week 8 Yoruba Land in the 19th Century: Oyo Empire Growth, structure, and decline of the Oyo Empire; internal conflicts and external pressures Week 9 The Era of Ibadan Imperialism Rise of Ibadan as a power; wars of expansion; military and political control Week 10 The Peace Treaty of 1886 and its Aftermath Terms of the treaty; end of wars; emergence of peace and new political structures Week 11 Revision Review of all topics on Sokoto, Bornu, and Yoruba history Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Nigerian History","term":"Second Term","text":"Week 1 Benin in the 19th Century Structure and political organization; trade and diplomacy; British relations Week 2 The First Phase of British Conquest (1851–1900) British intervention in Lagos; treaties, conquest of Benin; establishment of protectorates Week 3 The Second Phase of British Conquest (1900–1914) Expansion of colonial rule to the North; use of indirect rule; consolidation of British authority Week 4 Early Phase of British Rule (1900– 1914) Administration, policies, taxation, and native authorities Week 5 Midterm Examination — Week 6 The Amalgamation of Nigeria (1914) and its Significance Reasons for amalgamation; Lord Lugard’s policy; advantages and disadvantages Week 7 Midterm Break — Week 8 Colonial Rule and Its Impact Central administration; economic exploitation; introduction of Western education and Christianity Week 9 The Colonial Economy Cash crop production, taxation, infrastructure, and trade Week 10 Social Development and Inter- Group Relations Urbanization, missionary education, and national consciousness Week 11 Revision Review of British rule and colonial impact Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Nigerian History","term":"Third Term","text":"Week 1 Origins of Nationalism in Nigeria Causes of nationalism: colonial policies, education, press, and religion Week 2 Nationalist Movements after World War II Roles of political organizations – NCNC, NPC, AG, and others Week 3 The Road to Independence Constitutional developments: Clifford, Richards, Macpherson, and Lyttleton Constitutions Week 4 The Attainment of Independence (1960) Nationalist leaders; events leading to independence; challenges of self-government Week 5 Midterm Examination — Week 6 The First Republic (1960–1966) Political developments; party systems; major crises and regionalism Week 7 Midterm Break — Week 8 The First Republic: Social and Economic Developments Education, economy, and social welfare during the First Republic Week 9 Military Intervention and the 1966 Coup Causes, events, and consequences; Nigerian Civil War (1967–1970) Week 10 Post-Civil War Nigeria Reconstruction, rehabilitation, and reintegration; unity efforts Week 11 Revision Review of decolonization and post-independence developments Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS2","subject":"Government","term":"First Term","text":"Week 1 Colonial Administration in Nigeria: British, French, Indirect Rule Features of colonial administration; differences between British and French systems; principles and practice of indirect rule; successes and failures of indirect rule in Nigeria. Week 2 Nationalism in Nigeria: Causes, Effects, Key Personalities Meaning of nationalism; factors that led to its rise (education, media, religion, economy); roles of key nationalists (Herbert Macaulay, Nnamdi Azikiwe, Obafemi Awolowo, Ahmadu Bello, Tafawa Balewa, Anthony Enahoro, Ernest Ikoli); effects on Nigeria’s independence struggle. Week 3 Constitutional Development in Nigeria I Clifford Constitution (1922) – features, merits, demerits; Richards Constitution (1946) – features, merits, demerits; Macpherson Constitution (1951) – features, merits, demerits. Week 4 Constitutional Development in Nigeria II Lyttleton Constitution (1954) – federal structure and significance; Independence Constitution (1960); Republican Constitution (1963); comparative analysis of the constitutions. Week 5 Midterm Examination – Week 6 Military Rule in Nigeria: Causes, Achievements, Failures Reasons for military intervention; achievements (infrastructure, centralization, civil service reforms); failures (dictatorship, corruption, abuse of rights). Week 7 Midterm Break – Week 8 Civil Rule in Nigeria: Features, Merits, Challenges Meaning of civil rule; characteristics (constitutionality, rule of law, separation of powers); merits and challenges (corruption, instability, ethnicity). Week 9 Nigerian Federalism I: Features and Evolution Meaning of federalism; evolution of Nigerian federalism (from 1954 till date); main features of Nigerian federalism. Week 10 Nigerian Federalism II: Problems and Solutions Problems: resource control, revenue allocation, minority agitations, state creation; possible solutions for strengthening federalism. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Government","term":"Second Term","text":"Week 1 Revenue Allocation in Nigeria: Principles and Issues Meaning of revenue allocation; principles (derivation, need, equality of states, population, national interest); controversies and challenges in Nigeria’s revenue allocation. Week 2 Inter-Governmental Relations Meaning; types (federal–state, state–local, federal–local); importance and problems of inter-governmental relations. Week 3 Political Crisis in Nigeria I 1962 Census Crisis – causes, effects; 1963 Tiv Crisis – causes, effects. Week 4 Political Crisis in Nigeria II 1964 Election Crisis – causes, effects; 1965 Western Region Crisis – causes, effects; impact of crises on Nigerian politics. Week 5 Midterm Examination – Week 6 The Nigerian Civil War: Causes, Effects, Resolution Causes of the war (ethnic tension, coup, secession); major events; effects on Nigeria; resolution and reconciliation efforts (Gowon’s 3Rs: Reconstruction, Rehabilitation, Reconciliation). Week 7 Midterm Break – Week 8 Civil Society and Popular Participation Definition and role of civil society; examples (labour unions, NGOs, student movements, faith-based organizations); importance of popular participation in governance. Week 9 Citizenship Education and National Integration Meaning of citizenship; rights and duties of citizens; importance of national integration; challenges to unity in Nigeria. Week 10 Political Apathy: Causes, Effects, Solutions Meaning of political apathy; causes (ignorance, mistrust, corruption); effects (low voter turnout, weak democracy); solutions (civic education, transparency, accountability). Week 11 Revision Review of second term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Government","term":"Third Term","text":"Week 1 Electoral Systems: Types, Merits and Demerits Meaning; types (simple majority, proportional representation, second ballot, alternative vote); merits and demerits of each. Week 2 Electoral Commissions in Nigeria: Past and Present Historical overview of electoral commissions in Nigeria – NEC, FEDECO, INEC; roles, achievements, and challenges. Week 3 Electoral Malpractices: Types, Causes, Consequences Meaning; types (rigging, ballot stuffing, intimidation, falsification of results); causes; consequences on democracy. Week 4 Democratic Processes in Nigeria Meaning; democratic principles (rule of law, majority rule, protection of minority rights, regular elections); challenges to democratic processes in Nigeria. Week 5 Midterm Examination – Week 6 Judiciary: Structure, Functions, Independence Structure (hierarchy of courts); functions (interpretation of laws, protection of rights, settlement of disputes); independence of the judiciary and threats to independence. Week 7 Midterm Break – Week 8 Human Rights: Meaning, Categories, Protection, Limitations Meaning and types (civil, political, economic, social, cultural rights); protection of rights; limitations in practice; institutions for enforcement. Week 9 Public Corporations in Nigeria: Meaning, Types, Roles, Control Meaning and examples (NITEL, NNPC, Nigerian Railway Corporation); roles in national development; methods of control (ministerial control, legislative control, judicial control). Week 10 Revision Review of third term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Christian Religious Studies","term":"First Term","text":"Week 1 Leadership of Joseph, Moses, Joshua and Deborah I Early life and call of Joseph, Moses, Joshua, and Deborah; qualities of godly leadership. Week 2 Leadership of Joseph, Moses, Joshua and Deborah II Achievements, challenges and lessons from their leadership experiences. Week 3 Leadership of Joseph, Moses, Joshua and Deborah III Relevance of their leadership examples to contemporary Christian life. Week 4 God Cares for His People – Protection God’s protection of Israel in the wilderness; meaning of divine care and protection today. Week 5 Midterm Examination – Week 6 Parental Responsibility (Eli and His Sons) Duties of parents to children; Eli’s failure; consequences of neglect of parental responsibility. Week 7 Midterm Break – Week 8 Consequences of Obedience and Disobedience Biblical examples of obedience and disobedience; blessings and punishments. Week 9 Friendship David and Jonathan as a model of true friendship; Christian perspective on loyalty and sacrifice. Week 10 Trust in God (Submission to the Will of God) Biblical characters who trusted God (Abraham, Job, Jesus); importance of submission to God’s will. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Christian Religious Studies","term":"Second Term","text":"Week 1 Making Decisions as a Christian Factors influencing decision-making; biblical guidelines for making right decisions. Week 2 Greed and its Effect Meaning of greed; examples from the Bible (Achan, Gehazi, Judas); consequences of greed. Week 3 The Supremacy of God God’s power over nations, rulers, and creation; lessons for Christians. Week 4 Religious Reforms Biblical examples (Josiah, Nehemiah); importance of true worship and reform in Christian life. Week 5 Midterm Examination – Week 6 Concern for One’s Nation Nehemiah and patriotism; responsibilities of Christians toward their nation. Week 7 Midterm Break – Week 8 Faith in God Examples of men of faith (Hebrews 11); benefits of faith in Christian living. Week 9 True Religion and Social Justice Amos, Micah, and Isaiah on justice and righteousness; implications for Christians today. Week 10 The Baptism and Temptation of Jesus Christ The baptism of Jesus and its significance; temptation of Jesus and lessons for Christians. Week 11 Revision Review of second term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Christian Religious Studies","term":"Third Term","text":"Week 1 Call of the Disciples Jesus’ call of the twelve; reasons for their call; lessons for Christians. Week 2 The Mission of the Disciples (Luke 10:1-24) Jesus sending out the seventy; the disciples’ experiences and lessons. Week 3 The Trial of Jesus Christ and His Death The arrest, trial, crucifixion of Jesus; significance of His sacrifice. Week 4 Resurrection and Second Coming of Jesus Christ The resurrection and its implications; Christian hope in the second coming. Week 5 Midterm Examination – Week 6 Fellowship in the Early Church Characteristics of fellowship; sharing, love, and unity in the early church. Week 7 Midterm Break – Week 8 The Holy Spirit and the Mission of the Gentiles Coming of the Holy Spirit; role in spreading the gospel to the Gentiles. Week 9 Opposition to the Gospel Message I Causes of opposition; persecution in the early church (Stephen, Peter, Paul). Week 10 Opposition to the Gospel Message II Continuation of opposition; relevance of persecution to Christians today. Week 11 Revision Review of third term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Visual Arts","term":"First Term","text":"Week 1 Drawing Still life and nature drawings; keen observation of objects; types of drawings and their surface effects; shading techniques (cross- hatching, burning, line, pointillism, wash). Week 2 Painting Styles of painting (animal hide, mural, impasto, fresco tempera); still life objects (chair, plates, kettle); natural objects (insects, animals, bones, flowers); figure drawing (parts of the body, portrait, full life painting); colour mixing and application. Week 3 Nigerian Cultural Festivals Meaning and origin of festivals; types of festivals; functions of festivals; symbolic significance; body decorations; illustration of festival symbols. Week 4 History of Art (African Traditional Art and Culture) Traditional African art forms: Guinea, Kiss, Cameroon, Dahomey, Sierra Leone; origins and locations; media used in traditional arts; characteristics and influence on modern art. Week 5 Midterm Examination Assessment of first half of term’s work. Week 6 Graphic Design Definition and types; tools and materials; calligraphy practical; practical designs: book cover, book jacket, logo, calendar, poster, packaging. Week 7 Midterm Break - Week 8 Textile Design on Paper Use of creative forms; creation of motifs (shapes, figures, patterns); formation of repeating formats; application of colours on patterns. Week 9 Embroidery Identification of embroidery works; stitches illustrated on paper; transfer of stitches onto fabric; tools and materials (needle, thread, scissors, stitching machine); practical embroidery application. Week 10 Furniture Making Functions of furniture; processes involved in furniture making; sourcing appropriate wood; wood treatment before use; creation of furniture in various forms. Week 11 Puppetry Meaning and types; tools and materials; seams and stitches; puppet construction (marionette, storytelling, drama, shadow plays); Nigerian puppetry forms, styles, functions, and cultural significance. Week 12 Revision Review of all major topics: Drawing, Painting, Festivals, History of Art, Graphic and Textile Design, Embroidery, Furniture Making, Puppetry. Week 13 Examination and Closing End of term examinations and closing activities."},{"page":0,"class":"SSS2","subject":"Visual Arts","term":"Second Term","text":"Week 1 Imaginative Composition I Meaning of imaginative composition; components (foreground, middle ground, background, area of interest, compositional arrangement of objects); practical application in drawing and painting. Week 2 Imaginative Composition II Drawing objects from imagination (pot, spoon, chair, stove, house, etc.); sketching and painting scenes from memory (motor accident, market scene, carpenter’s workshop, etc.); application of colour and shading techniques. Week 3 Nature Painting Meaning and characteristics of nature painting; natural objects (plants, animals, shells, skulls, mountains, etc.); arrangement and components of nature painting; techniques of colour application (impasto, fresco, etc.); practical painting exercises. Week 4 Modern and Traditional Art Institutions in Nigeria Modern art institutions: Obafemi Awolowo University, Ahmadu Bello University, Adeyemi College of Education, Olabisi Onabanjo University; traditional art institutions: Oshogbo Art Centre, Mbari Mbayo Art Centre, Nri Art Centre; courses, history, and contributions to Nigerian art. Week 5 Midterm Examination Assessment of first half of the term’s work. Week 6 Pottery Meaning of pottery; tools and materials; methods of pottery making; functions of pottery; basic terminologies; differences between pottery and ceramics; marketing pottery wares; practical modelling of pottery wares up to finishing stage. Week 7 Midterm Break - Week 8 Book Cover and Jacket Design Meaning of book cover and jacket; differences between book cover and jacket; features of book design (spine, blurb, flap, ISBN, author bio, book summary, publisher’s address, etc.); practical design of book covers and jackets in pencil and colour. Week 9 Construction Meaning and types of construction; processes involved; objects and materials used (hard board, beads, metal, rope, etc.); practical construction of simple art objects using appropriate media. Week 10 Computer in Visual Arts Meaning and types of computers; parts and functions; drives and printers; CorelDraw window and tools; application of digital tools in art; advantages and disadvantages of computer use in art and general education. Week 11 Revision General review of topics: imaginative composition, nature painting, art institutions, pottery, book design, construction, and computer art. Week 12 Examination End of term examinations. Week 13 Closing End of term activities."},{"page":0,"class":"SSS2","subject":"Visual Arts","term":"Third Term","text":"Week 1 Basic Shapes and Designs Meaning of basic shapes and design; types of basic and geometrical shapes (circle, square, triangle, rectangle, etc.); materials and tools for basic design; practical approach using pencil and colour; arrangement of basic and non-basic shapes in harmonious designs. Week 2 Indigenous Decorative Motifs Meaning of motifs; indigenous decorative motifs (floral, animal, objects, etc.); formats for motif making (half-drop, diamond, mirror, simple repeat); creation of patterns using indigenous motifs. Week 3 Calabash Decoration I Meaning and types of calabash; types of calabash decoration; uses and functions of decorated calabash; marketing and outlets for calabash products. Week 4 Calabash Decoration II Practical decoration of calabash using painting, engraving, scotching, beads, cowries, coins, and carving; influence of foreign cultures on calabash decoration; value and relevance of calabash decoration in art and society. Week 5 Midterm Examination Assessment of first half of the term’s work. Week 6 Indigenous Motifs (Body Decoration – Tattoos) Meaning of body decoration; origin and importance of tattoos in indigenous societies; tools and motifs used; types of tattoo designs (animation, zoomorphic, spiral, lines, etc.); cultural values of tattooing. Week 7 Midterm Break - Week 8 Indigenous Motifs (Mural Designs) Meaning of mural design; origin of mural motifs; examples of indigenous mural designs (Yoruba Sango wand, snakes, birds, geometric patterns, etc.); materials and tools for mural art; practical creation of mural motifs. Week 9 Indigenous Craft Making (Baskets and Mats) Meaning of basket and mat; places in Nigeria known for basket/mat weaving; materials and tools; products of basket and mat making; functions and uses; practical weaving of simple basket and mat. Week 10 Indigenous Craft (Cloth Weaving) & Modern Nigerian Art and Artists Cloth weaving: meaning, materials, tools, towns and states where weaving is prominent (e.g., Aso-Ofi, Kente); functions of woven cloths; principles of weaving (warp, weft, shuttle, loom). Modern Nigerian art: meaning and origin of contemporary Nigerian art; development of modern artistic expression; forms of modern art (sculpture, ceramics, textiles, graphics); notable Nigerian studio artists and educators (Aina Onabolu, Akinola Lasekan, Ben Enwonwu, Yusuf Grillo, Ladi Kwali, Kolade Oshinowo, Uche Okeke). Week 11 Revision General review of all topics: basic designs, indigenous motifs, calabash decoration, tattoos, mural designs, basket/mat weaving, cloth weaving, modern Nigerian artists. Week 12 Examination End of term examinations. Week 13 Closing End of term activities."},{"page":0,"class":"SSS2","subject":"Literature-In-English","term":"First Term","text":"Week 1 Introduction to African Poetry Study of Gabriel Okara – “Once Upon a Time”; themes, content analysis, and poetic devices. Week 2 African Poetry Study of Wole Soyinka – “Night”; themes, structure, and poetic devices. Week 3 African Poetry Study of Niyi Osundare – “Not My Business”; themes, style, tone, and poetic analysis. Week 4 African Poetry Study of Syl Cheney-Coker – “The Breast of the Sea”; themes, content analysis, imagery, and symbolism. Week 5 Midterm Examination Assessment of first half of the term’s work. Week 6 African Poetry Study of S.O.H. Afriyie-Vidza – “Hearty Garlands” and Elizabeth L. A. Kamara – “New Tongue”; themes, mood, tone, and poetic devices. Week 7 Midterm Break — Week 8 Non-African Poetry Study of Maya Angelou – “Still I Rise”; themes of perseverance and empowerment; poetic techniques. Week 9 Non-African Poetry Study of Lord Byron – “She Walks in Beauty”; themes, diction, mood, and imagery. Week 10 Non-African Poetry Study of Seamus Heaney – “Digging” and Fleur Adcock – “The Telephone Call”; structure, tone, and poetic analysis. Week 11 Revision General review of all poems studied (African and Non-African). Week 12 Examination End of term examinations. Week 13 Closing End of term activities."},{"page":0,"class":"SSS2","subject":"Literature-In-English","term":"Second Term","text":"Week 1 Welcome Test and Review Review of previous term’s work; introduction to prose elements and literary terms. Week 2 Introduction to African Prose Study of Elma Shaw – “Redemption Road”; plot structure, setting (physical, social, and temporal). Week 3 African Prose Detailed analysis of Redemption Road (Chapters 1–5); introduction of characters and major events. Week 4 African Prose Continued analysis (Chapters 6–10); themes and character development. Week 5 Midterm Examination Assessment of first half of the term’s work. Week 6 African Prose Continued study (Chapters 11–15); stylistic and structural analysis. Week 7 Midterm Break — Week 8 Non-African Prose Study of Susanne Bellefeuille – “Path of Lucas: The Journey He Endured”; background of the author and text overview. Week 9 Non-African Prose Detailed analysis (Chapters 1–6); major events and themes of perseverance, love, and endurance. Week 10 Non-African Prose Continued analysis; characterization, plot development, and narrative techniques. Week 11 Revision General review of African and Non-African prose texts. Week 12 Examination End of term examinations. Week 13 Closing End of term activities."},{"page":0,"class":"SSS2","subject":"Literature-In-English","term":"Third Term","text":"Week 1 Introduction to African Drama Overview of African Drama and cultural influences. Week 2 African Drama Study of Efua Sutherland – “The Marriage of Anansewa”; background, setting, and summary of Act One. Week 3 African Drama Detailed analysis of The Marriage of Anansewa (Acts Two–Three); themes, plot, and characterization. Week 4 African Drama Continued study of The Marriage of Anansewa; moral lessons, style, and dramatic techniques. Week 5 Midterm Examination Assessment of first half of the term’s work. Week 6 Non-African Drama Study of Robert Bolt – “A Man for All Seasons”; background of the playwright, setting, and Acts One–Two. Week 7 Midterm Break — Week 8 Non-African Drama Continued analysis of A Man for All Seasons; themes, characterization, and style. Week 9 Non-African Drama Study of J.D. Priestley – “An Inspector Calls”; background, plot summary, and character analysis. Week 10 Non-African Drama Themes and dramatic techniques in An Inspector Calls; moral and social significance. Week 11 Revision General review of all drama texts and poems. Week 12 Examination End of term examinations. Week 13 Closing End of term activities."},{"page":0,"class":"SSS2","subject":"Catering And Craft","term":"First Term","text":"Week 1 Welcome Test / Revision Review of last term’s work and recall of previous topics Week 2 Introduction to Bar Meaning of bar, types of bar, functions of bar, factors to consider when planning a bar Week 3 Bar Equipment and Functions Identification and uses of different bar equipment Week 4 Introduction to Beverages Meaning and types of beverages (alcoholic and non- alcoholic) Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Beverages in Relation to Still Room Meaning, functions, food items and equipment in a still room Week 7 Midterm Break — Week 8 The Service Area / Ancillary Service Area Description, rooms in ancillary service area Week 9 Dispense Bar Equipment and Arrangement Types of dispense bar equipment and arrangement Week 10 Demonstration on Preparation and Serving of Beverages Practical preparation and serving of different beverages Week 11 Revision General revision of the term’s work Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Catering And Craft","term":"Second Term","text":"Week 1 Welcome Test / Revision Review of last term’s work Week 2 Introduction to Kitchen Equipment Classification, uses, care and maintenance Week 3 Standing and Local Measuring Equipment Identification and use of local and standard measuring tools Week 4 Cleaning Agents Meaning, classification, importance, and local cleaning agents Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Methods of Cooking I Boiling (stocks, soups, sauces), preparation and demonstration Week 7 Midterm Break — Week 8 Methods of Cooking II Roasting, grilling, barbecue (with demonstration) Week 9 Methods of Cooking III Baking (cakes, pastries, biscuits, cookies, scones) Week 10 Cake Decoration Royal icing, fondant, butter icing Week 11 Revision General revision of the term’s work Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Catering And Craft","term":"Third Term","text":"Week 1 Welcome Test Review of last term’s work Week 2 Costume and Fashion Designing Meaning, style development, sketching and pattern making Week 3 Adaptation of Basic Block for Costume Design Drafting, construction, use of different style features Week 4 Decorative Design: Embroidery Work I Satin, stem, chain stitches; planning embroidery Week 5 Midterm Test Assessment of weeks 1–4 Week 6 Decorative Design: Embroidery Work II Types of embroidery work; transferring designs to fabrics Week 7 Midterm Break — Week 8 Decorative Design: Traditional Design & Needlecraft Beads, sequins, traditional designs, needlecraft and toy-making Week 9 Basic Concepts of Marketing Meaning, methods, importance, distribution channels Week 10 Marketing (Continued) Branding, packaging, costing, pricing, feasibility study, product packaging Week 11 Revision General revision of the term’s work Week 12 Examination End of term exams Week 13 Closing Vacation"},{"page":0,"class":"SSS2","subject":"Financial Accounting","term":"First Term","text":"Week 1 Profit and Loss Appropriation Account Meaning and purpose; differences between profit and loss account and profit and loss appropriation account; items appearing in the account (interest on drawings, interest on capital, partners’ salary, partners’ commission, share of profit/loss). Week 2 Partnership Capital Account Definition; features of capital accounts; distinction between fixed and fluctuating capital accounts; format and preparation. Week 3 Partnership Current Account Meaning; purpose; format of current account; items affecting current account (drawings, interest on drawings, partners’ salary, interest on capital, share of profit/loss). Week 4 Current Account in Partnership Accounting Relationship between capital and current accounts; preparation of current accounts under fixed capital method; worked examples. Week 5 Midterm Examination – Week 6 Admission of a New Partner and Goodwill Account Meaning of goodwill; types (purchased and inherent); methods of valuation; treatment of goodwill on admission of a new partner; revaluation of assets and liabilities. Week 7 Midterm Break – Week 8 Receipts and Payments Account / Income and Expenditure Account Meaning; features; differences between receipts and payments account and income and expenditure account; preparation of accounts. Week 9 Single Entry (Incomplete Records) Meaning; limitations; conversion of single entry to double entry; statement of affairs method; preparation of final accounts from incomplete records. Week 10 Revision Review of first term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Financial Accounting","term":"Second Term","text":"Week 1 Formation of a Company Meaning of a company; steps and procedures in formation (promotion, incorporation, flotation); documents required (memorandum of association, articles of association, prospectus, certificate of incorporation). Week 2 Private and Public Companies Meaning and differences; features of private and public companies; advantages and disadvantages of each. Week 3 Quoted and Unquoted Companies Definition; differences; examples of quoted companies in Nigeria; requirements for listing on the stock exchange. Week 4 Financial System Meaning; components (money market, capital market, insurance, banking system, pension funds); importance of the financial system to economic growth. Week 5 Midterm Examination – Week 6 Issue of Shares Meaning; types of shares (ordinary, preference, deferred); methods of issue (public offer, rights issue, bonus issue); accounting entries for share issue. Week 7 Midterm Break – Week 8 Loan Capital Meaning; types of loan capital (debentures, bonds, bank loans); advantages and disadvantages; accounting treatment of loan capital. Week 9 Revision Review of second term’s work. Week 10 Examination – Week 11 Closing –"},{"page":0,"class":"SSS2","subject":"Financial Accounting","term":"Third Term","text":"Week 1 Methods of Raising Funds from the Capital Market Public issue, rights issue, private placement, offer for sale, government bonds; advantages and disadvantages of each method. Week 2 Requirements for Accessing the Capital Markets Regulatory requirements; eligibility criteria for companies; role of Securities and Exchange Commission (SEC) and Nigerian Stock Exchange (NSE). Week 3 Benefits of Capital Market Importance to companies, investors, and the economy; mobilization of savings, liquidity, capital formation, and wealth creation. Week 4 Final Accounts Meaning; preparation of trading, profit and loss account and balance sheet; adjustments in final accounts (depreciation, prepayments, accruals, bad debts, provision for doubtful debts). Week 5 Midterm Examination – Week 6 Regulation of the Capital Market Role of regulatory agencies (SEC, NSE, CBN); laws and policies guiding the capital market; investor protection. Week 7 Midterm Break – Week 8 Hire Purchase and Installment Payment Account Meaning; differences between hire purchase and installment payment; accounting entries; preparation of relevant accounts. Week 9 Revision Review of third term’s work. Week 10 Examination – Week 11 Closing –"},{"page":0,"class":"SSS2","subject":"Commerce","term":"First Term","text":"Week 1 Advertising I Meaning and importance of advertising; types of advertising (informative, persuasive, competitive). Week 2 Advertising II Media of advertising (print, electronic, outdoor); advantages and disadvantages of each medium. Week 3 Tourism in Nigeria Meaning and importance of tourism; tourist centers in Nigeria; role of tourism in economic development. Week 4 Insurance Meaning and principles of insurance; types of insurance (life, marine, fire, accident); importance to business and individuals. Week 5 Midterm Examination – Week 6 Banking I Meaning and types of banks; roles of commercial banks in business transactions. Week 7 Midterm Break – Week 8 Banking II Central Bank of Nigeria: roles, functions, and control of commercial banks. Week 9 Banking III Development banks, merchant banks, microfinance banks; their contributions to economic growth. Week 10 Warehousing Meaning and importance of warehousing; types of warehouses; functions in commerce. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Commerce","term":"Second Term","text":"Week 1 Capital Meaning and types of capital (fixed, working, liquid, loan); importance of capital to business. Week 2 Credit Meaning and importance of credit; types of credit (trade, bank, hire purchase); advantages and disadvantages. Week 3 Profit Meaning and types of profit; importance of profit to business; factors affecting profit. Week 4 Turnover Meaning and calculation of turnover; importance in business operations. Week 5 Midterm Examination – Week 6 Business Law Meaning and importance; contracts in business; rights and obligations of parties. Week 7 Midterm Break – Week 8 Structure of Business Types of business organizations (sole proprietorship, partnership, companies, cooperatives). Week 9 Introduction to Business Management I Meaning and importance; functions of management – planning and organizing. Week 10 Introduction to Business Management II Functions of management – directing, coordinating, controlling. Week 11 Revision Review of second term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Commerce","term":"Third Term","text":"Week 1 Introduction to Marketing Meaning and importance of marketing; difference between marketing and selling. Week 2 Consumer Protection I Meaning and importance of consumer protection; rights of consumers. Week 3 Consumer Protection II Agencies for consumer protection in Nigeria; challenges of consumer protection. Week 4 Meaning of Payment I Meaning and importance; traditional methods of payment (cash, cheque, bank draft). Week 5 Midterm Examination – Week 6 Meaning of Payment II Modern methods of payment (ATM, POS, electronic transfer, mobile banking). Week 7 Midterm Break – Week 8 Deregulation, Nationalization, Indigenisation I Meaning and features of deregulation, nationalization, and indigenisation. Week 9 Deregulation, Nationalization, Indigenisation II Advantages, disadvantages, and effects on the Nigerian economy. Week 10 Revision Review of third term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Marketing","term":"First Term","text":"Week 1 Transportation Meaning of transportation; types (land, water, air, pipeline); importance in marketing; problems and solutions. Week 2 Warehousing Meaning; types of warehouses (private, public, bonded, cooperative, state); functions and importance in marketing. Week 3 Structure and Market Unions for Sales of Goods Meaning and types of market structures; functions of market unions and associations in goods distribution. Week 4 Meaning and Roles of Facilitators Meaning; types of marketing facilitators (agents, brokers, wholesalers, retailers); their roles and importance. Week 5 Midterm Examination – Week 6 Marketing of Mineral Products Features of mineral products; channels of distribution; problems and prospects of marketing mineral products. Week 7 Midterm Break – Week 8 International Marketing Meaning and scope; importance of international marketing; challenges faced by Nigerian marketers. Week 9 Organizing for International Marketing Organizational structures; roles of government; methods of entry into international markets. Week 10 Application of ICT in International Marketing Meaning of ICT; roles of ICT in modern marketing; e- commerce, online advertising, digital platforms. Week 11 Revision Review of first term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Marketing","term":"Second Term","text":"Week 1 Planning for Personal Marketing Outlet Steps in establishing an outlet; location, capital, staffing, product selection; risks and management. Week 2 Purchasing, Supplying and Merchandising of Goods and Services Meaning of purchasing and supplying; methods of merchandising; importance of merchandising in marketing. Week 3 Marketing of Services Meaning; characteristics of services; types of services; problems and prospects of marketing services. Week 4 Consumer Behavior Meaning; factors affecting consumer behavior (cultural, social, psychological, economic); consumer decision- making process. Week 5 Midterm Examination – Week 6 Product Life Cycle Meaning; stages (introduction, growth, maturity, decline); strategies for each stage. Week 7 Midterm Break – Week 8 Branding and Packaging Meaning; types of branding; importance of branding and packaging; problems in branding. Week 9 Pricing Policies and Strategies Meaning; types of pricing policies (penetration, skimming, cost-plus, competitive); factors influencing pricing. Week 10 Channels of Distribution Meaning; types of distribution channels; advantages and disadvantages; role of intermediaries. Week 11 Revision Review of second term’s work. Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Marketing","term":"Third Term","text":"Week 1 Sales Promotion Meaning; methods (discounts, coupons, free samples, exhibitions); importance and limitations. Week 2 Advertising Meaning; types (print, broadcast, outdoor, online); importance and limitations of advertising. Week 3 Personal Selling Meaning; qualities of a good salesperson; importance; challenges of personal selling. Week 4 Public Relations in Marketing Meaning of public relations; functions in marketing; tools and strategies; importance. Week 5 Midterm Examination – Week 6 Consumer Protection Meaning; rights of consumers; agencies for consumer protection in Nigeria; problems and solutions. Week 7 Midterm Break – Week 8 Contemporary Issues in Marketing Digital marketing, social media marketing, e-commerce, globalization of marketing. Week 9 Careers in Marketing Different career paths in marketing; skills and qualifications needed; prospects. Week 10 Revision Review of third term’s work. Week 11 Examination – Week 12 Closing –"},{"page":0,"class":"SSS2","subject":"Economics","term":"First Term","text":"Week 1 Elementary Treatment of Fiscal Policy Meaning of fiscal policy; tools of fiscal policy (taxation, government expenditure); objectives and limitations. Week 2 Balanced and Unbalanced Budget Meaning and differences; effects on the economy; advantages and disadvantages of each. Week 3 Elements of National Income Accounting Meaning and concepts: GDP, GNP, NNP, NI, PI, DI; methods of measuring national income; uses and limitations of national income data. Week 4 Money: Demand for and Supply of Money Definition of money; demand for money (transactionary, precautionary, speculative motives); supply of money and determinants. Week 5 Midterm Examination – Week 6 Money: Inflation and Deflation Meaning, types, causes and effects of inflation and deflation; control measures. Week 7 Midterm Break – Week 8 Economic Lessons from Asian Tigers, Japan, Europe, and America Overview of economic growth in Asian Tigers; lessons Nigeria can learn from Japan, Europe, and America. Week 9 Human Capital Development Meaning, importance, problems and solutions to human capital development in Nigeria. 10. Petroleum and the Nigerian Economy History of petroleum in Nigeria; contributions to GDP; problems associated with dependence on oil; diversification strategies. 11. Revision Review of first term’s work. 12. Examination – 13. Closing –"},{"page":0,"class":"SSS2","subject":"Economics","term":"Second Term","text":"Week 1 Manufacturing and Construction Service Industries Meaning, features, importance and problems of manufacturing and construction industries in Nigeria. Week 2 Agencies that Regulate the Financial Markets Overview of financial markets; types of regulatory agencies. Week 3 Functions and Role of Regulatory Agencies (I) CBN, NDIC, SEC – functions, importance and challenges. Week 4 Functions and Role of Regulatory Agencies (II) NSE, Insurance Commission, Ministry of Finance – functions and roles. Week 5 Midterm Examination – Week 6 International Trade Meaning, types, importance and problems; theories of absolute and comparative advantage. Week 7 Midterm Break – Week 8 Economic Growth and Development Meaning and distinction between growth and development; indicators; problems and strategies for promoting growth. Week 9 Balance of Payments (BOP) Meaning, components, causes of disequilibrium, measures for correcting BOP problems. 10. Revision Review of term’s work. 11. Examination – 12. Closing –"},{"page":0,"class":"SSS2","subject":"Economics","term":"Third Term","text":"Week 1 Economic Development Planning Meaning and objectives of planning; types of plans; problems of planning in Nigeria. Week 2 International Economic Organization (I) IMF, World Bank – objectives, roles, benefits and criticisms. Week 3 International Economic Organization (II) ECOWAS, AU, WTO – aims, achievements and challenges. Week 4 Current Economic Plans: MDGs, NEEDS, Vision 2020 Meaning, objectives, achievements, challenges and evaluation of MDGs, NEEDS, and Vision 2020. Week 5 Midterm Examination – Week 6 Economic Development Challenges Corruption, unemployment, poverty, poor infrastructure; effects on Nigeria’s development. Week 7 Midterm Break – Week 8 Economic Reform Programs SAP, deregulation, privatization, commercialization – objectives, benefits and problems. Week 9 Past Question Drilling (I) Practice of WAEC/NECO past questions on SS2 topics. 10. Past Question Drilling (II) More past question practice and test drills. 11. Revision General review of the year’s work. 12. Examination – 13. Closing –"},{"page":0,"class":"SSS2","subject":"Solar Photovoltaic Installation & Maintenance","term":"First Term","text":"Week 1 Review of SS1 Work Quick recap of solar basics & components Week 2 Advanced PV System Design Hybrid systems, grid-tied calculations Week 3 Solar Energy Storage Technologies Advanced batteries (Li-ion, flow batteries) Week 4 Energy Efficiency in Solar Systems Energy conservation measures Week 5 Midterm Test Week 6 Safety in PV Installation Personal protective equipment (PPE), site hazards Week 7 Midterm Break Week 8 Nigerian & International Standards SON, NERC, IEC standards Week 9 Electrical Codes & Regulations Wiring codes, safety compliance Week 10 Practical: Grid-tied Solar Setup Demonstration with inverters and grid connection 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Solar Photovoltaic Installation & Maintenance","term":"Second Term","text":"Week 1 Solar Water Pumping Systems Design, applications in agriculture Week 2 Solar Street Lighting Systems Components, installation, maintenance Week 3 Solar Home Systems Standalone kits, plug-and-play designs Week 4 Advanced Wiring Techniques Conduits, trunking, cable protection Week 5 Midterm Test Week 6 PV System Maintenance I Preventive maintenance – cleaning panels, checking terminals Week 7 Midterm Break Week 8 PV System Maintenance II Troubleshooting faults, replacing components Week 9 Monitoring & Performance Evaluation Using meters and software for performance Week 10 Practical: Maintenance of Installed Systems Cleaning, testing, fault-finding 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Solar Photovoltaic Installation & Maintenance","term":"Third Term","text":"Week 1 Introduction to Solar Entrepreneurship Opportunities in Nigeria Week 2 Business Skills in Solar Sector Proposal writing, tendering Week 3 Costing & Pricing of Solar Systems Bill of quantities, cost analysis Week 4 Customer Service & Support Handling clients, after-sales service Week 5 Midterm Test Week 6 Project Management in Solar Installations Time, resources, quality control Week 7 Midterm Break Week 8 Case Studies of Nigerian Solar Projects Rural electrification, mini-grids Week 9 Practical: Business Simulation Preparing a proposal for a 5kVA solar system Week 10 Field Visit Visit to a solar company/installation site 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Fashion Design & Garment Making","term":"First Term","text":"Week 1 Review of SS1 Work Core concepts recap Week 2 Advanced Pattern Drafting Combination styles Week 3 Advanced Garment Construction I Children’s wear Week 4 Advanced Garment Construction II Men’s shirt & trousers Week 5 Midterm Test Week 6 Advanced Garment Construction III Women’s blouse & skirt Week 7 Midterm Break Week 8 Collars & Necklines Types & sewing methods Week 9 Sleeves & Cuffs Types & sewing methods Week 10 Practical: Constructing a 2-piece Outfit Week 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Fashion Design & Garment Making","term":"Second Term","text":"Week 1 Fastenings & Openings I Zippers, buttons, buttonholes Week 2 Fastenings & Openings II Hooks, snaps, Velcro Week 3 Pockets Types (patch, side, welt) Week 4 Waistbands & Facings Types & applications Week 5 Midterm Test Week 6 Lining & Interlining Types, uses, application Week 7 Midterm Break Week 8 Trimmings & Decorative Features Lace, braids, appliqué Week 9 Fashion Accessories Belts, hats, scarves, bags Week 10 Practical: Constructing a Complete Outfit Week 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Fashion Design & Garment Making","term":"Third Term","text":"Week 1 Fashion Illustration I Tools & basic sketches Week 2 Fashion Illustration II Figure drawing, garment detailing Week 3 Colour & Design Principles Colour wheel, harmony, balance Week 4 Textile Design Tie & dye, batik Week 5 Midterm Test Week 6 Nigerian Traditional Clothing Styles from Hausa, Igbo, Yoruba, others Week 7 Midterm Break Week 8 Contemporary African Fashion Modern trends Week 9 Fashion Shows & Exhibitions Organization, models, presentation Week 10 Practical: Mini Fashion Show Week 11–13 Revision & Exams"},{"page":0,"class":"SSS2","subject":"Livestock Farming","term":"First Term","text":"Week 1 Introduction to Aquaculture Meaning and importance of fish farming; Systems of aquaculture (extensive, semi-intensive, intensive) Week 2 Fish Pond Construction Site selection, pond design, pond preparation Week 3 Fish Breeds and Fingerlings Common fish species in Nigeria (catfish, tilapia); Fingerling production Week 4 Fish Nutrition and Feeding Fish feed types; Feed formulation; Feeding methods Week 5 Midterm Test – Week 6 Fish Health and Disease Common fish diseases; Symptoms, prevention, treatment Week 7 Midterm Break – Week 8 Fish Harvesting Methods of harvesting; Processing of fish Week 9 Fish Marketing Storage, transportation, sales channels Week 10 Economics of Aquaculture Cost–benefit analysis; Record keeping; Challenges of fish farming Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Snail Farming I Importance; Housing and equipment; Feeding Week 2 Snail Farming II Breeding; Management; Harvesting and marketing Week 3 Honey Bee Keeping (Apiculture) I Importance of honey bees; Bee species; Beekeeping equipment Week 4 Honey Bee Keeping II Apiary management; Honey extraction and processing Week 5 Midterm Test – Week 6 Grasscutter Farming Importance; Housing; Feeding; Breeding Week 7 Midterm Break – Week 8 Animal Health I Common livestock parasites (internal & external); Prevention and control Week 9 Animal Health II Veterinary drugs; Vaccination programmes; Quarantine practices Week 10 Pasture and Forage Crops Types of pasture; Cultivation; Conservation (silage, hay) Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Introduction to Livestock Economics Principles of farm management; Enterprise budgeting Week 2 Farm Records and Accounts Types of records; Importance of records; Practical record keeping Week 3 Marketing of Livestock Products I Channels of distribution; Pricing; Market surveys Week 4 Marketing of Livestock Products II Packaging; Branding; Export opportunities Week 5 Midterm Test – Week 6 Value Addition in Livestock Processing meat, milk, hides, skins; By-products Week 7 Midterm Break – Week 8 Cooperative Societies in Livestock Roles of cooperatives; Benefits to farmers Week 9 Government Policies in Livestock Farming Subsidies; Extension services; Regulations Week 10 Contemporary Issues Climate change impact on livestock; Biosecurity measures Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Advanced Hair Styling I Wigs and hair extensions Week 2 Advanced Hair Styling II Relaxing, perming and rebonding Week 3 Hair Colouring Types of dyes; Application methods; Safety precautions Week 4 Hair Cutting Basic techniques; Use of clippers and scissors Week 5 Midterm Test – Week 6 Advanced Makeup I Bridal makeup; Stage and fashion makeup Week 7 Midterm Break – Week 8 Advanced Makeup II Special effects makeup; Aging and fantasy looks Week 9 Cosmetic Product Formulation I Natural cosmetics (soaps, scrubs, oils) Week 10 Cosmetic Product Formulation II Perfume and cream making Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Salon Management I Setting up a beauty salon; Layout and equipment Week 2 Salon Management II Customer service; Client consultation Week 3 Business Skills I Pricing services; Record keeping; Marketing strategies Week 4 Business Skills II Branding; Packaging of products Week 5 Midterm Test – Week 6 Entrepreneurship in Cosmetology Starting small businesses in beauty industry Week 7 Midterm Break – Week 8 Spa and Wellness Therapy I Massage techniques; Aromatherapy Week 9 Spa and Wellness Therapy II Hydrotherapy; Stress management Week 10 Occupational Hazards in Cosmetology Chemical exposure; Posture problems; Safety measures Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Dermatology Basics for Beauticians Layers of skin; Skin types; Functions Week 2 Cosmetic Dermatology I Anti-aging treatments; Acne treatment methods Week 3 Cosmetic Dermatology II Laser and modern technologies in beauty Week 4 Hair Removal Methods Shaving, waxing, threading, laser Week 5 Midterm Test – Week 6 International Beauty Trends Global styles; Modern innovations Week 7 Midterm Break – Week 8 Ethics in Beauty and Cosmetology Professional conduct; Confidentiality Week 9 Regulation of Cosmetic Products NAFDAC, SON; Safety standards Week 10 Sustainable Beauty Practices Eco-friendly products; Green cosmetology Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Review of SS1 Work Questions and answers on key areas Week 2 Computer Storage Devices HDD, SSD, optical drives, flash drives Week 3 Advanced Computer Components Graphics card, sound card, expansion slots Week 4 Computer Troubleshooting I POST errors, beep codes, diagnostic steps Week 5 Midterm Examination – Week 6 Computer Troubleshooting II Boot failures, overheating, blue screen Week 7 Midterm Break – Week 8 Maintenance of GSM Tools Care of soldering iron, hot air gun, multimeter Week 9 GSM Circuit Boards Identification of ICs, resistors, capacitors Week 10 GSM Circuit Tracing Using multimeter for fault detection Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 Review of GSM Hardware Recap of SS1 GSM faults Week 2 GSM Power Section Charging IC, power IC, battery connectors Week 3 GSM Audio Section Speaker, earpiece, microphone faults Week 4 GSM Display Section Screen replacement, LCD vs OLED Week 5 Midterm Examination – Week 6 GSM Network Section Antenna, RF IC, signal problems Week 7 Midterm Break – Week 8 Software Flashing Flashing Android devices, drivers, tools Week 9 Unlocking GSM Devices IMEI repair, SIM unlocking, FRP bypass Week 10 Data Recovery Techniques Memory card, internal storage recovery Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Advanced Computer Repairs I BIOS update, OS reinstallation Week 2 Advanced Computer Repairs II Hardware upgrades: RAM, HDD, GPU Week 3 Computer Viruses and Security Types, prevention, antivirus tools Week 4 Networking Setup LAN, Wi-Fi, network troubleshooting Week 5 Midterm Examination – Week 6 GSM Software Optimization Rooting, custom ROMs, updates Week 7 Midterm Break – Week 8 Troubleshooting GSM Software Issues Boot loop, app crashes, malware Week 9 Internet Connectivity Issues Hotspot, APN, mobile data faults Week 10 Small-Scale ICT Business Setting up GSM/computer repair shop Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Horticultural Crop Improvement Aims, methods: selection, hybridization Week 2 Genetic Principles in Crop Production Mendel’s laws, applications Week 3 Biotechnology in Horticulture Tissue culture, GM crops Week 4 Organic Horticulture Principles, practices, benefits Week 5 Midterm Examination – Week 6 Greenhouse Technology Structures, benefits, challenges Week 7 Midterm Break – Week 8 Urban and Peri-Urban Horticulture Rooftop gardens, hydroponics Week 9 Agroforestry Meaning, practices, importance Week 10 Environmental Sustainability in Horticulture Soil conservation, water management Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Crop Rotation Principles, advantages, examples Week 2 Mixed Cropping and Intercropping Definitions, benefits, limitations Week 3 Crop Yield Measurement Methods, importance Week 4 Farm Mechanization in Crop Production Simple machines, advantages, limitations Week 5 Midterm Examination – Week 6 Irrigation Systems Modern methods, water conservation Week 7 Midterm Break – Week 8 Storage Structures Silos, barns, refrigerators, cold rooms Week 9 Agricultural Extension Services Roles, importance in crop production Week 10 Agricultural Cooperatives Functions, advantages, challenges Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS2","subject":"Horticulture And Crop Production","term":"Third Term","text":"Week 1 Cereal Crops Maize, rice, sorghum, millet (cultivation practices) Week 2 Leguminous Crops Cowpea, soybean, groundnut Week 3 Tuber Crops Cassava, yam, cocoyam, potato Week 4 Oil Crops Palm, coconut, sunflower Week 5 Midterm Examination – Week 6 Vegetables Tomato, okra, pepper, spinach Week 7 Midterm Break – Week 8 Fruits Mango, citrus, banana, pineapple Week 9 Spices and Condiments Ginger, garlic, pepper, cloves Week 10 Medicinal Plants Neem, moringa, aloe vera Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"English Language","term":"First Term","text":"Week 1 Vocabulary Development (Culture, Institutions and Ceremonies) Words associated with culture: ceremonies (child naming, festivals, rituals, chieftaincy, title-taking, installation). Words associated with institutions: social norms, morality, customs, social class, marriage, family life. Words related to African arts, sculpture, lyrics, age groups. Week 2 Spoken English – Revision of Intonation Patterns Falling tone in statements; rising tone in yes/no questions; practice with examples. Week 3 Grammatical Structures – Nouns and Noun Phrases Types of nouns (common, proper, collective, abstract); plural formation (regular and irregular); use in sentences. Week 4 Writing – Continuous Writing (Expository) Writing expository essays (not more than 400 words) on current issues: external examinations, elections, plane crash, excursion, drug abuse, corruption. Week 5 Midterm Examination — Week 6 Comprehension – Silent Reading Reading on topical issues: population explosion, youth unemployment, youth restiveness, being your brother’s keeper, examination malpractice, corruption. Discussion of meaning of words in context and answering questions of varying difficulty. Week 7 Midterm Break — Week 8 Summary Writing – Summarizing a Talk/Lecture Summarizing talks/lectures on topics such as HIV/AIDS, population, corruption, environmental issues, values orientation; answering relevant summary questions. Week 9 Spoken English – Consonant Clusters Words with two consonants at final position (banks, sacks, tasks, exist, thrusts); words with three consonants (scripts, crafts, twelfth); words with four consonants (sixths, twelfths, prompts, glimpsed). Week 10 Vocabulary Development – Motor Vehicles Vocabulary: chassis, bonnet, trafficators, carburetor, radiator, fuel gauge, alternator, wiper, rear lights, side lights, windscreen. Week 11 Grammatical Structures – Pronouns Definition, types (personal, possessive, reflexive, relative, demonstrative, indefinite), uses in sentences. Week 12 Listening Comprehension Listening to speeches, radio broadcasts, recorded talks; identifying main ideas; note-taking techniques; practice with selected passages. Week 13 Spoken English – Words with Schwa /ə/ The schwa as final unstressed syllable in words like teacher, mother, daughter, sister, enter."},{"page":0,"class":"SSS3","subject":"English Studies","term":"Second Term","text":"Week 3 Spoken English / Listening / Writing / Grammar / Reading Spoken English: Reading and appreciating poetry; Arguing given topics effectively. Listening: Following arguments efficiently. Writing: Writing for different audiences (teachers, headmasters, newspapers, magazines). Grammar: Adjuncts – forms and functions (time, place, manner, comparison, result). Reading: Paraphrasing dramatic works. Week 4 Listening / Reading / Vocabulary / Writing / Grammar Listening: Paraphrasing poems listened to. Reading: Summarizing by outlining main points. Vocabulary: Words from foreign elements in English (Latin & Greek origin). Writing: Revising continuous writing (expository composition on current issues e.g. drug abuse, corruption). Grammar: Revising adjectival clauses. Week 5 Midterm Examination Midterm test and assessment. Week 6 Listening / Vocabulary / Writing / Grammar Listening: Paraphrasing poetry. Vocabulary: Words associated with law and order (police, plaintiff, tribunal, civil rights, justice, societal norms). Writing: Writing for different audiences (newspapers, magazines). Grammar: Revising complex sentences. Week 7 Midterm Break School goes on midterm holiday. Week 8 Writing / Comprehension / Vocabulary Writing: Report writing (official and private reports, accidents, meeting proceedings). Comprehension: Silent reading of topical issues; answering questions. Vocabulary: Idioms and idiomatic expressions (e.g. silver spoon, black sheep, bull by the horn). Week 9 Listening / Reading / Grammar / Writing Listening: Following instructions accurately. Reading: Summarizing argumentative passages. Grammar: Adverbial clauses (cause, purpose, condition, contrast). Writing: Report writing (continuation). Week 10 Listening / Revision Listening: Dramatic presentations – identifying themes and storylines. Revision: Drama – theme, storyline, features of a play; selected Nigerian and foreign plays. Week 11 Revision General revision of all topics taught during the term. Week 12 Examination End of term examination. Week 13 Closing School closes for the term."},{"page":0,"class":"SSS3","subject":"Mathematics","term":"First Term","text":"Week 1 Welcome Test and Review of Difficult SS2 Topics Review of logarithm laws; solving questions involving logarithm theory; application of logarithm to complex calculations. Week 2 Logic Simple and compound statements; logical operations and their symbols; truth tables; conditional statements; indirect proof; application of truth tables in proving equivalence. Week 3 Application of Surds to Trigonometry Simplifying surds in trigonometric ratios of 30°, 45°, and 60°; drawing and interpreting graphs of sine and cosine (0°–360°); solving trigonometric and linear equations using graphs. Week 4 Matrices and Determinants Definition and order of a matrix; types of matrices; operations (addition, subtraction, multiplication); transpose of a matrix; determinants of square matrices; solving simultaneous equations using matrices. Week 5 Midterm Examination — Week 6 Linear and Quadratic Equations Solving simultaneous linear and quadratic equations algebraically and graphically; interpreting graphs; solving word problems including capital market applications. Week 7 Midterm Break — Week 8 Surface Area and Volume of Spheres and Hemispheres Finding surface area and volume of solid and hollow spheres; curved surface area of a hemisphere; solving word problems; use of charts/videos to illustrate geometry in real life. Week 9 Longitude and Latitude I Identification of North/South Poles, longitude, latitude, equator, and meridian; formula for calculating length and radius of parallel of latitude; solving related problems. Week 10 Longitude and Latitude II Calculations of distances between two points on the same parallel of latitude or meridian; time variations between two places using nautical rules. Week 11 Binary Operations Definition; properties—closure, commutativity, associativity, distributivity, identity, inverse; solving problems involving binary operations; real-life applications. Week 12 Arithmetic of Finance Simple and compound interest; annuities; depreciation; amortization; solving financial mathematics problems. Week 13 Revision / Examination / Closing General revision of all topics; end-of-term examinations; closing activities."},{"page":0,"class":"SSS3","subject":"Mathematics","term":"Second Term","text":"Week 1 Review of First Term Work & Financial Mathematics Review test; introduction to bonds, debentures, shares, income tax, and value-added tax; solving problems on interest, rates, and taxation using logarithm tables. Week 2 Coordinate Geometry of a Straight Line Cartesian plane; plotting linear graphs; distance between points; mid-point of a line; gradient and intercepts; application of coordinate geometry in everyday life. Week 3 Construction I Locus of moving points equidistant from lines/points; circumscribed, inscribed, and escribed circles; practical construction problems. Week 4 Differentiation of Algebraic Functions I Concept of limit; first principle of differentiation; derived functions; interpretation of derivatives of standard functions. Week 5 Midterm Examination — Week 6 Differentiation of Algebraic Functions II Application of differentiation to solve related problems; maxima, minima, and rates of change; application in business and capital markets. Week 7 Midterm Break — Week 8 Integration of Algebraic Functions Standard integrals; methods of integration (substitution, by parts, partial fractions); application of integration to real-life and capital market problems. Week 9 Functions and Mapping Concept of function; mapping; domain, co-domain, and range; inverse functions; solving problems involving functions and their graphs. Week 10 General Review of Calculus Mixed practice on differentiation and integration; real-life applications of calculus in physics, engineering, and economics. Week 11 Revision General revision of all term’s topics with WAEC/NECO past questions. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Citizenship And Heritage Studies","term":"First Term","text":"Week 1 Review of Citizenship Concepts Quick revision of SS1 & SS2 content Week 2 National Identity & Citizenship Components of national identity Week 3 Global Peace & Citizenship Role of Nigeria in peacekeeping Week 4 Justice & Fairness Social justice, equity, rule of law Week 5 Midterm Test Week 6 Heritage in Modern Nigeria Influence of tradition on contemporary life Week 7 Midterm Break Week 8 Civic Entrepreneurship Using civic skills for nation building Week 9 Ethics & Integrity Importance, challenges, role in governance Week 10 National Rebirth & Transformation Agenda Government initiatives & citizen participation 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Citizenship And Heritage Studies","term":"Second Term","text":"Week 1 Global Issues in Citizenship Terrorism, migration, climate change Week 2 Nigeria’s Role in International Affairs AU, UN, ECOWAS Week 3 Human Rights Protection in Nigeria NHRC, judiciary, NGOs Week 4 Sustainable Development Goals (SDGs) Concept, relevance to Nigeria Week 5 Midterm Test Week 6 Youth & Citizenship Role of youth in democracy, innovation, volunteering Week 7 Midterm Break Week 8 Challenges of Nigerian Citizenship Corruption, insecurity, poor leadership Week 9 Strategies for Strengthening Citizenship Education, legislation, role of families Week 10 Civic Competence for Nation Building Knowledge, skills, values required 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Citizenship And Heritage Studies","term":"Third Term","text":"Week 1 Consolidation of Citizenship Education Major themes across SS1–SS3 Week 2 National Consciousness Meaning, importance, development Week 3 Preparing for Civic Roles after Secondary School Voting, volunteering, community service Week 4 Global Citizenship & Future of Nigeria Active participation in a globalized world Week 5 Midterm Test Week 6 Legacy of Nigerian Heritage Continuity, preservation, modernization Week 7 Midterm Break Week 8 Mock Citizenship Project Practical project (debate, essay, heritage preservation task) Week 9 SSCE Preparation Exam focus areas & practice questions Week 10 Life After School Civic life, responsibilities, opportunities 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Digital Technologies","term":"First Term","text":"Week 1 Review of SS2 Work Key concepts revision Week 2 Advanced Programming I Functions, arrays/lists Week 3 Advanced Programming II Object-Oriented Programming basics Week 4 Software Development Life Cycle (SDLC) Phases, models (waterfall, agile) Week 5 Midterm Test Week 6 Networking II IP addressing, subnetting, protocols Week 7 Midterm Break Week 8 Cloud & Virtualization Virtual machines, remote servers Week 9 Internet of Things (IoT) Applications Smart homes, smart cities Week 10 Data Protection & Backup Systems Disaster recovery, redundancy 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Digital Technologies","term":"Second Term","text":"Week 1 Advanced Web Design JavaScript interactivity, responsive design Week 2 Advanced Database Management SQL basics, queries, reports Week 3 Networking III Network security, VPNs Week 4 Digital Project Management Tools (Trello, MS Project), teamwork Week 5 Midterm Test Week 6 Emerging Tech III Quantum computing, nanotechnology Week 7 Midterm Break Week 8 Revision of SSCE Past Questions I Theory + practical Week 9 Revision of SSCE Past Questions II Case studies, applied ICT Week 10 Mock Exam Prep 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Digital Technologies","term":"Third Term","text":"Week 1 Comprehensive Revision of SS1–SS3 Overview of major areas Week 2 Past Question Drills (WAEC/NECO) Theory, objective Week 3 Practical Project I Building website/app/database Week 4 Practical Project II Cybersecurity simulation, IoT demo Week 5 Midterm Test Week 6 Mock Examination Week 7 Midterm Break Week 8 SSCE Preparation Exam-focused review Week 9–10 WAEC/NECO & Final Examinations 11–13 Closing & Graduation"},{"page":0,"class":"SSS3","subject":"Biology","term":"First Term","text":"Week 1 Reproductive Behaviours in Animals Meaning of reproductive behaviour; courtship behaviour; mating systems (monogamy, polygamy, promiscuity); parental care in fishes, amphibians, birds and mammals; importance of reproductive behaviours in survival of species. Week 2 Biology of Heredity (Genetics I) Concept of heredity; brief history of genetics (Gregor Mendel’s experiments); terminologies—gene, allele, chromosome, genotype, phenotype, homozygous, heterozygous; Mendel’s laws of inheritance with examples. Week 3 Genetics II Monohybrid and dihybrid crosses; Punnett square applications; sex determination in humans; sex-linked traits (haemophilia, colour blindness); importance of genetics in agriculture and medicine. Week 4 Variation and Evolution I Concept of variation; types of variation—morphological, physiological, discontinuous and continuous; causes of variation (mutation, meiosis, fertilization, environment); adaptive colouration, mimicry, and camouflage in animals. Week 5 Midterm Examination — Week 6 Evolution II Meaning of evolution; theories of evolution—Lamarckism and Darwinism; modern synthetic theory of evolution; evidence of evolution (fossil records, comparative anatomy, embryology, vestigial structures); natural selection and adaptation. Week 7 Midterm Break — Week 8 Human Evolution Origin of man; fossil evidence of human evolution (Australopithecus, Homo habilis, Homo erectus, Homo sapiens); similarities between humans and apes; cultural and biological evolution of humans. Week 9 Application of Genetics and Evolution Application in agriculture (selective breeding, hybridization, genetic engineering, GMOs); application in medicine (blood transfusion, sickle cell study, genetic counselling, cloning, IVF); role of evolution in biodiversity and conservation. Week 10 Ethical, Social and Economic Implications of Genetics and Evolution Ethical debates on cloning, stem cell research, GMOs; advantages and disadvantages; importance of conservation of genetic resources; relevance to Nigeria’s development. Week 11 Revision General revision of all topics taught in the term, with practice questions and past exam applications. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Chemistry","term":"First Term","text":"Week 1 Food Chemistry Carbohydrates, proteins, fats; their properties, reactions, and importance. Week 2 Drugs and Their Effects Classification of drugs; medicinal uses; harmful chemicals and drug abuse. Week 3 Chemistry in Industry and Everyday Life Applications of chemistry in food, medicine, agriculture, textiles, construction, and household products. Week 4 Environmental Chemistry Types of pollution (air, water, soil, noise); causes and effects; methods of remediation. Week 5 Midterm Examination Comprehensive WAEC/NECO syllabus review – overview of topics from SS1–SS3. Week 6 Industrial Chemistry Chemical industries in Nigeria – petroleum, cement, soap, paint, textiles, beverages, etc. Week 7 Midterm Break — Week 8 Revision of Organic Chemistry Review of hydrocarbons, functional groups, reactions; practical activities and past questions. Week 9 Revision of Inorganic Chemistry Periodic table, properties of selected elements, their reactions and compounds. Week 10 Revision of Physical Chemistry Rates of reaction, equilibrium, gas laws, energetics. Week 11 Chemical Calculations Practice Moles, molar mass, titrations, stoichiometry, empirical and molecular formulas. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Chemistry","term":"Second Term","text":"Week 1 Practical Chemistry Techniques Titrations, qualitative analysis (acid-base, redox, salts), preparation of gases. Week 2 Summary of Major Topics Review of essential concepts across SS1–SS3. Week 3 Chemistry in Everyday Life Chemistry of food, drugs, cosmetics, textiles, plastics, soaps, and detergents. Week 4 Exam Strategy and Time Management Techniques for multiple-choice, essay, and practical exams; time management skills. Week 5 Midterm Examination — Week 6 WAEC/NECO Past Questions Review Analysis of past questions, marking schemes, common pitfalls. Week 7 Midterm Break — Week 8 Practical Chemistry Review Use of indicators, gas preparation and identification, salt tests. Week 9 Data Interpretation and Report Writing Recording results, analysis of tables and graphs, drawing valid conclusions. Week 10 Final Tips and Revision Strategies for last-minute preparation, study timetables, mental readiness. Week 11 Revision General revision of SS1–SS3 chemistry. Week 12 Mock Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Physics","term":"First Term","text":"Week 1 Conversion of Energy Meaning of energy conversion; principle of conservation of energy; conversion of energy from one form to another (mechanical to electrical, electrical to heat, chemical to electrical, etc.); practical demonstrations (electric iron, generator, dynamo, solar panels). Week 2 Transmission System Concept of transmission; mechanical transmission systems (gears, pulleys, levers, belt drives, chain drives); electrical transmission systems (power lines, transformers); importance of efficient transmission in reducing energy loss. Week 3 Uses of Machines Definition of machines; functions of simple machines; efficiency and mechanical advantage; applications of machines in everyday life (cranes, pulleys, levers, wheel and axle, hydraulic press). Week 4 Repair and Maintenance of Machines Meaning of repair and maintenance; common faults in machines; importance of lubrication, cleaning, and routine checks; differences between preventive and corrective maintenance. Week 5 Midterm Examination — Week 6 Dams and Energy Production Types of dams (hydroelectric, irrigation, multipurpose); processes involved in hydroelectric power generation; advantages and disadvantages of dams; examples in Nigeria (Kainji, Shiroro, Jebba dams). Week 7 Midterm Break — Week 8 Rockets and Satellites Principles of rocket propulsion (Newton’s third law of motion); types of rockets (solid fuel, liquid fuel); satellites—types (communication, navigation, weather, military); importance of satellites in modern technology. Week 9 Niger-SAT 1 Background of Nigeria’s first satellite (2003); objectives— environmental monitoring, disaster management, agricultural planning, security; achievements and challenges of Niger-SAT 1. Week 10 NICOM-SAT 1 Launch of NICOM-SAT 1 (2007); uses in communication, internet services, broadcasting; challenges—satellite control and failure; impact on Nigeria’s development. Week 11 Revision General revision of all topics covered in the term with emphasis on applications, calculations, and problem solving. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Agricultural Science","term":"First Term","text":"Week 1 Crop Improvement Meaning and objectives of crop improvement; methods of crop improvement (selection, introduction, hybridization); advantages and disadvantages; importance of genetic improvement. Week 2 Animal Improvement Meaning and objectives of animal improvement; methods (inbreeding, crossbreeding, artificial insemination, embryo transfer); advantages and limitations. Week 3 Animal Health Management Importance of animal health; common diseases and parasites of livestock; symptoms, prevention and control measures; routine management practices for healthy animals. Week 4 Aquaculture Meaning and scope; types of aquaculture systems (extensive, semi- intensive, intensive); common species cultured; management practices; importance of aquaculture in food security. Week 5 Midterm Examination — Week 6 Apiculture (Bee Keeping) Meaning and importance; types of bees; equipment used; management practices; products of beekeeping and their economic uses. Week 7 Midterm Break — Week 8 Agricultural Finance Meaning and importance; sources of agricultural finance (formal and informal); problems of agricultural finance; role of government and banks in agricultural credit. Week 9 Farm Records and Accounts Meaning and importance of farm records; types of farm records (production, financial, inventory, consumption); simple farm account preparation. Week 10 Marketing of Agricultural Produce Meaning and importance of agricultural marketing; functions of marketing; marketing channels; problems of agricultural marketing and solutions. Week 11 Agricultural Insurance Meaning and importance; types of agricultural insurance (crop, livestock, farm equipment, produce); benefits and limitations; role of government and insurance companies. Week 12 Agricultural Extension Meaning and objectives; role of agricultural extension agents; methods of extension (individual, group, mass media); problems of extension services in Nigeria. Week 13 Revision General review of all topics covered during the term. 14 Examination —"},{"page":0,"class":"SSS3","subject":"Further Mathematics","term":"First Term","text":"Week 1 Inequalities Quadratic inequalities; Inequalities in two dimensions. Week 2–3 Matrices and Determinants Meaning of matrices; Addition, subtraction and multiplication of matrices; Matrices as linear transformations; Determinants; Solution of simultaneous equations using 2×2 and 3×3 matrices. Week 4 Partial Fractions Basic definition of partial fraction; Proper rational functions with denominators as linear factors (distinct, repeated, and others). Week 5–6 Probability Distributions Binomial distribution; Poisson distribution; Normal distribution; Binomial approximation by Poisson distribution. Week 7–8 Variance Mean, variance, and coefficient of variation of binomial, Poisson and normal distributions. Week 9–10 Correlation Concept of correlation as a measure of relationship; Scatter diagrams; Rank correlation; Tied ranks. Week 11 Revision General revision of all first term topics. Week 12 Examination End of term examination."},{"page":0,"class":"SSS3","subject":"Further Mathematics","term":"Second Term","text":"Week 1–2 Integration Integration as the reverse process of differentiation; Integration of algebraic polynomials including logarithmic functions; Definite integrals and application to kinematics (v–t and s–t graphs); Area under a curve; Trapezoidal rule; Volume of solids of revolution. Week 3–4 Conic Sections Equations of parabola, ellipse and hyperbola in rectangular Cartesian coordinates; Parametric equations of conic sections. Week 5–6 Statics Forces in equilibrium; Resultant parallel forces (same and opposite directions) acting on a rigid body; Moment of a force; Two and three forces acting at a point; Polygon of forces; Resolution of forces; Friction. Week 7 Modelling Introduction to mathematical modelling; Dependent and independent variables; Construction of mathematical models; Applications to physical, biological, social and behavioural sciences. Week 8 Game Theory Introduction to game theory; Types of games; Solution of two-person zero- sum games using pure and mixed strategies; Matrix games. Week 9 Revision General revision of second term topics. Week 10 Examination End of term examination."},{"page":0,"class":"SSS3","subject":"Food And Nutrition","term":"First Term","text":"Week 1 Beverages • Explain the term beverages. • Classify beverages into alcoholic and non • alcoholic with examples. • Discuss the nutritive value of beverages. • Highlight the characteristics of alcoholic and non • alcoholic beverages. Week 2 Beverages (Non Alcoholic) • Classify non • alcoholic beverages. • Justify each class of non • alcoholic beverages with examples. Week 3 Special Diet • Explain the term Special Diet. • Explain the different types of vegetarian diet: strict/vegan, lacto, ovo, lacto • ovo, pescatarian, pollotarian, flexitarian. • Differentiate between overweight and underweight diet. • Discuss diets for persons suffering from: HIV/AIDS, fever and infection, overweight, diarrhoea, diabetes, ulcer, etc. Week 4 Practical on Beverages and Special Diet • Prepare and serve different types of beverages (cocoa, coffee, tea, fruit drinks, juice, egg flip, milk drinks, etc.). • Prepare and serve dishes for vegetarians, overweight, diabetic, ulcer patients, etc. Week 5 Midterm Examination • Midterm Test. Week 6 Cultural Food Habit • Explain food habits, food taboos, food facts, and food fallacies. • Analyse the factors influencing food habits. • Identify traditional foods associated with taboos. • Justify food fallacies with examples and correct facts. Week 7 Midterm Break • — Week 8 Traditional and Foreign Dishes • Explain the terms: traditional dishes and foreign dishes. • Identify traditional dishes from different localities."},{"page":0,"class":"SSS3","subject":"Food And Nutrition","term":"Second Term","text":"Week 1 Welcome Test & Food Service • Answer questions from previous topics. • Explain food service. • Differentiate between formal and informal food service. • Analyse different types of informal service. • Justify the importance of food service. Week 2 Self Employment (Catering Enterprise) • Explain the terms: entrepreneur, entrepreneurship, enterprise. • Discuss the characteristics of entrepreneurship. • State advantages and disadvantages of entrepreneurship. • Identify factors contributing to the success of an enterprise. • Discuss how to set up a catering enterprise. Week 3 Self Employment (Work Ethics and Food Packaging) • Explain the terms: work ethics and food packaging. • Discuss good work ethics. • Enumerate reasons for packaging food. • Justify types and qualities of packaging materials. Week 4 Experimental Cookery • Explain the term recipe. • Identify sources of collecting information on recipes. • Discuss methods of collecting information for recipes. • Analyse the importance of collecting recipe information. • Justify the advantages of recipes. • Create a recipe. Week 5 Midterm Examination • Midterm Test. Week 6 Test Interpretation • Interpret given cookery test questions."},{"page":0,"class":"SSS3","subject":"Geography","term":"First Term","text":"Week 1 Denudation Processes Meaning of denudation; agents of denudation (running water, wind, ice, waves); processes of denudation – weathering, erosion, transportation, deposition. Week 2 Weathering Meaning of weathering; types of weathering (mechanical, chemical, biological); factors influencing weathering; importance and effects of weathering on the environment. Week 3 Mass Movements Definition; types of mass movement (soil creep, landslides, rock fall, mudflow, solifluction, avalanches); causes and effects on human activities. Week 4 Climatic Change Meaning of climate and climate change; historical and contemporary evidence; causes of climate change (natural and human); effects on environment, agriculture, and human activities; global and local responses. Week 5 Midterm Examination — Week 6 ECOWAS Formation and objectives; structure and functions; achievements and challenges of ECOWAS; role in regional integration. Week 7 Midterm Break — Week 8 Trade Meaning of trade; types of trade (internal and international); importance of trade; trade patterns in Nigeria and West Africa; problems of trade. Week 9 Tourism Meaning and importance; types of tourism (domestic, international, eco- tourism, cultural tourism); tourist attractions in Nigeria and West Africa; benefits and challenges of tourism. Week 10 Satellite Remote Sensing Meaning and principles; types of remote sensing (aerial photography, satellite imagery); importance and applications in geography (mapping, agriculture, environmental monitoring). Week 11 GIS Application Meaning of Geographic Information Systems (GIS); components of GIS (hardware, software, data, people, methods); applications of GIS in resource management, planning, and environmental studies. Week 12 Revision General review of all topics covered during the term. Week 13 Examination — 14 Closing —"},{"page":0,"class":"SSS3","subject":"Technical Drawing","term":"First Term","text":"Week 1 Engineering Designs and Working Drawing Preparation of working drawings on the drawing table Week 2 Engineering Designs and Working Drawing (Continued) Preparation of working drawings on the drawing table Week 3 Screw Threads, Fasteners and Locking Devices Meaning of screw threads, fasteners, and locking devices; Identification and sketching; Uses of screws for hanging wooden materials/doors Week 4 Screw Threads, Fasteners and Locking Devices (Continued) Meaning of screw threads, fasteners, and locking devices; Identification and sketching; Uses of screws for hanging wooden materials/doors Week 5 Midterm Test – Week 6 Engineering Working Drawing Reading and interpreting various engineering drawings; Preparing working drawings of simple machine parts to scale; Coupling simple machine parts (e.g., manual air pumps); Producing working drawings of machine assemblies Week 7 Midterm Break – Week 8 Sections and Sectional Views Meaning of sectioning; Cutting and observing internal parts of an object; Identifying different types of sections in engineering drawing; Drawing sections of simple engines and assemblies Week 9 Block Sectioning Design of building floor plans and sectional views; Building elevations; Roof structures; Sketching internal part of moulded hollow block; Recognizing different roof designs Week 10 Block Sectioning (Continued) Continuation of floor plans, sectional views, elevations, roof structures, hollow blocks, and roof designs Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Technical Drawing","term":"Second Term","text":"Week 1 Introduction to Computer Meaning of computer; Common hardware components; Parts of a computer system; Using computer and software for building/engineering design; Introduction to CAD applications Week 2 Arches Meaning of arches; Types of arches; Importance of arches; Identification of arches in buildings Week 3 Roofs Meaning of roof; Types of roofs and roof members; Designing roofs and members; Determining roof pitch; Identifying roof designs in buildings Week 4 Conventional Representation of Materials and Symbols Plumbing, electrical, and mechanical symbols; Differentiation between symbols; Application of conventional representation of materials in technical drawings Week 5 Midterm Test – Week 6 Blueprint Reading, Reproduction Services and Merchandising Reading and interpreting building drawings, engineering drawings, and blueprints; Methods of sourcing funds; Setting up blueprint reproduction service centers Week 7 Midterm Break – Week 8 Blueprint Reading, Reproduction Services and Merchandising (Continued) Continuation of blueprint interpretation, construction/production applications, and managing blueprint services Week 9 Computer-Aided Design (CAD) Basic skills in using CAD software; Producing technical drawings using CAD; Comparing manual drawing and CAD Week 10 Computer-Aided Design (Continued) Advanced applications of CAD in engineering and building design Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Nigerian History","term":"First Term","text":"Week 1 Islamic Movements in West Africa Causes of Islamic movements; establishment of Muslim States in West Africa Week 2 The Jihads of Ahmadu Seku and Alhaji Umar Background, causes, course, and effects of both Jihads Week 3 The Activities of Samori Toure His rise, resistance against the French, and legacy Week 4 Muslim States and European Colonization Effects of European expansion on Muslim States Week 5 Midterm Examination — Week 6 Christian Missionary Activities in West Africa Arrival, spread, and missionary societies Week 7 Midterm Break — Week 8 Impact of Christian Missionary Activities Religious, educational, and socio-political effects Week 9 Empires in Western Sudan Ghana, Mali, Songhai: origins, administration, decline Week 10 Industrial Revolution and New Imperialism Causes of European expansion and its global impact Week 11 Revision Review of Themes 1–3 Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Nigerian History","term":"Second Term","text":"Week 1 The Berlin Conference and Partition of Africa Causes, major decisions, and consequences for Africa Week 2 Colonial Subjugation and African Reaction African resistance movements: Samori, Menelik II, Zulu, etc. Week 3 Colonial Rule in Africa Systems of administration: Direct and Indirect Rule Week 4 Colonial Economy and Underdevelopment Cash crop production, taxation, labour, and trade exploitation Week 5 Midterm Examination — Week 6 Colonial Africa and the World Wars Africa’s role and impact of both wars Week 7 Midterm Break — Week 8 Origins of Nationalism in Africa Early resistance, the rise of educated elites, and organizations Week 9 Patterns of Nationalist Movements and Independence Case studies: Ghana, Nigeria, Kenya Week 10 External Influences on African Nationalism Pan-Africanism, UNO, OAU, World Wars, and global solidarity Week 11 Revision General review of colonial and nationalist developments Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Nigerian History","term":"Third Term","text":"Week 1 Prelude to Apartheid Historical background, causes, and implementation in South Africa Week 2 Apartheid Legislation and Suppression Laws, policies, resistance movements (ANC, Mandela, etc.) Week 3 The OAU (AU) and the Fight Against Apartheid Role of African states and international organizations Week 4 Neo-Colonialism in Africa Political and economic effects on development Week 5 Midterm Examination — Week 6 Political and Economic Problems of Independent African States Coups, corruption, poverty, and unequal development Week 7 Midterm Break — Week 8 The Military Intervention in African Politics Causes, examples, and consequences Week 9 Boundary Disputes and African Unity Nigeria–Cameroon, Ethiopia–Eritrea, and others Week 10 Global Institutions and Africa Role of AU, ECOWAS, Commonwealth, UNO, OPEC Week 11 Africans in the Diaspora and Global Contributions Role of African-descended peoples in global affairs Week 12 Revision & Examination General review of Africa and global issues Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Government","term":"First Term","text":"Week 1–2 Resumption Test / Military Rule in Nigeria • Discuss reasons for military intervention. • Explain the roles of government structure under military rule. • Describe the performance of military administration. • Identify ways military coups can be avoided. Week 3 Conflict Resolution and Management • Explain the meaning of conflict. • Discuss causes of conflict. • Examine the consequences of conflict. • Identify ways of resolving conflict. Week 4 Peace Education • Explain the meaning of peace. • Discuss the need for peace. • Identify ways peace can be promoted. Week 5 The Interdependence of Nations and Globalization • Discuss interdependence of nations. • Explain Nigeria’s international relations: economic, political, cultural, and social. • Identify advantages and disadvantages of interaction among nations. Week 6 Nigeria’s Foreign Policy I • Explain foreign policy. • Examine factors that influence Nigeria’s foreign policy. • Outline the principles of Nigeria’s foreign policy. • Highlight objectives of Nigeria’s foreign policy. Week 7 Midterm Test / Open Day / Midterm Break • — Week 8 Nigeria’s Foreign Policy II • Explain the origin of Africa as the centrepiece of Nigeria’s policy."},{"page":0,"class":"SSS3","subject":"Government","term":"Second Term","text":"Week 1–2 Resumption Test / International Organisation: ECOWAS • Explain the formation of ECOWAS. • Outline aims and objectives of ECOWAS. • Explain organs of ECOWAS. • Highlight achievements of ECOWAS. • Identify problems confronting ECOWAS. Week 3–4 International Organisation: OPEC • Explain the formation of OPEC. • Outline aims and objectives. • Explain organs of OPEC. • Highlight achievements of OPEC. • Discuss problems confronting OPEC. Week 5 Millennium Development Goals (MDGs) & NEPAD • Explain meaning of MDGs. • Identify achievements of MDGs by 2015. • Describe the term NEPAD. • Outline aims of NEPAD. Week 6 E Government, Leadership and Followership • Explain the meaning of e-government. • Give examples of e-government. • Discuss advantages and disadvantages of e- government. • Describe leadership and followership. • Discuss qualities of a good leader. • Explain roles of leaders and followers in politics and government. Week 7 Midterm Test / Break • — Week 8–11 Continuation / Practical Applications • (Depending on state/unified curriculum adjustments: case studies, debates, or model United Nations exercises). Week 12 Revision • General review of second term topics. Week 13–14 Examination • End of Term Examinations."},{"page":0,"class":"SSS3","subject":"Christian Religious Studies","term":"First Term","text":"Week 1 Civic Responsibilities Meaning of civic responsibilities; examples (obedience to laws, payment of taxes, voting, community service); importance of civic responsibilities in nation building; biblical teachings on civic duties (Romans 13:1–7). Week 2 HIV/AIDS I Meaning of HIV and AIDS; causes and modes of transmission; biblical perspectives on sexual purity; consequences of immoral living; preventive measures. Week 3 HIV/AIDS II Myths and misconceptions about HIV/AIDS; effects on individuals, families, and society; role of Christians in showing care and compassion; biblical support for healthy living. Week 4 Independence and Self-Actualization Meaning of independence; self-reliance and personal responsibility; ways of achieving self-actualization; biblical examples of self-reliant individuals; importance of depending on God. Week 5 Midterm Examination — Week 6 Dignity of Labour Meaning of labour; biblical view on work (Genesis 2:15, Proverbs 22:29); importance of dignity in labour; consequences of idleness; relevance of honest work in contemporary society. Week 7 Midterm Break — Week 8 Christian Attitude to Corruption Meaning of corruption; forms of corruption (bribery, fraud, nepotism, dishonesty); effects of corruption on individuals and society; biblical condemnation of corruption (Amos 5:12, Micah 6:11, Proverbs 17:23); Christian response to corruption. Week 9 Forgiveness Meaning of forgiveness; biblical teachings on forgiveness (Matthew 18:21–22, Luke 15:11–32, Colossians 3:13); importance of forgiveness in Christian living; benefits of forgiveness to individuals and communities. Week 10 Perseverance, Wealth and Poverty Meaning of perseverance; biblical examples (Job, Paul, Joseph); wealth—meaning, acquisition, and biblical guidelines (1 Timothy 6:6–10); poverty—causes and biblical response (Acts 4:32–35, Proverbs 19:17). Week 11 Revision General revision of all topics covered. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Visual Arts","term":"First Term","text":"Week 1 Drawing and Painting • Explain materials and tools for painting. • List materials and tools used for drawing and painting and use them effectively. • Observe objects for drawing and painting purposes. • Apply colours on natural objects. • Demonstrate uses of colour on drawn objects (nature composition drawing). Week 2 History of Art (Western Art: Early Christian, Byzantine, Islamic, Renaissance Art) • Appraise Western Art such as Early Christian, Islamic, Renaissance, etc. • Analyse basic knowledge on surface architecture and decoration. • Highlight artists involved in Western Art. • List media used for Western Art. • State the characteristics of Western Art and apply skills in artwork. Week 3 Impressionism Art Movement • Explain the Impressionism Art Movement of the 19th century. • List the artists involved in the movement. • Identify the style of the Impressionism Movement. • Mention characteristics and functions of Impressionism Art and apply them accordingly. Week 4 Nigerian Contemporary Artists • Explain the history of Nigerian contemporary artists. • List the contribution of each artist. • Value and criticise the works of Nigerian contemporary artists. • List their areas of specialisation in the field of art."},{"page":0,"class":"SSS3","subject":"Visual Arts","term":"Second Term","text":"Week 1 Cultural and Creative Arts • Value and appraise cultural and creative arts. • State components of cultural and creative arts (fine art, applied art, music, dance, drama, media art, etc.). • Highlight the functions of cultural and creative arts in society. • Discuss the difference between fine art and applied art. Week 2 Imaginative Composition • Explain imaginative composition. • List types of grounds in imaginative composition (market scene, still life, festivals, village scene). • Produce imaginative composition. • List materials used in imaginative composition and apply them effectively. • Organise imaginative composition painting. Week 3 Craft in Nigeria • Explain the meaning of art and craft. • List and use materials and tools for craft. • Demonstrate methods of producing arts and crafts (styles and uses). • Mention the origin/location of craft production in Nigeria. • List the functions and characteristics of crafts and relate them to modern art. Week 4 Art Terminologies • Explain art terminologies. • Mention art terminologies used in the field of art. • Apply terminologies in artwork. Week 5 General Terminologies in Two and Three Dimensional Arts • Explain two • and three • dimensional artworks. • Differentiate between two • and three • dimensional artworks."},{"page":0,"class":"SSS3","subject":"Literature-In-English","term":"First Term","text":"Week 1 Welcome Test / Revision of Last Term’s Work - Recall the previous term’s work. - Relate Shakespeare’s background to Antony and Cleopatra. - Discuss the play’s historical and thematic background. Week 2 Dramatic Personae of William Shakespeare’s Antony and Cleopatra - Analyse the characters: Antony, Cleopatra, Octavius Caesar, Enobarbus, Charmian, and others. - Discuss relationships among the key characters and their roles in the tragedy. Week 3 Antony and Cleopatra – Act I - Analyse the events and conflicts in Act I. - Discuss Antony’s divided loyalty between Rome and Egypt. - Examine themes of love, power, and politics. Week 4 Antony and Cleopatra – Act II - Discuss the growing tension between Antony and Caesar. - Analyse Cleopatra’s character and her influence on Antony. - Examine language, imagery, and dramatic techniques used. Week 5 Antony and Cleopatra – Act III - Study the battle scenes and turning points. - Examine betrayal, ambition, and loyalty. - Discuss the role of Enobarbus as a foil to Antony. Week 6 Antony and Cleopatra – Acts IV & V - Analyse the tragic resolution of the play. - Identify the main themes: love vs. duty, honour, pride, and fate. - Discuss Shakespeare’s use of imagery, irony, and symbolism. Week 7 Mid-Term Break / Open Day — Week 8 Introduction to Unseen Prose - Features of unseen prose: comprehension and plot. - Tools for unseen passage analysis: theme, setting, tone, and character. - Practice analysis using short unseen prose excerpts. Week 9–10 Introduction to Unseen Poem - Features of unseen poem: structure, imagery, and mood. - Literary devices: metaphor, personification, simile, irony, alliteration, paradox. - Practice unseen poem analysis using short modern poems. Week 11 Principles of Answering Context and Literature Questions - Interpret common exam verbs (comment, describe, contrast, examine)."},{"page":0,"class":"SSS3","subject":"Literature-In-English","term":"Second Term","text":"Week 1 Welcome Test / Revision of Last Term’s Work - Overview of Antony and Cleopatra. - Key themes, characters, and stylistic features. Week 2 Review of Shakespearean Text - Discussion on characterization, plot development, and major conflicts. - Relate moral lessons from the play to modern society. Week 3 Revision of African Prose - Study of Pede Hollist – So the Path Does Not Die and Elma Shaw – Redemption Road. - Analyse themes, characters, and narrative techniques. - Discuss social, political, and cultural contexts. Week 4 Revision of Non-African Prose - Study of Harper Lee – To Kill a Mockingbird and Susanne Bellefeuille – Path of Lucas: The Journey He Endured. - Discuss plot, characters, and moral lessons. - Analyse themes of justice, love, and endurance. Week 5 Revision of African Drama - Study of Efua Sutherland – The Marriage of Anansewa and Bosede Ademilua-Afolayan – Once Upon an Elephant. - Identify dramatic techniques and themes. - Discuss societal values reflected in both plays. Week 6 Revision of Non-African Drama - Study of Robert Bolt – A Man for All Seasons and J. D. Priestley – An Inspector Calls. - Discuss themes of justice, integrity, hypocrisy, and social responsibility. - Identify major and minor characters. Week 7 Revision of African and Non- African Poetry - Review of all selected African and Non-African poems. - Identify themes, tone, mood, and poetic devices. - Relate imagery to central ideas. Week 8 Mid-Term Break / Open Day — Week 9–14 General Revision - Comprehensive revision of all prescribed texts: Drama, Prose, and Poetry. - Focus on examination techniques, past questions, and model answers."},{"page":0,"class":"SSS3","subject":"Catering And Craft Practice","term":"First Term","text":"Week 1 Resumption Test / Revision of Last Session Work General review of previous term’s work; answering resumption test questions. Week 2 Meal Planning Meaning of meal planning; Importance of meal planning; Factors affecting meal planning. Week 3 Special Menu – Vegetarians Types of vegetarians; Reasons for vegetarianism; Planning meals for vegetarians. Week 4 Special Menu – Pregnant and Lactating Women Nutritional needs of pregnant women; Nutritional needs of lactating mothers; Guidelines for planning meals. Week 5 Special Menu – Infants and Toddlers Characteristics affecting their nutritional needs; Guidelines for planning meals for infants and toddlers. Week 6 Special Menu – Adolescents Characteristics of adolescents; Nutritional requirements of adolescents; Planning a day’s menu for adolescents. Week 7 Mid-Term Test / Open Day / Mid-Term Break --- Week 8 Special Menu – Aged / Elderly Nutritional requirements of aged and elderly; Factors influencing appetite and eating habits. Week 9 Special Menu – Manual and Sedentary Workers Differences between manual and sedentary workers; Suitable dishes for each group. Week 10 Special Menu – Diabetic and Hypertensive Patients Explanation of diabetic and hypertensive conditions; Guidelines for planning suitable meals. Week 11 Special Menu – Invalid and Convalescent Meaning of invalid and convalescent; Guidelines for planning meals; Sample menus. Week 12 Revision General revision of the term’s work. Week 13 Examination / Closing End of term examination."},{"page":0,"class":"SSS3","subject":"Catering And Craft Practice","term":"Second Term","text":"Week 1 Resumption Test / Revision Answering test questions; recalling previous knowledge relevant to new term’s work. Week 2 Housekeeping Department Meaning of housekeeping; Areas of housekeeping; Duties and responsibilities of housekeeping personnel. Week 3 Bed Making Meaning of bed; Types of bed; Bed linen; Procedures for bed making. Week 4 Practical / Project on Bed Making Demonstration and practice of bed making. Week 5 Hotel Receptionist Meaning of receptionist; Qualities of a good receptionist; Responsibilities of a receptionist. Week 6 Front Office Meaning of front office; Personnel in front office and their duties; Attributes of front office personnel; Front office activities. Week 7 Mid-Term Break --- Week 8–11 Revision of Past Questions (WAEC & NECO Focus) Practice with past examination questions; intensive revision of key topics. Week 12 Revision Final overall revision of the term’s work. Week 13 Examination / Closing End of term examination."},{"page":0,"class":"SSS3","subject":"Commerce","term":"First Term","text":"Week 1 History of the Nigerian Capital Market Origin and development of the Nigerian capital market; establishment of the Lagos Stock Exchange (1961); transformation into the Nigerian Stock Exchange; roles and importance of the Securities and Exchange Commission (SEC). Week 2 Stock Exchange Meaning and functions of stock exchange; members of the stock exchange; types of securities traded; importance of stock exchange to investors, companies, and the economy. Week 3 Second Tier Securities Market (SSM) I Meaning of SSM; objectives of establishing SSM; listing requirements for companies; role of SSM in promoting indigenous enterprises. Week 4 Second Tier Securities Market (SSM) II Procedures for dealing in SSM securities; advantages and challenges of SSM; comparison between main stock exchange and SSM. Week 5 Midterm Examination — Week 6 Economic Grouping in West Africa Meaning of economic grouping; examples—ECOWAS, WAEC, MRU; objectives of ECOWAS; achievements and challenges of economic groupings in West Africa. Week 7 Midterm Break — Week 8 Business Law Meaning and sources of business law; importance of business law in commerce; types of laws affecting business (contract law, company law, sale of goods law, agency law). Week 9 Contract of Employment and Government Regulation of Business Meaning and features of contract of employment; rights and duties of employer and employee; government regulations of business— taxes, labour laws, environmental protection, consumer protection. Week 10 Meaning of Negotiable Instrument Definition of negotiable instruments; types—cheques, bills of exchange, promissory notes; features and importance in business transactions. Week 11 Revision General revision of all topics covered in the term. Week 12 Examination — Week 13 Closing —"},{"page":0,"class":"SSS3","subject":"Marketing","term":"First Term","text":"Week 1 International Marketing • Meaning of international marketing. • Reasons for international marketing. Week 2 Importance of International Market • Importance of international market. • Difference between domestic and international marketing. Week 3 International Trade System – Import and Export Trade • Meaning of international trade. • Comparison of import and export trade. Week 4 Market Decision and Reasons – Wider Market Escape from Competition • Evaluation of reasons why businesses seek wider markets. • Escape from competition. Week 5 Midterm Examination • — Week 6 Features of International Market • Advantages and disadvantages of international market. Week 7 Midterm Break • — Week 8 Legal, Social, Cultural and Demographic Features of International Market • Highlighting the legal, social, cultural, and demographic features influencing international marketing. Week 9 Approaches to International Market • Approaches to entering international marketing. • Adaptations in international markets. Week 10 Regulations Guiding International Marketing • Rules and regulations guiding international marketing. Week 11 Information and Communication Technology (ICT) in International Marketing • Meaning of ICT. • Advantages of ICT in international marketing. • Practice of internet facilities for marketing. Week 12 Revision • General revision of the term’s work. Week 13 Examination • — 14 Closing • —"},{"page":0,"class":"SSS3","subject":"Marketing","term":"Second Term","text":"Week 1 Internet Browsing and Electronic Marketing • Meaning of e-marketing. • Advantages and disadvantages of e- marketing. • Internet ethics. Week 2 Planning for a Personal Marketing Outlet • Meaning of marketing outlet. • Sources of funds for marketing businesses. • Advantages and disadvantages of financing marketing businesses. Week 3 Identifying a Good Marketing Location and Setting up/Operating a Marketing Outlet • Identifying good marketing locations. • Steps in setting up and managing a marketing outlet. Week 4 Purchase and Supply of Goods • Role of marketing outlets in the purchase and supply of goods and services. Week 5 Selling and Bargaining Skills • Meaning of selling and bargaining skills. • Various sales and bargaining techniques. Week 6 Fund Management • Meaning of fund management. • Roles of technology in fund management. Week 7 Midterm Break • — Week 8–11 Revision • Comprehensive revision of the term’s work. 12–13 Examination • — 14 Closing • —"},{"page":0,"class":"SSS3","subject":"Economics","term":"First Term","text":"Week 1 Economics Lessons from Asian Tigers, Japan, Europe, and America (1) • Economic history of the Asian Tigers and Japan (1960–2000) Week 2 Economics Lessons from Asian Tigers, Japan, Europe, and America (2) • Review of the development strategies employed by the Asian Tigers, Japan, Europe, and America. • Lessons for the Nigerian economy. Week 3 Human Capital Development • Definition and characteristics of human capital. • Factors affecting efficiency of human capital. • Distinction between human and physical capital. • Brain drain and its effect on the Nigerian economy. • Strategies for arresting brain drain. Week 4 Petroleum and the Nigerian Economy • Development of the petroleum industry. • Contributions of petroleum to the Nigerian economy (positive and negative). • Roles of NNPC and OPEC in exploration, production, refining, marketing, and distribution of petroleum products. Week 5 Midterm Examination • — Week 6 Manufacturing and Construction • Meaning and types of manufacturing (crafts, food processing, etc.). • Meaning of construction. • Contributions of manufacturing and construction to Nigeria’s GDP. • Roles of manufacturing and construction in economic development. Week 7 Midterm Break • — Week 8 Service Industries • Meaning of services."},{"page":0,"class":"SSS3","subject":"Economics","term":"Second Term","text":"Week 1 Balance of Payments (B.O.P) I • Terms of trade and measurements. • Favorable and unfavorable balance of payment and their effects. Week 2 Balance of Payments (B.O.P) II • Concepts of balance of payment: surplus and deficit. • Methods of correcting balance of payment problems. Week 3 Economic Growth and Development • Meaning of economic development. • Distinction between economic growth and development. • Problems of economic development in Nigeria. Week 4 Economic Development Planning • Elements of development planning. • Nigeria’s planning experience. • Objectives of Nigeria’s development plans. Week 5 Midterm Examination • — Week 6 International Economic Organizations • Historical development of organizations: ECOWAS, ECA, IMF, IBRD, ADB, OPEC, WACH, GATT, UNCTAD. • Aims, objectives, and roles of the organizations. Week 7 Midterm Break • — Week 8 Current Economic Plans: MDGs, NEEDS, Vision 2020 • Meaning and objectives of MDGs, NEEDS, and Vision 2020. Week 9 Economic Development Challenges • Meaning and effects of poverty. • Methods of poverty alleviation and eradication. • Agencies for poverty alleviation (e.g., NAPEP, NDE, etc.). • HIV/AIDS and the economy. • Power and energy inadequacy. Week 10 Economic Reform Programmes • Consolidation of financial institutions."},{"page":0,"class":"SSS3","subject":"Solar Photovoltaic Installation & Maintenance","term":"First Term","text":"Week 1 Review of SS1 & SS2 Work Core concepts recap Week 2 Advanced PV Technologies Bifacial panels, solar trackers Week 3 Smart Solar Systems IoT integration, monitoring apps Week 4 Hybrid Energy Systems Combining solar with wind/diesel Week 5 Midterm Test Week 6 Energy Policies in Nigeria Rural electrification policy, renewable energy policy Week 7 Midterm Break Week 8 Climate Change & Renewable Energy Role of solar in sustainability Week 9 Environmental Impacts of PV Systems Waste, recycling, sustainability Week 10 Practical: Smart Solar Monitoring System Using IoT tools 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Solar Photovoltaic Installation & Maintenance","term":"Second Term","text":"Week 1 Preparation for SSCE Review of key topics Week 2 SSCE Past Questions – Theory Worked solutions Week 3 SSCE Past Questions – Practical Case studies Week 4 Mock Installation Project I Group practical design Week 5 Midterm Test Week 6 Mock Installation Project II Installation & commissioning Week 7 Midterm Break Week 8 Mock Installation Project III Troubleshooting & maintenance Week 9 Mock SSCE Internal exams Week 10 Exam Prep & Coaching 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Solar Photovoltaic Installation & Maintenance","term":"Third Term","text":"Week 1 Comprehensive Revision I Theory Week 2 Comprehensive Revision II Practical Week 3 Final Project Presentation Individual/group solar projects Week 4 Mock Exams Week 5 Midterm Test Week 6 Final SSCE Preparation Week 7 Midterm Break Week 8–10 WAEC/NECO Practical & Theory Exams 11–13 Closing & Graduation"},{"page":0,"class":"SSS3","subject":"Fashion Design & Garment Making","term":"First Term","text":"Week 1 Review of SS1 & SS2 Work Core concepts recap Week 2 Tailoring Business I Setting up a fashion workshop Week 3 Tailoring Business II Costing & pricing garments Week 4 Customer Relations Communication, taking orders, handling complaints Week 5 Midterm Test Week 6 Entrepreneurship in Fashion Branding, marketing, sales Week 7 Midterm Break Week 8 ICT in Fashion Online marketing, fashion software Week 9 Fashion Trends & Globalization Influences of global fashion Week 10 Practical: Business Proposal for a Fashion Line 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Fashion Design & Garment Making","term":"Second Term","text":"Week 1 Revision of Major Skills Garment construction techniques Week 2 SSCE Past Questions – Theory Worked solutions Week 3 SSCE Past Questions – Practical Garment making practice Week 4 Mock Project I Designing & cutting Week 5 Midterm Test Week 6 Mock Project II Sewing & finishing Week 7 Midterm Break Week 8 Mock Project III Final fitting & presentation Week 9 Mock SSCE Internal exams Week 10 Exam Prep & Coaching Week 11–13 Revision & Exams"},{"page":0,"class":"SSS3","subject":"Fashion Design & Garment Making","term":"Third Term","text":"Week 1 Comprehensive Revision I Theory Week 2 Comprehensive Revision II Practical Week 3 Final Project Presentation Individual/group garment collection Week 4 Mock Exams Week 5 Midterm Test Week 6 Final SSCE Preparation Week 7 Midterm Break Week 8–10 WAEC/NECO Practical & Theory Exams 11–13 Closing & Graduation"},{"page":0,"class":"SSS3","subject":"Livestock Farming","term":"First Term","text":"Week 1 Introduction to Animal Biotechnology Meaning; Importance in livestock improvement Week 2 Reproductive Technologies Artificial insemination; Embryo transfer; Cloning Week 3 Genetic Improvement Selective breeding; Hybrid vigour; Genetic modification Week 4 Animal Welfare and Ethics Animal rights; Humane treatment; Slaughtering methods Week 5 Midterm Test – Week 6 Sustainable Livestock Farming Organic livestock farming; Waste management Week 7 Midterm Break – Week 8 Livestock Business Planning Business plan preparation; Funding sources Week 9 Farm Project Development Practical steps in establishing a livestock enterprise Week 10 Entrepreneurship in Livestock Opportunities; Success stories; Challenges Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Livestock Farming","term":"Second Term","text":"Week 1 Dairy Technology I Milk production; Handling and hygiene Week 2 Dairy Technology II Milk processing into yoghurt, cheese, butter Week 3 Meat Science I Slaughtering process; Carcass dressing Week 4 Meat Science II Processing, preservation and packaging of meat Week 5 Midterm Test – Week 6 Hide and Skin Processing Tanning methods; Leather products Week 7 Midterm Break – Week 8 Egg Technology Egg preservation; Processing into products Week 9 Livestock Product Quality Control Standards; Certification; Food safety Week 10 Export of Livestock Products International markets; Trade barriers; Opportunities Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Livestock Farming","term":"Third Term","text":"Week 1 Farm Mechanization in Livestock Equipment used in housing, feeding, milking Week 2 ICT in Livestock Farming Digital tools; Record systems; Precision livestock farming Week 3 Farm Management Simulation Planning and budgeting exercises Week 4 Field Work Practical visits to livestock farms and processing plants Week 5 Midterm Test – Week 6 Project Work Students embark on supervised livestock projects Week 7 Midterm Break – Week 8 Presentation of Projects Class presentations of findings and experiences Week 9 Career Opportunities in Livestock Extension officer, veterinary services, agribusiness, processing Week 10 Final Preparations for External Exams WAEC/NECO syllabus revision Week 11 General Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Beauty And Cosmetology","term":"First Term","text":"Week 1 Revision of SS1 & SS2 Work General review of key concepts Week 2 Professional Makeup Artistry I Portfolio building; Signature styles Week 3 Professional Makeup Artistry II High fashion, photography and editorial makeup Week 4 Bridal and Event Management in Beauty Coordinating bridal looks; Event styling Week 5 Midterm Test – Week 6 Cosmetology Entrepreneurship Project I Proposal writing; Market survey Week 7 Midterm Break – Week 8 Cosmetology Entrepreneurship Project II Practical product creation Week 9 Presentation of Projects Group and individual presentations Week 10 Client Care and Psychology Communication, counselling, client satisfaction Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Beauty And Cosmetology","term":"Second Term","text":"Week 1 Advanced Spa Services Body scrubs, wraps, holistic therapies Week 2 Global Beauty Standards Cultural perceptions of beauty; Diversity Week 3 Cosmetic Chemistry II Preservation, fragrance, safety testing Week 4 Health and Safety Regulations Salon hygiene; Government regulations Week 5 Midterm Test – Week 6 Digital Marketing for Beauty Business Social media branding; Online booking systems Week 7 Midterm Break – Week 8 Job Opportunities in Beauty Industry Makeup artist, cosmetologist, skincare consultant, nail technician Week 9 Career Preparation CV writing; Interview skills; Freelancing Week 10 WAEC/NECO Cosmetology Syllabus Revision Intensive preparation Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Beauty And Cosmetology","term":"Third Term","text":"Week 1 Practical Sessions Makeup, hair, nail and skin care practicals Week 2 Field Work Visit to beauty salons, spas, cosmetic industries Week 3 Independent Project Work Students run supervised beauty mini-business Week 4 Report Writing Documenting project experiences Week 5 Midterm Test – Week 6 Mock Examination – Week 7 Midterm Break – Week 8 Final Revision Past questions practice Week 9 WAEC/NECO Examinations – Week 10 Graduation Preparation – 11–13 Exams/Closing –"},{"page":0,"class":"SSS3","subject":"Computer Hardware And Gsm Repairs","term":"First Term","text":"Week 1 Review of SS2 Work Q&A, recap Week 2 Advanced Diagnostic Tools Oscilloscope, DC power supply, software tools Week 3 GSM Schematic Diagrams Reading and interpretation Week 4 Micro Soldering Techniques IC replacement, jumper techniques Week 5 Midterm Examination – Week 6 Advanced Computer Networking IP addressing, cabling, wireless setup Week 7 Midterm Break – Week 8 Repair Case Studies Real-life GSM/computer repair scenarios Week 9 Professional Ethics in ICT Repairs Customer service, safety, data privacy Week 10 ICT Career Opportunities Certification pathways (CompTIA, Cisco, GSM training) Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Computer Hardware And Gsm Repairs","term":"Second Term","text":"Week 1 GSM Advanced Repairs Water-damaged phones, motherboard faults Week 2 Smartphone Technology Android vs iOS architecture Week 3 Advanced Computer Maintenance Server maintenance, virtualization basics Week 4 Entrepreneurship in ICT Costing, pricing, business plan Week 5 Midterm Examination – Week 6 E-Waste Management Recycling, safe disposal of ICT waste Week 7 Midterm Break – Week 8 ICT Business Marketing Branding, digital marketing, customer retention Week 9 Financial Management Record keeping, profit analysis Week 10 Project Planning Preparing for final year project Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Computer Hardware And Gsm Repairs","term":"Third Term","text":"Week 1 Final Year Project Supervision Proposal writing, approval Week 2 Project Execution Hardware or GSM repair projects Week 3 Project Execution II Practical demonstration Week 4 Project Report Writing Documentation, diagrams, analysis Week 5 Midterm Examination – Week 6 Presentation Skills Oral defense, use of slides Week 7 Midterm Break – Week 8 Mock Exams Past WAEC/NECO ICT-related papers Week 9 Revision of Practical Works Hands-on review Week 10 WAEC/NECO Preparatory Classes Key areas likely to appear Week 11 Revision – Week 12 Examination – Week 13 Closing/Graduation –"},{"page":0,"class":"SSS3","subject":"Horticulture And Crop Production","term":"First Term","text":"Week 1 Review of SS1–SS2 Work Questions and answers Week 2 Advanced Greenhouse Technology Climate control, fertigation Week 3 Hydroponics Meaning, types, advantages Week 4 Aeroponics Meaning, method, advantages Week 5 Midterm Examination – Week 6 Aquaponics Integration of fish and crop production Week 7 Midterm Break – Week 8 Precision Agriculture ICT tools, drones, sensors Week 9 Climate Change and Crop Production Adaptation strategies Week 10 Sustainable Horticultural Practices Organic farming, permaculture Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Horticulture And Crop Production","term":"Second Term","text":"Week 1 Export Crops in Nigeria Cocoa, cashew, kola nut Week 2 Global Trends in Horticulture Organic certification, agribusiness Week 3 Agribusiness Opportunities Value chain in horticulture Week 4 Farm Management Planning, budgeting, record keeping Week 5 Midterm Examination – Week 6 Agricultural Finance Sources of credit, challenges Week 7 Midterm Break – Week 8 Agricultural Policies in Nigeria Government programmes and impacts Week 9 Agricultural Marketing Boards Functions, roles, limitations Week 10 Project Planning Preparing for final project Week 11 Revision – Week 12 Examination – Week 13 Closing –"},{"page":0,"class":"SSS3","subject":"Horticulture And Crop Production","term":"Third Term","text":"Week 1 Final Year Project Supervision Proposal writing Week 2 Project Execution Practical crop/horticultural projects Week 3 Project Execution II Field work and demonstrations Week 4 Project Report Writing Documentation and analysis Week 5 Midterm Examination – Week 6 Presentation Skills Oral defense, ICT use Week 7 Midterm Break – Week 8 Mock Exams Past WAEC/NECO agriculture papers Week 9 Review of Practical Sessions Hands-on revision Week 10 WAEC/NECO Preparatory Classes Likely examination topics Week 11 Revision – Week 12 Examination – Week 13 Closing/Graduation –"}];
 const norm=v=>String(v||'').toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'');
 const existing=Array.isArray(window.sclPages)?window.sclPages:[];
 const covered=new Set(existing.map(x=>norm(x.class)+'|'+norm(x.subject)+'|'+norm(x.term)));
 const additions=incoming.filter(x=>!covered.has(norm(x.class)+'|'+norm(x.subject)+'|'+norm(x.term)));
 window.sclPages=existing.concat(additions);
 window.sclCurriculumIntegration={existing:existing.length,added:additions.length,total:window.sclPages.length};
})();
</script>
<script id="scl-early-primary-curriculum-integration">
(function(){
  const incoming=[{"page":5000,"class":"CRECHE","subject":"Sensory Exploration & Tactile Play","term":"First Term","text":"Weeks 1–4 — Exploring soft, rough, and smooth textures using fabric patches; visual tracking with high-contrast color cards; sound localization with soft rattles."},{"page":5001,"class":"CRECHE","subject":"Gross Motor Development","term":"First Term","text":"Weeks 5–8 — Supervised tummy time; encouraging crawling towards objects; unassisted sitting exercises; pulling up to stand with support."},{"page":5002,"class":"CRECHE","subject":"Social Bonding & Personal Hygiene","term":"First Term","text":"Weeks 9–12 — Eye contact games; responding to caregiver voices; babbling exercises; routine diapering and hand-wiping hygiene habits."},{"page":5003,"class":"CRECHE","subject":"Hand-Eye Coordination & Dexterity","term":"Second Term","text":"Weeks 1–6 — Grasping and releasing objects; stacking large soft foam blocks; finger-feeding with healthy snacks; holding dual-handled cups."},{"page":5004,"class":"CRECHE","subject":"Vocal Expression & Body Awareness","term":"Second Term","text":"Weeks 7–12 — Identifying simple body parts (head, hands, feet, nose); mimicking single-syllable sounds (ma, da, ba); gesture communication (waving bye-bye)."},{"page":5005,"class":"CRECHE","subject":"Potty Training Readiness & Self-Care","term":"Third Term","text":"Weeks 1–6 — Identifying toilet urges; sitting on potty seats; washing hands with caregiver assistance; recognizing personal belongings."},{"page":5006,"class":"CRECHE","subject":"Rhythmic Movement & Spatial Exploration","term":"Third Term","text":"Weeks 7–12 — Clapping to musical beats; indoor obstacle walking; rolling and catching large light balls; outdoor stroller nature walks."},{"page":5007,"class":"RECEPTION","subject":"Phonics & Language Work","term":"First Term","text":"Term 1 — Auditory discrimination of environmental sounds; introduction to letter sounds /a/, /b/, /c/; phonetic picture recognition."},{"page":5008,"class":"RECEPTION","subject":"Number Work / Pre-Maths","term":"First Term","text":"Term 1 — Oral counting of numbers 1–10; identification of primary colors (Red, Yellow, Blue); matching identical shapes (Circle, Square)."},{"page":5009,"class":"RECEPTION","subject":"Social Habits & Health","term":"First Term","text":"Term 1 — Greeting adults and peers; using magic words (Please, Thank You, Sorry, Excuse Me); personal cleanliness and washing hands."},{"page":5010,"class":"RECEPTION","subject":"Pre-Writing & Fine Motor","term":"Second Term","text":"Term 2 — Crayon grip training; scribbling within bounded areas; tracing vertical and horizontal strokes; plasticine/playdough molding."},{"page":5011,"class":"RECEPTION","subject":"Elementary Science & Nature","term":"Second Term","text":"Term 2 — Exploring common domestic animals (Dog, Cat, Cow, Goat); weather identification (Sunny, Rainy); plant leaves and flowers."},{"page":5012,"class":"RECEPTION","subject":"Rhymes & Storytelling","term":"Third Term","text":"Term 3 — Reciting 15 classic nursery rhymes; picture book reading; active listening; simple recall of character names."},{"page":5013,"class":"RECEPTION","subject":"Creative Arts & Craft","term":"Third Term","text":"Term 3 — Freehand color fill; paper tearing and gluing collage; rhythmic singing and simple dance routines."},{"page":5014,"class":"NURSERY1","subject":"Literacy / Letter Work","term":"First Term","text":"Term 1 — Phonetic sounds /a/ to /z/; tracing letter shapes A–Z; sound blending of 2-letter words (at, in, on, it, am, is, my)."},{"page":5015,"class":"NURSERY1","subject":"Numeracy / Number Work","term":"First Term","text":"Term 1 — Rote counting 1–50; writing numbers 1–20; quantity association with physical counters; geometric shapes (Triangle, Rectangle)."},{"page":5016,"class":"NURSERY1","subject":"Basic Science & Health","term":"Second Term","text":"Term 2 — External body parts (eyes, ears, teeth, feet) and their functions; healthy eating vs junk foods; personal hygiene habits."},{"page":5017,"class":"NURSERY1","subject":"Civic Education & Social Habits","term":"Third Term","text":"Term 3 — Structure of the family (Father, Mother, Children); respect for teachers and elders; safety rules on the road and at home."},{"page":5018,"class":"NURSERY2","subject":"Literacy & Phonics","term":"First Term","text":"Term 1 — 3-letter CVC word building (cat, pin, pot, bed, sun); introduction to sight words (the, is, an, can, see, go); simple sentence reading."},{"page":5019,"class":"NURSERY2","subject":"Numeracy & Mathematics","term":"Second Term","text":"Term 2 — Counting numbers 1–100; writing 1–50; basic single-digit addition (+); concept of subtraction (-); comparing quantities (more/less)."},{"page":5020,"class":"NURSERY2","subject":"General Studies & Computer Studies","term":"Third Term","text":"Term 3 — Living vs non-living things; sources of water and light; identifying computer components (Monitor, Keyboard, Mouse, CPU)."},{"page":5021,"class":"PRIMARY1","subject":"English Studies","term":"First Term","text":"Terms 1 & 2 — Phonics (consonant sounds, short/long vowels); Nouns (naming words); Simple present tense; Reading simple comprehension passages."},{"page":5022,"class":"PRIMARY1","subject":"English Studies","term":"Second Term","text":"Terms 1 & 2 — Phonics (consonant sounds, short/long vowels); Nouns (naming words); Simple present tense; Reading simple comprehension passages."},{"page":5023,"class":"PRIMARY1","subject":"English Studies","term":"Third Term","text":"Term 3 — Pronouns (he, she, it, they); Punctuation (Capital letters, full stops); Guided composition: “Myself” and “My School”."},{"page":5024,"class":"PRIMARY1","subject":"Mathematics","term":"First Term","text":"Terms 1 & 2 — Counting whole numbers 1–200; Place value (TENS & UNITS); Addition and Subtraction without carrying/borrowing; Ordinal numbers."},{"page":5025,"class":"PRIMARY1","subject":"Mathematics","term":"Second Term","text":"Terms 1 & 2 — Counting whole numbers 1–200; Place value (TENS & UNITS); Addition and Subtraction without carrying/borrowing; Ordinal numbers."},{"page":5026,"class":"PRIMARY1","subject":"Mathematics","term":"Third Term","text":"Term 3 — Basic fraction concepts (1/2, 1/4); Nigerian Currency (Coins and Naira notes); 2D shapes (Circle, Square, Triangle); Days of the week."},{"page":5027,"class":"PRIMARY1","subject":"Basic Science","term":"First Term","text":"Terms 1 & 2 — Exploring immediate surroundings; Living and non-living things; Plant identification (leaves, stems); Animal classification (pets vs wild)."},{"page":5028,"class":"PRIMARY1","subject":"Basic Science","term":"Second Term","text":"Terms 1 & 2 — Exploring immediate surroundings; Living and non-living things; Plant identification (leaves, stems); Animal classification (pets vs wild)."},{"page":5029,"class":"PRIMARY1","subject":"Basic Science","term":"Third Term","text":"Term 3 — Water sources and uses; Cleanliness of water; Air around us; Observing weather changes (rainy, dry, windy days)."},{"page":5030,"class":"PRIMARY1","subject":"Basic Technology","term":"First Term","text":"Terms 1 & 2 — Simple technology around the home; Identifying simple tools (scissors, spoon, hammer, broom, key)."},{"page":5031,"class":"PRIMARY1","subject":"Basic Technology","term":"Second Term","text":"Terms 1 & 2 — Simple technology around the home; Identifying simple tools (scissors, spoon, hammer, broom, key)."},{"page":5032,"class":"PRIMARY1","subject":"Basic Technology","term":"Third Term","text":"Term 3 — Safety rules when using simple home tools; Maintenance and clean keeping of daily appliances."},{"page":5033,"class":"PRIMARY1","subject":"Information Tech (ICT)","term":"First Term","text":"Terms 1 & 2 — Meaning of computer; Identifiable parts of a computer (Monitor, System Unit, Keyboard, Mouse, Printer)."},{"page":5034,"class":"PRIMARY1","subject":"Information Tech (ICT)","term":"Second Term","text":"Terms 1 & 2 — Meaning of computer; Identifiable parts of a computer (Monitor, System Unit, Keyboard, Mouse, Printer)."},{"page":5035,"class":"PRIMARY1","subject":"Information Tech (ICT)","term":"Third Term","text":"Term 3 — Uses of computers at home and school; Turning a computer ON and OFF correctly; Computer room rules."},{"page":5036,"class":"PRIMARY1","subject":"Social Studies","term":"First Term","text":"Terms 1 & 2 — Meaning of family; Types of family (Nuclear and Extended); Duties of family members; Culture and tradition basics."},{"page":5037,"class":"PRIMARY1","subject":"Social Studies","term":"Second Term","text":"Terms 1 & 2 — Meaning of family; Types of family (Nuclear and Extended); Duties of family members; Culture and tradition basics."},{"page":5038,"class":"PRIMARY1","subject":"Social Studies","term":"Third Term","text":"Term 3 — Food, clothes, and housing in our locality; Good manners and respect for elders; Cleanliness of the surroundings."},{"page":5039,"class":"PRIMARY1","subject":"Civic Education","term":"First Term","text":"Terms 1 & 2 — Meaning of Civic Education; National symbols (National Flag, Anthem, Pledge, Coat of Arms); Respecting national symbols."},{"page":5040,"class":"PRIMARY1","subject":"Civic Education","term":"Second Term","text":"Terms 1 & 2 — Meaning of Civic Education; National symbols (National Flag, Anthem, Pledge, Coat of Arms); Respecting national symbols."},{"page":5041,"class":"PRIMARY1","subject":"Civic Education","term":"Third Term","text":"Term 3 — Democratic values: Honesty, Obedience, Co-operation, and Truthfulness; Rights of a child."},{"page":5042,"class":"PRIMARY1","subject":"Security Education","term":"First Term","text":"Terms 1 & 2 — Meaning of security; Identifying strange persons; Reporting suspicious movements; Safety at home and school."},{"page":5043,"class":"PRIMARY1","subject":"Security Education","term":"Second Term","text":"Terms 1 & 2 — Meaning of security; Identifying strange persons; Reporting suspicious movements; Safety at home and school."},{"page":5044,"class":"PRIMARY1","subject":"Security Education","term":"Third Term","text":"Term 3 — Sources of danger (fire, sharp objects, electricity, stranger danger); Emergency contact procedures."},{"page":5045,"class":"PRIMARY1","subject":"Cultural & Creative Arts","term":"First Term","text":"Terms 1 & 2 — Introduction to Arts; Basic colors (Primary colors); Drawing and coloring simple objects; Singing national and local songs."},{"page":5046,"class":"PRIMARY1","subject":"Cultural & Creative Arts","term":"Second Term","text":"Terms 1 & 2 — Introduction to Arts; Basic colors (Primary colors); Drawing and coloring simple objects; Singing national and local songs."},{"page":5047,"class":"PRIMARY1","subject":"Cultural & Creative Arts","term":"Third Term","text":"Term 3 — Craft work: Paper folding (origami), modeling with clay/plasticine; Traditional dances and rhythms."},{"page":5048,"class":"PRIMARY1","subject":"Physical & Health Ed.","term":"First Term","text":"Terms 1 & 2 — Basic movement patterns (walking, running, leaping, hopping); Personal hygiene (bathing, teeth cleaning, nail trimming)."},{"page":5049,"class":"PRIMARY1","subject":"Physical & Health Ed.","term":"Second Term","text":"Terms 1 & 2 — Basic movement patterns (walking, running, leaping, hopping); Personal hygiene (bathing, teeth cleaning, nail trimming)."},{"page":5050,"class":"PRIMARY1","subject":"Physical & Health Ed.","term":"Third Term","text":"Term 3 — Simple athletic games; Food and nutrition for growth; Sleep, rest, and posture habits."},{"page":5051,"class":"PRIMARY1","subject":"Nigerian History","term":"First Term","text":"Terms 1 & 2 — Who is an ancestor? History of our immediate community; Local heroes and heroines in our town/state."},{"page":5052,"class":"PRIMARY1","subject":"Nigerian History","term":"Second Term","text":"Terms 1 & 2 — Who is an ancestor? History of our immediate community; Local heroes and heroines in our town/state."},{"page":5053,"class":"PRIMARY1","subject":"Nigerian History","term":"Third Term","text":"Term 3 — Historical monuments and traditional festivals in Nigeria; Respecting historical artifacts."},{"page":5054,"class":"PRIMARY1","subject":"Religious Studies","term":"First Term","text":"Terms 1 & 2 — CRS: God as the creator of all things; Creation story. / IS: Allah the creator; Kalimatush-Shahadah basics."},{"page":5055,"class":"PRIMARY1","subject":"Religious Studies","term":"Second Term","text":"Terms 1 & 2 — CRS: God as the creator of all things; Creation story. / IS: Allah the creator; Kalimatush-Shahadah basics."},{"page":5056,"class":"PRIMARY1","subject":"Religious Studies","term":"Third Term","text":"Term 3 — CRS: Jesus as the son of God; Obedience to parents. / IS: Islamic morals; Suratul Fatiha recitation."},{"page":5057,"class":"PRIMARY2","subject":"English Studies","term":"First Term","text":"Terms 1 & 2 — Phonics (vowels, diphthongs); Plural forms of nouns (-s, -es, irregular); Verbs (action words); Antonyms and Synonyms; Reading comprehension."},{"page":5058,"class":"PRIMARY2","subject":"English Studies","term":"Second Term","text":"Terms 1 & 2 — Phonics (vowels, diphthongs); Plural forms of nouns (-s, -es, irregular); Verbs (action words); Antonyms and Synonyms; Reading comprehension."},{"page":5059,"class":"PRIMARY2","subject":"English Studies","term":"Third Term","text":"Term 3 — Adjectives (describing words); Prepositions (in, on, under, behind); Simple past tense; Descriptive essay writing."},{"page":5060,"class":"PRIMARY2","subject":"Mathematics","term":"First Term","text":"Terms 1 & 2 — Whole numbers 1–500; Place value (HUNDREDS, TENS, UNITS); Addition and Subtraction with regrouping; Multiplication as repeated addition."},{"page":5061,"class":"PRIMARY2","subject":"Mathematics","term":"Second Term","text":"Terms 1 & 2 — Whole numbers 1–500; Place value (HUNDREDS, TENS, UNITS); Addition and Subtraction with regrouping; Multiplication as repeated addition."},{"page":506