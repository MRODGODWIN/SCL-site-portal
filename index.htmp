}
</style>
<script id="scl-v93-timetable-today-sync">
(function(){
  function sync(){
    var day=new Date().toLocaleString('en-US',{timeZone:'Africa/Lagos',weekday:'long'});
    var map={Monday:'monday',Tuesday:'tuesday',Wednesday:'wednesday',Thursday:'thursday',Friday:'friday'};
    document.querySelectorAll('.scl-v93-one-table .scl-tt-day-head').forEach(function(h){
      var key=[...h.classList].find(function(c){return /^scl-tt-day-(monday|tuesday|wednesday|thursday|friday)$/.test(c)});
      var active=key&&key.endsWith(String(map[day]||'__none'));
      h.classList.toggle('scl-tt-today',!!active);
      h.querySelector('.scl-tt-today-badge')?.remove();
      if(active){var b=document.createElement('b');b.className='scl-tt-today-badge';b.textContent='TODAY';h.appendChild(b)}
    });
    document.querySelectorAll('.scl-v93-one-table .scl-tt-day-cell').forEach(function(c){
      var active=map[day]&&c.classList.contains(map[day]);c.classList.toggle('scl-tt-today',!!active);
    });
  }
  sync();setInterval(sync,60000);
})();
</script>
<style id="scl-v93-one-table-mobile-final">
/* Final mobile reset: keep V93 as one real HTML table instead of the older card transformation. */
@media(max-width:600px){
  .scl-v93-one-table.scl-v89-duration-timetable{display:table!important;width:100%!important;min-width:0!important;max-width:100%!important;table-layout:fixed!important}
  .scl-v93-one-table.scl-v89-duration-timetable colgroup{display:table-column-group!important}
  .scl-v93-one-table.scl-v89-duration-timetable col{display:table-column!important}
  .scl-v93-one-table.scl-v89-duration-timetable thead{display:table-header-group!important}
  .scl-v93-one-table.scl-v89-duration-timetable tbody{display:table-row-group!important;width:auto!important;overflow:visible!important;padding:0!important;gap:0!important}
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr{display:table-row!important;width:auto!important;min-width:0!important;max-width:none!important;background:transparent!important;border:0!important;border-radius:0!important;overflow:visible!important;box-shadow:none!important;scroll-snap-align:none!important}
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr>th,
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr>td{display:table-cell!important;width:auto!important;min-width:0!important;box-sizing:border-box!important}
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr>td.scl-tt-period-t1,
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr>td.scl-tt-period-t2,
  .scl-v93-one-table.scl-v89-duration-timetable tbody tr>td.scl-tt-period-t3{display:table-cell!important}
}
</style>
<script id="scl-v94-fee-source-lock-and-timetable-colours">
(function(){
'use strict';
/* The supplied official fee image is the authoritative 2026/2027 base schedule. */
const OFFICIAL_2026_2027={
'Daycare':[25000,5000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,5000],
'Nursery 1':[25000,5000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,5000],
'Nursery 2':[27000,5000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,6000],
'Reception':[27000,5000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,6000],
'Primary 1':[29000,6000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,6000],
'Primary 2':[30000,6000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,6000],
'Primary 3':[32000,6000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,6000],
'Primary 4':[34000,6000,10000,6000,18000,10000,null,6000,1000,3000,7000,2000,2000,7000],
'Primary 5':[36000,6000,10000,6000,18000,10000,null,6000,1000,3500,7000,2000,2000,7000],
'JSS 1':[50000,7000,10000,8000,23000,10000,null,8000,1000,3500,7000,4000,3000,10800],
'JSS 2':[55000,7000,10000,8000,23000,10000,null,8000,1000,3500,7000,4000,3000,10800],
'JSS 3':[60000,7000,10000,8000,23000,10000,null,8000,1000,3500,7000,4000,3000,10800],
'SSS 1':[65000,6000,10000,8000,28000,10000,null,8000,1000,3500,7000,4000,3000,7200],
'SSS 2':[70000,7000,10000,9000,28000,10000,null,8000,1000,3500,7000,4000,3000,7200],
'SSS 3':[75000,8000,10000,10000,28000,10000,null,8000,1000,3500,7000,4000,3000,7000]
};
window.SCL_OFFICIAL_FEE_SCHEDULE_2026_2027=OFFICIAL_2026_2027;
try{FEE_SCHEDULES=JSON.parse(JSON.stringify(OFFICIAL_2026_2027))}catch(_){}
function classRole(){const a=(()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}})();const roles=(a?.roles||[]).map(x=>String(x).toLowerCase());return !!(a?.staff||a?.student||roles.some(r=>/^(developer|technical_admin|management_admin|affairs_admin|teacher|staff|worker|student)$/.test(r)))}
function applyTimetableClassColour(){
 const root=document.getElementById('sclSmartTimetable');if(!root)return;
 const cls=(root.querySelector('#classPick')?.value||root.querySelector('.class-badge')?.textContent||'').trim();
 const c=window.sclClassColor?.(cls);if(!c)return;
 root.querySelectorAll('.class-badge').forEach(function(el){el.style.background=c;el.style.borderColor=c;el.style.color='#fff';el.style.boxShadow='0 5px 14px rgba(0,0,0,.14)';});
}
function install(){
 const root=document.getElementById('sclSmartTimetable');if(root&&!root.__sclV94Observer){root.__sclV94Observer=new MutationObserver(applyTimetableClassColour);root.__sclV94Observer.observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['value']});applyTimetableClassColour()}
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install);else install();
window.addEventListener('load',install,{once:true});
})();
</script>
<script id="scl-v94-official-total-and-payment-details">
(function(){
'use strict';
const OFFICIAL_TOTALS={'Daycare':100000,'Nursery 1':100000,'Nursery 2':103000,'Reception':103000,'Primary 1':106000,'Primary 2':107000,'Primary 3':109000,'Primary 4':112000,'Primary 5':116500,'JSS 1':145300,'JSS 2':150300,'JSS 3':155300,'SSS 1':160700,'SSS 2':167700,'SSS 3':174500};
const oldTotal=window.calculateFeeTotal;
window.calculateFeeTotal=function(cls,session,term){
  const s=session||sessionLabel(),t=term||selectedTerm||currentTerm();
  if(String(s)==='2026/2027'&&Object.prototype.hasOwnProperty.call(OFFICIAL_TOTALS,cls))return OFFICIAL_TOTALS[cls];
  return typeof oldTotal==='function'?oldTotal(cls,s,t):0;
};
try{SCL_FEE_BASE_TOTALS=OFFICIAL_TOTALS}catch(_){}
/* The supplied fee sheet shows the payment platform as OPay / Moniepoint and the same account details. */
try{
  Object.keys(SCL_PAYMENT_ACCOUNTS||{}).forEach(function(k){SCL_PAYMENT_ACCOUNTS[k].bank='OPay / Moniepoint';});
  SCHOOL_BANK='OPay / Moniepoint';
}catch(_){}
})();
</script>
<style id="scl-v94-payment-class-detail-css">
#pay .mh h3.scl-coloured-payment-title{display:inline-block;padding:5px 9px;border-radius:10px;border:2px solid var(--class-color,#650007);background:var(--class-bg,#fff);color:var(--class-text,#241b17)!important}
.scl-bulk-class-band{margin:0 0 10px;padding:9px 11px;border-radius:12px;border:2px solid var(--class-color,#650007);background:var(--class-bg,#fff);font-weight:950;color:var(--class-text,#241b17)}
</style>
<script id="scl-v94-payment-class-detail-script">
(function(){
'use strict';
function classFor(){try{return String(selectedClass||'')}catch(_){return ''}}
function apply(){const cls=classFor(),c=window.sclClassColor?.(cls)||'#650007';const title=document.getElementById('payTitle');if(title){title.classList.add('scl-coloured-payment-title');title.style.setProperty('--class-color',c);title.style.setProperty('--class-bg',window.sclClassColourVars?'rgba(255,255,255,.96)':'#fff');title.style.setProperty('--class-text','#241b17')}const bulk=document.querySelector('#bulkPay .form');if(bulk&&cls){let b=bulk.querySelector('.scl-bulk-class-band');if(!b){b=document.createElement('div');b.className='scl-bulk-class-band';bulk.insertBefore(b,bulk.firstChild)}b.style.setProperty('--class-color',c);b.style.setProperty('--class-bg','rgba(255,255,255,.96)');b.style.setProperty('--class-text','#241b17');b.textContent='CLASS: '+cls}}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',apply);else apply();
setInterval(apply,700);
})();
</script>
<style id="scl-v96-access-timetable-hardening-css">
/* V96: one clear access model and visible timetable conflict feedback. */
.scl-v96-access-note{margin:10px 0;padding:10px 12px;border-radius:11px;background:#f7fbff;border:1px solid #bfd3ea;color:#203b57;font-size:12px;line-height:1.45}
.scl-v96-conflict{outline:3px solid #d32f2f!important;background:#fff0f0!important;color:#7b0000!important}
.scl-v96-conflict-note{display:block;margin-top:4px;padding:5px 7px;border-radius:7px;background:#fff0f0;color:#8b0000;font-size:10px;font-weight:900;line-height:1.2}
</style>
<!-- SCL FINAL CLEANUP / SETTINGS / NAVIGATION STABILITY -->
<style id="scl-final-cleanup-v96">
/* Keep one visible theme control: settings. The old floating control is intentionally hidden. */
#sclThemeToggle{display:none!important}
/* Settings modal */
#sclSettingsModal{position:fixed;inset:0;z-index:10080;background:rgba(20,0,3,.72);backdrop-filter:blur(7px);display:none;align-items:center;justify-content:center;padding:14px 14px 84px}
#sclSettingsModal.open{display:flex}
#sclSettingsModal .scl-settings-card{width:min(920px,100%);max-height:calc(100vh - 105px);overflow:auto;background:#fffdf8;border:2px solid #ead5b6;border-radius:22px;box-shadow:0 30px 100px rgba(0,0,0,.35)}
.scl-settings-head{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 18px;background:linear-gradient(135deg,#650007,#8a0710);color:#fff}
.scl-settings-head h3{margin:0;font-size:18px}.scl-settings-head small{display:block;margin-top:3px;opacity:.86}
.scl-settings-close{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:8px 11px;font-weight:900;cursor:pointer}
.scl-settings-body{padding:15px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.scl-settings-section{background:#fff;border:1px solid #ead5b6;border-radius:16px;padding:13px;box-shadow:0 5px 18px rgba(101,0,7,.05)}
.scl-settings-section.full{grid-column:1/-1}.scl-settings-section h4{margin:0 0 5px;color:#650007;font-size:14px}.scl-settings-section>p{margin:0 0 10px;color:#665a52;font-size:11px;line-height:1.4}
.scl-setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid #f0e7dc}.scl-setting-row:first-of-type{border-top:0}.scl-setting-row b{font-size:12px;color:#342927}.scl-setting-row small{display:block;color:#776b63;font-size:10px;margin-top:2px;line-height:1.35}
.scl-setting-btn{border:1px solid #cda85e;background:#fff8df;color:#650007;border-radius:10px;padding:8px 11px;font-weight:900;cursor:pointer;white-space:nowrap}
.scl-setting-btn.primary{background:#650007;color:#fff;border-color:#650007}.scl-setting-btn.green{background:#126b3a;color:#fff;border-color:#126b3a}
.scl-setting-switch{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:900;color:#4b403a;cursor:pointer}.scl-setting-switch input{accent-color:#650007}
.scl-settings-note{padding:10px 11px;border-radius:11px;background:#fff8df;border:1px solid #ead5b6;color:#5b4d42;font-size:11px;line-height:1.4}
.scl-settings-status{margin-top:8px;font-size:11px;font-weight:800;color:#126b3a;min-height:15px}
@media(max-width:700px){#sclSettingsModal{padding:8px 8px 74px}.scl-settings-body{grid-template-columns:1fr;padding:10px}.scl-settings-section.full{grid-column:auto}.scl-settings-card{max-height:calc(100vh - 82px)!important}.scl-setting-row{align-items:flex-start}.scl-setting-btn{padding:8px 9px}}
</style>
<style id="scl-final-reduced-motion">.scl-reduce-motion *, .scl-reduce-motion *::before, .scl-reduce-motion *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}</style>
<style id="scl-v98-payment-clean-css">
#picker.scl-picker-payment .options{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;padding:10px!important}
#picker.scl-picker-payment .options .scl-v98-class-btn{display:block!important;width:100%!important;min-height:76px!important;padding:15px 14px!important;border:2px solid #caa95f!important;border-left:9px solid var(--scl-class,#650007)!important;border-radius:15px!important;background:linear-gradient(90deg,var(--scl-bg,#fff5dc),#fff)!important;color:#4d080d!important;text-align:left!important;font-size:15px!important;font-weight:950!important;cursor:pointer!important;box-shadow:0 4px 12px rgba(0,0,0,.06)!important}
#picker.scl-picker-payment .options .scl-v98-class-btn:active{transform:scale(.99)!important}
#sclV98PaymentGate{margin:0 0 12px;padding:12px;border:1px solid #e1c98e;border-radius:13px;background:#fffaf0}
.scl-v98-mode-switch{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0 12px}
.scl-v98-mode-switch button{border:1px solid #caa95f;border-radius:10px;background:#fff;color:#650007;padding:9px 7px;font-weight:900;font-size:11px;cursor:pointer}
.scl-v98-mode-switch button.active{background:#650007;color:#fff}
.scl-v98-status{margin:8px 0;padding:9px 10px;border-radius:10px;font-size:11px;line-height:1.4;border:1px solid #ddd}
.scl-v98-status.pending{background:#fff8df;color:#765500;border-color:#e6cb76}.scl-v98-status.paid{background:#eaf8ef;color:#116b3b;border-color:#8bc9a5}.scl-v98-status.unpaid{background:#fff1f1;color:#8b1018;border-color:#e1a0a5}
.scl-v98-paybox{border:2px solid #ead5b6;border-radius:14px;padding:12px;margin:10px 0;background:#fffdf8}
