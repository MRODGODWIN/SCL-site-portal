.scl-tt-teacher-day>span{display:block;overflow-wrap:anywhere}
.scl-tt-teacher-day.monday>b{color:#3978d4}.scl-tt-teacher-day.tuesday>b{color:#269a68}.scl-tt-teacher-day.wednesday>b{color:#8057c7}.scl-tt-teacher-day.thursday>b{color:#d47a25}.scl-tt-teacher-day.friday>b{color:#168a9b}
.scl-tt-teacher-day.today{outline:2px solid #ffd34e;outline-offset:1px}
