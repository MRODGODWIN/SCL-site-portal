#sclDirectPaymentRoot .scl-dp-card{width:min(980px,100%);max-height:calc(100vh - 28px);overflow:auto;background:#fffdf8;border:3px solid #caa95f;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.35);font-family:inherit}
#sclDirectPaymentRoot .scl-dp-head{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 15px;background:#650007;color:#fff;border-bottom:2px solid #caa95f}
#sclDirectPaymentRoot .scl-dp-head h2{margin:0;font-size:18px}
#sclDirectPaymentRoot .scl-dp-close{border:0;background:#fff;color:#650007;width:38px;height:38px;border-radius:50%;font-size:24px;font-weight:900;cursor:pointer}
#sclDirectPaymentRoot .scl-dp-body{padding:14px}
#sclDirectPaymentRoot .scl-dp-note{padding:11px 12px;border:1px solid #dfcda8;border-radius:12px;background:#fff7df;color:#4b3b2e;font-size:12px;line-height:1.5;margin-bottom:12px}
#sclDirectPaymentRoot .scl-dp-modes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
