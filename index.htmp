],STUDENT=[{"id": 1, "img": "emperor-empress", "name": "Emperor &amp; Empress", "group": "The Royal Court &middot; Ceremonial Pathway", "scope": "School-wide &middot; Ceremonial", "criteria": "Reserved for the most outstanding all-round student(s) in the school \u2014 top academic, moral, and leadership record. Must also be beautiful or attractive in appearance and presence, and able to generate funds or bring in people who can help attract investment into the school.", "steps": "Rise through the Royal Court tiers, maintain flawless conduct, and be nominated by staff and endorsed by the Senior Prefect body.", "purpose": "The highest ceremonial honour in the school \u2014 represents excellence, unity, and the standard every other rank looks up to.", "motivation": "Wear the crown with humility. Lead by example."}, {"id": 2, "img": "junior-king-queen", "name": "Junior King &amp; Queen", "group": "The Royal Court &middot; Ceremonial Pathway", "scope": "School-wide &middot; Ceremonial", "criteria": "Awarded to students who consistently excel and show strong leadership potential, one tier below Emperor/Empress. Must also be beautiful or attractive in appearance and presence, and able to generate funds or bring in people who can help attract investment into the school.", "steps": "Build a record of discipline, academic consistency, and peer respect; recommended by class teachers and form supervisors.", "purpose": "Grooms the next generation of ceremonial leadership and keeps the Royal Court pathway aspirational.", "motivation": "Every crown starts with consistency."}, {"id": 3, "img": "crown-prince-princess", "name": "Crown Prince &amp; Princess", "group": "The Royal Court &middot; Ceremonial Pathway", "scope": "School-wide &middot; Ceremonial", "criteria": "For students showing exceptional promise \u2014 strong academics plus visible leadership qualities among peers. Must also be beautiful or attractive in appearance and presence, and able to generate funds or bring in people who can help attract investment into the school.", "steps": "Demonstrate reliability in class duties, active participation, and good standing with staff over a full term.", "purpose": "The entry point into the Royal Court \u2014 recognises rising leaders early.", "motivation": "Today's promise is tomorrow's crown."}, {"id": 4, "img": "main-senior-prefect", "name": "Main Senior Prefect / President", "group": "Executive Senior Prefects", "scope": "School-wide &middot; Executive", "criteria": "The most senior elected student leader \u2014 head of the school's entire executive prefect body.", "steps": "Serve in a departmental or class leadership role first, then contest or be appointed through the school's prefect selection process.", "purpose": "Heads the student leadership structure and represents the student body to staff and management.", "motivation": "Leadership is service \u2014 carry the school on your shoulders."}, {"id": 5, "img": "senior-prefect-vp", "name": "Senior Prefect Vice President", "group": "Executive Senior Prefects", "scope": "School-wide &middot; Executive", "criteria": "Second-in-command of the executive body \u2014 strong organisational and mediation skills required.", "steps": "Support the Main Senior Prefect, deputise in their absence, and show readiness to lead departmental prefects.", "purpose": "Ensures continuity of leadership and backs up the President in all executive duties.", "motivation": "Every great leader needs a steady second."}, {"id": 6, "img": "sports-prefect", "name": "Sports Prefect", "group": "Departmental Senior Prefects", "scope": "School-wide &middot; Departmental", "criteria": "Awarded to a student with strong sporting discipline and the ability to organise fellow students during games and PE.", "steps": "Show consistent participation in sports, fair play, and help coordinate house/inter-class sporting activities.", "purpose": "Coordinates sports activities, equipment, and team discipline across the school.", "motivation": "Discipline on the field builds discipline for life."}, {"id": 7, "img": "discipline-prefect", "name": "Discipline Prefect", "group": "Departmental Senior Prefects", "scope": "School-wide &middot; Departmental", "criteria": "For students with an impeccable conduct record and the maturity to help enforce school rules fairly.", "steps": "Maintain a clean disciplinary record, show fairness in past monitor duties, and earn staff trust.", "purpose": "Helps uphold order, fairness, and the school's code of conduct among students.", "motivation": "True authority is earned through fairness."}, {"id": 8, "img": "academic-prefect", "name": "Academic Prefect", "group": "Departmental Senior Prefects", "scope": "School-wide &middot; Departmental", "criteria": "Awarded for strong academic performance combined with a willingness to support classmates' learning.", "steps": "Maintain consistently high grades and actively help organise study groups, assignments, or reading initiatives.", "purpose": "Champions academic culture and supports teachers with class learning activities.", "motivation": "Knowledge shared is knowledge multiplied."}, {"id": 9, "img": "health-sanitation-prefect", "name": "Health &amp; Sanitation Prefect", "group": "Departmental Senior Prefects", "scope": "School-wide &middot; Departmental", "criteria": "For students who show consistent hygiene awareness and care for the school's cleanliness and wellbeing standards.", "steps": "Take initiative in cleanliness drives, report health/safety concerns, and set a personal hygiene example.", "purpose": "Oversees sanitation standards and basic health awareness across the school compound.", "motivation": "A clean school starts with one committed leader."}, {"id": 10, "img": "timekeeper-prefect", "name": "Timekeeper Prefect", "group": "SSS1 Exclusive &amp; Universal Classroom Leaders", "scope": "SSS1 Only", "criteria": "An SSS1-exclusive role for a dependable student trusted to manage class time and routine keeping.", "steps": "Show punctuality and reliability early in SSS1; nominated by the form teacher for the role.", "purpose": "Keeps track of class schedules, timing, and routine order specific to the SSS1 level.", "motivation": "Small responsibilities build big leaders."}, {"id": 11, "img": "class-captain", "name": "Class Captain", "group": "SSS1 Exclusive &amp; Universal Classroom Leaders", "scope": "All Classes &middot; Universal", "criteria": "Chosen by classmates and teachers as the most reliable, respected student in a classroom.", "steps": "Show consistent good conduct and be voted or appointed as the class representative.", "purpose": "Represents the class in school matters and keeps order when a teacher is absent.", "motivation": "A captain steadies the class, one day at a time."}, {"id": 12, "img": "assistant-class-captain", "name": "Assistant Class Captain", "group": "SSS1 Exclusive &amp; Universal Classroom Leaders", "scope": "All Classes &middot; Universal", "criteria": "Supports the Class Captain \u2014 the next most trusted and dependable student in the class.", "steps": "Assist the Class Captain in daily duties and be ready to step in whenever needed.", "purpose": "Backs up the Class Captain and shares classroom leadership responsibilities.", "motivation": "Great support makes great leadership possible."}, {"id": 13, "img": "head-boy-governor", "name": "Head Boy / Governor", "group": "Junior Secondary (JSS3 Only) &mdash; Governors", "scope": "JSS3 Only", "criteria": "The top male student leader of the Junior Secondary section \u2014 proven leadership across JSS1&ndash;JSS3.", "steps": "Rise through class and departmental leadership roles in Junior Secondary, then be selected for the Governor role in JSS3.", "purpose": "Leads and represents the entire Junior Secondary male student body.", "motivation": "Govern with fairness. Lead with heart."}, {"id": 14, "img": "head-girl-deputy-governor", "name": "Head Girl / Deputy Governor", "group": "Junior Secondary (JSS3 Only) &mdash; Governors", "scope": "JSS3 Only", "criteria": "The top female student leader of the Junior Secondary section \u2014 proven leadership across JSS1&ndash;JSS3.", "steps": "Rise through class and departmental leadership roles in Junior Secondary, then be selected for the Deputy Governor role in JSS3.", "purpose": "Leads and represents the entire Junior Secondary female student body, supporting the Governor.", "motivation": "Govern with fairness. Lead with heart."}, {"id": 15, "img": "head-boy-primary", "name": "Head Boy", "group": "Primary Section (Basic 4 &amp; 5 Only)", "scope": "Basic 4 &amp; 5 Only", "criteria": "The top male student leader of the Primary section \u2014 good conduct and a helpful attitude in class.", "steps": "Show consistent good behaviour and be recommended by the class teacher in Basic 4 or 5.", "purpose": "Represents the boys of the Primary section and helps the class teacher keep order.", "motivation": "Little leaders grow into great ones.", "note": "Primary Heads carry no \u201cGovernor\u201d title \u2014 that title belongs only to the JSS3 Junior Secondary Governors above."}, {"id": 16, "img": "head-girl-primary", "name": "Head Girl", "group": "Primary Section (Basic 4 &amp; 5 Only)", "scope": "Basic 4 &amp; 5 Only", "criteria": "The top female student leader of the Primary section \u2014 good conduct and a helpful attitude in class.", "steps": "Show consistent good behaviour and be recommended by the class teacher in Basic 4 or 5.", "purpose": "Represents the girls of the Primary section and helps the class teacher keep order.", "motivation": "Little leaders grow into great ones.", "note": "Primary Heads carry no \u201cGovernor\u201d title \u2014 that title belongs only to the JSS3 Junior Secondary Governors above."}];
function regularPolygonPoints(cx, cy, r, sides, rotationDeg = -90) {
  const pts = [];
  for (let i = 0; i < sides; i++) {
    const a = (rotationDeg + i * 360 / sides) * Math.PI / 180;
    pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]);
  }
  return pts;
}
function ptsToStr(pts) { return pts.map(p => p[0].toFixed(2) + ',' + p[1].toFixed(2)).join(' '); }

function shapeSides(shape) {
  return { triangle:3, square:4, pentagon:5, hexagon:6, heptagon:7, octagon:8, nonagon:9, decagon:10 }[shape] || 0;
}

// ---------- color helpers (for gradient sheens on the richer modal view) ----------
function hexToRgb(hex) {
  const h = hex.replace('#', '');
  return [parseInt(h.substr(0,2),16), parseInt(h.substr(2,2),16), parseInt(h.substr(4,2),16)];
}
function shade(hex, pct) { // pct > 0 lightens toward white, < 0 darkens toward black
  const [r,g,b] = hexToRgb(hex);
  const t = pct > 0 ? 255 : 0;
  const p = Math.abs(pct);
  const mix = (c) => Math.round(c + (t - c) * p);
  return `rgb(${mix(r)},${mix(g)},${mix(b)})`;
}

// One entry per tier (0-10). Each maps to portable CSS classes only —
// no JS timers — so this whole block can be lifted into any site/app as-is.
const TIER_ANIM = {
  0:  { group: 't-breathe' },                                   // breathing
  1:  { group: 't-rotate-cw' },                                 // rotates every 2s
  2:  { filter: 't-pulse-glow' },                                // pulsing glow
  3:  { shimmer: true },                                        // shimmer sweep (SMIL)
  4:  { group: 't-sway' },                                      // pendulum sway
  5:  { filter: 't-twinkle' },                                  // twinkle
  6:  { group: 't-rotate-ccw' },                                // counter-rotation
  7:  { group: 't-ember' },                                     // ember pulse (glow+scale)
  8:  { group: 't-rotate-slow', shimmer: true },                // slow rotate + shimmer
  9:  { group: 't-heartbeat' },                                 // heartbeat double-pulse
  10: { group: 't-rotate-slow', innerGroup: 't-breathe', filter: 't-glow-gold' }, // apex combo
};

function buildShimmerOverlay(cx, cy, outerR, uid) {
  return `<clipPath id="clip-${uid}"><circle cx="${cx}" cy="${cy}" r="${outerR}"/></clipPath>
  <g clip-path="url(#clip-${uid})">
    <ellipse cx="${cx - outerR}" cy="${cy}" rx="7" ry="${outerR}" fill="#ffffff" opacity="0.22" transform="rotate(22 ${cx} ${cy})">
      <animate attributeName="cx" values="${cx-outerR-14};${cx+outerR+14}" dur="2.6s" repeatCount="indefinite"/>
    </ellipse>
  </g>`;
}

function buildBadgeSVG(entry, size, isModal) {
  const cx = 50, cy = 50;
  const outerR = 44;
  const uid = entry.level + (isModal ? '-m' : '-g');
  let inner = '';

  if (entry.goldApex) {
    inner += `<defs><radialGradient id="apexGlow-${uid}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff6da" stop-opacity="0.55"/>
      <stop offset="100%" stop-color="#fff6da" stop-opacity="0"/>
    </radialGradient></defs>
    <circle cx="${cx}" cy="${cy}" r="46" fill="url(#apexGlow-${uid})"/>`;
  }

  // glow filter used throughout the richer modal rendering
  if (isModal) {
    inner += `<defs><filter id="glow-${uid}" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="1.1" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter></defs>`;
  }

  // outer gold ring: double bezel + gem-dots in modal mode, single ring in grid
  if (isModal) {
    inner += `<circle cx="${cx}" cy="${cy}" r="${outerR}" fill="none" stroke="#dfb25c" stroke-width="2.4"/>`;
    inner += `<circle cx="${cx}" cy="${cy}" r="${outerR-3}" fill="none" stroke="#8a6a30" stroke-width="1"/>`;
    [0,90,180,270].forEach(a => {
      const rad = a * Math.PI / 180;
      const gx = cx + outerR * Math.cos(rad), gy = cy + outerR * Math.sin(rad);
      inner += `<circle cx="${gx.toFixed(1)}" cy="${gy.toFixed(1)}" r="2.1" fill="#fff3cf" stroke="#dfb25c" stroke-width="0.6"/>`;
    });
  } else {
    inner += `<circle cx="${cx}" cy="${cy}" r="${outerR}" fill="none" stroke="#dfb25c" stroke-width="2.6"/>`;
  }

  let r = outerR * 0.80;
  const shrink = 0.80;
  const n = entry.decagons;
  for (let k = 0; k < n; k++) {
    const w = Math.max(0.5, 2.3 - n * 0.14);
    const pts = regularPolygonPoints(cx, cy, r, 10);
    if (isModal) {
      const gid = `dgrad-${uid}-${k}`;
      inner += `<defs><linearGradient id="${gid}" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="${shade(entry.colors[k], 0.45)}"/>
        <stop offset="55%" stop-color="${entry.colors[k]}"/>
        <stop offset="100%" stop-color="${shade(entry.colors[k], -0.35)}"/>
      </linearGradient></defs>`;
      inner += `<polygon points="${ptsToStr(pts)}" fill="${entry.colors[k]}" fill-opacity="0.07" stroke="url(#${gid})" stroke-width="${(w+0.5).toFixed(2)}" filter="url(#glow-${uid})"/>`;
    } else {
      inner += `<polygon points="${ptsToStr(pts)}" fill="none" stroke="${entry.colors[k]}" stroke-width="${w.toFixed(2)}"/>`;
    }
    r *= shrink;
  }

  if (entry.shape) {
    const s = entry.shape;
    const color = n > 0 ? entry.colors[n - 1] : '#dfb25c';
    const sw = isModal ? 2.8 : 2.4;
    const filt = isModal ? ` filter="url(#glow-${uid})"` : '';
    const fillOpacity = isModal ? ' fill-opacity="0.12"' : ' fill="none"';
    if (s === 'circle') {
      inner += `<circle cx="${cx}" cy="${cy}" r="${r.toFixed(2)}" ${isModal ? `fill="${color}"` : 'fill="none"'}${isModal?fillOpacity:''} stroke="${color}" stroke-width="${sw}"${filt}/>`;
    } else if (s === 'dissected-circle') {
      inner += `<circle cx="${cx}" cy="${cy}" r="${r.toFixed(2)}" ${isModal ? `fill="${color}"` : 'fill="none"'}${isModal?fillOpacity:''} stroke="${color}" stroke-width="${sw}"${filt}/>`;
      inner += `<line x1="${(cx-r).toFixed(2)}" y1="${cy}" x2="${(cx+r).toFixed(2)}" y2="${cy}" stroke="${color}" stroke-width="${sw-0.2}"${filt}/>`;
    } else {
      const sides = shapeSides(s);
      const pts = regularPolygonPoints(cx, cy, r, sides);
      inner += `<polygon points="${ptsToStr(pts)}" ${isModal ? `fill="${color}"` : 'fill="none"'}${isModal?fillOpacity:''} stroke="${color}" stroke-width="${sw}"${filt}/>`;
    }
  }

  if (entry.diamond) {
    const dr = entry.goldApex ? 10 : 7.5;
    if (isModal) {
      // proper faceted diamond: 4 shaded facets + a sparkle highlight, instead of a flat kite
      const baseCol = entry.goldApex ? '#ffe9a8' : '#bfe9ff';
      const top = shade(baseCol, 0.35), left = shade(baseCol, 0.05), right = shade(baseCol, -0.15), bottom = shade(baseCol, -0.4);
      const glow = entry.goldApex ? '#ffdd7a' : '#8fd6ff';
      inner += `<g filter="url(#glow-${uid})">
        <polygon points="${cx},${cy-dr} ${cx+dr*0.72},${cy} ${cx},${cy} ${cx-dr*0.72},${cy}" fill="${top}"/>
        <polygon points="${cx-dr*0.72},${cy} ${cx},${cy} ${cx},${cy+dr} " fill="${left}"/>
        <polygon points="${cx},${cy} ${cx+dr*0.72},${cy} ${cx},${cy+dr}" fill="${right}"/>
        <polygon points="${cx},${cy-dr} ${cx+dr*0.72},${cy} ${cx},${cy+dr} ${cx-dr*0.72},${cy}" fill="none" stroke="${glow}" stroke-width="0.8"/>
        <path d="M${(cx-dr*0.3).toFixed(1)},${(cy-dr*0.35).toFixed(1)} l1.6,0 M${(cx-dr*0.05).toFixed(1)},${(cy-dr*0.55).toFixed(1)} l0,1.6" stroke="#ffffff" stroke-width="0.7" opacity="0.9"/>
      </g>`;
    } else {
      const dCol = entry.goldApex ? '#fff3cf' : '#bfe9ff';
      const glowCol = entry.goldApex ? '#ffdd7a' : '#8fd6ff';
      inner += `<polygon points="${cx},${cy-dr} ${cx+dr*0.72},${cy} ${cx},${cy+dr} ${cx-dr*0.72},${cy}"
               fill="${dCol}" stroke="${glowCol}" stroke-width="1" opacity="0.95"/>`;
    }
  }

  // ---- per-tier animation wrapping (nested <g> so transform-based effects never conflict) ----
  const ta = TIER_ANIM[entry.tier];
  let content = inner;
  if (ta.innerGroup) content = `<g class="${ta.innerGroup}">${content}</g>`;
  const groupClasses = [];
  if (ta.group) groupClasses.push(ta.group);
  if (ta.filter) groupClasses.push(ta.filter);
  if (groupClasses.length) content = `<g class="${groupClasses.join(' ')}">${content}</g>`;
  if (ta.shimmer) content += buildShimmerOverlay(cx, cy, outerR, uid);

  // ---- modal-only ornamentation: colored glow backdrop + ornamental tick ring ----
  let pre = '', post = '';
  if (isModal) {
    const glowColor = n > 0 ? entry.colors[n - 1] : '#dfb25c';
    pre = `<defs><radialGradient id="bg-${uid}" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="${glowColor}" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="${glowColor}" stop-opacity="0"/>
      </radialGradient></defs>
      <circle cx="${cx}" cy="${cy}" r="49" fill="url(#bg-${uid})"/>`;
    const ticks = [];
    for (let i = 0; i < 12; i++) {
      const a = i * 30 * Math.PI / 180;
      const x1 = cx + 46 * Math.cos(a), y1 = cy + 46 * Math.sin(a);
      const x2 = cx + 49 * Math.cos(a), y2 = cy + 49 * Math.sin(a);
      ticks.push(`<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="#dfb25c" stroke-width="1" opacity="0.7"/>`);
    }
    post = ticks.join('');
  }

  return `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}">${pre}${content}${post}</svg>`;
}


const P=(a,r,cx=50,cy=50)=>[cx+r*Math.cos(a*Math.PI/180),cy+r*Math.sin(a*Math.PI/180)],f1=p=>p.map(n=>n.toFixed(1)).join(',');
const oct=(r,cx=50,cy=50)=>Array.from({length:8},(_,i)=>f1(P(22.5+i*45,r,cx,cy))).join(' ');
const star=(cx,cy,R,n,k,o=-90)=>Array.from({length:n*2},(_,i)=>f1(P(o+i*180/n,i%2?R*k:R,cx,cy))).join(' ');
const G='url(#hG)',S='url(#hS)';
const laurel=(r,f,cx=50,cy=50,lf=1)=>{let o='';for(let s=0;s<2;s++)for(let i=0;i<7;i++){const a=s?180-(105+i*23):105+i*23,[x,y]=P(a,r,cx,cy);o+=`<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="${6.5*lf}" ry="${2.6*lf}" transform="rotate(${a+90} ${x.toFixed(1)} ${y.toFixed(1)})" fill="${f}"/>`}return o};
const rays=(cx,cy,r1,r2,n,a0,a1,f)=>Array.from({length:n},(_,i)=>{const a=a0+(a1-a0)*i/(n-1),p=P(a,r1,cx,cy),q=P(a,r2,cx,cy);return`<line x1="${p[0].toFixed(1)}" y1="${p[1].toFixed(1)}" x2="${q[0].toFixed(1)}" y2="${q[1].toFixed(1)}" stroke="${f}" stroke-width="2.4" stroke-linecap="round"/>`}).join('');
const crown=(x,y,s,f,d)=>`<g transform="translate(${x} ${y}) scale(${s})"><path d="M-24 10L-28-16-12-4 0-22 12-4 28-16 24 10Z" fill="${f}"/><rect x="-24" y="12" width="48" height="7" rx="2" fill="${f}"/><circle cx="-28" cy="-17" r="3" fill="${f}"/><circle cx="28" cy="-17" r="3" fill="${f}"/><circle cy="-24" r="3.4" fill="${f}"/><circle cx="-12" cy="3" r="2.6" fill="${d}"/><circle cy="3" r="2.6" fill="${d}"/><circle cx="12" cy="3" r="2.6" fill="${d}"/></g>`;
const book=(x,y,s,d)=>`<g transform="translate(${x} ${y}) scale(${s})"><path d="M-33-12V20Q-16 14 0 22 16 14 33 20V-12Z" fill="${G}"/><path d="M-2-14Q-16-22-30-16V14Q-16 8-2 16Z" fill="#fff6dc"/><path d="M2-14Q16-22 30-16V14Q16 8 2 16Z" fill="#fff6dc"/><path d="M-26-10Q-16-14-6-9M-26-3Q-16-7-6-2M-26 4Q-16 0-6 5M26-10Q16-14 6-9M26-3Q16-7 6-2M26 4Q16 0 6 5" stroke="${d}" stroke-width="1.5" fill="none" opacity=".6"/></g>`;
const torch=(x,y,s,f)=>`<g transform="translate(${x} ${y}) scale(${s})" fill="${f}"><path d="M0-34C12-20 10-10 0-8-10-10-12-20 0-34Z"/><path d="M-11-6H11L6 24H-6Z"/><rect x="-13" y="-9" width="26" height="5" rx="2"/><rect x="-4" y="24" width="8" height="14" rx="2"/></g>`;
const cmp=f=>`<circle cx="50" cy="50" r="28" fill="none" stroke="${f}" stroke-width="2.4"/><polygon points="${star(50,50,31,4,.17)}" fill="${f}"/><polygon points="${star(50,50,20,4,.26,-45)}" fill="${f}" opacity=".7"/>`;
const ART={
'emperor-empress':['#3a1361',G,d=>laurel(37,G)+crown(50,38,.62,G,d)+crown(50,60,.86,G,d)],
'junior-king-queen':['#7a0f1c',G,d=>rays(50,56,27,37,11,-170,-10,G)+crown(50,56,.9,G,d)],
'crown-prince-princess':['#12235d',G,d=>laurel(37,G)+crown(50,53,.85,G,d)],
'main-senior-prefect':['#650007',G,d=>`<path d="M26 78A24 24 0 0 1 74 78Z" fill="${G}" opacity=".35"/>`+rays(50,78,28,37,9,-165,-15,G)+`<g transform="rotate(-38 50 46)" fill="${G}"><rect x="33" y="28" width="34" height="16" rx="3"/><rect x="47" y="44" width="6" height="30" rx="2.5"/></g><rect x="30" y="76" width="40" height="6" rx="2" fill="${G}"/>`],
'senior-prefect-vp':['#12235d',S,d=>`<polygon points="${star(50,23,11,4,.3)}" fill="${S}"/>`+torch(50,59,.72,G)],
'sports-prefect':['#14532d',G,d=>laurel(36,G)+torch(50,52,.8,G)],
'discipline-prefect':['#16161d',G,d=>`<g stroke="${G}" fill="none" stroke-width="2.6" stroke-linecap="round"><path d="M50 26V70M40 73H60M28 34H72M28 34L20 54M28 34L36 54M72 34L64 54M72 34L80 54"/></g><path d="M18 54H38Q38 63 28 63 18 63 18 54ZM62 54H82Q82 63 72 63 62 63 62 54Z" fill="${G}"/><circle cx="50" cy="25" r="3.5" fill="${G}"/>`],
'academic-prefect':['#14532d',G,d=>book(46,54,1,d)+`<g transform="translate(70 40) rotate(35)"><path d="M0-22C10-14 8 6 0 20-8 6-10-14 0-22Z" fill="#fff6dc"/><path d="M0-22V28" stroke="${G}" stroke-width="1.6"/></g>`],
'health-sanitation-prefect':['#0e5b4f',S,d=>`<g fill="none" stroke="${S}" stroke-width="3" stroke-linecap="round"><path d="M50 24V78"/><path d="M50 74C36 68 36 60 50 56 64 52 64 44 50 40"/><path d="M50 74C64 68 64 60 50 56 36 52 36 44 50 40"/></g><circle cx="50" cy="21" r="4" fill="${S}"/><path d="M50 30C40 22 26 26 20 30 30 30 36 34 46 38ZM50 30C60 22 74 26 80 30 70 30 64 34 54 38Z" fill="${S}"/>`],
'timekeeper-prefect':['#12235d',S,d=>`<rect x="32" y="21" width="36" height="5" rx="2" fill="${S}"/><rect x="32" y="74" width="36" height="5" rx="2" fill="${S}"/><path d="M36 27H64C64 44 54 46 54 50 54 54 64 56 64 73H36C36 56 46 54 46 50 46 46 36 44 36 27Z" fill="none" stroke="${S}" stroke-width="2.6"/><path d="M40 67H60C58 59 53 57 50 55 47 57 42 59 40 67ZM42 34H58C56 41 52 44 50 46 48 44 44 41 42 34Z" fill="${S}"/>`],
'class-captain':['#650007',G,d=>cmp(G)],
'assistant-class-captain':['#650007',S,d=>cmp(S)],
'head-boy-governor':['#650007',G,d=>rays(50,50,30,38,9,-170,-10,G)+book(50,58,.95,d)],
'head-girl-deputy-governor':['#650007',G,d=>`<polygon points="${star(50,24,11,5,.42)}" fill="${G}"/>`+book(50,58,1,d)],
'head-boy-primary':['#5b3f96',S,d=>book(50,52,1.15,d)],
'head-girl-primary':['#5b3f96',S,d=>`<polygon points="${star(50,26,9,5,.42)}" fill="${S}"/>`+book(50,56,1.05,d)]};
const badge=id=>{const[c,rim,f]=ART[id];return`<svg viewBox="0 0 100 100" role="img"><polygon points="${oct(47)}" fill="${rim}"/><polygon points="${oct(42)}" fill="${c}"/><polygon points="${oct(42)}" fill="url(#hShine)"/><polygon points="${oct(39.5)}" fill="none" stroke="${rim}" stroke-opacity=".55" stroke-width=".8"/>${f(c)}</svg>`};
document.body.insertAdjacentHTML('afterbegin','<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="hG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff0b0"/><stop offset=".5" stop-color="#e2b04a"/><stop offset="1" stop-color="#8a6410"/></linearGradient><linearGradient id="hS" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#c4ccd6"/><stop offset="1" stop-color="#7d8791"/></linearGradient><radialGradient id="hShine" cx=".3" cy=".2" r=".9"><stop offset="0" stop-color="#fff" stop-opacity=".28"/><stop offset=".6" stop-color="#fff" stop-opacity="0"/></radialGradient></defs></svg>');
/* medals */
const MET=[['#fff1a8','#e0a919','#8f6508','#7b35b8'],['#fff','#c3cad3','#7b8590','#7b35b8'],['#ffe99a','#d9a91b','#8a6208','#b0654a'],['#f3b596','#c0704f','#7d4029','#2e9a4a'],['#cdb27a','#96793f','#5c4626','#f0b400']];
const ORD=['ST','ND','RD','TH','TH'],NAME=['1st Place · Gold','2nd Place · Silver','3rd Place · Brass','4th Place · Copper','5th Place · Bronze'];
function medal(i,back,who){const m=MET[i],id='m'+i+(back?'b':'f'),ink=m[2];let seed=i*7+3;const rnd=()=>(seed=(seed*1103515245+12345)&0x7fffffff)/0x7fffffff;
let c=`<defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${m[0]}"/><stop offset=".5" stop-color="${m[1]}"/><stop offset="1" stop-color="${m[2]}"/></linearGradient></defs><rect x="68" y="0" width="64" height="52" fill="#7a3bb0"/><path d="M76 0V52M124 0V52" stroke="#e6d0ff" stroke-width=".8" stroke-dasharray="3 3"/><rect x="82" y="40" width="36" height="26" rx="6" fill="none" stroke="url(#${id})" stroke-width="6"/><polygon points="${oct(88,100,152)}" fill="url(#${id})"/><polygon points="${oct(79,100,152)}" fill="none" stroke="${ink}" stroke-opacity=".55" stroke-width="1.4"/><polygon points="${oct(71,100,152)}" fill="${m[1]}" stroke="${m[3]}" stroke-width="3.4"/><polygon points="${oct(71,100,152)}" fill="url(#hShine)"/>`;
const T=(x,y,t,s,w=700)=>`<text x="${x}" y="${y}" text-anchor="middle" font-family="Georgia,serif" font-size="${s}" font-weight="${w}" fill="${ink}">${t}</text>`;
c+=T(100,105,'MGR',15,800)+T(100,205,String(mYear),13,800);
if(!back){
 if(i==0)c+=laurel(60,ink,100,152,1.15)+`<polygon points="100,108 136,152 100,196 64,152" fill="#8b3fd0" stroke="${ink}" stroke-width="2"/><polygon points="100,108 136,152 100,152" fill="#c58bff" opacity=".55"/>`;
 if(i==1)c+=`<polygon points="${star(100,116,8,4,.3)}" fill="${ink}"/><path d="M62 172C60 140 84 132 100 148M138 172C140 140 116 132 100 148" fill="none" stroke="${m[3]}" stroke-width="3"/>`;
 if(i==2)c+=laurel(60,ink,100,152,1.15);
 if(i==3)c+=`<path d="M100 108L140 152 100 196 60 152ZM100 118L130 152 100 186 70 152Z" fill="none" stroke="${ink}" stroke-width="1.6" opacity=".7"/>`;
 if(i==4)c+=`<path d="M64 118Q100 100 136 118M64 190Q100 208 136 190" fill="none" stroke="${ink}" stroke-width="2" opacity=".8"/>`;
 c+=`<text x="100" y="${i==0?176:174}" text-anchor="middle" font-family="Georgia,serif" font-size="70" font-weight="700" fill="${i==0?'#fff3c4':ink}" stroke="${i==0?ink:'none'}" stroke-width="1.2">${i+1}</text>`+`<text x="${i==0?134:142}" y="${i==0?128:150}" font-family="Georgia,serif" font-size="13" font-weight="700" fill="${ink}">${ORD[i]}</text>`;
}else{
 c+=`<rect x="52" y="112" width="96" height="24" rx="5" fill="#fff" fill-opacity=".28" stroke="${ink}" stroke-width="1.4"/><text x="58" y="122" font-family="Arial" font-size="6.5" font-weight="800" fill="${ink}">WINNER:</text><text x="100" y="131" text-anchor="middle" font-family="Georgia,serif" font-size="10" font-weight="700" fill="${ink}" class="mname">${who}</text><rect x="52" y="142" width="96" height="52" rx="5" fill="#fff" fill-opacity=".2" stroke="${ink}" stroke-width="1.4"/>`;
 c+=`<rect x="54" y="145" width="47" height="47" rx="2" fill="#fff"/><path d="${qrPath(mUrl(i+1,mYear),41/(qrM(mUrl(i+1,mYear)).n),57,148)}" fill="#111"/>`;
 c+=T(126,158,'SCAN TO',6.5,800)+T(126,166,'VERIFY',6.5,800)+T(126,174,'WINNER',6.5,800)+T(126,182,'& EVENT',6.5,800);
}
return`<svg viewBox="0 0 200 250" role="img" aria-label="${NAME[i]} medal ${back?'back':'front'}">${c}</svg>`}
let mBack=0,mWho='',mYear=curY;
function drawRecords(){const A=allRec().filter(r=>r.achievement&&r.achievement!='Medal');const box=$('hubRecords');if(!box)return;box.innerHTML='<h4 style="margin:18px 0 8px;color:#650007">RECORD MAKERS &amp; RECORD BREAKERS</h4>'+ (A.length?A.map(r=>`<div class="mw"><div><b>${esc(r.name)}</b><small>${esc(r.achievement)} · ${esc(r.category||'Uncategorised')} · ${r.year}${r.event?' · '+esc(r.event):''}</small></div></div>`).join(''):'<p class="hs-note">No record achievements recorded yet.</p>')}
function drawMedals(){const A=allRec();$('hubMedals').innerHTML=MET.map((_,i)=>{const n=A.filter(r=>r.place==i+1&&(!r.achievement||r.achievement=='Medal')).length;return`<button type="button" class="hub-medal" data-k="m" data-i="${i}" aria-label="${NAME[i]} winners">${medal(i,mBack,mWho||'')}<b>${NAME[i]}</b><small>MGR ${mYear} · ${n} winner${n==1?'':'s'} · tap to view</small></button>`}).join('')}
/* grids */
let done={};
function renderStaff(){if(done.s)return;done.s=1;let h='';LEVELS.forEach((e,i)=>{if(i%10==0)h+=(i?'</div>':'')+`<div class="hub-tier">Tier ${i/10+1} · Levels ${i+1}–${i+10}</div><div class="hub-grid lv">`;h+=`<button class="hub-cell" data-k="s" data-i="${i}" aria-label="Level ${e.level} ${e.name}">${buildBadgeSVG(e,64,false)}<small>#${e.level}</small></button>`});$('hubStaffGrid').innerHTML=h+'</div>'}
function renderStudents(){if(done.t)return;done.t=1;let h='',g='';STUDENT.forEach((e,i)=>{if(e.group!==g){g=e.group;h+=(i?'</div>':'')+`<div class="hub-tier">${g}</div><div class="hub-grid st">`}h+=`<button class="hub-cell" data-k="t" data-i="${i}">${badge(e.img)}<b>${e.name}</b><small>${e.scope}</small></button>`});$('hubStudentGrid').innerHTML=h+'</div>'}
function renderMedals(){const y=$('hubYear');if(y&&!y.options.length){for(let k=curY+1;k>=2026;k--)y.add(new Option(k,k,0,k==curY));y.onchange=()=>{mYear=+y.value;drawMedals();drawRecords()}}drawMedals();drawRecords();loadRemote().then(()=>{drawMedals();drawRecords()})}
/* ---- QR + medal winner records ---- */
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const qrM=t=>{const q=new QRCode(-1,QRErrorCorrectLevel.M);q.addData(t);q.make();return{n:q.getModuleCount(),d:(r,c)=>q.isDark(r,c)}};
const qrPath=(t,cs,ox,oy)=>{const{n,d}=qrM(t);let p='';for(let r=0;r<n;r++){let c=0;while(c<n){if(d(r,c)){let e=c;while(e<n&&d(r,e))e++;const w=((e-c)*cs).toFixed(2);p+=`M${(ox+c*cs).toFixed(2)} ${(oy+r*cs).toFixed(2)}h${w}v${cs.toFixed(2)}h-${w}z`;c=e}else c++}}return p};
const qrSvg=t=>{const N=qrM(t).n+8;return`<svg viewBox="0 0 ${N} ${N}" shape-rendering="crispEdges" role="img" aria-label="QR code"><rect width="${N}" height="${N}" fill="#fff"/><path d="${qrPath(t,1,4,4)}" fill="#000"/></svg>`};
const qrBlob=t=>new Promise(res=>{const{n,d}=qrM(t),S=10,N=(n+8)*S,c=document.createElement('canvas');c.width=c.height=N;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,N,N);x.fillStyle='#000';for(let r=0;r<n;r++)for(let k=0;k<n;k++)if(d(r,k))x.fillRect((k+4)*S,(r+4)*S,S,S);c.toBlob(res,'image/png')});
const LK='sclMedalWinnersLocal',BK='sclMedalBaseUrl',SB=window.SCL_SUPABASE_URL,KEY=window.SCL_SUPABASE_PUBLISHABLE_KEY;
const base=()=>(localStorage.getItem(BK)||(location.protocol=='file:'?location.href:location.origin+location.pathname)).split(/[?#]/)[0];
const mUrl=(p,y,sid)=>base()+'?medal='+p+'&year='+y+(sid?'&sid='+encodeURIComponent(sid):'');
const jl=()=>{try{return JSON.parse(localStorage.getItem(LK))||[]}catch(e){return[]}};
const authS=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(e){return null}};
const admin=()=>(authS()&&authS().roles||[]).some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)));
const hdr=()=>{const a=authS(),h={apikey:KEY,'Content-Type':'application/json'};if(a&&a.accessToken)h.Authorization='Bearer '+a.accessToken;return h};
let remote=[],remoteOK=false,flash='',selY=String(curY);
const norm=r=>({id:r.id,place:+r.place,year:+r.year,sid:r.student_id||r.sid||'',name:r.name,event:r.event||'',category:r.category||'',achievement:r.achievement_type||r.achievement||'Medal',at:r.created_at||r.at||''});
async function loadRemote(){try{const r=await fetch(SB+'/rest/v1/medal_winners?select=*&order=year.desc,created_at.desc',{headers:hdr()});if(!r.ok)throw 0;remote=(await r.json()).map(norm);remoteOK=true}catch(e){remoteOK=false}}
const allRec=()=>{const ids=new Set(remote.map(r=>r.id));return remote.concat(jl().filter(r=>!ids.has(r.id))).sort((a,b)=>b.year-a.year||String(b.at).localeCompare(String(a.at)))};
async function saveRec(r){if(remoteOK){try{const x=await fetch(SB+'/rest/v1/medal_winners',{method:'POST',headers:Object.assign(hdr(),{Prefer:'return=minimal'}),body:JSON.stringify({id:r.id,place:r.place,year:r.year,student_id:r.sid,name:r.name,event:r.event,category:r.category||'',achievement_type:r.achievement||'Medal'})});if(x.ok){remote.push(r);return'db'}}catch(e){}}
 const l=jl();l.push(Object.assign({local:1},r));localStorage.setItem(LK,JSON.stringify(l));return'local'}
async function delRec(id){const l=jl().filter(r=>r.id!==id);localStorage.setItem(LK,JSON.stringify(l));if(remote.some(r=>r.id===id)){try{await fetch(SB+'/rest/v1/medal_winners?id=eq.'+encodeURIComponent(id),{method:'DELETE',headers:hdr()});remote=remote.filter(r=>r.id!==id)}catch(e){}}}
const qrBox=(u,name)=>`<div class="mq"><div class="mqi">${qrSvg(u)}</div><div class="mqt"><small>${esc(u)}</small><div class="mqb"><button type="button" data-act="cp" data-u="${esc(u)}">Copy link</button><button type="button" data-act="cpi" data-u="${esc(u)}">Copy QR</button><button type="button" data-act="dl" data-u="${esc(u)}" data-n="${esc(name)}">Download</button></div></div></div>`;
function medalSheet(i,o){o=o||{};const p=i+1,recs=allRec().filter(r=>r.place==p&&(!r.achievement||r.achievement=='Medal'));if(o.year)selY=String(o.year);
 const yrs=[...new Set(recs.map(r=>r.year).concat([curY,mYear]))].sort((a,b)=>b-a),qy=selY=='all'?mYear:+selY,list=recs.filter(r=>selY=='all'||r.year==+selY);
 let h=`<div class="hs-medal">${medal(i,0,'')}</div><h3>${NAME[i]}</h3><div class="hs-tag">Winners record · latest first</div>`;
 if(flash){h+=`<div class="mv ok">${esc(flash)}</div>`;flash=''}
 if(o.sid!=null){const f=recs.find(r=>r.sid.toLowerCase()==String(o.sid).toLowerCase()&&(!o.year||r.year==+o.year));h+=f?`<div class="mv ok">✔ Verified winner<br><b>${esc(f.name)}</b> · ID ${esc(f.sid)}<br>${NAME[i]} · ${f.year}${f.event?' · '+esc(f.event):''}${f.category?' · '+esc(f.category):''}${f.achievement&&f.achievement!='Medal'?' · '+esc(f.achievement):''}</div>`:`<div class="mv bad">✖ No record found for ID ${esc(o.sid)} on this medal${o.year?' in '+esc(o.year):''}. It could not be verified.</div>`}
 h+=`<div class="hub-tools"><label>Year&nbsp;<select id="mYr"><option value="all"${selY=='all'?' selected':''}>All years</option>${yrs.map(y=>`<option${selY==y?' selected':''}>${y}</option>`).join('')}</select></label></div>`;
 h+=`<h4>Medal QR · ${qy}</h4>`+qrBox(mUrl(p,qy),'MGR-'+NAME[i].split(' ')[0]+'-'+qy);
 h+=`<h4>Winners${selY=='all'?'':' · '+selY}</h4>`;
 if(!list.length)h+='<p class="hs-note">No winners recorded yet.</p>';
 let gy=0;list.forEach(r=>{if(r.year!=gy){gy=r.year;h+=`<div class="mw-y">${gy}</div>`}const hl=o.sid!=null&&r.sid.toLowerCase()==String(o.sid).toLowerCase();
  h+=`<div class="mw${hl?' hl':''}"><div><b>${esc(r.name)}</b><small>ID ${esc(r.sid)}${r.event?' · '+esc(r.event):''}${r.category?' · '+esc(r.category):''}${r.achievement&&r.achievement!='Medal'?' · '+esc(r.achievement):''}${r.local?' · this device only':''}</small></div><span><button type="button" data-act="wqr" data-id="${r.id}">QR</button>${admin()?`<button type="button" data-act="del" data-id="${r.id}" aria-label="Delete">✕</button>`:''}</span></div><div class="mwq" id="q_${r.id}" hidden></div>`});
 if(admin())h+=`<div class="mf"><h4>Upload winner · ${NAME[i]}</h4><input id="mfName" placeholder="Child's full name"><input id="mfId" placeholder="Student ID, e.g. SCL-2026-0001"><input id="mfEvent" placeholder="Competition / event"><select id="mfCategory" aria-label="Competition category"><option value="">Select category</option><option>Sports &amp; Physical Activities</option><option>Academics &amp; Intellectual Achievement</option><option>Technology &amp; Digital Innovation</option><option>Catering &amp; Culinary Arts</option><option>Arts &amp; Entertainment</option><option>Leadership, Community &amp; Service</option></select><select id="mfAchievement" aria-label="Achievement type"><option value="Medal">Competition Medal</option><option value="Record Maker">Record Maker</option><option value="Record Breaker">Record Breaker</option></select><input id="mfYear" type="number" value="${qy}"><button type="button" class="pri" data-act="add">Upload winner / achievement</button><small>${remoteOK?'Connected: records are saved to the school database.':'Not connected: records are saved on this device only.'}</small><h4>Website address used in QR codes</h4><input id="mfBase" value="${esc(base())}"><button type="button" data-act="base">Save address</button>${location.protocol=='file:'?'<small>You are on a local file. Save the live website address so QR codes work when scanned.</small>':''}</div>`;
 return h}
async function onAct(b){const a=b.dataset.act,u=b.dataset.u,g=id=>($(id).value||'').trim();
 if(a=='cp'){try{await navigator.clipboard.writeText(u);b.textContent='Copied ✔'}catch(e){prompt('Copy this link',u)}}
 if(a=='cpi'||a=='dl'){const bl=await qrBlob(u);if(a=='cpi'&&window.ClipboardItem&&navigator.clipboard&&navigator.clipboard.write){try{await navigator.clipboard.write([new ClipboardItem({'image/png':bl})]);b.textContent='Copied ✔';return}catch(e){}}const l=document.createElement('a');l.href=URL.createObjectURL(bl);l.download=(b.dataset.n||'MGR-QR')+'.png';l.click();setTimeout(()=>URL.revokeObjectURL(l.href),2000);b.textContent=a=='cpi'?'Downloaded ✔':'Saved ✔'}
 if(a=='wqr'){const r=allRec().find(x=>x.id==b.dataset.id),box=$('q_'+b.dataset.id);if(box.hidden){box.innerHTML=qrBox(mUrl(r.place,r.year,r.sid),'MGR-'+r.place+'-'+r.year+'-'+r.sid);}box.hidden=!box.hidden}
 if(a=='del'){if(confirm('Delete this winner record?')){await delRec(b.dataset.id);drawMedals();openSheet('m',cur.i)}}
 if(a=='base'){const v=g('mfBase');try{new URL(v);localStorage.setItem(BK,v);flash='✔ QR address saved.';drawMedals();openSheet('m',cur.i)}catch(e){alert('Enter a full address, e.g. https://yourschool.com/')}}
 if(a=='add'){if(!admin())return;const name=g('mfName'),sid=g('mfId'),ev=g('mfEvent'),cat=g('mfCategory'),ach=g('mfAchievement')||'Medal',y=+g('mfYear'),p=ach=='Medal'?cur.i+1:null;if(!name||!sid||!cat||!(y>1999&&y<2100)){alert('Enter the child\'s name, student ID and a valid year.');return}
  if(allRec().some(r=>r.place==p&&r.year==y&&r.sid.toLowerCase()==sid.toLowerCase()&&r.achievement==ach)){alert('This student is already recorded for this medal and year.');return}
  b.disabled=true;const how=await saveRec({id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),place:p,year:y,sid,name,event:ev,category:cat,achievement:ach,at:new Date().toISOString()});
  flash='✔ '+name+' recorded'+(how=='db'?' and saved to the school database.':' (saved on this device only).');selY=String(y);drawMedals();drawRecords();openSheet('m',cur.i)}}

/* sheet */
let cur={k:'s',i:0};const sh=$('hubSheet');document.body.appendChild(sh);
function openSheet(k,i,opt){const L=k=='s'?LEVELS:k=='t'?STUDENT:MET;i=Math.max(0,Math.min(L.length-1,i));cur={k,i};const e=L[i];
$('hubBody').innerHTML=k=='m'?medalSheet(i,opt):k=='s'?`<div class="hs-badge">${buildBadgeSVG(e,120,true)}</div><h3>${e.name}</h3><div class="hs-tag">${e.meaning} · LEVEL ${e.level} OF 100</div><div class="hs-row"><span>Days to unlock</span><b>${e.days} days</b></div><div class="hs-row"><span>Expectation</span><b>${e.expectationPointsLabel} pts</b></div><p class="hs-quote">“${e.motivation}”</p><p>${e.importance}</p>`:`<div class="hs-badge">${badge(e.img)}</div><h3>${e.name}</h3><div class="hs-tag">${e.group}</div><div class="hs-tag">${e.scope}</div><h4>Criteria</h4><p>${e.criteria}</p><h4>Steps</h4><p>${e.steps}</p><h4>Purpose</h4><p>${e.purpose}</p><p class="hs-quote">“${e.motivation}”</p>`;
$('hubPrev').disabled=!i;$('hubNext').disabled=i==L.length-1;sh.classList.add('open');$('hubCard').scrollTop=0}
function closeSheet(){sh.classList.remove('open')}
document.addEventListener('click',e=>{const c=e.target.closest('.hub-cell,.hub-medal');if(c)openSheet(c.dataset.k,+c.dataset.i);const ab=e.target.closest('#hubBody [data-act]');if(ab)onAct(ab);if(e.target===sh)closeSheet()});
$('hubClose').onclick=closeSheet;$('hubPrev').onclick=()=>openSheet(cur.k,cur.i-1);$('hubNext').onclick=()=>openSheet(cur.k,cur.i+1);
document.addEventListener('keydown',e=>{if(!sh.classList.contains('open'))return;if(e.key=='Escape')closeSheet();if(e.key=='ArrowLeft')openSheet(cur.k,cur.i-1);if(e.key=='ArrowRight')openSheet(cur.k,cur.i+1)});
let tx=null;$('hubCard').addEventListener('touchstart',e=>tx=e.touches[0].clientX,{passive:true});$('hubCard').addEventListener('touchend',e=>{if(tx==null)return;const d=e.changedTouches[0].clientX-tx;if(Math.abs(d)>50)openSheet(cur.k,cur.i+(d<0?1:-1));tx=null},{passive:true});
document.addEventListener('change',e=>{if(e.target.id=='mYr'){selY=e.target.value;openSheet('m',cur.i)}});
document.querySelectorAll('.hub-seg button').forEach(b=>b.onclick=()=>{mBack=+b.dataset.b;document.querySelectorAll('.hub-seg button').forEach(x=>x.classList.toggle('on',x===b));drawMedals()});
$('hubWho').oninput=e=>{mWho=e.target.value.trim().slice(0,22).toUpperCase();document.querySelectorAll('.mname').forEach(t=>t.textContent=mWho)};
/* anthem: one tap = one play; cannot be paused or scrubbed */
const v=$('hubVideo'),pb=$('hubPlay'),bar=$('hubBar');let run=false;
function stopAnthem(){run=false;try{v.pause();v.currentTime=0}catch(e){}pb.style.display='flex';bar.style.width=0}
pb.onclick=()=>{run=true;v.currentTime=0;v.play().then(()=>{pb.style.display='none'}).catch(()=>{run=false});};
v.addEventListener('pause',()=>{if(run&&!v.ended)v.play().catch(()=>{})});
v.addEventListener('ended',()=>{stopAnthem()});
v.addEventListener('timeupdate',()=>{if(v.duration)bar.style.width=(v.currentTime/v.duration*100)+'%'});
['contextmenu','dblclick'].forEach(ev=>v.addEventListener(ev,e=>e.preventDefault()));
/* tabs + coin */
const TABS=['collaborators','activities','gallery','studentRanking','rank','medals','anthem'];
window.showCommunityTab=function(tab){TABS.forEach(t=>{const C=t[0].toUpperCase()+t.slice(1);$('communityPanel'+C)?.classList.toggle('hidden',t!==tab);const b=$('communityTab'+C);if(b){b.classList.toggle('active',t===tab);if(t===tab)b.scrollIntoView({inline:'center',block:'nearest'})}});
 if(tab=='rank')renderStaff();if(tab=='studentRanking')renderStudents();if(tab=='medals')renderMedals();if(tab!='anthem')stopAnthem();closeSheet()};
const oc=window.closeCollaboration;window.closeCollaboration=window.closeLogoGallery=function(){stopAnthem();closeSheet();oc&&oc()};
const btn=document.querySelector('.scl-logo-coin-button'),MAP={student:'studentRanking',staff:'rank',medals:'medals',anthem:'anthem'};
if(btn){btn.addEventListener('click',e=>{const a=e.target.closest('.scl-coin-action');window.openLogoGallery();if(a)setTimeout(()=>window.showCommunityTab(MAP[a.dataset.coinAction]),0)});
 btn.querySelectorAll('.scl-coin-action').forEach(el=>el.addEventListener('keydown',e=>{if(e.key=='Enter'||e.key==' '){e.preventDefault();el.click()}}))}
const qp=new URLSearchParams(location.search),dm=+qp.get('medal');
if(dm>=1&&dm<=5)loadRemote().then(()=>{const go=()=>{if($('scl-book-loader'))return setTimeout(go,300);window.openLogoGallery();window.showCommunityTab('medals');renderMedals();openSheet('m',dm-1,{year:qp.get('year'),sid:qp.get('sid')})};go()});
})();
</script>
<script id="scl-v69-shortcut-bar-js">
(function(){
  function close(){const p=document.getElementById('sclShortcutPanel'),b=document.getElementById('sclShortcutToggle');if(!p||!b)return;p.classList.remove('open');b.classList.remove('open');p.setAttribute('aria-hidden','true');b.setAttribute('aria-expanded','false')}
  function toggle(e){if(e)e.stopPropagation();const p=document.getElementById('sclShortcutPanel'),b=document.getElementById('sclShortcutToggle');if(!p||!b)return;const on=!p.classList.contains('open');p.classList.toggle('open',on);b.classList.toggle('open',on);b.setAttribute('aria-expanded',String(on));p.setAttribute('aria-hidden',String(!on));}
  window.sclCloseShortcutBar=close; window.sclToggleShortcutBar=toggle;
  function bind(){const b=document.getElementById('sclShortcutToggle'),p=document.getElementById('sclShortcutPanel');if(!b||!p||b.dataset.bound==='1')return;b.dataset.bound='1';b.addEventListener('click',toggle);document.addEventListener('click',function(e){if(!p.classList.contains('open'))return;if(e.target.closest('#sclShortcutPanel')||e.target.closest('#sclShortcutToggle'))return;close()});document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});else bind();
})();
</script>
<style id="scl-v72-modern-navigation-comments-professions">
.modal{z-index:10000!important;padding-bottom:82px!important}.wa-modal{z-index:10050!important}
.scl-profession-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.scl-profession-select{padding:11px;border:1px solid #d9c5aa;border-radius:9px;background:#fff;color:#260c0d;font-weight:700}
.scl-v72-modern-modal{position:fixed;inset:0;z-index:10020;background:rgba(20,0,3,.70);backdrop-filter:blur(7px);display:none;align-items:center;justify-content:center;padding:14px 14px 82px}.scl-v72-modern-modal.open{display:flex}
.scl-v72-comments-card{width:min(980px,100%);max-height:calc(100vh - 100px);overflow:auto;background:linear-gradient(180deg,#fff,#fffaf1);border:1px solid #ead5b6;border-radius:22px;box-shadow:0 30px 90px rgba(0,0,0,.35)}
.scl-v72-comments-head{position:sticky;top:0;z-index:2;background:linear-gradient(135deg,#650007,#8a0710);color:#fff;padding:16px 18px;display:flex;justify-content:space-between;align-items:center}.scl-v72-comments-head h3{margin:0}.scl-v72-comments-head button{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:10px;padding:8px 11px;font-weight:900}
.scl-v72-comments-body{padding:16px;display:grid;gap:14px}.scl-v72-comment-composer{background:#fff;border:1px solid #ead5b6;border-radius:16px;padding:14px;box-shadow:0 8px 24px rgba(101,0,7,.07)}.scl-v72-comment-composer select,.scl-v72-comment-composer textarea{width:100%;box-sizing:border-box;padding:11px;border:1px solid #d9c5aa;border-radius:10px;background:#fff}.scl-v72-comment-composer textarea{min-height:92px;resize:vertical;margin-top:9px}.scl-v72-comment-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:9px}.scl-v72-comment-list{display:grid;gap:9px}.scl-v72-comment{background:#fff;border:1px solid #ead5b6;border-radius:14px;padding:12px;box-shadow:0 5px 18px rgba(0,0,0,.05)}.scl-v72-comment-meta{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;color:#6c5e54;font-size:11px}.scl-v72-comment-author{font-size:13px;color:#650007;font-weight:900}.scl-v72-comment-body{margin-top:7px;line-height:1.5;color:#332525;white-space:pre-wrap}.scl-v72-comment-target{display:inline-block;margin-top:7px;padding:4px 8px;border-radius:999px;background:#fff3c7;color:#6b4a00;font-size:10px;font-weight:800}.scl-v72-comment-empty{padding:28px;text-align:center;border:1px dashed #d9c5aa;border-radius:14px;color:#75685f}
.scl-v72-daily-roster{min-width:235px;vertical-align:top!important;background:linear-gradient(180deg,#fff8e8,#fff)!important;border-left:3px solid #f2ae00!important}.scl-v72-daily-roster h4{margin:0 0 7px;color:#650007;font-size:12px}.scl-v72-roster-person{display:block;padding:6px 7px;margin:5px 0;border-radius:9px;background:#fff;border:1px solid #ead5b6}.scl-v72-roster-person b{display:block;color:#650007;font-size:11px}.scl-v72-roster-person small{display:block;color:#6b625a;margin-top:2px;line-height:1.3}
.scl-v72-page-polish .card,.scl-v72-page-polish .panel,.scl-v72-page-polish .scl-att-card,.scl-v72-page-polish .scl-rank-card{border-radius:18px;box-shadow:0 10px 30px rgba(60,0,0,.07)}
@media(max-width:600px){.bottom{gap:7px!important;justify-content:space-around!important}.bottom button{min-width:58px!important;font-size:11px!important}.scl-profession-grid{grid-template-columns:1fr}.scl-v72-comments-body{padding:11px}.scl-v72-daily-roster{min-width:180px}.scl-v72-comments-card{max-height:calc(100vh - 92px)}}
</style>
<script id="scl-v72-navigation-comments-professions-js">
(function(){
'use strict';
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function auth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
function apiHeaders(){const a=auth(),h={'Content-Type':'application/json','apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY};if(a?.accessToken)h.Authorization='Bearer '+a.accessToken;return h}
async function commentApi(body){const r=await fetch(window.SCL_COMMUNITY_API,{method:'POST',headers:apiHeaders(),body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Comment service request failed.');return d}
function ensureModal(){if(document.getElementById('sclV72CommentsModal'))return;const m=document.createElement('div');m.id='sclV72CommentsModal';m.className='scl-v72-modern-modal';m.innerHTML='<div class="scl-v72-comments-card"><div class="scl-v72-comments-head"><div><h3>💬 SCL COMMENTS & COMMUNITY</h3><small>Comments are linked to the official SCL community record.</small></div><button type="button" onclick="window.sclCloseComments()">✕</button></div><div class="scl-v72-comments-body"><div class="scl-v72-comment-composer"><b>Leave a comment</b><select id="sclV72CommentTarget" aria-label="Comment target"></select><textarea id="sclV72CommentBody" maxlength="2000" placeholder="Write your comment..."></textarea><div class="scl-v72-comment-actions"><button class="btn outline" type="button" onclick="window.sclLoadComments()">↻ Refresh</button><button class="btn gold" type="button" onclick="window.sclSubmitComment()">POST COMMENT</button></div><small style="display:block;margin-top:7px;color:#75685f">Your SCL profile name and verified account email are shown with your comment.</small></div><div id="sclV72CommentList" class="scl-v72-comment-list"><div class="scl-v72-comment-empty">Loading comments…</div></div></div></div>';document.body.appendChild(m);m.addEventListener('click',e=>{if(e.target===m)window.sclCloseComments()});}
function fillTargets(){const s=document.getElementById('sclV72CommentTarget');if(!s)return;const d=window.sclCommunityData||{};let h='<option value="general|">General SCL Post</option>';for(const x of (d.announcements||[]))h+='<option value="announcement|'+esc(x.id)+'">📢 '+esc(x.title)+'</option>';for(const x of (d.activities||[]))h+='<option value="activity|'+esc(x.id)+'">📸 '+esc(x.title)+'</option>';s.innerHTML=h;}
function titleFor(c){const d=window.sclCommunityData||{};if(c.content_type==='announcement'){return (d.announcements||[]).find(x=>String(x.id)===String(c.content_id))?.title||'School Announcement'}if(c.content_type==='activity'){return (d.activities||[]).find(x=>String(x.id)===String(c.content_id))?.title||'School Activity'}return 'General SCL Post'}
window.sclLoadComments=async function(){ensureModal();const list=document.getElementById('sclV72CommentList');try{const a=auth();if(!a?.accessToken){list.innerHTML='<div class="scl-v72-comment-empty">Please log in to view and post community comments.</div>';return}const d=await commentApi({action:'list_comments'});const rows=d.comments||[];list.innerHTML=rows.length?rows.map(c=>{const own=String(c.author_user_id)===String(d.viewer_user_id),roles=a.roles||[],admin=roles.some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)));return '<article class="scl-v72-comment"><div class="scl-v72-comment-meta"><div><div class="scl-v72-comment-author">'+esc(c.author_name||'SCL User')+'</div><div>'+esc(c.author_email||'')+'</div></div><div>'+esc(new Date(c.created_at).toLocaleString('en-NG'))+'</div></div><span class="scl-v72-comment-target">'+esc(titleFor(c))+'</span><div class="scl-v72-comment-body">'+esc(c.body)+'</div>'+(own||admin?'<div style="text-align:right;margin-top:7px"><button class="btn outline" type="button" style="padding:6px 9px;font-size:10px" onclick="window.sclDeleteComment(\''+esc(c.id)+'\')">DELETE</button></div>':'')+'</article>'}).join(''):'<div class="scl-v72-comment-empty">No comments yet. Be the first to comment.</div>';fillTargets();}catch(e){list.innerHTML='<div class="scl-v72-comment-empty">'+esc(e.message||'Comments are temporarily unavailable.')+'</div>';}}
window.sclSubmitComment=async function(){const a=auth();if(!a?.accessToken){toast('Please log in before commenting.');login();return}const s=document.getElementById('sclV72CommentTarget'),ta=document.getElementById('sclV72CommentBody');const v=s?.value||'general|',body=(ta?.value||'').trim();if(!body){toast('Write a comment first.');return}const [content_type,content_id]=v.split('|');try{await commentApi({action:'add_comment',content_type,content_id:content_id||null,body});ta.value='';toast('Comment posted to the SCL community.');await window.sclLoadComments();}catch(e){toast(e.message||'Unable to post comment.');}}
window.sclDeleteComment=async function(id){if(!confirm('Delete this comment?'))return;try{await commentApi({action:'delete_comment',id});toast('Comment removed.');await window.sclLoadComments();}catch(e){toast(e.message||'Unable to delete comment.');}}
window.sclOpenComments=function(){ensureModal();const m=document.getElementById('sclV72CommentsModal');m.classList.add('open');document.body.classList.add('modal-open');fillTargets();window.sclLoadComments()};window.sclCloseComments=function(){const m=document.getElementById('sclV72CommentsModal');if(m)m.classList.remove('open');document.body.classList.remove('modal-open')};
const bottom=document.querySelector('.bottom');if(bottom){const bs=bottom.querySelectorAll('button');if(bs.length>=5){bs[0].onclick=()=>login();bs[1].onclick=()=>window.sclOpenComments();bs[2].onclick=()=>pick();bs[3].onclick=()=>openCollaboration();bs[4].onclick=()=>openWhatsAppChoices();}}
function syncProfessions(form){const selects=[...form.querySelectorAll('.scl-profession-select')];const used=new Set([form.querySelector('input[name="role"]')?.value||'']);selects.forEach(sel=>{const current=sel.value;sel.querySelectorAll('option').forEach(o=>{if(!o.value){o.hidden=false;return}o.disabled=used.has(o.value)&&o.value!==current});if(current)used.add(current)});}
document.addEventListener('change',e=>{if(e.target.classList.contains('scl-profession-select'))syncProfessions(e.target.form)});
const oldRenderWorkerForm=window.renderWorkerForm;window.renderWorkerForm=function(){oldRenderWorkerForm&&oldRenderWorkerForm();const f=document.getElementById('workerForm');if(f)syncProfessions(f)};
document.documentElement.classList.add('scl-v72-page-polish');
})();
</script>
<style id="scl-v73-leadership-qr">
.scl-v73-leadership-card{background:linear-gradient(145deg,#fffdf7,#fff);border:1px solid #ead5b6;border-radius:20px;padding:16px;box-shadow:0 10px 30px rgba(101,0,7,.08)}
.scl-v73-leadership-card .qrbox{display:flex;justify-content:center;align-items:center;background:#fff;border:1px solid #ead5b6;border-radius:14px;padding:10px;min-height:190px}
.scl-v73-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.scl-v73-actions button{border:1px solid #cda85e;border-radius:10px;padding:9px 12px;font-weight:800;cursor:pointer;background:#fff}.scl-v73-actions .gold{background:#f2ae00;color:#3f0004}.scl-v73-actions .red{background:#650007;color:#fff}
.scl-v73-assign{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 16px;background:#fffaf0;border:1px solid #ead5b6;border-radius:16px;margin:12px 16px}.scl-v73-assign .full{grid-column:1/-1}.scl-v73-assign label{font-size:12px;font-weight:900;color:#650007;display:block;margin-bottom:4px}.scl-v73-assign input,.scl-v73-assign select,.scl-v73-assign textarea{width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px;background:#fff}.scl-v73-assign textarea{min-height:65px}.scl-v73-permission{margin:10px 16px;padding:11px 13px;border-radius:10px;background:#eef8f1;color:#126b3a;font-size:13px;font-weight:700}
.scl-v73-print{display:none}
.scl-v74-help{margin:10px 16px;padding:12px 14px;border-left:4px solid #d69b25;background:#fff8df;border-radius:10px;font-size:13px;line-height:1.5}
@media(max-width:650px){.scl-v73-assign{grid-template-columns:1fr}.scl-v73-assign .full{grid-column:auto}}
</style>
<script id="scl-v73-leadership-qr-js">
(()=>{
 const API=(window.SCL_SUPABASE_URL||'')+'/functions/v1/scl-leadership';
 const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const auth=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}};
 const headers=()=>{const a=auth();return {'Content-Type':'application/json','apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY||window.SCL_SUPABASE_ANON_KEY||'',...(a?.accessToken?{'Authorization':'Bearer '+a.accessToken}:{})}};
 const initialsMap={'Senior Prefect':'SP/P','Vice President':'SP/VP','Head Boy':'HB','Head Girl':'HG','Junior Prefect':'JP','Assistant Junior Prefect':'JP/AP','Class Captain':'CC','Assistant Class Captain':'ACC','Subject Captain':'SC','Emperor':'E','Empress':'EM','Sports Prefect':'SPT','Health & Sanitation Prefect':'HSP','Library Prefect':'LP','Timekeeper Prefect':'TP','Assembly Prefect':'AP','Protocol / Social Prefect':'PSP'};
 const badgeIcon=r=>({prefect:'👑',senior:'🎖️',service:'🤝',civic:'🏛️',academic:'📚',sport:'🏆'}[r]||'🏅');
 const roleInitials=r=>initialsMap[r]||r.split(/\s+/).filter(Boolean).map(x=>x[0]).join('').toUpperCase().slice(0,8);
 const getBadges=async()=>{const r=await fetch(API,{headers:headers()});const d=await r.json();if(!r.ok)throw Error(d.error||'Unable to load leadership records.');return d.badges||[]};
 const qrData=x=>location.href.split('#')[0]+'#scl-leadership-verify='+encodeURIComponent(JSON.stringify({badge_id:x.badge_id,student_id:x.students?.student_id||'',student_name:x.students?.child_name||'',role:x.role,class_name:x.class_name,subject:x.subject||'',leadership_scope:x.leadership_scope||'school',session:x.session||'',status:x.status,awarded_on:x.awarded_on}));
 function qr(el,data){el.innerHTML='';if(typeof QRCode==='function'){new QRCode(el,{text:data,width:170,height:170,colorDark:'#111',colorLight:'#fff',correctLevel:QRCode.CorrectLevel.M});}else{el.innerHTML='<div style="padding:20px;text-align:center">QR generator unavailable</div>'}}
 function badgeVisual(x,side='front'){const photo=x.students?.child_photo_url?'<img src="'+esc(x.students.child_photo_url)+'" style="width:58px;height:58px;border-radius:50%;object-fit:cover;border:3px solid #fff">':'';return side==='front'?'<div style="background:linear-gradient(135deg,#650007,#b51b27);color:#fff;border-radius:16px;padding:18px;min-height:185px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 10px 25px rgba(101,0,7,.18)"><div style="display:flex;justify-content:space-between;align-items:start"><div style="font-size:40px">'+badgeIcon(x.role)+'</div>'+photo+'</div><div><div style="font-size:24px;font-weight:1000;letter-spacing:1px">'+esc(x.role_initials||roleInitials(x.role))+'</div><div style="font-size:13px;font-weight:800">SHINING CHILD LEADERS SCHOOL</div><div style="font-size:11px;margin-top:5px">Official Student Leadership Badge</div></div></div>':'<div style="background:#fff;color:#111;border:2px solid #650007;border-radius:16px;padding:18px;min-height:185px;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center"><div class="scl-v73-print-qr"></div><div style="font-size:10px;font-weight:900;margin-top:5px">SCAN TO VERIFY • '+esc(x.badge_id)+'</div></div>'}
 function printCard(x,mode){
  const w=window.open('','_blank');
  if(!w){toast('Allow pop-ups to print the leadership ID/badge.');return}
  const data=qrData(x),tmp=document.createElement('div');
  tmp.style.cssText='position:fixed;left:-10000px;top:-10000px;width:200px;height:200px;background:#fff';
  document.body.appendChild(tmp);qr(tmp,data);
  setTimeout(()=>{
   const node=tmp.querySelector('canvas')||tmp.querySelector('img');
   const src=node?(node.tagName.toLowerCase()==='canvas'?node.toDataURL('image/png'):node.src):'';
   document.body.removeChild(tmp);
   const title='SCL Leadership '+esc(x.badge_id);
   const modeTitle=mode==='badge'?'Badge — Front & Back':'Identification Card';
   const scope=x.leadership_scope==='subject_class'?('Subject Captain • '+(x.subject||'')):x.leadership_scope==='general_class'?'General Class Captain':'School leadership';
   const html='<!doctype html><html><head><title>'+title+'</title><style>@page{margin:10mm}body{font-family:Arial,sans-serif;color:#111}.sheet{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{border:1px solid #ccc;border-radius:16px;padding:16px;min-height:210px;box-sizing:border-box}.qr{display:flex;justify-content:center}.qr img{width:180px;height:180px}.initial{font-size:30px;font-weight:1000;color:#650007}.muted{font-size:11px;color:#555}@media print{button{display:none}}</style></head><body><h2>Shining Child Leaders School</h2><p>Student Leadership '+modeTitle+'</p><div class="sheet"><div class="card"><div style="font-size:46px">'+badgeIcon(x.role)+'</div><div class="initial">'+esc(x.role_initials||roleInitials(x.role))+'</div><b>SHINING CHILD LEADERS SCHOOL</b><p class="muted">Official Student Leadership Badge</p></div><div class="card"><div class="qr">'+(src?'<img src="'+src+'">':'QR unavailable')+'</div><div class="muted" style="text-align:center">SCAN TO VERIFY • '+esc(x.badge_id)+'</div></div></div><p class="muted">'+esc(scope)+'</p><\/body><\/html>';
   w.document.open();w.document.write(html);w.document.close();w.focus();setTimeout(()=>w.print(),300);
  },180);
 }

 async function loadStudents(){const r=await fetch(API+'?students=1',{headers:headers()});const d=await r.json();if(!r.ok)throw Error(d.error||'Unable to load registered students.');return d.students||[]}
 async function loadAssignments(){const r=await fetch(API+'?assignments=1',{headers:headers()});const d=await r.json();if(!r.ok)throw Error(d.error||'Unable to load teacher assignments.');return d.assignments||[]}
 function renderAssign(students,assignments,mode){const area=document.getElementById('sclLeadershipAdminArea');if(!area)return;const a=auth(),roles=a?.roles||[];const admin=roles.some(r=>['developer','technical_admin','management_admin','affairs_admin'].includes(r));const teaching=roles.some(r=>['teacher','staff'].includes(r));const hasGeneral=admin||assignments.some(x=>x.general_authorized);const hasSubject=admin||assignments.length>0;
   const modes=(hasGeneral?'<option value="general_class">General Class Captain</option>':'')+(hasSubject?'<option value="subject_class">Subject Captain</option>':'');
   area.innerHTML='<div class="mh" style="margin:0 0 8px"><h3 style="margin:0">CLASS & SUBJECT LEADERSHIP ASSIGNMENT</h3></div><div class="scl-v74-help"><b>Shared leadership model:</b> the main General Class Captain handles overall class representation. Each teacher can appoint a separate Subject Captain for the class and subject they teach, spreading responsibility so one student is not overloaded.</div><form class="scl-v73-assign" onsubmit="sclV73Issue(event)"><div class="full"><label>Assignment Type *</label><select id="sclV74Scope" onchange="sclV74RefreshForm()" required>'+modes+'</select></div><div class="full" id="sclV74AssignmentWrap"></div><div><label>Student *</label><select id="sclV73Student" required><option value="">Choose a registered student</option>'+students.map(s=>'<option value="'+esc(s.id)+'" data-class="'+esc(s.class_name||'')+'">'+esc(s.child_name)+' — '+esc(s.student_id||'')+' — '+esc(s.class_name||'')+'</option>').join('')+'</select></div><div id="sclV74RoleWrap"><label>Leadership Role *</label><select id="sclV73Role" required><option>Class Captain</option><option>Assistant Class Captain</option><option>Subject Captain</option></select></div><div><label>Session</label><input id="sclV73Session" value="2026/2027"></div><div><label>Awarded Date</label><input id="sclV73Date" type="date" value="'+new Date().toISOString().slice(0,10)+'"></div><div class="full"><label>Note</label><textarea id="sclV73Note" placeholder="Optional school recognition note"></textarea></div><div class="full scl-v73-actions"><button class="gold" type="submit">👑 ASSIGN & GENERATE QR ID</button></div></form>';
   window.__sclV74Students=students;window.__sclV74Assignments=assignments;window.sclV74RefreshForm();
 }
 window.sclV74RefreshForm=function(){const scope=document.getElementById('sclV74Scope')?.value||'general_class',wrap=document.getElementById('sclV74AssignmentWrap'),role=document.getElementById('sclV73Role'),students=document.getElementById('sclV74Students')||[],assignments=document.getElementById('sclV74Assignments')||[];if(!wrap)return;if(scope==='subject_class'){wrap.innerHTML='<label>My Teaching Assignment *</label><select id="sclV74Assignment" required><option value="">Choose your class and subject</option>'+assignments.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.class_name)+' — '+esc(x.subject)+'</option>').join('')+'</select>';role.innerHTML='<option>Subject Captain</option>';role.disabled=true;const stu=document.getElementById('sclV73Student');if(stu)stu.value='';}else{wrap.innerHTML='<label>General Class *</label><select id="sclV74GeneralClass" required><option value="">Choose the class</option>'+[...new Set(students.map(s=>s.class_name).filter(Boolean))].sort().map(c=>'<option>'+esc(c)+'</option>').join('')+'</select>';role.innerHTML='<option>Class Captain</option><option>Assistant Class Captain</option>';role.disabled=false;}}
 window.sclV73Issue=async function(e){e.preventDefault();try{const scope=document.getElementById('sclV74Scope').value;const body={student_uuid:document.getElementById('sclV73Student').value,role:document.getElementById('sclV73Role').value,leadership_scope:scope,teacher_assignment_id:document.getElementById('sclV74Assignment')?.value||null,session:document.getElementById('sclV73Session').value,awarded_on:document.getElementById('sclV73Date').value,note:document.getElementById('sclV73Note').value};if(scope==='general_class')body.class_name=document.getElementById('sclV74GeneralClass')?.value||'';const r=await fetch(API,{method:'POST',headers:headers(),body:JSON.stringify(body)}),d=await r.json();if(!r.ok)throw Error(d.error||'Unable to issue leadership badge.');toast('Leadership assignment created: '+d.badge.badge_id);sclV73Render();}catch(err){toast(err.message)}};
 window.sclV73Render=async function(){const host=document.getElementById('sclLeadershipBadges');if(!host)return;try{const arr=await getBadges();const q=(document.getElementById('sclLeadershipSearch')?.value||'').toLowerCase();const list=arr.filter(x=>(x.role+' '+x.class_name+' '+(x.subject||'')+' '+(x.students?.child_name||'')+' '+x.badge_id).toLowerCase().includes(q));window.__sclV73Records=list;host.innerHTML=list.length?list.map((x,i)=>'<article class="scl-v73-leadership-card"><div style="display:grid;grid-template-columns:1fr 190px;gap:14px;align-items:center"><div>'+badgeVisual(x,'front')+'<div style="margin-top:8px;font-weight:900;color:#650007">'+esc(x.role_initials)+' • '+esc(x.role)+'</div><div style="font-size:12px">'+esc(x.class_name)+' '+(x.subject?('• '+esc(x.subject)+' '):'')+'• '+esc(x.session||'')+' • '+esc(x.status)+'</div><div style="font-size:11px;color:#666;margin-top:4px">'+(x.leadership_scope==='subject_class'?'Subject Captain':'General / School Leadership')+' • Badge ID: '+esc(x.badge_id)+'</div><div class="scl-v73-actions"><button class="gold" type="button" onclick="sclV73ShowQR('+i+')">▣ Show QR</button><button type="button" onclick="sclV73PrintCard('+i+',\'id\')">🪪 Print ID</button><button type="button" onclick="sclV73PrintCard('+i+',\'badge\')">👑 Print Badge</button></div></div><div><div id="sclqr_'+esc(x.badge_id)+'" class="qrbox"></div></div></div></article>').join(''):'<div class="scl-leadership-empty" style="grid-column:1/-1">No school-issued leadership records found.</div>';list.forEach(x=>{const el=document.getElementById('sclqr_'+x.badge_id);if(el)qr(el,qrData(x))})}catch(err){host.innerHTML='<div class="scl-leadership-empty">'+esc(err.message)+'</div>'}};
 window.sclV73ShowQR=function(i){const x=(window.__sclV73Records||[])[i];if(!x)return;const el=document.getElementById('sclqr_'+x.badge_id);if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.style.outline='4px solid #f2ae00';setTimeout(()=>el.style.outline='',1500)}};
 window.sclV73PrintCard=function(i,mode){const x=(window.__sclV73Records||[])[i];if(x)printCard(x,mode)};
 window.sclV74VerifyQR=async function(){const raw=location.hash||'';const prefix='#scl-leadership-verify=';if(!raw.startsWith(prefix))return;let payload;try{payload=JSON.parse(decodeURIComponent(raw.slice(prefix.length)))}catch(_){return}try{const r=await fetch(API+'?badge_id='+encodeURIComponent(payload.badge_id||''),{headers:headers()});const d=await r.json();const x=d.badges?.[0];if(!r.ok||!x)throw Error('This SCL leadership QR record could not be verified.');const old=document.getElementById('sclV74QRVerify');if(old)old.remove();const box=document.createElement('div');box.id='sclV74QRVerify';box.style.cssText='position:fixed;inset:0;z-index:2147483000;background:rgba(15,15,15,.78);display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box';box.innerHTML='<div style="width:min(520px,100%);background:#fff;border-radius:22px;box-shadow:0 20px 60px rgba(0,0,0,.35);overflow:hidden"><div style="background:linear-gradient(135deg,#650007,#b51b27);color:#fff;padding:18px 20px"><b style="font-size:18px">SHINING CHILD LEADERS SCHOOL</b><div style="font-size:12px;margin-top:4px">Official Leadership QR Verification</div></div><div style="padding:20px"><div style="font-size:30px;font-weight:1000;color:#650007">'+esc(x.role_initials||'')+'</div><h2 style="margin:4px 0 8px">'+esc(x.students?.child_name||payload.student_name||'Student')+'</h2><div style="line-height:1.7;font-size:14px"><b>Role:</b> '+esc(x.role)+'<br><b>Class:</b> '+esc(x.class_name||'')+(x.subject?'<br><b>Subject:</b> '+esc(x.subject):'')+'<br><b>Session:</b> '+esc(x.session||'')+'<br><b>Status:</b> '+esc(x.status)+'<br><b>Awarded:</b> '+esc(x.awarded_on||'')+'<br><b>Badge ID:</b> '+esc(x.badge_id)+'</div><div style="margin-top:16px;padding:10px 12px;border-radius:10px;background:#eef8f1;color:#126b3a;font-weight:800">✓ Verified against the SCL leadership record.</div><button type="button" onclick="document.getElementById(&quot;sclV74QRVerify&quot;).remove();history.replaceState(null,&quot;&quot;,location.pathname+location.search)" style="margin-top:16px;width:100%;padding:11px;border:0;border-radius:10px;background:#650007;color:#fff;font-weight:900">Close</button></div></div>';document.body.appendChild(box)}catch(err){const box=document.createElement('div');box.id='sclV74QRVerify';box.style.cssText='position:fixed;inset:0;z-index:2147483000;background:rgba(15,15,15,.78);display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box';box.innerHTML='<div style="background:#fff;border-radius:18px;padding:22px;max-width:420px"><h3 style="color:#650007">SCL QR Verification</h3><p>'+esc(err.message)+'</p><button onclick="document.getElementById(&quot;sclV74QRVerify&quot;).remove()" style="padding:10px 16px;border:0;border-radius:9px;background:#650007;color:#fff">Close</button></div>';document.body.appendChild(box)}};
 window.addEventListener('hashchange',window.sclV74VerifyQR);document.addEventListener('DOMContentLoaded',()=>setTimeout(window.sclV74VerifyQR,100));
 const oldOpen=window.openSclLeadership;window.openSclLeadership=async function(){if(oldOpen)oldOpen();const area=document.getElementById('sclLeadershipAdminArea'),note=document.getElementById('sclLeadershipAdminNote');try{const a=auth(),rs=a?.roles||[],admin=rs.some(r=>['developer','technical_admin','management_admin','affairs_admin'].includes(r)),teaching=rs.some(r=>['teacher','staff'].includes(r));if(admin||teaching){area.style.display='block';const students=await loadStudents(),assignments=await loadAssignments();renderAssign(students,assignments);if(!admin&&teaching)note.innerHTML='<b>Teaching-staff mode:</b> You can assign a General Class Captain only where you hold the authorised general/class assignment, and a Subject Captain only for a class and subject assigned to you. Other school-wide leadership badges remain administrator-controlled.';}else{area.style.display='none';note.innerHTML='<b>Verification / view mode:</b> Leadership records can be viewed and verified. Class and subject captain assignment requires authorised teaching staff; other leadership badges require school administration.'}await sclV73Render()}catch(e){if(note)note.textContent=e.message}};
 const oldRender=window.sclRenderLeadershipBadges;window.sclRenderLeadershipBadges=window.sclV73Render;
})();
</script>
<script id="scl-v76-alphabetical-organization-safe">
(function(){
  'use strict';
  // Safe peer-list ordering. Unlike V75, this version never rewrites a list
  // merely because a MutationObserver fired; that prevents an observer loop.
  var collator=new Intl.Collator('en',{sensitivity:'base',numeric:true});
  function alpha(a,b){return collator.compare(String(a||'').trim(),String(b||'').trim())}
  function sortSelect(id,keepFirst){
    var el=document.getElementById(id); if(!el||el.tagName!=='SELECT')return;
    var all=Array.prototype.slice.call(el.options); if(all.length<2)return;
    var first=(keepFirst!==false&&all[0]&&all[0].value==='')?all.shift():null;
    var sorted=all.slice().sort(function(a,b){return alpha(a.textContent,b.textContent)});
    var changed=sorted.some(function(o,i){return o!==all[i]});
    if(!changed)return;
    var selected=el.value;
    el.innerHTML=''; if(first)el.appendChild(first); sorted.forEach(function(o){el.appendChild(o)});
    if(Array.prototype.some.call(el.options,function(o){return o.value===selected}))el.value=selected;
  }
  function sortSubjectChecks(){
    var box=document.getElementById('teacherSubjects'); if(!box)return;
    var items=Array.prototype.slice.call(box.querySelectorAll('.subject-check')); if(items.length<2)return;
    var sorted=items.slice().sort(function(a,b){return alpha(a.textContent,b.textContent)});
    if(sorted.some(function(x,i){return x!==items[i]}))sorted.forEach(function(x){box.appendChild(x)});
  }
  function subjectKey(v){return String(v||'').toLowerCase().replace(/&/g,'and').replace(/\([^)]*\)/g,'').replace(/[^a-z0-9]+/g,'').trim()}
  function sortCurriculumSubjects(){
    var sel=document.getElementById('sclCurSubject'); if(!sel)return;
    var opts=Array.prototype.slice.call(sel.options).filter(function(o){return o.value});
    var seen={}; var list=[];
    opts.forEach(function(o){var k=subjectKey(o.textContent);if(k&&!seen[k]){seen[k]=true;list.push(o)}});
    list.sort(function(a,b){return alpha(a.textContent,b.textContent)});
    var current=Array.prototype.map.call(sel.options,function(o){return o.value}).filter(Boolean);
    var next=list.map(function(o){return o.value});
    if(current.length===next.length && current.every(function(v,i){return v===next[i]}))return;
    var selected=sel.value; sel.innerHTML=''; list.forEach(function(o){sel.appendChild(o)});
    if(Array.prototype.some.call(sel.options,function(o){return o.value===selected}))sel.value=selected; else if(list.length)sel.value=list[0].value;
  }
  function sortLeadershipAssignments(){sortSelect('sclV74Assignment',true)}
  function sortKnownLists(){sortCurriculumSubjects();sortSelect('sclSASubject',true);document.querySelectorAll('.scl-profession-select').forEach(function(el){sortSelect(el.id,true)});sortLeadershipAssignments();sortSubjectChecks()}
  if(typeof window.renderResults==='function'){
    var oldRenderResults=window.renderResults;
    window.renderResults=function(list){var copy=(list||[]).map(function(r){var x=Object.assign({},r);x.subjects=(r.subjects||[]).slice().sort(function(a,b){return alpha(a.subject,b.subject)});return x});return oldRenderResults(copy)};
  }
  var queued=false;
  function safeSort(){if(queued)return;queued=true;setTimeout(function(){queued=false;sortKnownLists()},0)}
  document.addEventListener('DOMContentLoaded',function(){sortKnownLists();var observer=new MutationObserver(safeSort);observer.observe(document.body,{subtree:true,childList:true});setTimeout(sortKnownLists,300);setTimeout(sortKnownLists,1000)});
  if(document.readyState!=='loading')sortKnownLists();
  window.sclAlphabeticalSort={sortKnownLists:sortKnownLists,sortSelect:sortSelect,alpha:alpha};
})();
</script>
<script id="scl-v76-curriculum-classification">
(function(){
  'use strict';
  function key(v){return String(v||'').toLowerCase().replace(/&/g,'and').replace(/\([^)]*\)/g,'').replace(/[^a-z0-9]+/g,'').trim()}
  var JR={
    beautyandcosmetology:['P.S','jr-ps'],businessstudies:['C','jr-c'],christianandreligiousstudies:['C','jr-c'],christianreligiousstudies:['C','jr-c'],
    computerhardwareandgsmrepair:['P.S','jr-ps'],culturalandcreativearts:['C','jr-c'],digitaltechnology:['C','jr-c'],digitaltechnologies:['C','jr-c'],
    englishstudies:['C','jr-c'],fashiondesignandgarmentmaking:['P.S','jr-ps'],french:['NC','jr-nc'],foreignlanguage:['NC','jr-nc'],
    horticulturalandcropproduction:['C','jr-c'],intermediatescience:['C','jr-c'],islamicreligiousstudies:['C','jr-c'],islamicstudies:['C','jr-c'],
    livestockfarming:['C','jr-c'],mathematics:['C','jr-c'],nigerianhistory:['NC','jr-nc'],physicalandhealtheducation:['C','jr-c'],
    socialandcitizenshipstudies:['C','jr-c'],solarpvinstallationandmaintenance:['P.S','jr-ps'],solarpvinstallationandmaintenancework:['P.S','jr-ps'],
    solarpvinstallationandmaintenace:['P.S','jr-ps'],nigerianlanguage:['C','jr-c'],nigerianlanguages:['C','jr-c'],igbo:['C','jr-c'],yoruba:['C','jr-c'],hausa:['C','jr-c']
  };
  var SS={
    agriculturescience:['S','ss-s'],agriculture:['S','ss-s'],beautyandcosmetology:['P.S','ss-ps'],biology:['S','ss-s'],
    cateringandcraftpractice:['A','ss-a'],chemistry:['S','ss-s'],christianreligiousstudies:['A','ss-a'],christianandreligiousstudies:['A','ss-a'],
    citizenshipandheritagestudies:['C','ss-c'],commerce:['C.O','ss-co'],computerknowledgeandgsmrepair:['P.S','ss-ps'],computerhardwareandgsmrepair:['P.S','ss-ps'],
    digitaltechnology:['C','ss-c'],digitaltechnologies:['C','ss-c'],economics:['C.O','ss-co'],english:['C','ss-c'],englishlanguage:['C','ss-c'],
    fashiondesignandgarmentmaking:['P.S','ss-ps'],financialaccounting:['C.O','ss-co'],foodandnutrition:['C','ss-c'],foodsandnutrition:['C','ss-c'],
    furthermaths:['S','ss-s'],furthermathematics:['S','ss-s'],geography:['S','ss-s'],government:['E','ss-e'],
    horticulturalandcropproduction:['P.S','ss-ps'],literatureinenglish:['A','ss-a'],literatureinenglish:['A','ss-a'],
    nigerianlanguage:['C','ss-c'],nigerianlanguages:['C','ss-c'],foreignlanguage:['E','ss-e'],french:['E','ss-e'],
    livestockfarming:['P.S','ss-ps'],marketing:['C.O','ss-co'],mathematics:['C','ss-c'],nigerianhistory:['E','ss-e'],physics:['S','ss-s'],
    solarpvinstallationandmaintenance:['P.S','ss-ps'],solarpvinstallationandmaintenancework:['P.S','ss-ps'],technicaldrawing:['S','ss-s'],technicaldrawings:['S','ss-s'],
    visualarts:['A','ss-a'],visualart:['A','ss-a']
  };
  function badge(code,cls){return '<span class="scl-subject-badge '+cls+'" title="'+code+'">'+code+'</span>'}
  function classify(subject,klass){
    var k=key(subject), c=key(klass);
    if(/^jss/.test(c))return JR[k]||null;
    if(/^sss/.test(c))return SS[k]||null;
    return null;
  }
  function decorateSelect(){
    var sel=document.getElementById('sclCurSubject'); if(!sel)return;
    Array.prototype.forEach.call(sel.options,function(o){
      if(!o.value)return;
      var raw=o.dataset.sclRaw||o.textContent.replace(/^\[[^\]]+\]\s*/,''); o.dataset.sclRaw=raw;
      var c=classify(raw,(document.getElementById('sclCurClass')||{}).value||'');
      var label=c?'['+c[0]+'] '+raw:raw;
      if(o.textContent!==label)o.textContent=label;
    });
  }
  function addLegend(){
    var box=document.getElementById('sclCurriculum'); if(!box||box.querySelector('.scl-curriculum-legend'))return;
    var legend=document.createElement('div'); legend.className='scl-curriculum-legend';
    legend.innerHTML='<span class="legend-item">Junior: '+badge('C','jr-c')+' Compulsory</span><span class="legend-item">'+badge('P.S','jr-ps')+' Practical Subject</span><span class="legend-item">'+badge('NC','jr-nc')+' Non-Compulsory</span><span class="legend-item">Senior: '+badge('S','ss-s')+' Science</span><span class="legend-item">'+badge('A','ss-a')+' Arts</span><span class="legend-item">'+badge('C.O','ss-co')+' Commercial</span><span class="legend-item">'+badge('E','ss-e')+' Elective/Humanities</span><span class="legend-item">'+badge('C','ss-c')+' Core/Compulsory</span><span class="legend-item">'+badge('P.S','ss-ps')+' Practical Subject</span>';
    var first=box.firstElementChild; if(first)box.insertBefore(legend,first); else box.appendChild(legend);
  }
  function decorateResults(){
    var box=document.getElementById('sclCurriculumResult'), cls=(document.getElementById('sclCurClass')||{}).value||''; if(!box)return;
    Array.prototype.forEach.call(box.querySelectorAll('h4'),function(h){
      if(h.dataset.sclBadgeDone==='1')return;
      var txt=h.textContent||''; var parts=txt.split(' — '); if(parts.length<3)return;
      var c=classify(parts[1],cls); if(!c)return;
      h.innerHTML='<span class="scl-curriculum-subject-line">'+badge(c[0],c[1])+'<span class="subject-name">'+parts.map(function(x){return x.replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]})}).join(' — ')+'</span></span>';
      h.dataset.sclBadgeDone='1';
    });
  }
  function run(){addLegend();decorateSelect();decorateResults()}
  document.addEventListener('DOMContentLoaded',function(){
    run();
    var c=document.getElementById('sclCurClass'); if(c)c.addEventListener('change',function(){setTimeout(run,0)});
    var observer=new MutationObserver(function(){setTimeout(run,0)});
    var target=document.getElementById('sclCurriculum')||document.body; observer.observe(target,{subtree:true,childList:true});
    setTimeout(run,300);setTimeout(run,1000);
  });
  if(document.readyState!=='loading')run();
  window.sclCurriculumSubjectClassification={classify:classify,badge:badge,run:run};
})();
</script>
<script id="scl-v77-curriculum-notes-drive-integration">
(function(){
  'use strict';
  var NOTES_FOLDER_ID='1unI9cEouRAyGDEn3-1hdVVIdiw-uIigp';
  var NOTES_FOLDER_URL='https://drive.google.com/drive/folders/'+NOTES_FOLDER_ID;
  function by(id){return document.getElementById(id)}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]})}
  function norm(v){return String(v||'').toLowerCase().replace(/&/g,'and').replace(/[()]/g,'').replace(/[^a-z0-9]+/g,'').trim()}
  function notesSearchUrl(topic){
    var clean=String(topic||'').replace(/\s+/g,' ').replace(/[•|]+/g,' ').trim();
    clean=clean.replace(/^[-–—:]+|[-–—:]+$/g,'').trim();
    if(!clean) return NOTES_FOLDER_URL;
    var words=clean.split(/\s+/).filter(Boolean).slice(0,6).join(' ');
    var q='title:'+words+' in:'+NOTES_FOLDER_ID;
    return 'https://drive.google.com/drive/search?q='+encodeURIComponent(q);
  }
  function folderLink(){return '<a class="scl-notes-folder-link" href="'+NOTES_FOLDER_URL+'" target="_blank" rel="noopener noreferrer">📚 OPEN SUBJECT NOTES</a>'}
  function topicLink(label,subject,week){
    var clean=String(label||'').replace(/\s+/g,' ').trim();
    if(!clean)return '';
    var qLabel=clean;
    if(qLabel.length>90)qLabel=qLabel.split(/[,:;.!?]/)[0].trim();
    if(!qLabel)qLabel=clean.slice(0,80);
    var url=notesSearchUrl(subject+' '+qLabel);
    return '<a class="scl-topic-note-link" href="'+esc(url)+'" target="_blank" rel="noopener noreferrer" title="Open '+esc(qLabel)+' notes in the SCL Subject Notes folder">'+esc(clean)+'</a>';
  }
  function renderLine(line,subject,week){
    var clean=String(line||'').trim();
    if(!clean)return '';
    if(/^(midterm|mid-term)\s+(examination|exam)|^(midterm|mid-term)\s+break|^revision\b|^examination\b|^closing\b/i.test(clean)) return '<div class="scheme-line">'+esc(clean)+'</div>';
    var parts=clean.split(/\s*;\s*/).map(function(x){return x.trim()}).filter(Boolean);
    if(parts.length<2){
      return '<div class="scheme-line"><span class="scheme-topic-text">'+esc(clean)+'</span> '+topicLink('🔗 Notes',subject,week)+'</div>';
    }
    return '<div class="scheme-line">'+parts.map(function(p){return '<span class="scheme-topic-chip">'+topicLink(p,subject,week)+'</span>'}).join(' <span class="scheme-topic-sep">•</span> ')+'</div>';
  }
  function renderPage(x){
    var raw=String(x&&x.text||'').replace(/\r/g,'').trim();
    var stripped=raw.replace(/^\d+\s*/,'');
    var weekRe=/(?:^|\s)(?:Week\s*)?(\d{1,2})\s+/gi, starts=[],m;
    while((m=weekRe.exec(stripped))!==null){var n=Number(m[1]);if(n>=1&&n<=13)starts.push({n:n,start:m.index+(m[0].startsWith(' ')?1:0)});}
    var unique=[],seen={};starts.forEach(function(v){if(!seen[v.n]){seen[v.n]=1;unique.push(v)}});
    if(unique.length<2){return '<div class="scheme-content"><section class="scheme-paper"><div class="scheme-paper-body">'+esc(stripped)+'</div><div class="scheme-notes-footer">'+topicLink('Open notes for this scheme',x.subject,'')+'</div></section></div>';}
    var cards=[];
    unique.forEach(function(v,i){
      var a=v.start,b=i+1<unique.length?unique[i+1].start:stripped.length;
      var body=stripped.slice(a,b).trim().replace(/^\d{1,2}\s+/,'');
      body=body.replace(/\s+(?=(Midterm Examination|Mid-Term Examination|Midterm Break|Mid-Term Break|Revision|Examination|Closing|Closing \/ Vacation)\b)/gi,'\n\n');
      body=body.replace(/\s+(?=(Week\s+\d+\b))/gi,'\n');
      var lines=body.split(/\n+/).map(function(z){return z.trim()}).filter(Boolean);
      var searchUrl=notesSearchUrl(String(x.subject||'')+' Week '+v.n);
      cards.push('<section class="scheme-week-card"><div class="scheme-week-title"><span>Week '+esc(v.n)+'</span><a class="scl-week-notes-link" href="'+esc(searchUrl)+'" target="_blank" rel="noopener noreferrer">📚 Notes</a></div><div class="scheme-week-body">'+lines.map(function(line){return renderLine(line,x.subject,v.n)}).join('')+'</div></section>');
    });
    return '<div class="scheme-content">'+cards.join('')+'</div>';
  }
  function show(){
    var c=by('sclCurClass'),t=by('sclCurTerm'),s=by('sclCurSubject'),box=by('sclCurriculumResult');
    if(!c||!t||!s||!box)return;
    var data=Array.isArray(window.sclPages)?window.sclPages:[];
    var C=norm(c.value),T=norm(t.value),S=norm(s.value);
    var matches=data.filter(function(x){return norm(x.class)===C&&norm(x.term)===T&&norm(x.subject)===S});
    var note='';
    if(!matches.length){
      matches=data.filter(function(x){return norm(x.class)===C&&norm(x.term)===T});
      if(matches.length)note='<div class="scheme-empty"><strong>The selected subject was not labelled exactly in the supplied curriculum.</strong><br>Showing the available scheme pages for '+esc(c.value)+' — '+esc(t.value)+' instead.</div>';
    }
    if(!matches.length){box.innerHTML='<div class="scheme-empty"><strong>No scheme pages were found for this selection.</strong><br>Please choose another class, term or subject.</div>';return;}
    box.innerHTML=note+'<div class="scheme-summary"><div><strong>'+esc(c.value)+' • '+esc(s.value)+' • '+esc(t.value)+'</strong><div class="scheme-notes-summary">'+folderLink()+'</div></div><span>'+matches.length+' supplied page(s)</span></div>'+matches.map(function(x){return '<article class="scl-result-card"><h4>'+esc(x.class)+' — '+esc(x.subject)+' — '+esc(x.term)+'</h4>'+renderPage(x)+'</article>'}).join('');
    box.scrollIntoView({behavior:'smooth',block:'start'});
  }
  function addPublicNotesButton(){
    var head=document.querySelector('#sclCurriculum .scl-learning-head');
    if(!head||head.querySelector('.scl-notes-top-link'))return;
    var b=document.createElement('a');b.className='scl-btn alt scl-notes-top-link';b.href=NOTES_FOLDER_URL;b.target='_blank';b.rel='noopener noreferrer';b.textContent='📚 SUBJECT NOTES';b.title='Open the SCL Subject Notes folder';
    var view=head.querySelector('button'); if(view&&view.parentNode===head)view.parentNode.insertBefore(b,view);else head.appendChild(b);
  }
  window.SCL_SUBJECT_NOTES={folderUrl:NOTES_FOLDER_URL,folderId:NOTES_FOLDER_ID,search:notesSearchUrl};
  window.sclShowCurriculum=show;
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',addPublicNotesButton);else addPublicNotesButton();
})();
</script>
<style id="scl-v77-curriculum-notes-css">
.scl-notes-top-link{display:inline-flex!important;align-items:center;justify-content:center;text-decoration:none!important;white-space:nowrap}
.scheme-notes-summary{margin-top:7px}.scl-notes-folder-link{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border-radius:999px;background:#fff;border:1px solid #d69b25;color:#650007!important;font-weight:900;text-decoration:none!important;font-size:12px}
.scheme-week-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.scl-week-notes-link{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.42);color:#fff!important;text-decoration:none!important;font-size:11px;font-weight:900;white-space:nowrap}.scl-week-notes-link:hover{background:rgba(255,255,255,.28)}
.scl-topic-chip{display:inline}.scl-topic-note-link{color:#126b3a!important;font-weight:800;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:2px}.scl-topic-note-link:hover{color:#650007!important}.scheme-topic-sep{color:#c08a1e;font-weight:900}.scheme-topic-text{font-weight:600}.scheme-notes-footer{padding:10px 16px;border-top:1px solid #eadfce;text-align:right}
@media(max-width:650px){.scl-notes-top-link{width:100%;order:3}.scheme-week-title{align-items:flex-start}.scl-week-notes-link{font-size:10px;padding:5px 7px}.scheme-line{line-height:1.65}}
</style>
<style id="scl-v70-final-user-adjustments">
/* V70 FINAL USER-APPROVED VISUAL/ROUTING PASS — additive overrides only. */
#sclThemeToggle{left:auto!important;right:10px!important;top:10px!important;transform:none!important;z-index:10070!important}
#sclThemeToggle.scl-theme-spinning{animation:sclThemeCoinSpinRight .72s cubic-bezier(.22,.61,.36,1) both!important}
@keyframes sclThemeCoinSpinRight{0%{transform:rotate(0deg) scale(1)}45%{transform:rotate(180deg) scale(1.05)}100%{transform:rotate(360deg) scale(1)}}
.scl-logo-coin-dock{top:10px!important;left:50%!important;right:auto!important;z-index:10040!important}
.scl-hero-image-panel{background:rgba(101,0,7,.08)!important;box-shadow:inset 0 0 55px rgba(255,255,255,.12),0 18px 40px rgba(0,0,0,.18)!important;position:absolute!important;overflow:hidden!important;isolation:isolate!important}
.scl-hero-poster{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:contain!important;object-position:center!important;padding:10px!important;box-sizing:border-box!important;z-index:1!important;border-radius:24px!important;filter:saturate(1.03) contrast(1.01)!important}
.scl-hero-transparent-effect{position:absolute!important;inset:0!important;z-index:3!important;pointer-events:none!important;background:radial-gradient(circle at 50% 48%,rgba(255,255,255,.10),transparent 45%)!important}
.scl-hero-transparent-effect .hero-orbit{border-color:rgba(255,255,255,.24)!important}
.scl-hero-transparent-effect .orbit-two{border-color:rgba(255,211,61,.30)!important}
.scl-hero-transparent-effect .hero-star{opacity:.78!important;text-shadow:0 2px 14px rgba(101,0,7,.35)!important}
.scl-hero-image-caption{position:absolute;left:14px;right:14px;bottom:12px;z-index:4;text-align:center;padding:7px 10px;border-radius:999px;background:rgba(101,0,7,.62);backdrop-filter:blur(3px);color:#fff;font-size:clamp(9px,1vw,13px);font-weight:900;letter-spacing:.10em;text-shadow:0 2px 8px rgba(0,0,0,.35)}
/* Friday: closing period is the final visible academic column; later columns are truly blank. */
.scl-tt-friday-closing{background:#ffd6a5!important;border-color:#d58b32!important}
.scl-tt-friday-closing .scl-tt-empty-cell{background:rgba(255,255,255,.22)!important}
.scl-tt-friday-closed,.scl-tt-friday-closed td,.scl-tt-friday-closed th{background:transparent!important}
.scl-tt-friday-closed .scl-tt-empty-cell{background:transparent!important;border:0!important;min-height:20px!important}
/* Same colour for Short Break and Long Break everywhere in the timetable. */
.scl-tt-period-sb,.scl-tt-period-lb,.scl-tt-row-sb td,.scl-tt-row-sb th,.scl-tt-row-lb td,.scl-tt-row-lb th{background:#e9ddff!important}
/* Make attendance controls large and easy to tap on phones. */
.scl-att-present-switch{min-width:142px;min-height:44px;justify-content:center;font-size:13px!important;touch-action:manipulation}
.scl-att-state-slider{display:inline-flex!important;min-width:150px!important;min-height:44px!important;padding:3px!important;border:2px solid #d8c6aa!important;border-radius:999px!important;background:#fff8ef!important;gap:3px!important}
.scl-att-state-slider button{min-width:68px!important;min-height:36px!important;border:0!important;border-radius:999px!important;font-weight:900!important;cursor:pointer!important;touch-action:manipulation}
.scl-att-state-slider button.active.absent{background:#dc2626!important;color:#fff!important;box-shadow:0 2px 8px rgba(220,38,38,.25)!important}
.scl-att-state-slider button.active.late{background:#eab308!important;color:#261a00!important;box-shadow:0 2px 8px rgba(234,179,8,.25)!important}
.scl-att-locked{opacity:.62!important;cursor:not-allowed!important}
@media(max-width:600px){
 #sclThemeToggle{right:8px!important;top:8px!important;width:40px!important;height:40px!important}
 .scl-logo-coin-dock{top:8px!important}
 .scl-hero-image-panel{right:5%!important;top:44%!important;width:90%!important;height:48%!important;border-radius:22px!important}
 .scl-hero-poster{padding:5px!important;border-radius:18px!important}
 .scl-hero-image-caption{left:8px;right:8px;bottom:7px;padding:5px 7px;font-size:8px}
 .scl-att-present-switch{min-width:132px!important}
 .scl-att-state-slider{min-width:142px!important}
}
</style>
<style id="scl-tt-v2-adjustments">.scl-new-smart-tt .cell.fixed{flex:.85;font-weight:900;font-size:.64rem;color:var(--text);background:var(--panel-2)}.scl-new-smart-tt .cell.break,.scl-new-smart-tt .cell.lunch{border-top:2px solid #d32f2f!important;border-bottom:2px solid #d32f2f!important;color:#b71c1c!important;background:#fff1f1!important;font-weight:900!important}.scl-new-smart-tt .time-header .cell{font-weight:950!important;color:var(--text)!important;font-size:.72rem!important}.scl-new-smart-tt .tt-mode-note{margin:0 0 10px;padding:7px 10px;border-radius:9px;border:1px solid var(--line);font-size:.72rem;font-weight:700;color:var(--text-dim);background:var(--panel-2)}.scl-new-smart-tt input[readonly]{opacity:.82;cursor:default}</style><script id="scl-v70-final-routing-repair">
(function(){
 'use strict';
 function closeShortcut(){try{window.sclCloseShortcutBar?.()}catch(_){}
 }
 function openSuite(tab){closeShortcut();openM('sclSuiteModal');setTimeout(function(){window.sclSuiteTab?.(tab)},0)}
 window.sclOpenShortcutDestination=function(key){
   closeShortcut();
   const routes={
    attendance:()=>openSuite('attendance'),timetable:()=>openSuite('timetable'),assignments:()=>openSuite('assignments'),cbt:()=>openSuite('cbt'),lessons:()=>openSuite('lessons'),bulk:()=>openSuite('bulk'),promotion:()=>{try{openM('reg');window.sclRegistrationMode?.('returning')}catch(_){pickRegistration()}},engagement:()=>openCollaboration(),announcements:()=>openSclAlerts(),
    anthem:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('anthem'),80)},medals:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('medals'),80)},studentRanking:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('studentRanking'),80)},rank:()=>window.sclOpenServiceRank?.(),
    environment:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('gallery'),80)},collaboration:()=>openCollaboration(),children:()=>openMyChildren(),profile:()=>window.sclOpenModernProfile?.(),admin:()=>window.sclOpenModernProfile?.(),fees:()=>openFees(),materials:()=>openMaterials(),results:()=>openResults(),uniform:()=>openUniformCatalogue(),uniformAdmin:()=>openUniformAdmin(),workers:()=>openWorkers(),staffAttendance:()=>window.sclOpenAttendance?.(),adminAttendance:()=>window.sclOpenAttendance?.('admin'),branch:()=>window.sclOpenBranchAdmin?.(),formerStaff:()=>window.sclOpenFormerStaffRecords?.(),salary:()=>openSalaryAdmin(),badges:()=>window.openSclLeadership?.(),certificateAdmin:()=>openCertificateAdmin(),certificates:()=>openCertificate(),curriculum:()=>window.openSchoolCurriculum?.(),support:()=>openWhatsAppChoices(),register:()=>pickRegistration(),ai:()=>window.sclAskAI?.(),rankMaintenance:()=>window.sclOpenServiceRank?.()
   }; const fn=routes[key];if(fn)fn();else openSuite('attendance');
 };
 /* Rebind every shortcut item from its label, so every shortcut has a real destination. */
 const map={
  'Admin Attendance Register':'adminAttendance','Already Paid / Bulk Payment':'bulkPayment','Announcements & Notifications':'announcements','Assignments & Assessment':'assignments','Birthdays, Awards & Activity':'engagement','Branch & GPS Setup':'branch','Bulk Data / Excel':'bulk','CBT & Online Tests':'cbt','Certificate Administration':'certificateAdmin','Certificates':'certificates','Collaborators & Activities':'collaboration','Community Manager':'collaboration','Former Staff Records':'formerStaff','Full Admin Dashboard':'admin','Leadership Badge Manager':'badges','Leadership Badges':'badges','Lesson Notes / Plans':'lessons','Medals & Records':'medals','My Children':'children','My SCL Profile':'profile','My Service Rank':'rank','Rank Maintenance':'rankMaintenance','Register Your Child':'register','Salary / Attendance Review':'salary','School Anthem':'anthem','School Curriculum':'curriculum','School Environment Gallery':'environment','School Fees & Payment':'fees','School Materials':'materials','School Results':'results','School Uniform':'uniform','Staff / Worker Registration':'workers','Staff Attendance':'staffAttendance','Student Promotion':'promotion','Support':'support','Timetable & Scheduling':'timetable','Uniform Management':'uniformAdmin'
 };
 const oldBulk=window.openBulkPayment;
 window.sclOpenShortcutDestination=function(key){
  closeShortcut();
  if(key==='bulkPayment'){oldBulk?.();return}
  const routes={attendance:()=>openSuite('attendance'),timetable:()=>openSuite('timetable'),assignments:()=>openSuite('assignments'),cbt:()=>openSuite('cbt'),lessons:()=>openSuite('lessons'),bulk:()=>openSuite('bulk'),promotion:()=>{openM('reg');window.sclRegistrationMode?.('returning')},engagement:()=>openCollaboration(),announcements:()=>openSclAlerts(),anthem:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('anthem'),80)},medals:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('medals'),80)},studentRanking:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('studentRanking'),80)},rank:()=>window.sclOpenServiceRank?.(),environment:()=>{openLogoGallery();setTimeout(()=>window.showCommunityTab?.('gallery'),80)},collaboration:()=>openCollaboration(),children:()=>openMyChildren(),profile:()=>window.sclOpenModernProfile?.(),admin:()=>window.sclOpenModernProfile?.(),fees:()=>pickFees(),materials:()=>openMaterials(),results:()=>openResults(),uniform:()=>openUniformCatalogue(),uniformAdmin:()=>openUniformAdmin(),workers:()=>openWorkers(),staffAttendance:()=>window.sclOpenAttendance?.(),adminAttendance:()=>window.sclOpenAttendance?.('admin'),branch:()=>window.sclOpenBranchAdmin?.(),formerStaff:()=>window.sclOpenFormerStaffRecords?.(),salary:()=>openSalaryAdmin(),badges:()=>window.openSclLeadership?.(),certificateAdmin:()=>openCertificateAdmin(),certificates:()=>openCertificate(),curriculum:()=>window.openSchoolCurriculum?.(),support:()=>openWhatsAppChoices(),register:()=>pickRegistration(),ai:()=>window.sclAskAI?.(),rankMaintenance:()=>window.sclOpenServiceRank?.()};
  const fn=routes[key];if(fn)fn();else openSuite('attendance');
 };
 function bindShortcuts(){document.querySelectorAll('#sclShortcutGrid .scl-shortcut-item').forEach(function(b){const label=b.dataset.shortcutLabel;if(!map[label]||b.dataset.v70route==='1')return;b.dataset.v70route='1';b.onclick=function(e){e.preventDefault();e.stopPropagation();window.sclOpenShortcutDestination(map[label]);};});}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bindShortcuts);else bindShortcuts();
 /* The theme control must never occupy the centre logo position. */
 const theme=document.getElementById('sclThemeToggle');if(theme){theme.style.left='auto';theme.style.right='10px';theme.style.top='10px';theme.style.transform='none';}
 /* One-button timetable transition: PRIMARY <-> SECONDARY. */
 window.sclToggleTimetableMode=function(){
  const active=document.querySelector('.scl-tt-mode[data-tt-mode].active')?.dataset.ttMode;
  const next=active==='secondary'?'primary':'secondary';
  document.querySelector('.scl-tt-mode[data-tt-mode="'+next+'"]')?.click();
 };
 function addTimetableToggle(){
  const tabs=document.querySelector('.scl-tt-mode-tabs');if(!tabs||tabs.querySelector('.scl-tt-toggle-all'))return;
  const b=document.createElement('button');b.type='button';b.className='scl-tt-mode scl-tt-toggle-all';b.textContent='↔ Switch Primary / Secondary';b.title='Switch between the Primary and Secondary timetable';b.onclick=function(){window.sclToggleTimetableMode()};tabs.appendChild(b);
 }
 const oldShell=window.shell; if(typeof oldShell==='function'){
  window.shell=function(){const r=oldShell.apply(this,arguments);setTimeout(addTimetableToggle,0);return r;};
 }
 document.addEventListener('click',function(e){if(e.target.closest('[data-tt-mode]'))setTimeout(addTimetableToggle,0);});
})();
</script>
<script id="scl-v78-aiei-subject-notes-search">
(function(){
  'use strict';
  var FOLDER_ID='1unI9cEouRAyGDEn3-1hdVVIdiw-uIigp';
  var FOLDER_URL='https://drive.google.com/drive/folders/'+FOLDER_ID;
  function searchUrl(q){var clean=String(q||'').replace(/\s+/g,' ').trim();if(!clean)return FOLDER_URL;var words=clean.split(/\s+/).slice(0,8).join(' ');return 'https://drive.google.com/drive/search?q='+encodeURIComponent('title:"'+words+'" in:'+FOLDER_ID)}
  function installBox(){var box=document.getElementById('sclAiModal');if(!box||box.querySelector('#sclAIEINotesSearch'))return;var response=document.getElementById('sclAiResponse');if(!response)return;var panel=document.createElement('div');panel.id='sclAIEINotesSearch';panel.innerHTML='<div class="scl-aiei-notes-card"><div><strong>📚 SUBJECT NOTES</strong><div class="scl-aiei-notes-help">Search the SCL Subject Notes folder for the topic you asked about.</div></div><a id="sclAIEINotesLink" class="scl-btn alt" target="_blank" rel="noopener noreferrer">OPEN RELATED NOTES</a></div>';response.insertAdjacentElement('afterend',panel)}
  function update(q){installBox();var panel=document.getElementById('sclAIEINotesSearch'),link=document.getElementById('sclAIEINotesLink');if(!panel||!link)return;var clean=String(q||'').trim();if(!clean){panel.style.display='none';return}panel.style.display='block';link.href=searchUrl(clean);link.textContent='OPEN NOTES FOR “'+clean.slice(0,55)+'”';link.title='Search the SCL Subject Notes folder for '+clean}
  function hook(){installBox();var input=document.getElementById('sclAiInput');if(input&&!input.dataset.sclNotesHook){input.dataset.sclNotesHook='1';input.addEventListener('input',function(){update(input.value)})}if(typeof window.sclAskAI==='function'&&!window.sclAskAI.__sclV78Wrapped){var original=window.sclAskAI;var wrapped=async function(){var q=(document.getElementById('sclAiInput')?.value||'').trim();update(q);var result=await original.apply(this,arguments);update(q);return result};wrapped.__sclV78Wrapped=true;window.sclAskAI=wrapped}}
  document.addEventListener('click',function(e){var target=e.target.closest?.('.scl-ai-float,[onclick*="sclAskAI"],[onclick*="sclAskAI()"]');if(target)setTimeout(hook,0)});
  document.addEventListener('DOMContentLoaded',function(){setTimeout(hook,400);setTimeout(hook,1200)});
  if(document.readyState!=='loading')setTimeout(hook,0);
  window.SCL_AIEI_SUBJECT_NOTES={folderId:FOLDER_ID,folderUrl:FOLDER_URL,search:searchUrl};
})();
</script>
<style id="scl-v78-aiei-notes-css">
.scl-aiei-notes-card{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:12px 14px;border:1px solid #e7d7b9;border-radius:14px;background:#fff8e9;box-shadow:0 3px 12px rgba(31,20,10,.05)}.scl-aiei-notes-card strong{color:#650007;font-size:14px}.scl-aiei-notes-help{font-size:12px;color:#66574a;margin-top:3px;line-height:1.4}.scl-aiei-notes-card .scl-btn{white-space:nowrap;text-decoration:none!important}@media(max-width:600px){.scl-aiei-notes-card{align-items:stretch;flex-direction:column}.scl-aiei-notes-card .scl-btn{width:100%;text-align:center}}
</style>
<style id="scl-v79-timetable-css">
.scl-home-timetable-btn{background:linear-gradient(135deg,#f8d56a,#c9971a)!important;color:#3b2300!important;border:2px solid rgba(255,255,255,.75)!important;box-shadow:0 8px 22px rgba(120,75,0,.22)!important;border-radius:18px!important;font-weight:800!important}.scl-home-timetable-btn .scl-home-book{font-size:28px;display:block;margin-bottom:3px}.scl-tt-fixed-cell{vertical-align:middle!important}.scl-tt-fixed-block{min-height:74px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;border-radius:12px;padding:7px;background:#f2f2f2;color:#4d4d4d}.scl-tt-fixed-block b{font-size:12px}.scl-tt-fixed-block small{font-size:10px}.scl-tt-period-t1,.scl-tt-period-t2,.scl-tt-period-t3{background:#f7f7f7}.scl-tt-period-sb{background:#e9ddff}.scl-tt-period-lb{background:#e9ddff}.scl-tt-period-p5 .scl-tt-fixed-block{background:#ffd6a5}.scl-tt-period-lesson .scl-tt-fixed-block{background:#dff2ff}.scl-v70-week{min-width:1450px}.scl-v70-week-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}.scl-tt-period-head{min-width:112px}.scl-tt-period-head small,.scl-tt-period-head em{display:block;font-size:10px;line-height:1.25}.scl-tt-period-head em{font-style:normal;opacity:.7;margin-top:2px}</style>
<div aria-hidden="true" class="scl-school-view" id="sclSchoolView">
<div class="scl-school-view-head"><h2>🏫 SCL SCHOOL VIEW</h2><button class="scl-school-view-close" onclick="closeSclSchoolView()" type="button">CLOSE</button></div>
<div class="scl-school-view-grid">
<section class="scl-school-view-card"><h3>🗓️ Today's Timetable</h3><div class="scl-school-view-list" id="sclSchoolViewToday"><div class="scl-school-view-note">Loading today's school timetable…</div></div></section>
<aside class="scl-school-view-card"><h3>🔔 School Notifications</h3><div class="scl-school-view-clock" id="sclSchoolViewClock">--:--</div><div class="scl-school-view-today" id="sclSchoolViewDate"></div><p class="scl-school-view-note">This clean display is designed for the school's Mac or Windows computer screen. It uses the same SCL website and the same live data, so there is no second system to maintain.</p><button class="btn primary" onclick="requestSclNotifications(true)" type="button">🔔 ENABLE NOTIFICATIONS</button></aside>
</div>
</div>
<script id="scl-role-capability-policy">
(function(){
  'use strict';
  function auth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
  function roles(){return (auth()?.roles||[]).map(x=>String(x).toLowerCase())}
  const TECH=['developer','technical_admin'];
  const MGMT=['management_admin'];
  const AFFAIRS=['affairs_admin'];
  const RECIPIENTS=['student','teacher','staff','developer','technical_admin','management_admin','affairs_admin'];
  function has(list){return roles().some(r=>list.includes(r))}
  window.sclRolePolicy={
    roles, isTechnicalAdmin:()=>has(TECH), isManagementAdmin:()=>has(MGMT), isAffairsAdmin:()=>has(AFFAIRS),
    isAdmin:()=>has(TECH.concat(MGMT,AFFAIRS)),
    canNegotiateFees:()=>has(MGMT),
    canControlTimetableAlerts:()=>has(TECH.concat(MGMT,AFFAIRS)),
    canReceiveTimetableAlerts:()=>has(RECIPIENTS)
  };
})();
</script>
<script id="scl-v80-final-integrity-and-notifications">
(function(){
  'use strict';
  const SUPA=(window.SCL_SUPABASE_URL||'').replace(/\/$/,'');
  const NOTIF_KEY='sclNotificationPermissionV80';
  const MASTER_KEY='sclTimetableAlertsMaster';
  function auth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
  function policy(){return window.sclRolePolicy||{canControlTimetableAlerts:()=>false,canReceiveTimetableAlerts:()=>false,isTechnicalAdmin:()=>false,isManagementAdmin:()=>false,isAdmin:()=>false}}
  function eligible(){return !!policy().canReceiveTimetableAlerts()}
  function controller(){return !!policy().canControlTimetableAlerts()}
  function masterOn(){try{return localStorage.getItem(MASTER_KEY)!=='0'}catch(_){return true}}
  function setMaster(on){if(!controller())return false;try{localStorage.setItem(MASTER_KEY,on?'1':'0')}catch(_){} window.dispatchEvent(new Event('scl:timetable-alert-setting'));return true}
  function toastSafe(msg){try{if(typeof toast==='function')toast(msg)}catch(_){} }
  async function registerSW(){if(!('serviceWorker' in navigator))return null;try{return await navigator.serviceWorker.register('./sw.js',{scope:'./'})}catch(e){return null}}
  window.sclTimetableAlertsMasterOn=masterOn;
  window.sclCanControlTimetableAlerts=controller;
  window.sclAdminToggleTimetableAlerts=function(){
    if(!controller()){try{toast('Administrator access is required to control timetable alerts.')}catch(_){};return false}
    const next=!masterOn();setMaster(next);
    document.querySelectorAll('[data-scl-alert-master]').forEach(function(b){b.textContent=next?'🔔 TIMETABLE ALERTS: ON':'🔕 TIMETABLE ALERTS: OFF';b.classList.toggle('is-on',next);b.setAttribute('aria-pressed',next?'true':'false')});
    if(next&&'Notification' in window&&Notification.permission==='default'){requestSclNotifications(true)}
    return next;
  };
  window.sclRefreshAdminAlertControls=function(){const on=masterOn();document.querySelectorAll('[data-scl-alert-master]').forEach(function(b){b.textContent=on?'🔔 TIMETABLE ALERTS: ON':'🔕 TIMETABLE ALERTS: OFF';b.classList.toggle('is-on',on);b.setAttribute('aria-pressed',on?'true':'false')})};
  window.requestSclNotifications=async function(force){
    if(!controller() && force)return false;
    if(!eligible())return false;
    if(!('Notification' in window))return false;
    await registerSW();
    try{
      const p=await Notification.requestPermission();
      localStorage.setItem(NOTIF_KEY,p);
      if(p==='granted'){scheduleLocalReminders();return true;}
    }catch(_){ }
    return false;
  };
  async function sendLocal(title,body,tag){
    if(!eligible()||!masterOn()||!('Notification' in window)||Notification.permission!=='granted')return;
    const reg=await registerSW();
    if(reg&&reg.showNotification){try{await reg.showNotification(title,{body,icon:'./favicon.ico',badge:'./favicon.ico',tag:tag||'scl'});return}catch(_){} }
    try{new Notification(title,{body,tag:tag||'scl'})}catch(_){ }
  }
  function timetableReminder(){
    if(!eligible()||!masterOn())return;
    const now=new Date(),day=now.getDay();if(day<1||day>5)return;
    const m=now.getHours()*60+now.getMinutes();
    const friday=day===5;
    const blocks=friday?[
      [510,'Period 1 starts at 8:30 AM.'],[560,'Period 2 starts at 9:20 AM.'],[610,'Period 3 starts at 10:10 AM.'],[660,'Period 4 starts at 11:00 AM.'],[750,'Fellowship starts at 12:30 PM.']
    ]:[
      [450,'Assembly starts at 7:30 AM.'],[502,'Preparation / Arrangement starts at 8:22 AM.'],[510,'Period 1 starts at 8:30 AM.'],[565,'Period 2 starts at 9:25 AM.'],[620,'Period 3 starts at 10:20 AM.'],[675,'Lunch & Refreshment starts at 11:15 AM.'],[690,'Period 4 starts at 11:30 AM.'],[745,'Leisure Break starts at 12:25 PM.'],[785,'Period 5 starts at 1:05 PM.'],[840,'Period 6 (School Lesson) starts at 2:00 PM.'],[900,'School closes at 3:00 PM.']
    ];
    const firedKey='sclReminder:'+now.toISOString().slice(0,10)+':'+m;
    const x=blocks.find(v=>v[0]===m);if(x&&!sessionStorage.getItem(firedKey)){sessionStorage.setItem(firedKey,'1');sendLocal('SCL Timetable Alert',x[1],'scl-timetable')}
  }
  function scheduleLocalReminders(){timetableReminder();if(!window.__sclReminderTimer)window.__sclReminderTimer=setInterval(timetableReminder,60000)}
  window.openSclSchoolView=function(){const el=document.getElementById('sclSchoolView');if(!el)return;el.classList.add('open');el.setAttribute('aria-hidden','false');renderSchoolView()}
  window.closeSclSchoolView=function(){const el=document.getElementById('sclSchoolView');if(el){el.classList.remove('open');el.setAttribute('aria-hidden','true')}}
  function renderSchoolView(){const now=new Date(),c=document.getElementById('sclSchoolViewClock'),d=document.getElementById('sclSchoolViewDate');if(c)c.textContent=now.toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'});if(d)d.textContent=now.toLocaleDateString('en-NG',{weekday:'long',year:'numeric',month:'long',day:'numeric'});const host=document.getElementById('sclSchoolViewToday');if(!host)return;const fri=now.getDay()===5;const rows=fri?[['8:30 AM','9:20 AM','Period 1'],['9:20 AM','10:10 AM','Period 2'],['10:10 AM','11:00 AM','Period 3'],['11:00 AM','11:50 AM','Period 4'],['11:50 AM','12:30 PM','Break'],['12:30 PM','1:00 PM','Fellowship'],['1:00 PM','—','CLOSING / DISMISSAL']]:[['7:30 AM','8:20 AM','Assembly'],['8:22 AM','8:30 AM','Preparation / Arrangement'],['8:30 AM','9:25 AM','Period 1'],['9:25 AM','10:20 AM','Period 2'],['10:20 AM','11:15 AM','Period 3'],['11:15 AM','11:30 AM','Short Break'],['11:30 AM','12:25 PM','Period 4'],['12:25 PM','1:05 PM','Long Break'],['1:05 PM','2:00 PM','Period 5'],['2:00 PM','2:55 PM','Period 6 (Lesson)'],['3:00 PM','—','CLOSING']];host.innerHTML=rows.map(r=>'<div class="scl-school-view-item"><b>'+r[2]+'</b><br><small>'+r[0]+' – '+r[1]+'</small></div>').join('')}
  function tick(){if(document.getElementById('sclSchoolView')?.classList.contains('open'))renderSchoolView()}
  setInterval(tick,30000);
  document.addEventListener('DOMContentLoaded',async()=>{
    await registerSW();
    // There is deliberately no automatic notification banner. Ordinary users never receive notification controls.
    if(eligible()&&masterOn()&&('Notification' in window)&&Notification.permission==='granted')scheduleLocalReminders();
    if(controller()){
      const grid=document.querySelector('.scl-suite-grid');
      if(grid&&!grid.querySelector('[data-scl-school-view]')){const b=document.createElement('button');b.className='scl-suite-btn';b.dataset.sclSchoolView='1';b.innerHTML='🏫 SCHOOL VIEW<small>Clean live display for the school office, Mac or Windows screen.</small>';b.onclick=window.openSclSchoolView;grid.appendChild(b)}
    }
  });
  window.addEventListener('scl:timetable-alert-setting',()=>{if(eligible()&&masterOn()&&('Notification' in window)&&Notification.permission==='granted')scheduleLocalReminders()});
})();
</script>
<script id="scl-v82-auth-portability">
(function(){
  const KEY='sclAuthSession';
  const roles=['Parent / Guardian','Student','Teacher','Staff / Worker','Regular User'];
  const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  function get(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(_){return null}}
  function live(){const a=get();return !!(a&&a.accessToken&&a.user)}
  window.sclHasLiveSession=live;
  window.sclOpenEntryFromNav=function(action){
    if(!live()){openM('loginModal');return;}
    if(action==='profile'){window.sclOpenModernProfile?.();return;}
    if(action==='plus'){pickRegistration();return;}
    if(action==='comments'){toast('Comments workspace is opening for your signed-in account.');return;}
    if(action==='posts'){toast('Posts workspace is opening for your signed-in account.');return;}
    if(action==='support'){openWhatsAppChoices();return;}
  };
  window.sclGoogleAuth=async function(){
    const sb=window.sclSupabase; const box=document.getElementById('sclLoginStatus');
    if(!sb?.auth?.signInWithOAuth){if(box){box.classList.remove('hidden');box.textContent='Google sign-in is not initialized. Please wait and try again.';box.classList.add('statusbox')}return;}
    try{
      window.__sclGateEntryRequested=true;
      localStorage.setItem('sclAccountSyncPending','google');
      const redirectTo=window.location.origin+window.location.pathname;
      const {error}=await sb.auth.signInWithOAuth({provider:'google',options:{redirectTo,queryParams:{prompt:'select_account'}}});
      if(error)throw error;
    }catch(e){window.__sclGateEntryRequested=false;if(box){box.classList.remove('hidden');box.textContent=e.message||'Google authentication could not be started.';box.classList.add('statusbox')}}
  };
  window.sclSocialLogin=function(provider){if(String(provider||'').toLowerCase()!=='google'){const box=document.getElementById('sclLoginStatus');if(box){box.classList.remove('hidden');box.textContent='SCL Login supports Google accounts only.';box.classList.add('statusbox')}return false;}return window.sclGoogleAuth();};
  window.renderSclGateCalendar=function(){
    if(window.SCL_RENDER_OFFICIAL_CALENDAR){window.SCL_RENDER_OFFICIAL_CALENDAR();return;}
    const box=document.getElementById('sclGateCalendar'); if(!box)return;
    const c=(typeof CALENDAR!=='undefined'&&CALENDAR)?CALENDAR:{};
    const term=(name,start,end)=>`<div class="scl-gate-term"><b>${name}</b><small>Start: ${esc(start||'To be announced')}<br>End: ${esc(end||'To be announced')}</small></div>`;
    box.innerHTML=term('First Term',c.term1Start,c.term1End)+term('Second Term',c.term2Start,c.term2End)+term('Third Term',c.term3Start,c.term3End);
  }
  function syncGateVisuals(){
    const logo=document.querySelector('.scl-logo-coin .logo')||document.querySelector('.logo');
    const banner=document.querySelector('.scl-hero-poster')||document.querySelector('.heroimg');
    const gl=document.getElementById('sclGateLogo'),gb=document.getElementById('sclGateBanner');
    if(gl&&logo?.src)gl.src=logo.src; if(gb&&banner?.src)gb.src=banner.src; (typeof renderGateCalendar==='function')&&renderGateCalendar();
  }
  async function hydrate(){
    syncGateVisuals();
    const sb=window.sclSupabase; if(!sb?.auth)return;
    try{
      const {data}=await sb.auth.getSession();
      if(data?.session){
        const s=data.session,u=data.session.user; let base={accessToken:s.access_token,refreshToken:s.refresh_token,user:u,roles:[],permissions:[]};
        try{const r=await fetch((window.SCL_SUPABASE_URL||'')+'/functions/v1/scl-attendance?action=profile',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY,Authorization:'Bearer '+s.access_token}});if(r.ok){const d=await r.json();base.roles=d.roles||[];base.profile=d.profile||null;base.staff=d.staff||null;base.student=d.student||null}}catch(_){}
        sessionStorage.setItem(KEY,JSON.stringify(base));
      }else sessionStorage.removeItem(KEY);
    }catch(_){}
    /* A valid Supabase session opens the public website. School roles and protected actions remain separately authorized. */
    const {data:live}=await sb.auth.getSession().catch(()=>({data:{session:null}}));
    if(live?.session){window.__sclGateEntryRequested=true;window.__sclGateAwaitingEntry=false;document.body.classList.remove('scl-public-locked');}
    else{window.__sclGateEntryRequested=false;document.body.classList.add('scl-public-locked');}
  }
  window.sclShowGoogleRoleChooser=function(){
    let m=document.getElementById('sclGoogleRoleModal'); if(!m){m=document.createElement('div');m.id='sclGoogleRoleModal';m.className='modal';m.innerHTML='<div class="card" style="max-width:720px"><div class="mh"><div><h3>CHOOSE YOUR SCL ACCOUNT TYPE</h3><small>This choice tells SCL which workspace to prepare. Staff roles still require school verification.</small></div><button type="button" onclick="closeM(\'sclGoogleRoleModal\')">X</button></div><div class="form"><div class="scl-auth-role-grid">'+roles.map((r,i)=>'<button type="button" class="scl-auth-role" data-role="'+esc(r)+'" onclick="sclSelectGoogleRole(this)"><strong>'+esc(r)+'</strong><small>'+(['Link children and parent services','Use a school-linked student account','Teaching tools and teacher workspace','Worker/staff tools after approval','General verified SCL account'][i])+'</small></button>').join('')+'</div><div id="sclGoogleRoleStatus" class="statusbox hidden"></div><p style="text-align:right"><button class="btn outline" type="button" onclick="closeM(\'sclGoogleRoleModal\')">CANCEL</button></p></div></div>';document.body.appendChild(m)} openM('sclGoogleRoleModal');
  };
  window.sclSelectGoogleRole=function(btn){document.querySelectorAll('.scl-auth-role').forEach(x=>x.classList.remove('selected'));btn.classList.add('selected');const st=document.getElementById('sclGoogleRoleStatus');if(st){st.classList.remove('hidden');st.textContent='Selected: '+btn.dataset.role+'. Your Google identity is verified first; SCL will link or route the account according to school approval and the role selected.'}};
  // Restore Supabase's persistent session after refresh/browser reopening and keep the shell locked until authentication exists.
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',hydrate);else hydrate();
  window.addEventListener('pageshow',hydrate);
  window.addEventListener('storage',hydrate);
  if(window.sclSupabase?.auth?.onAuthStateChange){window.sclSupabase.auth.onAuthStateChange(async(_event,session)=>{if(session){const cur=get()||{};sessionStorage.setItem(KEY,JSON.stringify({...cur,accessToken:session.access_token,refreshToken:session.refresh_token,user:session.user}));window.__sclGateEntryRequested=true;window.__sclGateAwaitingEntry=false;document.body.classList.remove('scl-public-locked');if(['google','signup_confirmation'].includes(localStorage.getItem('sclAccountSyncPending'))||localStorage.getItem('sclGoogleFirstRun')==='1'){try{const response=await fetch((window.SCL_SUPABASE_URL||'')+'/functions/v1/scl-auth-api',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+session.access_token,'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY},body:JSON.stringify({action:'sync_account'})});const result=await response.json().catch(()=>({}));if(!response.ok||result.error){console.warn('SCL profile initialization pending:',result.error||response.statusText);}else{localStorage.removeItem('sclAccountSyncPending');localStorage.removeItem('sclGoogleFirstRun');}}catch(err){console.warn('SCL profile initialization will retry when the profile is opened.',err);}}}else{sessionStorage.removeItem(KEY);window.__sclGateEntryRequested=false;document.body.classList.add('scl-public-locked');}});} 
})();
</script>
<script id="scl-v82-fee-touch">
(function(){
  function bind(){const modal=document.getElementById('fees');if(!modal||modal.dataset.swipeBound)return;modal.dataset.swipeBound='1';let sx=0,sy=0,st=0;modal.addEventListener('touchstart',e=>{if(e.touches.length!==1)return;sx=e.touches[0].clientX;sy=e.touches[0].clientY;st=Date.now()},{passive:true});modal.addEventListener('touchend',e=>{if(!sx)return;const t=e.changedTouches[0],dx=t.clientX-sx,dy=t.clientY-sy,dt=Date.now()-st;sx=sy=st=0;if(dt>800||Math.abs(dx)<65||Math.abs(dx)<Math.abs(dy)*1.35)return;if(dx<0)sclGoFeeClass(1);else sclGoFeeClass(-1)},{passive:true});}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();
})();
</script>
<script id="scl-v85-profile-dismiss-js"><!-- V213: accidental global dismissal disabled; use explicit controls. --></script>
<script id="scl-v85-attendance-signin-flow">
(function(){
  'use strict';
  const PENDING='sclPendingAttendanceSignIn';
  function lagosMinutes(){
    const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Lagos',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());
    return Number(parts.find(x=>x.type==='hour')?.value||0)*60+Number(parts.find(x=>x.type==='minute')?.value||0);
  }
  function within(){const m=lagosMinutes();return m>=420&&m<=960}
  function setStatus(msg){const el=document.getElementById('sclSignInChoiceStatus');if(el){el.classList.remove('hidden');el.textContent=msg}}
  function auth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
  function hasLive(){const a=auth();return !!(a?.accessToken&&a?.user)}
  function resume(){
    const pending=sessionStorage.getItem(PENDING);
    if(!pending||!hasLive())return;
    sessionStorage.removeItem(PENDING);
    localStorage.removeItem('sclGoogleFirstRun');
    window.sclGateEnterAfterAuth?.();
    setTimeout(()=>{closeM('loginModal');closeM('sclSignInChoiceModal');if(typeof window.sclOpenAttendance==='function')window.sclOpenAttendance('self');},350);
  }
  window.sclOpenSignInChoice=function(){
    if(!within()){
      toast('SCL attendance Sign In is available only from 7:00 AM to 4:00 PM (Africa/Lagos). Use LOGIN outside the attendance window.');
      return;
    }
    openM('sclSignInChoiceModal');
  };
  window.sclBeginAttendanceSignIn=function(category){
    if(!within()){setStatus('Attendance Sign In is closed. The SCL attendance window is 7:00 AM to 4:00 PM (Africa/Lagos). You may still use LOGIN for normal platform access.');return}
    sessionStorage.setItem(PENDING,category||'staff');
    if(hasLive()){window.sclGateEnterAfterAuth?.();closeM('sclSignInChoiceModal');window.sclOpenAttendance?.('self');return}
    closeM('sclSignInChoiceModal');openM('loginModal');
    const box=document.getElementById('sclLoginStatus');if(box){box.classList.remove('hidden');box.textContent='Authenticate your SCL account to continue to attendance. Your attendance entry will continue automatically after successful sign-in.';box.classList.add('statusbox')}
  };
  // Wrap the final email/password login handler without replacing its authentication logic.
  document.addEventListener('DOMContentLoaded',()=>{
    const original=window.sclLogin;
    if(typeof original==='function'&&!original.__sclV85Wrapped){
      const wrapped=async function(e){const pending=!!sessionStorage.getItem(PENDING);const result=await original(e);if(pending&&hasLive())resume();return result};
      wrapped.__sclV85Wrapped=true;window.sclLogin=wrapped;
    }
    resume();
  });
  if(window.sclSupabase?.auth?.onAuthStateChange){window.sclSupabase.auth.onAuthStateChange(()=>{setTimeout(resume,500)})}
  window.addEventListener('pageshow',resume);
})();
</script>
<script id="scl-v86-attendance-session-reminders">
(function(){
  'use strict';
  const KEY='sclAuthSession';
  const TZ='Africa/Lagos';
  let timer=null, lastNotice='';
  function auth(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(_){return null}}
  function signedIn(){const a=auth();return !!(a&&a.accessToken&&a.user)}
  function lagosMinutes(){
    const p=new Intl.DateTimeFormat('en-GB',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());
    return Number(p.find(x=>x.type==='hour')?.value||0)*60+Number(p.find(x=>x.type==='minute')?.value||0);
  }
  function today(){return new Date().toLocaleDateString('en-CA',{timeZone:TZ})}
  function notify(title,message){
    try{if('Notification' in window&&Notification.permission==='granted')new Notification(title,{body:message,icon:document.querySelector('.logo')?.src||undefined,tag:'scl-attendance-signout'});}catch(_){ }
    try{if(typeof toast==='function')toast(message)}catch(_){ }
  }
  async function getToday(){
    if(!signedIn()||!window.SCL_SUPABASE_URL||!window.SCL_SUPABASE_PUBLISHABLE_KEY)return null;
    try{
      const a=auth();
      const r=await fetch(window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance?action=my_attendance',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY,Authorization:'Bearer '+a.accessToken}});
      if(!r.ok)return null;
      const d=await r.json();
      return (d.records||[]).find(x=>x.attendance_date===today())||null;
    }catch(_){return null}
  }
  async function check(){
    const m=lagosMinutes();
    if(m<420||m>1080){return}
    const rec=await getToday();
    if(!rec?.sign_in_at||rec.sign_out_at)return;
    let message='';
    if(m>=945&&m<960)message='Your SCL workday is approaching closing time. Please remember to sign out of attendance when your work is finished.';
    else if(m>=960)message='Your SCL attendance window has closed. Please sign out of attendance now if you have finished work. LOGIN remains available for normal SCL access.';
    if(message){const stamp=today()+':'+(m>=960?'close':'reminder');if(stamp!==lastNotice){lastNotice=stamp;notify('SCL Attendance — Sign Out Reminder',message)}}
  }
  function start(){clearInterval(timer);check();timer=setInterval(check,60000)}
  function stop(){clearInterval(timer);timer=null}
  window.sclStartAttendanceReminders=start;
  window.sclStopAttendanceReminders=stop;
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
  window.addEventListener('pageshow',start);
  window.addEventListener('storage',start);
})();
</script>
<!-- SCL V88: hardened first-entry loader, secure gate, general registration, Supabase auth and attendance routing -->
<style id="scl-v88-security-gate-css">
body.scl-v88-booting > *:not(#scl-book-loader){visibility:hidden!important}
#sclV88RegisterModal .scl-v88-choice{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
#sclV88RegisterModal .scl-v88-choice label{border:1px solid #ead5b6;border-radius:12px;padding:11px;background:#fff;cursor:pointer;font-weight:800;color:#650007}
#sclV88RegisterModal .scl-v88-choice input{margin-right:6px}
#sclV88RegisterModal .scl-v88-security{background:#f6fbf7;border:1px solid #b8d8c4;border-radius:10px;padding:11px;margin-top:10px;color:#174c2b;font-size:12px;line-height:1.5}
#sclV88RegisterModal .scl-v88-status{margin-top:10px;padding:10px;border-radius:9px;background:#fff8df;border:1px solid #e2c98f;font-size:13px}
@media(max-width:600px){#sclV88RegisterModal .scl-v88-choice{grid-template-columns:1fr}}
</style>
<style id="scl-v89-timetable-duration-layout">
/* V89 timetable: the schedule itself is the first visual element; management controls follow it. */
.scl-v89-duration-timetable{table-layout:fixed!important;min-width:1440px!important;width:1440px!important}
.scl-v89-duration-timetable col.scl-tt-day-col{width:140px!important}
.scl-v89-duration-timetable col.scl-tt-duration-55{width:220px!important}
.scl-v89-duration-timetable col.scl-tt-duration-5{width:20px!important}
.scl-v89-duration-timetable col.scl-tt-duration-15{width:60px!important}
.scl-v89-duration-timetable col.scl-tt-duration-50{width:200px!important}
.scl-v89-duration-timetable col.scl-tt-duration-30{width:120px!important}
.scl-v89-duration-timetable col.scl-tt-duration-60{width:240px!important}
.scl-v89-duration-timetable .scl-tt-period-head{min-width:0!important;width:auto!important;padding:7px 5px!important}
.scl-v89-duration-timetable .scl-tt-period-head b{font-size:clamp(9px,1vw,13px)!important}
.scl-v89-duration-timetable .scl-tt-period-head small{font-size:clamp(8px,.8vw,11px)!important;line-height:1.15!important}
.scl-v89-duration-timetable .scl-tt-period-head em{font-size:9px!important}
.scl-v89-duration-timetable td{height:auto!important;min-width:0!important;padding:6px!important}
.scl-v89-duration-timetable .scl-tt-cell-entry,.scl-v89-duration-timetable .scl-tt-empty-cell{min-width:0!important;box-sizing:border-box}
.scl-v89-duration-timetable .scl-tt-fixed-cell{padding:3px!important}
.scl-v89-duration-timetable .scl-tt-fixed-block{min-height:52px!important;height:auto!important;padding:4px 2px!important;overflow:hidden}
.scl-v89-duration-timetable .scl-tt-fixed-block b{font-size:10px!important;line-height:1.05!important;overflow-wrap:anywhere}
.scl-v89-duration-timetable .scl-tt-fixed-block small{font-size:8px!important;line-height:1.05!important;overflow-wrap:anywhere}
/* The 5-minute transitions are intentionally narrow, while 15/30/50/55/60-minute blocks grow with their duration. */
.scl-v89-duration-timetable th.scl-tt-period-t1,.scl-v89-duration-timetable td.scl-tt-period-t1,
.scl-v89-duration-timetable th.scl-tt-period-t2,.scl-v89-duration-timetable td.scl-tt-period-t2,
.scl-v89-duration-timetable th.scl-tt-period-t3,.scl-v89-duration-timetable td.scl-tt-period-t3{padding-left:2px!important;padding-right:2px!important}
.scl-v89-duration-timetable th.scl-tt-period-t1 .scl-tt-period-head,.scl-v89-duration-timetable th.scl-tt-period-t2 .scl-tt-period-head,.scl-v89-duration-timetable th.scl-tt-period-t3 .scl-tt-period-head{font-size:8px!important}
.scl-v89-duration-timetable .scl-tt-period-sb .scl-tt-fixed-block,.scl-v89-duration-timetable .scl-tt-period-lb .scl-tt-fixed-block{border:1px solid rgba(101,0,7,.15);background:rgba(255,255,255,.36)!important}
.scl-v89-duration-timetable .scl-tt-period-t1 .scl-tt-fixed-block,.scl-v89-duration-timetable .scl-tt-period-t2 .scl-tt-fixed-block,.scl-v89-duration-timetable .scl-tt-period-t3 .scl-tt-fixed-block{min-height:58px!important;padding:2px 1px!important}
@media(max-width:600px){
 .scl-v89-duration-timetable{min-width:1440px!important;width:1440px!important}
 .scl-v89-duration-timetable .scl-tt-period-head b{font-size:9px!important}
 .scl-v89-duration-timetable .scl-tt-period-head small{font-size:8px!important}
 .scl-v89-duration-timetable .scl-tt-period-head em{font-size:7px!important}
 .scl-v89-duration-timetable .scl-tt-cell-entry,.scl-v89-duration-timetable .scl-tt-empty-cell{padding:5px!important}
}
/* Keep the first timetable viewport clear of the controls below it. */
.scl-v70-timetable #sclV70TTBody{order:1}
.scl-v70-timetable .scl-v70-tt-controls{order:2}
</style>
<style id="scl-v92-timetable-responsive">
/* V92: timetable stays wide and readable on desktop, but becomes compact day-cards on phones. */
@media (min-width: 601px){
  .scl-v89-duration-timetable{
    min-width:0!important;
    width:100%!important;
    max-width:100%!important;
    table-layout:fixed!important;
  }
  .scl-v89-duration-timetable col.scl-tt-day-col{width:10%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-55{width:15.28%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-5{width:1.39%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-15{width:4.17%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-50{width:13.89%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-30{width:8.33%!important}
  .scl-v89-duration-timetable col.scl-tt-duration-60{width:16.67%!important}
  .scl-v89-duration-timetable th,.scl-v89-duration-timetable td{box-sizing:border-box!important}
  .scl-v89-duration-timetable .scl-tt-cell-entry,.scl-v89-duration-timetable .scl-tt-empty-cell{width:100%!important}
  .scl-v89-duration-timetable .scl-tt-period-head b{font-size:clamp(9px,1.05vw,14px)!important}
  .scl-v89-duration-timetable .scl-tt-period-head small{font-size:clamp(8px,.78vw,11px)!important}
}
@media (max-width: 600px){
  /* The phone no longer receives the 1440px desktop table. Each day becomes one compact card. */
  .scl-v70-week-wrap{
    overflow-x:hidden!important;
    overflow-y:visible!important;
    width:100%!important;
    padding:0!important;
  }
  .scl-v89-duration-timetable{
    display:block!important;
    width:100%!important;
    min-width:0!important;
    max-width:100%!important;
    table-layout:auto!important;
    border-collapse:separate!important;
    border-spacing:0!important;
  }
  .scl-v89-duration-timetable colgroup,
  .scl-v89-duration-timetable thead{display:none!important}
  .scl-v89-duration-timetable tbody{
    display:flex!important;
    flex-direction:row!important;
    width:100%!important;
    overflow-x:auto!important;
    overflow-y:hidden!important;
    scroll-snap-type:x mandatory!important;
    -webkit-overflow-scrolling:touch!important;
    gap:10px!important;
    padding:2px 2px 12px!important;
    box-sizing:border-box!important;
  }
  .scl-v89-duration-timetable tbody tr{
    display:block!important;
    flex:0 0 100%!important;
    width:100%!important;
    min-width:100%!important;
    max-width:100%!important;
    scroll-snap-align:start!important;
    scroll-snap-stop:always!important;
    background:rgba(255,255,255,.94)!important;
    border:1px solid rgba(101,0,7,.16)!important;
    border-radius:14px!important;
    overflow:hidden!important;
    box-shadow:0 5px 18px rgba(0,0,0,.10)!important;
  }
  .scl-v89-duration-timetable tbody tr>th.scl-tt-day-head{
    display:flex!important;
    align-items:center!important;
    justify-content:space-between!important;
    width:100%!important;
    min-height:42px!important;
    box-sizing:border-box!important;
    padding:8px 11px!important;
    background:#650007!important;
    color:#fff!important;
    border:0!important;
    text-align:left!important;
  }
  .scl-v89-duration-timetable tbody tr>th.scl-tt-day-head b{font-size:14px!important}
  .scl-v89-duration-timetable tbody tr>th.scl-tt-day-head small{font-size:9px!important;color:#fff!important;opacity:.9!important}
  .scl-v89-duration-timetable tbody tr>td{
    display:grid!important;
    grid-template-columns:96px minmax(0,1fr)!important;
    align-items:stretch!important;
    width:100%!important;
    min-width:0!important;
    min-height:43px!important;
    box-sizing:border-box!important;
    padding:3px 5px!important;
    border:0!important;
    border-bottom:1px solid #eee7dc!important;
    background:#fff!important;
  }
  .scl-v89-duration-timetable tbody tr>td:last-child{border-bottom:0!important}
  .scl-v89-duration-timetable tbody tr>td::before{
    content:attr(data-scl-period)!important;
    display:flex!important;
    align-items:center!important;
    padding:3px 6px!important;
    border-right:1px solid #e5ddd2!important;
    color:#650007!important;
    font-size:9px!important;
    font-weight:900!important;
    line-height:1.15!important;
  }
  .scl-v89-duration-timetable .scl-tt-cell-entry,
  .scl-v89-duration-timetable .scl-tt-empty-cell,
  .scl-v89-duration-timetable .scl-tt-fixed-block{
    width:100%!important;
    min-width:0!important;
    min-height:36px!important;
    height:auto!important;
    box-sizing:border-box!important;
    padding:4px 6px!important;
    margin:0!important;
    border:0!important;
    border-radius:7px!important;
  }
  .scl-v89-duration-timetable .scl-tt-cell-entry{
    display:flex!important;
    flex-direction:column!important;
    align-items:flex-start!important;
    justify-content:center!important;
    text-align:left!important;
    gap:1px!important;
    background:#fffaf1!important;
  }
  .scl-v89-duration-timetable .scl-tt-cell-entry b{font-size:10px!important;line-height:1.15!important;overflow-wrap:anywhere!important}
  .scl-v89-duration-timetable .scl-tt-cell-entry small{font-size:8px!important;line-height:1.1!important;overflow-wrap:anywhere!important}
  .scl-v89-duration-timetable .scl-tt-empty-cell{display:flex!important;align-items:center!important;justify-content:space-between!important;background:#fafafa!important;color:#777!important}
  .scl-v89-duration-timetable .scl-tt-empty-cell span{font-size:9px!important;font-weight:800!important}
  .scl-v89-duration-timetable .scl-tt-empty-cell small{font-size:7px!important}
  .scl-v89-duration-timetable .scl-tt-fixed-cell{display:grid!important}
  .scl-v89-duration-timetable .scl-tt-fixed-block{display:flex!important;align-items:center!important;justify-content:center!important;text-align:center!important;background:#f3f0f7!important}
  .scl-v89-duration-timetable .scl-tt-fixed-block b{font-size:9px!important;line-height:1.1!important;overflow-wrap:anywhere!important}
  .scl-v89-duration-timetable .scl-tt-fixed-block small{font-size:7px!important;line-height:1.05!important}
  /* Hide unused Friday transition slots rather than creating a giant blank area. */
  .scl-v89-duration-timetable .scl-tt-friday-closed{display:none!important}
  .scl-v89-duration-timetable .scl-tt-period-t1,
  .scl-v89-duration-timetable .scl-tt-period-t2,
  .scl-v89-duration-timetable .scl-tt-period-t3{display:none!important}
  .scl-v89-duration-timetable .scl-tt-period-head{display:none!important}
  .scl-v89-duration-timetable tbody tr>td.scl-tt-period-t1,
  .scl-v89-duration-timetable tbody tr>td.scl-tt-period-t2,
  .scl-v89-duration-timetable tbody tr>td.scl-tt-period-t3{display:none!important}
}
</style>
<script id="scl-v92-timetable-mobile-labels">
(function(){
  function labelTimetableCells(){
    document.querySelectorAll('.scl-v89-duration-timetable tbody tr').forEach(function(tr){
      tr.querySelectorAll(':scope > td').forEach(function(td){
        if(td.classList.contains('scl-tt-period-t1')||td.classList.contains('scl-tt-period-t2')||td.classList.contains('scl-tt-period-t3')) return;
        var p=[...td.classList].find(function(c){return c.indexOf('scl-tt-period-')===0&&c!=='scl-tt-period-head'});
        if(!p)return;
        var key=p.replace('scl-tt-period-','');
        var names={p1:'Period 1',p2:'Period 2',p3:'Period 3',sb:'Short Break',p4:'Period 4',lb:'Long Break',p5:'Period 5',lesson:'Period 6'};
        td.setAttribute('data-scl-period',names[key]||key);
      });
    });
  }
  labelTimetableCells();
  document.addEventListener('click',function(e){if(e.target.closest('[data-tt-mode],#sclV70TTClass,#sclV70TTRefresh,#sclV70TTSchedule'))setTimeout(labelTimetableCells,50)});
  var mo=new MutationObserver(labelTimetableCells);mo.observe(document.body,{childList:true,subtree:true});
  setTimeout(labelTimetableCells,300);setTimeout(labelTimetableCells,1000);
})();
</script>
<script id="scl-v91-calendar-carousel-script">
(function(){
  function markCalendar(){
    var box=document.getElementById('sclGateCalendar');
    if(!box)return;
    var rail=box.querySelector('.scl-gate-calendar-full');
    if(!rail)return;
    rail.setAttribute('role','region');
    rail.setAttribute('aria-label','SCL 2026/2027 academic terms');
    rail.setAttribute('tabindex','0');
    var terms=rail.querySelectorAll('.scl-cal-term');
    terms.forEach(function(t,i){t.setAttribute('aria-label',t.querySelector('h4')?.textContent||('Term '+(i+1)));});
  }
  window.SCL_MARK_CALENDAR_CAROUSEL=markCalendar;
  window.setTimeout(markCalendar,500);
  window.addEventListener('load',markCalendar,{once:true});
})();
</script>
<script id="scl-universal-double-click-home"><!-- V213: accidental global dismissal disabled; use explicit controls. --></script>
<style id="scl-final-form-priority-v100">
/* Final form priority: the primary credential/action fields are visible first. */
#loginModal .scl-login-primary{display:grid;gap:10px;order:-20}
#loginModal .scl-login-primary .field{margin:0}
#loginModal .scl-login-primary .login-main-action{width:100%;min-height:46px;font-weight:950;font-size:15px}
#loginModal .scl-login-secondary{order:10}
#loginModal .scl-auth-divider{order:5}
#loginModal .scl-google-auth{order:10}
#loginModal .scl-login-status{order:0}
#loginModal form{display:flex;flex-direction:column}
#sclDirectPaymentRoot .scl-dp-form label{font-weight:900}
#sclDirectPaymentRoot .scl-dp-submit-top{width:100%;min-height:46px;font-weight:950}
</style>
<script id="scl-final-form-priority-v100-script">
(function(){
  'use strict';
  function hardenPaymentEntry(){
    const direct=window.sclDirectOpenPaymentCenter;
    if(typeof direct!=='function')return;
    window.openFees=function(){return direct()};
    window.pickFees=function(){return direct()};
    window.sclOpenPaymentPicker=function(){return direct()};
    window.sclV98OpenPaymentPicker=function(){return direct()};
    if(!window.__sclNativeOpenMForPayment){
      const nativeOpenM=window.openM;
      window.__sclNativeOpenMForPayment=nativeOpenM;
      window.openM=function(id){
        if(id==='fees'||id==='pay'||id==='bulkPay')return direct();
        return typeof nativeOpenM==='function'?nativeOpenM.apply(this,arguments):undefined;
      };
    }
  }
  function boot(){
    hardenPaymentEntry();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  setTimeout(boot,500);
  setTimeout(boot,1500);
})();
</script>
<script id="scl-rebuilt-core-v200">
(function(){'use strict';
const KEY='sclAuthSession', TZ='Africa/Lagos', ATT_START=420, ATT_END=960;
const $=id=>document.getElementById(id);
function readAuth(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(e){return null}}
function roles(a=readAuth()){return (a?.roles||[]).map(x=>String(x).toLowerCase())}
function isAdmin(a=readAuth()){return roles(a).some(r=>['developer','technical_admin','management_admin','affairs_admin'].includes(r))}
function isSchoolMember(a=readAuth()){return !!(a?.staff||a?.student||roles(a).some(r=>['teacher','staff','worker','student','developer','technical_admin','management_admin','affairs_admin'].includes(r)))}
function live(a=readAuth()){return !!(a?.accessToken&&a?.user)}
function saveAuth(a){try{sessionStorage.setItem(KEY,JSON.stringify(a))}catch(e){}}
function minutes(){const p=new Intl.DateTimeFormat('en-GB',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());return (+p.find(x=>x.type==='hour').value*60)+(+p.find(x=>x.type==='minute').value)}
function inAttendanceWindow(){const m=minutes();return m>=ATT_START&&m<=ATT_END}
function open(id){if(typeof window.openM==='function')window.openM(id);else $(id)?.classList.add('show')}
function close(id){if(typeof window.closeM==='function')window.closeM(id);else $(id)?.classList.remove('show')}
function status(id,msg,error=false){const el=$(id);if(!el)return;el.classList.remove('hidden');el.textContent=msg;el.style.color=error?'#a40000':''}
function gateEnter(){document.body.classList.remove('scl-public-locked','scl-v88-booting');window.__sclGateEntryRequested=true;window.__sclGateAwaitingEntry=false;}
function gateLogin(){window.__sclGateEntryRequested=true;window.__sclGateAwaitingEntry=true;open('loginModal')}
function gateSignup(){window.__sclGateEntryRequested=true;open('sclSignupModal')}
function gateSignIn(){window.__sclGateEntryRequested=true;open('sclSchoolSignInModal');selectRole('member')}
function selectRole(mode){const idw=$('sclSchoolIdWrap');if(idw)idw.style.display=mode==='admin'?'none':'';['sclSchoolRoleMember','sclSchoolRoleAdmin'].forEach(id=>$(id)?.classList.toggle('active',id===(mode==='admin'?'sclSchoolRoleAdmin':'sclSchoolRoleMember')));window.__sclSchoolRole=mode}
async function waitSB(ms=8000){const start=Date.now();while(!(window.sclSupabase?.auth?.signInWithPassword)){if(Date.now()-start>ms)throw new Error('SCL authentication service is not ready. Please check your internet connection and try again.');await new Promise(r=>setTimeout(r,100))}return window.sclSupabase}
async function login(email,password){const sb=await waitSB();const {data,error}=await sb.auth.signInWithPassword({email,password});if(error)throw error;const u=data.user||{};const meta={...(u.user_metadata||{}),...(u.app_metadata||{})};const a={accessToken:data.session?.access_token,refreshToken:data.session?.refresh_token,user:u,roles:meta.roles||u.user_metadata?.roles||[],staff:meta.staff||u.user_metadata?.staff,student:meta.student||u.user_metadata?.student};saveAuth(a);return a}
window.sclGateLogin=gateLogin;window.sclGateSignup=gateSignup;window.sclGateSignIn=gateSignIn;window.sclGateRegister=gateSignup;window.sclOpenSignInChoice=gateSignIn;window.sclSelectSchoolRole=selectRole;
window.sclSchoolSignIn=async function(e){e.preventDefault();const mode=window.__sclSchoolRole||'member',email=$('sclSchoolEmail')?.value.trim(),id=$('sclSchoolId')?.value.trim(),pw=$('sclSchoolPassword')?.value;status('sclSchoolSignInStatus','Authenticating securely…');try{const a=await login(email,pw);if(mode==='admin'){if(!isAdmin(a)){throw new Error('This account is not authorized as a school administrator. Use LOGIN for normal account access.')}}else{if(!isSchoolMember(a))throw new Error('This account is not linked to an approved SCL student, teacher or staff record.');const expected=String(a.student?.id||a.student?.student_id||a.staff?.id||a.staff?.staff_id||a.user?.user_metadata?.student_id||a.user?.user_metadata?.staff_id||'').trim();if(expected&&expected!==id)throw new Error('The SCL ID does not match this school identity.')}gateEnter();close('sclSchoolSignInModal');if(inAttendanceWindow()&&mode!=='admin'&&typeof window.sclOpenAttendance==='function'){window.sclOpenAttendance('self')}else{window.sclOpenModernProfile?.();window.sclRefreshHome?.()} }catch(err){status('sclSchoolSignInStatus',err?.message||'Sign in failed.',true)}};
window.sclSignup=async function(e){e.preventDefault();const name=$('sclSignupName')?.value.trim(),email=$('sclSignupEmail')?.value.trim(),phone=$('sclSignupPhone')?.value.trim(),pw=$('sclSignupPassword')?.value,pw2=$('sclSignupPassword2')?.value;if(pw!==pw2){status('sclSignupStatus','Passwords do not match.',true);return}status('sclSignupStatus','Creating your SCL account…');try{const sb=await waitSB();const {data,error}=await sb.auth.signUp({email,password:pw,options:{data:{full_name:name,phone,account_type:'member'}}});if(error)throw error;if(data.session){saveAuth({accessToken:data.session.access_token,refreshToken:data.session.refresh_token,user:data.user,roles:['member']});gateEnter();close('sclSignupModal');window.sclOpenPublicUserView?.();}else{status('sclSignupStatus','Account created. Check your email to verify your SCL account, then use LOGIN.');}}catch(err){status('sclSignupStatus',err?.message||'Account creation failed.',true)}};
window.sclBeginAttendanceSignIn=function(){gateSignIn()};window.login=gateLogin;window.pick=gateSignup;
// Keep registration protected: authenticated users reach it from the homepage, never from the public gate.
window.sclGateStudentRegistration=function(){if(!live()){gateLogin();return}window.openStudentRegistration?.()||window.openRegistration?.()||window.sclOpenRegistration?.()};
// Re-label and bind the public gate defensively after all legacy scripts have loaded.
function boot(){if(live()&&window.__sclGateEntryRequested)gateEnter()}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();</script>
<style id="scl-v201-visibility-scroll-fix">
/* V201: consistent white titles + directional floating navigation. */
.scl-v201-title,
.modal .card .mh h1,.modal .card .mh h2,.modal .card .mh h3,.modal .card .mh h4,
.modal .card > h1,.modal .card > h2,.modal .card > h3,.modal .card > h4,
.panel > h1,.panel > h2,.panel > h3,.panel > h4,
.scl-learning-head h1,.scl-learning-head h2,.scl-learning-head h3,
.aac-heading h1,.aac-heading h2,.aac-heading h3,
.scl-admin-section-title,.scl-child-head h1,.scl-child-head h2,.scl-child-head h3,.scl-child-head h4,
.scl-dp-head h1,.scl-dp-head h2,.scl-dp-head h3,.scl-dp-head h4,
.scl-salary-head h1,.scl-salary-head h2,.scl-salary-head h3,.scl-salary-head h4,
.scl-reg-section-head b,.scl-v42-live-head h1,.scl-v42-live-head h2,.scl-v42-live-head h3,
.scl-v72-comments-head h1,.scl-v72-comments-head h2,.scl-v72-comments-head h3,
.cert-title,.section-title{
  color:#fff!important;
  text-shadow:0 1px 3px rgba(0,0,0,.48)!important;
}
/* Put white titles on a readable title surface rather than on a white card. */
.modal .card .mh,
.modal .card > h1,.modal .card > h2,.modal .card > h3,.modal .card > h4,
.panel > h1,.panel > h2,.panel > h3,.panel > h4,
.scl-admin-section-title,.scl-reg-section-head b,.cert-title,.section-title{
  background:linear-gradient(135deg,#650007,#8b0712)!important;
  border-radius:10px!important;
  padding:8px 12px!important;
  box-sizing:border-box;
}
.modal .card .mh h1,.modal .card .mh h2,.modal .card .mh h3,.modal .card .mh h4{background:transparent!important;padding:0!important}
.scl-learning-head h1,.scl-learning-head h2,.scl-learning-head h3,
.aac-heading h1,.aac-heading h2,.aac-heading h3,
.scl-child-head h1,.scl-child-head h2,.scl-child-head h3,.scl-child-head h4,
.scl-dp-head h1,.scl-dp-head h2,.scl-dp-head h3,.scl-dp-head h4,
.scl-salary-head h1,.scl-salary-head h2,.scl-salary-head h3,.scl-salary-head h4,
.scl-v42-live-head h1,.scl-v42-live-head h2,.scl-v42-live-head h3,
.scl-v72-comments-head h1,.scl-v72-comments-head h2,.scl-v72-comments-head h3{
  background:linear-gradient(135deg,#650007,#8b0712)!important;
  border-radius:10px!important;
  padding:8px 12px!important;
  box-sizing:border-box;
}
.scl-school-view-head h1,.scl-school-view-head h2,.scl-school-view-head h3,.scl-settings-head h1,.scl-settings-head h2,.scl-settings-head h3,
.materials-head h1,.materials-head h2,.materials-head h3,.feehead,.scl-shortcut-head strong{color:#fff!important;text-shadow:0 1px 3px rgba(0,0,0,.45)!important}

.scl-logo-coin-dock,#sclShortcutToggle{transition:transform .28s ease,opacity .22s ease,visibility .22s ease!important;will-change:transform,opacity}
body.scl-v201-scroll-up .scl-logo-coin-dock{transform:translate(-50%,-145%)!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important}
body.scl-v201-scroll-up #sclShortcutToggle{transform:translate(-145%,-50%)!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important}
body.scl-v201-scroll-down .scl-logo-coin-dock{transform:translate(-50%,0)!important;opacity:1!important;visibility:visible!important}
body.scl-v201-scroll-down #sclShortcutToggle{transform:translate(0,-50%)!important;opacity:1!important;visibility:visible!important}
@media(prefers-reduced-motion:reduce){.scl-logo-coin-dock,#sclShortcutToggle{transition:none!important}}

/* V201: compact, role-aware Quick Actions opened from the bottom + button. */
#sclQuickActionsModal .scl-quick-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
#sclQuickActionsModal .scl-quick-action{border:1px solid #ead5b6;background:#fff;border-radius:14px;padding:13px;text-align:left;cursor:pointer;color:#650007;font-weight:900;box-shadow:0 5px 16px rgba(101,0,7,.08);transition:.16s}
#sclQuickActionsModal .scl-quick-action:hover,#sclQuickActionsModal .scl-quick-action:focus-visible{transform:translateY(-2px);border-color:#f2ae00;outline:none}
#sclQuickActionsModal .scl-quick-action small{display:block;margin-top:4px;color:#6b5b50;font-weight:500;line-height:1.3}
body.scl-night #sclQuickActionsModal .scl-quick-action{background:#182234;color:#f8fafc;border-color:#475569}
body.scl-night #sclQuickActionsModal .scl-quick-action small{color:#cbd5e1}
@media(max-width:600px){#sclQuickActionsModal .scl-quick-actions{grid-template-columns:1fr}.scl-logo-coin-dock{transition-duration:.2s!important}}
</style>
<style id="scl-v204-activities-nav-style">
/* V204: Bottom-bar Posts is the School Activities / Community feed. */
.bottom button.scl-activities-nav{font-weight:900}
.scl-activities-nav-panel-link{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 0 12px;padding:10px 14px;border:1px solid #ead5b6;border-radius:12px;background:#fff8df;color:#650007;font-weight:900;cursor:pointer}
body.scl-night .scl-activities-nav-panel-link{background:#182234;color:#f8fafc;border-color:#475569}
</style>
<script id="scl-v204-activities-nav">
(function(){
  'use strict';
  function live(){try{var a=window.sclHasLiveSession?.();if(typeof a==='boolean')return a}catch(_){}try{var k=window.SCL_AUTH_KEY||'scl_auth';var x=JSON.parse(sessionStorage.getItem(k)||localStorage.getItem(k)||'null');return !!(x&&x.accessToken&&x.user)}catch(_){return false}}
  window.sclOpenSchoolActivities=function(){
    if(!live()){if(typeof window.openM==='function')window.openM('loginModal');return false;}
    if(typeof window.openCollaboration==='function'){
      window.openCollaboration();
      setTimeout(function(){window.showCommunityTab?.('activities');},60);
      return true;
    }
    if(typeof window.openSclAlerts==='function'){window.openSclAlerts();return true;}
    return false;
  };
  function enhance(){
    document.querySelectorAll('.bottom button').forEach(function(b){
      if((b.textContent||'').trim()==='Posts'){
        b.textContent='Activities';
        b.classList.add('scl-activities-nav');
        b.setAttribute('aria-label','School Activities and Announcements');
      }
    });
    var panel=document.getElementById('communityPanelActivities');
    if(panel&&!panel.querySelector('.scl-activities-nav-panel-link')){
      var intro=panel.querySelector('.community-intro');
      if(intro){
        var link=document.createElement('button');
        link.type='button';link.className='scl-activities-nav-panel-link';
        link.innerHTML='📢 View School Announcements';
        link.onclick=function(){window.openSclAlerts?.();};
        intro.insertAdjacentElement('afterend',link);
      }
    }
  }
  window.sclOpenEntryFromNav=(function(old){return function(action){
    if(action==='posts')return window.sclOpenSchoolActivities();
    return typeof old==='function'?old.apply(this,arguments):false;
  };})(window.sclOpenEntryFromNav);
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',enhance);else enhance();
  setTimeout(enhance,300);setTimeout(enhance,1200);
})();
</script>
<style id="scl-v207-search-audit-style">.scl-profile-menu button[aria-label="Search my SCL profile"]{font-size:16px}.scl-audit-panel{grid-column:1/-1}.scl-audit-status{margin:9px 0;padding:9px 11px;border-radius:10px;background:#fff8df;border:1px solid #e2c98f;color:#614c21;font-size:11px}.scl-audit-table{min-width:980px}.scl-audit-table td,.scl-audit-table th{font-size:11px}.scl-audit-row-new{animation:sclAuditFlash 1.2s ease}.scl-profile-search-hit{outline:3px solid #d7a63a!important;box-shadow:0 0 0 5px rgba(215,166,58,.18)!important;border-radius:10px!important}@keyframes sclAuditFlash{0%{background:#fff0b8}100%{background:inherit}}</style>
<script id="scl-v207-profile-search-audit">
(function(){'use strict';
function e(v){try{return typeof esc==='function'?esc(v):String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}catch(_){return String(v??'')}}
function a(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
window.sclOpenProfileSearch=function(){const m=document.getElementById('sclProfileSearchModal');if(!m)return;if(typeof openM==='function')openM('sclProfileSearchModal');else{m.classList.add('open');m.style.display='flex'}const i=document.getElementById('sclProfileSearchInput');if(i){i.value='';setTimeout(()=>i.focus(),80)}const r=document.getElementById('sclProfileSearchResults');if(r)r.innerHTML='<div style="padding:16px;text-align:center;color:#6b6057">Type something to search your profile.</div>'};
function search(q){const box=document.getElementById('sclModernProfileBody'),out=document.getElementById('sclProfileSearchResults');if(!box||!out)return;q=String(q||'').trim().toLowerCase();if(!q){out.innerHTML='<div style="padding:16px;text-align:center;color:#6b6057">Type something to search your profile.</div>';return}const els=[...box.querySelectorAll('h1,h2,h3,h4,h5,p,button,label,span,b,small,td,th')],seen=new Set(),hits=[];for(const el of els){const t=(el.textContent||'').replace(/\s+/g,' ').trim();if(t.toLowerCase().includes(q)&&t){const target=el.closest('.scl-role-panel,.scl-att-card,.scl-profile-meta-grid>div,.scl-profile-passkey,.scl-profile-cover,.scl-profile-toolbar')||el;if(!seen.has(target)){seen.add(target);hits.push({target,text:t.slice(0,180)})}if(hits.length>=12)break}}if(!hits.length){out.innerHTML='<div style="padding:16px;text-align:center;color:#6b6057">No matching item was found in your current profile. Try <b>attendance</b>, <b>fees</b>, <b>results</b>, <b>assignment</b> or <b>support</b>.</div>';return}out.innerHTML=hits.map((h,n)=>'<button type="button" data-scl-search-index="'+n+'" style="display:block;width:100%;text-align:left;padding:12px;margin:6px 0;border:1px solid #ead5b6;border-radius:11px;background:#fffaf2;color:#3b1712;cursor:pointer"><b>'+e(h.text.slice(0,90))+'</b><br><small>Open this section</small></button>').join('');out.querySelectorAll('[data-scl-search-index]').forEach(b=>b.onclick=()=>{const h=hits[Number(b.dataset.sclSearchIndex)];if(!h)return;document.querySelectorAll('.scl-profile-search-hit').forEach(x=>x.classList.remove('scl-profile-search-hit'));h.target.classList.add('scl-profile-search-hit');h.target.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>h.target.classList.remove('scl-profile-search-hit'),2500);if(typeof closeM==='function')closeM('sclProfileSearchModal')})}
document.addEventListener('input',x=>{if(x.target?.id==='sclProfileSearchInput')search(x.target.value)});
const AUDIT='scl_activity_log';let ch=null;
function isAdmin(){return !!(a()?.roles||[]).some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)))}
function status(t,ok){const x=document.getElementById('sclAuditStatus');if(x){x.textContent=t;x.style.background=ok?'#eefaf2':'#fff8df';x.style.color=ok?'#12652e':'#614c21'}}
function row(r){let d='—';try{d=r.created_at?new Date(r.created_at).toLocaleString('en-NG',{dateStyle:'short',timeStyle:'medium'}):'—'}catch(_){}const actor=r.actor_name||r.full_name||r.user_email||r.email||r.actor_email||'—',role=r.actor_role||r.role||'—',act=r.action||r.activity||r.event_type||r.event||'—',ent=r.entity_type||r.entity||r.module||'—',st=r.status||'RECORDED',det=r.details||r.description||r.metadata||'';return '<tr class="scl-audit-row-new"><td>'+e(d)+'</td><td>'+e(actor)+'</td><td>'+e(role)+'</td><td>'+e(act)+'</td><td>'+e(ent)+'</td><td>'+e(st)+'</td><td>'+e(typeof det==='string'?det:JSON.stringify(det))+'</td></tr>'}
function render(rs){const b=document.getElementById('sclActivityLogBody');if(!b)return;b.innerHTML=rs.length?rs.map(row).join(''):'<tr><td colspan="7" style="text-align:center;padding:22px">No activity recorded yet.</td></tr>'}
async function load(){if(!isAdmin())return;const au=a();if(!au?.accessToken)throw new Error('Administrator authentication is required.');const u=window.SCL_SUPABASE_URL+'/rest/v1/'+AUDIT+'?select=*&order=created_at.desc&limit=200',r=await fetch(u,{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY,Authorization:'Bearer '+au.accessToken}});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d?.message||d?.error||'The activity log table is not available yet.');return Array.isArray(d)?d:[]}
window.sclLoadActivityLog=async function(){try{const rs=await load();render(rs);status(rs.length?'Live log connected • '+rs.length+' recent event(s) loaded.':'Connected • No activity has been recorded yet. The table is ready for live events.',true);if(!ch&&window.sclSupabase?.channel){ch=window.sclSupabase.channel('scl-activity-log-live').on('postgres_changes',{event:'INSERT',schema:'public',table:AUDIT},p=>{const b=document.getElementById('sclActivityLogBody');if(b){const em=b.querySelector('td[colspan="7"]');if(em)b.innerHTML='';b.insertAdjacentHTML('afterbegin',row(p.new||{}));const rows=b.querySelectorAll('tr');if(rows.length>200)rows[rows.length-1].remove()}status('LIVE • New activity received '+new Date().toLocaleTimeString('en-NG'),true)}).subscribe()}}catch(err){render([]);status(err.message||'Activity log unavailable. Run the supplied Supabase activity-log SQL first.',false)}};
const old=window.sclOpenModernProfile;if(typeof old==='function')window.sclOpenModernProfile=async function(){await old.apply(this,arguments);if(isAdmin())setTimeout(()=>window.sclLoadActivityLog(),250)};
})();</script>\n
<style id="scl-v208-admin-cms-css">
#sclAdminCmsPanel{position:fixed;inset:0;z-index:2147483000;display:none;background:rgba(20,8,5,.58);backdrop-filter:blur(8px);padding:14px;box-sizing:border-box}
#sclAdminCmsPanel.open{display:flex;align-items:center;justify-content:center}
#sclAdminCmsCard{width:min(1120px,100%);height:min(92vh,900px);background:#fffaf4;border:1px solid #e7c98d;border-radius:20px;box-shadow:0 24px 80px rgba(0,0,0,.35);overflow:hidden;display:flex;flex-direction:column;color:#35130e}
#sclAdminCmsHead{padding:14px 18px;border-bottom:1px solid #ead9bc;display:flex;gap:10px;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#fff9ef,#f8ead1)}
#sclAdminCmsHead h2{margin:0;font-size:18px}#sclAdminCmsHead small{display:block;color:#735f55;margin-top:3px}
#sclAdminCmsBody{display:grid;grid-template-columns:300px 1fr;min-height:0;flex:1}
#sclAdminCmsNav{border-right:1px solid #ead9bc;padding:12px;overflow:auto;background:#fffdf9}
#sclAdminCmsMain{padding:14px;overflow:auto}
.scl-cms-btn{border:1px solid #d9bb82;background:#fff;border-radius:10px;padding:9px 11px;cursor:pointer;font-weight:700;color:#4b2018}.scl-cms-btn:hover{background:#fff4df}.scl-cms-btn.primary{background:#6f2419;color:#fff;border-color:#6f2419}.scl-cms-btn.danger{color:#9d2018}.scl-cms-row{padding:10px;border:1px solid #ead9bc;border-radius:12px;background:#fff;margin-bottom:9px;cursor:pointer}.scl-cms-row:hover,.scl-cms-row.active{border-color:#bd8d43;box-shadow:0 0 0 2px rgba(189,141,67,.12)}
.scl-cms-row b{display:block}.scl-cms-row small{color:#75655e;display:block;margin-top:3px}.scl-cms-field{display:grid;gap:6px;margin:12px 0}.scl-cms-field label{font-weight:800;font-size:12px}.scl-cms-field input,.scl-cms-field textarea,.scl-cms-field select{width:100%;box-sizing:border-box;border:1px solid #d8c5a4;border-radius:10px;padding:10px;background:#fff;font:inherit}.scl-cms-field textarea{min-height:140px;resize:vertical}.scl-cms-meta{font-size:12px;color:#78665e}.scl-cms-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.scl-cms-search{width:100%;box-sizing:border-box;border:1px solid #d8c5a4;border-radius:10px;padding:10px;background:#fff;margin-bottom:10px}.scl-cms-empty{padding:25px;text-align:center;color:#75655e;border:1px dashed #d8c5a4;border-radius:12px;background:#fff}
.scl-cms-highlight{outline:3px solid #c99335!important;outline-offset:3px;scroll-margin:90px}.scl-cms-editable{cursor:crosshair!important}.scl-cms-editable:hover{outline:2px dashed #c99335!important;outline-offset:2px}
@media(max-width:760px){#sclAdminCmsBody{grid-template-columns:1fr}#sclAdminCmsNav{border-right:0;border-bottom:1px solid #ead9bc;max-height:35vh}.scl-cms-toolbar{position:sticky;top:0;background:#fffaf4;padding-bottom:8px;z-index:2}}
</style>
<div aria-hidden="true" id="sclAdminCmsPanel">
<div id="sclAdminCmsCard">
<div id="sclAdminCmsHead"><div><h2>⚙️ SCL Admin Website &amp; Data Control</h2><small>Edit school content and business data from the admin panel. Changes are stored online; GitHub re-upload is not required.</small></div><button class="scl-cms-btn" id="sclAdminCmsClose">Close</button></div>
<div id="sclAdminCmsBody">
<aside id="sclAdminCmsNav"><input class="scl-cms-search" id="sclAdminCmsSearch" placeholder="Search prices, account, timetable, announcements…"/><div id="sclAdminCmsList"></div></aside>
<main id="sclAdminCmsMain"><div class="scl-cms-toolbar"><button class="scl-cms-btn primary" id="sclAdminCmsScan">Scan current site</button><button class="scl-cms-btn" id="sclAdminCmsRefresh">Refresh saved data</button><button class="scl-cms-btn" id="sclAdminCmsEditMode">Edit directly on page</button></div><div id="sclAdminCmsEditor"><div class="scl-cms-empty">Select a content item on the left. You can edit its value, section, and label, then save it to the live backend.</div></div></main>
</div>
</div>
</div>
<style id="scl-v211-admin-control-center-style">
.scl-v211-panel{position:fixed;inset:0;z-index:2147483000;background:rgba(20,10,8,.78);backdrop-filter:blur(10px);display:none;overflow:auto;padding:14px}.scl-v211-panel.open{display:block}.scl-v211-shell{width:min(1180px,100%);margin:10px auto;background:#fffdf8;border:2px solid #caa95f;border-radius:20px;box-shadow:0 24px 80px #0008;min-height:calc(100vh - 48px);overflow:hidden}.scl-v211-head{position:sticky;top:0;z-index:3;background:#650007;color:#fff;padding:14px 16px;display:flex;justify-content:space-between;gap:12px;align-items:center}.scl-v211-head h2{margin:0;font-size:18px}.scl-v211-head small{opacity:.85}.scl-v211-close{border:1px solid #e5c979;background:#fff8df;color:#650007;border-radius:10px;padding:8px 12px;font-weight:900}.scl-v211-body{display:grid;grid-template-columns:230px 1fr;min-height:650px}.scl-v211-nav{border-right:1px solid #eadfce;padding:10px;background:#fbf4e8}.scl-v211-nav button{display:block;width:100%;text-align:left;border:0;background:transparent;border-radius:10px;padding:10px;margin:3px 0;color:#4a241c;font-weight:800;cursor:pointer}.scl-v211-nav button.active,.scl-v211-nav button:hover{background:#fff;color:#650007;box-shadow:0 2px 10px #0001}.scl-v211-main{padding:14px}.scl-v211-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.scl-v211-toolbar input,.scl-v211-form input,.scl-v211-form select,.scl-v211-form textarea{width:100%;box-sizing:border-box;border:1px solid #d9c7ae;border-radius:9px;padding:9px;background:#fff}.scl-v211-toolbar input{max-width:340px}.scl-v211-btn{border:1px solid #caa95f;border-radius:9px;padding:9px 12px;background:#fff8df;color:#650007;font-weight:900;cursor:pointer}.scl-v211-btn.primary{background:#650007;color:#fff}.scl-v211-btn.danger{background:#fff0f0;color:#8b0000;border-color:#e5a7a7}.scl-v211-tablewrap{overflow:auto;border:1px solid #eadfce;border-radius:12px;background:#fff}.scl-v211-table{width:100%;border-collapse:collapse;min-width:760px}.scl-v211-table th,.scl-v211-table td{padding:8px;border-bottom:1px solid #eee4d5;text-align:left;vertical-align:top;font-size:11px}.scl-v211-table th{background:#f7efe1;color:#650007;position:sticky;top:0}.scl-v211-card{border:1px solid #eadfce;border-radius:14px;padding:12px;background:#fffaf3;margin-bottom:12px}.scl-v211-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scl-v211-form label{display:block;font-size:11px;font-weight:900;color:#5d3a30;margin:0 0 4px}.scl-v211-field{margin-bottom:9px}.scl-v211-form textarea{min-height:100px;resize:vertical}.scl-v211-status{padding:9px 11px;border-radius:10px;background:#fff8df;border:1px solid #e2c98f;color:#614c21;font-size:11px;margin-bottom:10px}.scl-v211-status.ok{background:#eefaf2;color:#12652e;border-color:#a9d9b8}.scl-v211-status.err{background:#fff0f0;color:#8b0000;border-color:#e5a7a7}.scl-v211-empty{text-align:center;padding:28px;color:#75675d}.scl-v211-module-note{font-size:11px;color:#76685e;margin:-5px 0 12px}.scl-v211-actions{display:flex;gap:6px;flex-wrap:wrap}.scl-v211-pill{display:inline-block;padding:3px 7px;border-radius:99px;background:#f2eadc;font-size:10px;font-weight:800}.scl-v211-kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}.scl-v211-kpi>div{padding:12px;border:1px solid #eadfce;border-radius:12px;background:#fff}.scl-v211-kpi b{display:block;font-size:18px;color:#650007}.scl-v211-kpi small{color:#776960}@media(max-width:780px){.scl-v211-body{grid-template-columns:1fr}.scl-v211-nav{border-right:0;border-bottom:1px solid #eadfce;display:flex;overflow:auto;gap:5px}.scl-v211-nav button{min-width:max-content}.scl-v211-grid{grid-template-columns:1fr}.scl-v211-kpi{grid-template-columns:repeat(2,1fr)}}
</style>
<style id="scl-v212-final-hardening-style">
#sclV212HealthBadge{position:fixed;right:10px;bottom:74px;z-index:2147483640;display:none;max-width:min(92vw,420px);padding:8px 11px;border-radius:10px;background:#fff7df;border:1px solid #d7b86b;color:#5d4300;font:700 11px/1.35 Arial,sans-serif;box-shadow:0 8px 24px #0002}
#sclV212HealthBadge.err{background:#fff0f0;border-color:#d99;color:#800;display:block}
#sclV212HealthBadge.warn{background:#fff7df;border-color:#d7b86b;color:#5d4300;display:block}
.scl-v212-disabled{opacity:.5!important;pointer-events:none!important}
</style>
<!-- SCL FINAL CLEANUP / SETTINGS / NAVIGATION STABILITY -->
<!-- SCL V205: final attendance authority. Prevent legacy attendance/login wrappers from overriding the live Supabase + GPS flow. -->
<style id="scl-v213-final-stability-style">
/* V213 FINAL STABILITY: mobile-first containment for every overlay/profile/admin workspace. */
:root{--scl-vh:100vh;--scl-safe-top:env(safe-area-inset-top,0px);--scl-safe-right:env(safe-area-inset-right,0px);--scl-safe-bottom:env(safe-area-inset-bottom,0px);--scl-safe-left:env(safe-area-inset-left,0px)}
html,body{max-width:100%;overflow-x:hidden}
body.scl-v213-lock{overflow:hidden!important;overscroll-behavior:none!important}
body.scl-v213-lock #sclV211AdminPanel,body.scl-v213-lock #sclModernProfileModal{touch-action:pan-y}
/* All ordinary modal cards get viewport-safe dimensions. */
.modal{padding:max(8px,var(--scl-safe-top)) max(8px,var(--scl-safe-right)) max(8px,var(--scl-safe-bottom)) max(8px,var(--scl-safe-left))!important;box-sizing:border-box}
.modal>.card{width:min(96vw,1180px);max-width:100%;max-height:calc(var(--scl-vh) - 16px);overflow:auto;overscroll-behavior:contain}
#sclModernProfileModal{z-index:2147482500!important;align-items:stretch!important;justify-content:center!important}
#sclModernProfileModal>.scl-profile-modal-card{width:min(1180px,96vw)!important;max-width:100%!important;height:min(95vh,95dvh)!important;max-height:calc(var(--scl-vh) - 16px)!important;margin:auto!important;display:flex!important;flex-direction:column!important;overflow:hidden!important;box-sizing:border-box!important}
#sclModernProfileModal .mh{position:sticky;top:0;z-index:5;flex:0 0 auto}
#sclModernProfileBody{min-height:0!important;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
.scl-profile-dismiss-hint{flex:0 0 auto!important}
/* Admin control center: never depend on document scroll; the workspace itself owns scrolling. */
#sclV211AdminPanel{position:fixed!important;inset:0!important;width:100vw!important;height:var(--scl-vh)!important;max-height:none!important;box-sizing:border-box!important;padding:max(8px,var(--scl-safe-top)) max(8px,var(--scl-safe-right)) max(8px,var(--scl-safe-bottom)) max(8px,var(--scl-safe-left))!important;overflow:hidden!important;z-index:2147483000!important;overscroll-behavior:none!important}
#sclV211AdminPanel.open{display:flex!important;align-items:center!important;justify-content:center!important}
#sclV211AdminPanel .scl-v211-shell{width:min(1180px,100%)!important;height:100%!important;max-height:100%!important;min-height:0!important;margin:0 auto!important;display:flex!important;flex-direction:column!important;overflow:hidden!important;border-radius:20px!important}
#sclV211AdminPanel .scl-v211-head{position:relative!important;top:auto!important;flex:0 0 auto!important;min-height:58px;box-sizing:border-box;padding:10px 12px!important}
#sclV211AdminPanel .scl-v211-body{display:grid!important;grid-template-columns:230px minmax(0,1fr)!important;min-height:0!important;flex:1 1 auto!important;overflow:hidden!important}
#sclV211AdminPanel .scl-v211-nav{min-width:0;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
#sclV211AdminPanel .scl-v211-main{min-width:0;min-height:0;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
#sclV211AdminPanel .scl-v211-tablewrap{max-width:100%;overflow:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch!important}
#sclV211AdminPanel input,#sclV211AdminPanel select,#sclV211AdminPanel textarea,#sclV211AdminPanel button{font-size:16px;touch-action:manipulation}
@media(max-width:780px){
  #sclV211AdminPanel{padding:0!important}
  #sclV211AdminPanel .scl-v211-shell{width:100%!important;height:100%!important;border-radius:0!important;border-left:0!important;border-right:0!important}
  #sclV211AdminPanel .scl-v211-head{padding:calc(8px + var(--scl-safe-top)) 10px 8px!important;min-height:64px}
  #sclV211AdminPanel .scl-v211-head h2{font-size:15px!important;line-height:1.15}
  #sclV211AdminPanel .scl-v211-head small{font-size:9px;line-height:1.2;display:block;max-width:75vw}
  #sclV211AdminPanel .scl-v211-close{min-width:44px;min-height:44px;padding:8px!important;flex:0 0 auto}
  #sclV211AdminPanel .scl-v211-body{grid-template-columns:1fr!important;grid-template-rows:auto minmax(0,1fr)!important}
  #sclV211AdminPanel .scl-v211-nav{display:flex!important;gap:5px!important;padding:7px!important;border-right:0!important;border-bottom:1px solid #eadfce!important;overflow-x:auto!important;overflow-y:hidden!important;white-space:nowrap!important;scroll-snap-type:x proximity}
  #sclV211AdminPanel .scl-v211-nav button{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:auto!important;min-width:max-content!important;margin:0!important;padding:9px 11px!important;min-height:40px!important;scroll-snap-align:start}
  #sclV211AdminPanel .scl-v211-main{padding:10px!important}
  #sclV211AdminPanel .scl-v211-toolbar{position:sticky;top:0;z-index:4;background:#fffdf8;padding:5px 0 8px;margin:-2px 0 8px}
  #sclV211AdminPanel .scl-v211-toolbar input{max-width:none!important;min-width:0;flex:1 1 100%}
  #sclV211AdminPanel .scl-v211-toolbar .scl-v211-btn{flex:1 1 calc(50% - 5px);min-height:42px}
  #sclV211AdminPanel .scl-v211-kpi{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  #sclV211AdminPanel .scl-v211-card{padding:10px!important}
  #sclV211AdminPanel .scl-v211-grid{grid-template-columns:1fr!important}
  #sclV211AdminPanel .scl-v211-table{min-width:700px}
  #sclV211AdminPanel .scl-v211-actions .scl-v211-btn{min-height:40px}
  #sclModernProfileModal{padding:0!important}
  #sclModernProfileModal>.scl-profile-modal-card{width:100vw!important;height:var(--scl-vh)!important;max-height:none!important;border-radius:0!important;margin:0!important}
  #sclModernProfileModal .mh{padding:calc(8px + var(--scl-safe-top)) 10px 8px!important}
  #sclModernProfileModal .mh h3{font-size:14px!important}
  #sclModernProfileModal .scl-profile-home-close{min-width:58px!important;min-height:42px!important}
  #sclModernProfileBody{padding-bottom:max(10px,var(--scl-safe-bottom))}
  .scl-profile-toolbar{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media(max-width:420px){
  #sclV211AdminPanel .scl-v211-head small{display:none}
  #sclV211AdminPanel .scl-v211-kpi{grid-template-columns:1fr 1fr!important}
  #sclModernProfileModal .scl-profile-toolbar{grid-template-columns:1fr!important}
}
/* Prevent accidental text selection/drag from looking like the overlay vanished. */
#sclV211AdminPanel .scl-v211-close,#sclV211AdminPanel .scl-v211-nav button,#sclModernProfileModal button{user-select:none;-webkit-user-select:none}
</style>
<style id="scl-v93-timetable-ui">
/* V93: one responsive timetable table, colour-coded by weekday and scaled by duration. */
.scl-v93-one-table{width:100%!important;min-width:0!important;max-width:100%!important;table-layout:fixed!important;border-collapse:separate!important;border-spacing:4px!important;background:transparent!important}
.scl-v93-one-table .scl-tt-time-col{width:112px!important}
.scl-v93-one-table .scl-tt-day-col{width:auto!important}
.scl-v93-one-table thead th{position:sticky;top:0;z-index:4;border:0!important}
.scl-v93-one-table .scl-tt-corner{background:#3b124f!important;color:#fff!important;border-radius:12px!important;padding:10px 7px!important;font-size:11px!important;font-weight:950!important;letter-spacing:.04em!important}
.scl-v93-one-table .scl-tt-day-head{position:relative;padding:9px 5px!important;border-radius:12px!important;color:#fff!important;text-align:center!important;font-weight:950!important;box-shadow:0 5px 12px rgba(0,0,0,.10)!important}
.scl-v93-one-table .scl-tt-day-head span{display:block;font-size:13px!important;line-height:1.05!important}
.scl-v93-one-table .scl-tt-day-head small{display:block;font-size:8px!important;line-height:1.1!important;margin-top:4px!important;opacity:.9!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-day-monday{background:#3978d4!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-day-tuesday{background:#269a68!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-day-wednesday{background:#8057c7!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-day-thursday{background:#d47a25!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-day-friday{background:#168a9b!important}
.scl-v93-one-table .scl-tt-day-head.scl-tt-today{outline:3px solid #ffd34e!important;outline-offset:2px!important;box-shadow:0 0 0 5px rgba(255,211,78,.22),0 8px 20px rgba(76,34,111,.28)!important;transform:translateY(-1px)!important}
.scl-v93-one-table .scl-tt-today-badge{display:block!important;margin:4px auto 0!important;width:max-content!important;padding:2px 6px!important;border-radius:999px!important;background:#fff!important;color:#4c2270!important;font-size:7px!important;font-weight:1000!important;letter-spacing:.08em!important}
.scl-v93-one-table tbody .scl-tt-row{--rowh:52px}
.scl-v93-one-table tbody .scl-tt-row-p1,.scl-v93-one-table tbody .scl-tt-row-p2,.scl-v93-one-table tbody .scl-tt-row-p3,.scl-v93-one-table tbody .scl-tt-row-p5{--rowh:64px}
.scl-v93-one-table tbody .scl-tt-row-p4{--rowh:58px}
.scl-v93-one-table tbody .scl-tt-row-lesson{--rowh:70px}
.scl-v93-one-table tbody .scl-tt-row-sb{--rowh:38px}
.scl-v93-one-table tbody .scl-tt-row-lb{--rowh:46px}
.scl-v93-one-table tbody .scl-tt-row-t1,.scl-v93-one-table tbody .scl-tt-row-t2,.scl-v93-one-table tbody .scl-tt-row-t3{--rowh:27px}
.scl-v93-one-table .scl-tt-block-head,.scl-v93-one-table .scl-tt-day-cell{height:var(--rowh)!important;min-height:var(--rowh)!important;box-sizing:border-box!important;border-radius:10px!important;overflow:hidden!important}
.scl-v93-one-table .scl-tt-block-head{padding:5px 6px!important;text-align:left!important;vertical-align:middle!important;background:#f0e7f5!important;color:#3b124f!important;border:1px solid rgba(76,34,111,.12)!important}
.scl-v93-one-table .scl-tt-block-head b{display:block;font-size:10px!important;line-height:1.05!important}
.scl-v93-one-table .scl-tt-block-head small{display:block;font-size:7px!important;opacity:.72!important;margin-top:2px!important}
.scl-v93-one-table .scl-tt-block-head em{display:block;font-size:7px!important;font-style:normal!important;opacity:.75!important;margin-top:2px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.scl-v93-one-table .scl-tt-row-t1 .scl-tt-block-head,.scl-v93-one-table .scl-tt-row-t2 .scl-tt-block-head,.scl-v93-one-table .scl-tt-row-t3 .scl-tt-block-head{background:#e7e0ee!important}
.scl-v93-one-table .scl-tt-row-sb .scl-tt-block-head{background:#ffe6a8!important}
.scl-v93-one-table .scl-tt-row-lb .scl-tt-block-head{background:#ffd07a!important}
.scl-v93-one-table .scl-tt-row-t1 .scl-tt-block-head b,.scl-v93-one-table .scl-tt-row-t2 .scl-tt-block-head b,.scl-v93-one-table .scl-tt-row-t3 .scl-tt-block-head b{font-size:8px!important}
.scl-v93-one-table .scl-tt-day-cell{padding:3px!important;vertical-align:middle!important;border:1px solid rgba(0,0,0,.07)!important}
.scl-v93-one-table .scl-tt-day-cell.monday{background:rgba(57,120,212,.09)!important;border-color:rgba(57,120,212,.20)!important}
.scl-v93-one-table .scl-tt-day-cell.tuesday{background:rgba(38,154,104,.09)!important;border-color:rgba(38,154,104,.20)!important}
.scl-v93-one-table .scl-tt-day-cell.wednesday{background:rgba(128,87,199,.09)!important;border-color:rgba(128,87,199,.20)!important}
.scl-v93-one-table .scl-tt-day-cell.thursday{background:rgba(212,122,37,.09)!important;border-color:rgba(212,122,37,.20)!important}
.scl-v93-one-table .scl-tt-day-cell.friday{background:rgba(22,138,155,.09)!important;border-color:rgba(22,138,155,.20)!important}
.scl-v93-one-table .scl-tt-day-cell.scl-tt-today{box-shadow:inset 0 0 0 2px #ffd34e!important}
.scl-v93-one-table .scl-tt-cell-entry,.scl-v93-one-table .scl-tt-empty-cell,.scl-v93-one-table .scl-tt-fixed-block{width:100%!important;height:100%!important;min-height:0!important;box-sizing:border-box!important;margin:0!important;border-radius:8px!important;border:0!important;padding:4px!important;overflow:hidden!important}
.scl-v93-one-table .scl-tt-cell-entry{display:flex!important;flex-direction:column!important;justify-content:center!important;align-items:center!important;text-align:center!important;gap:2px!important;background:rgba(255,255,255,.92)!important;color:#281c2e!important;cursor:pointer!important}
.scl-v93-one-table .scl-tt-cell-entry:hover{transform:translateY(-1px);box-shadow:0 5px 12px rgba(0,0,0,.12)!important}
.scl-v93-one-table .scl-tt-cell-entry b{font-size:10px!important;line-height:1.08!important;overflow-wrap:anywhere!important}
.scl-v93-one-table .scl-tt-cell-entry small{font-size:7px!important;line-height:1.05!important;overflow-wrap:anywhere!important;opacity:.78!important}
.scl-v93-one-table .scl-tt-empty-cell{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;background:rgba(255,255,255,.55)!important;color:#766d78!important}
.scl-v93-one-table .scl-tt-empty-cell b{font-size:8px!important}.scl-v93-one-table .scl-tt-empty-cell small{font-size:6px!important}
.scl-v93-one-table .scl-tt-fixed-block{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;text-align:center!important;background:rgba(255,238,191,.82)!important;color:#634b13!important}
.scl-v93-one-table .scl-tt-row-t1 .scl-tt-fixed-block,.scl-v93-one-table .scl-tt-row-t2 .scl-tt-fixed-block,.scl-v93-one-table .scl-tt-row-t3 .scl-tt-fixed-block{background:rgba(225,220,232,.80)!important;color:#665b6b!important}
.scl-v93-one-table .scl-tt-row-sb .scl-tt-fixed-block{background:rgba(255,219,113,.88)!important;color:#684f0a!important}
.scl-v93-one-table .scl-tt-row-lb .scl-tt-fixed-block{background:rgba(255,192,68,.90)!important;color:#604400!important}
.scl-v93-one-table .scl-tt-fixed-block b{font-size:8px!important;line-height:1.05!important;overflow-wrap:anywhere!important}.scl-v93-one-table .scl-tt-fixed-block small{font-size:6px!important;line-height:1.05!important}
.scl-v93-one-table .scl-tt-highlight{outline:2px solid #8a4de8!important;outline-offset:-2px!important;box-shadow:0 0 0 3px rgba(138,77,232,.18)!important}
.scl-tt-weekend-today{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:0 0 8px;padding:7px 10px;border:2px solid #ffd34e;border-radius:12px;background:linear-gradient(135deg,rgba(255,211,78,.18),rgba(138,77,232,.12));color:#fff;font-size:11px;font-weight:900;text-align:center}
.scl-tt-weekend-today span{color:#ffd34e}.scl-tt-weekend-today small{opacity:.86;font-weight:700}
@media(max-width:600px){
  .scl-v93-one-table{font-size:8px!important;border-spacing:2px!important}
  .scl-v93-one-table .scl-tt-time-col{width:58px!important}
  .scl-v93-one-table .scl-tt-day-head{padding:7px 2px!important;border-radius:8px!important}
  .scl-v93-one-table .scl-tt-day-head span{font-size:9px!important}
  .scl-v93-one-table .scl-tt-day-head small{font-size:6px!important;margin-top:2px!important}
  .scl-v93-one-table .scl-tt-today-badge{font-size:5px!important;padding:1px 4px!important;margin-top:2px!important}
  .scl-v93-one-table .scl-tt-block-head{padding:3px 3px!important;border-radius:6px!important}
  .scl-v93-one-table .scl-tt-block-head b{font-size:7px!important}
  .scl-v93-one-table .scl-tt-block-head small,.scl-v93-one-table .scl-tt-block-head em{font-size:5px!important}
  .scl-v93-one-table .scl-tt-day-cell{padding:2px!important;border-radius:6px!important}
  .scl-v93-one-table .scl-tt-cell-entry,.scl-v93-one-table .scl-tt-empty-cell,.scl-v93-one-table .scl-tt-fixed-block{padding:2px!important;border-radius:5px!important}
  .scl-v93-one-table .scl-tt-cell-entry b{font-size:7px!important}
  .scl-v93-one-table .scl-tt-cell-entry small{font-size:5.5px!important}
  .scl-v93-one-table .scl-tt-empty-cell b,.scl-v93-one-table .scl-tt-fixed-block b{font-size:6px!important}
  .scl-v93-one-table .scl-tt-empty-cell small,.scl-v93-one-table .scl-tt-fixed-block small{font-size:5px!important}
  .scl-v93-one-table tbody .scl-tt-row-p1,.scl-v93-one-table tbody .scl-tt-row-p2,.scl-v93-one-table tbody .scl-tt-row-p3,.scl-v93-one-table tbody .scl-tt-row-p5{--rowh:55px}
  .scl-v93-one-table tbody .scl-tt-row-p4{--rowh:50px}
  .scl-v93-one-table tbody .scl-tt-row-lesson{--rowh:59px}
  .scl-v93-one-table tbody .scl-tt-row-sb{--rowh:32px}
  .scl-v93-one-table tbody .scl-tt-row-lb{--rowh:39px}
  .scl-v93-one-table tbody .scl-tt-row-t1,.scl-v93-one-table tbody .scl-tt-row-t2,.scl-v93-one-table tbody .scl-tt-row-t3{--rowh:20px}
  .scl-tt-weekend-today{font-size:9px;gap:5px;margin-bottom:6px;padding:6px}
}
</style>
<style id="scl-v94-vertical-days-square">
/* V94: compact real-life timetable layout — weekdays vertically, periods horizontally. */
.scl-v94-timetable-square{width:100%!important;max-width:100%!important;overflow:hidden!important;margin:0 auto!important}
.scl-v94-vertical-days{width:100%!important;min-width:0!important;max-width:100%!important;table-layout:fixed!important;border-collapse:separate!important;border-spacing:2px!important}
.scl-v94-vertical-days .scl-tt-day-col{width:13%!important}
.scl-v94-vertical-days .scl-tt-col-p1,.scl-v94-vertical-days .scl-tt-col-p2,.scl-v94-vertical-days .scl-tt-col-p3,.scl-v94-vertical-days .scl-tt-col-p5{width:12.42%!important}
.scl-v94-vertical-days .scl-tt-col-p4{width:11.30%!important}
.scl-v94-vertical-days .scl-tt-col-lesson{width:13.55%!important}
.scl-v94-vertical-days .scl-tt-col-t1,.scl-v94-vertical-days .scl-tt-col-t2,.scl-v94-vertical-days .scl-tt-col-t3{width:1.14%!important}
.scl-v94-vertical-days .scl-tt-col-sb{width:3.39%!important}
.scl-v94-vertical-days .scl-tt-col-lb{width:6.78%!important}
.scl-v94-vertical-days thead th{position:static!important}
.scl-v94-vertical-days .scl-tt-corner{padding:6px 3px!important;font-size:9px!important;line-height:1.05!important}
.scl-v94-vertical-days .scl-tt-period-head{padding:5px 2px!important;border-radius:7px!important;text-align:center!important;vertical-align:middle!important;overflow:hidden!important}
.scl-v94-vertical-days .scl-tt-period-head b{display:block!important;font-size:9px!important;line-height:1!important}
.scl-v94-vertical-days .scl-tt-period-head small{display:block!important;font-size:6px!important;line-height:1!important;margin-top:2px!important;opacity:.9!important}
.scl-v94-vertical-days .scl-tt-period-head em{display:block!important;font-size:5px!important;line-height:1!important;margin-top:2px!important;font-style:normal!important;white-space:nowrap!important;overflow:hidden!important}
.scl-v94-vertical-days .scl-tt-period-t1,.scl-v94-vertical-days .scl-tt-period-t2,.scl-v94-vertical-days .scl-tt-period-t3{background:#ddd5e6!important;color:#5c5063!important}
.scl-v94-vertical-days .scl-tt-period-sb{background:#ffe08a!important;color:#654b0a!important}
.scl-v94-vertical-days .scl-tt-period-lb{background:#ffc85c!important;color:#604000!important}
.scl-v94-vertical-days .scl-tt-period-p1,.scl-v94-vertical-days .scl-tt-period-p2,.scl-v94-vertical-days .scl-tt-period-p3,.scl-v94-vertical-days .scl-tt-period-p4,.scl-v94-vertical-days .scl-tt-period-p5,.scl-v94-vertical-days .scl-tt-period-lesson{background:#4d2469!important;color:#fff!important}
.scl-v94-vertical-days .scl-tt-day-row{height:auto!important}
.scl-v94-vertical-days .scl-tt-day-head-cell{position:relative!important;padding:4px 3px!important;border-radius:7px!important;text-align:center!important;vertical-align:middle!important;color:#fff!important;font-weight:1000!important;overflow:hidden!important}
.scl-v94-vertical-days .scl-tt-day-head-cell span{display:block!important;font-size:9px!important;line-height:1.05!important}
