#sclDirectPaymentRoot .scl-dp-pending{background:#fff8df;color:#765500;border-color:#e6cb76}
#sclDirectPaymentRoot .scl-dp-unpaid{background:#fff1f1;color:#8b1018;border-color:#e1a0a5}
#sclDirectPaymentRoot .scl-dp-box{border:2px solid #ead5b6;border-radius:13px;background:#fffdf8;padding:12px;margin:10px 0}
#sclDirectPaymentRoot .scl-dp-box h3{margin:0 0 8px;color:#650007;font-size:16px}
#sclDirectPaymentRoot .scl-dp-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
#sclDirectPaymentRoot .scl-dp-form label{font-size:11px;font-weight:900;color:#51463d}
#sclDirectPaymentRoot .scl-dp-form input,#sclDirectPaymentRoot .scl-dp-form select{width:100%;box-sizing:border-box;margin-top:4px;padding:10px;border:1px solid #cdbda6;border-radius:9px;background:#fff;font:inherit}
#sclDirectPaymentRoot .scl-dp-account{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
#sclDirectPaymentRoot .scl-dp-account>div{border:1px solid #decba5;border-radius:10px;padding:9px;background:#fff8e8;font-size:11px;line-height:1.45}
#sclDirectPaymentRoot .scl-dp-account b{color:#650007}
#sclDirectPaymentRoot .scl-dp-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
#sclDirectPaymentRoot .scl-dp-actions button{border:1px solid #650007;background:#650007;color:#fff;border-radius:9px;padding:9px 12px;font-weight:950;cursor:pointer}
#sclDirectPaymentRoot .scl-dp-actions button.secondary{background:#fff;color:#650007;border-color:#caa95f}
#sclDirectPaymentRoot .scl-dp-total{font-size:17px;font-weight:950;color:#650007}
#sclDirectPaymentRoot .scl-dp-small{font-size:11px;line-height:1.45;color:#675a4e}
#sclDirectPaymentRoot .scl-dp-scan{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
#sclDirectPaymentRoot .scl-dp-scan button{border:1px solid #caa95f;background:#fff8df;color:#650007;border-radius:8px;padding:8px 10px;font-weight:900;cursor:pointer}
#sclDirectPaymentRoot #sclDirectReceiptPreview{max-width:100%;max-height:220px;display:none;border:1px solid #d8c6ad;border-radius:9px;margin-top:8px}
#sclDirectPaymentRoot .scl-dp-error{color:#8b1018;font-weight:800;font-size:11px;margin-top:5px}
@media(max-width:700px){#sclDirectPaymentRoot{padding:0}#sclDirectPaymentRoot .scl-dp-card{max-height:100vh;border-radius:0;border-width:0 0 3px}#sclDirectPaymentRoot .scl-dp-modes{grid-template-columns:1fr}.scl-dp-classes{grid-template-columns:1fr!important}#sclDirectPaymentRoot .scl-dp-form,#sclDirectPaymentRoot .scl-dp-account{grid-template-columns:1fr}.scl-dp-body{padding:10px!important}}
</style>
<!-- SCL V205: final attendance authority. Prevent legacy attendance/login wrappers from overriding the live Supabase + GPS flow. -->
<script id="scl-v205-final-attendance-authority">
(function(){
  'use strict';
  const TZ='Africa/Lagos', START=450, END=960;
  function auth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
  function mins(){const p=new Intl.DateTimeFormat('en-GB',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());return Number(p.find(x=>x.type==='hour')?.value||0)*60+Number(p.find(x=>x.type==='minute')?.value||0)}
  function within(){const m=mins();return m>=START&&m<=END}
  function approved(a){const r=(a?.roles||[]).map(x=>String(x).toLowerCase());return !!(a?.staff||a?.student||r.some(x=>['developer','technical_admin','management_admin','affairs_admin','teacher','staff','worker','student'].includes(x)))}
  function attendance(){return typeof window.sclOpenAttendance==='function'}

  /* Final Sign In entry: authentication is separate from attendance, but approved users can be routed to attendance during the 7:30–4 window. */
  window.sclOpenSignInChoice=function(){
    const a=auth();
    if(a?.accessToken && a?.user && approved(a)){
      if(within()){window.sclGateEnterAfterAuth?.();closeM?.('sclSignInChoiceModal');window.sclOpenAttendance?.('self');return;}
      toast?.('Attendance Sign In is currently closed. LOGIN remains available for normal SCL access.');return;
    }
    sessionStorage.setItem('sclPendingAttendanceSignIn','staff');
    if(typeof openM==='function')openM('sclSignInChoiceModal');
    const st=document.getElementById('sclSignInChoiceStatus');
    if(st){st.classList.remove('hidden');st.textContent='Use your approved SCL school identity to continue. Attendance opens from 7:30 AM to 4:00 PM (Africa/Lagos).';}
  };

  window.sclBeginAttendanceSignIn=function(category){
    if(!within()){toast?.('Attendance Sign In is available from 7:30 AM to 4:00 PM (Africa/Lagos). You may still use LOGIN for normal SCL access.');return;}
    sessionStorage.setItem('sclPendingAttendanceSignIn',category||'staff');
    const a=auth();
    if(a?.accessToken&&a?.user){
      if(!approved(a)){sessionStorage.removeItem('sclPendingAttendanceSignIn');toast?.('This account is not approved for SCL Sign In.');return;}
      window.sclGateEnterAfterAuth?.();closeM?.('sclSignInChoiceModal');window.sclOpenAttendance?.('self');return;
    }
    closeM?.('sclSignInChoiceModal');openM?.('loginModal');
    const box=document.getElementById('sclLoginStatus');
    if(box){box.classList.remove('hidden');box.textContent='Sign in with your approved SCL account. After successful authentication, attendance will open automatically.';box.classList.add('statusbox');}
  };

  /* Final attendance submit: Supabase account + GPS geofence. No /api/auth/login and no mandatory passkey dependency. */
  window.sclV42SubmitAttendance=async function(){
    const action=window.__sclV42Action||'in';
    const username=document.getElementById('sclV42Username')?.value.trim();
    const branch=document.querySelector('input[name="sclV42Branch"]:checked')?.value;
    const period=document.querySelector('input[name="sclV42Period"]:checked')?.value||'';
    const status=document.getElementById('sclV42LocationStatus');
    const btn=document.getElementById('sclV42Submit');
    if(!username){toast?.('Enter your SCL email/username first.');return}
    if(!branch){toast?.('Select your school location first.');return}
    if(action==='in'&&!period){toast?.('Select Morning or Afternoon attendance.');return}
    const m=mins();
    if(action==='in' && (m<START||m>END)){toast?.('Attendance is available from 7:30 AM to 4:00 PM (Africa/Lagos).');return}
    const a=auth();
    if(!a?.accessToken||!a?.user){window.__sclV42Pending={action,username,branch,period,location:null};openM?.('loginModal');return}
    if(!approved(a)){toast?.('Your account is not an approved SCL school identity.');return}
    const loginEmail=String(a.user?.email||a.profile?.email||'').trim().toLowerCase();
    if(loginEmail&&username.toLowerCase()!==loginEmail){toast?.('The email/username does not match the SCL account currently signed in.');return}
    if(btn)btn.disabled=true;
    try{
      if(status)status.innerHTML='<div class="scl-att-warning">Checking your live school location…</div>';
      if(!navigator.geolocation)throw new Error('This device/browser does not provide GPS location.');
      const pos=await new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(resolve,reject,{enableHighAccuracy:true,maximumAge:0,timeout:20000}));
      const c=pos.coords,accuracy=Number(c.accuracy||0);
      if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude))throw new Error('The device did not return a usable GPS location.');
      const branches=await (async()=>{const r=await fetch(window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance?action=branches',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Unable to load the school attendance locations.');return d.branches||[]})();
      const b=branches.find(x=>String(x.id)===String(branch));
      if(!b)throw new Error('The selected school location is not available. Please contact the administrator.');
      if(b.latitude==null||b.longitude==null)throw new Error('The selected school location has no GPS coordinates configured. An administrator must configure the branch before attendance can be recorded.');
      const R=6371000,rad=x=>x*Math.PI/180,dl=rad(Number(b.latitude)-c.latitude),dn=rad(Number(b.longitude)-c.longitude),q=Math.sin(dl/2)**2+Math.cos(rad(c.latitude))*Math.cos(rad(Number(b.latitude)))*Math.sin(dn/2)**2,dist=2*R*Math.asin(Math.sqrt(q)),radius=Number(b.radius_m||150);
      if(dist>radius)throw new Error('Location not confirmed. You are about '+Math.round(dist)+' m from '+String(b.name||'the selected school')+'. Please move to the school location and try again.');
      if(status)status.innerHTML='<div class="scl-att-warning">Location confirmed ('+Math.round(dist)+' m). Recording attendance securely…</div>';
      const h={'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+a.accessToken,'Content-Type':'application/json'};
      const rr=await fetch(window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance?action='+encodeURIComponent(action==='in'?'sign_in':'sign_out'),{method:'POST',headers:h,body:JSON.stringify({branch_id:branch,latitude:c.latitude,longitude:c.longitude,accuracy_m:accuracy,verification:'device_location_and_account_login',staff_username:username,attendance_period:period})});
      const out=await rr.json().catch(()=>({}));if(!rr.ok)throw new Error(out.error||'The attendance service rejected the submission.');
      toast?.(action==='in'?'Attendance signed in successfully.':'Attendance signed out successfully.');
      window.sclCalendarAttendanceSync?.();window.sclAttendanceStatusSync?.(out.record);
      if(typeof window.sclOpenAttendance==='function')await window.sclOpenAttendance('self');
    }catch(e){if(status)status.innerHTML='<div class="scl-att-error">'+String(e.message||'Attendance could not be completed.').replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]))+'</div>';}
    finally{if(btn)btn.disabled=false;}
  };

  /* Prevent the legacy /api/auth/login attendance wrapper from surviving in the final page. */
  window.__sclAttendanceAuthority={version:'V205',timezone:TZ,attendanceStart:'07:00',attendanceEnd:'16:00',requiresSupabaseAuth:true,requiresGps:true,requiresPasskey:false};
})();
</script>
<style id="scl-v210-admin-identity-style">#sclV210AdminIdentityModal{z-index:99999}.scl-v210-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scl-v210-card{border:1px solid #ead5b6;border-radius:14px;background:linear-gradient(145deg,#fffdf8,#f7efe1);padding:14px}.scl-v210-card h4{margin:0 0 6px;color:#650007}.scl-v210-card p{font-size:12px;line-height:1.5;margin:5px 0;color:#5e5148}.scl-v210-field{display:flex;flex-direction:column;gap:5px;margin:8px 0}.scl-v210-field label{font-size:11px;font-weight:900;color:#5d5147}.scl-v210-field input{padding:10px;border:1px solid #cdbda6;border-radius:9px;background:#fff;font:inherit;box-sizing:border-box;width:100%}.scl-v210-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.scl-v210-actions button{border:1px solid #650007;border-radius:9px;padding:9px 12px;font-weight:900;cursor:pointer;background:#650007;color:#fff}.scl-v210-actions button.secondary{background:#fff;color:#650007;border-color:#caa95f}.scl-v210-status{padding:9px;border-radius:9px;background:#fff8df;border:1px solid #e5cf83;font-size:11px;margin:8px 0;line-height:1.45}.scl-v210-status.ok{background:#edf9f1;border-color:#9bcfaf;color:#17653a}.scl-v210-status.err{background:#fff0f0;border-color:#dfa2a7;color:#8b1018}.scl-v210-table{width:100%;border-collapse:collapse;font-size:11px}.scl-v210-table th,.scl-v210-table td{padding:8px;border-bottom:1px solid #eadfce;text-align:left;vertical-align:top}.scl-v210-table th{background:#f7efe1;color:#650007}.scl-v210-lock{position:fixed;inset:0;background:rgba(39,20,12,.78);z-index:100000;display:flex;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(8px)}.scl-v210-lock .box{width:min(520px,100%);background:#fffdf8;border:2px solid #caa95f;border-radius:18px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.35)}.scl-v210-lock h3{margin:0 0 7px;color:#650007}.scl-v210-lock p{font-size:12px;line-height:1.55;color:#5e5148}@media(max-width:720px){.scl-v210-grid{grid-template-columns:1fr}}</style>
</div><script id="scl-v89-attendance-navigation-fix">
(function(){
  'use strict';
  function addAttendanceNav(){
    const card=document.querySelector('#sclAttendanceModal .card');
    if(!card)return;
    const mh=card.querySelector('.mh');
    if(!mh||mh.querySelector('.scl-att-nav-fix'))return;
    const nav=document.createElement('span');nav.className='scl-att-nav-fix';nav.style.cssText='margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap';
    nav.innerHTML='<button type="button" class="btn outline" onclick="closeM(\'sclAttendanceModal\')">← BACK</button><button type="button" class="btn outline" onclick="closeM(\'sclAttendanceModal\');sclOpenModernProfile?.()">PROFILE</button><button type="button" class="btn gold" onclick="closeM(\'sclAttendanceModal\');sclOpenBranchAdmin?.()">📍 BRANCH GPS</button>';
    mh.appendChild(nav);
  }
  function diagnose(){
    const body=document.getElementById('sclAttendanceBody');if(!body)return;
    const cards=body.querySelectorAll('.scl-att-branch');
    let missing=false;cards.forEach(c=>{if(/GPS NOT CONFIGURED/i.test(c.textContent||''))missing=true;});
    if(missing && !body.querySelector('.scl-v89-gps-block')){
      const n=document.createElement('div');n.className='scl-v89-gps-block scl-att-error';n.style.cssText='margin:12px 0;padding:12px;border-radius:10px';
      n.innerHTML='<b>Attendance cannot be recorded yet.</b><br>The SCL branch GPS coordinates have not been captured. An administrator must stand at the physical school location and use <b>BRANCH GPS</b> to capture the exact device location before staff can sign in.';
      const target=body.querySelector('.scl-att-card');
      (target||body).prepend(n);
    }
  }
  const original=window.sclOpenAttendance;
  if(typeof original==='function'){
    window.sclOpenAttendance=async function(mode){
      addAttendanceNav();
      try{const r=await original.apply(this,arguments);setTimeout(function(){addAttendanceNav();diagnose()},250);return r}
      catch(e){addAttendanceNav();throw e}
    };
  }
  document.addEventListener('DOMContentLoaded',function(){addAttendanceNav();setTimeout(diagnose,500)});
})();
</script>
<!-- SCL V91: CREATE EMAIL / USER ID INTEGRATED IDENTITY ACTION -->
<style id="scl-create-email-userid-css">
#sclCreateEmailUserIdModal{z-index:100500}.scl-ceui-card{max-width:760px;width:min(96vw,760px)}
.scl-ceui-banner{padding:13px 15px;border:1px solid #e4c46a;border-radius:13px;background:linear-gradient(135deg,#fff8dc,#fff);line-height:1.5;color:#4b1d00}
.scl-ceui-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.scl-ceui-result{margin-top:12px;padding:14px;border-radius:13px;border:1px solid #ead5b6;background:#fffaf0}.scl-ceui-id{font-size:24px;font-weight:1000;letter-spacing:.7px;color:#650007}.scl-ceui-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.scl-ceui-actions button{flex:1;min-width:170px}
@media(max-width:620px){.scl-ceui-grid{grid-template-columns:1fr}.scl-ceui-id{font-size:20px}}
</style>
<script id="scl-create-email-userid-layer">
(function(){
'use strict';
const SB=()=>window.sclSupabase;
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function clean(v){return String(v||'').trim().toLowerCase().replace(/[^a-z0-9]+/g,'')}
function modal(){
 if(document.getElementById('sclCreateEmailUserIdModal'))return;
 const m=document.createElement('div');m.id='sclCreateEmailUserIdModal';m.className='modal';m.setAttribute('aria-hidden','true');
 m.innerHTML='<div class="card scl-ceui-card"><div class="mh"><div><h3>📧 CREATE EMAIL / USER ID</h3><small>One secure action for your SCL academic email identity and school User ID.</small></div><button type="button" onclick="closeM(\'sclCreateEmailUserIdModal\')">X</button></div><div class="form"><div class="scl-ceui-banner"><b>Your SCL identity is permanent.</b><br>The system first checks the authenticated SCL account. If you already belong to this school, it returns your existing school ID instead of creating a duplicate. If you are new to this school, the next number in the single school-wide registration sequence is allocated. Your person identity remains reusable when you join another school.</div><div class="scl-ceui-grid"><div class="field"><label>Full name *</label><input id="sclCEUIName" autocomplete="name" required></div><div class="field"><label>Verified account email *</label><input id="sclCEUIAuthEmail" type="email" readonly></div><div class="field"><label>Account type *</label><select id="sclCEUIType"><option value="administrator">Administrator</option><option value="teacher">Teacher</option><option value="staff">Staff / Worker</option><option value="student">Student</option><option value="parent">Parent</option><option value="guardian">Guardian</option><option value="visitor">Visitor</option></select></div><div class="field"><label>Academic email domain</label><input id="sclCEUIDomain" placeholder="e.g. scl.edu"></div></div><div id="sclCEUIStatus" class="statusbox hidden"></div><div id="sclCEUIResult" class="scl-ceui-result" hidden></div><div class="scl-ceui-actions"><button class="btn outline" type="button" onclick="closeM(\'sclCreateEmailUserIdModal\')">CANCEL</button><button class="btn gold" type="button" onclick="sclCreateEmailUserId()">CREATE / LINK EMAIL & USER ID</button></div></div></div>';
 document.body.appendChild(m);
}
function inferType(u){const md=u?.user_metadata||{};const t=String(md.registration_type||md.account_type||md.membership_type||md.role||'').toLowerCase();for(const x of ['administrator','teacher','staff','student','parent','guardian','visitor'])if(t.includes(x))return x;return 'visitor'}
function setStatus(msg,bad){const s=document.getElementById('sclCEUIStatus');s.classList.remove('hidden');s.textContent=msg;s.style.color=bad?'#9b111e':'#315b32'}
window.sclOpenCreateEmailUserId=async function(){modal();const s=document.getElementById('sclCEUIStatus'),r=document.getElementById('sclCEUIResult');r.hidden=true;s.classList.add('hidden');try{const sb=SB();if(!sb?.auth?.getUser)throw new Error('SCL authentication is not ready.');const ur=await sb.auth.getUser();const u=ur?.data?.user;if(!u)throw new Error('Please sign in first. Your User ID must be securely linked to your authenticated account.');const md=u.user_metadata||{};document.getElementById('sclCEUIName').value=md.full_name||md.name||'';document.getElementById('sclCEUIAuthEmail').value=u.email||'';document.getElementById('sclCEUIType').value=inferType(u);document.getElementById('sclCEUIDomain').value=localStorage.getItem('sclAcademicEmailDomain')||'';openM('sclCreateEmailUserIdModal');}catch(e){openM('sclCreateEmailUserIdModal');setStatus(e.message||'Please sign in first.',true)}};
window.sclCreateEmailUserId=async function(){
 try{const sb=SB();const ur=await sb.auth.getUser();const u=ur?.data?.user;if(!u)throw new Error('Please sign in before creating your SCL User ID.');const name=document.getElementById('sclCEUIName').value.trim(),type=document.getElementById('sclCEUIType').value,domain=document.getElementById('sclCEUIDomain').value.trim().toLowerCase().replace(/^https?:\/\//,'').replace(/^www\./,'').replace(/\/.*$/,'').replace(/[^a-z0-9.-]/g,'');if(!name)throw new Error('Enter the full name.');setStatus('Securely checking your existing SCL identity and allocating the school ID…');const q=await sb.rpc('scl_register_or_join_identity',{p_full_name:name,p_membership_type:type});if(q?.error)throw q.error;const row=q?.data?.[0];if(!row)throw new Error('The identity service returned no registration record.');const id=row.school_id_number||row.primary_id||'';if(!id)throw new Error('The school User ID was not returned.');let academicEmail='';if(domain){const base=clean(name).split('').length?clean(name):'scluser';const code=String(row.sequence_code||'').trim();academicEmail=(code?('scl'+clean(row.name_initials||'')+code):base)+'@'+domain;try{localStorage.setItem('sclAcademicEmailDomain',domain)}catch(_){} }const r=document.getElementById('sclCEUIResult');r.hidden=false;r.innerHTML='<div><small>SCL SCHOOL USER ID</small><div class="scl-ceui-id">'+esc(id)+'</div></div>'+(academicEmail?'<div style="margin-top:8px"><b>Academic email identity:</b> '+esc(academicEmail)+'</div>':'<div style="margin-top:8px"><b>User ID created/linked.</b> Enter your approved SCL academic email domain above if you also want the academic address generated here.</div>')+'<div style="margin-top:8px"><b>Identity:</b> '+esc(row.person_id||'Linked')+' · <b>Membership:</b> '+esc(row.membership_type||type)+' · <b>Status:</b> '+esc(row.status||'pending')+'</div>';setStatus('Completed. The system reused an existing identity or created the next school-wide membership without creating a duplicate.');try{sessionStorage.setItem('sclPlatformIdentity',JSON.stringify(row))}catch(_){}
 }catch(e){setStatus(e.message||'Could not create/link the SCL email and User ID.',true)}
};
})();
</script>
<!-- SCL multi-school identity layer: permanent person identity + school memberships -->
<style id="scl-multi-school-identity-css">
#sclIdentityModal .scl-id-box{max-width:760px;width:min(96vw,760px)}
#sclIdentityModal .scl-id-note{padding:12px;border:1px solid #ead5b6;border-radius:12px;background:#fffaf0;line-height:1.5;font-size:13px}
#sclIdentityModal .scl-id-choice{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:12px 0}
#sclIdentityModal .scl-id-choice button{padding:14px;border:1px solid #ead5b6;border-radius:12px;background:#fff;font-weight:900;color:#650007;cursor:pointer}
#sclIdentityModal .scl-id-choice button.active{outline:3px solid #d69b25;background:#fff8df}
#sclIdentityResult{margin-top:12px}
@media(max-width:600px){#sclIdentityModal .scl-id-choice{grid-template-columns:1fr}}
</style>
<style id="scl-v91-dossier-style">
.scl-v91-modal{z-index:100200}.scl-v91-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scl-v91-card{border:1px solid #e7d6b6;border-radius:14px;padding:14px;background:linear-gradient(145deg,#fffdf8,#f8f0e2)}.scl-v91-card h4{margin:0 0 7px;color:#650007}.scl-v91-small{font-size:11px;line-height:1.5;color:#62584f}.scl-v91-doc-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px;border-bottom:1px solid #eadfce}.scl-v91-pill{display:inline-block;padding:4px 8px;border-radius:999px;background:#f2e5c4;font-size:10px;font-weight:900}.scl-v91-stat{font-size:26px;font-weight:1000;color:#650007}.scl-v91-progress{height:10px;border-radius:99px;background:#eadfce;overflow:hidden}.scl-v91-progress i{display:block;height:100%;background:linear-gradient(90deg,#650007,#caa95f);width:0}.scl-v91-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.scl-v91-actions button{border:1px solid #650007;border-radius:9px;padding:9px 12px;font-weight:900;cursor:pointer;background:#650007;color:#fff}.scl-v91-actions button.alt{background:#fff;color:#650007;border-color:#caa95f}.scl-v91-status{padding:9px;border-radius:9px;background:#fff8df;border:1px solid #e5cf83;font-size:11px;line-height:1.45}.scl-v91-status.ok{background:#edf9f1;border-color:#9bcfaf;color:#17653a}.scl-v91-status.err{background:#fff0f0;border-color:#dfa2a7;color:#8b1018}.scl-v91-field{display:flex;flex-direction:column;gap:5px;margin:8px 0}.scl-v91-field label{font-size:11px;font-weight:900}.scl-v91-field input,.scl-v91-field select{width:100%;box-sizing:border-box;padding:10px;border:1px solid #cdbda6;border-radius:9px;background:#fff;font:inherit}.scl-v91-print{background:#fff!important;color:#111!important}.scl-v91-verify-box{max-width:700px;margin:20px auto}.scl-v91-hidden{display:none!important}@media(max-width:720px){.scl-v91-grid{grid-template-columns:1fr}.scl-v91-doc-row{align-items:flex-start;flex-direction:column}}
@media print{body>*:not(#sclV91PrintSheet){display:none!important}#sclV91PrintSheet{display:block!important;position:static!important}.scl-v91-print{display:block!important}}
</style>
<script id="scl-v91-dossier-module">
(function(){'use strict';
const SB=()=>window.sclSupabase, KEY='sclAuthSession';
const read=()=>{try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(_){return null}};
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const toastx=m=>{try{window.toast?.(m)}catch(_){alert(m)}};
let state={person:null,membership:null,documents:[],activities:[],score:null};
async function session(){const s=SB();if(!s?.auth)return null;const r=await s.auth.getSession();return r?.data?.session||null}
async function person(){const ses=await session();if(!ses?.user)return null;const {data,error}=await SB().from('platform_people').select('*').eq('auth_user_id',ses.user.id).maybeSingle();if(error)throw error;return data}
async function load(){const p=await person();state.person=p;if(!p){return state}const {data:m}=await SB().from('platform_school_memberships').select('*,platform_schools(school_name,school_code)').eq('person_id',p.id).order('created_at',{ascending:true});state.membership=(m||[])[0]||null;const {data:d}=await SB().from('platform_person_documents').select('*').eq('person_id',p.id).order('created_at',{ascending:false});state.documents=d||[];const {data:a}=await SB().from('platform_person_activity').select('*').eq('person_id',p.id).order('activity_date',{ascending:false});state.activities=a||[];const {data:s}=await SB().from('platform_person_scores').select('*').eq('person_id',p.id).maybeSingle();state.score=s||null;return state}
function ensureModal(){let m=document.getElementById('sclV91DossierModal');if(m)return m;m=document.createElement('div');m.id='sclV91DossierModal';m.className='modal scl-v91-modal';m.innerHTML=`<div class="card" style="max-width:1100px"><div class="mh"><div><h3>📚 MY SCL PROFILE & VERIFICATION DOSSIER</h3><small>Your academic, professional, credential, activity and school-history record.</small></div><button type="button" onclick="closeM('sclV91DossierModal')">X</button></div><div class="form" id="sclV91DossierBody">Loading…</div></div>`;document.body.appendChild(m);return m}
function render(){const b=document.getElementById('sclV91DossierBody');if(!b)return;const p=state.person,m=state.membership,s=state.score||{};if(!p){b.innerHTML='<div class="scl-v91-status err">No SCL identity is linked to this signed-in account yet. Complete account registration first.</div>';return}const pct=Math.max(0,Math.min(100,Number(s.overall_percent||0)));b.innerHTML=`<div class="scl-v91-grid"><div class="scl-v91-card"><h4>Identity</h4><div><b>${esc(p.full_name)}</b></div><div class="scl-v91-small">Permanent person identity: ${esc(p.name_initials||'—')}</div><div class="scl-v91-small">School ID: <b>${esc(m?.school_id_number||'Pending')}</b></div><div class="scl-v91-small">Membership: ${esc(m?.membership_type||'—')} · Status: ${esc(m?.status||'pending')}</div><div class="scl-v91-small">School: ${esc(m?.platform_schools?.school_name||'SCL')}</div><div class="scl-v91-actions"><button type="button" onclick="sclV91VerifyDialog()">VERIFY SCHOOL ID</button><button class="alt" type="button" onclick="sclV91Print()">PRINT DOSSIER</button></div></div><div class="scl-v91-card"><h4>Overall Activity & Verification Rank</h4><div class="scl-v91-stat">${pct.toFixed(2)}%</div><div class="scl-v91-progress"><i style="width:${pct}%"></i></div><p class="scl-v91-small">Rank number: <b>${esc(s.rank_number||'Not calculated')}</b>. The score is cumulative and can incorporate attendance, punctuality, performance, credentials, conduct and recorded activities as the school records them.</p></div></div><div class="scl-v91-card" style="margin-top:12px"><h4>Credentials & Documents</h4><p class="scl-v91-small">Upload a CV, application letter, certificate, result, credential or other verification document. SCL extracts readable text/fields on this device and stores the extracted record; the original selected file is not uploaded to SCL storage.</p><div class="scl-v91-grid"><div class="scl-v91-field"><label>Document type</label><select id="sclV91DocType"><option>CV / Resume</option><option>Application Letter</option><option>Certificate</option><option>Result / Transcript</option><option>Credential</option><option>Medal / Award</option><option>Other Verification Document</option></select></div><div class="scl-v91-field"><label>Choose document</label><input id="sclV91DocFile" type="file" accept="image/*,.pdf,.docx,.txt"></div></div><div class="scl-v91-actions"><button type="button" onclick="sclV91ProcessDocument()">SCAN, EXTRACT & SAVE RECORD</button></div><div id="sclV91DocStatus" class="scl-v91-status" style="margin-top:8px">No document being processed.</div><div id="sclV91Docs">${state.documents.length?state.documents.map(d=>`<div class="scl-v91-doc-row"><div><b>${esc(d.title)}</b><div class="scl-v91-small">${esc(d.document_type)} · ${esc(d.verification_status)} · ${new Date(d.created_at).toLocaleDateString('en-NG')}</div></div><span class="scl-v91-pill">TEXT RECORD STORED</span></div>`).join(''):'<div class="scl-v91-small">No credential records yet.</div>'}</div></div><div class="scl-v91-card" style="margin-top:12px"><h4>Accumulated School & Activity History</h4>${state.activities.length?state.activities.map(a=>`<div class="scl-v91-doc-row"><div><b>${esc(a.title)}</b><div class="scl-v91-small">${esc(a.activity_type)} · ${esc(a.school_id||'SCL')} · ${esc(a.activity_date||'No date')}</div></div><span class="scl-v91-pill">${Number(a.points||0)}/${Number(a.max_points||100)}</span></div>`).join(''):'<div class="scl-v91-small">Activities, awards, service, school events and other verified records will accumulate here over time.</div>'}</div>`}
async function open(){ensureModal();openM('sclV91DossierModal');const b=document.getElementById('sclV91DossierBody');if(b)b.innerHTML='Loading your secure dossier…';try{await load();render()}catch(e){if(b)b.innerHTML='<div class="scl-v91-status err">'+esc(e.message||'Unable to load your dossier.')+'</div>'}}
window.sclV91OpenDossier=open;
async function extractImage(f){await loadOCR();const T=window.Tesseract;const w=await T.createWorker('eng');const r=await w.recognize(f);const t=String(r?.data?.text||'').trim();await w.terminate();return t}
async function loadOCR(){if(window.Tesseract)return;await new Promise((res,rej)=>{const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';s.onload=res;s.onerror=rej;document.head.appendChild(s)})}
async function extractPdf(f){await new Promise((res,rej)=>{if(window.pdfjsLib)return res();const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs';s.type='module';s.onload=res;s.onerror=rej;document.head.appendChild(s)});if(!window.pdfjsLib)throw new Error('PDF reader is still loading. Please press the scan button again.');const buf=await f.arrayBuffer();const pdf=await window.pdfjsLib.getDocument({data:buf}).promise;let out='';await loadOCR();const T=window.Tesseract;const w=await T.createWorker('eng');for(let i=1;i<=Math.min(pdf.numPages,20);i++){const page=await pdf.getPage(i),vp=page.getViewport({scale:1.5}),c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;const r=await w.recognize(c);out+='\n'+String(r?.data?.text||'')}await w.terminate();return out.trim()}
async function extract(f){if(f.type.startsWith('image/'))return extractImage(f);if(f.type==='text/plain')return f.text();if(f.type==='application/pdf')return extractPdf(f);if(f.type==='application/vnd.openxmlformats-officedocument.wordprocessingml.document'){await new Promise((res,rej)=>{if(window.mammoth)return res();const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js';s.onload=res;s.onerror=rej;document.head.appendChild(s)});const a=await f.arrayBuffer();const r=await window.mammoth.extractRawText({arrayBuffer:a});return String(r.value||'').trim()}throw new Error('Unsupported document type. Use an image, PDF, DOCX or TXT file.')}
function fields(t){const x=String(t||'').replace(/\s+/g,' ').trim();const email=(x.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i)||[])[0]||'';const phone=(x.match(/(?:\+?234|0)[789]\d{9}/)||[])[0]||'';return {email,phone,character_count:x.length,keywords:['CV','certificate','result','credential'].filter(k=>x.toLowerCase().includes(k))}}
window.sclV91ProcessDocument=async function(){const p=await person();const f=document.getElementById('sclV91DocFile')?.files?.[0],type=document.getElementById('sclV91DocType')?.value||'Other Verification Document',out=document.getElementById('sclV91DocStatus');if(!p){out.textContent='Sign in first so the document can be attached to your permanent SCL identity.';return}if(!f){out.textContent='Choose a document first.';return}out.textContent='Scanning and extracting text. The original file remains only in this browser during processing…';try{const text=await extract(f);if(!text.trim())throw new Error('No readable text was detected. Try a clearer image or a text-based PDF/DOCX.');const ses=await session();const mem=state.membership||((await SB().from('platform_school_memberships').select('school_id').eq('person_id',p.id).limit(1)).data||[])[0];const row={person_id:p.id,school_id:mem?.school_id||null,document_type:type,title:f.name,extracted_text:text.slice(0,100000),extracted_fields:fields(text),verification_status:'pending',source_filename:f.name,source_mime_type:f.type,source_deleted:true};const {error}=await SB().from('platform_person_documents').insert(row);if(error)throw error;document.getElementById('sclV91DocFile').value='';out.className='scl-v91-status ok';out.textContent='Document processed. The original file was not uploaded or retained by SCL; its extracted text and verification record were saved. School verification can now review it.';await load();render()}catch(e){out.className='scl-v91-status err';out.textContent=e.message||'Document processing failed.'}}
window.sclV91Print=async function(){await load();let m=state.membership,s=state.score||{},docs=state.documents,acts=state.activities;let x=document.getElementById('sclV91PrintSheet');if(!x){x=document.createElement('div');x.id='sclV91PrintSheet';document.body.appendChild(x)}x.innerHTML=`<div class="scl-v91-print" style="padding:30px;font-family:Arial,sans-serif"><h1>SHINING CHILD LEADERS SCHOOL</h1><h2>Verified Profile & Information Dossier</h2><p><b>Name:</b> ${esc(state.person?.full_name)}<br><b>School ID:</b> ${esc(m?.school_id_number||'Pending')}<br><b>Role:</b> ${esc(m?.membership_type||'—')}<br><b>Overall activity:</b> ${Number(s.overall_percent||0).toFixed(2)}%<br><b>Rank number:</b> ${esc(s.rank_number||'Not calculated')}</p><hr><h3>Credentials / Documents</h3>${docs.map(d=>`<p><b>${esc(d.document_type)}</b> — ${esc(d.title)}<br><small>Status: ${esc(d.verification_status)} · Extracted record length: ${String(d.extracted_text||'').length} characters</small></p>`).join('')||'<p>No documents recorded.</p>'}<h3>Accumulated Activities</h3>${acts.map(a=>`<p><b>${esc(a.title)}</b> — ${esc(a.activity_type)} — ${esc(a.activity_date||'')} — ${Number(a.points||0)}/${Number(a.max_points||100)}</p>`).join('')||'<p>No activities recorded.</p>'}<p style="margin-top:30px;font-size:11px">This printout is generated from SCL's verified digital record. Source files are not reproduced here.</p></div>`;window.print()}
window.sclV91VerifyDialog=function(){let m=document.getElementById('sclV91VerifyModal');if(!m){m=document.createElement('div');m.id='sclV91VerifyModal';m.className='modal scl-v91-modal';m.innerHTML='<div class="card scl-v91-verify-box"><div class="mh"><h3>🔎 VERIFY SCL SCHOOL ID</h3><button onclick="closeM(\'sclV91VerifyModal\')">X</button></div><div class="form"><div class="scl-v91-field"><label>School / Teacher / Student ID</label><input id="sclV91VerifyId" placeholder="e.g. SCLJDP0001"></div><div class="scl-v91-actions"><button onclick="sclV91VerifyId()">VERIFY</button></div><div id="sclV91VerifyResult" class="scl-v91-status" style="margin-top:10px">Enter an SCL ID to verify its current school identity.</div></div></div>';document.body.appendChild(m)}openM('sclV91VerifyModal')};
window.sclV91VerifyId=async function(){const id=document.getElementById('sclV91VerifyId')?.value.trim(),out=document.getElementById('sclV91VerifyResult');if(!id){out.textContent='Enter an SCL ID.';return}out.textContent='Verifying…';try{const {data,error}=await SB().rpc('scl_verify_school_id',{p_school_id_number:id});if(error)throw error;if(!data?.found){out.className='scl-v91-status err';out.textContent='No verified SCL identity was found for that ID.';return}out.className='scl-v91-status ok';out.innerHTML='<b>'+esc(data.full_name)+'</b><br>'+esc(data.school_name)+' · '+esc(data.membership_type)+' · '+esc(data.school_id_number)+'<br>Activity: <b>'+Number(data.activity_percent||0).toFixed(2)+'%</b> · Overall: <b>'+Number(data.overall_percent||0).toFixed(2)+'%</b> · Rank: <b>'+esc(data.rank_number||'—')+'</b><br><small>'+esc(data.verification_note)+'</small>'}catch(e){out.className='scl-v91-status err';out.textContent=e.message||'Verification failed.'}}
function addProfileButton(){if(document.getElementById('sclV91DossierBtn'))return;const b=document.createElement('button');b.id='sclV91DossierBtn';b.type='button';b.className='scl-role-action';b.innerHTML='📚 Profile, CV & Verification Dossier<small>Credentials, results, certificates, medals, school history, activity and printable verification record.</small>';b.onclick=window.sclV91OpenDossier;const panel=document.getElementById('sclProfileAdminPanel')||document.querySelector('.scl-role-actions')||document.querySelector('#sclModernProfileModal .form');if(panel)panel.appendChild(b)}
function boot(){setTimeout(addProfileButton,500);setTimeout(addProfileButton,1800);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();window.addEventListener('load',boot);setInterval(addProfileButton,2500);
})();
</script>
<div aria-hidden="true" class="modal" id="sclParentChildModal">
<div class="card scl-parent-claim-card">
<div class="mh"><div><h3>👨‍👩‍👧 REGISTER YOUR CHILD</h3><small>Your SCL account comes first. Then we connect you to your child.</small></div><button onclick="sclCloseParentChild()" type="button">X</button></div>
<div class="form">
<div class="scl-parent-claim-step active" id="sclPCCStep1">
<p><b>What are you registering as?</b></p>
<div class="scl-parent-claim-choice">
<button onclick="sclStartParentChild('Parent')" type="button">👨‍👩‍👦 I am the Parent</button>
<button onclick="sclStartParentChild('Guardian')" type="button">🧑‍🧒 I am the Guardian</button>
</div>
<div class="scl-parent-claim-warning">If the school has already registered your child, you can claim the existing student record instead of creating a duplicate record.</div>
</div>
<div class="scl-parent-claim-step" id="sclPCCStep2">
<div class="scl-parent-claim-warning"><b>Relationship: <span id="sclPCCRelationship"></span></b><br/>First, provide the contact information the school needs for you. This does not create a second account.</div>
<div class="grid">
<div class="field"><label>Phone number *</label><input autocomplete="tel" id="sclPCCPhone" required="" type="tel"/></div>
<div class="field"><label>Contact email</label><input autocomplete="email" id="sclPCCEmail" readonly="" type="email"/></div>
</div>
<div class="scl-parent-claim-choice">
<button onclick="sclShowClaimExisting()" type="button">🔎 My child is already registered by the school</button>
<button onclick="sclContinueNewChild()" type="button">📝 My child is not yet registered</button>
</div>
<div class="scl-parent-claim-actions"><button class="btn outline" onclick="sclPCCBack(1)" type="button">← BACK</button><button class="btn outline" onclick="sclCloseParentChild()" type="button">CANCEL</button></div>
</div>
<div class="scl-parent-claim-step" id="sclPCCStep3">
<p><b>Claim an existing school student</b></p>
<p class="scl-small">For security, all three details must match the school's record exactly: the child's full name, date of birth and Student ID.</p>
<div class="grid">
<div class="field full"><label>Child's full name *</label><input autocomplete="off" id="sclPCCChildName"/></div>
<div class="field"><label>Child's date of birth *</label><input id="sclPCCDob" type="date"/></div>
<div class="field"><label>Child's Student ID *</label><input autocomplete="off" id="sclPCCStudentId"/></div>
</div>
<div class="statusbox hidden" id="sclPCCSearchStatus"></div>
<div class="scl-parent-claim-result" hidden="" id="sclPCCMatch"></div>
<div class="scl-parent-claim-actions"><button class="btn outline" onclick="sclPCCBack(2)" type="button">← BACK</button><button class="btn gold" onclick="sclFindExistingStudent()" type="button">FIND MY CHILD</button></div>
</div>
<div class="scl-parent-claim-step" id="sclPCCStep4">
<p><b>Confirm child claim</b></p>
<div class="scl-parent-claim-result" id="sclPCCConfirm"></div>
<p class="scl-small">By confirming, you are asking SCL to link this existing student record to your signed-in account as the selected Parent/Guardian. No duplicate student record will be created.</p>
<div class="scl-parent-claim-actions"><button class="btn outline" onclick="sclPCCBack(3)" type="button">← BACK</button><button class="btn gold" onclick="sclClaimExistingStudent()" type="button">CLAIM CHILD</button></div>
</div>
<div class="scl-parent-claim-step" id="sclPCCStep5">
<div class="scl-parent-claim-result" id="sclPCCDone"></div>
<div class="scl-parent-claim-actions"><button class="btn gold" onclick="sclCloseParentChild();window.sclOpenModernProfile?.();" type="button">OPEN MY PROFILE</button></div>
</div>
</div>
</div>
</div>
<script id="scl-v91-parent-child-workflow">
(function(){
  const escPC=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  let relationship='Parent', matchedStudent=null;
  function setStep(n){
    for(let i=1;i<=5;i++) document.getElementById('sclPCCStep'+i)?.classList.toggle('active',i===n);
  }
  window.sclCloseParentChild=function(){try{closeM('sclParentChildModal')}catch(_){const m=document.getElementById('sclParentChildModal');m?.classList.remove('open');}setStep(1);matchedStudent=null;};
  window.sclPCCBack=function(n){setStep(n);};
  window.sclStartParentChild=function(rel){
    relationship=rel||'Parent';
    document.getElementById('sclPCCRelationship').textContent=relationship;
    const a=auth?.()||{};
    const email=a?.user?.email||a?.profile?.email||'';
    const el=document.getElementById('sclPCCEmail'); if(el) el.value=email;
    const phone=document.getElementById('sclPCCPhone'); if(phone && !phone.value) phone.value=a?.profile?.phone||a?.user?.user_metadata?.phone||'';
    setStep(2);
  };
  window.sclShowClaimExisting=function(){setStep(3);};
  window.sclContinueNewChild=function(){
    const phone=document.getElementById('sclPCCPhone')?.value.trim();
    if(!phone){alert('Please enter your phone number before continuing.');return;}
    window.__sclParentChildRelationship=relationship;
    window.__sclParentChildPhone=phone;
    window.__sclParentChildEmail=(auth?.()||{}).user?.email||'';
    sclCloseParentChild();
    if(typeof window.renderPickerMode==='function'){window.pickerMode='registration';window.renderPickerMode();}
    if(typeof openM==='function')openM('picker');
  };
  async function rpc(name,args){
    const sb=typeof SB==='function'?SB():null;
    if(!sb?.rpc) throw new Error('Secure SCL connection is not ready. Please sign in again.');
    const r=await sb.rpc(name,args);
    if(r?.error) throw r.error;
    return r?.data;
  }
  window.sclFindExistingStudent=async function(){
    const name=document.getElementById('sclPCCChildName')?.value.trim();
    const dob=document.getElementById('sclPCCDob')?.value;
    const sid=document.getElementById('sclPCCStudentId')?.value.trim();
    const st=document.getElementById('sclPCCSearchStatus'); const box=document.getElementById('sclPCCMatch');
    if(!name||!dob||!sid){if(st){st.classList.remove('hidden');st.textContent='Enter the child full name, date of birth and Student ID.';}return;}
    if(st){st.classList.remove('hidden');st.textContent='Checking the school record securely…';}
    if(box)box.hidden=true;
    try{
      const rows=await rpc('scl_find_unclaimed_student',{p_full_name:name,p_date_of_birth:dob,p_student_id:sid});
      const row=Array.isArray(rows)?rows[0]:rows;
      if(!row?.found)throw new Error('No matching student was found. Check all three details and try again.');
      if(!row.claimable)throw new Error('This student has already been assigned to a parent or guardian. Please contact the school.');
      matchedStudent=row;
      if(st)st.classList.add('hidden');
      if(box){box.hidden=false;box.innerHTML='<b>Student found.</b><br>'+escPC(row.child_name)+'<br><small>Student ID: '+escPC(row.student_id)+' · Class: '+escPC(row.class_name||'Not specified')+'</small><br><br><b>Do you want to claim this child for your SCL account?</b><div class="scl-parent-claim-actions"><button type="button" class="btn gold" onclick="sclConfirmStudentClaim()">YES, CONTINUE</button></div>';}
    }catch(e){if(st){st.classList.remove('hidden');st.textContent=e?.message||'The student could not be found.';}}
  };
  window.sclConfirmStudentClaim=function(){
    if(!matchedStudent)return;
    document.getElementById('sclPCCConfirm').innerHTML='<b>'+escPC(matchedStudent.child_name)+'</b><br>Student ID: '+escPC(matchedStudent.student_id)+'<br>Relationship: '+escPC(relationship)+'<br><br>This will link the existing school record to your signed-in account. A duplicate student will not be created.';
    setStep(4);
  };
  window.sclClaimExistingStudent=async function(){
    if(!matchedStudent)return;
    const phone=document.getElementById('sclPCCPhone')?.value.trim();
    const st=document.getElementById('sclPCCConfirm');
    try{
      st.innerHTML='<b>Linking the child securely…</b>';
      const data=await rpc('scl_claim_existing_student',{p_full_name:matchedStudent.child_name,p_date_of_birth:matchedStudent.date_of_birth,p_student_id:matchedStudent.student_id,p_relationship:relationship,p_phone:phone||''});
      setStep(5);
      document.getElementById('sclPCCDone').innerHTML='<b>✅ Child successfully linked.</b><br>'+escPC(data?.child_name||matchedStudent.child_name)+' is now connected to your SCL account as '+escPC(data?.relationship||relationship)+'.<br><small>Student ID: '+escPC(data?.student_id||matchedStudent.student_id)+'</small>';
      try{window.sclRefreshHome?.();}catch(_){}
    }catch(e){
      st.innerHTML='<b>Could not complete the claim.</b><br>'+escPC(e?.message||'Please contact the school for assistance.');
    }
  };
  window.sclOpenParentChildWorkflow=function(){
    const a=auth?.();
    if(!a?.accessToken){window.__sclRegisterIntent='parent_child';window.sclV88OpenRegister?.();return;}
    setStep(1);openM('sclParentChildModal');
  };
  const oldPick=window.pickRegistration;
  window.pickRegistration=function(){
    const a=auth?.();
    if(!a?.accessToken){window.__sclRegisterIntent='parent_child';window.sclV88OpenRegister?.();return;}
    window.sclOpenParentChildWorkflow();
  };
  // A school/admin can continue using the existing authenticated student registration path.
  window.sclSchoolRegisterStudent=function(){
    if(typeof window.sclGateStudentRegistration==='function')return window.sclGateStudentRegistration();
    if(typeof window.openStudentRegistration==='function')return window.openStudentRegistration();
    if(typeof window.openRegistration==='function')return window.openRegistration();
  };
})();
</script>
<!-- SCL V91: GLOBAL SCHOOL IDENTITY + SINGLE SCHOOL-WIDE REGISTRATION SEQUENCE -->
<style id="scl-v91-global-identity-css">
#sclIdentityModal .scl-id-box{max-width:780px;width:min(96vw,780px)}
#sclIdentityModal .scl-id-note{padding:12px;border:1px solid #ead5b6;border-radius:12px;background:#fffaf0;line-height:1.5;font-size:13px}
#sclIdentityModal .scl-id-choice{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:12px 0}
#sclIdentityModal .scl-id-choice button{padding:14px;border:1px solid #ead5b6;border-radius:12px;background:#fff;font-weight:900;color:#650007;cursor:pointer}
#sclIdentityModal .scl-id-choice button.active{outline:3px solid #d69b25;background:#fff8df}
#sclIdentityResult{margin-top:12px}
.scl-v91-id-banner{margin:12px 0;padding:13px 15px;border-radius:13px;background:linear-gradient(135deg,#fff7d6,#fff);border:1px solid #e5c56b;color:#4b1d00}
@media(max-width:600px){#sclIdentityModal .scl-id-choice{grid-template-columns:1fr}}
</style>
<!-- SCL V91 CORE FAMILY/ROLE COEXISTENCE LAYER -->
<style id="scl-v91-family-core-css">
.scl-family-core{margin:12px 0;padding:14px;border:1px solid #ead5b6;border-radius:14px;background:linear-gradient(135deg,#fffaf0,#fff)}
.scl-family-core h4{margin:0 0 6px;color:#650007}.scl-family-core .scl-role-pills{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0}.scl-role-pill{padding:6px 9px;border-radius:999px;background:#f5ead5;border:1px solid #dec89e;font-size:12px;font-weight:800}.scl-child-list{display:grid;gap:8px;margin-top:10px}.scl-child-card{padding:11px;border:1px solid #ead5b6;border-radius:12px;background:#fff}.scl-child-card b{color:#650007}.scl-child-card small{display:block;margin-top:3px;color:#666}
</style>
<script id="scl-v91-family-core-layer">
(function(){
 'use strict';
 const SB=()=>window.sclSupabase;
 const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
 async function session(){try{const r=await SB()?.auth?.getSession?.();return r?.data?.session||null}catch(e){return null}}
 async function roles(){
   const s=await session(); if(!s)return [];
   try{const r=await SB().from('user_roles').select('role,active,created_at').eq('user_id',s.user.id).eq('active',true).order('created_at');return r?.error?[]:(r.data||[])}catch(e){return []}
 }
 window.sclLoadMyChildren=async function(targetId){
   const box=document.getElementById(targetId||'sclMyChildrenList'); if(!box)return [];
   box.innerHTML='<small>Loading your children/wards…</small>';
   try{
     const s=await session(); if(!s){box.innerHTML='<small>Please sign in to view your children/wards.</small>';return []}
     const r=await SB().rpc('scl_list_my_children'); if(r?.error)throw r.error;
     const rows=r.data||[];
     if(!rows.length){box.innerHTML='<small>No child or ward is linked to this account yet. Use <b>Register Your Child</b> to add one.</small>';return []}
     box.innerHTML=rows.map(x=>'<div class="scl-child-card"><b>'+esc(x.child_name)+'</b><small>Student ID: '+esc(x.student_id)+' • '+esc(x.class_name||'Class pending')+'</small><small>Relationship: '+esc(x.relationship||'Parent/Guardian')+' • Status: '+esc(x.status||'registered')+'</small></div>').join('');
     return rows;
   }catch(e){box.innerHTML='<small>Children/wards could not be loaded right now. Please try again.</small>';return []}
 };
 window.sclRenderRoleFamilySummary=async function(targetId){
   const box=document.getElementById(targetId||'sclRoleFamilySummary');if(!box)return;
   const rs=await roles(); const labels=rs.map(x=>String(x.role).replace(/_/g,' '));
   box.innerHTML='<div class="scl-family-core"><h4>👤 YOUR SCL ACCOUNT</h4><div>This is one permanent account. Your school roles and family relationships can exist together.</div><div class="scl-role-pills">'+(labels.length?labels.map(x=>'<span class="scl-role-pill">'+esc(x)+'</span>').join(''):'<span class="scl-role-pill">normal user</span>')+'</div><div id="sclMyChildrenList" class="scl-child-list"></div></div>';
   await window.sclLoadMyChildren('sclMyChildrenList');
 };
 window.sclAddAnotherChild=function(){
   if(typeof window.pickRegistration==='function')return window.pickRegistration();
   if(typeof window.sclOpenParentChildFlow==='function')return window.sclOpenParentChildFlow();
 };
 document.addEventListener('DOMContentLoaded',()=>setTimeout(async()=>{
   // Non-invasive: add the family summary only when a suitable profile/dashboard host exists.
   const host=document.querySelector('#profileModal .form,#profilePanel .form,.profile-content,.dashboard-content');
   if(!host||document.getElementById('sclRoleFamilySummary'))return;
   const d=document.createElement('div');d.id='sclRoleFamilySummary';host.prepend(d);
   await window.sclRenderRoleFamilySummary('sclRoleFamilySummary');
 },1400));
})();
</script>
<style id="scl-v91-organized-admin-and-discipline-css">
.scl-v91-admin-map{border:1px solid #ead5b6;border-radius:18px;background:linear-gradient(145deg,#fffdf8,#f8efe2);padding:14px;box-shadow:0 8px 24px rgba(63,20,20,.07);margin-bottom:14px}.scl-v91-admin-map h4{margin:0 0 4px;color:#650007}.scl-v91-admin-map>p{margin:4px 0 12px;color:#66594f;font-size:12px}.scl-v91-admin-cats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scl-v91-admin-cat{border:1px solid #ead5b6;border-radius:14px;background:#fff;padding:11px}.scl-v91-admin-cat h5{margin:0 0 8px;color:#650007;font-size:13px}.scl-v91-admin-cat .scl-v91-admin-actions{display:grid;gap:7px}.scl-v91-admin-cat button{width:100%;text-align:left;border:1px solid #dec7a3;border-radius:10px;background:#fffaf1;color:#3b1712;padding:9px 10px;font-weight:900;cursor:pointer}.scl-v91-admin-cat button small{display:block;font-weight:700;color:#75675c;margin-top:2px}.scl-v91-discipline-modal{z-index:2147483000}.scl-v91-discipline-card{width:min(760px,96vw);max-height:92vh;overflow:auto;background:#fffdf8;border:2px solid #caa95f;border-radius:20px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.35)}.scl-v91-discipline-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scl-v91-discipline-card label{display:block;font-size:11px;font-weight:900;color:#5d5147;margin-bottom:5px}.scl-v91-discipline-card input,.scl-v91-discipline-card select,.scl-v91-discipline-card textarea{width:100%;box-sizing:border-box;border:1px solid #cdbda6;border-radius:10px;padding:10px;background:#fff;font:inherit}.scl-v91-cause-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px}.scl-v91-cause{border:1px solid #dec7a3;border-radius:11px;background:#fffaf1;padding:10px;cursor:pointer}.scl-v91-cause input{width:auto;margin-right:6px}.scl-v91-cause b{font-size:12px}.scl-v91-cause small{display:block;color:#75675c;margin-top:3px}.scl-v91-discipline-status{padding:10px;border-radius:11px;background:#f6f0e7;border:1px solid #ead5b6;margin:10px 0;font-size:12px}.scl-v91-discipline-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.scl-v91-discipline-actions button{border:1px solid #650007;border-radius:10px;padding:10px 13px;font-weight:900;cursor:pointer;background:#650007;color:#fff}.scl-v91-discipline-actions button.secondary{background:#fff;color:#650007;border-color:#caa95f}@media(max-width:700px){.scl-v91-admin-cats,.scl-v91-discipline-grid,.scl-v91-cause-grid{grid-template-columns:1fr}}
</style>
<script id="scl-v91-organized-admin-and-student-discipline">
(function(){'use strict';
const SUP=window.SCL_SUPABASE_URL, KEY='sclAuthSession';
function A(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null')}catch(_){return null}}
function admin(){const a=A();return (a?.roles||[]).some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)))}
function H(t){return String(t||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
async function rpc(name,args){const a=A();if(!a?.accessToken)throw new Error('Please sign in first.');const r=await fetch(SUP+'/rest/v1/rpc/'+name,{method:'POST',headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY,Authorization:'Bearer '+a.accessToken,'Content-Type':'application/json'},body:JSON.stringify(args)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||d.error||'SCL backend request failed.');return d}
function openDiscipline(){if(!admin()){toast?.('Only authorised school administrators can open Student Discipline.');return}let m=document.getElementById('sclV91DisciplineModal');if(!m){m=document.createElement('div');m.id='sclV91DisciplineModal';m.className='modal scl-v91-discipline-modal';m.setAttribute('aria-hidden','true');m.innerHTML='<div class="scl-v91-discipline-card"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><div><h3 style="margin:0;color:#650007">🛡️ STUDENT DISCIPLINE</h3><p style="margin:4px 0;color:#66594f;font-size:12px">Short, structured discipline workflow. The system calculates blacklist and rustication review status.</p></div><button type="button" onclick="closeM(\'sclV91DisciplineModal\')" style="border:0;background:#650007;color:#fff;border-radius:50%;width:34px;height:34px">X</button></div><div class="scl-v91-discipline-grid" style="margin-top:12px"><div><label>Student ID</label><input id="sclDStudentId" placeholder="Enter SCL Student ID"></div><div style="display:flex;align-items:end"><button type="button" class="btn gold" onclick="sclV91FindStudent()">FIND STUDENT</button></div></div><div id="sclDStudentBox" class="scl-v91-discipline-status">Find a student to begin.</div><div id="sclDForm" style="display:none"><label style="display:block;font-size:11px;font-weight:900;color:#5d5147">MAIN CAUSE — choose the category that best fits</label><div class="scl-v91-cause-grid"><label class="scl-v91-cause"><input type="radio" name="sclDCause" value="SERIOUS_MISCONDUCT"><b>🚫 Serious Misconduct</b><small>Fighting, bullying, threats, dangerous or serious disrespect.</small></label><label class="scl-v91-cause"><input type="radio" name="sclDCause" value="PROPERTY_DAMAGE_OR_THEFT"><b>🛡️ Property Damage / Theft</b><small>Damage, theft, vandalism or deliberate property loss.</small></label><label class="scl-v91-cause"><input type="radio" name="sclDCause" value="ACADEMIC_EXAMINATION_MISCONDUCT"><b>📚 Academic / Examination Misconduct</b><small>Cheating, malpractice, forgery or serious academic misconduct.</small></label><label class="scl-v91-cause"><input type="radio" name="sclDCause" value="PROHIBITED_OR_UNSAFE_CONDUCT"><b>⚠️ Prohibited / Unsafe Conduct</b><small>Prohibited items, substance-related or seriously unsafe conduct.</small></label><label class="scl-v91-cause"><input type="radio" name="sclDCause" value="REPEATED_DISOBEDIENCE"><b>🔁 Repeated Disobedience / Misconduct</b><small>Persistent rule violations or repeated defiance after intervention.</small></label></div><div class="scl-v91-discipline-grid" style="margin-top:10px"><div><label>Action / Record</label><select id="sclDAction"><option value="incident">Record Incident</option><option value="suspension_confirmed">Confirm Suspension → Blacklist</option><option value="negative_record">Add Negative Record</option><option value="damage_assessed">Assess Damage</option><option value="damage_payment">Record Damage Payment</option></select></div><div><label>Sub-cause / short label</label><input id="sclDSub" placeholder="Short description, not a long story"></div><div><label>Damage amount (₦)</label><input id="sclDDamage" type="number" min="0" step="0.01" value="0"></div><div><label>Damage payment (₦)</label><input id="sclDPaid" type="number" min="0" step="0.01" value="0"></div></div><div style="margin-top:10px"><label>Short note</label><textarea id="sclDNote" rows="2" placeholder="Brief factual note"></textarea><label style="margin-top:8px"><input id="sclDParent" type="checkbox"> Parent/guardian notified</label></div><div id="sclDResult" class="scl-v91-discipline-status">A confirmed suspension starts the blacklist. Three negative records trigger Rustication Review.</div><div class="scl-v91-discipline-actions"><button type="button" onclick="sclV91RecordDiscipline()">SAVE & CALCULATE</button><button type="button" class="secondary" onclick="sclV91CloseDiscipline()">CANCEL</button></div><div id="sclDReviewBox" style="margin-top:12px"></div></div></div>';document.body.appendChild(m)}openM('sclV91DisciplineModal')}
window.sclV91OpenDiscipline=openDiscipline;
window.sclV91FindStudent=async function(){const id=document.getElementById('sclDStudentId')?.value.trim();if(!id){toast?.('Enter the Student ID.');return}const box=document.getElementById('sclDStudentBox');box.textContent='Searching…';try{const d=await rpc('scl_admin_find_student_for_discipline',{p_student_id:id});if(!d.found){box.textContent='Student not found. Check the Student ID.';document.getElementById('sclDForm').style.display='none';return}window.__sclDStudent=d;box.innerHTML='<b>'+H(d.child_name)+'</b><br>Student ID: '+H(d.student_id)+' • Class: '+H(d.class_name)+' • Status: '+H(d.status);document.getElementById('sclDForm').style.display='block';await sclV91LoadDiscipline()}catch(e){box.textContent=e.message||'Unable to find student.'}}
window.sclV91LoadDiscipline=async function(){const d=window.__sclDStudent;if(!d)return;try{const x=await rpc('scl_get_student_discipline',{p_student_uuid:d.student_uuid});const out=document.getElementById('sclDResult');if(!x.found){out.innerHTML='Current status: <b>CLEAR</b><br>First confirmed suspension → BLACKLISTED. Three negative records → RUSTICATION REVIEW.';return}out.innerHTML='<b>Current status: '+H(x.disciplinary_status)+'</b><br>Negative records: '+H(x.negative_records)+' / 3<br>Damage outstanding: ₦'+Number(x.damage_outstanding||0).toLocaleString('en-NG',{minimumFractionDigits:2})+(x.confirmed_suspension?' <br>Confirmed suspension: YES':'');const rb=document.getElementById('sclDReviewBox');if(x.disciplinary_status==='blacklisted'||x.disciplinary_status==='rustication_review'||x.disciplinary_status==='rusticated'){rb.innerHTML='<div class="scl-v91-discipline-status"><b>REVIEW</b><div class="scl-v91-discipline-actions"><button type="button" onclick="sclV91Review(\'continue_blacklist\')">CONTINUE BLACKLIST</button><button type="button" onclick="sclV91Review(\'remove_blacklist\')">UNBLACKLIST / REINSTATE</button><button type="button" onclick="sclV91Review(\'rusticate\')">RUSTICATE</button><button type="button" onclick="sclV91Review(\'reinstate_after_rustication\')">REINSTATE AFTER RUSTICATION</button></div></div>'}}catch(e){document.getElementById('sclDResult').textContent=e.message||'Unable to load discipline record.'}}
window.sclV91RecordDiscipline=async function(){const d=window.__sclDStudent,cat=document.querySelector('input[name="sclDCause"]:checked')?.value;if(!d||!cat){toast?.('Find a student and choose one main cause.');return}const action=document.getElementById('sclDAction').value,sub=document.getElementById('sclDSub').value.trim()||'General';try{const x=await rpc('scl_record_student_discipline',{p_student_uuid:d.student_uuid,p_event_type:action,p_cause_category:cat,p_cause_subcategory:sub,p_short_note:document.getElementById('sclDNote').value.trim(),p_damage_amount:Number(document.getElementById('sclDDamage').value||0),p_damage_paid:Number(document.getElementById('sclDPaid').value||0),p_parent_notified:document.getElementById('sclDParent').checked});document.getElementById('sclDResult').innerHTML='<b>Saved.</b><br>Status: '+H(x.disciplinary_status)+'<br>Negative records: '+H(x.negative_records)+' / 3<br>Damage outstanding: ₦'+Number(x.damage_outstanding||0).toLocaleString('en-NG',{minimumFractionDigits:2});toast?.('Student discipline record saved.');await sclV91LoadDiscipline()}catch(e){toast?.(e.message||'Unable to save discipline record.')}};
window.sclV91Review=async function(action){const d=window.__sclDStudent;if(!d)return;const x=await rpc('scl_get_student_discipline',{p_student_uuid:d.student_uuid});if(!x.found){toast?.('No active discipline case.');return}const note=prompt('Short review note (optional):','');try{const r=await rpc('scl_review_student_discipline',{p_case_id:x.case_id,p_action:action,p_review_note:note||'',p_damage_waived:0});toast?.('Review recorded. Current status: '+r.disciplinary_status);await sclV91LoadDiscipline()}catch(e){toast?.(e.message||'Review could not be completed.')}};
window.sclV91CloseDiscipline=function(){closeM('sclV91DisciplineModal');window.__sclDStudent=null};
function installAdminMap(){if(!admin())return;const body=document.getElementById('sclModernProfileBody');if(!body||body.querySelector('.scl-v91-admin-map'))return;const old=[...body.querySelectorAll('.scl-role-panel')].find(x=>/ADMIN CONTROL CENTER/i.test(x.textContent||''));if(!old)return;const map=document.createElement('section');map.className='scl-v91-admin-map';map.innerHTML='<h4>🧭 ADMINISTRATOR WORKSPACE</h4><p>Everything is grouped by function. Open only the section you need; your role permissions remain enforced by the backend.</p><div class="scl-v91-admin-cats"><div class="scl-v91-admin-cat"><h5>👥 PEOPLE & ADMISSIONS</h5><div class="scl-v91-admin-actions"><button onclick="pickRegistration()">Student Admissions<small>Register students and manage returning-student workflows.</small></button><button onclick="openWorkers()">Staff & Workers<small>Teachers, workers, applications and staff records.</small></button><button onclick="openMyChildren?.()">Family / Children<small>Parent-child relationships and family records.</small></button></div></div><div class="scl-v91-admin-cat"><h5>🕘 ATTENDANCE & RANK</h5><div class="scl-v91-admin-actions"><button onclick="sclOpenAttendance(\'admin\')">Staff Attendance<small>Sign-in/out register, GPS, attendance percentage and notices.</small></button><button onclick="sclOpenServiceRank()">Service Rank<small>30-day cycles, monthly acceptance and promotion readiness.</small></button><button onclick="sclOpenBranchAdmin()">Branches & GPS<small>Approved school locations and attendance geofencing.</small></button></div></div><div class="scl-v91-admin-cat"><h5>🛡️ STUDENT WELFARE</h5><div class="scl-v91-admin-actions"><button onclick="sclV91OpenDiscipline()">Student Discipline<small>Suspension → blacklist → negative records → rustication review.</small></button><button onclick="openResults()">Results & Certificates<small>Academic results, reports and certificates.</small></button><button onclick="openSclLeadership()">Leadership & Recognition<small>Prefects, badges, medals and records.</small></button></div></div><div class="scl-v91-admin-cat"><h5>🏫 SCHOOL OPERATIONS</h5><div class="scl-v91-admin-actions"><button onclick="openFees()">Fees & Payments<small>Class-based fees, payments and management controls.</small></button><button onclick="openSchoolCurriculum()">Curriculum & Calendar<small>Programme, teaching scheme and academic calendar.</small></button><button onclick="openMaterials()">School Materials<small>Materials catalogue and requests.</small></button><button onclick="openUniformAdmin()">Uniform Management<small>Uniform catalogue and administration.</small></button></div></div><div class="scl-v91-admin-cat"><h5>📢 COMMUNICATION & CONTENT</h5><div class="scl-v91-admin-actions"><button onclick="openCollaboration()">Community & Activities<small>Collaborators, activities and school posts.</small></button><button onclick="openSclNotice?.()">Announcements & Notices<small>School notifications and communication.</small></button><button onclick="openWhatsAppChoices()">Support / Escalation<small>Contact the appropriate school administrator.</small></button></div></div><div class="scl-v91-admin-cat"><h5>⚙️ SYSTEM & RECORDS</h5><div class="scl-v91-admin-actions"><button onclick="openM(\'sclSuiteModal\');sclSuiteTab(\'bulk\')">Bulk Data & Tools<small>Operational data and management tools.</small></button><button onclick="openSalaryAdmin()">Salary / Attendance Review<small>Attendance-based salary indicators and appeals.</small></button><button onclick="sclOpenFormerStaffRecords()">Former Staff Records<small>Archived employment and verification history.</small></button><button onclick="openM(\'sclV210AdminIdentityModal\')">Administrator Identity<small>Administrator identity and provisioning controls.</small></button></div></div></div>';old.parentNode.insertBefore(map,old);old.style.display='none';[...body.querySelectorAll('.scl-role-panel')].forEach(p=>{const t=(p.querySelector('h4')?.textContent||'').trim();if(/Administrator Workspace — Fully Equipped|ADMINISTRATOR ACCESS & RESPONSIBILITIES/i.test(t))p.style.display='none'});}
const obs=new MutationObserver(()=>setTimeout(installAdminMap,40));function boot(){setTimeout(installAdminMap,250);obs.observe(document.getElementById('sclModernProfileBody')||document.body,{childList:true,subtree:true})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
<!-- SCL ONLINE ADMIN OVERLAY FIX: secondary workspace modules always open above the profile/home layer -->
<style id="scl-admin-overlay-fix-v1">
/* The administrator profile is the workspace base layer. Child tools must sit above it. */
#sclModernProfileModal{z-index:900!important}
#sclV211AdminPanel{z-index:950!important}
body.scl-admin-overlay-active .modal.open:not(#sclModernProfileModal),
body.scl-admin-overlay-active #sclAdminCmsPanel.open,
body.scl-admin-overlay-active #sclV210AdminIdentityModal.open,
body.scl-admin-overlay-active #sclV211AdminPanel.open{z-index:3000!important}
.modal.scl-admin-overlay-front{z-index:3000!important;display:flex!important;visibility:visible!important;opacity:1!important}
.scl-admin-overlay-front>.card,
.scl-admin-overlay-front>.scl-profile-modal-card,
.scl-admin-overlay-front>div{position:relative;z-index:3001}
#sclModernProfileModal.open{display:flex!important;visibility:visible!important}
</style>
<!-- SCL V92 FINAL STABILITY -->
<style id="scl-v94-click-layer-fix">
#sclModernProfileModal{z-index:900!important}
#sclV211AdminPanel{z-index:950!important}
#sclAdminCmsPanel.open,#sclV210AdminIdentityModal.open,.modal.open.scl-v94-front{z-index:12000!important;display:flex!important;visibility:visible!important;opacity:1!important}
</style>

