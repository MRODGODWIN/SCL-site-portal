  .scl-v94-vertical-days .scl-tt-period-head em{font-size:6px!important}
  .scl-v94-vertical-days .scl-tt-cell-entry b,.scl-v94-vertical-days .scl-tt-empty-cell b,.scl-v94-vertical-days .scl-tt-fixed-block b{font-size:8px!important}
  .scl-v94-vertical-days .scl-tt-cell-entry small,.scl-v94-vertical-days .scl-tt-empty-cell small,.scl-v94-vertical-days .scl-tt-fixed-block small{font-size:6px!important}
  .scl-tt-daily-teachers{padding:10px}.scl-tt-daily-teachers h4{font-size:11px}.scl-tt-teacher-day{font-size:8px}.scl-tt-teacher-day>b{font-size:9px}
}
