<div aria-hidden="true" class="modal" id="sclProfileSearchModal"><div class="card" style="width:min(760px,96vw);max-height:88vh"><div class="mh"><h3>🔎 SEARCH MY SCL PROFILE</h3><button onclick="closeM('sclProfileSearchModal')" type="button">X</button></div><div style="padding:14px"><input autocomplete="off" id="sclProfileSearchInput" placeholder="Search attendance, fees, results, assignments, support…" style="width:100%;box-sizing:border-box;padding:13px 15px;border:1px solid #d9c5aa;border-radius:12px;font-size:15px" type="search"/><div id="sclProfileSearchResults" style="margin-top:12px;max-height:58vh;overflow:auto"></div></div></div></div>
<div aria-hidden="true" class="modal" id="sclModernProfileModal"><div class="card scl-profile-modal-card" style="width:min(1180px,96vw);max-height:95vh"><div class="mh"><h3>MY SCL PROFILE &amp; DASHBOARD</h3><button class="scl-profile-home-close" onclick="sclCloseProfileToHome()" title="Return to home without logging out" type="button">HOME</button></div><div class="scl-modern-profile-body" id="sclModernProfileBody"></div><div class="scl-profile-dismiss-hint">Double-tap or double-click anywhere on this profile to return to the SCL home page. You will stay logged in.</div></div></div>
