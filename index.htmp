<div aria-hidden="true" class="modal" id="sclBranchAdminModal"><div class="card" style="width:min(1000px,96vw);max-height:95vh"><div class="mh"><h3>SCHOOL BRANCH &amp; GPS SETUP</h3><button onclick="closeM('sclBranchAdminModal')" type="button">X</button></div><div class="scl-modern-profile-body" id="sclBranchAdminBody"></div></div></div>
<div aria-hidden="true" class="modal" id="sclRankGuideModal">
<div class="card scl-mgr-guide-card" style="width:min(1180px,97vw);max-height:96vh">
<div class="mh"><h3>🏅 MGR SCHOOL RANKING — TIERS 1–10 • RANKS 1–100</h3><button onclick="closeM('sclRankGuideModal')" type="button">X</button></div>
<div class="scl-mgr-guide-intro">
<div class="scl-mgr-hero"><div><span class="scl-mgr-kicker">COMPLETE MGR RANKING</span><h3>10 Tiers · 100 Ranks · Original MGR Geometric Symbols</h3><p>Each Tier contains exactly 10 ranks. Every rank uses the symbol, colours, shape, meaning and qualification days from the supplied MGR ranking software.</p></div><div class="scl-mgr-hero-stat"><b>100</b><span>Ranks</span></div><div class="scl-mgr-hero-stat"><b>10</b><span>Tiers</span></div></div>
<div class="scl-mgr-rule-grid"><div><b>Qualification</b><span>30 days per rank</span></div><div><b>Rank 1</b><span>30 days</span></div><div><b>Rank 100</b><span>3,000 days</span></div><div><b>Acceptance</b><span>Monthly approval must be accepted</span></div></div>
<div class="scl-mgr-note"><b>Promotion &amp; salary:</b> The ranking does not calculate or reduce salary. Where a school promotion requires a particular rank, the required rank must be reached and verified before that promotion benefit can take effect. Missed/unaccepted service cycles do not count.</div>
</div>
<div class="scl-mgr-archive-actions"><button class="btn outline" onclick="window.sclOpenFormerStaffRecords?.()" type="button">📋 FORMER STAFF RANK RECORDS</button><small>Authorised administrators can view retained name, contact, final rank and qualification record.</small></div><div class="scl-mgr-rank-explorer" id="sclMgrRankExplorer"></div>
<div class="scl-mgr-beyond"><div class="scl-mgr-beyond-title">Beyond Rank 100 — Prestige Extension</div><div class="scl-mgr-rule-grid" style="margin:10px 0"><div><b>Rank 1,000 time</b><span>30,000 days ≈ 82.14 years</span></div><div><b>Basis</b><span>SCL extension assumes 30 qualification days per rank after Rank 100; the supplied MGR source itself defines ranks through 100.</span></div></div><p>The supplied MGR software defines the complete geometric system through Rank 100. SCL will continue the service record beyond 100 using repeating MGR geometric motifs and a higher prestige naming layer.</p><div class="scl-mgr-milestones"><span><b>101</b> Master Level Foundation</span><span><b>200</b> Grand Master Level Foundation</span><span><b>300</b> Supreme Master Level Foundation</span><span><b>400</b> Imperial Master Level Foundation</span><span><b>500</b> Legendary Master Level Foundation</span><span><b>600</b> Mythic Master Level Foundation</span><span><b>700</b> Eternal Master Level Foundation</span><span><b>800</b> Apex Master Level Foundation</span><span><b>900</b> Ultimate Master Level Foundation</span><span><b>1,000</b> Iconic Master Foundation</span></div></div>
</div>
<div aria-hidden="true" class="modal" id="sclServiceRankModal"><div class="card" style="width:min(1050px,96vw);max-height:95vh"><div class="mh"><h3>🏅 SCL MONTHLY SERVICE RANK</h3><button onclick="closeM('sclServiceRankModal')" type="button">X</button></div><div class="scl-modern-profile-body" id="sclServiceRankBody"></div></div></div>
<style id="scl-social-profile-v71-css">
.scl-profile-shell{display:grid;gap:14px}.scl-profile-hero-card{overflow:hidden;border:1px solid #ead5b6;border-radius:22px;background:#fff;box-shadow:0 14px 42px rgba(63,20,20,.12)}
.scl-profile-cover{position:relative;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;padding:24px;background:linear-gradient(135deg,#4a0006 0%,#650007 48%,#a96b0a 100%);color:#fff;min-height:190px}.scl-profile-cover-glow{position:absolute;inset:auto -15% -65% auto;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(255,220,115,.45),rgba(255,220,115,0) 65%);pointer-events:none}.scl-profile-avatar{position:relative;width:116px;height:116px;border-radius:50%;padding:4px;background:linear-gradient(135deg,#ffe79a,#fff,#d39b24);box-shadow:0 10px 28px rgba(0,0,0,.28);z-index:1}.scl-profile-avatar-img,.scl-profile-avatar-fallback{width:100%;height:100%;border-radius:50%;object-fit:cover}.scl-profile-avatar-fallback{place-items:center;background:linear-gradient(135deg,#f5c84c,#8d0b13);font-size:34px;font-weight:1000;color:#fff}.scl-profile-identity{position:relative;z-index:1}.scl-profile-kicker{font-size:10px;letter-spacing:.16em;font-weight:1000;opacity:.78}.scl-profile-identity h2{margin:5px 0 3px;font-size:30px;line-height:1.05}.scl-profile-identity p{margin:0;opacity:.9;font-size:13px}.scl-profile-badges{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.scl-profile-badges span{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);border-radius:999px;padding:6px 9px;font-size:10px;font-weight:900}.scl-profile-menu{position:relative;z-index:2;display:flex;gap:7px;align-self:start}.scl-profile-menu button{width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.18);color:#fff;cursor:pointer;font-size:17px}.scl-profile-toolbar{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:12px;background:#fff8e8;border-bottom:1px solid #ead5b6}.scl-profile-toolbar button{border:1px solid #dfc897;border-radius:11px;background:#fff;padding:11px 8px;color:#650007;font-weight:900;cursor:pointer}.scl-profile-toolbar .scl-profile-primary{background:#650007;color:#fff;border-color:#650007}.scl-profile-meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:13px}.scl-profile-meta-grid>div{padding:11px;border:1px solid #ead5b6;border-radius:12px;background:#fffaf2}.scl-profile-meta-grid span{display:block;font-size:9px;letter-spacing:.08em;color:#7b6b5c;font-weight:900}.scl-profile-meta-grid b{display:block;margin-top:4px;font-size:12px;color:#34251d;overflow-wrap:anywhere}.scl-profile-passkey{display:flex;justify-content:space-between;gap:12px;align-items:center;margin:0 13px 13px;padding:12px;border-radius:13px;background:#eef4ff;border:1px solid #b9cbed;color:#23467c}.scl-profile-passkey b,.scl-profile-passkey small{display:block}.scl-profile-passkey small{margin-top:3px;line-height:1.4}.scl-profile-section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.scl-profile-section-grid .scl-role-panel{height:100%}
body.scl-night .scl-profile-hero-card{background:#182234;border-color:#475569}.scl-profile-meta-grid>div{color:#fff}.scl-profile-meta-grid b{color:inherit}.scl-profile-toolbar{background:#172033;border-color:#475569}.scl-profile-toolbar button{background:#202b3f;color:#f3d27a;border-color:#475569}.scl-profile-passkey{background:#172a45;border-color:#42658e;color:#dbeafe}
@media(max-width:800px){.scl-profile-cover{grid-template-columns:auto 1fr;gap:12px;padding:18px}.scl-profile-menu{grid-column:1/-1;justify-self:end;position:absolute;right:12px;top:12px}.scl-profile-identity h2{font-size:24px}.scl-profile-avatar{width:94px;height:94px}.scl-profile-toolbar{grid-template-columns:repeat(2,1fr)}.scl-profile-meta-grid{grid-template-columns:repeat(2,1fr)}.scl-profile-section-grid{grid-template-columns:1fr}}
@media(max-width:480px){.scl-profile-cover{grid-template-columns:1fr;text-align:center}.scl-profile-avatar{margin:auto}.scl-profile-identity{margin-top:2px}.scl-profile-badges{justify-content:center}.scl-profile-toolbar{grid-template-columns:1fr 1fr}.scl-profile-meta-grid{grid-template-columns:1fr}.scl-profile-passkey{align-items:stretch;flex-direction:column}.scl-profile-passkey .btn{width:100%}}
</style>
<style id="scl-modern-role-attendance-css">
.scl-modern-profile-body{padding:16px;overflow:auto;max-height:calc(95vh - 75px);background:#fffdf8}.scl-role-hero{display:grid;grid-template-columns:1.4fr .6fr;gap:14px}.scl-role-panel{border:1px solid #ead5b6;border-radius:16px;background:#fff;padding:15px;box-shadow:0 6px 20px #0000000d}.scl-role-panel h4{margin:0 0 8px;color:#650007}.scl-role-chip{display:inline-flex;align-items:center;border-radius:999px;padding:6px 10px;margin:3px;background:#f7eddb;border:1px solid #e2c99f;color:#650007;font-size:11px;font-weight:800}.scl-role-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}.scl-role-action{border:1px solid #ead5b6;border-radius:12px;background:#fff;padding:12px;text-align:left;cursor:pointer;font-weight:800;color:#650007}.scl-role-action small{display:block;color:#6a5d52;margin-top:4px;font-weight:500}.scl-att-card{border:1px solid #ead5b6;border-radius:14px;padding:14px;background:#fff;margin-bottom:12px}.scl-att-status{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.scl-att-status>div{border:1px solid #ead5b6;border-radius:11px;padding:10px;background:#fffaf0;text-align:center}.scl-att-status b{display:block;font-size:19px;color:#650007}.scl-att-status span{font-size:10px;color:#6b6057}.scl-att-green{background:#eefaf2!important;border-color:#9ed1af!important}.scl-att-red{background:#fff0f0!important;border-color:#e2aaaa!important}.scl-att-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.scl-att-location{border:1px dashed #b9a483;border-radius:12px;padding:11px;background:#fffaf0}.scl-att-branch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scl-att-branch{border:2px solid #ead5b6;border-radius:13px;padding:12px;background:#fff;cursor:pointer}.scl-att-branch.selected{border-color:#126b3a;background:#eefaf2}.scl-att-table{width:100%;border-collapse:collapse;font-size:12px}.scl-att-table th{background:#12235d;color:#fff;padding:8px;text-align:left}.scl-att-table td{border:1px solid #ead5b6;padding:8px;vertical-align:top}.scl-att-table-wrap{overflow:auto}.scl-att-passkey-note{padding:11px;border-radius:10px;background:#eef4ff;border:1px solid #b9cbed;color:#23467c;font-size:12px}.scl-att-warning{padding:11px;border-radius:10px;background:#fff8df;border:1px solid #e2c98f;color:#614c21;font-size:12px}.scl-att-error{padding:11px;border-radius:10px;background:#fff0f0;border:1px solid #e2aaaa;color:#8d1515;font-size:12px}.scl-att-success{padding:11px;border-radius:10px;background:#eefaf2;border:1px solid #9ed1af;color:#12652e;font-size:12px}@media(max-width:800px){.scl-role-hero{grid-template-columns:1fr}.scl-role-actions{grid-template-columns:repeat(2,1fr)}.scl-att-status{grid-template-columns:repeat(2,1fr)}.scl-att-branch-grid{grid-template-columns:1fr}}@media(max-width:560px){.scl-modern-profile-body{padding:11px}.scl-role-actions{grid-template-columns:1fr}.scl-att-actions .btn{width:100%}}
</style>
<style id="scl-service-rank-css">.scl-rank-card{border:1px solid #ead5b6;border-radius:16px;background:linear-gradient(135deg,#fffdf8,#fff7df);padding:15px;box-shadow:0 8px 25px #0000000c;margin-bottom:12px}.scl-rank-top{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.scl-rank-number{font-size:48px;line-height:1;font-weight:1000;color:#650007;text-shadow:0 2px 8px #f2ae0055}.scl-rank-label{font-size:12px;font-weight:900;letter-spacing:.08em;color:#6a5d52}.scl-rank-pulse{animation:sclRankPulse 2s ease-in-out infinite}.scl-rank-alert{padding:11px;border-radius:11px;background:#fff0f0;border:1px solid #e2aaaa;color:#7b0000;margin-top:10px}.scl-rank-pending{padding:11px;border-radius:11px;background:#fff8df;border:1px solid #e2c98f;color:#614c21;margin-top:10px}.scl-rank-ok{padding:11px;border-radius:11px;background:#eefaf2;border:1px solid #9ed1af;color:#12652e;margin-top:10px}.scl-rank-history{display:grid;gap:7px;margin-top:12px}.scl-rank-cycle{display:grid;grid-template-columns:80px 1fr auto;gap:9px;align-items:center;border:1px solid #ead5b6;border-radius:10px;padding:9px;background:#fff}.scl-rank-cycle.accepted{border-left:5px solid #16803c}.scl-rank-cycle.missed{border-left:5px solid #b00000}.scl-rank-cycle.pending{border-left:5px solid #f2ae00}.scl-rank-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}@keyframes sclRankPulse{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px) scale(1.02)}}@media(max-width:600px){.scl-rank-cycle{grid-template-columns:1fr}.scl-rank-number{font-size:40px}}</style>
<style id="scl-mgr-complete-ranking-css">
.scl-mgr-guide-card{background:linear-gradient(180deg,#fffdf8,#fff8e9);border:1px solid #d9b66a}.scl-mgr-guide-intro{padding:14px}.scl-mgr-hero{display:grid;grid-template-columns:1fr 90px 90px;gap:10px;align-items:stretch;border:1px solid #ead5b6;border-radius:16px;padding:15px;background:linear-gradient(135deg,#fff,#fff4d6);box-shadow:0 8px 24px #0000000c}.scl-mgr-kicker{font-size:10px;font-weight:1000;letter-spacing:.12em;color:#8a640e}.scl-mgr-hero h3{margin:5px 0;color:#650007}.scl-mgr-hero p{margin:0;color:#62594f;line-height:1.5;font-size:12px}.scl-mgr-hero-stat{border:1px solid #dfc27d;border-radius:12px;background:#fffaf0;display:flex;flex-direction:column;align-items:center;justify-content:center}.scl-mgr-hero-stat b{font-size:30px;color:#650007}.scl-mgr-hero-stat span{font-size:10px;color:#6b6057;font-weight:800}.scl-mgr-rule-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.scl-mgr-rule-grid>div{border:1px solid #ead5b6;border-radius:11px;background:#fff;padding:10px}.scl-mgr-rule-grid b{display:block;color:#650007;font-size:11px}.scl-mgr-rule-grid span{display:block;margin-top:3px;color:#6a6056;font-size:10px;line-height:1.35}.scl-mgr-note{margin-top:10px;padding:11px;border-radius:11px;background:#f5f0ff;border:1px solid #cbbce8;color:#493b68;font-size:11px;line-height:1.5}.scl-mgr-rank-explorer{padding:0 14px 14px}.scl-mgr-tier{border:1px solid #ead5b6;border-radius:16px;background:#fff;margin-top:12px;overflow:hidden;box-shadow:0 5px 18px #0000000a}.scl-mgr-tier-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 14px;background:linear-gradient(90deg,#650007,#8d1b23);color:#fff}.scl-mgr-tier-head b{font-size:14px}.scl-mgr-tier-head span{font-size:10px;opacity:.9}.scl-mgr-rank-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;padding:10px}.scl-mgr-rank-item{border:1px solid #ead5b6;border-radius:12px;padding:8px 5px;background:linear-gradient(180deg,#fff,#fffaf0);cursor:pointer;text-align:center;min-width:0;transition:.16s transform,.16s box-shadow,.16s border-color}.scl-mgr-rank-item:hover{transform:translateY(-2px);border-color:#d6a93d;box-shadow:0 7px 18px #00000012}.scl-mgr-rank-item svg{width:74px;height:74px;display:block;margin:auto}.scl-mgr-rank-no{font-size:11px;font-weight:1000;color:#650007}.scl-mgr-rank-name{font-size:10px;font-weight:800;color:#403831;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}.scl-mgr-rank-days{font-size:9px;color:#786c60;margin-top:2px}.scl-mgr-beyond{margin:14px;padding:14px;border:1px solid #d7c0ec;border-radius:16px;background:linear-gradient(135deg,#fbf6ff,#fff)}.scl-mgr-beyond-title{font-weight:1000;color:#5d277f}.scl-mgr-beyond p{font-size:11px;color:#64586a;line-height:1.45}.scl-mgr-milestones{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.scl-mgr-milestones span{padding:8px;border:1px solid #dfcfea;border-radius:9px;background:#fff;font-size:10px;color:#4e4154}.scl-mgr-milestones b{color:#650007}.scl-mgr-detail-overlay{position:fixed;inset:0;background:#0009;z-index:9999;display:none;align-items:center;justify-content:center;padding:15px}.scl-mgr-detail-overlay.open{display:flex}.scl-mgr-detail{width:min(460px,96vw);max-height:92vh;overflow:auto;border-radius:20px;background:linear-gradient(180deg,#fffdf8,#fff);border:2px solid #d9b66a;box-shadow:0 25px 70px #0008;padding:18px;position:relative}.scl-mgr-detail-close{position:absolute;right:10px;top:8px;border:0;background:#650007;color:#fff;border-radius:50%;width:32px;height:32px;font-weight:900}.scl-mgr-detail-badge{text-align:center}.scl-mgr-detail-badge svg{width:170px;height:170px}.scl-mgr-detail h3{text-align:center;color:#650007;margin:3px 0}.scl-mgr-detail .tag{text-align:center;color:#806e60;font-size:11px;margin-bottom:10px}.scl-mgr-detail-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #ead5b6;font-size:12px}.scl-mgr-detail-row span:first-child{color:#74685e}.scl-mgr-detail-row b{color:#352d28;text-align:right}.scl-mgr-detail-meaning{margin-top:12px;padding:11px;border-radius:11px;background:#fff8df;color:#5e4c20;font-size:11px;line-height:1.45}.scl-mgr-detail-nav{display:flex;justify-content:space-between;gap:8px;margin-top:12px}.scl-mgr-detail-nav button{border:1px solid #d6b45d;background:#fff8df;border-radius:10px;padding:9px 12px;font-weight:900;color:#650007}.t-breathe{animation:sclMgrBreathe 4s ease-in-out infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrBreathe{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}.t-rotate-cw{animation:sclMgrRotate 2s linear infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrRotate{from{transform:rotate(0)}to{transform:rotate(360deg)}}.t-pulse-glow{animation:sclMgrGlow 2.6s ease-in-out infinite}@keyframes sclMgrGlow{0%,100%{filter:drop-shadow(0 0 2px currentColor) brightness(1)}50%{filter:drop-shadow(0 0 7px currentColor) brightness(1.3)}}.t-sway{animation:sclMgrSway 2.8s ease-in-out infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrSway{0%,100%{transform:rotate(-9deg)}50%{transform:rotate(9deg)}}.t-twinkle{animation:sclMgrTwinkle 1.4s ease-in-out infinite}@keyframes sclMgrTwinkle{0%,100%{filter:brightness(1)}50%{filter:brightness(1.6)}}.t-rotate-ccw{animation:sclMgrRotateCCW 3.4s linear infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrRotateCCW{from{transform:rotate(0)}to{transform:rotate(-360deg)}}.t-ember{animation:sclMgrEmber 2.1s ease-in-out infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrEmber{0%,100%{filter:drop-shadow(0 0 3px #d43a3a) brightness(1);transform:scale(1)}50%{filter:drop-shadow(0 0 11px #ff6b6b) brightness(1.2);transform:scale(1.05)}}.t-rotate-slow{animation:sclMgrRotate 8s linear infinite;transform-box:fill-box;transform-origin:center}.t-heartbeat{animation:sclMgrHeartbeat 1.7s ease-in-out infinite;transform-box:fill-box;transform-origin:center}@keyframes sclMgrHeartbeat{0%,100%{transform:scale(1)}14%{transform:scale(1.12)}28%{transform:scale(1)}42%{transform:scale(1.08)}65%{transform:scale(1)}}.t-glow-gold{animation:sclMgrGold 2.4s ease-in-out infinite}@keyframes sclMgrGold{0%,100%{filter:drop-shadow(0 0 4px #ffdd7a)}50%{filter:drop-shadow(0 0 16px #ffe9a8)}}@media(max-width:760px){.scl-mgr-hero{grid-template-columns:1fr 75px 75px}.scl-mgr-rule-grid{grid-template-columns:repeat(2,1fr)}.scl-mgr-rank-grid{grid-template-columns:repeat(2,1fr)}.scl-mgr-milestones{grid-template-columns:1fr}}
@media(max-width:430px){.scl-mgr-hero{grid-template-columns:1fr 65px 65px}.scl-mgr-hero h3{font-size:15px}.scl-mgr-rank-grid{grid-template-columns:repeat(2,1fr);gap:6px;padding:7px}.scl-mgr-rank-item svg{width:62px;height:62px}.scl-mgr-rank-name{font-size:9px}.scl-mgr-rank-days{font-size:8px}}
</style>
<script id="scl-mgr-former-records-v1">
(function(){
  const URL=(window.SCL_SUPABASE_URL||'')+'/functions/v1/scl-rank-archive-api';
  const auth=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}};
  const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  window.sclOpenFormerStaffRecords=async function(){
    const a=auth(), roles=a?.roles||[], ok=roles.some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)));
    if(!ok){toast('Former staff records are restricted to authorised school administrators.');return;}
    let ov=document.getElementById('sclFormerRankRecords');
    if(!ov){ov=document.createElement('div');ov.id='sclFormerRankRecords';ov.className='scl-mgr-detail-overlay';ov.innerHTML='<div class="scl-mgr-detail" style="width:min(1050px,96vw)"><button class="scl-mgr-detail-close" type="button">X</button><h3>📋 FORMER STAFF RANK RECORDS</h3><p style="font-size:12px;color:#6b6057">Retained record: name, contact, final rank, tier and qualification record. Other employment/profile details are removed when an account is archived.</p><div id="sclFormerRankRecordsBody"></div></div>';document.body.appendChild(ov);ov.querySelector('.scl-mgr-detail-close').onclick=()=>ov.classList.remove('open');ov.addEventListener('click',e=>{if(e.target===ov)ov.classList.remove('open')});}
    const body=ov.querySelector('#sclFormerRankRecordsBody');body.innerHTML='<div class="scl-att-warning">Loading retained records…</div>';ov.classList.add('open');
    try{const r=await fetch(URL+'?action=archived',{headers:{'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+(a?.accessToken||'')}});const d=await r.json();if(!r.ok)throw new Error(d.error||'Unable to load records.');body.innerHTML=d.records?.length?'<div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Name</th><th>Contact</th><th>Final Rank</th><th>Tier</th><th>Qualification</th><th>Attendance Days</th><th>Archived</th></tr></thead><tbody>'+d.records.map(x=>'<tr><td>'+esc(x.full_name)+'</td><td>'+esc(x.phone||'—')+'</td><td><b>Rank '+esc(x.archived_rank)+'</b></td><td>'+esc(x.archived_tier_name||('Tier '+x.archived_tier))+'</td><td>✓ '+esc(x.qualification_percent)+'%</td><td>'+esc(x.attendance_days_snapshot||0)+'</td><td>'+esc(x.anonymized_at||'')+'</td></tr>').join('')+'</tbody></table></div>':'<div class="scl-att-warning">No archived staff rank records yet.</div>'}catch(e){body.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}
  };
})();
</script>
<style id="scl-mgr-tier-archive-css">.scl-mgr-archive-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 0}.scl-mgr-archive-actions small{color:#6b6057}.scl-mgr-tier-head b{font-size:14px}.scl-mgr-tier-head span{font-size:11px}</style>
<script id="scl-modern-role-attendance-v1">
(function(){
  const ATT=window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance';
  const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const auth=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}};
  const token=()=>auth()?.accessToken||'';
  const roleList=()=>auth()?.roles||[];
  const isAdmin=()=>roleList().some(r=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(r)));
  async function attFetch(action,method='GET',body=null){const h={'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+token(),'Content-Type':'application/json'};const r=await fetch(ATT+'?action='+encodeURIComponent(action),{method,headers:h,body:body?JSON.stringify(body):undefined});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Attendance service request failed.');return d}
  function open(id){const m=document.getElementById(id);if(!m)return;m.classList.add('open');m.style.display='flex';m.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}
  function close(id){try{closeM(id)}catch(_){const m=document.getElementById(id);if(m){m.classList.remove('open');m.style.display='none'}}}
  function formatDate(v){try{return new Date(v+'T00:00:00').toLocaleDateString('en-NG',{weekday:'short',day:'2-digit',month:'short',year:'numeric'})}catch(_){return v||''}}
  function pct(v){return Number(v||0).toFixed(2)+'%'}
  async function getProfile(){return await attFetch('profile')}
  async function getBranches(){return await attFetch('branches')}
  async function requestLocation(){return new Promise((resolve,reject)=>{if(!navigator.geolocation)return reject(new Error('This phone/browser does not provide GPS location.'));navigator.geolocation.getCurrentPosition(resolve,reject,{enableHighAccuracy:true,maximumAge:0,timeout:15000})})}
  async function passkeyVerify(){
    const sb=window.sclSupabase;
    if(!sb?.auth?.signInWithPasskey)throw new Error('Phone biometric/passkey verification is not available in this browser or is not enabled for the SCL authentication domain yet.');
    const {data,error}=await sb.auth.signInWithPasskey();
    if(error)throw error;
    if(data?.session){
      const current=auth()||{};sessionStorage.setItem('sclAuthSession',JSON.stringify({...current,accessToken:data.session.access_token,refreshToken:data.session.refresh_token,user:data.user||current.user}));
    }
    return true;
  }
  window.sclRegisterPhonePasskey=async function(){
    try{
      const sb=window.sclSupabase;
      if(!sb?.auth?.registerPasskey) throw new Error('This browser does not expose the SCL passkey registration API. Update the browser or use a supported secure HTTPS browser.');
      if(!window.isSecureContext) throw new Error('Passkeys require a secure HTTPS website. Open the official SCL site over HTTPS and try again.');
      const {data,error}=await sb.auth.registerPasskey();
      if(error){
        const code=String(error.code||'').toLowerCase();
        if(code==='passkey_disabled' || /passkey.*disabled/i.test(String(error.message||''))) throw new Error('SCL passkeys are currently disabled in the Supabase project. The administrator must enable Authentication → Passkeys and configure the WebAuthn domain before phone biometric registration can work.');
        throw error;
      }
      toast('Phone biometric / passkey registered. Your biometric data remains on your device.');
    }catch(e){toast(e.message||'Unable to register phone biometric verification.')}
  };
  window.sclOpenModernProfile=async function(){open('sclModernProfileModal');const box=document.getElementById('sclModernProfileBody');box.innerHTML='<div class="scl-att-warning">Loading your SCL profile and role dashboard…</div>';try{const d=await getProfile();window.sclCurrentProfile=d;renderProfile(d)}catch(e){const local=auth()||{};const localRoles=local.roles||[];const localAdmin=localRoles.some(x=>/^(developer|technical_admin|management_admin|affairs_admin)$/i.test(String(x)));if(localAdmin){const fallback={roles:localRoles,user:local.user||{},profile:(local.user&&local.user.user_metadata)||{},summary:null,staff:null,children:[],student:null};window.sclCurrentProfile=fallback;renderProfile(fallback);box.insertAdjacentHTML('afterbegin','<div class="scl-att-warning"><b>Backend connection notice:</b> the administrator controls are available locally. Live records will populate when the SCL/Supabase service responds.</div>')}else{box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div><div class="scl-att-actions"><button class="btn outline" onclick="openSchoolEmail()" type="button">EMAIL SCHOOL</button><button class="btn red" onclick="openWhatsAppChoices()" type="button">CONTACT SCL SUPPORT</button></div>'}}};
  function renderProfile(d){
    const roles=d.roles||[],r=roles[0]||'account';const admin=isAdmin();const staff=!!d.staff;const summary=d.summary;const name=d.profile?.full_name||d.user?.email||'SCL User';
    const au=(auth()||{}).user||{}; const meta=Object.assign({},au.user_metadata||{},d.user?.user_metadata||{});
    const email=d.user?.email||d.profile?.email||au.email||'';
    const photo=meta.avatar_url||meta.picture||meta.photo_url||d.profile?.avatar_url||'';
    const initials=String(name||email||'SCL').trim().split(/\s+/).slice(0,2).map(x=>x[0]||'').join('').toUpperCase()||'SCL';
    const avatar=photo?'<img src="'+esc(photo)+'" alt="Profile photo" class="scl-profile-avatar-img" referrerpolicy="no-referrer" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'grid\'">':'<span></span>';
    const roleLabel=roles.map(x=>String(x).replace(/_/g,' ').replace(/\b\w/g,m=>m.toUpperCase())).join(' • ')||'SCL ACCOUNT';
    const cards='<section class="scl-profile-hero-card">'
      +'<div class="scl-profile-cover"><div class="scl-profile-cover-glow"></div><div class="scl-profile-avatar">'+avatar+'<span class="scl-profile-avatar-fallback" style="display:'+(photo?'none':'grid')+'">'+esc(initials)+'</span></div><div class="scl-profile-identity"><div class="scl-profile-kicker">SCL ADMINISTRATIVE ACCOUNT</div><h2>'+esc(name)+'</h2><p>'+esc(email)+'</p><div class="scl-profile-badges"><span>✓ AUTHENTICATED</span><span>'+esc(roleLabel)+'</span></div></div><div class="scl-profile-menu"><button type="button" onclick="sclOpenProfileSearch()" title="Search my SCL profile" aria-label="Search my SCL profile">🔎</button><button type="button" onclick="sclRegisterPhonePasskey()" title="Register phone biometric/passkey">🔐</button><button type="button" onclick="sclLogout();closeM(\'sclModernProfileModal\')" title="Log out">↪</button></div></div>'
      +'<div class="scl-profile-toolbar"><button class="scl-profile-primary" type="button" onclick="sclOpenAttendance()">🟢 Attendance</button><button type="button" onclick="sclOpenServiceRank()">🏅 Service Rank</button><button type="button" onclick="openSchoolCurriculum()">📚 Curriculum</button><button type="button" onclick="openWhatsAppChoices()">💬 Support</button></div>'
      +'<div class="scl-profile-meta-grid"><div><span>ACCOUNT EMAIL</span><b>'+esc(email)+'</b></div><div><span>ACCOUNT ROLE</span><b>'+esc(roleLabel)+'</b></div><div><span>ACCESS LEVEL</span><b>'+(admin?'Full administrative access':'Role-based access')+'</b></div><div><span>PHOTO SOURCE</span><b>'+(photo?'Linked account profile image':'Initials / SCL fallback')+'</b></div></div>'
      +'<div class="scl-profile-passkey"><div><b>🔐 PHONE BIOMETRIC / PASSKEY</b><small>Your fingerprint/face data stays on the phone. SCL receives the WebAuthn credential, not the biometric.</small></div><button class="btn gold" type="button" onclick="sclRegisterPhonePasskey()">REGISTER PASSKEY</button></div>'
      +'</section>';
    let extraCards='';
    function rrRoleLabel(rs){return rs.map(x=>String(x).replace(/_/g,' ').replace(/\b\w/g,m=>m.toUpperCase())).join(' • ')||'ADMINISTRATOR';}
    const adminControlCard=admin?`<div class="scl-role-panel scl-technical-control-center"><h4>🛠️ ADMIN CONTROL CENTER</h4><p><b>${rrRoleLabel(roles)}</b> — ${rrRoleLabel(roles).toLowerCase().includes('technical')?'Full technical and operational controls are exposed here. The only reserved area is fee negotiation, which belongs to Management Administration.':'Role-based administration controls are exposed here; fee negotiation belongs to Management Administration.'}</p><div class="scl-admin-alert-control"><div><b>🔔 Timetable Master Alerts</b><small>Controls automatic period-start and period-end notifications for authorised students, teachers and staff/workers. Ordinary users never receive this control.</small></div><button type="button" class="scl-alert-master-toggle" data-scl-alert-master aria-pressed="false" onclick="sclAdminToggleTimetableAlerts()">🔕 TIMETABLE ALERTS: OFF</button></div><div class="scl-admin-feature-grid"><button class="scl-role-action" onclick="openM('sclSuiteModal');sclSuiteTab('timetable')">🗓️ Timetable & Scheduling<small>Direct timetable editing, teacher/live schedule and class periods.</small></button><button class="scl-role-action" onclick="sclOpenAttendance('admin')">📋 Attendance Control<small>Review and manage attendance records.</small></button><button class="scl-role-action" onclick="openWorkers()">🧑‍🏫 Workers & Teachers<small>Staff registration, teacher records and worker management.</small></button><button class="scl-role-action" onclick="pickRegistration()">👤 Admissions & Registration<small>New admissions and returning-student promotion.</small></button><button class="scl-role-action" onclick="openFees()">💳 Fees & Payments<small>Fee schedules, payments and management review.</small></button><button class="scl-role-action" onclick="openResults()">📊 Results & Certificates<small>Results, PINs, reports and certificates.</small></button><button class="scl-role-action" onclick="openM('sclSuiteModal');sclSuiteTab('assignments')">📚 Assignments & Assessment<small>Class work and assessment tools.</small></button><button class="scl-role-action" onclick="openM('sclSuiteModal');sclSuiteTab('cbt')">📝 CBT & Online Tests<small>Question and test management.</small></button><button class="scl-role-action" onclick="openM('sclSuiteModal');sclSuiteTab('lessons')">📖 Lesson Notes / Plans<small>Teaching plans and lesson records.</small></button><button class="scl-role-action" onclick="openM('sclSuiteModal');sclSuiteTab('bulk')">📊 Bulk Data / Excel<small>Bulk school data and operations.</small></button><button class="scl-role-action" onclick="openSchoolCurriculum()">📚 Curriculum & Calendar<small>Academic programme and calendar.</small></button><button class="scl-role-action" onclick="openMaterials()">📦 School Materials<small>Materials catalogue and requests.</small></button><button class="scl-role-action" onclick="openUniformAdmin()">👕 Uniform Management<small>Publish and maintain uniform listings.</small></button><button class="scl-role-action" onclick="openCollaboration()">🤝 Community & Activities<small>Announcements, collaborators and school activities.</small></button><button class="scl-role-action" onclick="openSclLeadership()">👑 Leadership & Badges<small>Student leadership recognition records.</small></button><button class="scl-role-action" onclick="sclOpenServiceRank()">🏅 Service Rank<small>Rank review and maintenance.</small></button><button class="scl-role-action" onclick="sclOpenBranchAdmin()">📍 Branch & GPS<small>Approved attendance locations and geofencing.</small></button><button class="scl-role-action" onclick="openSalaryAdmin()">💼 Salary / Attendance Review<small>Attendance-based salary review.</small></button><button class="scl-role-action" onclick="sclOpenFormerStaffRecords()">🗃️ Former Staff Records<small>Archived worker records.</small></button><button class="scl-role-action" onclick="openWhatsAppChoices()">💬 Support / Escalation<small>Contact school support.</small></button></div><div class="scl-admin-backend-note"><b>Backend readiness:</b> these controls stay visible in the administrator workspace. Each module uses its live SCL/Supabase service when connected; if a service is unavailable, the module reports the connection issue instead of disappearing.</div></div>`:'';
    function rrRoleLabel(rs){return rs.map(x=>String(x).replace(/_/g,' ').replace(/\b\w/g,m=>m.toUpperCase())).join(' • ')||'ADMINISTRATOR';}
    
    if(staff){extraCards+='<div class="scl-role-panel"><h4>Staff Attendance</h4><p style="margin:5px 0">'+esc(d.staff.full_name||name)+' • '+esc(d.staff.role||r)+'</p>'+(summary?'<div class="scl-att-status"><div class="'+(summary.meets_90_percent?'scl-att-green':'scl-att-red')+'"><b>'+pct(summary.attendance_percent)+'</b><span>4-week attendance</span></div><div><b>'+summary.present_days+'</b><span>Valid days</span></div><div><b>'+summary.absent_days+'</b><span>Absent days</span></div><div><b>'+summary.working_days+'</b><span>Working days</span></div></div>':'')+'<div class="scl-att-actions"><button class="btn red" onclick="sclOpenAttendance()" type="button">🟢 OPEN ATTENDANCE</button>'+(summary&&!summary.meets_90_percent?'<button class="btn gold" onclick="sclOpenAttendance(\'appeal\')" type="button">APPEAL PAYMENT REVIEW</button>':'')+'</div></div>'}
    if(d.children?.length){extraCards+='<div class="scl-role-panel"><h4>Parent / Children</h4><p>Manage and monitor each linked child from one secure dashboard.</p><div class="scl-att-actions"><button class="btn red" onclick="openMyChildren()" type="button">👨‍👩‍👧 MY CHILDREN</button></div><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Child</th><th>Class</th><th>Session</th><th>Status</th></tr></thead><tbody>'+d.children.map(c=>'<tr><td>'+esc(c.child_name)+'</td><td>'+esc(c.class_name)+'</td><td>'+esc(c.session)+'</td><td>'+esc(c.status)+'</td></tr>').join('')+'</tbody></table></div></div>'}
    if(d.student){extraCards+='<div class="scl-role-panel"><h4>Student Workspace</h4><p>'+esc(d.student.child_name)+' • '+esc(d.student.class_name)+'</p><div class="scl-role-actions"><button class="scl-role-action" onclick="openResults()">📊 Results<small>View academic results and reports.</small></button><button class="scl-role-action" onclick="openM(\'sclSuiteModal\');sclSuiteTab(\'assignments\')">📚 Learning<small>Assignments and timetable.</small></button><button class="scl-role-action" onclick="toast(\'Student attendance status is available through the SCL attendance system.\')">🟢 Attendance<small>Attendance status.</small></button><button class="scl-role-action" onclick="openSclLeadership()">👑 Badge Status<small>View student leadership badge status and verification.</small></button><button class="scl-role-action" onclick="showCommunityTab(\'medals\')">🏅 Medal &amp; Record Status<small>View competition medals, Record Makers and Record Breakers.</small></button><button class="scl-role-action" onclick="openMyChildren()">👨‍👩‍👧 Parent Care<small>Complaints, recommendations, improvements and child history.</small></button></div></div>'}
    if(roles.some(x=>String(x).toLowerCase()==='teacher')){extraCards+='<div class="scl-role-panel"><h4>Teacher Workspace</h4><p>Teaching tools are organised here so teachers do not have to search through the public website.</p><div class="scl-role-actions"><button class="scl-role-action" onclick="sclOpenAttendance()">🟢 Staff Attendance<small>Sign in/out and review your attendance.</small></button><button class="scl-role-action" onclick="sclSuiteTab(\'assignments\');openM(\'sclSuiteModal\')">📚 Assignments<small>Create and track class work.</small></button><button class="scl-role-action" onclick="sclSuiteTab(\'lessons\');openM(\'sclSuiteModal\')">📖 Lesson Plans<small>Prepare lesson plans and notes.</small></button><button class="scl-role-action" onclick="sclSuiteTab(\'timetable\');openM(\'sclSuiteModal\')">🗓️ Timetable<small>View teaching periods and schedules.</small></button><button class="scl-role-action" onclick="sclSuiteTab(\'cbt\');openM(\'sclSuiteModal\')">📝 CBT<small>Create or review online tests.</small></button><button class="scl-role-action" onclick="toast(\'Use the SCL Results tools to enter and publish approved results.\')">📊 Results<small>Result entry and publication.</small></button></div></div>'}
    if(admin){const rr=roles.map(x=>String(x).toLowerCase());const tech=rr.includes('technical_admin')||rr.includes('developer');const mgmt=rr.includes('management_admin');const affairs=rr.includes('affairs_admin');extraCards+=adminControlCard;extraCards+=`<div class="scl-role-panel scl-audit-panel" id="sclProfileAuditPanel"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap"><div><h4 style="margin:0">🧾 LIVE ACTIVITY & TRANSACTION LOG</h4><p style="margin:5px 0">Authoritative school activity stream for payments, attendance, registrations, results, announcements, authentication and other important operations.</p></div><button class="btn gold" type="button" onclick="sclLoadActivityLog(true)">↻ REFRESH</button></div><div class="scl-audit-status" id="sclAuditStatus">Connecting to the SCL activity log…</div><div class="scl-att-table-wrap"><table class="scl-att-table scl-audit-table"><thead><tr><th>Time</th><th>Person / Account</th><th>Role</th><th>Activity</th><th>Entity</th><th>Status</th><th>Details</th></tr></thead><tbody id="sclActivityLogBody"><tr><td colspan="7" style="text-align:center;padding:22px">No activity recorded yet.</td></tr></tbody></table></div></div>`;extraCards+='<div class="scl-role-panel"><h4>ADMINISTRATOR ACCESS & RESPONSIBILITIES</h4><p><b>Technical Administrator:</b> overall creator and highest-level administrator with no feature limitation across the SCL platform. Technical Administrator can configure, edit, approve, manage, replace and disable administrator identities and school systems.</p><p><b>Management Administrator:</b> management, parent support and fee-negotiation authority.</p><p><b>Affairs Administrator:</b> affairs/communication responsibilities within the school administration scope.</p><p><b>Timetable alerts:</b> only authorised administrators can turn the master alert switch ON or OFF. Students, teachers and staff/workers may receive timetable alerts when the master switch is ON; ordinary users do not receive the alert control.</p></div>'+'<div class="scl-role-panel"><h4>Administrator Workspace — Fully Equipped</h4><p>Authorised administrators get one control dashboard for attendance, rank maintenance, admissions, fees, results, staff, recognition, curriculum, community and verification tools.</p><div class="scl-role-actions"><button class="scl-role-action" onclick="sclOpenAttendance(\'admin\')">📋 Attendance Register<small>Review sign-in/out, absences, branches and attendance summaries.</small></button><button class="scl-role-action" onclick="sclOpenServiceRank()">🏅 Rank Maintenance<small>Review attendance-based staff rank calculations and monthly approvals.</small></button><button class="scl-role-action" onclick="sclOpenBranchAdmin()">📍 Branch & GPS Setup<small>Manage approved school locations for attendance.</small></button><button class="scl-role-action" onclick="openWorkers()">🧑‍🏫 Staff / Worker Management<small>Register and manage teachers and other workers.</small></button><button class="scl-role-action" onclick="pickRegistration()">👤 Student Admissions<small>Register new students and verify returning students.</small></button><button class="scl-role-action" onclick="openFees()">💳 Fees & Payment Review<small>Open class fee schedules and payment workflows.</small></button><button class="scl-role-action" onclick="openResults()">📊 Results & Certificates<small>Results, PIN clearance, report cards and certificates.</small></button><button class="scl-role-action" onclick="openUniformAdmin()">👕 Uniform Management<small>Publish and maintain uniform catalogue entries.</small></button><button class="scl-role-action" onclick="openSclLeadership()">👑 Leadership Badges<small>Issue, verify, print and export student badges.</small></button><button class="scl-role-action" onclick="showCommunityTab(\'medals\')">🏅 Medals & Records<small>Competition recognition, Record Makers and Record Breakers.</small></button><button class="scl-role-action" onclick="openCollaboration()">🤝 Community Manager<small>Collaborators, activities and school communication content.</small></button><button class="scl-role-action" onclick="openSchoolCurriculum()">📖 Curriculum & Calendar<small>Programme, scheme and local-date calendar.</small></button><button class="scl-role-action" onclick="openM(\'sclSuiteModal\');sclSuiteTab(\'bulk\')">📊 Bulk Data / Management Tools<small>Bulk data, scheduling, promotion and school operations.</small></button><button class="scl-role-action" onclick="openSalaryAdmin()">💼 Salary / Attendance Review<small>Attendance-based salary fitness review.</small></button><button class="scl-role-action" onclick="sclOpenFormerStaffRecords()">🗃️ Former Staff Records<small>Retained archived staff records and final qualification history.</small></button><button class="scl-role-action" onclick="openWhatsAppChoices()">💬 Support & Admin Contact<small>Contact school support when an issue requires escalation.</small></button></div></div>'}
    if(!staff&&!d.children?.length&&!d.student&&!admin){extraCards+='<div class="scl-role-panel"><h4>Role Dashboard</h4><p>Your account is authenticated. The school can link your account to a parent, student or staff profile to activate the relevant workspace.</p><div class="scl-role-actions"><button class="scl-role-action" onclick="openSchoolEmail()">✉️ Contact School<small>Request profile linking or support.</small></button><button class="scl-role-action" onclick="openWhatsAppChoices()">💬 SCL Support<small>Contact the appropriate administrator.</small></button></div></div>'}
    if(staff||admin){extraCards='<div class="scl-role-panel" style="grid-column:1/-1"><h4>STAFF STATUS</h4><p>Your staff ranking is calculated from verified working attendance. Monday-Friday is the working week; full-time staff default to 5 working days/week and part-time staff default to 2 working days/week unless the school records another schedule.</p><div class="scl-role-actions"><button class="scl-role-action" onclick="sclOpenAttendance()">🟢 VIEW MY ATTENDANCE STATUS<small>See present days, expected days, absences and attendance history.</small></button><button class="scl-role-action" onclick="sclOpenServiceRank()">🏅 VIEW MY RANK STATUS<small>See attendance-based rank, accepted monthly cycles and promotion readiness.</small></button></div></div><div id="sclProfileServiceRank" class="scl-rank-card" style="grid-column:1/-1"><div class="scl-rank-top"><div><div class="scl-rank-label">ATTENDANCE-BASED SERVICE RANK</div><div class="scl-rank-number scl-rank-pulse">—</div></div><div><b>Rank is calculated from verified working attendance, with monthly approval also required for a cycle to count.</b><p style="margin:4px 0;color:#6a5d52">Working week: Monday-Friday. Staff are not limited to two days/week. For part-time staff, each absence carries a 2-working-day attendance deduction. A valid present working day earns attendance credit; missed scheduled days reduce the attendance credit. Every completed 30-day cycle still requires staff acceptance before that cycle can count.</p></div></div><div id="sclProfileServiceRankContent" class="scl-rank-pending">Loading your service-rank status…</div></div>'+extraCards;}
    document.getElementById('sclModernProfileBody').innerHTML='<div class="scl-profile-shell">'+cards+'<div class="scl-profile-section-grid">'+extraCards+'</div></div>';    if(admin) setTimeout(()=>window.sclRefreshAdminAlertControls?.(),0); if(staff||admin) setTimeout(()=>window.sclLoadServiceRankIntoProfile?.(),0);
  }
  const SERVICE_RANK=window.SCL_SUPABASE_URL+'/functions/v1/scl-service-rank-api';
  async function serviceRankFetch(action='current',method='GET',body=null){const a=auth();if(!a?.accessToken)throw new Error('Please sign in to view your service rank.');const h={'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+a.accessToken,'Content-Type':'application/json'};const r=await fetch(SERVICE_RANK+'?action='+encodeURIComponent(action),{method,headers:h,body:body?JSON.stringify(body):undefined});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Service rank request failed.');return d}
  function rankDate(v){if(!v)return '—';try{return new Date(v+'T00:00:00').toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric'})}catch(_){return v}}
  function badgeForProfile(e){try{var cx=50,cy=50,r=35.2,html='<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" width="86" height="86">';html+='<circle cx="50" cy="50" r="44" fill="none" stroke="#dfb25c" stroke-width="2.6"/>';for(var k=0;k<(e.decagons||0);k++){var c=e.colors[k],pts=[];for(var i=0;i<10;i++){var a=(-90+i*36)*Math.PI/180;pts.push((50+r*Math.cos(a)).toFixed(2)+','+(50+r*Math.sin(a)).toFixed(2))}html+='<polygon points="'+pts.join(' ')+'" fill="none" stroke="'+c+'" stroke-width="'+Math.max(.5,2.3-e.decagons*.14)+'"/>';r*=.8}if(e.shape==='circle')html+='<circle cx="50" cy="50" r="'+r+'" fill="none" stroke="'+(e.colors[e.decagons-1]||'#dfb25c')+'" stroke-width="2.4"/>';else if(e.shape){var sidesMap={triangle:3,square:4,pentagon:5,hexagon:6,heptagon:7,octagon:8,nonagon:9,decagon:10},n=sidesMap[e.shape]||0,pts2=[];for(var j=0;j<n;j++){var aa=(-90+j*360/n)*Math.PI/180;pts2.push((50+r*Math.cos(aa)).toFixed(2)+','+(50+r*Math.sin(aa)).toFixed(2))}html+='<polygon points="'+pts2.join(' ')+'" fill="none" stroke="'+(e.colors[e.decagons-1]||'#dfb25c')+'" stroke-width="2.4"/>'}if(e.diamond)html+='<polygon points="50,42.5 55.4,50 50,57.5 44.6,50" fill="#bfe9ff" stroke="#8fd6ff" stroke-width="1"/>';return html+'</svg>'}catch(_){return ''}}
function rankHtml(d){const next=d.next_due_date?rankDate(d.next_due_date):'Not due yet';let notice='';if(d.resignation_advice){notice='<div class="scl-rank-alert"><b>Monthly approval warning:</b> '+esc(d.notification||'Two or more monthly approvals have been missed.')+(d.resignation_deadline?'<br><b>Review deadline:</b> '+rankDate(String(d.resignation_deadline).slice(0,10)):'' )+'</div>'}else if(d.next_due_date&&new Date(d.next_due_date+'T00:00:00Z')<=new Date()){notice='<div class="scl-rank-pending"><b>Approval required now.</b> Accept this monthly service-rank notice for this cycle to count.</div>'}else notice='<div class="scl-rank-ok">'+esc(d.notification||'Your service-rank record is up to date.')+'</div>';const rows=(d.cycles||[]).slice(0,18).map(c=>'<div class="scl-rank-cycle '+String(c.status||'').toLowerCase()+'"><b>Cycle '+esc(c.cycle_number)+'</b><span>Due '+rankDate(c.due_date)+'<br><small>'+(c.status==='ACCEPTED'?'Accepted '+rankDate(String(c.accepted_at||'').slice(0,10)):c.status==='MISSED'?'Not accepted':'Awaiting approval')+'</small></span><strong>'+esc(c.status)+'</strong></div>').join('');const promo=(d.promotion_rules||[]).map(r=>'<div class="scl-rank-cycle '+(Number(d.rank||0)>=Number(r.required_rank)?'accepted':'pending')+'"><b>'+esc(r.title)+'</b><span>Required rank: '+esc(r.required_rank)+'</span><strong>'+(Number(d.rank||0)>=Number(r.required_rank)?'ELIGIBLE':'HELD')+'</strong></div>').join(''); const pnotice=(d.promotion_notifications||[]).map(n=>'<div class="scl-rank-pending"><b>'+esc(n.title)+'</b><br>'+esc(n.body)+'<br><button class="btn gold" type="button" onclick="toast(\'Promotion verification is completed from your SCL profile.\')">VERIFY ON PROFILE</button></div>').join(''); const rm=window.sclGetMGRRankTier?window.sclGetMGRRankTier(Number(d.rank||0)):null; const rb=(rm&&rm.level<=100)?badgeForProfile(rm):''; const rn=rm?esc(rm.name):'Service Rank'; const rt=rm&&rm.level<=100?'Tier '+esc(rm.tier+1)+' • '+esc(rm.days)+' days':(rm?'Prestige Rank':''); return '<div class="scl-rank-top"><div><div class="scl-rank-label">CURRENT MGR RANK</div><div class="scl-rank-number">'+esc(d.rank||0)+'</div></div>'+ (rb?'<div style="text-align:center"><div>'+rb+'</div><small style="font-weight:900;color:#650007">'+rn+'</small><br><small style="color:#6a5d52">'+rt+'</small></div>':'') +'<div><b>Accepted monthly cycles: '+esc(d.approved_months||0)+'</b><br><span>Verified present working days: '+esc(d.attendance_present_days||0)+'</span><br><span>Expected scheduled days: '+esc(d.attendance_expected_days||0)+'</span><br><span>Attendance rate: '+esc(d.attendance_percent??100)+'%</span><br><span>Rank supported by attendance days: '+esc(d.attendance_rank_by_days||0)+'</span><br><span>Service started: '+rankDate(d.service_start)+'</span><br><span>Next cycle due: '+next+'</span></div></div>'+notice+'<div class="scl-rank-card" style="margin-top:10px"><h4>PROMOTION READINESS</h4>'+promo+'<small style="display:block;margin-top:8px;color:#6b5c50">Salary is not calculated from this rank. Promotion eligibility and benefits are held until the required rank is reached and verified.</small></div>'+(pnotice?'<div class="scl-rank-card" style="margin-top:10px"><h4>VERIFICATION NOTICES</h4>'+pnotice+'</div>':'')+(d.next_due_date?'<div class="scl-rank-actions"><button class="btn gold" type="button" id="sclRankAcceptBtn" '+(new Date(d.next_due_date+'T00:00:00Z')<=new Date()?'':'disabled')+'>✓ ACCEPT & APPROVE THIS MONTH</button></div>':'')+'<div class="scl-rank-history">'+(rows||'<div class="scl-rank-cycle pending"><span>No completed 30-day cycles yet.</span></div>')+'</div>'}
  async function bindRankAccept(){const btn=document.getElementById('sclRankAcceptBtn');if(!btn||btn.disabled)return;btn.onclick=async()=>{btn.disabled=true;btn.textContent='Saving approval…';try{await serviceRankFetch('accept','POST');toast('Monthly service rank accepted.');await window.sclOpenServiceRank()}catch(e){btn.disabled=false;btn.textContent='✓ ACCEPT & APPROVE THIS MONTH';toast(e.message||'Unable to accept this cycle.')}}}
  window.sclLoadServiceRankIntoProfile=async function(){const box=document.getElementById('sclProfileServiceRankContent');if(!box)return;try{const d=await serviceRankFetch('current');box.className='';box.innerHTML=rankHtml(d);await bindRankAccept()}catch(e){box.className='scl-rank-alert';box.textContent=e.message||'Service rank unavailable.'}};
  window.sclOpenServiceRank=async function(){open('sclServiceRankModal');const box=document.getElementById('sclServiceRankBody');box.innerHTML='<div class="scl-att-warning">Loading monthly service rank…</div>';try{const d=await serviceRankFetch('current');box.innerHTML='<div class="scl-rank-card">'+rankHtml(d)+'</div>'+(isAdmin()?'<div class="scl-rank-card"><h4>ADMIN MAINTENANCE</h4><p>Run the rank maintenance check for linked verified staff accounts.</p><div class="scl-rank-actions"><button class="btn red" type="button" id="sclRankAdminSync">RUN RANK MAINTENANCE</button></div><div id="sclRankAdminResult"></div></div>':'');await bindRankAccept();const ab=document.getElementById('sclRankAdminSync');if(ab)ab.onclick=async()=>{ab.disabled=true;ab.textContent='Running…';try{const r=await serviceRankFetch('admin_sync','POST');document.getElementById('sclRankAdminResult').innerHTML='<div class="scl-rank-ok">Processed '+esc(r.processed)+' account(s). Archived: '+esc(r.archived)+'.</div>';toast('Service-rank maintenance completed.')}catch(e){toast(e.message||'Maintenance failed')}finally{ab.disabled=false;ab.textContent='RUN RANK MAINTENANCE'}}}catch(e){box.innerHTML='<div class="scl-rank-alert">'+esc(e.message)+'</div>'}};
  window.sclOpenAttendance=async function(mode='self'){open('sclAttendanceModal');const box=document.getElementById('sclAttendanceBody');box.innerHTML='<div class="scl-att-warning">Loading attendance…</div>';try{if(mode==='admin'){await renderAdminAttendance();return}const d=await attFetch('my_attendance');renderSelfAttendance(d,mode==='appeal')}catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div><div class="scl-att-actions"><button class="btn outline" onclick="openSchoolEmail()" type="button">EMAIL SCHOOL</button><button class="btn red" onclick="openWhatsAppChoices()" type="button">CONTACT TECHNICAL ADMIN</button></div>'}};
  function renderSelfAttendance(d,showAppeal){const s=d.summary||{};const rows=(d.records||[]).slice(0,90);const today=new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'});const rec=rows.find(x=>x.attendance_date===today);let html='<div class="scl-att-card"><h4>Four-Week Attendance Status</h4><p><b>Attendance applies to all SCL staff and teachers, including full-time and part-time workers.</b></p><div class="scl-att-status"><div class="'+(s.meets_90_percent?'scl-att-green':'scl-att-red')+'"><b>'+pct(s.attendance_percent)+'</b><span>Attendance</span></div><div><b>'+s.present_days+'</b><span>Valid complete days</span></div><div><b>'+s.absent_days+'</b><span>Absent / missing</span></div><div><b>'+s.working_days+'</b><span>Expected weekdays</span></div></div><p style="margin-bottom:0">'+(s.meets_90_percent?'You are currently at or above the 90% four-week attendance threshold.':'Your four-week attendance is below 90%. Salary/payment review may require an appeal.')+'</p></div>';
    html+='<div class="scl-att-card"><h4>Today — '+formatDate(today)+'</h4>';
    if(rec?.status==='present'&&rec.sign_in_at&&!rec.sign_out_at){html+='<div class="scl-att-success">Signed in at '+esc(new Date(rec.sign_in_at).toLocaleTimeString('en-NG'))+' at '+esc(rec.school_branches?.name||'your selected branch')+'. You must sign out at the same branch while you are physically inside the approved geofence.</div><div class="scl-att-actions"><button class="btn red" onclick="sclSignOut()" type="button">🔴 SIGN OUT FROM THIS LOCATION</button></div>'}
    else if(rec?.sign_out_status==='valid'){html+='<div class="scl-att-success">Today is complete. Sign-in: '+esc(new Date(rec.sign_in_at).toLocaleTimeString('en-NG'))+' • Sign-out: '+esc(new Date(rec.sign_out_at).toLocaleTimeString('en-NG'))+'</div>'}
    else if(rec?.status==='absent'){html+='<div class="scl-att-warning"><b>Absent today.</b><br>'+esc(rec.absence_reason||'Reason recorded')+'</div>'}
    else if(rec?.status==='leave'){html+='<div class="scl-att-warning">Leave recorded for today.</div>'}
    else{html+='<div class="scl-att-actions"><button class="btn red" onclick="sclSignIn()" type="button">🟢 SIGN ATTENDANCE</button><button class="btn gold" onclick="sclMarkAbsent()" type="button">ABSENT TODAY</button></div>'}
    html+='</div><div class="scl-att-card"><h4>How location verification works</h4><div class="scl-att-location">1. Choose the branch you are physically attending.<br>2. SCL asks the phone for current location permission.<br>3. The server checks the GPS point against the approved branch radius.<br>4. Phone biometric / passkey verification completes the attendance action.<br>5. SCL stores the attendance verification record, not your fingerprint or face image.</div></div>';
    html+='<div class="scl-att-card"><h4>Attendance History</h4><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Date</th><th>Status</th><th>Branch</th><th>Sign In</th><th>Sign Out</th><th>Location</th></tr></thead><tbody>'+(rows.map(r=>'<tr><td>'+formatDate(r.attendance_date)+'</td><td>'+esc(r.status)+'</td><td>'+esc(r.school_branches?.name||'—')+'</td><td>'+esc(r.sign_in_at?new Date(r.sign_in_at).toLocaleTimeString('en-NG'):'—')+'</td><td>'+esc(r.sign_out_at?new Date(r.sign_out_at).toLocaleTimeString('en-NG'):'—')+'</td><td>'+esc(r.sign_out_status||r.sign_in_distance_m!=null?Math.round(r.sign_out_distance_m??r.sign_in_distance_m)+' m':'—')+'</td></tr>').join('')||'<tr><td colspan="6">No attendance records yet.</td></tr>')+'</tbody></table></div></div>';
    if(showAppeal||!s.meets_90_percent)html+='<div class="scl-att-card"><h4>Payment / Attendance Appeal</h4><p>Your four-week attendance is below 90%. Submit an appeal with the reason and supporting note for administrator review.</p><textarea id="sclAppealReason" rows="3" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px" placeholder="Why should the attendance/payment record be reviewed?"></textarea><textarea id="sclAppealNote" rows="2" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px;margin-top:8px" placeholder="Supporting note (optional)"></textarea><div class="scl-att-actions"><button class="btn gold" onclick="sclSubmitAppeal()" type="button">SUBMIT APPEAL</button></div></div>';
    html+='<div class="scl-att-actions"><button class="btn outline" onclick="openSchoolEmail()" type="button">EMAIL '+esc(window.SCL_WORKER_CONFIG?.schoolEmail||'SCL SCHOOL')+'</button><button class="btn outline" onclick="openWhatsAppChoices()" type="button">TECHNICAL ADMIN SUPPORT</button></div>';
    document.getElementById('sclAttendanceBody').innerHTML=html;
  }
  async function branchPickerHtml(){const d=await getBranches();const b=d.branches||[];return b.map(x=>'<label class="scl-att-branch"><input type="radio" name="sclBranch" value="'+esc(x.id)+'" style="margin-right:7px"> <b>'+esc(x.name)+'</b><br><small>'+esc(x.address)+'</small><br><small>Approved radius: '+esc(x.radius_m)+' m • '+(x.latitude==null?'GPS not configured':'GPS configured')+'</small></label>').join('')||'<div class="scl-att-warning">No active school branches are configured.</div>'}
  async function chooseBranchAndLocation(action){const box=document.getElementById('sclAttendanceBody');box.innerHTML='<div class="scl-att-warning">Loading approved school branches…</div>';const branches=await getBranches();const list=branches.branches||[];box.innerHTML='<div class="scl-att-card"><h4>'+(action==='in'?'Sign Attendance':'Sign Out')+'</h4><p>Select the branch you are physically at. SCL will request your phone location and will not accept the action outside the branch geofence.</p><div class="scl-att-branch-grid">'+list.map(x=>'<label class="scl-att-branch"><input type="radio" name="sclBranch" value="'+esc(x.id)+'" style="margin-right:7px"> <b>'+esc(x.name)+'</b><br><small>'+esc(x.address)+'</small><br><small>Approved radius: '+esc(x.radius_m)+' m • '+(x.latitude==null?'GPS NOT CONFIGURED':'GPS READY')+'</small></label>').join('')+'</div><div class="scl-att-actions"><button class="btn outline" onclick="sclOpenAttendance()" type="button">BACK</button><button class="btn red" onclick="sclContinueAttendance(\''+action+'\')" type="button">CONTINUE WITH PHONE LOCATION</button></div></div><div class="scl-att-passkey-note">Next step: the phone will prompt for its own biometric / passkey verification. SCL does not receive fingerprint or face data.</div>'}
  window.sclSignIn=()=>chooseBranchAndLocation('in');
  window.sclSignOut=()=>chooseBranchAndLocation('out');
  window.sclContinueAttendance=async function(action){const branch=document.querySelector('input[name="sclBranch"]:checked')?.value;if(!branch){toast('Choose the branch first.');return}try{const p=await requestLocation();const coords=p.coords;const accuracy=Number(coords.accuracy||0);if(!Number.isFinite(coords.latitude)||!Number.isFinite(coords.longitude))throw new Error('The phone did not return a usable location.');document.getElementById('sclAttendanceBody').innerHTML='<div class="scl-att-warning">Location captured. Please complete the phone biometric / passkey prompt…</div>';await passkeyVerify();const out=await attFetch(action==='in'?'sign_in':'sign_out','POST',{branch_id:branch,latitude:coords.latitude,longitude:coords.longitude,accuracy_m:accuracy,verification:'phone_passkey'});toast(action==='in'?'Attendance signed in successfully.':'Attendance signed out successfully.');renderSelfAttendance(out, false)}catch(e){document.getElementById('sclAttendanceBody').innerHTML='<div class="scl-att-error">'+esc(e.message||'Attendance could not be completed.')+'</div><div class="scl-att-actions"><button class="btn outline" onclick="sclOpenAttendance()" type="button">TRY AGAIN</button><button class="btn red" onclick="openWhatsAppChoices()" type="button">CONTACT TECHNICAL ADMIN</button></div>'}};
  window.sclMarkAbsent=async function(){const reason=prompt('Why will you be absent today?');if(!reason||reason.trim().length<5){toast('A reason is required.');return}const note=prompt('Supporting note (optional):')||'';try{await passkeyVerify();const out=await attFetch('mark_absent','POST',{reason:reason.trim(),note,verification:'phone_passkey'});toast('Absence recorded for administrator review.');renderSelfAttendance(out,false)}catch(e){toast(e.message||'Unable to record absence.')}};
  window.sclSubmitAppeal=async function(){const reason=document.getElementById('sclAppealReason')?.value.trim();const note=document.getElementById('sclAppealNote')?.value.trim()||'';if(!reason){toast('Enter the appeal reason.');return}try{await passkeyVerify();const d=await attFetch('my_attendance');const row=(d.records||[]).find(x=>x.status==='absent');await attFetch('appeal','POST',{staff_attendance_id:row?.id||null,attendance_date:row?.attendance_date||new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'}),reason,supporting_note:note});toast('Attendance appeal submitted.');sclOpenAttendance()}catch(e){toast(e.message||'Unable to submit appeal.')}};
  async function renderAdminAttendance(){const d=await attFetch('admin_attendance','POST',{start_date:new Date(Date.now()-35*86400000).toISOString().slice(0,10)});let notices=[];try{notices=(await attFetch('admin_notifications','POST',{limit:30})).notifications||[]}catch(_){}const rows=d.records||[],sum=d.summaries||{};let html='<div class="scl-att-card"><h4>ADMIN ATTENDANCE REGISTER</h4><p>All authorised administrators can review staff attendance, branch, GPS distance, sign-in/out times and four-week attendance percentage.</p><div class="scl-att-card" style="margin-top:10px;background:#fffaf0"><h4>ATTENDANCE NOTICES FOR ADMINS</h4>'+(notices.length?notices.map(n=>'<div style="padding:9px 0;border-bottom:1px solid #ead5b6"><b>'+esc(n.title)+'</b><br><small>'+esc(n.body)+'</small><br><small>'+esc(new Date(n.created_at).toLocaleString('en-NG'))+'</small></div>').join(''):'<div>No new attendance notices.</div>')+'</div><div class="scl-att-actions"><button class="btn gold" onclick="sclOpenBranchAdmin()" type="button">📍 MANAGE BRANCH GPS</button><button class="btn outline" onclick="sclOpenAttendance(\'admin\')" type="button">REFRESH</button></div></div><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Staff / Employment</th><th>Date</th><th>Status</th><th>Branch</th><th>Sign In</th><th>Sign Out</th><th>4-Week %</th><th>Salary Review</th></tr></thead><tbody>'+(rows.map(r=>{const s=sum[r.auth_user_id]||{};return '<tr><td><b>'+esc(r.staff?.full_name||'Staff')+'</b><br><small>'+esc(r.staff?.role||'')+' • '+esc(r.staff?.employment_mode||r.staff?.employment_status||'Employment mode not set')+'</small></td><td>'+formatDate(r.attendance_date)+'</td><td>'+esc(r.status)+'</td><td>'+esc(r.school_branches?.name||'')+'<br><small>'+esc(r.school_branches?.address||'')+'</small></td><td>'+esc(r.sign_in_at?new Date(r.sign_in_at).toLocaleTimeString('en-NG'):'—')+'<br><small>'+esc(r.sign_in_distance_m!=null?Math.round(r.sign_in_distance_m)+' m':'')+'</small></td><td>'+esc(r.sign_out_at?new Date(r.sign_out_at).toLocaleTimeString('en-NG'):'—')+'<br><small>'+esc(r.sign_out_status||'')+'</small></td><td class="'+(s.meets_90_percent?'scl-att-green':'scl-att-red')+'"><b>'+pct(s.attendance_percent)+'</b></td><td>'+(s.meets_90_percent?'MEETS 90%':'APPEAL / REVIEW')+'</td></tr>'}).join('')||'<tr><td colspan="8">No staff attendance records found.</td></tr>')+'</tbody></table></div>';
    html+='<div class="scl-att-card"><h4>Attendance Rule</h4><p><b>90% attendance over the rolling four-week window</b> is the salary/payment review threshold requested for SCL. Staff below the threshold can submit an appeal; administrators make the final payment decision.</p></div>';document.getElementById('sclAttendanceBody').innerHTML=html}
  window.sclOpenBranchAdmin=async function(){open('sclBranchAdminModal');const box=document.getElementById('sclBranchAdminBody');box.innerHTML='<div class="scl-att-warning">Loading branches…</div>';try{const d=await getBranches();const branches=d.branches||[];box.innerHTML='<div class="scl-att-card"><h4>Approved SCL Branches</h4><p>Each branch must have its exact GPS coordinates before staff attendance can be accepted there. An administrator can stand at the physical school location and capture the phone GPS for that branch.</p><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Branch</th><th>Address</th><th>GPS</th><th>Radius</th><th>Action</th></tr></thead><tbody>'+branches.map(b=>'<tr><td><b>'+esc(b.name)+'</b></td><td>'+esc(b.address)+'</td><td>'+esc(b.latitude!=null?Number(b.latitude).toFixed(6)+', '+Number(b.longitude).toFixed(6):'NOT SET')+'</td><td>'+esc(b.radius_m)+' m</td><td><button class="btn gold" type="button" onclick="sclCaptureBranchGPS(\''+esc(b.id)+'\')">CAPTURE CURRENT GPS</button></td></tr>').join('')+'</tbody></table></div></div><div class="scl-att-card"><h4>Add another branch</h4><input id="sclNewBranchName" placeholder="Branch name" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px"><input id="sclNewBranchAddress" placeholder="Full branch address" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px;margin-top:8px"><input id="sclNewBranchRadius" type="number" min="25" max="1000" value="150" placeholder="Geofence radius in metres" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d9c5aa;border-radius:9px;margin-top:8px"><div class="scl-att-actions"><button class="btn red" onclick="sclAddBranch()" type="button">ADD BRANCH</button></div></div>'}catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}};
  window.sclCaptureBranchGPS=async function(id){try{const p=await requestLocation();const c=p.coords;await attFetch('branches','PATCH',{id,latitude:c.latitude,longitude:c.longitude});toast('Exact branch GPS saved.');sclOpenBranchAdmin()}catch(e){toast(e.message||'Unable to capture branch GPS.')}};
  window.sclAddBranch=async function(){const name=document.getElementById('sclNewBranchName')?.value.trim(),address=document.getElementById('sclNewBranchAddress')?.value.trim(),radius=Number(document.getElementById('sclNewBranchRadius')?.value||150);if(!name||!address){toast('Branch name and address are required.');return}try{await attFetch('branches','POST',{name,address,radius_m:radius});toast('Branch added. Capture its GPS while physically at the branch.');sclOpenBranchAdmin()}catch(e){toast(e.message||'Unable to add branch.')}};
  // Replace the old profile button behaviour while preserving the existing login flow.
  const oldLogin=window.login;window.login=function(){const a=auth();if(a&&a.accessToken){window.sclOpenModernProfile()}else{oldLogin()}};
  // Replace the old login submission with a Supabase Auth fallback when the legacy /api route is not present.
  const oldSclLogin=window.sclLogin;window.sclLogin=async function(e){e.preventDefault();const email=document.getElementById('sclLoginEmail').value.trim(),password=document.getElementById('sclLoginPassword').value,box=document.getElementById('sclLoginStatus');box.classList.remove('hidden');box.textContent='Authenticating with SCL…';try{const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});if(r.ok){const d=await r.json();sessionStorage.setItem('sclAuthSession',JSON.stringify(d));closeM('loginModal');window.sclOpenModernProfile();return} }catch(_){} try{const {data,error}=await window.sclSupabase.auth.signInWithPassword({email,password});if(error)throw error;const s=data.session,u=data.user;const base={accessToken:s.access_token,refreshToken:s.refresh_token,user:u,roles:[],permissions:[]};sessionStorage.setItem('sclAuthSession',JSON.stringify(base));const profile=await getProfile();base.roles=profile.roles||[];base.permissions=[];base.profile=profile.profile||null;base.staff=profile.staff||null;base.student=profile.student||null;sessionStorage.setItem('sclAuthSession',JSON.stringify(base));closeM('loginModal');window.sclOpenModernProfile();toast('SCL login successful.')}catch(err){box.textContent=err.message||'Unable to sign in.';box.classList.add('statusbox')}};
})();
</script>
<script id="scl-community-destination-handoff-v1">
(function(){
  const oldLoad=window.sclLoadCommunity;
  function renderDestinations(){const box=document.getElementById('sclAdminSocialDestinations');const data=window.sclCommunityData||{};if(!box)return;const list=data.destinations||[];box.innerHTML=list.length?list.map(x=>'<label style="display:block;margin-top:6px"><input type="checkbox" class="scl-social-target" value="'+String(x.id).replace(/"/g,'&quot;')+'" checked> '+String(x.name).replace(/</g,'&lt;')+' — '+String(x.platform).replace(/</g,'&lt;')+'</label>').join(''):'<small>No other destinations configured.</small>'}
  async function refresh(){try{const d=await oldLoad();setTimeout(renderDestinations,0);return d}catch(e){setTimeout(renderDestinations,0);throw e}}
  window.sclLoadCommunity=refresh;
  window.sclPrepareSelectedDestinations=function(item){const data=window.sclCommunityData||{};const wa=(data.whatsapp_groups||[]).filter(x=>document.querySelector('.scl-wa-target[value="'+x.id+'"]:checked'));const other=(data.destinations||[]).filter(x=>document.querySelector('.scl-social-target[value="'+x.id+'"]:checked'));const url=location.origin+location.pathname+'?scl_announcement='+encodeURIComponent(item.id||'');const message="Hi, I'm messaging from the NOTICE.\n\nThis is an announcement from the official SCL website, and I am messaging from the official website.\n\n"+(item.title||item.name||'SCL Notice')+'\n'+(item.body||item.description||'')+'\n\nRead the full post on the SCL website: '+url;window.sclWhatsAppDraftTargets=[...wa.map(x=>({name:x.name,url:x.invite_url,platform:'WhatsApp'})),...other.map(x=>({name:x.name,url:x.url,platform:x.platform}))];const ta=document.getElementById('sclWhatsAppDraftText');if(ta)ta.value=message;const targets=document.getElementById('sclWhatsAppDraftTargets');if(targets)targets.innerHTML=window.sclWhatsAppDraftTargets.length?'<b>Selected destination:</b> '+window.sclWhatsAppDraftTargets.map(x=>x.name+' ('+x.platform+')').join(', '):'<span style="color:#9b1c1c">No destination selected. Select a WhatsApp group or other social/group destination first.</span>';open('sclWhatsAppDraftModal');};
  window.sclCopyWhatsAppDraft=function(){const ta=document.getElementById('sclWhatsAppDraftText');if(!ta)return;const msg=ta.value;try{navigator.clipboard?.writeText(msg).then(()=>toast('Draft copied. Edit it if needed, then post it in the opened destination.')).catch(()=>{ta.select();document.execCommand('copy');toast('Draft copied.');});}catch(_){ta.select();try{document.execCommand('copy')}catch(__){}toast('Draft ready to copy.')}};
  window.sclOpenWhatsAppDraftDestination=function(){const targets=window.sclWhatsAppDraftTargets||[];if(!targets.length){toast('Select at least one destination first.');return}const t=targets[0];window.open(t.url,'_blank','noopener,noreferrer');toast('Destination opened. Paste or edit the draft, then post it yourself.');};
  // Give the admin an explicit multi-destination handoff button.
  const observer=new MutationObserver(()=>{const p=document.getElementById('sclCommunityAdminPanel');if(!p||p.classList.contains('hidden')||p.dataset.handoff==='1')return;p.dataset.handoff='1';const row=document.createElement('div');row.className='scl-admin-actions-row';row.innerHTML='<button class="btn red" type="button" id="sclPrepareLastPostBtn">📤 PREPARE / TRANSFER POST TO SELECTED DESTINATIONS</button><small style="display:block;width:100%;color:#6d6259">You can add as many destinations as you need. SCL prepares an editable Notice message first. Review or add your message, copy it, then open the selected destination and post it yourself.</small>';p.appendChild(row);document.getElementById('sclPrepareLastPostBtn').onclick=()=>{const a=window.sclCommunityData?.announcements||[],acts=window.sclCommunityData?.activities||[];const item=a[0]||acts[0];if(!item){toast('Publish a post first.');return}window.sclPrepareSelectedDestinations(item)}});observer.observe(document.body,{childList:true,subtree:true});
})();
</script>
<script id="scl-notice-ui-fix-v1">
(function(){
  window.openSclNotice=function(){if(typeof window.openSclAlerts==='function')return window.openSclAlerts();const m=document.getElementById('sclAlertsModal');if(!m)return;m.classList.add('open');m.style.display='flex';m.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')};
  window.openSclAlerts=window.openSclAlerts||window.openSclNotice;
  function sync(){const desktop=document.getElementById('sclAlertBell'),mobile=document.getElementById('sclAlertBellMobile');[desktop,mobile].forEach(b=>{if(b){b.setAttribute('aria-label','Open SCL notice');b.title='Notice';const l=b.querySelector('.scl-bell-label');if(l)l.textContent='NOTICE'}})}
  document.addEventListener('DOMContentLoaded',sync);sync();
})();
</script>
<script id="scl-v37-calendar-attendance-notice-fix">
(function(){
  'use strict';
  function todayKey(){return new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'});}
  function setButton(label,mode,disabled){const b=document.getElementById('sclCalendarAttendanceButton');if(!b)return;b.textContent=label;b.classList.toggle('signed-in',mode==='signed-in');b.classList.toggle('completed',mode==='completed');b.disabled=!!disabled;}
  function getSclAuth(){try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}}
  async function calendarAttendanceFetch(action){const a=getSclAuth();if(!a?.accessToken)throw new Error('Authentication required.');const r=await fetch((window.SCL_SUPABASE_URL||'')+'/functions/v1/scl-attendance?action='+encodeURIComponent(action),{headers:{'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY||window.SCL_SUPABASE_ANON_KEY||'', 'Authorization':'Bearer '+a.accessToken}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Attendance service request failed.');return d}
  window.sclSyncCalendarAttendanceButton=async function(){
    const b=document.getElementById('sclCalendarAttendanceButton');if(!b)return;
    setButton('SIGN IN ATTENDANCE TODAY','',false);
    try{
      const a=getSclAuth();
      if(!a?.accessToken)return;
      const d=await calendarAttendanceFetch('my_attendance');
      const rec=(d.records||[]).find(x=>x.attendance_date===todayKey());
      if(rec?.status==='present'&&rec.sign_in_at&&!rec.sign_out_at){setButton('SIGN OUT ATTENDANCE TODAY','signed-in',false);}
      else if(rec?.sign_out_at&&rec.sign_out_status==='valid'){setButton('ATTENDANCE COMPLETED TODAY','completed',true);}
    }catch(_){}
  };
  window.sclCalendarAttendanceAction=function(){
    const a=getSclAuth();
    if(!a?.accessToken){toast('Please log in with your SCL staff account to sign attendance.');login();return;}
    if(typeof window.sclOpenAttendance==='function')window.sclOpenAttendance();
  };
  function init(){sclSyncCalendarAttendanceButton();setInterval(sclSyncCalendarAttendanceButton,15000);window.addEventListener('focus',sclSyncCalendarAttendanceButton);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="scl-master-registration-promotion-v1">
(function(){
  const CLASS_FLOW={"Daycare":"Nursery 1","Nursery 1":"Nursery 2","Nursery 2":"Reception","Reception":"Primary 1","Primary 1":"Primary 2","Primary 2":"Primary 3","Primary 3":"Primary 4","Primary 4":"Primary 5","Primary 5":"JSS 1","JSS 1":"JSS 2","JSS 2":"JSS 3","JSS 3":"SSS 1","SSS 1":"SSS 2","SSS 2":"SSS 3","SSS 3":"SSS 3"};
  window.sclRegistrationMode=function(mode){
    const n=document.getElementById('sclNewStudentRegistration'),r=document.getElementById('sclReturningStudentRegistration');
    const tn=document.getElementById('sclRegTabNew'),tr=document.getElementById('sclRegTabReturning');
    const isNew=mode!=='returning'; n?.classList.toggle('hidden',!isNew);r?.classList.toggle('hidden',isNew);tn?.classList.toggle('active',isNew);tr?.classList.toggle('active',!isNew);
  };
  window.sclUpdateRegistrationAge=function(){
    const dob=document.getElementById('regDob'),out=document.getElementById('regAgeDisplay');if(!dob||!out)return;
    if(!dob.value){out.textContent='Select the date of birth';return}
    const d=new Date(dob.value+'T00:00:00'),now=new Date();
    if(Number.isNaN(d.getTime())||d>now){out.textContent='Invalid date of birth';return}
    let years=now.getFullYear()-d.getFullYear(),months=now.getMonth()-d.getMonth(),days=now.getDate()-d.getDate();
    if(days<0){months--;days+=new Date(now.getFullYear(),now.getMonth(),0).getDate()}
    if(months<0){years--;months+=12}
    out.textContent=years+' year'+(years===1?'':'s')+(months?' '+months+' month'+(months===1?'':'s'):'');
  };
  function syncFullName(){const f=document.querySelector('[name="firstName"]')?.value.trim()||'',m=document.querySelector('[name="middleName"]')?.value.trim()||'',s=document.querySelector('[name="surname"]')?.value.trim()||'';const x=[f,m,s].filter(Boolean).join(' ');const out=document.getElementById('regChildFullName');if(out)out.value=x}
  document.addEventListener('input',e=>{if(['firstName','middleName','surname'].includes(e.target?.name))syncFullName()});
  document.addEventListener('DOMContentLoaded',()=>{const today=new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'});const d=document.getElementById('regAdmissionDate');if(d&&!d.value)d.value=today;const dob=document.getElementById('regDob');if(dob){dob.max=today;dob.addEventListener('input',sclUpdateRegistrationAge);sclUpdateRegistrationAge()}sclRegistrationMode('new')});
  async function promoApi(action,payload){
    const base=window.SCL_SUPABASE_URL?window.SCL_SUPABASE_URL+'/functions/v1/scl-public-api':'';if(!base)throw new Error('SCL backend address is not configured.');
    const key=window.SCL_SUPABASE_ANON_KEY||window.SCL_SUPABASE_PUBLISHABLE_KEY||'';const res=await fetch(base+'?action='+encodeURIComponent(action),{method:'POST',headers:{'Content-Type':'application/json','apikey':key},body:JSON.stringify({action,...payload})});const d=await res.json().catch(()=>({error:'Invalid server response.'}));if(!res.ok||d.error)throw new Error(d.error||'Request failed.');return d;
  }
  window.sclVerifyReturningStudent=async function(){
    const sid=document.getElementById('promoStudentId')?.value.trim(),email=document.getElementById('promoParentEmail')?.value.trim();const status=document.getElementById('promoVerifyStatus');if(!sid||!email){toast('Enter the Student ID and parent/guardian email first.');return}
    status.classList.remove('hidden');status.textContent='Verifying the student academic record…';
    try{const d=await promoApi('promotion_lookup',{studentId:sid,parentEmail:email});document.getElementById('promoPreviousClass').value=d.student.class_name||'';document.getElementById('promoAcademicStatus').value=d.academic_status||'PENDING ACADEMIC REVIEW';document.getElementById('promoStudentName').value=d.student.child_name||'';document.getElementById('promoAdmissionNumber').value=d.student.student_id||sid;document.getElementById('promoCurrentClass').value=d.student.class_name||'';document.getElementById('promoStatusReadout').value=d.academic_status||'PENDING ACADEMIC REVIEW';
      const target=document.getElementById('promoTargetClass');target.innerHTML='';const recommended=d.recommended_class||CLASS_FLOW[d.student.class_name]||d.student.class_name;[d.student.class_name,recommended].filter((x,i,a)=>x&&a.indexOf(x)===i).forEach(x=>target.insertAdjacentHTML('beforeend','<option value="'+x.replace(/"/g,'&quot;')+'">'+x+'</option>'));target.value=recommended;
      document.getElementById('promoDetails').classList.remove('hidden');document.getElementById('promoChoiceSection').classList.remove('hidden');document.getElementById('promoRepeatNotice').classList.toggle('hidden',d.academic_status!=='FAILED'&&d.academic_status!=='RECOMMENDED TO REPEAT');document.getElementById('promoClearanceStatus').value=d.academic_status==='FAILED'?'ADMIN CLEARANCE REQUIRED':'NOT REQUIRED';status.textContent='Student record verified. Review the recommendation before submitting.';
    }catch(e){status.textContent=e.message||'Unable to verify student record.';status.classList.add('statusbox')}
  };
  window.sclToggleDoublePromotion=function(){const on=document.getElementById('promoDoublePromotion')?.checked;document.getElementById('promoDoubleBox')?.classList.toggle('hidden',!on);if(on){document.getElementById('promoClearanceStatus').value='PENDING ADMIN VERIFICATION'}else{const failed=document.getElementById('promoAcademicStatus')?.value==='FAILED';document.getElementById('promoClearanceStatus').value=failed?'ADMIN CLEARANCE REQUIRED':'NOT REQUIRED'}};
  window.sclSubmitPromotion=async function(e){e?.preventDefault();const sid=document.getElementById('promoStudentId')?.value.trim(),email=document.getElementById('promoParentEmail')?.value.trim(),target=document.getElementById('promoTargetClass')?.value,doublePromo=document.getElementById('promoDoublePromotion')?.checked||false,reason=document.getElementById('promoDoubleReason')?.value.trim()||'';if(!sid||!email||!target){toast('Verify the student and select the class before submitting.');return}if(doublePromo&&!reason){toast('Provide the double-promotion reason or application reference.');return}try{const d=await promoApi('promotion_submit',{studentId:sid,parentEmail:email,toClass:target,doublePromotion:doublePromo,reason});toast(d.message||'Class registration submitted.');closeM('reg');openFees(target)}catch(e){toast(e.message||'Unable to submit class registration.')}};
  const form=document.getElementById('form');
  if(form){form.addEventListener('submit',async function(e){
    e.preventDefault(); e.stopImmediatePropagation();syncFullName();const choice=document.querySelector('input[name="academicEmailStatus"]:checked')?.value,generated=document.getElementById('regOfficialAcademicEmail')?.value.trim();if(choice==='create'&&!generated){toast('Please create the official academic email before submitting this registration.');return}
    const fd=new FormData(form),d={};for(const [k,v] of fd.entries()){if(k==='age')continue;if(v instanceof File)d[k]=v.name;else d[k]=v}d.childName=document.getElementById('regChildFullName')?.value.trim();d.date=new Date().toISOString();d.session=typeof sessionLabel==='function'?sessionLabel():'2026/2027';d.term=typeof currentTerm==='function'?currentTerm():'First Term';
    /* Parent/Guardian workflow handoff: one account may register/associate any number of children. */
    if(window.__sclParentChildRelationship){d.relationship=window.__sclParentChildRelationship;d.parentRelationship=window.__sclParentChildRelationship;}
    if(window.__sclParentChildPhone){d.parentPhone=window.__sclParentChildPhone;d.parent_phone=window.__sclParentChildPhone;}
    if(window.__sclParentChildEmail){d.parentEmail=window.__sclParentChildEmail;d.parent_email=window.__sclParentChildEmail;}
    const authNow=typeof auth==='function'?auth():null;if(authNow?.user?.email){d.parentEmail=d.parentEmail||authNow.user.email;d.parent_email=d.parent_email||authNow.user.email;}
    if(window.__sclParentChildRelationship==='Guardian')d.guardianName=authNow?.profile?.full_name||authNow?.user?.user_metadata?.full_name||d.guardianName||'';
    const files=['childPhoto','parentPhoto','birthCertificate','previousResult'];for(const k of files){const f=form.elements[k]?.files?.[0];if(f){try{d[k+'Data']=await fileToDataURL(f)}catch(_){}}}
    let saved=null;try{saved=await api('/api/registrations',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)})}catch(_){}
    if(!saved){d.status='New';d.registrationId='REG-'+Date.now();d.studentId=d.studentId||'LOCAL-'+Date.now();d.accessPin=d.accessPin||'123456';try{localStorage.setItem('lastRegistration',JSON.stringify(d))}catch(_){}saved=d;toast('Registration saved on this device. Connect the SCL backend to make it official.')}else toast('Registration submitted successfully.');
    window.__sclParentChildRelationship='';window.__sclParentChildPhone='';window.__sclParentChildEmail='';
    closeM('reg');if(saved&&saved.studentId){try{document.dispatchEvent(new CustomEvent('scl:student-registered',{detail:{studentId:saved.studentId,className:saved.class||d.class||selectedClass}}))}catch(_){}alert('Registration successful.\nStudent ID: '+saved.studentId+'\nResult PIN: '+saved.accessPin+(saved.officialAcademicEmail?'\nOfficial Academic Email: '+saved.officialAcademicEmail:''));openFees(saved.class||d.class||selectedClass)}
  },true)}
})();
</script>
<style id="scl-v38-attendance-frontbar-css">
.scl-v33-tools{grid-template-columns:repeat(4,minmax(0,1fr))!important}
.scl-v33-tool.attendance{background:linear-gradient(135deg,#126b3a,#0a4f2a);color:#fff;border-color:#126b3a}
.scl-v33-tool.attendance .tool-sub{color:#eafff1}
.scl-v38-attendance-form{display:grid;gap:12px}
.scl-v38-attendance-periods{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.scl-v38-period{border:2px solid #ead5b6;border-radius:14px;padding:13px;background:#fff;cursor:pointer}
.scl-v38-period.selected{border-color:#126b3a;background:#eefaf2}
.scl-v38-period b{display:block;color:#650007;font-size:15px}.scl-v38-period small{display:block;margin-top:4px;color:#66574a}
.scl-v38-device-note{padding:12px;border-radius:12px;background:#eef4ff;border:1px solid #b9cbed;color:#23467c;font-size:12px}
@media(max-width:700px){.scl-v33-tools{grid-template-columns:1fr 1fr!important}.scl-v38-attendance-periods{grid-template-columns:1fr}.heroimg{width:48%;}}
</style>
<script id="scl-v38-attendance-flow">
(function(){
  const ATT=window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance';
  const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const auth=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}};
  const token=()=>auth()?.accessToken||'';
  async function af(action,method='GET',body=null){const h={'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+token(),'Content-Type':'application/json'};const r=await fetch(ATT+'?action='+encodeURIComponent(action),{method,headers:h,body:body?JSON.stringify(body):undefined});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Attendance service request failed.');return d}
  function openModal(){const m=document.getElementById('sclAttendanceModal');if(!m)return;m.classList.add('open');m.style.display='flex';m.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}
  function today(){return new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'})}
  function nowMinutes(){const p=new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Lagos',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());const h=Number(p.find(x=>x.type==='hour')?.value||0),m=Number(p.find(x=>x.type==='minute')?.value||0);return h*60+m}
  function periodAllowed(period){const m=nowMinutes();return period==='morning'?(m>=465&&m<=719):(m>=720&&m<=900)}
  function periodLabel(p){return p==='morning'?'Morning (7:00 AM – 11:59 AM)':'Afternoon (12:00 PM – 4:00 PM)'}
  async function branches(){const r=await af('branches');return r.branches||[]}
  function renderForm(d,rec){
    const box=document.getElementById('sclAttendanceBody');
    const signedIn=!!(rec?.sign_in_at&&!rec?.sign_out_at),complete=!!(rec?.sign_out_at&&rec?.sign_out_status==='valid');
    if(complete){box.innerHTML='<div class="scl-att-card"><h4>ATTENDANCE COMPLETED TODAY</h4><div class="scl-att-success">Sign-in: '+esc(new Date(rec.sign_in_at).toLocaleTimeString('en-NG'))+' • Sign-out: '+esc(new Date(rec.sign_out_at).toLocaleTimeString('en-NG'))+' • '+esc(rec.attendance_period||'Attendance')+'</div></div>';return;}
    const isOut=signedIn;
    const bs=d.branches||[];
    box.innerHTML='<div class="scl-att-card"><h4>'+(isOut?'SIGN OUT ATTENDANCE TODAY':'SIGN IN ATTENDANCE TODAY')+'</h4><p><b>Attendance is for every SCL teacher and staff member, full-time and part-time.</b></p><div class="scl-v38-attendance-form">'+
      '<label class="field"><span>Staff Username *</span><input id="sclV38Username" autocomplete="username" placeholder="Enter the username used for your SCL login" required></label>'+
      (isOut?'':'<div><b>Attendance Period *</b><div class="scl-v38-attendance-periods"><label class="scl-v38-period"><input type="radio" name="sclV38Period" value="morning" style="margin-right:7px"><b>🌅 MORNING</b><small>7:00 AM to 11:59 AM</small></label><label class="scl-v38-period"><input type="radio" name="sclV38Period" value="afternoon" style="margin-right:7px"><b>☀️ AFTERNOON</b><small>12:00 PM to 4:00 PM</small></label></div></div>')+
      '<div><b>School Location *</b><div class="scl-att-branch-grid">'+(bs.length?bs.map(x=>'<label class="scl-att-branch"><input type="radio" name="sclV38Branch" value="'+esc(x.id)+'" style="margin-right:7px"><b>'+esc(x.name)+'</b><br><small>'+esc(x.address)+'</small><br><small>Approved radius: '+esc(x.radius_m)+' m • '+(x.latitude==null?'GPS NOT CONFIGURED':'GPS READY')+'</small></label>').join(''):'<div class="scl-att-warning">No active school branch is configured yet.</div>')+'</div></div>'+ 
      '<div class="scl-v38-device-note"><b>Biometrics / Face Verification</b><br>Your phone may use its registered fingerprint, face unlock or other device passkey. SCL does <b>not</b> receive or store your fingerprint, face image or biometric template. The device only confirms your registered credential.</div>'+ 
      '<div id="sclV38FlowStatus"></div><div class="scl-att-actions"><button class="btn outline" type="button" onclick="closeM(\'sclAttendanceModal\')">CANCEL</button><button id="sclV41AttendanceSubmit" class="btn red" type="button" disabled onclick="sclV38EnterAttendance(\''+(isOut?'out':'in')+'\')">'+(isOut?'🔴 ENTER SIGN OUT':'🟢 ENTER ATTENDANCE')+'</button></div></div></div>'+
      '<div class="scl-att-card"><h4>What happens next?</h4><div class="scl-att-location">1. Enter your staff username. 2. Select Morning or Afternoon for sign-in. 3. Select the school branch where you are physically present. 4. Tap Enter Attendance. 5. If you are not logged in, SCL will ask you to log in only at this point. 6. Your device will then perform its secure biometric/face/passkey verification. 7. GPS and the exact sign-in/sign-out time are recorded.</div></div>';
  }
  window.sclV38EnterAttendance=async function(action){
    const username=document.getElementById('sclV38Username')?.value.trim();
    const branch=document.querySelector('input[name="sclV38Branch"]:checked')?.value;
    const period=document.querySelector('input[name="sclV38Period"]:checked')?.value||'';
    const status=document.getElementById('sclV38FlowStatus');
    if(!username){toast('Enter your staff username first.');return}
    if(!branch){toast('Select the school location first.');return}
    if(action==='in'&&!period){toast('Select Morning or Afternoon attendance.');return}
    if(action==='in'&&!periodAllowed(period)){toast(period==='morning'?'Morning attendance is available from 7:00 AM to 11:59 AM.':'Afternoon attendance is available from 12:00 PM to 4:00 PM.');return}
    const a=auth();
    if(!a?.accessToken){window.__sclAttendancePending={action,username,branch,period};openM('loginModal');return}
    const loginEmail=String(a.user?.email||a.profile?.email||'').trim().toLowerCase();
    if(loginEmail&&username.toLowerCase()!==loginEmail){toast('That username does not match the SCL account currently logged in.');return}
    await window.sclV38FinishAttendance({action,username,branch,period});
  };
  window.sclV38FinishAttendance=async function(x){
    const status=document.getElementById('sclV38FlowStatus');if(status)status.innerHTML='<div class="scl-att-warning">Checking your school location…</div>';
    try{
      if(x.action==='in'&&!periodAllowed(x.period))throw new Error(x.period==='morning'?'Morning attendance is available from 7:00 AM to 11:59 AM.':'Afternoon attendance is available from 12:00 PM to 4:00 PM.');
      const pos=await new Promise((resolve,reject)=>navigator.geolocation?.getCurrentPosition(resolve,reject,{enableHighAccuracy:true,maximumAge:0,timeout:15000})||reject(new Error('This device does not provide GPS location.')));
      const c=pos.coords, accuracy=Number(c.accuracy||0);if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude))throw new Error('The device did not return a usable GPS location.');
      if(status)status.innerHTML='<div class="scl-att-warning">Location confirmed. Now complete your device biometric / face verification…</div>';
      const sb=window.sclSupabase;
      if(!sb?.auth?.signInWithPasskey)throw new Error('Device biometric / face verification is not available in this browser or SCL production authentication has not been configured for this website origin yet.');
      const pk=await sb.auth.signInWithPasskey();if(pk?.error)throw pk.error;
      if(pk?.data?.session){const cur=auth()||{};sessionStorage.setItem('sclAuthSession',JSON.stringify({...cur,accessToken:pk.data.session.access_token,refreshToken:pk.data.session.refresh_token,user:pk.data.user||cur.user}));}
      const out=await af(x.action==='in'?'sign_in':'sign_out','POST',{branch_id:x.branch,latitude:c.latitude,longitude:c.longitude,accuracy_m:accuracy,verification:'device_biometric_face_passkey',staff_username:x.username,attendance_period:x.period});
      toast(x.action==='in'?'Attendance signed in successfully.':'Attendance signed out successfully.');
      if(x.action==='in'){document.getElementById('sclAttendanceBody').innerHTML='<div class="scl-att-card"><h4>SUCCESSFUL SIGN-IN</h4><div class="scl-att-success">You are signed in for '+esc(x.period==='morning'?'Morning':'Afternoon')+' attendance. Sign-in time: '+esc(new Date(out.record.sign_in_at).toLocaleTimeString('en-NG'))+'. The button will now show Sign Out Attendance.</div><div class="scl-att-actions"><button class="btn red" onclick="sclOpenAttendance()" type="button">🔴 SIGN OUT ATTENDANCE</button></div></div>';}
      else{window.sclOpenAttendance();}
      window.sclCalendarAttendanceSync?.(); window.sclAttendanceStatusSync?.(out.record);
    }catch(e){if(status)status.innerHTML='<div class="scl-att-error">'+esc(e.message||'Attendance could not be completed.')+'</div>'}
  };
  const originalOpen=window.sclOpenAttendance;
  window.sclOpenAttendance=async function(mode='self'){
    if(mode==='admin' || mode==='appeal'){return originalOpen(mode)}
    openModal();const box=document.getElementById('sclAttendanceBody');box.innerHTML='<div class="scl-att-warning">Preparing today\'s attendance form…</div>';
    try{const b=await af('branches');let todayRec=null;if(auth()?.accessToken){try{const d=await af('my_attendance');todayRec=(d.records||[]).find(r=>r.attendance_date===today())||null}catch(_){} }renderForm(b,todayRec);window.sclAttendanceStatusSync?.(todayRec)}catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}
  };
  window.sclCalendarAttendanceAction=function(){window.sclOpenAttendance();};
  window.sclCalendarAttendanceSync=async function(){try{const b=document.getElementById('sclCalendarAttendanceButton');if(!b)return;const a=auth();if(!a?.accessToken){b.textContent='SIGN IN ATTENDANCE TODAY';return}const d=await af('my_attendance');const rec=(d.records||[]).find(r=>r.attendance_date===today());b.textContent=rec?.sign_in_at&&!rec?.sign_out_at?'SIGN OUT ATTENDANCE TODAY':rec?.sign_out_at?'ATTENDANCE COMPLETED TODAY':'SIGN IN ATTENDANCE TODAY'}catch(_){} };
  // Resume the exact attendance form after login, rather than requiring the user to restart it.
  window.sclV38ResumeAfterLogin=async function(){const x=window.__sclAttendancePending;if(!x)return;window.__sclAttendancePending=null;closeM('loginModal');await window.sclV38FinishAttendance(x)};
  const oldLogin=window.sclLogin;
  window.sclLogin=async function(e){
    if(!window.__sclAttendancePending){return oldLogin(e)}
    e.preventDefault();const email=document.getElementById('sclLoginEmail').value.trim();const password=document.getElementById('sclLoginPassword').value;const box=document.getElementById('sclLoginStatus');box.classList.remove('hidden');box.textContent='Authenticating with SCL…';
    try{const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Login failed.');sessionStorage.setItem('sclAuthSession',JSON.stringify(d));closeM('loginModal');toast('SCL login successful. Continuing attendance…');await window.sclV38ResumeAfterLogin();}
    catch(err){box.textContent=err.message||'Unable to sign in.';box.classList.add('statusbox')}
  };
  window.sclAttendanceStatusSync=async function(rec){
    try{
      const tile=document.getElementById('sclV38AttendanceButton');
      const badge=document.getElementById('sclAttendanceStatusBadge');
      if(!tile||!badge)return;
      let r=rec;
      if(!r && auth()?.accessToken){try{const d=await af('my_attendance');r=(d.records||[]).find(x=>x.attendance_date===today())||null}catch(_){}
      }
      const signedIn=!!(r?.sign_in_at&&!r?.sign_out_at), complete=!!(r?.sign_out_at&&r?.sign_out_status==='valid');
      badge.textContent=complete?'COMPLETED':signedIn?'SIGNED IN':'READY';
      badge.dataset.state=complete?'complete':signedIn?'active':'ready';
      tile.setAttribute('aria-label','Staff Attendance — '+badge.textContent);
    }catch(_){}
  };
  document.addEventListener('DOMContentLoaded',()=>{window.sclCalendarAttendanceSync();window.sclAttendanceStatusSync?.();});
})();
</script>
<style id="scl-v39-modern-ui">
/* V39: color-coded sections and modern controls. Existing functions/layout remain unchanged. */
:root{--scl-blue:#2563eb;--scl-green:#16a34a;--scl-purple:#7c3aed;--scl-orange:#ea580c;--scl-gold:#d99a00;--scl-teal:#0f766e;--scl-pink:#db2777;--scl-red:#b91c1c;--scl-navy:#1e3a8a}
.scl-v39-frontbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0}
.scl-v39-frontbar .scl-v39-service{border:0;border-radius:16px;padding:15px 12px;min-height:78px;color:#fff;font-weight:800;box-shadow:0 7px 18px rgba(0,0,0,.12);transition:transform .18s ease,box-shadow .18s ease;cursor:pointer}
.scl-v39-frontbar .scl-v39-service:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(0,0,0,.16)}
.scl-v39-frontbar .attendance{background:linear-gradient(135deg,#15803d,#22c55e)}.scl-v39-frontbar .fees{background:linear-gradient(135deg,#1d4ed8,#3b82f6)}.scl-v39-frontbar .email{background:linear-gradient(135deg,#6d28d9,#8b5cf6)}.scl-v39-frontbar .curriculum{background:linear-gradient(135deg,#b77900,#eab308)}
/* Existing quick-service cards receive unique identities. */
.quick button{position:relative;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.quick button:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.10)}
.quick button:nth-child(1){border-color:#93c5fd;background:linear-gradient(180deg,#eff6ff,#fff)}.quick button:nth-child(2){border-color:#86efac;background:linear-gradient(180deg,#f0fdf4,#fff)}.quick button:nth-child(3){border-color:#c4b5fd;background:linear-gradient(180deg,#f5f3ff,#fff)}.quick button:nth-child(4){border-color:#fdba74;background:linear-gradient(180deg,#fff7ed,#fff)}.quick button:nth-child(5){border-color:#facc15;background:linear-gradient(180deg,#fefce8,#fff)}.quick button:nth-child(6){border-color:#5eead4;background:linear-gradient(180deg,#f0fdfa,#fff)}.quick button:nth-child(7){border-color:#f9a8d4;background:linear-gradient(180deg,#fdf2f8,#fff)}.quick button:nth-child(8){border-color:#fca5a5;background:linear-gradient(180deg,#fef2f2,#fff)}
.quick button:nth-child(1) .icon{color:var(--scl-blue)}.quick button:nth-child(2) .icon{color:var(--scl-green)}.quick button:nth-child(3) .icon{color:var(--scl-purple)}.quick button:nth-child(4) .icon{color:var(--scl-orange)}.quick button:nth-child(5) .icon{color:var(--scl-gold)}.quick button:nth-child(6) .icon{color:var(--scl-teal)}.quick button:nth-child(7) .icon{color:var(--scl-pink)}.quick button:nth-child(8) .icon{color:var(--scl-red)}
/* Admission classes are intentionally color-coded for quick recognition. */
.classes .class{color:#fff;border:2px solid transparent;text-shadow:0 1px 1px rgba(0,0,0,.25);min-height:64px;transition:transform .16s ease,filter .16s ease}.classes .class:hover{transform:translateY(-2px);filter:brightness(1.04)}
.classes .class:nth-child(1){background:#2563eb}.classes .class:nth-child(2){background:#7c3aed}.classes .class:nth-child(3){background:#0f766e}.classes .class:nth-child(4){background:#d99a00}.classes .class:nth-child(5){background:#16a34a}.classes .class:nth-child(6){background:#0891b2}.classes .class:nth-child(7){background:#ea580c}.classes .class:nth-child(8){background:#db2777}.classes .class:nth-child(9){background:#4f46e5}.classes .class:nth-child(10){background:#059669}.classes .class:nth-child(11){background:#9333ea}.classes .class:nth-child(12){background:#c2410c}.classes .class:nth-child(13){background:#0369a1}.classes .class:nth-child(14){background:#be123c}.classes .class:nth-child(15){background:#475569}
.classes .class small{color:rgba(255,255,255,.92)}
/* Modern buttons without changing the school's maroon/gold identity. */
.btn{border-radius:12px!important;padding:11px 17px!important;font-weight:800!important;letter-spacing:.1px;box-shadow:0 4px 12px rgba(0,0,0,.10);transition:transform .16s ease,box-shadow .16s ease,filter .16s ease}.btn:hover{transform:translateY(-1px);box-shadow:0 7px 16px rgba(0,0,0,.14);filter:brightness(1.04)}.btn:active{transform:translateY(0)}
.scl-v39-status-badge{display:inline-flex;align-items:center;justify-content:center;margin-top:6px;padding:3px 8px;border-radius:999px;font-size:10px;line-height:1;font-weight:900;background:#dbeafe;color:#1e3a8a}.scl-v39-status-badge[data-state="active"]{background:#fef3c7;color:#92400e}.scl-v39-status-badge[data-state="complete"]{background:#dcfce7;color:#166534}
@media(max-width:760px){.scl-v39-frontbar{grid-template-columns:repeat(2,minmax(0,1fr))}.scl-v39-frontbar .scl-v39-service{min-height:70px;padding:12px 8px}}

/* V39 service-bar color identities */
.scl-v33-tools .scl-v33-tool{border:0!important;border-radius:16px!important;color:#fff!important;min-height:82px!important;box-shadow:0 7px 18px rgba(0,0,0,.12)!important;transition:transform .18s ease,box-shadow .18s ease,filter .18s ease!important}
.scl-v33-tools .scl-v33-tool:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(0,0,0,.16)!important;filter:brightness(1.04)}
.scl-v33-tools .scl-v33-tool.fee{background:linear-gradient(135deg,#1d4ed8,#3b82f6)!important}.scl-v33-tools .scl-v33-tool.email{background:linear-gradient(135deg,#6d28d9,#8b5cf6)!important}.scl-v33-tools .scl-v33-tool.curriculum{background:linear-gradient(135deg,#b77900,#eab308)!important}.scl-v33-tools .scl-v33-tool.attendance{background:linear-gradient(135deg,#15803d,#22c55e)!important}
.scl-v33-tools .tool-sub{color:rgba(255,255,255,.92)!important}

/* V39 major-section identity accents: distinct colors without replacing the school's maroon/gold base palette. */
#admissions{border-top:5px solid #dc2626}#about{border-top:5px solid #2563eb}#schoolStats{border-top:5px solid #0891b2}#life{border-top:5px solid #16a34a}#sclSocial{border-top:5px solid #7c3aed}#sclV22Module{border-top:5px solid #ea580c}#sclCurriculum{border-top:5px solid #d99a00}#approvedAcademicCalendar{border-top:5px solid #0f766e}
#admissions h2{color:#fff}#about h2{color:#2563eb}#schoolStats h2{color:#0891b2}#life h2{color:#15803d}#sclSocial h2{color:#6d28d9}#sclV22Module h2{color:#c2410c}#sclCurriculum h2{color:#b77900}#approvedAcademicCalendar h2{color:#0f766e}
.btn.outline{border:2px solid currentColor!important;background:rgba(255,255,255,.82)!important;backdrop-filter:blur(4px);box-shadow:0 4px 10px rgba(0,0,0,.08)!important}
</style>
<style id="scl-v41-location-confirmation-css">
.scl-v41-confirmed{border-color:#16a34a!important;background:#eefaf2!important;box-shadow:0 0 0 2px #16a34a22,0 0 18px #16a34a44!important}
.scl-v41-confirmed::after{content:" ✓ LOCATION CONFIRMED";display:block;color:#12652e;font-size:11px;font-weight:900;margin-top:5px}
#sclV41AttendanceSubmit:disabled{opacity:.45!important;cursor:not-allowed!important;filter:grayscale(.25)}
</style>
<script id="scl-v41-location-confirmation-flow">
(function(){
  function escV41(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
  function distV41(a,b,c,d){const R=6371000,rad=x=>x*Math.PI/180,d1=rad(c-a),d2=rad(d-b),q=Math.sin(d1/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(d2/2)**2;return 2*R*Math.asin(Math.sqrt(q));}
  window.__sclV41LocationFix=null;window.__sclV41Branches=[];
  async function getBranches(){try{const r=await fetch(window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance?action=branches',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY}});const d=await r.json();window.__sclV41Branches=d.branches||[];return window.__sclV41Branches;}catch(_){return window.__sclV41Branches||[]}}
  async function confirmLocation(branchId){
    const status=document.getElementById('sclV38FlowStatus'),submit=document.getElementById('sclV41AttendanceSubmit');
    if(submit)submit.disabled=true;window.__sclV41LocationFix=null;
    document.querySelectorAll('input[name="sclV38Branch"]').forEach(x=>x.closest('label')?.classList.remove('scl-v41-confirmed'));
    const branch=window.__sclV41Branches.find(x=>String(x.id)===String(branchId));
    if(!branch){if(status)status.innerHTML='<div class="scl-att-error">Selected school location could not be found.</div>';return false;}
    if(branch.latitude==null||branch.longitude==null){if(status)status.innerHTML='<div class="scl-att-error">This school location does not have an exact GPS position yet. An administrator must configure the branch first.</div>';return false;}
    if(status)status.innerHTML='<div class="scl-att-warning">📍 Please allow this device/browser to use your location. Checking the selected school location…</div>';
    try{
      const pos=await new Promise((resolve,reject)=>{if(!navigator.geolocation)return reject({code:2,message:'Location services are not available on this device/browser.'});navigator.geolocation.getCurrentPosition(resolve,reject,{enableHighAccuracy:true,maximumAge:0,timeout:20000});});
      const c=pos.coords,accuracy=Number(c.accuracy||0);if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude))throw new Error('No usable device location was returned.');
      const distance=distV41(c.latitude,c.longitude,Number(branch.latitude),Number(branch.longitude)),radius=Number(branch.radius_m||150);
      if(distance>radius){if(status)status.innerHTML='<div class="scl-att-error">❌ Location not confirmed. You are about '+Math.round(distance)+' m from '+escV41(branch.name)+'. Move closer to the selected school location and try again.</div>';return false;}
      window.__sclV41LocationFix={branchId,latitude:c.latitude,longitude:c.longitude,accuracy_m:accuracy,distance_m:distance};
      document.querySelectorAll('input[name="sclV38Branch"]').forEach(x=>x.closest('label')?.classList.toggle('scl-v41-confirmed',x.checked&&String(x.value)===String(branchId)));
      if(status)status.innerHTML='<div class="scl-att-success"><b>✓ LOCATION CONFIRMED</b><br>'+escV41(branch.name)+' is confirmed. Device distance: '+Math.round(distance)+' m. GPS accuracy: '+Math.round(accuracy)+' m.<br><b>You can now submit your attendance.</b></div>';
      if(submit)submit.disabled=false;return true;
    }catch(e){let msg='Location permission was not completed.';if(e?.code===1)msg='Location permission was denied. Turn on Location for this browser/device, then select the school location again.';else if(e?.code===2)msg='Your device could not determine its location. Turn on Location/GPS and try again.';else if(e?.code===3)msg='Location check timed out. Move to an open area and try again.';else if(e?.message)msg=e.message;if(status)status.innerHTML='<div class="scl-att-error">❌ '+escV41(msg)+'</div>';return false;}
  }
  window.sclV41EnterAttendance=async function(action){const branch=document.querySelector('input[name="sclV38Branch"]:checked')?.value;if(!branch){toast('Select the school location first.');return}if(!window.__sclV41LocationFix||String(window.__sclV41LocationFix.branchId)!==String(branch)){if(!await confirmLocation(branch))return}await window.sclV38EnterAttendance(action)};
  const previousOpen=window.sclOpenAttendance;
  window.sclOpenAttendance=async function(mode='self'){
    window.__sclV41LocationFix=null;const result=await previousOpen(mode);if(mode==='admin'||mode==='appeal')return result;
    await getBranches();
    const submit=document.getElementById('sclV41AttendanceSubmit');
    if(submit){const action=(submit.textContent||'').toUpperCase().includes('SIGN OUT')?'out':'in';submit.disabled=true;submit.removeAttribute('onclick');submit.onclick=()=>window.sclV41EnterAttendance(action);}
    document.querySelectorAll('input[name="sclV38Branch"]').forEach(r=>r.addEventListener('change',()=>{document.querySelectorAll('input[name="sclV38Branch"]').forEach(x=>x.closest('label')?.classList.remove('scl-v41-confirmed'));confirmLocation(r.value)}));
    return result;
  };
  document.addEventListener('DOMContentLoaded',()=>getBranches());
})();
</script>
<style id="scl-v42-real-attendance-css">
.scl-v42-live-board{margin-top:14px;border:2px solid #650007;border-radius:16px;background:#fff;overflow:hidden;box-shadow:0 8px 22px #00000010}
.scl-v42-live-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;background:linear-gradient(135deg,#650007,#8f1118);color:#fff}
.scl-v42-live-head h4{margin:0;font-size:15px}.scl-v42-live-head small{opacity:.9}.scl-v42-live-dot{width:9px;height:9px;border-radius:50%;background:#62e58a;display:inline-block;margin-right:6px;box-shadow:0 0 10px #62e58a}
.scl-v42-live-table{width:100%;border-collapse:collapse;font-size:12px}.scl-v42-live-table th{background:#fff5e2;color:#650007;text-align:left;padding:9px}.scl-v42-live-table td{border-top:1px solid #ead9bd;padding:9px}.scl-v42-live-table tr:nth-child(even) td{background:#fffaf2}
.scl-v42-status{padding:12px;border-radius:12px;margin-top:10px}.scl-v42-welcome{border:2px solid #16a34a;background:#effcf3;color:#12652e}.scl-v42-goodbye{border:2px solid #b77900;background:#fff8e7;color:#6d4c00}.scl-v42-location-note{border:2px solid #d6a400;background:#fff9df;color:#5d4700;padding:12px;border-radius:12px;margin-top:10px}
.scl-v42-admin-tools{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.scl-v42-salary-fit{background:#eaf8ef!important;color:#08763a!important;font-weight:900}.scl-v42-salary-almost{background:#fff7d9!important;color:#8a6200!important;font-weight:900}.scl-v42-salary-not{background:#fff0f0!important;color:#9b0000!important;font-weight:900}.scl-v42-percent{font-size:17px;font-weight:900}.scl-v42-legend{display:flex;gap:8px;flex-wrap:wrap;font-size:11px;margin-top:8px}.scl-v42-legend span{padding:5px 8px;border-radius:999px;font-weight:800}
@media(max-width:700px){.scl-v42-live-table{font-size:11px}.scl-v42-live-table th,.scl-v42-live-table td{padding:7px}.scl-v42-live-table th:nth-child(3),.scl-v42-live-table td:nth-child(3){display:none}}
</style>
<script id="scl-v42-real-attendance-flow">
(function(){
  const ATT=window.SCL_SUPABASE_URL+'/functions/v1/scl-attendance';
  const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const auth=()=>{try{return JSON.parse(sessionStorage.getItem('sclAuthSession')||'null')}catch(_){return null}};
  const token=()=>auth()?.accessToken||'';
  async function api(action,method='GET',body=null){const h={'apikey':window.SCL_SUPABASE_PUBLISHABLE_KEY,'Authorization':'Bearer '+token(),'Content-Type':'application/json'};const r=await fetch(ATT+'?action='+encodeURIComponent(action),{method,headers:h,body:body?JSON.stringify(body):undefined});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Attendance service request failed.');return d}
  async function daily(){const r=await fetch(ATT+'?action=daily',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY}});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Unable to load today’s attendance list.');return d}
  async function branches(){const r=await fetch(ATT+'?action=branches',{headers:{apikey:window.SCL_SUPABASE_PUBLISHABLE_KEY}});let d={};try{d=await r.json()}catch(_){}if(!r.ok)throw new Error(d.error||'Unable to load school locations.');return d}
  function today(){return new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'})}
  function nowMinutes(){const p=new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Lagos',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());return Number(p.find(x=>x.type==='hour')?.value||0)*60+Number(p.find(x=>x.type==='minute')?.value||0)}
  function periodAllowed(p){const m=nowMinutes();return p==='morning'?(m>=420&&m<=719):(m>=720&&m<=960)}
  function distance(a,b,c,d){const R=6371000,rad=x=>x*Math.PI/180,dl=rad(c-a),dn=rad(d-b),q=Math.sin(dl/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(dn/2)**2;return 2*R*Math.asin(Math.sqrt(q))}
  function openModal(){const m=document.getElementById('sclAttendanceModal');if(!m)return;m.classList.add('open');m.style.display='flex';m.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}
  function time(v){return v?new Date(v).toLocaleTimeString('en-NG',{hour:'2-digit',minute:'2-digit'}):'—'}
  let dailyTimer=null;
  async function renderDaily(){const box=document.getElementById('sclV42DailyBoard');if(!box)return;try{const d=await daily();const rows=d.records||[];box.innerHTML='<div class="scl-v42-live-board"><div class="scl-v42-live-head"><div><h4><span class="scl-v42-live-dot"></span>TODAY’S STAFF ATTENDANCE</h4><small>'+esc(new Date(d.attendance_date+'T12:00:00').toLocaleDateString('en-NG',{weekday:'long',year:'numeric',month:'long',day:'numeric'}))+'</small></div><b>'+rows.length+' signed in</b></div>'+(rows.length?'<div style="overflow:auto"><table class="scl-v42-live-table"><thead><tr><th>Staff</th><th>Sign In</th><th>Period</th><th>Status</th><th>Sign Out</th></tr></thead><tbody>'+rows.map(r=>'<tr><td><b>'+esc(r.staff?.full_name||'Staff')+'</b><br><small>'+esc(r.staff?.role||'')+'</small></td><td>'+esc(time(r.sign_in_at))+'</td><td>'+esc(r.attendance_period||'—')+'</td><td><b>'+(r.sign_out_at&&r.sign_out_status==='valid'?'COMPLETED':'SIGNED IN')+'</b></td><td>'+esc(time(r.sign_out_at))+'</td></tr>').join('')+'</tbody></table></div>':'<div style="padding:14px">No staff member has signed in yet today.</div>')+'</div>'}catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}}
  function startLive(){clearInterval(dailyTimer);renderDaily();dailyTimer=setInterval(renderDaily,20000)}
  function stopLive(){clearInterval(dailyTimer);dailyTimer=null}
  async function confirmLocation(branchId){
    const status=document.getElementById('sclV42LocationStatus'),submit=document.getElementById('sclV42Submit');
    if(submit)submit.disabled=true;window.__sclV42LocationFix=null;
    const branch=(window.__sclV42Branches||[]).find(x=>String(x.id)===String(branchId));
    if(!branch){if(status)status.innerHTML='<div class="scl-att-error">Selected school location could not be found.</div>';return false}
    if(branch.latitude==null||branch.longitude==null){if(status)status.innerHTML='<div class="scl-att-error">This school location does not have its exact GPS position configured yet.</div>';return false}
    if(status)status.innerHTML='<div class="scl-v42-location-note"><b>📍 Location permission needed</b><br>Your device will share its current location with SCL only to confirm that you are physically at the selected school location. Please allow the browser/device location prompt.</div>';
    try{
      if(!navigator.geolocation)throw new Error('This device/browser does not provide location services.');
      const pos=await new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(resolve,reject,{enableHighAccuracy:true,maximumAge:0,timeout:20000}));
      const c=pos.coords,acc=Number(c.accuracy||0);if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude))throw new Error('No usable device location was returned.');
      const dist=distance(c.latitude,c.longitude,Number(branch.latitude),Number(branch.longitude)),radius=Number(branch.radius_m||150);
      if(dist>radius){if(status)status.innerHTML='<div class="scl-att-error">❌ Location not confirmed. You are about '+Math.round(dist)+' m from '+esc(branch.name)+'. Please move to the selected school location and try again.</div>';return false}
      window.__sclV42LocationFix={branchId,latitude:c.latitude,longitude:c.longitude,accuracy_m:acc,distance_m:dist};
      if(status)status.innerHTML='<div class="scl-att-success"><b>✓ LOCATION CONFIRMED</b><br>'+esc(branch.name)+' • '+Math.round(dist)+' m from the approved point • GPS accuracy '+Math.round(acc)+' m.<br><small>Your location has been confirmed. You can now sign in or sign out.</small></div>';
      document.querySelectorAll('input[name="sclV42Branch"]').forEach(x=>x.closest('label')?.classList.toggle('scl-v41-confirmed',x.checked&&String(x.value)===String(branchId)));
      if(submit)submit.disabled=false;return true;
    }catch(e){let msg='Location permission was not completed.';if(e?.code===1)msg='Location permission was denied. Turn on Location for this browser/device, then tap the location button again.';else if(e?.code===2)msg='Location is turned off or unavailable. Turn on Location/GPS in the device settings, then try again.';else if(e?.code===3)msg='Location check timed out. Move to an open area and try again.';else if(e?.message)msg=e.message;if(status)status.innerHTML='<div class="scl-att-error">❌ '+esc(msg)+'</div>';return false}
  }
  async function render(mode='self'){
    openModal();const box=document.getElementById('sclAttendanceBody');if(!box)return;box.innerHTML='<div class="scl-att-warning">Loading today’s attendance…</div>';
    try{
      const bd=await branches();window.__sclV42Branches=bd.branches||[];
      let rec=null;if(auth()?.accessToken){try{const md=await api('my_attendance');rec=(md.records||[]).find(x=>x.attendance_date===today())||null}catch(_){} }
      if(mode==='admin'){await renderAdmin();return}
      const signedIn=!!(rec?.sign_in_at&&!rec?.sign_out_at),complete=!!(rec?.sign_out_at&&rec?.sign_out_status==='valid');
      if(complete){box.innerHTML='<div class="scl-v42-status scl-v42-goodbye"><b>GOODBYE FOR TODAY 🌟</b><br>Your attendance for today is complete.<br><small>Sign-in: '+esc(time(rec.sign_in_at))+' • Sign-out: '+esc(time(rec.sign_out_at))+'</small></div><div id="sclV42DailyBoard"></div>';startLive();return}
      const a=auth(),email=String(a?.user?.email||a?.profile?.email||'');
      box.innerHTML='<div class="scl-att-card"><h4>'+(signedIn?'SIGN OUT FOR TODAY':'STAFF SIGN-IN')+'</h4><p><b>Welcome to SCL staff attendance.</b> Select your attendance period and the school location where you are physically present. When you tap Sign In, SCL will ask for location permission automatically before continuing.</p><div class="scl-v38-attendance-form">'+
      '<label class="field"><span>Staff Username *</span><input id="sclV42Username" autocomplete="username" value="'+esc(email)+'" placeholder="Use the username/email used for your SCL login" required></label>'+
      (signedIn?'':'<div><b>Attendance Period *</b><div class="scl-v38-attendance-periods"><label class="scl-v38-period"><input type="radio" name="sclV42Period" value="morning"><b>🌅 MORNING</b><small>7:00 AM to 11:59 AM</small></label><label class="scl-v38-period"><input type="radio" name="sclV42Period" value="afternoon"><b>☀️ AFTERNOON</b><small>12:00 PM to 4:00 PM</small></label></div></div>')+
      '<div><b>School Location *</b><div class="scl-att-branch-grid">'+(window.__sclV42Branches.length?window.__sclV42Branches.map(x=>'<label class="scl-att-branch"><input type="radio" name="sclV42Branch" value="'+esc(x.id)+'"> <b>'+esc(x.name)+'</b><br><small>'+esc(x.address)+'</small><br><small>Approved radius: '+esc(x.radius_m)+' m</small></label>').join(''):'<div class="scl-att-warning">No active school location is configured.</div>')+'</div></div>'+ 
      '<div id="sclV42LocationStatus"></div><div class="scl-att-actions"><button id="sclV42Submit" class="btn red" type="button" onclick="sclV42SubmitAttendance()">'+(signedIn?'🔴 SIGN OUT':'✍️ SIGN IN')+'</button></div>'+
      (!a?.accessToken?'<div class="scl-v42-location-note"><b>📍 Location permission</b><br>Tap '+(signedIn?'Sign Out':'✍️ Sign In')+' to begin. Your device/browser will first ask for location permission. If you are not logged in, SCL will then ask you to sign in and continue automatically.</div>':'')+
      '</div></div><div id="sclV42DailyBoard"></div>';
      document.querySelectorAll('input[name="sclV42Branch"]').forEach(r=>r.addEventListener('change',()=>{window.__sclV42LocationFix=null;const status=document.getElementById('sclV42LocationStatus');if(status)status.innerHTML='';}));
      window.__sclV42Action=signedIn?'out':'in';window.__sclV42LocationFix=null;startLive();
    }catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}
  }
  window.sclV42ConfirmSelectedLocation=async function(){const b=document.querySelector('input[name="sclV42Branch"]:checked')?.value;if(!b){toast('Select your school location first.');return false}return confirmLocation(b)};
  window.sclV42SubmitAttendance=async function(){
    const action=window.__sclV42Action||'in',username=document.getElementById('sclV42Username')?.value.trim(),branch=document.querySelector('input[name="sclV42Branch"]:checked')?.value,period=document.querySelector('input[name="sclV42Period"]:checked')?.value||'',status=document.getElementById('sclV42LocationStatus');
    if(!username){toast('Enter your staff username first.');return}
    if(!branch){toast('Select your school location first.');return}
    if(action==='in'&&!period){toast('Select Morning or Afternoon attendance.');return}
    if(action==='in'&&!periodAllowed(period)){toast(period==='morning'?'Morning attendance is available from 7:00 AM to 11:59 AM.':'Afternoon attendance is available from 12:00 PM to 4:00 PM.');return}
    const btn=document.getElementById('sclV42Submit');if(btn)btn.disabled=true;
    if(!window.__sclV42LocationFix||String(window.__sclV42LocationFix.branchId)!==String(branch)){
      const ok=await confirmLocation(branch);
      if(!ok){if(btn)btn.disabled=false;return}
    }
    const a=auth();if(!a?.accessToken){window.__sclV42Pending={action,username,branch,period,location:window.__sclV42LocationFix};openM('loginModal');if(btn)btn.disabled=false;return}
    const loginEmail=String(a.user?.email||a.profile?.email||'').trim().toLowerCase();if(loginEmail&&username.toLowerCase()!==loginEmail){toast('The staff username does not match the SCL account currently logged in.');return}
    if(btn)btn.disabled=true;if(status)status.innerHTML='<div class="scl-att-warning">Recording your attendance securely…</div>';
    try{
      const x=window.__sclV42LocationFix;
      const out=await api(action==='in'?'sign_in':'sign_out','POST',{branch_id:branch,latitude:x.latitude,longitude:x.longitude,accuracy_m:x.accuracy_m,verification:'device_location_and_account_login',staff_username:username,attendance_period:period});
      if(action==='in'){boxWelcome('Welcome to SCL! 🌟 Your attendance has been recorded for today. We are happy to have you with us. Have a productive day!');}
      else{boxGoodbye('Goodbye and thank you for today’s work! 🌟 Your sign-out has been recorded. Have a safe journey home.');}
      await renderDaily();window.sclCalendarAttendanceSync?.();window.sclAttendanceStatusSync?.(out.record);
      if(action==='in'){setTimeout(()=>render('self'),1800)}
    }catch(e){if(btn)btn.disabled=false;if(status)status.innerHTML='<div class="scl-att-error">'+esc(e.message||'Attendance could not be completed.')+'</div>'}
  };
  function boxWelcome(msg){const box=document.getElementById('sclAttendanceBody');if(box)box.innerHTML='<div class="scl-v42-status scl-v42-welcome"><b>WELCOME FOR TODAY 🌟</b><br>'+esc(msg)+'</div><div id="sclV42DailyBoard"></div>';startLive()}
  function boxGoodbye(msg){const box=document.getElementById('sclAttendanceBody');if(box)box.innerHTML='<div class="scl-v42-status scl-v42-goodbye"><b>GOODBYE FOR TODAY 🌟</b><br>'+esc(msg)+'</div><div id="sclV42DailyBoard"></div>';startLive()}
  window.sclV38ResumeAfterLogin=async function(){const x=window.__sclV42Pending;if(!x)return;window.__sclV42Pending=null;closeM('loginModal');await new Promise(r=>setTimeout(r,150));window.__sclV42LocationFix=x.location;window.__sclV42Action=x.action;const u=document.getElementById('sclV42Username');if(u)u.value=x.username;const b=document.querySelector('input[name="sclV42Branch"][value="'+CSS.escape(String(x.branch))+'"]');if(b){b.checked=true}if(x.period){const p=document.querySelector('input[name="sclV42Period"][value="'+CSS.escape(x.period)+'"]');if(p)p.checked=true}await window.sclV42SubmitAttendance()};
  async function renderAdmin(){
    const box=document.getElementById('sclAttendanceBody');
    box.innerHTML='<div class="scl-att-card"><h4>ADMIN ATTENDANCE & SALARY REVIEW</h4><p>Administrators can review the current month, full year, or any custom date range. The live public board only shows today; this register keeps the accumulated history.</p><div class="scl-v42-admin-tools"><button class="btn gold" type="button" onclick="sclV42AdminLoad(\'month\')">THIS MONTH</button><button class="btn outline" type="button" onclick="sclV42AdminLoad(\'year\')">THIS YEAR</button><button class="btn outline" type="button" onclick="sclV42AdminLoad(\'custom\')">CUSTOM RANGE</button><button class="btn outline" type="button" onclick="sclOpenBranchAdmin()">📍 BRANCH GPS</button></div><div id="sclV42AdminBody"><div class="scl-att-warning">Loading this month’s attendance…</div></div></div>';
    await window.sclV42AdminLoad('month');
  }
  window.sclV42AdminLoad=async function(period){const box=document.getElementById('sclV42AdminBody');if(!box)return;if(period==='custom'){box.innerHTML='<div class="grid"><div class="field"><label>Start Date</label><input id="sclV42Start" type="date"></div><div class="field"><label>End Date</label><input id="sclV42End" type="date" value="'+today()+'"></div></div><button class="btn red" type="button" onclick="sclV42AdminLoad(\'custom_apply\')">LOAD RANGE</button>';return}try{let body={period};if(period==='custom_apply'){body={start_date:document.getElementById('sclV42Start')?.value,end_date:document.getElementById('sclV42End')?.value};if(!body.start_date||!body.end_date){toast('Choose both dates.');return}}box.innerHTML='<div class="scl-att-warning">Loading accumulated attendance…</div>';const d=await api('admin_attendance','POST',body),rows=d.records||[],sum=d.summaries||{};const ids=[...new Set(rows.map(r=>r.auth_user_id))];let html='<div class="scl-att-card"><h4>'+esc((d.period||period).toUpperCase())+' • '+esc(d.period_start)+' to '+esc(d.period_end)+'</h4><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Staff</th><th>Attendance</th><th>Salary Fitness</th><th>Records</th></tr></thead><tbody>';
      ids.forEach(id=>{const r=rows.find(x=>x.auth_user_id===id),s=sum[id]||{};const cls=s.salary_status==='FIT FOR SALARY'?'scl-v42-salary-fit':s.salary_status==='ALMOST FIT'?'scl-v42-salary-almost':'scl-v42-salary-not';const pctn=Number(s.attendance_percent||0);const count=rows.filter(x=>x.auth_user_id===id).length;html+='<tr><td><b>'+esc(r?.staff?.full_name||'Staff')+'</b><br><small>'+esc(r?.staff?.role||'')+' • '+esc(r?.staff?.employment_mode||r?.staff?.employment_status||'')+'</small></td><td><span class="scl-v42-percent">'+pctn.toFixed(2)+'%</span><br><small>Present '+esc(s.present_days)+' • Absent '+esc(s.absent_days)+' • Incomplete '+esc(s.incomplete_days)+' • Leave '+esc(s.leave_days)+'</small></td><td class="'+cls+'">'+esc(s.salary_status||'REVIEW')+'<br><small>90%+ = salary threshold</small></td><td>'+count+' attendance record(s)</td></tr>'});
      html+='</tbody></table></div><div class="scl-v42-legend"><span class="scl-v42-salary-fit">🟢 FIT ≥ 90%</span><span class="scl-v42-salary-almost">🟡 ALMOST FIT 80–89.99%</span><span class="scl-v42-salary-not">🔴 NOT FIT &lt; 80%</span></div><p><small>The 90% threshold follows the existing SCL attendance rule. The 80% “almost fit” band is a visual warning and can be changed by management if the school adopts a different payroll policy. Final salary payment remains an administrator decision.</small></p></div>';
      html+='<div class="scl-att-card"><h4>ACCUMULATED DAILY RECORDS</h4><div class="scl-att-table-wrap"><table class="scl-att-table"><thead><tr><th>Date</th><th>Staff</th><th>Sign In</th><th>Sign Out</th><th>Branch</th><th>Status</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+esc(r.attendance_date)+'</td><td>'+esc(r.staff?.full_name||'Staff')+'</td><td>'+esc(time(r.sign_in_at))+'</td><td>'+esc(time(r.sign_out_at))+'</td><td>'+esc(r.school_branches?.name||'')+'</td><td>'+esc(r.sign_out_at&&r.sign_out_status==='valid'?'COMPLETE':'INCOMPLETE')+'</td></tr>').join('')+'</tbody></table></div></div>';
      box.innerHTML=html;
    }catch(e){box.innerHTML='<div class="scl-att-error">'+esc(e.message)+'</div>'}}
  const originalOpen=window.sclOpenAttendance;
  window.sclOpenAttendance=async function(mode='self'){if(mode==='admin'){openModal();await render('admin');return}if(mode==='appeal'){return originalOpen(mode)}await render('self')};
  window.addEventListener('beforeunload',stopLive);
  document.addEventListener('DOMContentLoaded',()=>{});
})();
</script>
<style id="scl-v44-one-tap-location-css">
/* V44: location permission is requested from the staff Sign In / Sign Out action itself. */
#sclV42Submit{min-width:150px}
</style>
<script id="scl-v44-one-tap-location-flow">
(function(){
  // The V42 attendance renderer already exposes the single Sign In / Sign Out action.
  // Keep the location request inside that action; no separate location-confirmation button is created.
  window.__sclV44OneTapLocation=true;
})();
</script>
<script id="scl-v44-leadership-js">
(function(){
  const KEY='sclLeadershipBadgesV44';
  const OLD='sclLeadershipBadgesV43';
  const roles={'Head Prefect':'prefect','Deputy Head Prefect':'prefect','Senior Prefect':'senior','Class Prefect':'prefect','Assistant Class Prefect':'prefect','Sports Prefect':'sport','Health & Sanitation Prefect':'service','Library Prefect':'academic','Timekeeper Prefect':'service','Assembly Prefect':'senior','Protocol / Social Prefect':'civic','Student Council / Civic Leadership':'civic','Academic Achievement':'academic','Sports Achievement':'sport','Community Service':'service'};
  const icon={prefect:'👑',senior:'🎖️',service:'🤝',civic:'🏛️',academic:'📚',sport:'🏆'};
  function get(){try{let v=JSON.parse(localStorage.getItem(KEY)||'null');if(Array.isArray(v))return v;let old=JSON.parse(localStorage.getItem(OLD)||'[]');return Array.isArray(old)?old.map(normalize):[]}catch(e){return[]}}
  function normalize(x){x=x||{};return {id:x.id&&String(x.id).startsWith('SCL-LD-')?x.id:'SCL-LD-'+Math.random().toString(36).slice(2,8).toUpperCase(),student:String(x.student||''),className:String(x.className||''),role:String(x.role||''),date:String(x.date||''),session:String(x.session||''),status:x.status==='ended'?'ended':'active',note:String(x.note||'')}}
  function save(a){try{localStorage.setItem(KEY,JSON.stringify(a.map(normalize)));return true}catch(e){toast('Unable to save badge records on this device.');return false}}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
  function isSchoolAdmin(){try{return typeof isAdmin==='function'&&isAdmin()}catch(e){return false}}
  function matches(x,q){return !q||[x.id,x.student,x.className,x.role,x.note,x.session,x.status].join(' ').toLowerCase().includes(q)}
  function statusHtml(x){return '<span class="status-chip '+(x.status==='ended'?'ended':'')+'">'+(x.status==='ended'?'ENDED / ARCHIVED':'ACTIVE')+'</span>'}
  window.openSclLeadership=function(){const m=document.getElementById('sclLeadershipModal');if(!m)return;m.classList.add('open');m.style.display='flex';m.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');const d=document.getElementById('sclBadgeDate');if(d&&!d.value)d.value=new Date().toISOString().slice(0,10);document.getElementById('sclLeadershipAdminArea').style.display=isSchoolAdmin()?'block':'none';document.getElementById('sclLeadershipAdminNote').innerHTML=isSchoolAdmin()?'Administrator mode is active. Records are stored locally on this device until a school database is connected.':'<b>View mode:</b> Records can be searched, verified and printed. Issuing or clearing records requires an authenticated SCL administrator.';sclRenderLeadershipBadges()};
  window.sclRenderLeadershipBadges=function(){const host=document.getElementById('sclLeadershipBadges');if(!host)return;const q=(document.getElementById('sclLeadershipSearch')?.value||'').trim().toLowerCase();const arr=get().filter(x=>matches(x,q));if(!arr.length){host.innerHTML='<div class="scl-leadership-empty" style="grid-column:1/-1">No badge records match the current search.</div>';return}host.innerHTML=arr.map((x,i)=>{const type=roles[x.role]||'prefect';return '<article class="scl-badge '+type+'"><div class="medal">'+(icon[type]||'🏅')+'</div><div><b>'+esc(x.role)+'</b><br><strong>'+esc(x.student)+'</strong><br><small>'+esc(x.className)+' • '+esc(x.session||'Session not set')+' • Awarded '+esc(x.date||'—')+'</small><br>'+statusHtml(x)+' <span class="badge-id">'+esc(x.id)+'</span></div><small>'+esc(x.note||'SCL leadership recognition')+'</small><div class="scl-leadership-actions"><button type="button" onclick="sclPrintOneLeadershipBadge('+i+')">Print</button>'+(isSchoolAdmin()?'<button type="button" onclick="sclDeleteLeadershipBadge('+i+')">Delete</button>':'')+'</div></article>'}).join('')};
  window.sclIssueLeadershipBadge=function(e){e.preventDefault();if(!isSchoolAdmin()){toast('Administrator access is required to issue a badge.');return}const a=get();a.unshift(normalize({id:'SCL-LD-'+Math.random().toString(36).slice(2,8).toUpperCase(),student:document.getElementById('sclBadgeStudent').value.trim(),className:document.getElementById('sclBadgeClass').value,role:document.getElementById('sclBadgeRole').value,date:document.getElementById('sclBadgeDate').value||new Date().toISOString().slice(0,10),session:document.getElementById('sclBadgeSession').value.trim(),status:document.getElementById('sclBadgeStatus').value,note:document.getElementById('sclBadgeNote').value.trim()}));if(save(a)){e.target.reset();document.getElementById('sclBadgeDate').value=new Date().toISOString().slice(0,10);sclRenderLeadershipBadges();toast('Leadership badge recorded successfully.')}};
  window.sclDeleteLeadershipBadge=function(index){if(!isSchoolAdmin())return;const a=get();a.splice(index,1);save(a);sclRenderLeadershipBadges();toast('Badge record removed.')};
  window.sclClearLeadershipBadges=function(){if(!isSchoolAdmin()){toast('Administrator access is required.');return}if(confirm('Clear all local SCL leadership badge records on this device?')){save([]);sclRenderLeadershipBadges();toast('Local badge records cleared.')}};
  window.sclSeedLeadershipDemo=function(){if(!isSchoolAdmin()){toast('Administrator access is required.');return}const d=new Date().toISOString().slice(0,10);save([normalize({id:'SCL-LD-DEMO01',student:'Example Student',className:'JSS 3',role:'Senior Prefect',date:d,session:'2026/2027',status:'active',note:'Recognised for responsible school leadership.'}),normalize({id:'SCL-LD-DEMO02',student:'Example Student 2',className:'Primary 5',role:'Sports Prefect',date:d,session:'2026/2027',status:'active',note:'Recognised for supporting school sports activities.'})]);sclRenderLeadershipBadges();toast('Demo badges loaded. Replace them with real records.')};
  window.sclVerifyLeadershipBadge=function(){const input=document.getElementById('sclLeadershipVerifyCode'),out=document.getElementById('sclLeadershipVerifyResult');const code=(input?.value||'').trim().toUpperCase();if(!out)return;if(!code){out.className='scl-v44-status bad';out.textContent='Please enter a badge ID.';return}const x=get().find(r=>String(r.id).toUpperCase()===code);if(!x){out.className='scl-v44-status bad';out.textContent='No matching SCL leadership record found on this device.';return}out.className='scl-v44-status ok';out.innerHTML='Verified: <b>'+esc(x.student)+'</b> — '+esc(x.role)+' — '+esc(x.className)+' — '+statusHtml(x)+' — '+esc(x.session||'Session not set')};
  function printHtml(items){const w=window.open('','_blank','noopener,noreferrer');if(!w){toast('Please allow pop-ups to print badges.');return}w.document.write('<!doctype html><html><head><title>SCL Leadership Badges</title><style>body{font-family:Arial,sans-serif;padding:24px;color:#222}.sheet{display:grid;grid-template-columns:1fr 1fr;gap:16px}.badge{border:3px solid #650007;border-radius:18px;padding:22px;min-height:210px;break-inside:avoid;display:flex;flex-direction:column;justify-content:space-between}.badge h2{margin:0;color:#650007}.badge p{margin:6px 0}.foot{font-size:11px;color:#666}.id{font-size:10px;color:#777}@media print{button{display:none}}</style></head><body><h1>Shining Child Leaders School</h1><p>Prefect &amp; Politics — Leadership &amp; Recognition</p><div class="sheet">'+items.map(x=>'<div class="badge"><div><div style="font-size:34px">'+esc(icon[roles[x.role]||'prefect']||'🏅')+'</div><h2>'+esc(x.role)+'</h2><h3>'+esc(x.student)+'</h3><p><b>Class:</b> '+esc(x.className)+'</p><p><b>Session:</b> '+esc(x.session||'—')+'</p><p><b>Date:</b> '+esc(x.date||'—')+' &nbsp; <b>Status:</b> '+esc(x.status==='ended'?'Ended / Archived':'Active')+'</p><p class="id">Badge ID: '+esc(x.id)+'</p></div><div class="foot">'+esc(x.note||'SCL leadership recognition')+'</div></div>').join('')+'</div><scr'+'ipt>window.onload=function(){window.print()}<\/scr'+'ipt>');w.document.close()}

  window.sclPrintLeadershipBadges=function(){const q=(document.getElementById('sclLeadershipSearch')?.value||'').toLowerCase();printHtml(get().filter(x=>matches(x,q)))};
  window.sclPrintOneLeadershipBadge=function(index){const q=(document.getElementById('sclLeadershipSearch')?.value||'').toLowerCase();const arr=get().filter(x=>matches(x,q));if(arr[index])printHtml([arr[index]])};
  window.sclExportLeadershipBadges=function(){const blob=new Blob([JSON.stringify(get(),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='SCL_Leadership_Badges_V44.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
  document.addEventListener('DOMContentLoaded',function(){const grid=document.querySelector('#sclSuiteModal .scl-suite-grid');if(grid&&!grid.querySelector('[data-scl-leadership]')){const b=document.createElement('button');b.className='scl-suite-btn';b.setAttribute('data-scl-leadership','1');b.innerHTML='👑 PREFECT & POLITICS<small>Manage prefect badges, civic leadership and recognition records.</small>';b.onclick=window.openSclLeadership;grid.appendChild(b);const r=document.createElement('button');r.className='scl-suite-btn';r.setAttribute('data-scl-service-rank','1');r.innerHTML='🏅 MONTHLY SERVICE RANK<small>View and approve your 30-day service rank cycles.</small>';r.onclick=window.sclOpenServiceRank;grid.appendChild(r)}});
})();
</script>
<script id="scl-smart-timetable-single">
(function(){
  const TT_CSS=`
.scl-new-smart-tt{--bg:#0f1216;--panel:#171b21;--panel-2:#1e232b;--line:#2a303a;--text:#e8eaed;--text-dim:#8a9099;--led:#ff3b30;--led-dim:#3a1310;--gold:#d4af37;--gold-dim:#3a2f10;--purple:#9b59d0;--ok:#3ddc84;--warn:#ff6b6b;--mon:#4aa8ff;--tue:#9b59d0;--wed:#3ddc84;--thu:#ff9f43;--fri:#d4af37;color:var(--text);background:var(--bg);padding:14px;border-radius:14px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}.scl-new-smart-tt *{box-sizing:border-box}.scl-new-smart-tt .wrap{width:100%;max-width:1000px;margin:auto}.scl-new-smart-tt .clock-panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:12px;text-align:center}.scl-new-smart-tt .led{font-family:"Courier New",monospace;font-weight:700;font-size:clamp(1.9rem,9vw,2.6rem);letter-spacing:.05em;color:var(--led);text-shadow:0 0 6px rgba(255,59,48,.55),0 0 16px rgba(255,59,48,.3);background:var(--led-dim);border-radius:8px;padding:8px 4px;line-height:1}.scl-new-smart-tt .date-line{margin-top:8px;font-size:.78rem;color:var(--text-dim)}.scl-new-smart-tt .status-pill{display:inline-block;margin-top:10px;padding:6px 14px;border-radius:999px;font-size:.8rem;font-weight:600;background:var(--panel-2);border:1px solid var(--line)}.scl-new-smart-tt .status-pill.live{border-color:var(--ok);color:var(--ok)}.scl-new-smart-tt .status-pill .sub{font-weight:400;color:var(--text-dim)}.scl-new-smart-tt .controls{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}.scl-new-smart-tt .seg{display:flex;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:3px;gap:3px;flex:1;min-width:150px}.scl-new-smart-tt .seg button{flex:1;border:none;background:transparent;color:var(--text-dim);padding:8px 6px;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer}.scl-new-smart-tt .seg button.active{background:var(--panel);color:var(--text)}.scl-new-smart-tt .seg.gold button.active{background:var(--gold);color:#241d05}.scl-new-smart-tt select.classpick{flex:1;min-width:150px;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 10px;font-size:.85rem}.scl-new-smart-tt .notify-btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:8px 12px;border-radius:10px;font-size:.78rem;cursor:pointer;display:flex;align-items:center;gap:6px}.scl-new-smart-tt .notify-btn .dot{width:7px;height:7px;border-radius:50%;background:var(--text-dim)}.scl-new-smart-tt .notify-btn.on .dot{background:var(--ok);box-shadow:0 0 6px var(--ok)}.scl-new-smart-tt .class-badge{display:inline-flex;align-items:center;padding:7px 14px;border-radius:999px;font-size:.85rem;font-weight:700;color:#fff;margin-bottom:10px}.scl-new-smart-tt .teacher-box{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:.85rem}.scl-new-smart-tt .teacher-box input{flex:1;border:none;background:transparent;color:var(--text);text-align:right;font-size:.85rem;outline:none}.scl-new-smart-tt .section-title{font-size:.75rem;font-weight:700;color:var(--text-dim);letter-spacing:.03em;margin:14px 0 6px 2px}.scl-new-smart-tt .table-scroll{overflow-x:auto;padding-bottom:6px}.scl-new-smart-tt .grid{min-width:720px}.scl-new-smart-tt .time-header{display:flex;margin-left:70px;margin-bottom:6px}.scl-new-smart-tt .time-header .cell{font-size:.65rem;color:var(--text-dim);text-align:center;padding:0 2px}.scl-new-smart-tt .day-row{display:flex;align-items:stretch;background:var(--panel);border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:7px}.scl-new-smart-tt .day-label{width:70px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.72rem;color:#fff;text-align:center}.scl-new-smart-tt .day-row.mon .day-label{background:var(--mon)}.scl-new-smart-tt .day-row.tue .day-label{background:var(--tue)}.scl-new-smart-tt .day-row.wed .day-label{background:var(--wed)}.scl-new-smart-tt .day-row.thu .day-label{background:var(--thu)}.scl-new-smart-tt .day-row.fri .day-label{background:var(--fri);color:#241d05}.scl-new-smart-tt .cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:6px 4px;text-align:center;border-right:1px solid var(--line)}.scl-new-smart-tt .cell:last-child{border-right:none}.scl-new-smart-tt .cell.teach{flex:1}.scl-new-smart-tt .cell.break,.scl-new-smart-tt .cell.lunch{flex:.55;font-weight:600;font-size:.65rem;color:var(--text-dim);background:var(--panel-2)}.scl-new-smart-tt .cell.fellowship{flex:1;font-weight:700;font-size:.7rem;color:var(--gold);background:var(--gold-dim)}.scl-new-smart-tt .cell.active{box-shadow:inset 0 0 0 2px var(--gold);background:rgba(212,175,55,.14);border-radius:6px}.scl-new-smart-tt .cell input{width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:6px;padding:4px 3px;font-size:.68rem;color:var(--text);outline:none;text-align:center}.scl-new-smart-tt .cell input.subject{font-weight:700;font-size:.7rem}.scl-new-smart-tt .cell input:focus{border-color:var(--gold)}.scl-new-smart-tt .cell input.conflict{border-color:var(--warn);box-shadow:0 0 0 1px var(--warn)}.scl-new-smart-tt .toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%) translateY(10px);background:var(--panel-2);border:1px solid var(--line);color:var(--text);padding:10px 16px;border-radius:10px;font-size:.8rem;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;max-width:90vw;text-align:center;z-index:99999}.scl-new-smart-tt .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media(max-width:700px){.scl-new-smart-tt{padding:8px}.scl-new-smart-tt .grid{min-width:760px}.scl-new-smart-tt .table-scroll{overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:thin;touch-action:pan-x pan-y}.scl-new-smart-tt .time-header{margin-left:54px}.scl-new-smart-tt .day-label{width:54px;font-size:.62rem}.scl-new-smart-tt .cell{padding:3px 2px;font-size:.55rem}.scl-new-smart-tt .cell input{font-size:.55rem;padding:3px 1px}.scl-new-smart-tt .cell input.subject{font-size:.58rem}.scl-new-smart-tt .time-header .cell{font-size:.55rem;font-weight:900;color:var(--text)}.scl-new-smart-tt .section-title{font-size:.68rem}.scl-new-smart-tt .seg{min-width:0}.scl-new-smart-tt select.classpick{min-width:0}}
.scl-new-smart-tt .tt-fixed-note{flex:1;min-width:220px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:.78rem;font-weight:800;color:var(--text);display:flex;align-items:center;justify-content:center;text-align:center}.scl-new-smart-tt .notify-btn{touch-action:manipulation;user-select:none;-webkit-tap-highlight-color:transparent}.scl-new-smart-tt .seg button{touch-action:manipulation;user-select:none;-webkit-tap-highlight-color:transparent}.scl-new-smart-tt .time-header .cell{font-size:.76rem!important;font-weight:900!important;color:var(--text)!important;white-space:nowrap}.scl-new-smart-tt .cell.break,.scl-new-smart-tt .cell.lunch{border-top:3px solid #ff3b30;border-bottom:3px solid #ff3b30}.scl-new-smart-tt .cell.fixed{font-weight:900}.scl-new-smart-tt .school-close{border:3px solid var(--gold);color:var(--gold);background:var(--gold-dim);font-weight:900}.scl-new-smart-tt .alarm-on{box-shadow:0 0 0 2px var(--ok) inset}.scl-new-smart-tt .alarm-off{opacity:.9}.scl-new-smart-tt .tt-scroll-nav{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:4px 0 6px}.scl-new-smart-tt .tt-scroll-nav button{border:1px solid var(--line);background:var(--panel-2);color:var(--text);border-radius:9px;padding:7px 13px;font-weight:900;font-size:.72rem;cursor:pointer;touch-action:manipulation}.scl-new-smart-tt .tt-scroll-nav button:active{background:var(--gold);color:#241d05}.scl-new-smart-tt .tt-scroll-nav span{font-size:.65rem;color:var(--text-dim);font-weight:700;text-align:center;flex:1}.scl-new-smart-tt .table-scroll{scroll-behavior:smooth}
.scl-new-smart-tt .tt-gold-frame{border:3px solid #d4af37;border-radius:18px;padding:10px;background:linear-gradient(180deg,rgba(212,175,55,.08),rgba(212,175,55,.025));box-shadow:0 0 0 1px rgba(212,175,55,.25),0 8px 28px rgba(212,175,55,.10);overflow:hidden}
.scl-new-smart-tt .tt-gold-frame .section-title{color:#f0d56a!important;font-weight:950!important}
.scl-new-smart-tt .tt-gold-frame .table-scroll{border:1px solid rgba(212,175,55,.35);border-radius:12px;padding:8px;margin-bottom:10px;background:rgba(15,18,22,.35)}
.scl-new-smart-tt .tt-gold-frame .tt-scroll-nav{padding:0 2px}
.scl-new-smart-tt .tt-time-stack{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:1px!important;line-height:1.02!important;white-space:nowrap!important;font-weight:950!important}
.scl-new-smart-tt .tt-time-start{color:#39ff88!important;font-weight:950!important}
.scl-new-smart-tt .tt-time-end{color:#ff3b30!important;font-weight:950!important}
.scl-new-smart-tt .tt-time-end::before{content:'🔴 ';font-size:.72em}
.scl-new-smart-tt .tt-break-label,.scl-new-smart-tt .tt-close-label{font-weight:950!important}
.scl-new-smart-tt .tt-bell{font-size:1em;line-height:1;display:inline-block;margin-right:2px}
.scl-new-smart-tt .cell.break,.scl-new-smart-tt .cell.lunch{border-left:3px solid #ff3b30!important;border-right:3px solid #ff3b30!important}
.scl-new-smart-tt .school-close{min-width:100px!important;flex:0 0 100px!important;border:3px solid #d4af37!important;color:#ffe477!important;background:#3a2f10!important;white-space:nowrap}
.scl-new-smart-tt .school-close .tt-time-stack{font-size:.78rem!important}
.scl-new-smart-tt .tt-header-cell{padding:5px 6px!important;min-width:138px!important;white-space:nowrap!important}.scl-new-smart-tt .tt-header-line{display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;min-height:30px!important;line-height:1!important;font-weight:950!important}.scl-new-smart-tt .tt-period-name{font-weight:950!important;color:#ffffff!important;font-size:.72rem!important;letter-spacing:.01em!important}.scl-new-smart-tt .tt-inline-times{display:inline-flex!important;align-items:center!important;gap:3px!important;font-family:"Courier New",monospace!important;font-size:.68rem!important;font-weight:950!important}.scl-new-smart-tt .tt-inline-times .tt-time-start{color:#39ff88!important;font-weight:950!important}.scl-new-smart-tt .tt-inline-times .tt-time-end{color:#ff3b30!important;font-weight:950!important}.scl-new-smart-tt .tt-time-arrow{color:#d4af37!important;font-weight:950!important}.scl-new-smart-tt .tt-alert-cell .tt-header-line{gap:5px!important}.scl-new-smart-tt .tt-alert-cell .tt-bell{font-size:.8rem!important;line-height:1!important}.scl-new-smart-tt .school-close .tt-header-line{color:#ffe477!important}.scl-new-smart-tt .school-close .tt-period-name{color:#ffe477!important}@media(max-width:700px){.scl-new-smart-tt .tt-header-cell{min-width:150px!important;padding:5px 5px!important}.scl-new-smart-tt .tt-header-line{gap:5px!important}.scl-new-smart-tt .tt-period-name{font-size:.66rem!important}.scl-new-smart-tt .tt-inline-times{font-size:.62rem!important}.scl-new-smart-tt .tt-alert-cell{min-width:160px!important}}
.scl-new-smart-tt .notify-btn{font-weight:900!important}
.scl-new-smart-tt .notify-btn .dot{width:9px!important;height:9px!important}
@media(max-width:700px){.scl-new-smart-tt .tt-gold-frame{padding:7px;border-width:2px;border-radius:15px}.scl-new-smart-tt .tt-gold-frame .table-scroll{padding:6px}.scl-new-smart-tt .tt-time-stack{font-size:.64rem!important}.scl-new-smart-tt .tt-time-end::before{font-size:.62em}.scl-new-smart-tt .school-close{min-width:92px!important;flex-basis:92px!important}}
/* Final alignment: period and its stacked times live in the exact same column as the cells below. */
.scl-new-smart-tt .time-header{display:flex!important;margin:0 0 4px 0!important;padding-left:70px!important;align-items:stretch!important;gap:0!important}
.scl-new-smart-tt .time-header .tt-header-cell{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;box-sizing:border-box!important;border:1px solid rgba(212,175,55,.35)!important;border-radius:7px!important;min-width:138px!important;padding:5px 4px!important;background:#24202a!important;overflow:hidden!important}
.scl-new-smart-tt .time-header .tt-header-line{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:2px!important;width:100%!important;min-height:0!important}
.scl-new-smart-tt .time-header .tt-period-name{display:block!important;font-size:.72rem!important;font-weight:950!important;line-height:1.05!important;color:#fff!important;white-space:nowrap!important}
.scl-new-smart-tt .time-header .tt-inline-times{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:0!important;font-family:"Courier New",monospace!important;font-size:.66rem!important;font-weight:950!important;line-height:1.05!important;white-space:nowrap!important}
.scl-new-smart-tt .time-header .tt-time-arrow{display:none!important}
.scl-new-smart-tt .time-header .tt-time-start,.scl-new-smart-tt .time-header .tt-time-end{display:block!important;font-weight:950!important;line-height:1.05!important}
.scl-new-smart-tt .time-header .tt-time-start::before{content:'🟢 ';font-size:.7em}
.scl-new-smart-tt .time-header .tt-time-end::before{content:'🔴 ';font-size:.7em}
.scl-new-smart-tt .time-header .tt-bell{position:absolute!important;margin:0!important;right:4px!important;top:3px!important;font-size:.72rem!important}
.scl-new-smart-tt .time-header .tt-alert-cell{position:relative!important}
.scl-new-smart-tt .time-header .tt-alert-cell .tt-period-name{padding-right:8px!important}
.scl-new-smart-tt .time-header .school-close{min-width:100px!important;flex-basis:100px!important}
@media(max-width:700px){
  .scl-new-smart-tt .time-header{padding-left:54px!important}
  .scl-new-smart-tt .time-header .tt-header-cell{min-width:150px!important;padding:5px 3px!important}
  .scl-new-smart-tt .time-header .tt-period-name{font-size:.64rem!important}
  .scl-new-smart-tt .time-header .tt-inline-times{font-size:.58rem!important}
  .scl-new-smart-tt .time-header .tt-alert-cell{min-width:160px!important}
}


/* FINAL ALIGNMENT: one shared CSS grid controls header and every day row. */
.scl-new-smart-tt .table-scroll{overflow-x:auto!important;overflow-y:hidden!important;position:relative!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior-x:contain!important}
.scl-new-smart-tt .grid{min-width:max-content!important;width:max-content!important}
.scl-new-smart-tt .time-header,.scl-new-smart-tt .day-row{display:grid!important;grid-template-columns:var(--tt-cols)!important;width:max-content!important;margin:0 0 7px 0!important;align-items:stretch!important}
.scl-new-smart-tt .time-header{margin-bottom:7px!important;border:1px solid var(--line);border-radius:10px;overflow:visible!important;background:var(--panel)}
.scl-new-smart-tt .time-header>.tt-day-corner,.scl-new-smart-tt .day-row>.day-label{position:sticky!important;left:0!important;z-index:20!important;width:auto!important;min-width:0!important}
.scl-new-smart-tt .time-header>.tt-day-corner{display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:950;color:#f0d56a;background:#171b21;border-right:2px solid var(--gold);min-height:76px}
.scl-new-smart-tt .day-row>.day-label{border-right:2px solid var(--gold);z-index:19!important;box-shadow:4px 0 7px rgba(0,0,0,.28)}
.scl-new-smart-tt .time-header .tt-header-cell{width:auto!important;min-width:0!important;max-width:none!important;flex:none!important;height:76px!important;display:flex!important;align-items:stretch!important;justify-content:center!important;border-right:1px solid var(--line)!important;border-bottom:0!important;padding:5px 3px!important;position:relative!important}
.scl-new-smart-tt .time-header .tt-header-line{width:100%!important;height:100%!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:4px!important}
.scl-new-smart-tt .time-header .tt-period-name{display:block!important;font-size:.72rem!important;font-weight:950!important;line-height:1.05!important;color:#fff!important;white-space:normal!important;text-align:center!important}
.scl-new-smart-tt .time-header .tt-inline-times{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:2px!important;font-family:"Courier New",monospace!important;font-size:.64rem!important;font-weight:950!important;line-height:1.05!important;white-space:nowrap!important}
.scl-new-smart-tt .time-header .tt-time-start,.scl-new-smart-tt .time-header .tt-time-end{display:block!important;font-weight:950!important;line-height:1.05!important}
.scl-new-smart-tt .time-header .tt-time-start{color:#39ff88!important}.scl-new-smart-tt .time-header .tt-time-end{color:#ff3b30!important}
.scl-new-smart-tt .time-header .tt-time-start::before{content:'🟢 ';font-size:.7em}.scl-new-smart-tt .time-header .tt-time-end::before{content:'🔴 ';font-size:.7em}
.scl-new-smart-tt .time-header .tt-bell{position:absolute!important;right:4px!important;top:3px!important;margin:0!important;font-size:.72rem!important}
.scl-new-smart-tt .day-row{background:var(--panel);border:1px solid var(--line);border-radius:10px;overflow:visible!important}
.scl-new-smart-tt .day-row>.cell{width:auto!important;min-width:0!important;max-width:none!important;flex:none!important;display:flex!important;box-sizing:border-box!important;border-right:1px solid var(--line)!important}
.scl-new-smart-tt .day-row>.cell:last-child{border-right:none!important}
.scl-new-smart-tt .day-row>.cell.teach{min-width:0!important}
.scl-new-smart-tt .day-row>.cell.break,.scl-new-smart-tt .day-row>.cell.lunch{min-width:0!important}
.scl-new-smart-tt .school-close{min-width:0!important;width:auto!important;flex:none!important}
@media(max-width:700px){
 .scl-new-smart-tt .grid{min-width:max-content!important}
 .scl-new-smart-tt .time-header,.scl-new-smart-tt .day-row{grid-template-columns:var(--tt-cols)!important}
 .scl-new-smart-tt .time-header>.tt-day-corner,.scl-new-smart-tt .day-row>.day-label{width:auto!important}
 .scl-new-smart-tt .time-header .tt-header-cell{height:82px!important;padding:5px 3px!important}
 .scl-new-smart-tt .time-header .tt-period-name{font-size:.64rem!important}
 .scl-new-smart-tt .time-header .tt-inline-times{font-size:.57rem!important}
}


`;
  function ensureCss(){if(document.getElementById('scl-smart-timetable-single-css'))return;const st=document.createElement('style');st.id='scl-smart-timetable-single-css';st.textContent=TT_CSS;document.head.appendChild(st)}
  const PRIMARY=['Primary 1','Primary 2','Primary 3','Primary 4','Primary 5','Primary 6'], SECONDARY=['JSS 1','JSS 2','JSS 3','SS 1','SS 2','SS 3'];
  const DOW={1:'mon',2:'tue',3:'wed',4:'thu',5:'fri'};
  const CLASS_COLORS={'Primary 1':'hsl(0,70%,55%)','Primary 2':'hsl(30,75%,50%)','Primary 3':'hsl(55,70%,42%)','Primary 4':'hsl(95,50%,42%)','Primary 5':'hsl(150,50%,38%)','Primary 6':'hsl(180,45%,38%)','JSS 1':'hsl(210,55%,50%)','JSS 2':'hsl(240,50%,58%)','JSS 3':'hsl(268,50%,55%)','SS 1':'hsl(295,45%,48%)','SS 2':'hsl(325,55%,50%)','SS 3':'hsl(12,65%,50%)'};
  const SCHEDULES={A:[['asm','fixed','07:30','08:20','Assembly'],['prep','fixed','08:22','08:30','Preparation / Arrangement'],['p1','teach','08:30','09:25'],['p2','teach','09:25','10:20'],['p3','teach','10:20','11:15'],['b1','break','11:15','11:30','Lunch & Refreshment'],['p4','teach','11:30','12:25'],['l1','lunch','12:25','13:05','Leisure Break'],['p5','teach','13:05','14:00'],['p6','teach','14:00','14:55'],['close','fixed','15:00','15:00','School closes']],FRI:[['asm','fixed','07:30','08:20','Assembly'],['prep','fixed','08:22','08:30','Preparation / Arrangement'],['p1','teach','08:30','09:20'],['p2','teach','09:20','10:10'],['p3','teach','10:10','11:00'],['p4','teach','11:00','11:50'],['b1','break','11:50','12:30','Lunch & Refreshment'],['f1','fellowship','12:30','13:00','Fellowship']]};
  let state={section:'secondary',variant:'A',primaryClass:PRIMARY[0],secondaryClass:SECONDARY[0]}, data={primarySubjects:{},primaryTeachers:{},secondary:{}};
  try{const raw=localStorage.getItem('smart-tt-v2');if(raw)data=Object.assign(data,JSON.parse(raw))}catch(e){}
  const save=()=>{try{localStorage.setItem('smart-tt-v2',JSON.stringify(data))}catch(e){}};
  const path=(o,keys)=>{let x=o;for(const k of keys){if(!x)return undefined;x=x[k]}return x};
  const setPath=(o,keys,val)=>{let x=o;for(let i=0;i<keys.length-1;i++){if(!x[keys[i]])x[keys[i]]={};x=x[keys[i]]}x[keys[keys.length-1]]=val};
  let timer,notifyOn=false,lastId=null,warned=null,live={key:null,day:null,id:null};
  function toast(msg){const t=document.querySelector('#sclSmartTimetable .toast');if(!t)return;t.textContent=msg;t.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>t.classList.remove('show'),4000)}
  function shell(){ensureCss();const b=document.getElementById('sclSuiteBody');if(!b)return;b.innerHTML=`<div id="sclSmartTimetable" class="scl-new-smart-tt"><div class="wrap"><div class="clock-panel"><div class="led" id="clock">--:--:--</div><div class="date-line" id="dateLine">—</div><div class="status-pill" id="statusPill">Loading…</div></div><div class="controls"><div class="seg" id="sectionSeg"><button data-v="primary">Primary</button><button data-v="secondary">Secondary</button></div><button class="notify-btn" id="notifyBtn"><span class="dot"></span><span id="notifyLabel">Alerts</span></button></div><div class="controls"><select class="classpick" id="classPick"></select><div class="tt-fixed-note">Mon–Thu: 55-minute periods • School closes 3:00 PM</div></div><div id="classBadge"></div><div id="teacherBox"></div><div id="ttModeNote" class="tt-mode-note"></div><div class="tt-gold-frame"><div class="section-title">MONDAY – THURSDAY</div><div class="tt-scroll-nav"><button type="button" data-scroll="mainGrid" data-dir="left">◀ Previous</button><span>Swipe left/right or use the buttons to see the full timetable</span><button type="button" data-scroll="mainGrid" data-dir="right">Next ▶</button></div><div class="table-scroll" data-scroll-box="mainGrid"><div class="grid" id="mainGrid"></div></div><div class="section-title">FRIDAY — fixed 50-minute schedule</div><div class="tt-scroll-nav"><button type="button" data-scroll="friGrid" data-dir="left">◀ Previous</button><span>Swipe left/right or use the buttons to see the full Friday timetable</span><button type="button" data-scroll="friGrid" data-dir="right">Next ▶</button></div><div class="table-scroll" data-scroll-box="friGrid"><div class="grid" id="friGrid"></div></div></div></div><div class="toast" id="toastTimetable"></div></div>`;init()}
  function init(){const root=document.getElementById('sclSmartTimetable');if(!root)return;function wire(id,fn){root.querySelectorAll('#'+id+' button').forEach(btn=>{btn.classList.toggle('active',btn.dataset.v===state[id==='sectionSeg'?'section':'variant']);btn.onclick=()=>{root.querySelectorAll('#'+id+' button').forEach(x=>x.classList.remove('active'));btn.classList.add('active');fn(btn.dataset.v)}})}
    wire('sectionSeg',v=>{state.section=v;renderAll()});
    const cp=root.querySelector('#classPick');cp.onchange=()=>{if(state.section==='primary')state.primaryClass=cp.value;else state.secondaryClass=cp.value;renderAll()};
    const nb=root.querySelector('#notifyBtn');const canControl=!!window.sclCanControlTimetableAlerts?.();let master=true;try{master=localStorage.getItem('sclTimetableAlertsMaster')!=='0'}catch(_){};if(!canControl){nb.style.display='none';notifyOn=master}else{try{notifyOn=master}catch(e){notifyOn=true};setNotify(nb,notifyOn);nb.onclick=async(e)=>{e.preventDefault();e.stopPropagation();const next=!notifyOn;setNotify(nb,next);try{localStorage.setItem('sclTimetableAlertsMaster',next?'1':'0');localStorage.setItem('tt-notify',next?'1':'0')}catch(_){};window.dispatchEvent(new Event('scl:timetable-alert-setting'));if(next&&('Notification'in window)&&Notification.permission==='default'){try{await Notification.requestPermission()}catch(_){} }}};wireScrollNav(root);renderAll();tick();clearInterval(window.__sclSmartTTTimer);window.__sclSmartTTTimer=setInterval(tick,1000)}
  function setNotify(btn,on=notifyOn){if(!btn)return;notifyOn=!!on;btn.classList.toggle('on',notifyOn);btn.classList.toggle('alarm-on',notifyOn);btn.classList.toggle('alarm-off',!notifyOn);const label=btn.querySelector('#notifyLabel');if(label)label.textContent=notifyOn?'Alerts ON':'Enable alerts';btn.setAttribute('aria-pressed',notifyOn?'true':'false');try{localStorage.setItem('tt-notify',notifyOn?'1':'0')}catch(e){}}
  function wireScrollNav(root){root.querySelectorAll('.tt-scroll-nav button[data-scroll]').forEach(btn=>{btn.onclick=()=>{const box=root.querySelector('[data-scroll-box="'+btn.dataset.scroll+'"]');if(!box)return;const amount=Math.max(260,Math.round(box.clientWidth*.72));box.scrollBy({left:btn.dataset.dir==='right'?amount:-amount,behavior:'smooth'});};});}
  function currentClass(){return state.section==='primary'?state.primaryClass:state.secondaryClass}
  function conflict(day,id,name,own){if(!name.trim())return false;for(const cls of SECONDARY){if(cls===own)continue;const c=path(data.secondary,[cls,day==='fri'?'FRI':'A',day,id]);if(c&&c.teacher&&c.teacher.trim().toLowerCase()===name.trim().toLowerCase())return cls}return false}
  function timetableAdmin(){try{return typeof isAdmin==='function'&&isAdmin()}catch(e){return false}}
  function teacherLiveAssignments(){let rows=[];try{rows=JSON.parse(localStorage.getItem('sclWorkerRecords')||'[]')}catch(e){rows=[]}const out={};rows.forEach(r=>{if(r.mode!=='staff'||r.role!=='Teacher'||!r.timetableRegistration)return;const t=r.timetableRegistration;if(!t.day||!t.className||!t.subject)return;const key=t.day==='fri'?'FRI':(t.variant||'A');const ps=SCHEDULES[key]||[];const hit=ps.find(p=>p[1]==='teach'&&p[2]===t.start&&p[3]===t.end);if(!hit)return;out[t.className]??={};out[t.className][key]??={};out[t.className][key][t.day]??={};out[t.className][key][t.day][hit[0]]={subject:t.subject,teacher:t.teacher||r.fullName||''}});return out}
  function effectiveCell(cls,key,day,id){const draft=path(data.secondary,[cls,key,day,id]);if(draft&&(draft.subject||draft.teacher))return draft;return path(teacherLiveAssignments(),[cls,key,day,id])||{}}
  function build(container,days,key){
    container.innerHTML='';
    const ps=SCHEDULES[key];
    /* One geometry only: every row owns the same columns. There is deliberately
       no separate period/time header, so the time can never drift away from its cell. */
    const colWidths=ps.map(p=>p[0]==='close'?'112px':(p[1]==='teach'?'158px':(p[1]==='fixed'?'132px':'118px'))).join(' ');
    const template='70px '+colWidths;
    container.style.setProperty('--tt-cols',template);
    container.classList.add('tt-shared-grid');

    function addTime(cell,start,end){
      const t=document.createElement('div');
      t.className='tt-cell-time';
      const st=document.createElement('span');st.className='tt-time-start';st.textContent=start;
      const en=document.createElement('span');en.className='tt-time-end';en.textContent=end;
      t.append(st,en);
      cell.appendChild(t);
    }

    days.forEach(day=>{
      const row=document.createElement('div');
      row.className='day-row '+day;
      row.style.gridTemplateColumns=template;
      const lab=document.createElement('div');
      lab.className='day-label';
      lab.textContent=day.toUpperCase();
      row.appendChild(lab);
      let n=0;

      ps.forEach(p=>{
        const [id,type,start,end,label]=p;
        const cell=document.createElement('div');
        cell.className='cell '+type+(id==='close'?' school-close':'');
        if(live.key===key&&live.day===day&&live.id===id)cell.classList.add('active');
        addTime(cell,start,end);

        if(type==='teach'){
          n++;
          if(state.section==='primary'){
            if(key==='A'&&id==='p6'){
              const tag=document.createElement('div');tag.className='tt-cell-role';tag.textContent='SCHOOL LESSON PERIOD';cell.appendChild(tag);
            }
            if(key==='A'&&id==='p5'&&day==='wed'){
              const tag=document.createElement('div');tag.className='tt-cell-role activity';tag.textContent='ACTIVITY PERIOD';cell.appendChild(tag);
            }
            const inp=document.createElement('input');
            inp.className='subject';
            inp.placeholder=(key==='A'&&id==='p5'&&day==='wed')?'Activity / subject':'P'+n;
            inp.value=path(data.primarySubjects,[key,day,id])||'';
            inp.readOnly=!timetableAdmin();
            if(timetableAdmin())inp.oninput=e=>{setPath(data.primarySubjects,[key,day,id],e.target.value);save()};
            cell.appendChild(inp);
          }else{
            const cls=state.secondaryClass,c=effectiveCell(cls,key,day,id),editable=timetableAdmin();
            if(key==='A'&&id==='p6'){
              const tag=document.createElement('div');tag.className='tt-cell-role';tag.textContent='SCHOOL LESSON PERIOD';cell.appendChild(tag);
            }
            if(key==='A'&&id==='p5'&&day==='wed'){
              const tag=document.createElement('div');tag.className='tt-cell-role activity';tag.textContent='ACTIVITY PERIOD';cell.appendChild(tag);
            }
            const subj=document.createElement('input');
            subj.className='subject';
            subj.placeholder=(key==='A'&&id==='p5'&&day==='wed')?'Activity / subject':'P'+n;
            subj.value=c.subject||'';subj.readOnly=!editable;
            const teacher=document.createElement('input');
            teacher.placeholder='Teacher';teacher.value=c.teacher||'';teacher.readOnly=!editable;
            if(editable){
              subj.oninput=e=>{setPath(data.secondary,[cls,key,day,id,'subject'],e.target.value);save()};
              teacher.oninput=e=>{setPath(data.secondary,[cls,key,day,id,'teacher'],e.target.value);save()};
              teacher.onblur=e=>{const clash=conflict(day,id,e.target.value,cls);teacher.classList.toggle('conflict',!!clash);if(clash)toast((e.target.value.trim()||'This teacher')+' already teaches '+clash+' at this time.')};
            }
            cell.append(subj,teacher);
          }
        }else{
          const activity=document.createElement('div');
          activity.className='tt-fixed-label';
          activity.textContent=label||type;
          cell.appendChild(activity);
          if(type==='break'||type==='lunch'||id==='close'){
            const bell=document.createElement('span');bell.className='tt-bell';bell.textContent='🔔';cell.appendChild(bell);
          }
        }
        row.appendChild(cell);
      });
      container.appendChild(row);
    });
  }
  function renderAll(){const root=document.getElementById('sclSmartTimetable');if(!root)return;const list=state.section==='primary'?PRIMARY:SECONDARY,cp=root.querySelector('#classPick');const wanted=currentClass();if(cp.dataset.section!==state.section){cp.innerHTML=list.map(c=>'<option value="'+c.replace(/"/g,'&quot;')+'">'+c+'</option>').join('');cp.dataset.section=state.section}if([...cp.options].some(o=>o.value===wanted))cp.value=wanted;else{if(state.section==='primary')state.primaryClass=PRIMARY[0];else state.secondaryClass=SECONDARY[0];cp.value=currentClass()}root.querySelector('#classBadge').innerHTML='<span class="class-badge" style="background:'+CLASS_COLORS[currentClass()]+'">'+currentClass()+'</span>';const note=root.querySelector('#ttModeNote');if(note)note.textContent=timetableAdmin()?'ADMIN DRAFT MODE — edit directly on the timetable. Teacher registrations remain the live source.':'LIVE TIMETABLE — teacher registrations supply the live schedule; administrator draft edits are read-only here.';const tb=root.querySelector('#teacherBox');if(state.section==='primary'){const name=data.primaryTeachers[state.primaryClass]||'';tb.innerHTML='<div class="teacher-box"><strong>Class teacher — '+state.primaryClass+'</strong><input id="ptInput" placeholder="Assign teacher" value="'+name.replace(/"/g,'&quot;')+'"></div>';tb.querySelector('#ptInput').oninput=e=>{data.primaryTeachers[state.primaryClass]=e.target.value;save()}}else tb.innerHTML='';build(root.querySelector('#mainGrid'),['mon','tue','wed','thu'],'A');build(root.querySelector('#friGrid'),['fri'],'FRI')}
  function min(x){const a=x.split(':').map(Number);return a[0]*60+a[1]}
  function tick(){const root=document.getElementById('sclSmartTimetable');if(!root)return;const previousLive=live.key+'|'+live.day+'|'+live.id;const now=new Date(),pad=n=>String(n).padStart(2,'0');root.querySelector('#clock').textContent=pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());root.querySelector('#dateLine').textContent=now.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});const day=DOW[now.getDay()],status=root.querySelector('#statusPill');if(!day){status.textContent='No school today';status.classList.remove('live');live={key:null,day:null,id:null};if(previousLive!=='null|null|null')renderAll();return}const key=day==='fri'?'FRI':'A',ps=SCHEDULES[key],m=now.getHours()*60+now.getMinutes()+now.getSeconds()/60,active=ps.find(p=>m>=min(p[2])&&m<min(p[3]));if(active){const [id,type,,end,label]=active;live={key,day,id};const name=type==='teach'?'Period '+(ps.filter(p=>p[1]==='teach').findIndex(p=>p[0]===id)+1):(label||type);status.innerHTML='Now: <strong>'+name+'</strong> <span class="sub">until '+end+'</span>';status.classList.add('live')}else{live={key:null,day:null,id:null};status.textContent='Outside scheduled hours';status.classList.remove('live')}const curId=active?active[0]:null;if(active&&notifyOn&&window.sclRolePolicy?.canReceiveTimetableAlerts?.()){const endMin=min(active[3]);const nowSec=now.getHours()*3600+now.getMinutes()*60+now.getSeconds();const endSec=endMin*60;if(endSec-nowSec===120&&warned!==curId){warned=curId;if('Notification'in window&&Notification.permission==='granted'){try{new Notification('SCL Timetable Alert',{body:(active[4]||'Current period')+' ends at '+active[3]+'.',tag:'scl-timetable-end'})}catch(e){}}}}if(curId!==lastId&&curId!==null&&lastId!==null&&notifyOn&&window.sclRolePolicy?.canReceiveTimetableAlerts?.()){const nm=active?(active[1]==='teach'?'Period '+(ps.filter(p=>p[1]==='teach').findIndex(p=>p[0]===curId)+1):(active[4]||active[1])):'a free period';if('Notification'in window&&Notification.permission==='granted'){try{new Notification('SCL Timetable — Now Starting',{body:nm+(active?.[3]?' • until '+active[3]:''),tag:'scl-timetable-start'})}catch(e){}}}lastId=curId;const nextLive=live.key+'|'+live.day+'|'+live.id;if(nextLive!==previousLive)renderAll()}
  window.__sclSmartTimetableShell=shell;window.addEventListener('storage',e=>{if(e.key==='sclWorkerRecords'||e.key==='smart-tt-v2'){if(document.getElementById('sclSmartTimetable'))renderAll()}});window.addEventListener('scl:timetable-live-update',()=>{if(document.getElementById('sclSmartTimetable'))renderAll()});
  window.sclSuiteTab=function(tab){const b=document.getElementById('sclSuiteBody');if(!b)return;const modal=document.getElementById('sclSuiteModal');document.querySelectorAll('.scl-suite-tabs button').forEach(x=>x.classList.remove('active'));document.getElementById('sclTab-'+tab)?.classList.add('active');if(tab==='timetable'){modal?.classList.add('scl-timetable-only-mode');const h=modal?.querySelector('.mh h3');if(h)h.textContent='SCHOOL TIMETABLE';shell();return}modal?.classList.remove('scl-timetable-only-mode');const h=modal?.querySelector('.mh h3');if(h)h.textContent='SCL STAFF & SCHOOL MANAGEMENT PORTAL';document.querySelectorAll('.scl-suite-tabs').forEach(x=>x.classList.remove('scl-timetable-only-tabs-hidden'));if(tab==='attendance'&&typeof renderStudentAttendance==='function'){renderStudentAttendance();return}const routes={cbt:()=>toast('CBT & Online Tests workspace is ready for question/test management.'),assignments:()=>toast('Assignments & Assessment workspace is ready.'),lessons:()=>toast('Lesson Notes / Plans workspace is ready.'),promotion:()=>{closeM('sclSuiteModal');document.querySelector('[onclick*="promotion"]')?.click()},bulk:()=>toast('Bulk Data / Excel workspace is ready.'),engagement:()=>{closeM('sclSuiteModal');if(typeof openCollaboration==='function')openCollaboration()}};if(routes[tab])routes[tab]();else b.innerHTML='<div class="paybox"><b>'+String(tab).toUpperCase()+'</b><p>Use the SCL shortcut panel or management portal buttons above to open this module.</p></div>'};
})();
</script>
<style id="scl-timetable-exact-column-alignment">
/* Exact timetable alignment: header and every day row share the identical column geometry.
   No outer border is allowed to shift a column by even 1px. */
.scl-new-smart-tt .table-scroll{
  padding:0!important;
  overflow-x:auto!important;
  overflow-y:hidden!important;
}
.scl-new-smart-tt .grid{
  width:max-content!important;
  min-width:max-content!important;
}
.scl-new-smart-tt .time-header,
.scl-new-smart-tt .day-row{
  display:grid!important;
  width:max-content!important;
  margin:0!important;
  border:0!important;
  border-radius:0!important;
  box-sizing:border-box!important;
  grid-template-columns:var(--tt-cols)!important;
}
.scl-new-smart-tt .time-header{
  background:var(--panel)!important;
}
.scl-new-smart-tt .time-header>.tt-day-corner,
.scl-new-smart-tt .day-row>.day-label{
  grid-column:1!important;
  width:auto!important;
  min-width:0!important;
  max-width:none!important;
  box-sizing:border-box!important;
  margin:0!important;
  border-radius:0!important;
  position:sticky!important;
  left:0!important;
}
.scl-new-smart-tt .time-header>.tt-day-corner{
  border:0!important;
  border-right:2px solid var(--gold)!important;
  min-height:82px!important;
  background:#171b21!important;
}
.scl-new-smart-tt .day-row>.day-label{
  border:0!important;
  border-right:2px solid var(--gold)!important;
  box-shadow:4px 0 7px rgba(0,0,0,.28)!important;
  z-index:30!important;
}
.scl-new-smart-tt .time-header .tt-header-cell,
.scl-new-smart-tt .day-row>.cell{
  width:auto!important;
  min-width:0!important;
  max-width:none!important;
  flex:none!important;
  box-sizing:border-box!important;
  margin:0!important;
  border-top:0!important;
  border-left:0!important;
  border-bottom:0!important;
  border-right:1px solid var(--line)!important;
  border-radius:0!important;
}
.scl-new-smart-tt .time-header .tt-header-cell{
  height:82px!important;
  padding:5px 3px!important;
  position:relative!important;
}
.scl-new-smart-tt .day-row>.cell{
  min-height:88px!important;
  padding:6px 4px!important;
}
.scl-new-smart-tt .time-header .tt-header-cell:last-child,
.scl-new-smart-tt .day-row>.cell:last-child{
  border-right:0!important;
}
/* The first period starts on precisely the same x-coordinate in the header and every row. */
.scl-new-smart-tt .time-header .tt-header-cell:first-of-type,
.scl-new-smart-tt .day-row>.cell:nth-child(2){
  border-left:0!important;
}
/* Header sits directly on top of the period cells: no spacer, no offset. */
.scl-new-smart-tt .time-header + .day-row{
  margin-top:0!important;
}
.scl-new-smart-tt .day-row + .day-row{
  margin-top:0!important;
  border-top:1px solid var(--line)!important;
}
@media(max-width:700px){
  .scl-new-smart-tt .time-header>.tt-day-corner,
  .scl-new-smart-tt .day-row>.day-label{
    width:auto!important;
    min-width:0!important;
  }
  .scl-new-smart-tt .time-header .tt-header-cell{height:82px!important}
  .scl-new-smart-tt .day-row>.cell{min-height:88px!important}
}
</style>
<style id="scl-timetable-time-inside-cell">
/* FINAL CHILD-FRIENDLY TIMETABLE: time belongs to the same cell as the activity. */
.scl-new-smart-tt .time-header{display:none!important}
.scl-new-smart-tt .table-scroll{padding:0!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;touch-action:pan-x pan-y!important}
.scl-new-smart-tt .grid{width:max-content!important;min-width:max-content!important}
.scl-new-smart-tt .day-row{display:grid!important;grid-template-columns:var(--tt-cols)!important;width:max-content!important;margin:0!important;border:0!important;border-radius:0!important;overflow:visible!important;box-sizing:border-box!important}
.scl-new-smart-tt .day-row>.day-label{grid-column:1!important;position:sticky!important;left:0!important;z-index:40!important;width:auto!important;min-width:0!important;max-width:none!important;box-sizing:border-box!important;margin:0!important;border:0!important;border-right:3px solid var(--gold)!important;border-radius:0!important;box-shadow:4px 0 8px rgba(0,0,0,.34)!important}
.scl-new-smart-tt .day-row>.cell{width:auto!important;min-width:0!important;max-width:none!important;flex:none!important;box-sizing:border-box!important;margin:0!important;border-top:0!important;border-left:0!important;border-bottom:1px solid var(--line)!important;border-right:1px solid var(--line)!important;border-radius:0!important;min-height:112px!important;padding:7px 5px!important;position:relative!important;overflow:hidden!important}
.scl-new-smart-tt .day-row>.cell:last-child{border-right:0!important}
.scl-new-smart-tt .tt-cell-time{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:1px!important;line-height:1.05!important;font-family:"Courier New",monospace!important;font-size:.62rem!important;font-weight:950!important;white-space:nowrap!important;margin:0 0 7px!important;padding:3px 2px!important;border-bottom:1px solid rgba(212,175,55,.28)!important;width:100%!important}
.scl-new-smart-tt .tt-cell-time .tt-time-start{display:block!important;color:#39ff88!important;font-weight:950!important}
.scl-new-smart-tt .tt-cell-time .tt-time-end{display:block!important;color:#ff3b30!important;font-weight:950!important}
.scl-new-smart-tt .tt-cell-time .tt-time-start::before{content:'🟢 ';font-size:.72em}
.scl-new-smart-tt .tt-cell-time .tt-time-end::before{content:'🔴 ';font-size:.72em}
.scl-new-smart-tt .tt-fixed-label{font-weight:950!important;font-size:.72rem!important;line-height:1.15!important;text-align:center!important;color:var(--text)!important;max-width:100%!important}
.scl-new-smart-tt .cell.teach .subject{margin-top:1px!important}
.scl-new-smart-tt .cell.teach .tt-cell-role{margin:0 0 4px!important}
.scl-new-smart-tt .cell.break,.scl-new-smart-tt .cell.lunch{min-height:112px!important}
.scl-new-smart-tt .cell.break .tt-fixed-label,.scl-new-smart-tt .cell.lunch .tt-fixed-label{color:#ff7a70!important}
.scl-new-smart-tt .school-close .tt-fixed-label{color:#ffe477!important}
.scl-new-smart-tt .school-close .tt-cell-time{border-bottom-color:rgba(212,175,55,.55)!important}
.scl-new-smart-tt .tt-bell{position:absolute!important;right:5px!important;top:5px!important;font-size:.8rem!important;line-height:1!important}
.scl-new-smart-tt .day-row + .day-row{border-top:1px solid var(--line)!important}
@media(max-width:700px){
 .scl-new-smart-tt .day-row>.cell{min-height:118px!important;padding:6px 4px!important}
 .scl-new-smart-tt .tt-cell-time{font-size:.52rem!important;margin-bottom:6px!important}
 .scl-new-smart-tt .tt-fixed-label{font-size:.62rem!important}
 .scl-new-smart-tt .day-row>.day-label{font-size:.62rem!important}
 .scl-new-smart-tt .cell input{font-size:.55rem!important;padding:4px 2px!important}
 .scl-new-smart-tt .cell input.subject{font-size:.58rem!important}
}
</style>
<style id="scl-timetable-standalone-final">
/* Standalone timetable mode: unrelated suite tabs disappear while timetable is open. */
.scl-suite-tabs.scl-timetable-only-tabs-hidden{display:none!important}
.scl-timetable-standalone{padding:10px 0!important}
.scl-timetable-title{padding:4px 2px 8px!important}
.scl-timetable-title h3{font-size:clamp(18px,2.2vw,25px)!important;letter-spacing:.02em!important}
.scl-timetable-title p{margin:5px 0 4px!important;font-size:12px!important}
.scl-timetable-management{margin-top:14px;padding:10px;border:1px solid #ead5b6;border-radius:14px;background:linear-gradient(145deg,rgba(255,250,240,.96),rgba(247,241,229,.96))}
.scl-timetable-management-title{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px;color:#650007}
.scl-timetable-management-title span{font-size:11px;color:#6a5d52;font-weight:600}
@media(max-width:600px){.scl-timetable-standalone{padding:4px 0!important}.scl-timetable-management{padding:8px}.scl-timetable-management-title{font-size:12px}.scl-timetable-management-title span{width:100%;font-size:10px}}
</style>
<style id="scl-timetable-only-mode-css">
/* Timetable mode: the suite modal contains ONLY the timetable workspace. */
#sclSuiteModal.scl-timetable-only-mode .scl-suite-note,
#sclSuiteModal.scl-timetable-only-mode .scl-suite-grid,
#sclSuiteModal.scl-timetable-only-mode .scl-suite-all-tools,
#sclSuiteModal.scl-timetable-only-mode .scl-suite-tabs{display:none!important}
#sclSuiteModal.scl-timetable-only-mode #sclSuiteBody{display:block!important;padding:0!important;margin:0!important}
#sclSuiteModal.scl-timetable-only-mode .card{width:min(1180px,96vw)!important}
</style>
<style id="scl-v70-timetable-final-css">
.scl-v70-timetable{padding:14px}.scl-v70-tt-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}.scl-v70-tt-head h3{margin:0;color:#650007}.scl-v70-tt-head p{margin:5px 0 12px;color:#66574a}.scl-tt-time-badge{padding:9px 12px;border-radius:999px;background:#fff1c9;border:1px solid #e2bd56;color:#650007;font-weight:800}.scl-tt-mode-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 12px}.scl-tt-mode{border:1px solid #cdbd9f;background:#fff;padding:10px 14px;border-radius:10px;font-weight:900;cursor:pointer;color:#650007}.scl-tt-mode.active{background:#650007;color:#fff;border-color:#650007}.scl-v70-tt-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:10px 0}.scl-v70-tt-controls label{font-weight:800;color:#650007}.scl-v70-tt-controls select,.scl-v70-tt-controls input{display:block;width:100%;margin-top:5px;padding:10px;border:1px solid #d6c5a3;border-radius:9px;background:#fff}.scl-v70-tt-editor-actions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.scl-v70-tt-status{padding:10px;border-radius:10px;background:#f7f2e7;margin:10px 0;font-size:13px}.scl-v70-week-wrap{overflow:auto;border:1px solid #ded4c5;border-radius:12px;box-shadow:0 8px 24px rgba(70,40,20,.08)}.scl-v70-week{width:100%;border-collapse:separate;border-spacing:0;min-width:1120px;background:#fff}.scl-v70-week th,.scl-v70-week td{padding:8px;border-right:1px solid #e8e1d6;border-bottom:1px solid #e8e1d6;vertical-align:top}.scl-v70-week thead th{background:#650007;color:#fff;text-align:center;position:sticky;top:0;z-index:2}.scl-v70-week thead th:first-child{position:sticky;left:0;z-index:4}.scl-v70-week tbody>tr>th{position:sticky;left:0;z-index:1;width:170px;text-align:left}.scl-v70-week tbody>tr>th small,.scl-v70-week tbody>tr>th em{display:block;font-size:11px;font-style:normal;color:#5b4e43;margin-top:3px}.scl-v70-week td{height:94px;min-width:175px}.scl-tt-period-label{color:#3e3025}.scl-tt-empty-cell{height:72px;border:1px dashed rgba(60,40,20,.18);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#6c6259;font-weight:900;background:rgba(255,255,255,.42)}.scl-tt-empty-cell small{font-weight:600}.scl-tt-cell-entry{width:100%;min-height:72px;text-align:left;border:1px solid rgba(60,40,20,.18);border-radius:9px;padding:8px;cursor:pointer;color:#2e241e;box-shadow:0 3px 10px rgba(60,40,20,.08);transition:transform .15s,box-shadow .15s,outline .15s}.scl-tt-cell-entry:hover{transform:translateY(-1px);box-shadow:0 6px 14px rgba(60,40,20,.12)}.scl-tt-cell-entry b,.scl-tt-cell-entry small{display:block}.scl-tt-cell-entry small{margin-top:4px;color:#4f463f}.scl-tt-highlight{outline:4px solid #fff;box-shadow:0 0 0 5px #650007,0 10px 24px rgba(101,0,7,.28)!important;transform:translateY(-2px) scale(1.015)}
.scl-tt-period-p1{background:#e9f7ff}.scl-tt-period-p2{background:#eaf8ea}.scl-tt-period-p3{background:#fff3d9}.scl-tt-period-sb{background:#e9ddff}.scl-tt-period-p4{background:#ffe5ed}.scl-tt-period-lb{background:#dff7f2}.scl-tt-period-p5{background:#e8edff}.scl-tt-period-p6{background:#fff0c7}.scl-tt-period-lesson{background:#e8f4e8}.scl-tt-row-p1 td,.scl-tt-row-p1 th{background:#e9f7ff}.scl-tt-row-p2 td,.scl-tt-row-p2 th{background:#eaf8ea}.scl-tt-row-p3 td,.scl-tt-row-p3 th{background:#fff3d9}.scl-tt-row-sb td,.scl-tt-row-sb th{background:#e9ddff}.scl-tt-row-p4 td,.scl-tt-row-p4 th{background:#ffe5ed}.scl-tt-row-lb td,.scl-tt-row-lb th{background:#dff7f2}.scl-tt-row-p5 td,.scl-tt-row-p5 th{background:#e8edff}.scl-tt-row-p6 td,.scl-tt-row-p6 th{background:#fff0c7}.scl-tt-row-lesson td,.scl-tt-row-lesson th{background:#e8f4e8}.scl-tt-row-sb .scl-tt-empty-cell,.scl-tt-row-lb .scl-tt-empty-cell{font-size:12px}.scl-day-close{display:block;font-size:10px;color:#ffe8a8;margin-top:3px;font-weight:800}.scl-day-close:not(.friday){color:#d9ffdc}.scl-tt-panel-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin:14px 0 8px;padding:12px;border-radius:12px;background:#fff8df;border-left:4px solid #b88a32}.scl-tt-panel-title b,.scl-tt-panel-title small{display:block}.scl-tt-panel-title small{color:#6a5d52;margin-top:3px}.scl-tt-panel-title>span{font-weight:900;color:#650007}.scl-tt-secondary-directory{display:grid;gap:10px}.scl-tt-class-card{border:1px solid #ded4c5;border-radius:12px;background:#fff;padding:10px}.scl-tt-class-card.current{border-color:#650007;box-shadow:0 0 0 2px rgba(101,0,7,.08)}.scl-tt-class-card-head{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:8px;color:#650007}.scl-tt-class-card-head span{font-size:11px;color:#6a5d52;font-weight:800}.scl-tt-secondary-directory .scl-tt-day-teacher-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.scl-tt-day-teacher-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.scl-tt-day-card{padding:9px;border:1px solid #ded4c5;border-radius:11px;background:#fff;min-height:130px}.scl-tt-day-card h4{margin:0 0 7px;color:#650007;display:flex;justify-content:space-between}.scl-tt-day-card h4 span{background:#650007;color:#fff;border-radius:999px;padding:2px 7px;font-size:11px}.scl-tt-teacher-chip{display:block;width:100%;text-align:left;margin:5px 0;padding:8px;border:1px solid #d9cdbb;border-radius:9px;background:#faf7f0;cursor:pointer}.scl-tt-teacher-chip:hover,.scl-tt-teacher-chip.selected{border-color:#650007;background:#fff0d1;box-shadow:0 0 0 2px rgba(101,0,7,.1)}.scl-tt-teacher-chip b,.scl-tt-teacher-chip small{display:block}.scl-tt-teacher-chip small{margin-top:2px;color:#6a5d52}.scl-tt-no-teacher{font-size:12px;color:#85796f;padding:8px 2px}.scl-tt-panel-note{margin:14px 0;padding:11px;border-radius:10px;background:#f5f0e6;color:#5f5144}.scl-tt-teacher-summary{margin-top:9px;padding:10px;border-radius:10px;background:#f7f2e7;color:#5f5144;min-height:20px}.scl-v70-tt-detail{margin-top:12px;padding:12px;border-radius:10px;background:#fff9e9;border-left:4px solid #b88a32;line-height:1.7}.scl-v70-tt-detail:empty{display:none}.scl-tt-detail-head{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.scl-tt-rule{margin-top:12px;padding:12px;border-radius:10px;background:#f5f0e6;color:#5f5144;font-size:13px}@media(max-width:1000px){.scl-tt-day-teacher-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.scl-v70-tt-controls{grid-template-columns:1fr 1fr}.scl-tt-day-teacher-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.scl-v70-tt-controls{grid-template-columns:1fr}.scl-v70-timetable{padding:8px}.scl-tt-day-teacher-grid{grid-template-columns:1fr}.scl-tt-mode{width:100%}}
</style>
<style id="scl-hub-css">/* ---------- per-tier animations (portable: pure CSS, no JS timers) ---------- */
  /* Tier 0 (1-10): breathing */
  @keyframes anim-breathe{ 0%,100%{transform:scale(1);} 50%{transform:scale(1.08);} }
  .t-breathe{ animation:anim-breathe 4s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 1 (11-20): steady rotation, once every 2s */
  @keyframes anim-rotate-cw{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }
  .t-rotate-cw{ animation:anim-rotate-cw 2s linear infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 2 (21-30): pulsing glow */
  @keyframes anim-pulse-glow{ 0%,100%{filter:drop-shadow(0 0 2px currentColor) brightness(1);} 50%{filter:drop-shadow(0 0 7px currentColor) brightness(1.3);} }
  .t-pulse-glow{ animation:anim-pulse-glow 2.6s ease-in-out infinite; }

  /* Tier 3 (31-40): shimmer sweep — handled via SMIL inside the SVG itself */

  /* Tier 4 (41-49): sway, like a pendulum */
  @keyframes anim-sway{ 0%,100%{transform:rotate(-9deg);} 50%{transform:rotate(9deg);} }
  .t-sway{ animation:anim-sway 2.8s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 5 (50-59): twinkle — Diamond Dawn */
  @keyframes anim-twinkle{ 0%,100%{filter:brightness(1);} 50%{filter:brightness(1.6);} }
  .t-twinkle{ animation:anim-twinkle 1.4s ease-in-out infinite; }

  /* Tier 6 (60-69): counter-rotation, opposite direction/speed to tier 1 */
  @keyframes anim-rotate-ccw{ from{transform:rotate(0deg);} to{transform:rotate(-360deg);} }
  .t-rotate-ccw{ animation:anim-rotate-ccw 3.4s linear infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 7 (70-79): ember pulse — glow + scale together */
  @keyframes anim-ember{ 0%,100%{filter:drop-shadow(0 0 3px #d43a3a) brightness(1); transform:scale(1);} 50%{filter:drop-shadow(0 0 11px #ff6b6b) brightness(1.2); transform:scale(1.05);} }
  .t-ember{ animation:anim-ember 2.1s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 8 (80-89): slow rotation (paired with SMIL shimmer) */
  .t-rotate-slow{ animation:anim-rotate-cw 8s linear infinite; transform-box:fill-box; transform-origin:center; }

  /* Tier 9 (90-99): heartbeat double-pulse */
  @keyframes anim-heartbeat{ 0%,100%{transform:scale(1);} 14%{transform:scale(1.12);} 28%{transform:scale(1);} 42%{transform:scale(1.08);} 65%{transform:scale(1);} }
  .t-heartbeat{ animation:anim-heartbeat 1.7s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }

  /* Apex (Level 100): rotate + breathe (nested groups) + gold glow */
  @keyframes anim-glow-gold{ 0%,100%{filter:drop-shadow(0 0 4px #ffdd7a);} 50%{filter:drop-shadow(0 0 16px #ffe9a8);} }
  .t-glow-gold{ animation:anim-glow-gold 2.4s ease-in-out infinite; }
.scl-logo-back{display:grid!important;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:0;padding:15px 13px!important;place-items:center}
.scl-coin-divider{display:none!important}.scl-coin-action{font-size:14px!important}.scl-coin-action b{font-size:6.3px!important}
@media(max-width:600px){.scl-logo-back{padding:11px 9px!important}.scl-coin-action{font-size:12px!important}.scl-coin-action b{font-size:5.3px!important}}
.hub-tier{margin:16px 0 7px;display:flex;align-items:center;gap:9px;color:#650007;font-weight:900;font-size:13px}.hub-tier:after{content:"";flex:1;height:1px;background:linear-gradient(90deg,#d6a93d,transparent)}
.hub-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
@media(min-width:720px){.hub-grid.lv{grid-template-columns:repeat(10,minmax(0,1fr))}.hub-grid.st{grid-template-columns:repeat(4,minmax(0,1fr))}}
.hub-grid.st{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.hub-cell{appearance:none;border:1px solid #2a3556;background:radial-gradient(circle at 50% 30%,#1b2748,#0b1224);border-radius:13px;padding:6px 3px 7px;cursor:pointer;color:#e8dfc4;font:inherit;display:flex;flex-direction:column;align-items:center;transition:transform .15s,border-color .15s}
.hub-cell:hover,.hub-cell:focus-visible{border-color:#d6a93d;transform:translateY(-2px);outline:none}.hub-cell svg{width:100%;max-width:64px;aspect-ratio:1}
.hub-cell small{font-size:10px;font-weight:800;margin-top:2px;color:#d9c48a}.hub-grid.st .hub-cell{padding:12px 8px}.hub-grid.st .hub-cell svg{max-width:96px}.hub-grid.st .hub-cell b{font-size:12px;line-height:1.25;margin-top:6px;text-align:center}
.hub-grid.st .hub-cell small{font-weight:600;font-size:10px;opacity:.8;text-align:center}
.hub-sheet{position:fixed;inset:0;z-index:99999;background:#000a;display:none;align-items:center;justify-content:center;padding:14px}.hub-sheet.open{display:flex}
.hub-card{position:relative;width:min(430px,100%);max-height:90vh;overflow:auto;background:linear-gradient(180deg,#fffdf8,#fff6e0);border:2px solid #d6a93d;border-radius:18px;padding:22px 20px 20px;color:#3f342c;box-shadow:0 20px 60px #0009}
.hub-card h3{margin:10px 0 4px;text-align:center;color:#650007;font-size:19px}.hub-card h4{margin:12px 0 2px;color:#8a640e;font-size:12px}.hub-card p{margin:3px 0;font-size:13.5px;line-height:1.55}
.hub-nav{display:flex;align-items:center;justify-content:center;gap:12px}.hub-nav button,.hub-x{width:38px;height:38px;border-radius:50%;border:1px solid #d6a93d;background:#fff;color:#650007;font-size:20px;cursor:pointer}.hub-nav button:disabled{opacity:.3}
.hub-x{position:absolute;right:10px;top:10px;width:34px;height:34px;font-size:15px}.hs-badge{width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,#1b2748,#0b1224);display:flex;align-items:center;justify-content:center;border:3px solid #d6a93d}.hs-badge svg{width:118px;height:118px}
.hs-tag{text-align:center;font-size:11.5px;font-weight:800;color:#8a640e}.hs-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed #d9c5aa;font-size:13px}.hs-quote{text-align:center;color:#650007;font-weight:800;margin:12px 0 6px!important}
.hub-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 12px}.hub-tools input{flex:1;min-width:180px;padding:10px 12px;border:1px solid #d9c5aa;border-radius:10px;font:inherit}.hub-seg{display:flex;border:1px solid #d6a93d;border-radius:10px;overflow:hidden}.hub-seg button{border:0;background:#fff;color:#650007;font-weight:800;padding:10px 14px;cursor:pointer}.hub-seg button.on{background:#650007;color:#fff}
.hub-medals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}@media(min-width:720px){.hub-medals{grid-template-columns:repeat(5,minmax(0,1fr))}}
.hub-medal{background:radial-gradient(circle at 50% 20%,#1d2a52,#0a1020);border-radius:16px;padding:10px 6px 12px;text-align:center;color:#f2e2ad}.hub-medal svg{width:100%;height:auto;max-width:190px;filter:drop-shadow(0 8px 10px #0008)}.hub-medal b{display:block;font-size:13px;margin-top:4px}.hub-medal small{font-size:10.5px;opacity:.8}
.hub-anthem{max-width:460px;margin:0 auto}.hub-stage{position:relative;border-radius:18px;overflow:hidden;background:#0b1224;border:3px solid #d6a93d;aspect-ratio:1;box-shadow:0 12px 30px #0003}.hub-stage video{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.hub-play{position:absolute;inset:0;border:0;background:linear-gradient(180deg,#0003,#000a);color:#fff;font:inherit;font-weight:900;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:10px;padding-bottom:9%}.hub-play i{width:74px;height:74px;border-radius:50%;background:#d6a93d;color:#650007;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:30px;padding-left:5px;box-shadow:0 0 0 7px #d6a93d55}
.hub-bar{height:5px;background:#ead5b6;border-radius:9px;margin:10px 0 6px;overflow:hidden}.hub-bar i{display:block;height:100%;width:0;background:#650007}
body.scl-night .hub-card,body.scl-night .hub-tools input,body.scl-night .hub-nav button,body.scl-night .hub-seg button:not(.on){background:#1a1b25;color:#f0e6d0}body.scl-night .hub-card p,body.scl-night .hub-card{color:#e5dccb}body.scl-night .hub-card h3,body.scl-night .hub-tier{color:#f3d27a}
.hs-badge{margin:0 auto}.hub-nav{align-items:flex-start}
.hub-nav>button{margin-top:58px;flex:none}.hub-card{padding-top:26px}
.hub-medal{appearance:none;border:0;font:inherit;cursor:pointer;width:100%;transition:transform .15s,box-shadow .15s}.hub-medal:hover,.hub-medal:focus-visible{transform:translateY(-3px);box-shadow:0 0 0 2px #d6a93d;outline:none}
.hs-medal svg{width:120px;height:auto;display:block;margin:0 auto;filter:drop-shadow(0 6px 8px #0006)}.hub-tools select{padding:8px 10px;border:1px solid #d9c5aa;border-radius:10px;font:inherit}.hub-tools label{font-weight:800;color:#650007}
.mv{margin:10px 0;padding:10px 12px;border-radius:12px;font-size:13px;line-height:1.5}.mv.ok{background:#e8f6ec;border:1px solid #2e9a4a;color:#14532d}.mv.bad{background:#fdeaea;border:1px solid #b91c1c;color:#7f1d1d}
.mq{display:flex;gap:10px;align-items:center;margin:6px 0 10px}.mqi{flex:none;width:112px;border:1px solid #d9c5aa;border-radius:8px;overflow:hidden;background:#fff}.mqi svg{display:block;width:100%}.mqt{min-width:0}.mqt small{display:block;word-break:break-all;font-size:10px;color:#6b5c50;margin-bottom:6px}
.mqb{display:flex;gap:6px;flex-wrap:wrap}.hub-card button[data-act]{border:1px solid #d6a93d;background:#fff;color:#650007;border-radius:8px;padding:6px 10px;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.hub-card button.pri{background:#650007;color:#fff}
.mw-y{margin:12px 0 4px;font-weight:900;color:#8a640e;font-size:13px;border-bottom:1px solid #ead5b6}.mw{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 10px;border-radius:10px;border:1px solid #ead5b6;background:#fff;margin:5px 0}.mw b{display:block;font-size:13.5px;color:#3f342c}.mw small{font-size:11px;color:#6b5c50}.mw span{display:flex;gap:5px;flex:none}.mw.hl{border-color:#2e9a4a;background:#e8f6ec;box-shadow:0 0 0 2px #2e9a4a55}.mwq{padding:4px 2px 8px}
.mf{margin-top:14px;padding:12px;border:1px dashed #d6a93d;border-radius:12px;background:#fffaf0}.mf input{display:block;width:100%;box-sizing:border-box;margin:5px 0;padding:9px 11px;border:1px solid #d9c5aa;border-radius:9px;font:inherit}.mf button{margin:4px 0}.mf small,.hs-note{display:block;font-size:11.5px;color:#6b5c50;margin:4px 0}
body.scl-night .mw,body.scl-night .mf{background:#22232e}body.scl-night .mw b{color:#f0e6d0}
</style>
<div aria-modal="true" class="hub-sheet" id="hubSheet" role="dialog"><div class="hub-card" id="hubCard"><button aria-label="Close" class="hub-x" id="hubClose" type="button">✕</button><div class="hub-nav"><button aria-label="Previous" id="hubPrev" type="button">‹</button><div id="hubBody" style="flex:1;min-width:0"></div><button aria-label="Next" id="hubNext" type="button">›</button></div></div></div>
<script id="scl-hub-js">(function(){
const __M={},__C={};const __req=n=>{n=n.replace(/^.*\//,"");if(!__C[n]){const m={exports:{}};__C[n]=m;__M[n](m,m.exports,__req)}return __C[n].exports};
__M["QR8bitByte"]=function(module,exports,require){var QRMode = require('./QRMode');

function QR8bitByte(data) {
	this.mode = QRMode.MODE_8BIT_BYTE;
	this.data = data;
}

QR8bitByte.prototype = {

	getLength : function() {
		return this.data.length;
	},
	
	write : function(buffer) {
		for (var i = 0; i < this.data.length; i++) {
			// not JIS ...
			buffer.put(this.data.charCodeAt(i), 8);
		}
	}
};

module.exports = QR8bitByte;

};
__M["QRBitBuffer"]=function(module,exports,require){function QRBitBuffer() {
	this.buffer = [];
	this.length = 0;
}

QRBitBuffer.prototype = {

