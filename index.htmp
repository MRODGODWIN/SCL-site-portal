.scl-v94-vertical-days .scl-tt-kind-t1 .scl-tt-fixed-block,.scl-v94-vertical-days .scl-tt-kind-t2 .scl-tt-fixed-block,.scl-v94-vertical-days .scl-tt-kind-t3 .scl-tt-fixed-block{background:#ddd5e6!important;color:#62566b!important}
