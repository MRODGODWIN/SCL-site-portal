nt and arrangement; Food preservation techniques (drying, salting, refrigeration); Sewing simple garments."},{"page":5191,"class":"PRIMARY5","subject":"Home Economics (PVS)","term":"Third Term","text":"Term 3 — Consumer education: Wise buying habits, budgeting, detecting expired products."},{"page":5192,"class":"PRIMARY5","subject":"Social Studies","term":"First Term","text":"Terms 1 & 2 — Resources development in Nigeria; Natural resources (Petroleum, Agriculture, Minerals); Environmental degradation (Erosion, Deforestation)."},{"page":5193,"class":"PRIMARY5","subject":"Social Studies","term":"Second Term","text":"Terms 1 & 2 — Resources development in Nigeria; Natural resources (Petroleum, Agriculture, Minerals); Environmental degradation (Erosion, Deforestation)."},{"page":5194,"class":"PRIMARY5","subject":"Social Studies","term":"Third Term","text":"Term 3 — International organizations: ECOWAS, African Union (AU), United Nations (UN); Foreign trade basics."},{"page":5195,"class":"PRIMARY5","subject":"Civic Education","term":"First Term","text":"Terms 1 & 2 — Constitutional development in Nigeria; Arms of Government: Executive, Legislature, Judiciary; Separation of powers."},{"page":5196,"class":"PRIMARY5","subject":"Civic Education","term":"Second Term","text":"Terms 1 & 2 — Constitutional development in Nigeria; Arms of Government: Executive, Legislature, Judiciary; Separation of powers."},{"page":5197,"class":"PRIMARY5","subject":"Civic Education","term":"Third Term","text":"Term 3 — Pressure groups and civil society; Protection of human rights; National security agencies in Nigeria."},{"page":5198,"class":"PRIMARY5","subject":"Security Education","term":"First Term","text":"Terms 1 & 2 — Terrorism and insurgency awareness; Security consciousness in public places (airports, markets, parks); Bomb safety drills."},{"page":5199,"class":"PRIMARY5","subject":"Security Education","term":"Second Term","text":"Terms 1 & 2 — Terrorism and insurgency awareness; Security consciousness in public places (airports, markets, parks); Bomb safety drills."},{"page":5200,"class":"PRIMARY5","subject":"Security Education","term":"Third Term","text":"Term 3 — Financial fraud and cybercrime awareness (Yahoo-Yahoo, phishing, ATM safety); Reporting economic crimes."},{"page":5201,"class":"PRIMARY5","subject":"Cultural & Creative Arts","term":"First Term","text":"Terms 1 & 2 — Perspective drawing (1-point and 2-point perspective); Clay pottery throwing and glazing; Musical instruments classification (Aerophones, Chordophones, Membranophones)."},{"page":5202,"class":"PRIMARY5","subject":"Cultural & Creative Arts","term":"Second Term","text":"Terms 1 & 2 — Perspective drawing (1-point and 2-point perspective); Clay pottery throwing and glazing; Musical instruments classification (Aerophones, Chordophones, Membranophones)."},{"page":5203,"class":"PRIMARY5","subject":"Cultural & Creative Arts","term":"Third Term","text":"Term 3 — Choreography principles; Play directing and production; Cultural heritage preservation."},{"page":5204,"class":"PRIMARY5","subject":"Physical & Health Ed.","term":"First Term","text":"Terms 1 & 2 — Basketball and Tennis fundamental skills; Swimming strokes (Freestyle, Backstroke, Breaststroke); Drug abuse and sports performance."},{"page":5205,"class":"PRIMARY5","subject":"Physical & Health Ed.","term":"Second Term","text":"Terms 1 & 2 — Basketball and Tennis fundamental skills; Swimming strokes (Freestyle, Backstroke, Breaststroke); Drug abuse and sports performance."},{"page":5206,"class":"PRIMARY5","subject":"Physical & Health Ed.","term":"Third Term","text":"Term 3 — Communicable diseases (Malaria, Typhoid, HIV/AIDS prevention); Community health programs."},{"page":5207,"class":"PRIMARY5","subject":"Nigerian History","term":"First Term","text":"Terms 1 & 2 — Nigeria's independence movement; October 1st, 1960 Independence; The First Republic (1963) and key political actors."},{"page":5208,"class":"PRIMARY5","subject":"Nigerian History","term":"Second Term","text":"Terms 1 & 2 — Nigeria's independence movement; October 1st, 1960 Independence; The First Republic (1963) and key political actors."},{"page":5209,"class":"PRIMARY5","subject":"Nigerian History","term":"Third Term","text":"Term 3 — History of military rule in Nigeria; Creation of 36 States in Nigeria; Return to Democracy in 1999."},{"page":5210,"class":"PRIMARY5","subject":"Religious Studies","term":"First Term","text":"Terms 1 & 2 — CRS: The Paul's missionary journeys; Faith and Works. / IS: Hadith 1-5 of An-Nawawi; Zakat (Almsgiving) rules."},{"page":5211,"class":"PRIMARY5","subject":"Religious Studies","term":"Second Term","text":"Terms 1 & 2 — CRS: The Paul's missionary journeys; Faith and Works. / IS: Hadith 1-5 of An-Nawawi; Zakat (Almsgiving) rules."},{"page":5212,"class":"PRIMARY5","subject":"Religious Studies","term":"Third Term","text":"Term 3 — CRS: The fruit of the Holy Spirit. / IS: Life of Caliph Uthman and Ali; Islamic historical monuments."}];
  const norm=v=>String(v||'').toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'');
  const existing=Array.isArray(window.sclPages)?window.sclPages:[];
  const covered=new Set(existing.map(x=>norm(x.class)+'|'+norm(x.subject)+'|'+norm(x.term)+'|'+norm(x.text)));
  const additions=incoming.filter(x=>!covered.has(norm(x.class)+'|'+norm(x.subject)+'|'+norm(x.term)+'|'+norm(x.text)));
  window.sclPages=existing.concat(additions);
  window.sclEarlyPrimaryIntegration={added:additions.length,total:window.sclPages.length,classes:["CRECHE", "RECEPTION", "NURSERY1", "NURSERY2", "PRIMARY1", "PRIMARY2", "PRIMARY3", "PRIMARY4", "PRIMARY5"]};
})();
</script>
<script id="scl-complete-teaching-scheme-ui">
(function(){
  function norm(v){return String(v||'').toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'');}
  function by(id){return document.getElementById(id)}
  function populate(){
    var c=by('sclCurClass'), t=by('sclCurTerm'), s=by('sclCurSubject'); if(!c||!t||!s)return;
    var data=Array.isArray(window.sclPages)?window.sclPages:[];
    var cls=c.value;
    var subjects=[];
    data.forEach(function(x){if(norm(x.class)===norm(cls)&&subjects.indexOf(x.subject)<0)subjects.push(x.subject)});
    subjects.sort(function(a,b){return String(a).localeCompare(String(b))});
    var previous=s.value;
    s.innerHTML=subjects.map(function(v){return '<option value="'+String(v).replace(/&/g,'&amp;').replace(/"/g,'&quot;')+'">'+String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</option>'}).join('');
    if(previous && subjects.some(function(v){return norm(v)===norm(previous)})){s.value=subjects.find(function(v){return norm(v)===norm(previous)})}
    else if(subjects.length)s.value=subjects[0];
  }
  function init(){
    var c=by('sclCurClass'),t=by('sclCurTerm'); if(!c||!t)return;
    populate();
    c.addEventListener('change',populate);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>
<script id="scl-supabase-v1">
(function(){
  async function check(){
    var el=document.getElementById('sclBackendStatus');if(!el||!window.sclSupabase)return;
    try{var r=await window.sclSupabase.from('school_settings').select('key').limit(1);
      if(!r.error){el.setAttribute('data-status','connected');}
      else {el.setAttribute('data-status','ready');}
    }catch(e){el.setAttribute('data-status','ready');}
  }
  window.sclRecordWhatsAppContact=function(role,number){
    try{localStorage.setItem('sclLastWhatsAppContact',JSON.stringify({role:role,number:number,at:new Date().toISOString()}));}catch(e){}
  };
  var original=window.openAdminWhatsApp;
  window.openAdminWhatsApp=function(role,number){window.sclRecordWhatsAppContact(role,number);return original(role,number);};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',check);else check();
})();
</script>
<script id="scl-announcement-deep-link-v1">
(function(){
  function openAnnouncementFromUrl(){
    try{
      const id=new URLSearchParams(location.search).get('scl_announcement');
      if(!id)return;
      const tryOpen=()=>{
        const list=window.sclCommunityData?.announcements||[];
        const item=list.find(x=>String(x.id)===String(id));
        if(item){window.openSclAlerts?.();return true}
        return false;
      };
      let n=0; const timer=setInterval(()=>{n++;if(tryOpen()||n>25)clearInterval(timer)},400);
    }catch(e){}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',openAnnouncementFromUrl);else openAnnouncementFromUrl();
})();
</script>
